// T16 -- live integration harness. One @test per driver: each reads a DSN from the environment and,
// when it is set, connects to the real server and runs a CREATE / INSERT / SELECT / DROP roundtrip,
// asserting the typed decode. When the DSN is UNSET the test SKIPS cleanly (prints a hint and passes),
// so the harness is green offline (`nova test` with no env) yet gates every driver's live path the
// moment a DSN is provided -- e.g. in CI with service containers.
//
// Run one driver live:
//   NOVA_PG_DSN='postgres://user:pass@127.0.0.1:5432/db' nova test integration/live_db_harness.nova
// DSNs recognized: NOVA_PG_DSN, NOVA_MYSQL_DSN, NOVA_MSSQL_DSN, NOVA_BTREE_DSN, NOVA_MONGO_DSN.
//
// This file is compiled from the `lang/` directory so `../packages/nova-*` resolve as local packages.

import assert;
import list;
import string;
import env;
import metrics;
import db;
import postgres;
import mysql;
import mssql;
import novadb;
import mongodb;

// A SQL CREATE/INSERT/SELECT/DROP roundtrip over any Connection-producing Driver. `textType` is the
// column type for the name field (TEXT vs VARCHAR(32)) so each dialect gets a valid DDL. Returns "" on
// success, else a human error string. Asserts one row decodes to (1, "Alice").
fn sqlRoundtrip(drv: Driver, connectionString: string, textType: string): string {
    let conn = drv.connect(connectionString);
    let none = List<DbValue>();
    conn.exec("DROP TABLE IF EXISTS nova_live_probe", none);
    let c = conn.exec("CREATE TABLE nova_live_probe (id INT, name " + textType + ")", none);
    if (c.hasError()) { conn.close(); return "create: " + c.err.message; }
    let i = conn.exec("INSERT INTO nova_live_probe (id, name) VALUES (1, 'Alice')", none);
    if (i.hasError()) { conn.close(); return "insert: " + i.err.message; }
    let rs = conn.query("SELECT id, name FROM nova_live_probe", none);
    if (rs.hasError()) { conn.close(); return "select: " + rs.err.message; }
    if (rs.rowCount() != 1) { conn.close(); return "expected 1 row, got " + metrics.numStr(rs.rowCount() as long); }
    let r = rs.row(0);
    let okId = r.getInt(0) == 1;
    let okName = string.eql(r.getText(1), "Alice");
    conn.exec("DROP TABLE nova_live_probe", none);
    conn.close();
    if (!okId) { return "id mismatch"; }
    if (!okName) { return "name mismatch"; }
    return "";
}

fn skip(label: string, envVar: string): void {
    console.log("  SKIP  " + label + " (set " + envVar + " to run live)");
}

@test
fn live_postgres(): void {
    let connectionString = env.get("NOVA_PG_DSN");
    if (string.eql(connectionString, "")) { skip("postgres", "NOVA_PG_DSN"); return; }
    let err = sqlRoundtrip(PgDriver(), connectionString, "TEXT");
    assert.equalStr("", err);
}

@test
fn live_mysql(): void {
    let connectionString = env.get("NOVA_MYSQL_DSN");
    if (string.eql(connectionString, "")) { skip("mysql", "NOVA_MYSQL_DSN"); return; }
    let err = sqlRoundtrip(MyDriver(), connectionString, "VARCHAR(32)");
    assert.equalStr("", err);
}

@test
fn live_mssql(): void {
    let connectionString = env.get("NOVA_MSSQL_DSN");
    if (string.eql(connectionString, "")) { skip("mssql", "NOVA_MSSQL_DSN"); return; }
    let err = sqlRoundtrip(MssqlDriver(), connectionString, "VARCHAR(32)");
    assert.equalStr("", err);
}

@test
fn live_btreedb(): void {
    let connectionString = env.get("NOVA_BTREE_DSN");
    if (string.eql(connectionString, "")) { skip("novadb", "NOVA_BTREE_DSN"); return; }
    let err = sqlRoundtrip(NovaDriver(), connectionString, "TEXT");
    assert.equalStr("", err);
}

@test
fn live_mongodb(): void {
    // mongo is not SQL: exercise connect + a server ping command through the same seam.
    let connectionString = env.get("NOVA_MONGO_DSN");
    if (string.eql(connectionString, "")) { skip("mongodb", "NOVA_MONGO_DSN"); return; }
    let conn = MongoDriver().connect(connectionString);
    let rs = conn.query("{\"ping\": 1}", List<DbValue>());
    conn.close();
    assert.isFalse(rs.hasError());
}
