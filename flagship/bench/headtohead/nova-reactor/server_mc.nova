import bytes;
import os.sys;
import net.poller;
import env;
import string;

const SO_REUSEADDR: int = 4;

fn appendStr(buf: long, off: int, s: string): int {
    let i = 0;
    while (i < s.length) { bytes.write_byte(buf, off + i, s[i]); i = i + 1; }
    return off + s.length;
}
fn appendCRLF(buf: long, off: int): int {
    bytes.write_byte(buf, off, 13); bytes.write_byte(buf, off + 1, 10);
    return off + 2;
}
fn writeAll(fd: int, buf: long, len: int): void {
    let sent = 0;
    while (sent < len) {
        let w = sys.write(fd, buf + (sent as long), (len - sent) as long);
        if (w <= 0) { if (sys.errno() == 35) { continue; } return; }
        sent = sent + (w as int);
    }
}

async fn serveConn(r: poller.Reactor, fd: int, resp: long, respLen: int): void {
    while (true) {
        r.addRead(fd, currentCoro());
        coroSuspend();
        let buf = r.getBuffer();
        let got = sys.read(fd, buf, 16384);
        if (got <= 0) { r.putBuffer(buf); sys.close(fd); return; }
        writeAll(fd, resp, respLen);
        r.putBuffer(buf);
    }
}

fn reactorWorker(idx: int): void {
    let pe = env.get("PORT");
    let port = if (pe.length == 0) 8087 else string.parseI64(pe) as int;

    let lfd = sys.socket(sys.AF_INET, sys.SOCK_STREAM, 0);
    let one = bytes.alloc(4);
    bytes.write_i32(one, 0, 1);
    sys.setsockopt(lfd, sys.SOL_SOCKET, SO_REUSEADDR, one, 4);
    sys.setReusePort(lfd);
    bytes.free(one);
    let sa = sys.makeSockaddrIn(port, 0);
    if (sys.bind(lfd, sa, 16) != 0) { bytes.free(sa); return; }
    sys.listen(lfd, 512);
    sys.setNonBlocking(lfd);
    bytes.free(sa);

    let resp = bytes.alloc(256);
    let o = 0;
    o = appendStr(resp, o, "HTTP/1.1 200 OK"); o = appendCRLF(resp, o);
    o = appendStr(resp, o, "Content-Type: application/json"); o = appendCRLF(resp, o);
    o = appendStr(resp, o, "Content-Length: 27"); o = appendCRLF(resp, o);
    o = appendStr(resp, o, "Connection: keep-alive"); o = appendCRLF(resp, o);
    o = appendCRLF(resp, o);
    o = appendStr(resp, o, `{"message":"Hello, World!"}`);
    let respLen = o;

    let r = poller.Reactor(1024, 16384, 1024);
    r.addRead(lfd, lfd as long);
    let addrBuf = bytes.alloc(16);
    let addrLen = bytes.alloc(4);

    while (true) {
        let n = r.poll(-1);
        let i = 0;
        while (i < n) {
            let fd = r.readyFd(i);
            if (fd == lfd) {
                while (true) {
                    bytes.write_i32(addrLen, 0, 16);
                    let c = sys.accept(lfd, addrBuf, addrLen);
                    if (c < 0) { break; }
                    sys.setNonBlocking(c);
                    coroStart(serveConn(r, c, resp, respLen));
                }
            } else {
                nova_reactor_resume(r.readyToken(i));
            }
            i = i + 1;
        }
    }
}

fn main(): void {
    let re = env.get("NOVA_REACTORS");
    let n = if (re.length == 0) 4 else string.parseI64(re) as int;
    poller.runReactors(n, reactorWorker);
}
