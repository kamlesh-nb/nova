// A minimal HTTP/1.1 server built directly on the Nova-owned event loop (net/reactor over
// kqueue), with NO Asio and NO web.App framework. It answers every request with the same
// constant JSON as the head-to-head peers, so its throughput is directly comparable. This is
// the gap-8 measurement of docs/design/self-hosted-runtime.md: how fast is the Nova loop itself.
//
// Single reactor on one core (share-nothing multi-core via SO_REUSEPORT is the next step). The
// request content is not parsed (a fixed-response benchmark isolates the loop and I/O path).
import bytes;
import os.sys;
import os.socket;
import net.poller;
import env;
import string;


fn appendStr(buf: long, off: int, s: string): int {
    let i = 0;
    while (i < s.length) {
        bytes.write_byte(buf, off + i, s[i]);
        i = i + 1;
    }
    return off + s.length;
}
fn appendCRLF(buf: long, off: int): int {
    bytes.write_byte(buf, off, 13);
    bytes.write_byte(buf, off + 1, 10);
    return off + 2;
}

// Write the whole buffer, tolerating partial writes and EAGAIN (tiny response, so this loops
// at most a couple of times under load).
fn writeAll(fd: int, buf: long, len: int): void {
    let sent = 0;
    while (sent < len) {
        let w = sys.write(fd, buf + (sent as long), (len - sent) as long);
        if (w <= 0) {
            // socket.wouldBlock(), NOT a hardcoded 35: EAGAIN is 35 on macOS but 11 on Linux, so the
            // literal made this branch dead off macOS -- a write that merely needed retrying was
            // treated as fatal and writeAll returned with the response half-sent, which the client
            // reports as "connection closed before message completed".
            if (socket.wouldBlock()) { continue; }
            return;
        }
        sent = sent + (w as int);
    }
}

fn main(): void {
    let pe = env.get("PORT");
    let port = if (pe.length == 0) 8085 else string.parseI64(pe) as int;

    let lfd = sys.socket(sys.AF_INET, sys.SOCK_STREAM, 0);
    let one = bytes.alloc(4);
    bytes.write_i32(one, 0, 1);
    // socket.setReuseAddr picks the right SO_REUSEADDR per OS (4 on macOS, 2 on Linux); the old
    // literal 4 set SO_ERROR on Linux instead, so the port stayed unbindable during TIME_WAIT.
    socket.setReuseAddr(lfd);
    let sa = sys.makeSockaddrIn(port, 0);
    if (sys.bind(lfd, sa, 16) != 0) {
        return;
    }
    sys.listen(lfd, 512);
    sys.setNonBlocking(lfd);
    bytes.free(one);
    bytes.free(sa);

    // Build the fixed response once.
    let resp = bytes.alloc(256);
    let o = 0;
    o = appendStr(resp, o, "HTTP/1.1 200 OK"); o = appendCRLF(resp, o);
    o = appendStr(resp, o, "Content-Type: application/json"); o = appendCRLF(resp, o);
    o = appendStr(resp, o, "Content-Length: 27"); o = appendCRLF(resp, o);
    o = appendStr(resp, o, "Connection: keep-alive"); o = appendCRLF(resp, o);
    o = appendCRLF(resp, o);
    o = appendStr(resp, o, `{"message":"Hello, World!"}`);
    let respLen = o;

    let r = poller.Reactor(1024, 16384, 64);
    r.addRead(lfd, lfd as long);

    let addrBuf = bytes.alloc(16);
    let addrLen = bytes.alloc(4);

    while (true) {
        let n = r.poll(-1);
        let i = 0;
        while (i < n) {
            let fd = r.readyFd(i);
            if (fd == lfd) {
                while (true) {
                    bytes.write_i32(addrLen, 0, 16);
                    let c = sys.accept(lfd, addrBuf, addrLen);
                    if (c < 0) { break; }
                    sys.setNonBlocking(c);
                    r.addRead(c, c as long);
                }
            } else {
                let buf = r.getBuffer();
                let got = sys.read(fd, buf, 16384);
                if (got <= 0) {
                    r.putBuffer(buf);
                    sys.close(fd);
                } else {
                    writeAll(fd, resp, respLen);
                    r.putBuffer(buf);
                }
            }
            i = i + 1;
        }
    }
}
