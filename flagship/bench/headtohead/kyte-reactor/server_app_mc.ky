import web.app;
import web.request;
import web.response;
import web.status;
import serde.source;
import env;
import string;

@serializable struct Hello { pub id: int }

struct HelloHandler impl MessageHandler {
    async fn handle(self: HelloHandler, src: ValueSource): Response {
        return json(`{"message":"Hello, World!"}`);
    }
}

fn main(): void {
    let pe = env.get("PORT");
    let port = if (pe.length == 0) 8090 else string.parseI64(pe) as int;
    let re = env.get("KYTE_REACTORS");
    let workers = if (re.length == 0) 4 else string.parseI64(re) as int;

    let application = App();
    application.handle<Hello>(HelloHandler{});
    application.get<Hello>("/");

    application.runReactorMC(port, workers);
}
