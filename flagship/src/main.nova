// main.nova — app composition root (= Program.cs): register handlers + routes, wire
// static files, run. Each `handle<TReq>` binds a request type to its handler; the
// matching `get/post<TReq>` registers the route. Vertical slices live under Features/.
import web.app;
import web.request;
import web.response;
import serde.source;
import env;
import string;
import Features.Products.CreateProduct.command;
import Features.Products.CreateProduct.handler;
import Features.Products.GetProductById.query;
import Features.Products.GetProductById.handler;
import Features.Upstream.FetchUpstream.query;
import Features.Upstream.FetchUpstream.handler;
import Infrastructure.product_repository;

fn buildApp(): App {
    let app = App();

    // Products feature — one registration per slice.
    app.handle<CreateProduct>(CreateProductHandler{});
    app.post<CreateProduct>("/api/products");

    // The GetProductById handler holds a repository backed by the fetched nova-postgres driver, so it
    // runs a REAL per-request DB query (awaited on the request coroutine — no block-drive, no deadlock).
    let repo = ProductRepository("postgresql://postgres@127.0.0.1:5432/appdb");
    app.handle<GetProductById>(GetProductByIdHandler{ repo: repo });
    app.get<GetProductById>("/api/products/{id:int}");

    // Upstream feature — a per-request outbound verified HTTPS call via net/httpsclient (reactor-native
    // pure-Nova TLS 1.3), awaited on the request coroutine. Target/CA come from NOVA_UPSTREAM_URL /
    // NOVA_UPSTREAM_CA. GET /api/fetch returns a JSON summary of the upstream response.
    app.handle<FetchUpstream>(FetchUpstreamHandler{});
    app.get<FetchUpstream>("/api/fetch");

    // Serve static assets (wwwroot/) for any unmatched GET.
    app.useStatic("/", "./wwwroot");
    return app;
}

fn main(): void {
    // DB access now happens PER REQUEST inside GetProductByIdHandler (awaited on the request coroutine
    // through the nova get-fetched nova-postgres driver) — no startup block-drive needed. GET
    // /api/products/{id} runs a live `SELECT name FROM products WHERE id = $1`, degrading gracefully
    // to a fallback name when the database is offline, so the app serves either way.
    let app = buildApp();
    // Port from NOVA_PORT (default 8080) so the orchestrator can run many replicas on distinct ports
    // behind its load balancer.
    let portEnv = env.get("NOVA_PORT");
    let port = if (portEnv == "") 8080 else string.parseI64(portEnv) as int;
    console.log(`Listening on http://127.0.0.1:${port}`);
    app.run(port);
}