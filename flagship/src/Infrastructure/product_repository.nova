
import db;
import postgres;
import list;
import string;

pub struct ProductRepository {
    pub dsn: string,
    init(dsn: string) {
        self.dsn = dsn;
    }

    pub async fn productName(self: ProductRepository, id: int): string {
        let driver = PgDriver();
        let conn = await driver.connect(self.dsn);
        let params = List<DbValue>();
        params.push(dbInt(id));
        let rs = await conn.query("SELECT name FROM products WHERE id = $1", params);
        conn.close();
        if (rs.rowCount() > 0) {
            return rs.row(0).getText(0);
        }
        return "Sample Product (database offline, fallback)";
    }
}
