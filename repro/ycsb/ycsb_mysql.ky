import ycsb_core;
import db;
import mysql;

@test
fn ycsb_mysql_suite(): void {
    let conn = MyDriver().connect("mysql://ycsb:ycsbpass@127.0.0.1:3306/ycsbtest");
    ycsb_core.runSuite("MySQL", conn,
        "CREATE TABLE ycsb_af (ykey VARCHAR(64) PRIMARY KEY, ydata TEXT)",
        10000, 5000, 0.99, false);
}
