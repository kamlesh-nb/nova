// One PostgreSQL client process for the concurrency-scaling harness.
import ycsb_client_core;
import db;
import postgres;
import env;

fn main(): void {
    let connectionString = env.get("YCSB_DSN");
    if (connectionString.length == 0) { connectionString = "postgres://kamlesh@127.0.0.1:5432/ycsbtest"; }
    let conn = PgDriver().connect(connectionString);
    ycsb_client_core.dispatch(conn, "CREATE TABLE ycsb_af (ykey TEXT PRIMARY KEY, ydata TEXT)");
}
