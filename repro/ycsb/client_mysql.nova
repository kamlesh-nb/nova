// One MySQL client process for the concurrency-scaling harness.
import ycsb_client_core;
import db;
import mysql;
import env;

fn main(): void {
    let dsn = env.get("YCSB_DSN");
    if (dsn.length == 0) { dsn = "mysql://ycsb:ycsbpass@127.0.0.1:3306/ycsbtest"; }
    let conn = MyDriver().connect(dsn);
    ycsb_client_core.dispatch(conn, "CREATE TABLE ycsb_af (ykey VARCHAR(64) PRIMARY KEY, ydata TEXT)");
}
