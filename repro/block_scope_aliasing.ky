
fn shadowing(): int {
    let x = 1;
    if (true) {
        let x = 2;
    }
    return x;
}

fn disjoint(): string {
    let out = "";
    if (true) {
        let v = 42;
        out = out + `${v}`;
    }
    if (false) {
        let v = "never-runs";
        out = out + v;
    }
    return out;
}

fn main(): void {
    console.log(`shadowing=${shadowing()}`);
    console.log(`disjoint=${disjoint()}`);
    console.log("if you see this, both are fixed");
}
