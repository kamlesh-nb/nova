// YCSB benchmark suite — ALL workloads A-F — in Nova against a LIVE BTreeDB.
//   A: 50% read / 50% update            (Zipfian)
//   B: 95% read / 5% update             (Zipfian)
//   C: 100% read                        (Zipfian)
//   D: 95% read / 5% insert             (Latest — reads favor recent inserts)
//   E: 95% scan / 5% insert             (Zipfian, short ranges)
//   F: 50% read / 50% read-modify-write (Zipfian)
// Zero-padded keys (user00000001) so range scans are numerically ordered.
// Run: start the server (btree/ ; ./zig-out/bin/btree :3009), then
//   ./zig-out/bin/nova test --release repro/btree_e2e/ycsb_af.nova
import assert;
import list;
import string;
import datetime;
import math;
import db;
import btreedb;

struct Rng {
    pub state: long,
    init(seed: long) { self.state = seed; }
    pub fn nextU64(self: Rng): long {
        self.state = self.state * 2862933555777941757 + 3037000493;
        return self.state;
    }
    pub fn nextDouble(self: Rng): double {
        let v = self.nextU64();
        if (v < 0) { v = 0 - v; }
        return ((v % 1000000000) as double) / 1000000000.0;
    }
    pub fn nextInt(self: Rng, n: int): int {
        let v = self.nextU64();
        if (v < 0) { v = 0 - v; }
        return (v % (n as long)) as int;
    }
}

fn zetaSum(n: int, theta: double): double {
    let sum = 0.0;
    let i = 1;
    while (i <= n) { sum = sum + math.fpowf(i as double, 0.0 - theta); i = i + 1; }
    return sum;
}

struct Zipfian {
    pub rng: Rng,
    pub n: int,
    pub theta: double,
    pub zeta_n: double,
    pub alpha: double,
    pub eta: double,
    init(rng: Rng, n: int, theta: double) {
        self.rng = rng;
        self.n = n;
        self.theta = theta;
        let zeta_2 = zetaSum(2, theta);
        self.zeta_n = zetaSum(n, theta);
        self.alpha = 1.0 / (1.0 - theta);
        let nd = n as double;
        self.eta = (1.0 - math.fpowf(2.0 / nd, 1.0 - theta)) / (1.0 - zeta_2 / self.zeta_n);
    }
    // Zipfian rank in [0, n)  (0 = hottest)
    pub fn next(self: Zipfian): int {
        let u = self.rng.nextDouble();
        let uz = u * self.zeta_n;
        if (uz < 1.0) { return 0; }
        if (uz < 1.0 + math.fpowf(0.5, self.theta)) { return 1; }
        let r = self.eta * u - self.eta + 1.0;
        return ((self.n as double) * math.fpowf(r, self.alpha)) as int;
    }
}

fn genValue(size: int): string {
    let s = "";
    let i = 0;
    while (i < size) { s = s + "x"; i = i + 1; }
    return s;
}

// Zero-padded key so lexical order == numeric order (range scans work).
fn keyName(k: int): string {
    let s = `${k}`;
    while (s.length < 8) { s = "0" + s; }
    return `user${s}`;
}

// Mutable benchmark state (Nova structs are references, so a method mutates it).
struct Bench {
    pub rng: Rng,
    pub conn: db.Connection,
    pub records: int,      // keyspace size for reads/updates/scans
    pub nextKey: int,      // next INSERT key (grows for D/E)
    pub value: string,
    pub theta: double,
    pub scanLen: int,
    init(rng: Rng, conn: db.Connection, records: int, value: string, theta: double) {
        self.rng = rng;
        self.conn = conn;
        self.records = records;
        self.nextKey = records;
        self.value = value;
        self.theta = theta;
        self.scanLen = 10;
    }

    // Run `ops` operations with the given proportions; useLatest picks the Latest
    // distribution for reads (D). Returns nothing; prints throughput+latency.
    pub fn run(self: Bench, name: string, ops: int, readP: double, updateP: double,
               insertP: double, scanP: double, rmwP: double, useLatest: bool): void {
        let zipf = Zipfian(self.rng, self.records, self.theta);
        let cRead = 0; let cUpdate = 0; let cInsert = 0; let cScan = 0; let cRmw = 0;
        let minNs: long = 999999999999; let maxNs: long = 0; let sumNs: long = 0;
        let start = datetime.nowNs();
        let op = 0;
        while (op < ops) {
            let coin = self.rng.nextDouble();
            let t0 = datetime.nowNs();
            let a = readP;
            let b = a + updateP;
            let c = b + insertP;
            let d = c + scanP;
            if (coin < a) {
                // READ (Latest for D: hottest = most recently inserted)
                let k = zipf.next();
                if (useLatest) { k = self.nextKey - 1 - k; if (k < 0) { k = 0; } }
                let rs = self.conn.query(`SELECT ykey, ydata FROM ycsb_af WHERE ykey = '${keyName(k)}'`, List<DbValue>());
                cRead = cRead + 1;
            } else { if (coin < b) {
                let k = zipf.next();
                self.conn.exec(`UPDATE ycsb_af SET ydata = '${self.value}' WHERE ykey = '${keyName(k)}'`, List<DbValue>());
                cUpdate = cUpdate + 1;
            } else { if (coin < c) {
                self.conn.exec(`INSERT INTO ycsb_af (ykey, ydata) VALUES ('${keyName(self.nextKey)}', '${self.value}')`, List<DbValue>());
                self.nextKey = self.nextKey + 1;
                cInsert = cInsert + 1;
            } else { if (coin < d) {
                let k = zipf.next();
                let rs = self.conn.query(`SELECT ykey, ydata FROM ycsb_af WHERE ykey >= '${keyName(k)}' LIMIT ${self.scanLen}`, List<DbValue>());
                cScan = cScan + 1;
            } else {
                // READ-MODIFY-WRITE (F): read then update the same key
                let k = zipf.next();
                let rs = self.conn.query(`SELECT ykey, ydata FROM ycsb_af WHERE ykey = '${keyName(k)}'`, List<DbValue>());
                self.conn.exec(`UPDATE ycsb_af SET ydata = '${self.value}' WHERE ykey = '${keyName(k)}'`, List<DbValue>());
                cRmw = cRmw + 1;
            } } } }
            let dt = datetime.nowNs() - t0;
            if (dt < minNs) { minNs = dt; }
            if (dt > maxNs) { maxNs = dt; }
            sumNs = sumNs + dt;
            op = op + 1;
        }
        let elapsedNs = datetime.nowNs() - start;
        let opsPerSec = (ops as double) * 1000000000.0 / (elapsedNs as double);
        let avgUs = (sumNs as double) / (ops as double) / 1000.0;
        console.log(`Workload ${name}: ${ops} ops [r=${cRead} u=${cUpdate} i=${cInsert} s=${cScan} rmw=${cRmw}] in ${elapsedNs / 1000000}ms  ${opsPerSec as int} ops/sec  lat[min ${(minNs / 1000) as int}us avg ${avgUs as int}us max ${(maxNs / 1000) as int}us]`);
        assert.equalInt(cRead + cUpdate + cInsert + cScan + cRmw, ops);
    }
}

@test
fn ycsb_af_suite(): void {
    let records = 10000;
    let ops = 5000;
    let theta = 0.99;
    let value = genValue(64);

    let rng = Rng(88172645463325252);
    let drv = BTreeDriver();
    let conn = drv.connect("127.0.0.1:3009");
    conn.exec("CREATE TABLE ycsb_af (ykey TEXT PRIMARY KEY, ydata TEXT)", List<DbValue>());

    // --- LOAD ---
    let loadStart = datetime.nowNs();
    let i = 0;
    while (i < records) {
        conn.exec(`INSERT INTO ycsb_af (ykey, ydata) VALUES ('${keyName(i)}', '${value}')`, List<DbValue>());
        i = i + 1;
    }
    let loadNs = datetime.nowNs() - loadStart;
    console.log("=== YCSB A-F on BTreeDB (Zipfian theta=0.99) ===");
    console.log(`LOAD: ${records} inserts in ${loadNs / 1000000}ms  ${((records as double) * 1000000000.0 / (loadNs as double)) as int} ops/sec`);

    let b = Bench(rng, conn, records, value, theta);
    //           name  ops   read  update insert scan   rmw   latest
    b.run("A", ops, 0.50, 0.50, 0.00, 0.00, 0.00, false);
    b.run("B", ops, 0.95, 0.05, 0.00, 0.00, 0.00, false);
    b.run("C", ops, 1.00, 0.00, 0.00, 0.00, 0.00, false);
    b.run("D", ops, 0.95, 0.00, 0.05, 0.00, 0.00, true);
    b.run("E", ops, 0.00, 0.00, 0.05, 0.95, 0.00, false);
    b.run("F", ops, 0.50, 0.00, 0.00, 0.00, 0.50, false);

    conn.close();
}
