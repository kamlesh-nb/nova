// nsieve, BORROWED-STRING (Str) variant. The sieve itself reuses the value-struct engine; the Str angle is
// the REPORT rendering, which is exactly what `Str` exists for (str.nova: render straight from a borrow into
// a builder with NO owned intermediate). The label "Primes up to " is borrowed ONCE as a zero-copy view and
// its bytes are streamed into a fresh builder per rep via `appendBytes` (no per-line owned prefix string).
// The render loop measures the borrow -> render -> free cycle; the three real nsieve lines are printed once.
import str;
import collections.string_builder;

struct Sieve {
    pub flags: bool[160000],
    pub limit: int,
    init(cap: int) { self.flags = [false; 160000]; self.limit = cap; }
    fn run(self: Sieve, m: int): int {
        let i = 0; while (i < m) { self.flags[i] = true; i = i + 1; }
        let count = 0; i = 2;
        while (i < m) {
            if (self.flags[i]) {
                count = count + 1;
                let j = i + i; while (j < m) { self.flags[j] = false; j = j + i; }
            }
            i = i + 1;
        }
        return count;
    }
}

const RENDER_REPS: int = 120000;

fn main(): int {
    let s = Sieve(160000);
    let c0 = s.run(10000 * 16);
    let c1 = s.run(10000 * 8);
    let c2 = s.run(10000 * 4);

    // Borrow the label ONCE: a {ptr,len} view over a constant literal (lives for the whole program).
    let label = str.of("Primes up to ");
    let checksum: long = 0;
    let rep = 0;
    while (rep < RENDER_REPS) {
        let sb = string_builder.StringBuilder();
        // Stream the borrowed prefix bytes straight in -- no owned "Primes up to " string is minted.
        sb.appendBytes(label.ptr, label.len);
        sb.append(`${10000 * 16} ${c0}`);
        checksum = checksum + (sb.len as long);
        sb.delete();
        rep = rep + 1;
    }

    console.log(`Primes up to ${10000 * 16} ${c0}`);
    console.log(`Primes up to ${10000 * 8} ${c1}`);
    console.log(`Primes up to ${10000 * 4} ${c2}`);
    console.log(`rendered ${RENDER_REPS} lines from borrow, checksum ${checksum}`);
    return 0;
}
