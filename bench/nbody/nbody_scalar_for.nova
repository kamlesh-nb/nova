import math;
const PI: double = 3.141592653589793;
const SOLAR_MASS: double = 4.0 * PI * PI;
const DAYS_PER_YEAR: double = 365.24;
const N: int = 1000000;
fn pad9(n: long): string { let s = `${n}`; while (s.length < 9) { s = "0" + s; } return s; }
fn fixed9(v: double): string { let neg = v < 0.0; let a = if (neg) 0.0 - v else v;
  let scaled = (a * 1000000000.0 + 0.5) as long; let ip = scaled / 1000000000; let fp = scaled - ip * 1000000000;
  let sign = if (neg) "-" else ""; return sign + `${ip}` + "." + pad9(fp); }
fn main(): int {
  let x0 = 0.0; let y0 = 0.0; let z0 = 0.0;
  let vx0 = (0.0) * DAYS_PER_YEAR; let vy0 = (0.0) * DAYS_PER_YEAR; let vz0 = (0.0) * DAYS_PER_YEAR;
  let m0 = 1.0 * SOLAR_MASS;
  let x1 = 4.8414314424647209; let y1 = 0.0 - 1.16032004402742839; let z1 = 0.0 - 0.103622044471123109;
  let vx1 = (0.00166007664274403694) * DAYS_PER_YEAR; let vy1 = (0.00769901118419740425) * DAYS_PER_YEAR; let vz1 = (0.0 - 0.0000690460016972063023) * DAYS_PER_YEAR;
  let m1 = 0.000954791938424326609 * SOLAR_MASS;
  let x2 = 8.34336671824457987; let y2 = 4.12479856412430479; let z2 = 0.0 - 0.403523417114321381;
  let vx2 = (0.0 - 0.00276742510726862411) * DAYS_PER_YEAR; let vy2 = (0.00499852801234917238) * DAYS_PER_YEAR; let vz2 = (0.0000230417297573763929) * DAYS_PER_YEAR;
  let m2 = 0.000285885980666130812 * SOLAR_MASS;
  let x3 = 12.8943695621391310; let y3 = 0.0 - 15.1111514016986312; let z3 = 0.0 - 0.223307578892655734;
  let vx3 = (0.00296460137564761618) * DAYS_PER_YEAR; let vy3 = (0.00237847173959480950) * DAYS_PER_YEAR; let vz3 = (0.0 - 0.0000296589568540237556) * DAYS_PER_YEAR;
  let m3 = 0.0000436624404335156298 * SOLAR_MASS;
  let x4 = 15.3796971148509165; let y4 = 0.0 - 25.9193146099879641; let z4 = 0.179258772950371181;
  let vx4 = (0.00268067772490389322) * DAYS_PER_YEAR; let vy4 = (0.00162824170038242295) * DAYS_PER_YEAR; let vz4 = (0.0 - 0.0000951592254519715870) * DAYS_PER_YEAR;
  let m4 = 0.0000515138902046611451 * SOLAR_MASS;
  let px = vx0*m0 + vx1*m1 + vx2*m2 + vx3*m3 + vx4*m4;
  let py = vy0*m0 + vy1*m1 + vy2*m2 + vy3*m3 + vy4*m4;
  let pz = vz0*m0 + vz1*m1 + vz2*m2 + vz3*m3 + vz4*m4;
  vx0 = 0.0 - px / SOLAR_MASS; vy0 = 0.0 - py / SOLAR_MASS; vz0 = 0.0 - pz / SOLAR_MASS;
  let e0 = 0.0;
  e0 = e0 + 0.5 * m0 * (vx0*vx0 + vy0*vy0 + vz0*vz0);
  e0 = e0 + 0.5 * m1 * (vx1*vx1 + vy1*vy1 + vz1*vz1);
  e0 = e0 + 0.5 * m2 * (vx2*vx2 + vy2*vy2 + vz2*vz2);
  e0 = e0 + 0.5 * m3 * (vx3*vx3 + vy3*vy3 + vz3*vz3);
  e0 = e0 + 0.5 * m4 * (vx4*vx4 + vy4*vy4 + vz4*vz4);
  { let dx = x0-x1; let dy = y0-y1; let dz = z0-z1;
    e0 = e0 - (m0*m1) / math.fsqrt(dx*dx+dy*dy+dz*dz); }
  { let dx = x0-x2; let dy = y0-y2; let dz = z0-z2;
    e0 = e0 - (m0*m2) / math.fsqrt(dx*dx+dy*dy+dz*dz); }
  { let dx = x0-x3; let dy = y0-y3; let dz = z0-z3;
    e0 = e0 - (m0*m3) / math.fsqrt(dx*dx+dy*dy+dz*dz); }
  { let dx = x0-x4; let dy = y0-y4; let dz = z0-z4;
    e0 = e0 - (m0*m4) / math.fsqrt(dx*dx+dy*dy+dz*dz); }
  { let dx = x1-x2; let dy = y1-y2; let dz = z1-z2;
    e0 = e0 - (m1*m2) / math.fsqrt(dx*dx+dy*dy+dz*dz); }
  { let dx = x1-x3; let dy = y1-y3; let dz = z1-z3;
    e0 = e0 - (m1*m3) / math.fsqrt(dx*dx+dy*dy+dz*dz); }
  { let dx = x1-x4; let dy = y1-y4; let dz = z1-z4;
    e0 = e0 - (m1*m4) / math.fsqrt(dx*dx+dy*dy+dz*dz); }
  { let dx = x2-x3; let dy = y2-y3; let dz = z2-z3;
    e0 = e0 - (m2*m3) / math.fsqrt(dx*dx+dy*dy+dz*dz); }
  { let dx = x2-x4; let dy = y2-y4; let dz = z2-z4;
    e0 = e0 - (m2*m4) / math.fsqrt(dx*dx+dy*dy+dz*dz); }
  { let dx = x3-x4; let dy = y3-y4; let dz = z3-z4;
    e0 = e0 - (m3*m4) / math.fsqrt(dx*dx+dy*dy+dz*dz); }
  console.log(fixed9(e0));
  for (step in 0..N) {
    let dt = 0.01;
    { let dx = x0-x1; let dy = y0-y1; let dz = z0-z1;
      let d2 = dx*dx+dy*dy+dz*dz; let dist = math.fsqrt(d2); let mag = dt/(d2*dist);
      vx0 = vx0 - dx*m1*mag; vy0 = vy0 - dy*m1*mag; vz0 = vz0 - dz*m1*mag;
      vx1 = vx1 + dx*m0*mag; vy1 = vy1 + dy*m0*mag; vz1 = vz1 + dz*m0*mag; }
    { let dx = x0-x2; let dy = y0-y2; let dz = z0-z2;
      let d2 = dx*dx+dy*dy+dz*dz; let dist = math.fsqrt(d2); let mag = dt/(d2*dist);
      vx0 = vx0 - dx*m2*mag; vy0 = vy0 - dy*m2*mag; vz0 = vz0 - dz*m2*mag;
      vx2 = vx2 + dx*m0*mag; vy2 = vy2 + dy*m0*mag; vz2 = vz2 + dz*m0*mag; }
    { let dx = x0-x3; let dy = y0-y3; let dz = z0-z3;
      let d2 = dx*dx+dy*dy+dz*dz; let dist = math.fsqrt(d2); let mag = dt/(d2*dist);
      vx0 = vx0 - dx*m3*mag; vy0 = vy0 - dy*m3*mag; vz0 = vz0 - dz*m3*mag;
      vx3 = vx3 + dx*m0*mag; vy3 = vy3 + dy*m0*mag; vz3 = vz3 + dz*m0*mag; }
    { let dx = x0-x4; let dy = y0-y4; let dz = z0-z4;
      let d2 = dx*dx+dy*dy+dz*dz; let dist = math.fsqrt(d2); let mag = dt/(d2*dist);
      vx0 = vx0 - dx*m4*mag; vy0 = vy0 - dy*m4*mag; vz0 = vz0 - dz*m4*mag;
      vx4 = vx4 + dx*m0*mag; vy4 = vy4 + dy*m0*mag; vz4 = vz4 + dz*m0*mag; }
    { let dx = x1-x2; let dy = y1-y2; let dz = z1-z2;
      let d2 = dx*dx+dy*dy+dz*dz; let dist = math.fsqrt(d2); let mag = dt/(d2*dist);
      vx1 = vx1 - dx*m2*mag; vy1 = vy1 - dy*m2*mag; vz1 = vz1 - dz*m2*mag;
      vx2 = vx2 + dx*m1*mag; vy2 = vy2 + dy*m1*mag; vz2 = vz2 + dz*m1*mag; }
    { let dx = x1-x3; let dy = y1-y3; let dz = z1-z3;
      let d2 = dx*dx+dy*dy+dz*dz; let dist = math.fsqrt(d2); let mag = dt/(d2*dist);
      vx1 = vx1 - dx*m3*mag; vy1 = vy1 - dy*m3*mag; vz1 = vz1 - dz*m3*mag;
      vx3 = vx3 + dx*m1*mag; vy3 = vy3 + dy*m1*mag; vz3 = vz3 + dz*m1*mag; }
    { let dx = x1-x4; let dy = y1-y4; let dz = z1-z4;
      let d2 = dx*dx+dy*dy+dz*dz; let dist = math.fsqrt(d2); let mag = dt/(d2*dist);
      vx1 = vx1 - dx*m4*mag; vy1 = vy1 - dy*m4*mag; vz1 = vz1 - dz*m4*mag;
      vx4 = vx4 + dx*m1*mag; vy4 = vy4 + dy*m1*mag; vz4 = vz4 + dz*m1*mag; }
    { let dx = x2-x3; let dy = y2-y3; let dz = z2-z3;
      let d2 = dx*dx+dy*dy+dz*dz; let dist = math.fsqrt(d2); let mag = dt/(d2*dist);
      vx2 = vx2 - dx*m3*mag; vy2 = vy2 - dy*m3*mag; vz2 = vz2 - dz*m3*mag;
      vx3 = vx3 + dx*m2*mag; vy3 = vy3 + dy*m2*mag; vz3 = vz3 + dz*m2*mag; }
    { let dx = x2-x4; let dy = y2-y4; let dz = z2-z4;
      let d2 = dx*dx+dy*dy+dz*dz; let dist = math.fsqrt(d2); let mag = dt/(d2*dist);
      vx2 = vx2 - dx*m4*mag; vy2 = vy2 - dy*m4*mag; vz2 = vz2 - dz*m4*mag;
      vx4 = vx4 + dx*m2*mag; vy4 = vy4 + dy*m2*mag; vz4 = vz4 + dz*m2*mag; }
    { let dx = x3-x4; let dy = y3-y4; let dz = z3-z4;
      let d2 = dx*dx+dy*dy+dz*dz; let dist = math.fsqrt(d2); let mag = dt/(d2*dist);
      vx3 = vx3 - dx*m4*mag; vy3 = vy3 - dy*m4*mag; vz3 = vz3 - dz*m4*mag;
      vx4 = vx4 + dx*m3*mag; vy4 = vy4 + dy*m3*mag; vz4 = vz4 + dz*m3*mag; }
    x0 = x0 + dt*vx0; y0 = y0 + dt*vy0; z0 = z0 + dt*vz0;
    x1 = x1 + dt*vx1; y1 = y1 + dt*vy1; z1 = z1 + dt*vz1;
    x2 = x2 + dt*vx2; y2 = y2 + dt*vy2; z2 = z2 + dt*vz2;
    x3 = x3 + dt*vx3; y3 = y3 + dt*vy3; z3 = z3 + dt*vz3;
    x4 = x4 + dt*vx4; y4 = y4 + dt*vy4; z4 = z4 + dt*vz4;
  }
  let e1 = 0.0;
  e1 = e1 + 0.5 * m0 * (vx0*vx0 + vy0*vy0 + vz0*vz0);
  e1 = e1 + 0.5 * m1 * (vx1*vx1 + vy1*vy1 + vz1*vz1);
  e1 = e1 + 0.5 * m2 * (vx2*vx2 + vy2*vy2 + vz2*vz2);
  e1 = e1 + 0.5 * m3 * (vx3*vx3 + vy3*vy3 + vz3*vz3);
  e1 = e1 + 0.5 * m4 * (vx4*vx4 + vy4*vy4 + vz4*vz4);
  { let dx = x0-x1; let dy = y0-y1; let dz = z0-z1;
    e1 = e1 - (m0*m1) / math.fsqrt(dx*dx+dy*dy+dz*dz); }
  { let dx = x0-x2; let dy = y0-y2; let dz = z0-z2;
    e1 = e1 - (m0*m2) / math.fsqrt(dx*dx+dy*dy+dz*dz); }
  { let dx = x0-x3; let dy = y0-y3; let dz = z0-z3;
    e1 = e1 - (m0*m3) / math.fsqrt(dx*dx+dy*dy+dz*dz); }
  { let dx = x0-x4; let dy = y0-y4; let dz = z0-z4;
    e1 = e1 - (m0*m4) / math.fsqrt(dx*dx+dy*dy+dz*dz); }
  { let dx = x1-x2; let dy = y1-y2; let dz = z1-z2;
    e1 = e1 - (m1*m2) / math.fsqrt(dx*dx+dy*dy+dz*dz); }
  { let dx = x1-x3; let dy = y1-y3; let dz = z1-z3;
    e1 = e1 - (m1*m3) / math.fsqrt(dx*dx+dy*dy+dz*dz); }
  { let dx = x1-x4; let dy = y1-y4; let dz = z1-z4;
    e1 = e1 - (m1*m4) / math.fsqrt(dx*dx+dy*dy+dz*dz); }
  { let dx = x2-x3; let dy = y2-y3; let dz = z2-z3;
    e1 = e1 - (m2*m3) / math.fsqrt(dx*dx+dy*dy+dz*dz); }
  { let dx = x2-x4; let dy = y2-y4; let dz = z2-z4;
    e1 = e1 - (m2*m4) / math.fsqrt(dx*dx+dy*dy+dz*dz); }
  { let dx = x3-x4; let dy = y3-y4; let dz = z3-z4;
    e1 = e1 - (m3*m4) / math.fsqrt(dx*dx+dy*dy+dz*dz); }
  console.log(fixed9(e1));
  return 0;
}
