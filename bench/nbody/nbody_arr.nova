import math;

const PI: double = 3.141592653589793;
const SOLAR_MASS: double = 4.0 * PI * PI;
const DAYS_PER_YEAR: double = 365.24;
const NB: int = 5;
const N: int = 1000000;

fn pad9(n: long): string { let s = `${n}`; while (s.length < 9) { s = "0" + s; } return s; }
fn fixed9(v: double): string {
    let neg = v < 0.0; let a = if (neg) 0.0 - v else v;
    let scaled = (a * 1000000000.0 + 0.5) as long; let ip = scaled / 1000000000; let fp = scaled - ip * 1000000000;
    return (if (neg) "-" else "") + `${ip}` + "." + pad9(fp);
}

fn main(): int {
    let x: double[5] = [0.0, 4.8414314424647209, 8.34336671824457987, 12.8943695621391310, 15.3796971148509165];
    let y: double[5] = [0.0, 0.0 - 1.16032004402742839, 4.12479856412430479, 0.0 - 15.1111514016986312, 0.0 - 25.9193146099879641];
    let z: double[5] = [0.0, 0.0 - 0.103622044471123109, 0.0 - 0.403523417114321381, 0.0 - 0.223307578892655734, 0.179258772950371181];
    let vx: double[5] = [0.0, 0.00166007664274403694, 0.0 - 0.00276742510726862411, 0.00296460137564761618, 0.00268067772490389322];
    let vy: double[5] = [0.0, 0.00769901118419740425, 0.00499852801234917238, 0.00237847173959480950, 0.00162824170038242295];
    let vz: double[5] = [0.0, 0.0 - 0.0000690460016972063023, 0.0000230417297573763929, 0.0 - 0.0000296589568540237556, 0.0 - 0.0000951592254519715870];
    let mass: double[5] = [1.0, 0.000954791938424326609, 0.000285885980666130812, 0.0000436624404335156298, 0.0000515138902046611451];

    let s = 0;
    while (s < NB) {
        vx[s] = vx[s] * DAYS_PER_YEAR; vy[s] = vy[s] * DAYS_PER_YEAR; vz[s] = vz[s] * DAYS_PER_YEAR;
        mass[s] = mass[s] * SOLAR_MASS;
        s = s + 1;
    }

    let px = 0.0; let py = 0.0; let pz = 0.0; let k = 0;
    while (k < NB) { px = px + vx[k] * mass[k]; py = py + vy[k] * mass[k]; pz = pz + vz[k] * mass[k]; k = k + 1; }
    vx[0] = 0.0 - px / SOLAR_MASS; vy[0] = 0.0 - py / SOLAR_MASS; vz[0] = 0.0 - pz / SOLAR_MASS;

    let e0 = 0.0; let i = 0;
    while (i < NB) {
        e0 = e0 + 0.5 * mass[i] * (vx[i]*vx[i] + vy[i]*vy[i] + vz[i]*vz[i]);
        let j = i + 1;
        while (j < NB) {
            let dx = x[i]-x[j]; let dy = y[i]-y[j]; let dz = z[i]-z[j];
            e0 = e0 - (mass[i]*mass[j]) / math.fsqrt(dx*dx+dy*dy+dz*dz);
            j = j + 1;
        }
        i = i + 1;
    }
    console.log(fixed9(e0));

    let step = 0;
    while (step < N) {
        let dt = 0.01; let a = 0;
        while (a < NB) {
            let ivx = vx[a]; let ivy = vy[a]; let ivz = vz[a];
            let b = a + 1;
            while (b < NB) {
                let dx = x[a]-x[b]; let dy = y[a]-y[b]; let dz = z[a]-z[b];
                let d2 = dx*dx+dy*dy+dz*dz; let dist = math.fsqrt(d2); let mag = dt/(d2*dist);
                let mb = mass[b]; let ma = mass[a];
                ivx = ivx - dx*mb*mag; ivy = ivy - dy*mb*mag; ivz = ivz - dz*mb*mag;
                vx[b] = vx[b] + dx*ma*mag; vy[b] = vy[b] + dy*ma*mag; vz[b] = vz[b] + dz*ma*mag;
                b = b + 1;
            }
            vx[a] = ivx; vy[a] = ivy; vz[a] = ivz;
            x[a] = x[a] + dt*ivx; y[a] = y[a] + dt*ivy; z[a] = z[a] + dt*ivz;
            a = a + 1;
        }
        step = step + 1;
    }

    let e1 = 0.0; let p = 0;
    while (p < NB) {
        e1 = e1 + 0.5 * mass[p] * (vx[p]*vx[p] + vy[p]*vy[p] + vz[p]*vz[p]);
        let q = p + 1;
        while (q < NB) {
            let dx = x[p]-x[q]; let dy = y[p]-y[q]; let dz = z[p]-z[q];
            e1 = e1 - (mass[p]*mass[q]) / math.fsqrt(dx*dx+dy*dy+dz*dz);
            q = q + 1;
        }
        p = p + 1;
    }
    console.log(fixed9(e1));
    return 0;
}
