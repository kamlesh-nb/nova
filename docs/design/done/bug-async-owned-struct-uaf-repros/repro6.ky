import list;
import string;

struct Item {
    pub name: string,
    init(n: string) { self.name = n; }
}

struct Cur {
    pub batch: list.List<Item>,
    pub pos: int,
    init() { self.batch = list.List<Item>(); self.pos = 0; }

    pub async fn next(self: Cur): Item | undefined {
        if (self.pos < self.batch.size()) {
            let it = self.batch.get(self.pos) ?? Item("NONE");
            self.pos = self.pos + 1;
            return it;
        }
        return undefined;
    }
}

async fn suspendOnce(): int { return 1; }

async fn find(): Cur {
    let _ = await suspendOnce();
    let cur = Cur();
    cur.batch.push(Item("marg" + "herita"));
    cur.batch.push(Item("pep" + "peroni"));
    return cur;
}

async fn run(): void {
    let cur = await find();
    let out = list.List<string>();
    while (true) {
        let dn = await cur.next();
        if (dn == undefined) { break; }
        out.push(dn.name);
    }
    console.log(`collected=${out.size()} first=${out.get(0) ?? "?"}`);
}

fn main(): void {
    console.log("start");
    run();
    console.log("done");
}
