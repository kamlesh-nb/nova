import list;

struct Box {
    pub batch: list.List<int>,
    init() { self.batch = list.List<int>(); }
}

async fn suspendOnce(): int { return 1; }

fn makeBox(): Box {
    let b = Box();
    b.batch.push(10); b.batch.push(20); b.batch.push(30);
    return b;
}

async fn readViaFreeAsync(b: Box): int {
    return b.batch.size();
}

fn readViaSync(b: Box): int {
    return b.batch.size();
}

async fn run(): void {
    let b1 = makeBox();
    console.log(`SYNC pass-by-value:  size=${readViaSync(b1)}`);

    let b2 = makeBox();
    let r = await readViaFreeAsync(b2);
    console.log(`ASYNC pass-by-value: size=${r}`);
}

fn main(): void {
    console.log("start");
    run();
    console.log("done");
}
