import list;

struct Box {
    pub batch: list.List<int>,
    init() { self.batch = list.List<int>(); }
}

async fn suspendOnce(): int { return 1; }

async fn make(): Box {
    let _ = await suspendOnce();
    let b = Box();
    b.batch.push(10);
    b.batch.push(20);
    b.batch.push(30);
    return b;
}

async fn readFirst(self: Box): int {
    let n = self.batch.size();
    if (n <= 0) { return -1; }
    return self.batch.get(0) ?? -1;
}

async fn run(): void {
    let b = await make();
    let v = await b.readFirst();
    console.log(`readFirst=${v}`);
}

fn main(): void {
    console.log("repro: async fn returning a struct that owns a List");
    run();
    console.log("done (no crash)");
}
