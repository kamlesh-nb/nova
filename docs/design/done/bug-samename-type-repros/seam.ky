import list;
pub struct Row { pub v: int, init(x: int) { self.v = x; } }
pub struct Cursor {
    pub source: int,
    pub batch: list.List<Row>,
    pub pos: int,
    init() { self.source = 0; self.batch = list.List<Row>(); self.pos = 0; }
    pub fn next(self: Cursor): int {
        return self.batch.size();
    }
}
