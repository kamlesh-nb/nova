// main.nova, the composition root. It constructs the app-wide dependencies ONCE, then hands them to
// each feature's `register(...)` so the feature can wire its own routes. A route maps a path to a
// handler INSTANCE that implements `RouteHandler` (one uniform `async serve(ctx): Response` method)
// and holds its dependencies as fields. There is no mediator and no DI container: dependencies are
// plain constructor arguments, resolved right here where you can see them.
//
// This default build uses an in-memory Connection so it runs and its tests pass with no database.
// `main_postgres.nova` is the SAME app over a real PostgreSQL connection; only this file changes.
import web.app;
import Features.Products.Shared.database;
import Features.Products.Shared.repository;
import Features.Products.routes;

fn buildApp(): App {
    let app = App();

    // Build the shared dependencies once. The repository takes any `Connection`; here that is the
    // in-memory one. Then let each feature register its routes against them.
    let conn = InMemoryConnection();
    let repo = ProductRepository(conn);
    registerProducts(app, repo);

    // Serve static assets (wwwroot/) for any unmatched GET.
    app.useStatic("/", "./wwwroot");
    return app;
}

fn main(): void {
    let app = buildApp();
    // Configuration is read by the framework from app.yaml at the project root into `app.config` when
    // `App()` is constructed (no environment variables -- they collide when several apps share a machine).
    // The port comes from `--port N` if the orchestrator passed one, else `config.port` in app.yaml, else
    // 8080. A typed section binds with `app.config.bind<T>("name")`.
    let port = app.config.port(8080);
    console.log("Listening on http://127.0.0.1:" + `${port}`);
    app.run(port);
}
