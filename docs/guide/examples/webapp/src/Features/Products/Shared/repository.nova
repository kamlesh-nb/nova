import list;
import data.db;
import data.orm;
import Domain.Dtos.ProductDto;

// The repository is the ONE place that knows SQL. Handlers depend on it, never on a connection or a
// driver. Its field is the `Connection` TRAIT, not a concrete type, so the same repository runs over
// the in-memory connection (offline, in tests) and over a real NovaDB/Postgres connection with no
// change. Parameters are built with `db.dbInt`/`db.dbText`/`db.dbLong` and bound to `$1,$2,...`; the
// micro-ORM (`orm.bindOne`/`orm.bindAll`) maps result rows onto `ProductDto` by column name.
pub struct ProductRepository {
    conn: Connection,
    init(conn: Connection) { self.conn = conn; }

    pub async fn findById(self: ProductRepository, id: int): ProductDto | undefined {
        let params = List<DbValue>();
        params.push(db.dbInt(id));
        let rs = await self.conn.query("SELECT id, name, price FROM products WHERE id = $1", params);
        return orm.bindOne<ProductDto>(rs);
    }

    pub async fn findAll(self: ProductRepository): List<ProductDto> {
        let rs = await self.conn.query("SELECT id, name, price FROM products", List<DbValue>());
        return orm.bindAll<ProductDto>(rs);
    }

    pub async fn create(self: ProductRepository, name: string, price: int): int {
        let params = List<DbValue>();
        params.push(db.dbText(name));
        params.push(db.dbLong(price));
        let r = await self.conn.exec("INSERT INTO products (name, price) VALUES ($1, $2)", params);
        return r.rows_affected as int;
    }
}
