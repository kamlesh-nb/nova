import web.mediator;
import web.response;
import web.status;
import web.di;
import data.db;
import Features.Products.Shared.repository;

// A logging behaviour: wraps every handler, tags the response with the request type it handled. A real
// one would time the request and write a structured log line. Being outermost, it sees the final
// Response whether the handler ran or a behaviour short-circuited.
pub struct LoggingBehavior impl PipelineBehavior {
    async fn handle(self: LoggingBehavior, ctx: RequestContext, next: Next): Response {
        let res = await next.proceed(ctx);
        res.setHeader("X-Handled-By", ctx.requestType);
        return res;
    }
}

// A transaction / unit-of-work behaviour: it opens a transaction on the request's SCOPED connection
// (the same instance the handler's repository uses), runs the handler, and commits on success or rolls
// back on an error response. This is why `send` opens one DI scope per request: the behaviour and the
// handler share the connection.
pub struct TransactionBehavior impl PipelineBehavior {
    async fn handle(self: TransactionBehavior, ctx: RequestContext, next: Next): Response {
        // Resolve the SAME scoped repository the handler will use, and open the transaction on its
        // connection. Going through the repository keeps this behaviour driver-agnostic: it never names
        // the concrete connection type, so it works unchanged for the in-memory store and for NovaDB.
        let repo = ctx.scope.require("ProductRepository") as ProductRepository;
        let conn = repo.connection();
        let _ = await conn.begin();
        let res = await next.proceed(ctx);
        if (res.status.toCode() < 400) {
            let _ = await conn.commit();
        } else {
            let _ = await conn.rollback();
        }
        return res;
    }
}
