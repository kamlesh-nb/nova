import list;
import data.db;
import pool;
import postgres;

// A `Connection` backed by a connection POOL. This is what `main_postgres.nova` passes to the repository
// instead of the in-memory connection, so the SAME repository code runs against a real database.
//
// Why a pool and not a single eager connection: opening a connection is async, and driving an async
// call to completion from the synchronous `main` (before the event loop starts) is not supported. A
// `pool.Pool` is built synchronously and opens its connections LAZILY, inside a request, where the
// handler is already `await`-ing. So we construct this adapter at composition time with no I/O, and
// the first real connect happens on the first `acquire` during a request. The pool also gives you
// concurrency (many in-flight requests) and connection reuse for free.
//
// Each call acquires a connection, runs the statement, and releases it. That is correct for the
// single-statement queries this app issues. A multi-statement TRANSACTION must run on ONE connection,
// so for that you acquire a connection explicitly and pass it to a `Repository<T>` (see chapter 20).
pub struct PooledConnection impl Connection {
    p: pool.Pool,

    init(dsn: string, size: int) {
        self.p = pool.Pool(PgDriver(), dsn, size);
        self.p.configure(size, 0, false);
    }

    async fn query(self: PooledConnection, sql: string, params: List<DbValue>): ResultSet {
        let c = await self.p.acquire();
        let rs = await c.query(sql, params);
        self.p.release(c);
        return rs;
    }

    async fn exec(self: PooledConnection, sql: string, params: List<DbValue>): ExecResult {
        let c = await self.p.acquire();
        let r = await c.exec(sql, params);
        self.p.release(c);
        return r;
    }

    async fn queryWire(self: PooledConnection, sql: string, params: List<DbValue>): WireRows {
        let c = await self.p.acquire();
        let w = await c.queryWire(sql, params);
        self.p.release(c);
        return w;
    }

    // Prepared statements and transactions are per-connection state; a pooled adapter that acquires a
    // fresh connection per call cannot span them. This app uses neither, so these acquire, delegate,
    // and release for completeness. For real transactions, acquire a connection yourself.
    async fn prepare(self: PooledConnection, sql: string): int {
        let c = await self.p.acquire();
        let s = await c.prepare(sql);
        self.p.release(c);
        return s;
    }
    async fn queryPrepared(self: PooledConnection, stmt: int, params: List<DbValue>): ResultSet {
        let c = await self.p.acquire();
        let rs = await c.queryPrepared(stmt, params);
        self.p.release(c);
        return rs;
    }
    async fn execPrepared(self: PooledConnection, stmt: int, params: List<DbValue>): ExecResult {
        let c = await self.p.acquire();
        let r = await c.execPrepared(stmt, params);
        self.p.release(c);
        return r;
    }
    async fn begin(self: PooledConnection): ExecResult {
        let c = await self.p.acquire();
        let r = await c.begin(); self.p.release(c); return r;
    }
    async fn commit(self: PooledConnection): ExecResult {
        let c = await self.p.acquire();
        let r = await c.commit(); self.p.release(c); return r;
    }
    async fn rollback(self: PooledConnection): ExecResult {
        let c = await self.p.acquire();
        let r = await c.rollback(); self.p.release(c); return r;
    }

    fn close(self: PooledConnection): void {}
    fn setTimeout(self: PooledConnection, ms: int): int { return 0; }
}
