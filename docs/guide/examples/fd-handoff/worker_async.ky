// Reactor-driven counterpart to worker.ky, written to close the one open question about the
// fd-handoff: does a socket received over SCM_RIGHTS behave when it is subsequently driven by the
// REACTOR rather than by blocking syscalls?
//
// worker.ky proves the handoff mechanic, but it serves the client with blocking send/recv and so
// never enters the reactor at all -- running it under KYTE_REACTOR=uring changes nothing, and
// KYTE_IO_WATCHDOG=1 prints nothing, because no reactor loop is ever driven. That makes it unable to
// say anything about io_uring.
//
// This worker registers the inherited fd with net.poller.Reactor and waits for readability there
// before reading, so the same binary exercises epoll or io_uring purely by KYTE_REACTOR. That is the
// interesting axis: on a readiness engine (epoll) an inherited fd is just an interest registration,
// while on a completion engine (io_uring) readiness is emulated with a zero-byte receive, and the
// socket arrives mid-life from another process rather than from this process's own accept().
import os.socket;
import os.sys;
import net.poller;
import bytes;
import string;
import env;

const SOCK_PATH: string = "/tmp/kyte_handoff.sock";

fn requestLine(req: string): string {
    let i = 0;
    while (i < req.length) {
        let c = req[i];
        if (c == 13 || c == 10) { return string.slice(req, 0, i); }
        i = i + 1;
    }
    return req;
}

fn main(): int {
    let id = env.get("WORKER_ID");
    if (id == "") { id = "async-worker"; }

    let r = poller.Reactor(64, 8192, 16);
    if (!r.ok()) { console.log(id + ": reactor init failed"); return 1; }

    let ua = socket.makeSockaddrUn(SOCK_PATH);
    let ctrl = socket.newUnix();
    let ok = -1;
    let tries = 0;
    while (tries < 2000) {
        ok = socket.connectSock(ctrl, ua, socket.sockaddrUnLen());
        if (ok == 0) { break; }
        socket.close(ctrl);
        ctrl = socket.newUnix();
        tries = tries + 1;
    }
    bytes.free(ua);
    if (ok != 0) { console.log(id + ": could not reach router"); return 1; }
    console.log(id + ": connected to router; serving handed-off sockets VIA THE REACTOR");

    let count = 0;
    let viaReactor = 0;
    while (true) {
        let h = socket.recvFd(ctrl, 8192);
        if (h.fd < 0) { console.log(id + ": control channel closed after " + count + " served (" + viaReactor + " via reactor)"); break; }
        count = count + 1;

        // The router already consumed the request bytes and forwarded them as the payload, so the
        // handed-off socket usually has nothing left to read. Register it anyway and poll with a
        // short timeout: that is the operation under test -- arming an INHERITED descriptor on
        // whichever backend is active. A timeout is a pass (the fd was accepted and armed and the
        // reactor stayed healthy); an error return is the failure this exists to catch.
        let armed = r.addRead(h.fd, h.fd as long);
        if (armed == 0) {
            viaReactor = viaReactor + 1;
            let n = r.poll(15);
            if (n > 0) {
                // Data did arrive on the inherited fd -- drain it through the reactor's buffer pool
                // so the read path is exercised too, not just the arm.
                let buf = r.getBuffer();
                if (buf != 0) {
                    let got = sys.read(r.readyFd(0), buf, 4096);
                    if (got < 0) { console.log(id + ": read on handed-off fd failed"); }
                    r.putBuffer(buf);
                }
            }
            r.delRead(h.fd);
        } else {
            console.log(id + ": FAILED to arm inherited fd " + h.fd + " on the reactor");
        }

        let line = requestLine(h.payload);
        let body = `{"served_by":"${id}","request":"${line}","served":${count},"via_reactor":${viaReactor}}`;
        let resp = `HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: ${body.length}\r\nConnection: close\r\n\r\n${body}`;
        socket.sendAll(h.fd, resp as long, resp.length);
        socket.close(h.fd);
    }
    r.destroy();
    return 0;
}
