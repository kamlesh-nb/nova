// Tier 1 — file I/O over os/sys (mingw compat path on Windows). Write, exists, read-back, assert.
import assert;
import io.file;

fn main(): int {
    let path = "nova_ci_fileio.txt";
    file.File.writeText(path, "hello-from-nova");
    assert.isTrue(file.File.exists(path));
    let got = file.File.readText(path);
    assert.equalStr(got, "hello-from-nova");
    console.log("t02_fileio ok");
    return 0;
}
