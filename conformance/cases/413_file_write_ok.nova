import io.file;
import assert;

@test
fn write_ok_to_writable_path(): void {
    let path = "/tmp/nova_writeok_413.txt";
    assert.isTrue(file.File.writeTextOk(path, "hello"));
    assert.equalStr(file.File.readText(path), "hello");
}

@test
fn write_ok_false_on_bad_path(): void {
    assert.isTrue(!file.File.writeTextOk("/no/such/dir/nova_413.txt", "x"));
}
