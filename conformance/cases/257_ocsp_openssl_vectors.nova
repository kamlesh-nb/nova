// Interop: our OCSP revocation path against REAL responses produced by `openssl ocsp`, not our own
// encoder. Case 252 round-trips ocsp.buildTestResponse (byKey responderID, our exact byte layout); this
// case feeds genuine OpenSSL output -- byName responderID ([1]), id-pkix-ocsp-basic-wrapped
// BasicOCSPResponse, ecdsa-with-SHA256 over a SHA-1 CertID -- through the SAME parse + responder-signature
// verify + serial-binding + status decode the live TLS client uses. The vectors were generated by an
// `openssl s_server` OCSP-stapling run (EC P-256 CA + localhost leaf) and captured byte-for-byte off the
// wire, so a green result here is proof the client accepts a `good` staple and rejects a `revoked` one
// from a real responder, decoupled from any socket. See revocation.checkOcspStapled / crypto/ocsp.
import bytes;
import crypto.x509;
import crypto.ocsp;
import crypto.tls.revocation;
import assert;

// DER captured from a live `openssl s_server -status -status_file` handshake (EC P-256 chain).
const LEAF: string = "";
const CA: string   = "";
const GOOD: string = "";
const REVOKED: string = "";
const LEAF_LEN: int = 403;
const CA_LEN: int   = 390;
const GOOD_LEN: int = 265;
const REV_LEN: int  = 284;

fn hexNib(c: int): int { if (c >= 48 && c <= 57) { return c - 48; } if (c >= 97 && c <= 102) { return c - 87; } return 0; }
fn hexBuf(hex: string): ptr {
    let n = hex.length / 2; let b = bytes.alloc(n);
    let i = 0; while (i < n) { bytes.write_byte(b, i, hexNib(hex[i * 2]) * 16 + hexNib(hex[i * 2 + 1])); i = i + 1; }
    return b;
}

// The high-level verdict the live TLS client enforces (chain issuer + stapled OCSP): a real OpenSSL
// `good` response is accepted (REV_GOOD), a real `revoked` response is rejected (REV_REVOKED).
@test
fn openssl_staple_verdict(): void {
    let leaf = x509.parseCert(hexBuf(LEAF), LEAF_LEN);
    let issuer = x509.parseCert(hexBuf(CA), CA_LEN);
    assert.isTrue(leaf.ok);
    assert.isTrue(issuer.ok);
    assert.isTrue(x509.isEcKey(issuer));                 // EC P-256 CA -> responder sig is ecdsa-with-SHA256

    assert.equalInt(revocation.REV_GOOD, revocation.checkOcspStapled(leaf, issuer, hexBuf(GOOD), GOOD_LEN));
    assert.equalInt(revocation.REV_REVOKED, revocation.checkOcspStapled(leaf, issuer, hexBuf(REVOKED), REV_LEN));
}

// The low-level parse must handle OpenSSL's structure: byName responderID, and a certStatus of [0] good
// vs [1] revoked, bound to the leaf's serial. (Case 252 covers our own byKey encoder; this is interop.)
@test
fn openssl_response_parse(): void {
    let leaf = x509.parseCert(hexBuf(LEAF), LEAF_LEN);

    let good = hexBuf(GOOD);
    let rg = ocsp.parseOcspResponse(good, GOOD_LEN);
    assert.isTrue(rg.ok);
    assert.equalInt(0, rg.responseStatus);
    assert.equalInt(ocsp.CERT_GOOD, rg.certStatus);
    // serial in the response is bound to the leaf certificate's serial
    assert.equalInt(leaf.serialLen, rg.serialLen);
    let i = 0;
    while (i < leaf.serialLen) {
        assert.equalInt(bytes.read_byte(hexBuf(LEAF), leaf.serialStart + i), bytes.read_byte(good, rg.serialOff + i));
        i = i + 1;
    }
    assert.isTrue(ocsp.serialMatches(good, rg, (hexBuf(LEAF) as long + leaf.serialStart) as ptr, leaf.serialLen));

    let rev = hexBuf(REVOKED);
    let rr = ocsp.parseOcspResponse(rev, REV_LEN);
    assert.isTrue(rr.ok);
    assert.equalInt(ocsp.CERT_REVOKED, rr.certStatus);
    assert.isTrue(rr.isRevoked());
}

// A response about a DIFFERENT certificate must not be accepted for this leaf: swapping the issuer to the
// leaf itself breaks responder-signature verification, so the verdict degrades to UNKNOWN (soft-fail),
// never a false REV_GOOD/REV_REVOKED. Guards the serial+signature binding.
@test
fn openssl_wrong_issuer_is_unknown(): void {
    let leaf = x509.parseCert(hexBuf(LEAF), LEAF_LEN);
    // leaf is not the OCSP responder; verifying the CA-signed response against the leaf key must fail
    assert.equalInt(revocation.REV_UNKNOWN, revocation.checkOcspStapled(leaf, leaf, hexBuf(GOOD), GOOD_LEN));
}
