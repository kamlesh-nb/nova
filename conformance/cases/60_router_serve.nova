// Flagship: the Router bridges to the async HTTP server via `serve(req): Response`.
// This is the last piece — `server.listen(port, app.serve)` runs the typed mediator
// pipeline over real HTTP. Here we drive it with hand-built Requests (no network) and
// assert the Response: matched -> 200 + JSON body, wrong method -> 405, no path -> 404.
import assert;
import web.routing;
import web.request;
import web.status;

@serializable struct GetUser { pub id: int }
@serializable struct UserDto { pub id: int, pub name: string }
struct GetUserHandler impl RequestHandler<GetUser, UserDto> {
    async fn handle(self, req: GetUser): UserDto { return UserDto{ id: req.id, name: "Ada" }; }
}

fn makeReq(method: string, path: string, body: string): request.Request {
    let r = request.Request.empty();
    r.method = method;
    r.path = path;
    r.body = body;
    return r;
}

@test
fn test_serve_matched_is_200_json(): void {
    let app = Router();
    app.get<GetUser>("/api/user/{id:int}");
    let res = app.serve(makeReq("GET", "/api/user/42", ""));
    let ok = res.status == Status.Ok;
    assert.isTrue(ok);
    assert.equalStr(res.body, "{\"id\":42,\"name\":\"Ada\"}");
}

@test
fn test_serve_wrong_method_is_405(): void {
    let app = Router();
    app.get<GetUser>("/api/user/{id:int}");
    // path matches, method does not -> 405 (not 404)
    let res = app.serve(makeReq("POST", "/api/user/42", "{}"));
    let mna = res.status == Status.MethodNotAllowed;
    assert.isTrue(mna);
}

@test
fn test_serve_no_path_is_404(): void {
    let app = Router();
    app.get<GetUser>("/api/user/{id:int}");
    let res = app.serve(makeReq("GET", "/nope", "{}"));
    let nf = res.status == Status.NotFound;
    assert.isTrue(nf);
}
