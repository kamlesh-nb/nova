import assert;

fn half(x: double): double { return x / 2.0; }

@test
fn test_inline_float_arith(): void {
    let m = 10.0 / 4.0;
    assert.isTrue(m > 2.0);
    assert.isTrue(m < 3.0);
    let s = 1.5 + 2.5;
    assert.isTrue(s > 3.9);
    assert.isTrue(s < 4.1);
    let p = 3.0 * 3.0;
    assert.isTrue(p > 8.9);
    let d = 5.5 - 1.5;
    assert.isTrue(d > 3.9);
}

@test
fn test_float_through_function(): void {
    let b = half(7.0);
    assert.isTrue(b > 3.0);
    assert.isTrue(b < 4.0);
}

@test
fn test_float_through_if_expr(): void {
    let cond = true;
    let x = if (cond) 2.5 else 9.5;
    assert.isTrue(x > 2.0);
    assert.isTrue(x < 3.0);
    let y = if (5 > 10) 1.5 else 4.25;
    assert.isTrue(y > 4.0);
    assert.isTrue(y < 5.0);
}

@test
fn test_float_arith_chain(): void {
    let a = 1.5;
    let b = 2.0;
    let c = 4.0;
    let r = a * b + c / 2.0;
    assert.isTrue(r > 4.9);
    assert.isTrue(r < 5.1);
}
