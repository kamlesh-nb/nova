// Emit-subset growth (B5, read + construct): a value `struct` flows as the address of its inline bytes (no
// ARC header), so field READS are `base + offset` + load exactly like a heap struct, and CONSTRUCTION uses
// an inline stack alloca (buildValueStructStorage). This lets functions that build a value struct locally and
// read its fields, or take a value-struct param and read it, compile from the optimised IR. A value struct
// that would ESCAPE (returned, or stored into a heap field) is rejected by the return / field gates, so its
// stack storage cannot outlive the function; field WRITES (mutation) still fall back (value-semantics ABI).
// Under NOVA_OPT_EMIT these helpers compile from the emit path; both must agree.
import assert;

struct Rect { pub w: int, pub h: int }
struct P3 { pub x: int, pub y: int, pub z: int }

fn area(r: Rect): int { return r.w * r.h; }             // read a value-struct param
fn perimeter(r: Rect): int { return 2 * (r.w + r.h); }
fn build(): int {                                        // construct locally, read, return int (no escape)
    let p = P3{ x: 3, y: 4, z: 5 };
    return p.x + p.y * p.z;
}

@test
fn test_value_struct(): void {
    let rc = Rect{ w: 4, h: 5 };
    assert.equalInt(area(rc), 20);
    assert.equalInt(perimeter(rc), 18);
    assert.equalInt(build(), 23); // 3 + 4*5
}
