import assert;
import mem.rawbuffer;

struct Point { pub x: int, pub y: int, init(x: int, y: int) { self.x = x; self.y = y; } }

@test
fn test_scalar(): void {
    let b = rawbuffer.RawBuffer<int>(2);
    let i = 0;
    while (i < 10) { b.push(i * 3); i = i + 1; }
    assert.equalInt(b.count(), 10);
    assert.equalInt(b.at(0), 0);
    assert.equalInt(b.at(9), 27);
    b.set(0, 99);
    assert.equalInt(b.at(0), 99);
}

@test
fn test_string_reference(): void {
    let b = rawbuffer.RawBuffer<string>(1);
    b.push("alpha");
    b.push("beta");
    b.push("gamma");
    assert.equalStr(b.at(1), "beta");
    b.set(1, "delta");
    assert.equalStr(b.at(1), "delta");
    assert.equalInt(b.count(), 3);
}

@test
fn test_value_struct(): void {
    let b = rawbuffer.RawBuffer<Point>(1);
    b.push(Point(10, 20));
    b.push(Point(30, 40));
    assert.equalInt(b.at(0).x, 10);
    assert.equalInt(b.at(1).y, 40);
    b.set(0, Point(11, 21));
    assert.equalInt(b.at(0).x, 11);
}
