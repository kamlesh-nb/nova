// Channels 1/3/5 (value-semantics): a "pure value DTO" -- a declared `struct` with only scalar/string/
// nested-pure-value-struct fields and no trait impl -- stays on the heap when it is constructed-and-returned
// (channel 1), serde-bound (3), or passed as a type-param arg (5). Copying it (`let b = a`) must DEEP-COPY
// for value semantics, not alias. The trait/container structs (channels 2/4, the shared-state "should be
// class" types) are deliberately NOT deep-copied and keep reference semantics.
import assert;

struct P { pub x: int, pub y: int, init(a: int, b: int) { self.x = a; self.y = b; } }
struct Owned { pub data: string, pub n: int, init(d: string, k: int) { self.data = d; self.n = k; } }

fn makeP(a: int, b: int): P { return P(a, b); }              // channel 1: constructed + returned
fn makeOwned(i: int): Owned { return Owned("ret-" + istr(i), i); }

@test
fn returned_struct_copy_is_independent(): void {
    let a = makeP(1, 2);
    let b = a;
    b.x = 99;
    assert.equalInt(a.x, 1);        // a untouched (value semantics)
    assert.equalInt(b.x, 99);
    assert.equalInt(a.y, 2);
}

@test
fn returned_owned_copy_is_independent(): void {
    let a = makeOwned(5);
    let b = a;
    b.n = 99;
    assert.equalInt(a.n, 5);
    assert.equalStr(a.data, "ret-5");
}

// Owned inner + copy in a loop: the deep-copy retains the string, so both original and copy drop cleanly
// under the --arc / --asan gates (no leak, no double-free).
@test
fn returned_owned_copy_no_leak(): void {
    let i = 0;
    while (i < 100) {
        let a = makeOwned(i);
        let b = a;
        assert.isTrue(b.data.length > 0);
        i = i + 1;
    }
    assert.isTrue(true);
}

fn istr(n: int): string {
    if (n == 0) { return "0"; }
    let s = "";
    let m = n;
    while (m > 0) { s = dig(m % 10) + s; m = m / 10; }
    return s;
}
fn dig(x: int): string {
    if (x == 0) { return "0"; } if (x == 1) { return "1"; } if (x == 2) { return "2"; }
    if (x == 3) { return "3"; } if (x == 4) { return "4"; } if (x == 5) { return "5"; }
    if (x == 6) { return "6"; } if (x == 7) { return "7"; } if (x == 8) { return "8"; }
    return "9";
}
