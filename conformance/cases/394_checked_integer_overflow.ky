import math;
import assert;
@test
fn checked_int_detects_overflow(): void {
    assert.equalInt(math.checkedAddInt(2000000000, 100000000) ?? -1, 2100000000);
    assert.isTrue(math.checkedAddInt(2147483647, 1) == undefined);
    assert.isTrue(math.checkedMulInt(100000, 100000) == undefined);
    assert.isTrue(math.checkedSubInt(-2147483648, 1) == undefined);
}
@test
fn checked_long_detects_overflow(): void {
    assert.isTrue(math.checkedAddLong(9223372036854775807, 1) == undefined);
}
@test
fn saturating_clamps(): void {
    assert.equalInt(math.satAddInt(2147483647, 1000), 2147483647);
}
