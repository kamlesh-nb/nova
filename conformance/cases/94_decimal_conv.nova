import assert;

@test
fn test_from_int(): void {
    assert.equalStr(`${decimal.fromInt(42)}`, "42");
    assert.equalStr(`${decimal.fromInt(0 - 7)}`, "-7");
    assert.equalStr(`${decimal.fromInt(0)}`, "0");
    assert.equalStr(`${decimal.fromInt(1000000)}`, "1000000");
}

@test
fn test_to_int_truncates_toward_zero(): void {
    assert.equalInt(decimal.toInt(42m), 42);
    assert.equalInt(decimal.toInt(100m), 100);
    assert.equalInt(decimal.toInt(3.99m), 3);
    assert.equalInt(decimal.toInt(-3.99m), 0 - 3);
    assert.equalInt(decimal.toInt(0.5m), 0);
    assert.equalInt(decimal.toInt(-0.9m), 0);
}

@test
fn test_roundtrip(): void {
    let n = 123456789;
    assert.equalInt(decimal.toInt(decimal.fromInt(n)), n);
    assert.equalInt(decimal.toInt(decimal.fromInt(0 - 987654321)), 0 - 987654321);
}

@test
fn test_convert_arith_result(): void {
    assert.equalInt(decimal.toInt(10.5m + 4.5m), 15);
    assert.equalInt(decimal.toInt(7m * 6m), 42);
    assert.equalInt(decimal.toInt(100m / 8m), 12);
}
