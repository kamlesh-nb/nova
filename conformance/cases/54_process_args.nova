// main(args) / command-line arguments (#18 sibling). The runtime `main(argc, argv)` stashes the args;
// `env.args()` builds a `List<string>` from them (the idiomatic accessor, like Rust's env::args()).
// argv[0] — the program path — is always present, so a running test sees size >= 1. Must be leak-free.
import env;
import list;
import assert;

@test
fn test_args_present(): void {
    let a: list.List<string> = env.args();
    assert.isTrue(a.size() >= 1); // argv[0]
}

@test
fn test_args_iterable(): void {
    let a: list.List<string> = env.args();
    let count: int = 0;
    for (x in a) { count = count + 1; }
    assert.isTrue(count >= 1);
    assert.equalInt(count, a.size());
}
