import assert;
import scoped.rec_b;
import scoped.rec_a;

@test
fn test_module_a_rec(): void {
    let a = rec_a.makeA();
    assert.equalInt(a.x, 10);
    assert.equalInt(a.y, 20);
}

@test
fn test_module_b_rec_reads_own_layout(): void {
    let b = rec_b.makeB();
    assert.equalInt(b.tag, 7);
    assert.equalInt(b.items.size(), 1);
}

@test
fn test_both_coexist(): void {
    let a = rec_a.makeA();
    let b = rec_b.makeB();
    assert.equalInt(a.x + b.tag, 17);
}
