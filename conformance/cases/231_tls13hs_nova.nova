// TLS 1.3 handshake authentication in Nova (M9 phase E, no external library). Verified against the RFC
// 8448 "Simple 1-RTT Handshake": the running transcript hash, the server Finished MAC, the server
// CertificateVerify signature (RSA-PSS over the transcript, checked with the leaf cert's key), the
// application traffic secrets, and ServerHello parsing all reproduce the published values.
import crypto.tls13;
import crypto.tls13hs;
import crypto.x509;
import bytes;
import assert;

fn hexNib(c: int): int {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    return 0;
}
fn hexBuf(hex: string): ptr {
    let n = hex.length / 2;
    let b = bytes.alloc(n);
    let i = 0;
    while (i < n) { bytes.write_byte(b, i, hexNib(hex[i * 2]) * 16 + hexNib(hex[i * 2 + 1])); i = i + 1; }
    return b;
}
fn eqHex(buf: ptr, n: int, hex: string): bool {
    if (hex.length != n * 2) { return false; }
    let i = 0;
    while (i < n) {
        if (bytes.read_byte(buf, i) != hexNib(hex[i * 2]) * 16 + hexNib(hex[i * 2 + 1])) { return false; }
        i = i + 1;
    }
    return true;
}
fn at(buf: ptr, off: int): ptr { return (buf as long + off) as ptr; }

const CH: string = "";
const SH: string = "020000560303a6af06a4121860dc5e6e60249cd34c95930c8ac5cb1434dac155772ed3e2692800130100002e00330024001d0020c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f002b00020304";
const PAY: string = "";

const HANDSHAKE: string = "1dc826e93606aa6fdc0aadc12f741b01046aa6b99f691ed221a9f0ca043fbeac";
const SERVER_HS: string  = "b67b7d690cc16c4e75e54213cb2d37b4e9c912bcded9105d42befd59d391ad38";
const MASTER: string     = "18df06843d13a08bf2a449844c5f8a478001bc4d4c627984d5a41da8d0402919";
const C_AP: string       = "9e40646ce79a7f9dc05af8889bce6552875afa0b06df0087f792ebb7c17504a5";
const S_AP: string       = "a11af9f05531f856ad47116b45a950328204b4f44bfb6b3a4b4f1f3fcb631643";
const T_CH_SH: string    = "860c06edc07858ee8e78f0e7428c58edd6b43f2ca3e6e95f02ed063cf0e1cad8";
const T_CH_SF: string    = "9608102a0f1ccc6db6250b7b7e417b1a000eaada3daae4777a7686c9ff83df13";
const SERVER_PUB: string = "c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f";

// The transcript hash of ClientHello..ServerHello matches the RFC value.
@test
fn transcript(): void {
    let t = tls13hs.transcriptNew();
    tls13hs.transcriptAdd(t, hexBuf(CH), 196);
    tls13hs.transcriptAdd(t, hexBuf(SH), 90);
    let h = bytes.alloc(32);
    tls13hs.transcriptHash(0, t, h);
    assert.isTrue(eqHex(h, 32, T_CH_SH));
    tls13hs.transcriptFree(t);
}

// ServerHello parsing extracts the negotiated cipher suite and the server key_share.
@test
fn server_hello(): void {
    let sp = bytes.alloc(32);
    let cipher = tls13hs.parseServerHello(hexBuf(SH), 90, sp);
    assert.equalInt(cipher, 0x1301);              // TLS_AES_128_GCM_SHA256
    assert.isTrue(eqHex(sp, 32, SERVER_PUB));
}

// The server Finished MAC verifies over the transcript through CertificateVerify.
@test
fn server_finished(): void {
    let pay = hexBuf(PAY);
    let t = tls13hs.transcriptNew();
    tls13hs.transcriptAdd(t, hexBuf(CH), 196);
    tls13hs.transcriptAdd(t, hexBuf(SH), 90);
    tls13hs.transcriptAdd(t, at(pay, 0), 40);      // EncryptedExtensions
    tls13hs.transcriptAdd(t, at(pay, 40), 445);    // Certificate
    tls13hs.transcriptAdd(t, at(pay, 485), 136);   // CertificateVerify
    let hCV = bytes.alloc(32);
    tls13hs.transcriptHash(0, t, hCV);

    let verifyData = at(pay, 625);                 // Finished message verify_data (32 bytes)
    assert.isTrue(tls13hs.verifyFinished(0, hexBuf(SERVER_HS), hCV, verifyData));
    // A tampered transcript must fail.
    bytes.write_byte(hCV, 0, (bytes.read_byte(hCV, 0) ^ 1) & 0xff);
    assert.isTrue(!tls13hs.verifyFinished(0, hexBuf(SERVER_HS), hCV, verifyData));
    tls13hs.transcriptFree(t);
}

// The server CertificateVerify signature (RSA-PSS over the transcript through Certificate) verifies.
@test
fn certificate_verify(): void {
    let pay = hexBuf(PAY);
    let t = tls13hs.transcriptNew();
    tls13hs.transcriptAdd(t, hexBuf(CH), 196);
    tls13hs.transcriptAdd(t, hexBuf(SH), 90);
    tls13hs.transcriptAdd(t, at(pay, 0), 40);      // EncryptedExtensions
    tls13hs.transcriptAdd(t, at(pay, 40), 445);    // Certificate
    let hCert = bytes.alloc(32);
    tls13hs.transcriptHash(0, t, hCert);

    let cert = x509.parseCert(at(pay, 51), 432);   // leaf cert DER inside the Certificate message
    assert.isTrue(cert.ok);
    let sig = at(pay, 493);                         // CertificateVerify signature (128 bytes)
    assert.isTrue(tls13hs.verifyCertificateVerify(cert, 0x0804, sig, 128, hCert));

    // A tampered transcript hash must fail the signature check.
    bytes.write_byte(hCert, 5, (bytes.read_byte(hCert, 5) ^ 0x40) & 0xff);
    assert.isTrue(!tls13hs.verifyCertificateVerify(cert, 0x0804, sig, 128, hCert));
    tls13hs.transcriptFree(t);
}

// The application traffic secrets derive from the master secret and the full-flight transcript.
@test
fn application_secrets(): void {
    let t = tls13hs.transcriptNew();
    tls13hs.transcriptAdd(t, hexBuf(CH), 196);
    tls13hs.transcriptAdd(t, hexBuf(SH), 90);
    let pay = hexBuf(PAY);
    tls13hs.transcriptAdd(t, pay, 657);            // EE || Cert || CertVerify || Finished
    let hSF = bytes.alloc(32);
    tls13hs.transcriptHash(0, t, hSF);
    assert.isTrue(eqHex(hSF, 32, T_CH_SF));

    let master = bytes.alloc(32);
    tls13hs.masterSecret(0, hexBuf(HANDSHAKE), master);
    assert.isTrue(eqHex(master, 32, MASTER));

    let cap = bytes.alloc(32);
    tls13.deriveTraffic(0, master, "c ap traffic", hSF, cap);
    assert.isTrue(eqHex(cap, 32, C_AP));

    let sap = bytes.alloc(32);
    tls13.deriveTraffic(0, master, "s ap traffic", hSF, sap);
    assert.isTrue(eqHex(sap, 32, S_AP));
    tls13hs.transcriptFree(t);
}
