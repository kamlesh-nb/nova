import assert;

fn dv(a: int, b: int): int { return a / b; }
fn md(a: int, b: int): int { return a % b; }
fn dvl(a: long, b: long): long { return a / b; }

@test
fn test_div_truncates_toward_zero(): void {
    let three = 3;
    assert.equalInt(dv(10, three), 3);
    assert.equalInt(dv(-10, three), -3);
    assert.equalInt(dv(7, -2), -3);
    assert.equalInt(dv(-7, -2), 3);
}

@test
fn test_mod_sign_of_dividend(): void {
    let three = 3;
    assert.equalInt(md(10, three), 1);
    assert.equalInt(md(-10, three), -1);
    assert.equalInt(md(10, 0 - three), 1);
}

@test
fn test_long_min_at_long_width_ok(): void {
    let neg1: long = 0 - 1;
    let x: long = 0 - 2147483648;
    assert.equalInt(dvl(x, neg1) as int, 2147483648 as int);
}
