import assert;

@test
fn test_string_plus_float(): void {
    let f = 2.5;
    assert.equalStr("v=" + f, "v=2.5");
    assert.equalStr(f + " end", "2.5 end");
    let g = 0.5;
    assert.equalStr("a" + f + "b" + g, "a2.5b0.5");
}

@test
fn test_float_add_still_works(): void {
    let a = 2.5;
    let b = 0.5;
    let c = a + b;
    assert.equalStr(`${c}`, "3");
}
