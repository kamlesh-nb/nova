import assert;
import bytes;

fn okReturn(log: ptr): int {
    defer bytes.write_byte(log, 0, bytes.read_byte(log, 0) + 1);
    return 7;
}

fn earlyReturn(log: ptr, x: int): int {
    defer bytes.write_byte(log, 0, bytes.read_byte(log, 0) + 1);
    if (x > 0) { return 10; }
    return 20;
}

fn reverseOrder(log: ptr): void {
    defer bytes.write_byte(log, 1, 1);
    defer bytes.write_byte(log, 1, 2);
}

@test
fn defer_runs_on_ok_return(): void {
    let log = bytes.alloc(4);
    bytes.write_byte(log, 0, 0);
    let r = okReturn(log);
    assert.equalInt(r, 7);
    assert.equalInt(bytes.read_byte(log, 0), 1);
}

@test
fn defer_runs_on_every_exit(): void {
    let log = bytes.alloc(4);
    bytes.write_byte(log, 0, 0);
    earlyReturn(log, 5);
    assert.equalInt(bytes.read_byte(log, 0), 1);
    earlyReturn(log, -1);
    assert.equalInt(bytes.read_byte(log, 0), 2);
}

@test
fn defer_reverse_order(): void {
    let log = bytes.alloc(4);
    bytes.write_byte(log, 1, 0);
    reverseOrder(log);
    assert.equalInt(bytes.read_byte(log, 1), 1);
}
