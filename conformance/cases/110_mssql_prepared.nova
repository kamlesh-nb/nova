// D6: MSSQL server-side prepared statements — the TDS RPC codec (sp_prepare / sp_execute) plus
// the NBCROW (null-bitmap-compressed row) decode. The full flow is verified LIVE against SQL
// Server 2022 (prepare -> execute with params, typed decode, reuse, dedup, NULL params in both
// positions). This gate locks offline: the $N -> @PN placeholder rewrite + param declaration,
// the RPC frame + INTN/NVARCHAR parameter encodings, and the NBCROW row decode that a NULL
// triggers (which the driver previously mishandled — a real bug this work also fixed for plain
// queries).
import assert;
import bytes;
import string;
import list;
import db;
import mssql;

fn b(vals: List<int>): string {
    let p = bytes.alloc(vals.size());
    let i = 0;
    while (i < vals.size()) { bytes.write_byte(p, i, (vals.get(i) ?? 0) % 256); i = i + 1; }
    return p as string;
}

@test
fn test_placeholder_rewrite(): void {
    let m = mssql.convertPlaceholders("SELECT $1 AS a, $2 AS b WHERE x = $1");
    assert.equalStr(m.sql, "SELECT @P1 AS a, @P2 AS b WHERE x = @P1");
    assert.equalInt(m.nparams, 2);      // highest N seen
}

@test
fn test_param_declaration(): void {
    assert.equalStr(mssql.paramDecl(2), "@P1 nvarchar(4000),@P2 nvarchar(4000)");
    assert.equalStr(mssql.paramDecl(0), "");
}

@test
fn test_rpc_intn_param(): void {
    // INTN out-param: [name len 0][status 1][type 0x26][maxlen 4][actual 4][value u32]
    let p = mssql.rpcParamIntN(true, 7);
    assert.equalInt(p[0], 0);           // name length
    assert.equalInt(p[1], 1);           // status = OUTPUT
    assert.equalInt(p[2], 38);          // 0x26 INTN
    assert.equalInt(p[3], 4);           // max len
    assert.equalInt(p[4], 4);           // actual len
    assert.equalInt(p[5], 7);           // value low byte
}

@test
fn test_rpc_nvarchar_param(): void {
    // NVARCHAR: [name 0][status 0][type 0xE7][maxlen u16][collation 5][actual u16][utf16 bytes]
    let p = mssql.rpcParamNVarchar("hi");
    assert.equalInt(p[2], 231);         // 0xE7 NVARCHAR
    // actual length (u16) sits after 1+1+1+2+5 = 10 header bytes -> index 10 = 4 bytes ("hi" utf16)
    assert.equalInt(p[10], 4);
    // utf16 "hi": 'h'(104) 0 'i'(105) 0
    assert.equalInt(p[12], 104);
    assert.equalInt(p[14], 105);
}

@test
fn test_rpc_frame_procid(): void {
    // buildRpc: ALL_HEADERS(22) then [0xFFFF][procId u16][flags u16][params]
    let f = mssql.buildRpc(11, "");       // SP_PREPARE = 11
    // after 22-byte ALL_HEADERS: 0xFF 0xFF
    assert.equalInt(f[22], 255);
    assert.equalInt(f[23], 255);
    assert.equalInt(f[24], 11);           // proc id low byte
}

@test
fn test_nbcrow_decode_with_null(): void {
    // Craft COLMETADATA(2 nvarchar cols) + NBCROW(col0 NULL, col1 "hi") + DONE, then decode.
    let s = List<int>();
    // COLMETADATA 0x81, count=2
    s.push(129); s.push(2); s.push(0);
    // col0: UserType(4)=0, Flags(2)=0, Type 0xE7, maxlen 8000(0x1F40), collation(5)=0, name "a"
    s.push(0); s.push(0); s.push(0); s.push(0); s.push(0); s.push(0);
    s.push(231); s.push(64); s.push(31); s.push(0); s.push(0); s.push(0); s.push(0); s.push(0);
    s.push(1); s.push(97); s.push(0);              // namelen 1, "a" utf16
    // col1: same, name "b"
    s.push(0); s.push(0); s.push(0); s.push(0); s.push(0); s.push(0);
    s.push(231); s.push(64); s.push(31); s.push(0); s.push(0); s.push(0); s.push(0); s.push(0);
    s.push(1); s.push(98); s.push(0);              // namelen 1, "b" utf16
    // NBCROW 0xD2, bitmap 0x01 (col0 null), col1 value: len 4, "hi" utf16
    s.push(210); s.push(1);
    s.push(4); s.push(0); s.push(104); s.push(0); s.push(105); s.push(0);
    // DONE 0xFD: status(2) curcmd(2) rowcount(8)
    s.push(253); s.push(0); s.push(0); s.push(0); s.push(0);
    s.push(1); s.push(0); s.push(0); s.push(0); s.push(0); s.push(0); s.push(0); s.push(0);

    let stream = b(s);
    let r = mssql.decodeTokens(stream);
    assert.isTrue(r.ok);
    assert.equalInt(r.rs.columns.size(), 2);
    assert.equalInt(r.rs.rows.size(), 1);          // BUG WAS: NBCROW ignored -> 0 rows
    let row = r.rs.rows.get(0) ?? Row();
    assert.isTrue(row.isNull(0));                  // col0 NULL via bitmap
    assert.equalStr(row.getText(1), "hi");         // col1 decoded
}
