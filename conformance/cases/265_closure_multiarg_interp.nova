// Regression: a multi-argument closure whose param types cannot be pinned from its body alone
// (e.g. `(a, b) => a + b`, where both params are only used with each other) must still be typed
// from its CALL SITE, so its result interpolates correctly. Before the fix the closure inferred
// as `unresolved`, the call result was untyped, and `${add(3, 8)}` picked the string stringifier
// and dereferenced the int as a pointer -> SIGSEGV. Fix: the checker looks ahead to the call site
// (incl. inside a template) and pins the closure's param types from the argument types.
// The closure CALL codegen was always correct; this is purely a type-inference fix.
import assert;

@test
fn test_multiarg_closure_inline_interp(): void {
    let add = (a, b) => a + b;
    assert.equalStr(`${add(3, 8)}`, "11");
}

@test
fn test_multiarg_closure_bound_result(): void {
    let add = (a, b) => a + b;
    let r = add(3, 8);
    assert.equalStr(`sum=${r}`, "sum=11");
}

@test
fn test_threearg_closure_interp(): void {
    let mul = (a, b, c) => a * b * c;
    assert.equalStr(`${mul(2, 3, 4)}`, "24");
}

@test
fn test_multiarg_string_closure(): void {
    let cat = (a, b) => a + b;
    assert.equalStr(cat("foo", "bar"), "foobar");
}

@test
fn test_multiarg_result_arithmetic(): void {
    let sub = (a, b) => a - b;
    let x = sub(10, 3) + 100;
    assert.equalInt(x, 107);
}

@test
fn test_singlearg_still_works(): void {
    let inc = (x) => x + 1;
    assert.equalStr(`${inc(41)}`, "42");
}
