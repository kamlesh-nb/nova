// DEFLATE / gzip: round-trip and gzip-format correctness. inflate(deflateRaw(x)) == x, gunzip(gzipCompress(x))
// == x, and the gzip module compress/decompress path. Interop with the system gzip/gunzip is proven by the
// host tests; this case is the in-corpus regression guard for the pure-Nova codec.
import compress.deflate;
import compress.gzip;
import assert;

@test
fn deflate_inflate_roundtrip(): void {
    let data = "The quick brown fox jumps over the lazy dog. aaaaaaaaaa bbbbbbbbbb 1234567890 repeated repeated repeated";
    let comp = deflate.deflateRaw(data);
    assert.equalStr(deflate.inflate(comp.toString()).toString(), data);
}

@test
fn gzip_roundtrip_full(): void {
    let data = "gzip payload with redundancy redundancy redundancy and a tail 0987654321";
    assert.equalStr(deflate.gunzip(deflate.gzipCompress(data)), data);
    assert.equalStr(gzip.decompress(gzip.compress(data)), data);
}

@test
fn deflate_empty_and_short(): void {
    assert.equalStr(deflate.gunzip(deflate.gzipCompress("")), "");
    assert.equalStr(deflate.gunzip(deflate.gzipCompress("x")), "x");
}

// FR-deflate-4 guard: a long, highly repetitive payload forces matches well past 8 bytes, so the
// word-at-a-time (SWAR) match extension runs both its 8-byte window and its byte tail. Round-tripping
// it proves the wide compare picks exactly the byte-by-byte match length across the word boundary.
@test
fn deflate_long_match_swar(): void {
    let unit = "the quick brown fox jumps over the lazy dog 0123456789 ";
    let data = "";
    let i = 0;
    while (i < 64) {          // ~3.5 KiB of repeats, matches run to the 258-byte cap
        data = data + unit;
        i = i + 1;
    }
    assert.equalStr(deflate.inflate(deflate.deflateRaw(data).toString()).toString(), data);
    assert.equalStr(deflate.gunzip(deflate.gzipCompress(data)), data);
}
