// The MSSQL/TDS driver's wire CODEC (data/sql/mssql.nova) — gated OFFLINE over hand-built
// byte buffers, no server. Covers: the LOGIN7 password obfuscation (nibble-swap + XOR 0xA5,
// UTF-16LE), the PRELOGIN encryption advertisement, and a COLMETADATA/ROW/DONE token-stream
// decode into typed DbValues (INT via INTN, NVARCHAR unicode, NUMERIC exact decimal).
import mssql;
import db;
import bytes;
import list;
import string;
import assert;

// Build a binary Nova string from a list of byte values.
fn hx(vals: List<int>): string {
    let n = vals.size();
    if (n == 0) { return ""; }
    let p = bytes.alloc(n);
    let i = 0;
    while (i < n) { bytes.write_byte(p, i, (vals.get(i) ?? 0) & 255); i = i + 1; }
    return p as string;
}
fn push(l: List<int>, v: int): void { l.push(v); }

@test
fn test_password_obfuscation(): void {
    // reference vector: obf("test") = E2 A5 F3 A5 92 A5 E2 A5  (verified vs a Python impl)
    let o = mssql.obfuscatePassword("test");
    assert.equalInt(o.length, 8);
    assert.equalInt(o[0] & 255, 226);  // E2
    assert.equalInt(o[1] & 255, 165);  // A5
    assert.equalInt(o[2] & 255, 243);  // F3
    assert.equalInt(o[3] & 255, 165);  // A5
    assert.equalInt(o[4] & 255, 146);  // 92
    assert.equalInt(o[7] & 255, 165);  // A5
}

@test
fn test_prelogin_advertises_not_sup(): void {
    let pre = mssql.buildPrelogin(false);
    // option table: VERSION(0)+ENCRYPTION(1)+THREADID(3)+terminator(0xFF) = 16 bytes, then data.
    // ENCRYPTION option entry is at bytes [5..10): token=1, then be16 offset, be16 len=1.
    assert.equalInt(pre[5] & 255, 1);          // ENCRYPTION token
    let encOff = (pre[6] & 255) * 256 + (pre[7] & 255);
    assert.equalInt(pre[encOff] & 255, 2);     // ENCRYPT_NOT_SUP
}

@test
fn test_login7_shape(): void {
    let l = mssql.buildLogin7("sa", "pw", "master");
    // first 4 bytes = total length (LE) == the whole buffer length.
    let total = (l[0] & 255) + (l[1] & 255) * 256 + (l[2] & 255) * 65536;
    assert.equalInt(total, l.length);
    // TDSVersion 0x74000004 at bytes [4..8) little-endian -> 04 00 00 74
    assert.equalInt(l[4] & 255, 4);
    assert.equalInt(l[7] & 255, 116);          // 0x74
}

@test
fn test_token_stream_row_decode(): void {
    // COLMETADATA (129): 3 cols — id INTN(4)=38/4, name NVARCHAR=231, price NUMERIC(10,2)=108/9/10/2
    let s = List<int>();
    push(s, 129); push(s, 3); push(s, 0);                       // token, count=3
    // col id: usertype(4) flags(2) INTN len4, name "id" (105,100)
    push(s, 0); push(s, 0); push(s, 0); push(s, 0); push(s, 0); push(s, 0);
    push(s, 38); push(s, 4);
    push(s, 2); push(s, 105); push(s, 0); push(s, 100); push(s, 0);
    // col name: NVARCHAR len(2)=100 + collation(5), name "nm" (110,109)
    push(s, 0); push(s, 0); push(s, 0); push(s, 0); push(s, 0); push(s, 0);
    push(s, 231); push(s, 100); push(s, 0); push(s, 0); push(s, 0); push(s, 0); push(s, 0); push(s, 0);
    push(s, 2); push(s, 110); push(s, 0); push(s, 109); push(s, 0);
    // col price: NUMERICN len=9 prec=10 scale=2, name "pr" (112,114)
    push(s, 0); push(s, 0); push(s, 0); push(s, 0); push(s, 0); push(s, 0);
    push(s, 108); push(s, 9); push(s, 10); push(s, 2);
    push(s, 2); push(s, 112); push(s, 0); push(s, 114); push(s, 0);
    // ROW (209): id=42, name="hi", price=19.99 (mag 1999 = 207,7 LE; sign 1)
    push(s, 209);
    push(s, 4); push(s, 42); push(s, 0); push(s, 0); push(s, 0);
    push(s, 4); push(s, 0); push(s, 104); push(s, 0); push(s, 105); push(s, 0);
    push(s, 3); push(s, 1); push(s, 207); push(s, 7);
    // DONE (253): status(2), curcmd(2), rowcount(8)=1
    push(s, 253); push(s, 0); push(s, 0); push(s, 0); push(s, 0);
    push(s, 1); push(s, 0); push(s, 0); push(s, 0); push(s, 0); push(s, 0); push(s, 0); push(s, 0);

    let r = mssql.decodeTokens(hx(s));
    assert.isTrue(r.ok);
    assert.equalInt(r.rs.rowCount(), 1);
    assert.equalInt(r.rs.colCount(), 3);
    let row = r.rs.row(0);
    assert.equalInt(row.getInt(0), 42);
    assert.equalStr(row.getText(1), "hi");
    assert.equalStr(`${row.getDecimal(2)}`, "19.99");   // exact decimal128, not f64
}
