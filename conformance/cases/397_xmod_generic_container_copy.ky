import list;
import assert;
struct Box<T> {
    pub buf: list.List<T>,
    init() { self.buf = list.List<T>(); }
    pub fn depth(self: Box<T>): int { return self.buf.size(); }
    pub fn add(self: Box<T>, v: T): void { self.buf.push(v); }
}
@test
fn xmod_generic_container_copy(): void {
    let b = Box<int>();
    b.add(7);
    let b2 = b;
    assert.equalInt(b2.depth(), 1);
}
