import bytes;
import assert;
import crypto.aead.aesgcmhw;

extern("c") fn kyte_aes_encrypt_block(rk: ptr, nr: int, inb: ptr, out: ptr): void;

fn hexNib(c: int): int { if (c >= 48 && c <= 57) { return c - 48; } if (c >= 97 && c <= 102) { return c - 87; } return c - 55; }
fn hexb(dst: ptr, hex: string): void {
    let i = 0; while (i < hex.length / 2) { bytes.write_byte(dst, i, hexNib(hex[i*2]) * 16 + hexNib(hex[i*2+1])); i = i + 1; }
}

fn checkKat(keyHex: string, keyLen: int, ptHex: string, ctHex: string): void {
    let key = bytes.alloc(keyLen); hexb(key, keyHex);
    let pt = bytes.alloc(16); hexb(pt, ptHex);
    let want = bytes.alloc(16); hexb(want, ctHex);
    let rk = bytes.alloc(240);
    let nr = aesgcmhw.expandKey(key, keyLen, rk);
    let out = bytes.alloc(16);
    kyte_aes_encrypt_block(rk, nr, pt, out);
    let i = 0; while (i < 16) { assert.equalInt(bytes.read_byte(out, i), bytes.read_byte(want, i)); i = i + 1; }
    let out2 = bytes.alloc(16); aesgcmhw.encBlock(rk, nr, pt, out2);
    i = 0; while (i < 16) { assert.equalInt(bytes.read_byte(out, i), bytes.read_byte(out2, i)); i = i + 1; }
}

@test
fn asm_aes128_fips197(): void {
    checkKat("000102030405060708090a0b0c0d0e0f", 16, "00112233445566778899aabbccddeeff", "69c4e0d86a7b0430d8cdb78070b4c55a");
}
@test
fn asm_aes256_fips197(): void {
    checkKat("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f", 32, "00112233445566778899aabbccddeeff", "8ea2b7ca516745bfeafc49904b496089");
}
