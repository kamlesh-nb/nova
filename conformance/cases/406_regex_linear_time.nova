// Regex is now matched by a Pike VM (Thompson NFA threads run in lockstep, one input position at a time,
// with a per-position pc-dedup so at most prog.size() threads are live per position). This makes matching
// LINEAR time O(n*m): pathological patterns that make a backtracking engine exponential -- (a*)*, nested
// quantifiers, ambiguous alternation -- terminate in bounded work. Captures, alternation priority
// (leftmost-first) and lazy quantifiers are preserved.
import text.regex;
import assert;

@test
fn captures_preserved(): void {
    let m = regex.compile("(a+)(b+)").exec("xxaaabbbyy");
    assert.isTrue(m.matched);
    assert.equalStr(m.group(0), "aaabbb");
    assert.equalStr(m.group(1), "aaa");
    assert.equalStr(m.group(2), "bbb");
}

@test
fn alternation_leftmost_first(): void {
    // Priority order: the first alternative that matches wins (POSIX-leftmost-first, like PCRE).
    assert.equalStr(regex.compile("a|ab").exec("ab").group(0), "a");
    assert.equalStr(regex.compile("ab|a").exec("ab").group(0), "ab");
}

@test
fn lazy_quantifier_preserved(): void {
    // Lazy .+? stops at the first '>' rather than being greedy.
    assert.equalStr(regex.compile("<(.+?)>").exec("<a><b>").group(1), "a");
}

@test
fn catastrophic_backtracking_terminates(): void {
    // (a*)*c over a long run of 'a' with no 'c'. A backtracking matcher is exponential here and would hang;
    // the Pike VM is linear, so this returns (false) quickly. Reaching this assertion at all IS the test.
    let re = regex.compile("(a*)*c");
    let s = "";
    let i = 0;
    while (i < 60) { s = s + "a"; i = i + 1; }
    assert.isTrue(!re.test(s));
    // And it still finds the 'c' when present.
    assert.isTrue(re.test(s + "c"));
}

@test
fn nested_ambiguous_terminates(): void {
    // (a+)+$ is another classic exponential-backtracking trap.
    let re = regex.compile("(a+)+$");
    let s = "";
    let i = 0;
    while (i < 50) { s = s + "a"; i = i + 1; }
    assert.isTrue(re.test(s));       // all a's, anchored -> matches
    assert.isTrue(!re.test(s + "b")); // trailing b defeats $ -> no match, still linear
}

@test
fn find_all_and_anchors_still_work(): void {
    let all = regex.compile("[0-9]+").findAll("a12b3c456");
    assert.equalInt(all.size(), 3);
    assert.equalStr(all.at(0), "12");
    assert.equalStr(all.at(2), "456");
    assert.isTrue(regex.compile("^\\d{3}$").test("415"));
    assert.isTrue(!regex.compile("^\\d{3}$").test("41"));
}
