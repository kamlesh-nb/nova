// TLS 1.3 client handshake state machine in Nova (M9 phase E, no external library). Replays the RFC 8448
// "Simple 1-RTT Handshake" through the client driver: seed the ClientHello, process the ServerHello
// (ECDHE + handshake secrets), decrypt and verify the server's encrypted flight (CertificateVerify +
// Finished), then derive the application secrets and compute the client Finished. Every derived value
// matches the RFC.
import crypto.tls.13.tlsClient;
import bytes;
import assert;

fn hexNib(c: int): int {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    return 0;
}
fn hexBuf(hex: string): ptr {
    let n = hex.length / 2;
    let b = bytes.alloc(n);
    let i = 0;
    while (i < n) { bytes.write_byte(b, i, hexNib(hex[i * 2]) * 16 + hexNib(hex[i * 2 + 1])); i = i + 1; }
    return b;
}
fn eqHex(buf: ptr, n: int, hex: string): bool {
    if (hex.length != n * 2) { return false; }
    let i = 0;
    while (i < n) {
        if (bytes.read_byte(buf, i) != hexNib(hex[i * 2]) * 16 + hexNib(hex[i * 2 + 1])) { return false; }
        i = i + 1;
    }
    return true;
}

const CLIENT_PRIV: string = "49af42ba7f7994852d713ef2784bcbcaa7911de26adc5642cb634540e7ea5005";
const CH: string = "";
const SH: string = "020000560303a6af06a4121860dc5e6e60249cd34c95930c8ac5cb1434dac155772ed3e2692800130100002e00330024001d0020c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f002b00020304";
// The server's first protected handshake record (5-byte header + ciphertext + tag).
const REC: string = "";

const SERVER_HS: string = "b67b7d690cc16c4e75e54213cb2d37b4e9c912bcded9105d42befd59d391ad38";
const C_AP: string = "9e40646ce79a7f9dc05af8889bce6552875afa0b06df0087f792ebb7c17504a5";
const S_AP: string = "a11af9f05531f856ad47116b45a950328204b4f44bfb6b3a4b4f1f3fcb631643";
const CLIENT_FINISHED: string = "a8ec436d677634ae525ac1fcebe11a039ec17694fac6e98527b642f2edd5ce61";

@test
fn full_client_handshake(): void {
    let c = tlsClient.newClient(hexBuf(CLIENT_PRIV));
    c.addClientHello(hexBuf(CH), 196);
    c.processServerHello(hexBuf(SH), 90);

    // The handshake secrets/keys are derived; the server traffic secret matches the RFC.
    assert.isTrue(eqHex(c.shs, 32, SERVER_HS));

    // Decrypt and verify the server's encrypted flight.
    let flightOk = c.processFlight(hexBuf(REC), 679);
    assert.isTrue(flightOk);
    assert.isTrue(c.certVerifyOk);
    assert.isTrue(c.finishedOk);

    // Derive application secrets and compute the client Finished verify_data.
    let vd = bytes.alloc(32);
    c.clientFinished(vd);
    assert.isTrue(eqHex(vd, 32, CLIENT_FINISHED));
    assert.isTrue(eqHex(c.cap, 32, C_AP));
    assert.isTrue(eqHex(c.sap, 32, S_AP));

    // Producing the client Finished record and switching to application keys resets the sequence numbers.
    let out = bytes.alloc(128);
    let recLen = c.clientFinishedRecord(vd, out);
    assert.equalInt(recLen, 58);                 // 5 header + 36 inner + 1 type + 16 tag
    assert.equalInt((c.cSeq as int), 0);
    assert.equalInt((c.sSeq as int), 0);
}

// The ClientHello builder produces a well-formed handshake message carrying our key_share.
@test
fn build_client_hello(): void {
    let rnd = bytes.alloc(32);
    let sid = bytes.alloc(32);
    let pk = hexBuf("99381de560e4bd43d23d8e435a7dbafeb3c06e51c13cae4d5413691e529aaf2c");
    let i = 0;
    while (i < 32) { bytes.write_byte(rnd, i, i); bytes.write_byte(sid, i, 255 - i); i = i + 1; }
    let out = bytes.alloc(512);
    let n = tlsClient.buildClientHello(rnd, sid, pk, "example.com", out);
    // Handshake type 0x01, and the 3-byte body length equals n-4.
    assert.equalInt(bytes.read_byte(out, 0), 0x01);
    let bodyLen = (bytes.read_byte(out, 1) << 16) | (bytes.read_byte(out, 2) << 8) | bytes.read_byte(out, 3);
    assert.equalInt(bodyLen, n - 4);
    // The key_share is the last 32 bytes and equals our public key.
    assert.isTrue(eqHex(at(out, n - 32), 32, "99381de560e4bd43d23d8e435a7dbafeb3c06e51c13cae4d5413691e529aaf2c"));
}

fn at(buf: ptr, off: int): ptr { return (buf as long + off) as ptr; }

// The incremental feedHandshake path (used for live, fragment-tolerant reassembly) verifies the flight.
@test
fn flight_reassembly(): void {
    let c = tlsClient.newClient(hexBuf(CLIENT_PRIV));
    c.addClientHello(hexBuf(CH), 196);
    c.processServerHello(hexBuf(SH), 90);
    let r = c.feedHandshake(hexBuf(REC), 679);
    assert.equalInt(r, 1);                        // 1 = server Finished reached
    assert.isTrue(c.certVerifyOk);
    assert.isTrue(c.finishedOk);
}

// A tampered flight (flipped ciphertext byte) fails verification.
@test
fn tampered_flight(): void {
    let c = tlsClient.newClient(hexBuf(CLIENT_PRIV));
    c.addClientHello(hexBuf(CH), 196);
    c.processServerHello(hexBuf(SH), 90);
    let rec = hexBuf(REC);
    bytes.write_byte(rec, 100, (bytes.read_byte(rec, 100) ^ 1) & 0xff);
    assert.isTrue(!c.processFlight(rec, 679));
}
