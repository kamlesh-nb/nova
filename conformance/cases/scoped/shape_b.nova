import shape_a;
pub enum Shape { Tri(int), Rect(int), Pent(int)
    pub fn area(self: Shape): int {
        switch (self) {
            case Shape.Tri(b): { return b; }
            case Shape.Rect(w): { return w * 2; }
            case Shape.Pent(p): { return p * 5; }
        }
        return -1;
    }
}
pub fn mkB(): Shape { return Shape.Pent(4); }
