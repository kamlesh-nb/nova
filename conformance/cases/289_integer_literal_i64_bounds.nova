// lit-i64: a decimal integer literal that did not fit i64 was silently parsed to 0 (`catch 0` in the
// lexeme parser), so `let x: long = 9999999999999999999` became 0 -- silent data loss that the checker's
// range check never saw (it only ever saw 0). The parser now parses literals faithfully and rejects an
// out-of-i64-range decimal literal (see expect_fail/integer_literal_i64_overflow); this case pins the
// boundary values that MUST still compile to the right value.

import assert;

@test
fn test_i64_max(): void {
    let x: long = 9223372036854775807;   // i64 max
    assert.isTrue(x == 9223372036854775807);
    assert.isTrue((x + 1) < 0);          // wraps to i64 MIN
}

@test
fn test_i64_min(): void {
    let x: long = -9223372036854775808;  // i64 MIN, expressed as unary-minus of 2^63
    assert.isTrue(x < 0);
    assert.isTrue((x - 1) > 0);          // MIN - 1 wraps positive
}

@test
fn test_hex_u64_mask(): void {
    let m: ulong = 0xFFFFFFFFFFFFFFFF;   // u64 max as a hex mask: keeps its bit pattern
    assert.isTrue(m != 0);
    assert.isTrue((m + 1) == 0);         // wraps to 0
}

@test
fn test_large_but_in_range_decimal(): void {
    let u: ulong = 6364136223846793005; // < i64 max, a real stdlib PCG constant
    assert.isTrue(u == 6364136223846793005);
}
