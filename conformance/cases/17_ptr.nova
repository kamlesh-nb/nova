// A7 / F3 §5 stage 2: `ptr` is a first-class OPAQUE machine-word value type.
// Round-trips a raw heap address through a `ptr` field and back, and reads/writes
// bytes through it — proving `ptr` is word-sized (holds a real address), a VALUE type
// (never ARC-released as a heap object), and interchangeable with an address from
// `bytes.*`. This is the safety move that lets stage 5 narrow `int` to 32 without the
// stdlib's address fields truncating.
import assert;
import bytes;

struct Buffer {
    pub data: ptr,
    pub len: int,

    init(n: int) {
        self.data = bytes.alloc_persistent(n);
        self.len = n;
    }

    pub fn setByte(self: Buffer, i: int, b: int): void {
        bytes.write_byte(self.data, i, b);
    }
    pub fn getByte(self: Buffer, i: int): int {
        return bytes.read_byte(self.data, i);
    }
}

@test
fn test_ptr_field_roundtrip(): void {
    let b = Buffer(4);
    b.setByte(0, 65);
    b.setByte(1, 66);
    assert.equalInt(b.getByte(0), 65);
    assert.equalInt(b.getByte(1), 66);
    bytes.free(b.data);   // ptr is MANUAL memory (F3 §3.2) — freed by hand, not ARC
}

@test
fn test_ptr_local_is_a_value(): void {
    // A `ptr` local holds an address and is a VALUE — copying it and reading through
    // both copies must see the same memory; it must never be ARC-released.
    let p: ptr = bytes.alloc_persistent(2);
    let q: ptr = p;
    bytes.write_byte(p, 0, 7);
    assert.equalInt(bytes.read_byte(q, 0), 7);
    bytes.free(p);        // one buffer, two ptr copies — free once
}
