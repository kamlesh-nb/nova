// FR-mem Tier 2: scalar bit builtins rotl / rotr / ctz / clz / bswap.
// rotl/rotr/bswap return T (width and signedness from the type argument); ctz/clz return int.
import assert;

@test
fn rotate_u32(): void {
    // 0x00000001 rotated left by 1 = 0x00000002; by 31 = 0x80000000.
    assert.isTrue(mem.rotl<uint>(1, 1) == 2);
    assert.isTrue(mem.rotl<uint>(1, 31) == 2147483648);
    // rotr is the inverse.
    assert.isTrue(mem.rotr<uint>(2, 1) == 1);
    assert.isTrue(mem.rotr<uint>(1, 1) == 2147483648);
    // Rotating by the full width is a no-op (the intrinsic takes the amount modulo width).
    assert.isTrue(mem.rotl<uint>(0xdeadbeef, 32) == 0xdeadbeef);
}

@test
fn rotate_u64(): void {
    assert.isTrue(mem.rotl<ulong>(1, 1) == 2);
    assert.isTrue(mem.rotl<ulong>(1, 63) == 9223372036854775808);
    assert.isTrue(mem.rotr<ulong>(1, 1) == 9223372036854775808);
}

@test
fn count_zeros(): void {
    // ctz: number of trailing zero bits.
    assert.equalInt(mem.ctz<uint>(1), 0);
    assert.equalInt(mem.ctz<uint>(8), 3);
    assert.equalInt(mem.ctz<ulong>(0x100), 8);
    // clz: number of leading zero bits (width - 1 - floor(log2)).
    assert.equalInt(mem.clz<uint>(1), 31);
    assert.equalInt(mem.clz<uint>(0x80000000), 0);
    assert.equalInt(mem.clz<ulong>(1), 63);
}

@test
fn byte_swap(): void {
    // bswap reverses the byte order of the T-wide value.
    assert.isTrue(mem.bswap<uint>(0x01020304) == 0x04030201);
    assert.isTrue(mem.bswap<ushort>(0x0102) == 0x0201);
    assert.isTrue(mem.bswap<ulong>(0x0102030405060708) == 0x0807060504030201);
}
