import assert; import string;
struct Profile { pub name: string, pub age: int }
struct User { pub profile: Profile | undefined }
@test
fn test_chain_present(): void {
  let u = User{ profile: Profile{ name: "Ada", age: 36 } };
  assert.equalStr(u.profile?.name ?? "none", "Ada");
  assert.equalInt(u.profile?.age ?? -1, 36);
}
@test
fn test_chain_absent(): void {
  let u = User{ profile: undefined };
  assert.equalStr(u.profile?.name ?? "none", "none");
  assert.equalInt(u.profile?.age ?? -1, -1);
}
@test
fn test_present_zero(): void {
  let u = User{ profile: Profile{ name: "Z", age: 0 } };
  assert.equalInt(u.profile?.age ?? -1, 0);
}
@test
fn test_multilevel(): void {
  let u = User{ profile: Profile{ name: "Bob", age: 5 } };
  let n = u.profile?.name;
  assert.equalStr(n ?? "x", "Bob");
}
