// I (parser gaps): a `where` clause on a generic function signature (`fn f<T>(x: T): R where T: Show`)
// failed to parse -- the parser expected the body `{` right after the return type. Generic dispatch in
// Nova is structural (a call resolves against the concrete instantiation regardless of any declared
// bound), so the constraints are advisory. Fix: parse and discard an optional `where` clause between the
// return type and the body, accepting `T: Bound`, `T: A + B`, and comma-separated lists.

import assert;

trait Show { fn show(self: Self): string; }
trait Tag { fn tag(self: Self): int; }

fn describe<T>(x: T): string where T: Show {
    return x.show();
}

fn both<T, U>(a: T, b: U): string where T: Show + Tag, U: Show {
    return a.show();
}

struct Dog impl Show, Tag {
    fn show(self: Dog): string { return "woof"; }
    fn tag(self: Dog): int { return 1; }
}

struct Cat impl Show {
    fn show(self: Cat): string { return "meow"; }
}

@test
fn test_single_bound(): void {
    assert.equalStr(describe(Dog{}), "woof");
    assert.equalStr(describe(Cat{}), "meow");
}

@test
fn test_multi_bound_and_multi_constraint(): void {
    // `T: Show + Tag` (two bounds) and a second constraint `U: Show`.
    assert.equalStr(both(Dog{}, Cat{}), "woof");
}
