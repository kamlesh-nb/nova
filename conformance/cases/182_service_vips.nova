// 182 — I3 Tier-1 service VIPs (userspace k8s-Service model): the offline-testable surface — Service
// endpoint formatting (port-per-service vs VIP), backend membership, and name→endpoint resolution via
// the registry. The live data plane (stable address LB'ing to healthy replicas, health-gated drain,
// file-based cross-process discovery) is proven end-to-end separately.
import assert;
import net.service;
import net.proxy;

// A port-per-service endpoint resolves to loopback:port; a VIP service to vip:port.
@test
fn test_service_endpoint(): void {
    let api = service.Service("api", "", 8080);          // no VIP → port-per-service
    assert.equalStr(api.endpoint(), "127.0.0.1:8080");
    let web = service.Service("web", "127.0.0.2", 80);   // dedicated VIP
    assert.equalStr(web.endpoint(), "127.0.0.2:80");
}

// Backends (replica endpoints) accumulate in the Service's pool.
@test
fn test_service_backends(): void {
    let s = service.Service("cache", "", 6379);
    assert.equalInt(s.backendCount(), 0);
    s.addBackend("127.0.0.1", 7001);
    s.addBackend("127.0.0.1", 7002);
    s.addBackend("127.0.0.1", 7003);
    assert.equalInt(s.backendCount(), 3);
    s.setStrategy(proxy.LbStrategy.RoundRobin);           // strategy is settable
    // the pool selects among the added backends (all healthy by default → real ports, never the sentinel)
    let picked = s.pool.select("").port;
    assert.isTrue(picked == 7001 || picked == 7002 || picked == 7003);
}

// The registry resolves a registered service name to its stable endpoint, and "" for unknown names.
@test
fn test_registry_resolve(): void {
    let reg = service.ServiceRegistry("");                // in-memory only (no discovery file)
    let api = service.Service("api", "", 8080);
    api.addBackend("127.0.0.1", 9101);
    reg.register(api);
    let web = service.Service("web", "127.0.0.3", 80);
    reg.register(web);

    assert.equalStr(reg.resolve("api"), "127.0.0.1:8080");
    assert.equalStr(reg.resolve("web"), "127.0.0.3:80");
    assert.equalStr(reg.resolve("nonexistent"), "");      // unknown → empty
}
