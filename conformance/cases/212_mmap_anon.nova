// M8: the allocator page source is raw kernel pages (mmap of anonymous memory), not libc malloc.
// The C bump arena under nova_bytes_alloc is mmap-backed; os/sys also exposes mmap/munmap so a Nova
// arena can back itself the same way. This exercises the syscall path from Nova: map an anonymous
// region, confirm it is zero-filled and read/write, then unmap it.
import os.sys;
import bytes;
import assert;

@test
fn mmap_anon_roundtrip(): void {
    let n = 65536 as long;
    let p = sys.mapAnon(n);
    assert.isTrue((p as long) != 0);

    // Anonymous memory is zero-filled by the kernel.
    assert.equalInt(bytes.read_byte(p, 0), 0);
    assert.equalInt(bytes.read_byte(p, 40000), 0);

    // It is writable and reads back what was written.
    bytes.write_i32(p, 0, 123456);
    bytes.write_byte(p, 4, 200);
    bytes.write_i32(p, 40000, 777);
    assert.equalInt(bytes.read_i32(p, 0) as int, 123456);
    assert.equalInt(bytes.read_byte(p, 4), 200);
    assert.equalInt(bytes.read_i32(p, 40000) as int, 777);

    assert.equalInt(sys.unmap(p, n), 0);
}

@test
fn mmap_many_pages(): void {
    // A few independent mappings, each usable and released, to exercise repeated map/unmap.
    let i = 0;
    while (i < 8) {
        let n = 16384 as long;
        let p = sys.mapAnon(n);
        assert.isTrue((p as long) != 0);
        bytes.write_i32(p, 0, i);
        assert.equalInt(bytes.read_i32(p, 0) as int, i);
        assert.equalInt(sys.unmap(p, n), 0);
        i = i + 1;
    }
}
