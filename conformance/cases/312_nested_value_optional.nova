// A-nested: a generic container of value-optionals whose accessor returns `V | undefined` produces a
// NESTED value-optional `(int | undefined) | undefined` -- e.g. `Map<K, int | undefined>.get()`. The outer
// optional distinguishes KEY-PRESENT from KEY-ABSENT; the inner distinguishes the stored value from
// `undefined`. The bug (now fixed) was that the outer reused 0 as its `none` sentinel, so a key that is
// PRESENT holding `undefined` collided with an ABSENT key -- a silent wrong value, generics-only.
//
// Fix (codegen, ownership-correct): the producer boxes the OUTER level on the key-found return even though
// the returned expression already yields the inner value-optional box (the `undefined`-return arm stays 0 =
// absent); `valueOptionalInner` recurses so the box/unbox seam adds/removes exactly one level; the consuming
// `??` peel unboxes one outer level and RETAINS the container-owned inner box for the bound local (present
// arm only, via a dedicated block, so a non-pointer default like `999` is never retained); and the RHS
// default is boxed to the inner value-optional representation so both `??` arms share it. The outer box
// BORROWS the inner (the container owns and frees it -- see 311), so nothing double-frees.
//
// This is an ARC gate: run under `--asan` (no UAF/double-free from the borrowed inner box) and `--arc`
// (no leak of the outer or inner boxes).

import assert;
import list;
import map;

@test
fn test_present_undef_vs_absent(): void {
    let m = Map<string, int | undefined>(8, string.hash);
    m.set("holds_undef", undefined);   // key PRESENT, value undefined
    m.set("present", 42);              // key PRESENT, value 42
    // "absent" is never set.

    // Peel the OUTER optional with a sentinel int default (999). Absent -> outer 0 -> picks 999.
    // Present-holding-undefined -> outer is a present box -> picks the inner (undefined) -> reads -1.
    // If the two collided (the old bug), both would read the same.
    let inner_undef = m.get("holds_undef") ?? 999;
    let inner_absent = m.get("absent") ?? 999;
    let inner_present = m.get("present") ?? 999;

    assert.equalInt(-1, inner_undef ?? -1);    // present-holding-undefined: inner is undefined
    assert.equalInt(999, inner_absent ?? -1);  // absent: fell through to the sentinel
    assert.equalInt(42, inner_present ?? -1);  // present real value reads through both levels
}

@test
fn test_nested_get_undefined_default(): void {
    // The `?? undefined` outer peel path: both absent and present-undefined read as the inner default,
    // and a real value reads through. Exercises the RHS-is-undefined arm (stays 0, not box(0)).
    let m = Map<string, int | undefined>(8, string.hash);
    m.set("a", 7);
    m.set("b", undefined);

    assert.equalInt(7, (m.get("a") ?? undefined) ?? -1);
    assert.equalInt(-1, (m.get("b") ?? undefined) ?? -1);
    assert.equalInt(-1, (m.get("missing") ?? undefined) ?? -1);
}

@test
fn test_list_nested_get(): void {
    // Same nesting through `List<int | undefined>.get(i)` -> `(int | undefined) | undefined`.
    let xs = List<int | undefined>();
    xs.push(5);
    xs.push(undefined);

    // In-range present value.
    assert.equalInt(5, (xs.get(0) ?? 999) ?? -1);
    // In-range present-holding-undefined: outer present, inner undefined.
    assert.equalInt(-1, (xs.get(1) ?? 999) ?? -1);
    // Out-of-range: outer absent -> sentinel.
    assert.equalInt(999, (xs.get(9) ?? 999) ?? -1);
}
