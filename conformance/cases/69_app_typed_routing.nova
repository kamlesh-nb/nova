import assert;
import web.app;
import web.request;
import web.response;
import web.status;
import web.routing;
import web.mediator;
import serde.json;
import serde.source;
import string;

@serializable struct GetUser impl Message { pub id: int }
@serializable struct CreateUser impl Message { pub name: string }
@serializable struct UserDto { pub id: int, pub name: string }
@serializable struct CreatedDto { pub created: string }

struct GetUserHandler impl RequestHandler<GetUser, UserDto> {
    async fn handle(self: GetUserHandler, q: GetUser): UserDto {
        return UserDto{ id: q.id, name: "Ada" };
    }
}

struct CreateUserHandler impl RequestHandler<CreateUser, CreatedDto> {
    async fn handle(self: CreateUserHandler, c: CreateUser): CreatedDto {
        return CreatedDto{ created: c.name };
    }
}

fn makeApp(): App {
    let a = App();
    a.mediated<GetUser>("GET", "/api/user/{id:int}");
    a.mediated<CreateUser>("POST", "/api/user");
    return a;
}

@test
fn test_typed_get_route(): void {
    let a = makeApp();
    let req = Request.fromString("GET /api/user/7 HTTP/1.1\r\nHost: x\r\n\r\n");
    let resp = a.dispatch(req);
    assert.equalStr(resp.body, `{"id":7,"name":"Ada"}`);
}

@test
fn test_typed_post_route_binds_body(): void {
    let a = makeApp();
    let req = Request.fromString("POST /api/user HTTP/1.1\r\nContent-Type: application/json\r\n\r\n{\"name\": \"Grace\"}");
    let resp = a.dispatch(req);
    assert.equalStr(resp.body, `{"created":"Grace"}`);
}

@test
fn test_unmatched_route_404(): void {
    let a = makeApp();
    let req = Request.fromString("GET /nope HTTP/1.1\r\nHost: x\r\n\r\n");
    let resp = a.dispatch(req);
    assert.equalInt(resp.status.toCode(), 404);
}
