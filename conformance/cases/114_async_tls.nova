fn toStr(buf: ptr, n: int): string {
    if (n <= 0) { return ""; }
    let out = bytes.alloc(n);
    let i = 0;
    while (i < n) { bytes.write_byte(out, i, bytes.read_byte(buf, i)); i = i + 1; }
    return out as string;
}

async fn tlsServer(srv: long): int {
    let client = await asyncio.aaccept(srv);
    let base = asyncio.AsyncStream(client);
    let ts = await asynctls.tlsAccept(base, TEST_CERT, TEST_KEY);
    if (!ts.ok()) { ts.close(); return -1; }
    let buf = bytes.alloc(256);
    let n = await ts.recvInto(buf as int, 256);
    let got = toStr(buf, n);
    if (string.eql(got, "PING")) { let w = await ts.sendStr("PONG-TLS"); }
    else { let e = await ts.sendStr("ERR"); }
    ts.close();
    return n;
}

async fn tlsClient(port: int): string {
    let ts = await asynctls.tlsConnect("localhost", port, false);
    if (!ts.ok()) { return "HS-FAIL"; }
    let w = await ts.sendStr("PING");
    let buf = bytes.alloc(256);
    let n = await ts.recvInto(buf as int, 256);
    ts.close();
    return toStr(buf, n);
}

async fn tlsRoundtrip(port: int): string {
    let srv = asyncio.serverListen(port);
    if (srv == 0) { return "BIND-FAIL"; }
    spawn tlsServer(srv);
    let reply = await tlsClient(port);
    asyncio.aclose(srv);
    return reply;
}

@test
fn test_async_tls_roundtrip(): void {
    // Encrypted PING -> PONG over a fully async TLS handshake + record pump.
    assert.equalStr(tlsRoundtrip(18483), "PONG-TLS");
}
