import assert;

fn boxit(x: int): int | undefined { return x; }

fn pick(x: int): int | undefined {
    if (x > 0) { return x; }
    return 0 - x;
}

@test
fn test_valopt_return_roundtrip(): void {
    assert.equalInt(42, boxit(42) ?? 0);
    assert.equalInt(0, boxit(0) ?? 0 - 1);
}

@test
fn test_valopt_conditional_return(): void {
    assert.equalInt(5, pick(5) ?? 0);
    assert.equalInt(3, pick(0 - 3) ?? 0);
    assert.equalInt(0, pick(0) ?? 0 - 1);
}
