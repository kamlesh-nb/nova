// I (parser gaps): `obj?.method(args)` -- an optional-chaining METHOD call on a `T | undefined` receiver --
// compiled to a FieldNotFound error. `?.field` already worked; a call over it treated the method name as a
// field. The checker already permits `x?.get()` (its own optional-safety error even suggests it).
// Fix in codegen: a `.call` whose callee is an optional-chaining evaluates the receiver ONCE; if present,
// it calls `T.method(args)` with the receiver as `self` and yields the result as `R | undefined`; if
// absent, it yields `undefined`.

import assert;

struct Box {
    v: int,
    fn get(self: Box): int { return self.v; }
    fn add(self: Box, k: int): int { return self.v + k; }
    fn label(self: Box): string { return `box=${self.v}`; }
}

fn find(hit: bool): Box | undefined {
    if (hit) { return Box{ v: 5 }; }
    return undefined;
}

@test
fn test_present_value_method(): void {
    assert.equalInt(find(true)?.get() ?? -1, 5);
}

@test
fn test_absent_yields_undefined(): void {
    assert.equalInt(find(false)?.get() ?? -1, -1);
}

@test
fn test_method_with_argument(): void {
    assert.equalInt(find(true)?.add(10) ?? -1, 15);
    assert.equalInt(find(false)?.add(10) ?? -1, -1);
}

@test
fn test_string_returning_method(): void {
    assert.equalStr(find(true)?.label() ?? "none", "box=5");
    assert.equalStr(find(false)?.label() ?? "none", "none");
}

@test
fn test_field_access_still_works(): void {
    let b = find(true);
    assert.equalInt(b?.v ?? -1, 5);
}
