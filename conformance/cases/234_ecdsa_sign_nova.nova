// ECDSA-P256 signing with the RFC 6979 deterministic nonce, in Nova (M9 phase E, no external library).
// Verified against the RFC 6979 Appendix A.2.5 P-256 / SHA-256 test vectors (private key C9AFA9..., the
// messages "sample" and "test"): the produced (r, s) match the RFC exactly, and the signatures verify
// under the Nova ECDSA verifier with the public key derived from the same private key.
import crypto.p256;
import bytes;
import assert;

fn hexNib(c: int): int {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    return 0;
}
fn hexBuf(hex: string): ptr {
    let n = hex.length / 2;
    let b = bytes.alloc(n);
    let i = 0;
    while (i < n) { bytes.write_byte(b, i, hexNib(hex[i * 2]) * 16 + hexNib(hex[i * 2 + 1])); i = i + 1; }
    return b;
}
fn eqHex(buf: ptr, n: int, hex: string): bool {
    if (hex.length != n * 2) { return false; }
    let i = 0;
    while (i < n) {
        if (bytes.read_byte(buf, i) != hexNib(hex[i * 2]) * 16 + hexNib(hex[i * 2 + 1])) { return false; }
        i = i + 1;
    }
    return true;
}

const PRIV: string = "c9afa9d845ba75166b5c215767b1d6934e50c3db36e89b127b8a622b120f6721";
const H_SAMPLE: string = "af2bdbe1aa9b6ec1e2ade1d694f41fc71a831d0268e9891562113d8a62add1bf";
const R_SAMPLE: string = "efd48b2aacb6a8fd1140dd9cd45e81d69d2c877b56aaf991c34d0ea84eaf3716";
const S_SAMPLE: string = "f7cb1c942d657c41d436c7a1b6e29f65f3e900dbb9aff4064dc4ab2f843acda8";
const H_TEST: string = "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08";
const R_TEST: string = "f1abb023518351cd71d881567b1ea663ed3efcf6c5132b354f28d3b0b7d38367";
const S_TEST: string = "019f4113742a2b14bd25926b49c649155f267e60d3814b4c0cc84250e46f0083";

// The deterministic (r, s) for "sample" match RFC 6979 exactly.
@test
fn rfc6979_sample(): void {
    let r = bytes.alloc(32); let s = bytes.alloc(32);
    let ok = p256.ecdsaSign(hexBuf(H_SAMPLE), hexBuf(PRIV), r, s);
    assert.equalInt(ok, 1);
    assert.isTrue(eqHex(r, 32, R_SAMPLE));
    assert.isTrue(eqHex(s, 32, S_SAMPLE));
}

// The deterministic (r, s) for "test" match RFC 6979 exactly.
@test
fn rfc6979_test(): void {
    let r = bytes.alloc(32); let s = bytes.alloc(32);
    let ok = p256.ecdsaSign(hexBuf(H_TEST), hexBuf(PRIV), r, s);
    assert.equalInt(ok, 1);
    assert.isTrue(eqHex(r, 32, R_TEST));
    assert.isTrue(eqHex(s, 32, S_TEST));
}

// Sign then verify with the derived public key (sign/verify round trip).
@test
fn sign_verify_roundtrip(): void {
    let pk = bytes.alloc(65);
    p256.derivePublic(pk, hexBuf(PRIV));
    let r = bytes.alloc(32); let s = bytes.alloc(32);
    p256.ecdsaSign(hexBuf(H_SAMPLE), hexBuf(PRIV), r, s);
    assert.isTrue(p256.ecdsaVerify(hexBuf(H_SAMPLE), pk, r, s));
    // The signature is for this message; a different digest must not verify.
    assert.isTrue(!p256.ecdsaVerify(hexBuf(H_TEST), pk, r, s));
}
