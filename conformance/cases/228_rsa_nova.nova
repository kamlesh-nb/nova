// RSA signature verification in Nova (M9 phase C, no external library). Verified against real OpenSSL
// 3.6 RSA-2048 signatures: RSASSA-PKCS1-v1_5 and RSASSA-PSS (salt = hash length), both over SHA-256,
// plus tamper rejections. The modulus, public exponent, message digest, and signatures are pinned here.
import crypto.rsa;
import bytes;
import assert;

fn hexNib(c: int): int {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    if (c >= 65 && c <= 70) { return c - 55; }
    return 0;
}
fn hexBuf(hex: string): ptr {
    let n = hex.length / 2;
    let b = bytes.alloc(n);
    let i = 0;
    while (i < n) {
        bytes.write_byte(b, i, hexNib(hex[i * 2]) * 16 + hexNib(hex[i * 2 + 1]));
        i = i + 1;
    }
    return b;
}

const N: string = "";
const E: string = "010001";
const HASH: string = "05dd0d0cab745524318ba533da8f2aa6d6511a426fe2fd5eb3ab4deced6001d4";
const SIG_PKCS1: string = "";
const SIG_PSS: string = "";

// hashId 0 = SHA-256; N is 256 bytes.
@test
fn rsa_pkcs1_valid(): void {
    assert.isTrue(rsa.verifyPkcs1(0, hexBuf(HASH), hexBuf(SIG_PKCS1), 256, hexBuf(N), 256, hexBuf(E), 3));
}

@test
fn rsa_pkcs1_bad_hash(): void {
    let h = hexBuf(HASH);
    bytes.write_byte(h, 5, (bytes.read_byte(h, 5) ^ 0x80) & 0xff);
    assert.isTrue(!rsa.verifyPkcs1(0, h, hexBuf(SIG_PKCS1), 256, hexBuf(N), 256, hexBuf(E), 3));
}

@test
fn rsa_pkcs1_bad_sig(): void {
    let s = hexBuf(SIG_PKCS1);
    bytes.write_byte(s, 200, (bytes.read_byte(s, 200) ^ 1) & 0xff);
    assert.isTrue(!rsa.verifyPkcs1(0, hexBuf(HASH), s, 256, hexBuf(N), 256, hexBuf(E), 3));
}

@test
fn rsa_pss_valid(): void {
    assert.isTrue(rsa.verifyPss(0, hexBuf(HASH), hexBuf(SIG_PSS), 256, hexBuf(N), 256, hexBuf(E), 3));
}

@test
fn rsa_pss_bad_hash(): void {
    let h = hexBuf(HASH);
    bytes.write_byte(h, 0, (bytes.read_byte(h, 0) ^ 1) & 0xff);
    assert.isTrue(!rsa.verifyPss(0, h, hexBuf(SIG_PSS), 256, hexBuf(N), 256, hexBuf(E), 3));
}

// A PKCS#1 signature must not verify under PSS and vice versa.
@test
fn rsa_cross_scheme_rejected(): void {
    assert.isTrue(!rsa.verifyPss(0, hexBuf(HASH), hexBuf(SIG_PKCS1), 256, hexBuf(N), 256, hexBuf(E), 3));
    assert.isTrue(!rsa.verifyPkcs1(0, hexBuf(HASH), hexBuf(SIG_PSS), 256, hexBuf(N), 256, hexBuf(E), 3));
}
