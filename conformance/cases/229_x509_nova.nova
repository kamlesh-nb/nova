import crypto.x509;
import bytes;
import assert;

fn hexNib(c: int): int {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    return 0;
}
fn hexBuf(hex: string): ptr {
    let n = hex.length / 2;
    let b = bytes.alloc(n);
    let i = 0;
    while (i < n) {
        bytes.write_byte(b, i, hexNib(hex[i * 2]) * 16 + hexNib(hex[i * 2 + 1]));
        i = i + 1;
    }
    return b;
}

const EC_CA: string = "";
const EC_LEAF: string = "";
const RSA_CA: string = "";
const RSA_LEAF: string = "";

@test
fn ec_chain(): void {
    let ca = x509.parseCert(hexBuf(EC_CA), 387);
    let leaf = x509.parseCert(hexBuf(EC_LEAF), 374);
    assert.isTrue(ca.ok);
    assert.isTrue(leaf.ok);
    assert.equalInt(leaf.sigAlg, 0);
    assert.equalInt(ca.keyType, 1);
    assert.isTrue(x509.verifySignedBy(leaf, ca));
    assert.isTrue(x509.verifySignedBy(ca, ca));
    assert.isTrue(x509.nameMatches(leaf, ca));
}

@test
fn rsa_chain(): void {
    let ca = x509.parseCert(hexBuf(RSA_CA), 785);
    let leaf = x509.parseCert(hexBuf(RSA_LEAF), 771);
    assert.isTrue(ca.ok);
    assert.isTrue(leaf.ok);
    assert.equalInt(leaf.sigAlg, 3);
    assert.equalInt(ca.keyType, 0);
    assert.isTrue(x509.verifySignedBy(leaf, ca));
    assert.isTrue(x509.verifySignedBy(ca, ca));
    assert.isTrue(x509.nameMatches(leaf, ca));
}

@test
fn wrong_issuer(): void {
    let ecCa = x509.parseCert(hexBuf(EC_CA), 387);
    let ecLeaf = x509.parseCert(hexBuf(EC_LEAF), 374);
    let rsaCa = x509.parseCert(hexBuf(RSA_CA), 785);
    let rsaLeaf = x509.parseCert(hexBuf(RSA_LEAF), 771);
    assert.isTrue(!x509.verifySignedBy(ecLeaf, rsaCa));
    assert.isTrue(!x509.verifySignedBy(rsaLeaf, ecCa));
}

@test
fn tampered_cert(): void {
    let buf = hexBuf(EC_LEAF);
    bytes.write_byte(buf, 120, (bytes.read_byte(buf, 120) ^ 1) & 0xff);
    let leaf = x509.parseCert(buf, 374);
    let ca = x509.parseCert(hexBuf(EC_CA), 387);
    assert.isTrue(!x509.verifySignedBy(leaf, ca));
}
