// Flagship: the typed-mediator routing DX via the STDLIB Router (web/routing.nova).
// `app.get<GetUser>(path)` is lowered by codegen to `app.__addRoute("GET", path,
// "GetUser")`; the compiler-generated `__mediator_dispatch_by_name` runs the
// discovered handler's bind → handle → serialize pipeline. Zero handler
// registration, zero `any`, zero downcast — RequestHandler + Router come from the
// stdlib, the user writes only handlers + `app.get<T>(...)`.
import assert;
import web.routing;
import serde.source;

@serializable struct GetUser { pub id: int }
@serializable struct UserDto { pub id: int, pub name: string }
struct GetUserHandler impl RequestHandler<GetUser, UserDto> {
    async fn handle(self, req: GetUser): UserDto { return UserDto{ id: req.id, name: "Ada" }; }
}

@serializable struct AddReq { pub a: int, pub b: int }
@serializable struct SumDto { pub sum: int }
struct AddHandler impl RequestHandler<AddReq, SumDto> {
    async fn handle(self, req: AddReq): SumDto { return SumDto{ sum: req.a + req.b }; }
}

@test
fn test_typed_get_route(): void {
    let app = Router();
    app.get<GetUser>("/api/user");
    let body = app.dispatch("GET", "/api/user", source.fromJson("{\"id\": 7}"));
    assert.equalStr(body, "{\"id\":7,\"name\":\"Ada\"}");
}

@test
fn test_two_routes_and_404(): void {
    let app = Router();
    app.get<GetUser>("/api/user");
    app.post<AddReq>("/api/add");
    assert.equalStr(app.dispatch("POST", "/api/add", source.fromJson("{\"a\":20,\"b\":22}")), "{\"sum\":42}");
    assert.equalStr(app.dispatch("GET", "/nope", source.fromJson("{}")), "404");
}
