// Gates the HTTP request parser (web/request.nova) end to end. It had ZERO tests, so two
// latent bugs shipped: (1) `url.decode` inside parseQuery's `forEach` closure died with
// "Identifier 'url' not found" — the module receiver was captured as a phantom free
// variable (only `string` survived, by accident, via a `_string`-suffixed function);
// fixed by recognising namespace receivers in capture scanning. (2) fromString returned
// corrupted fields because splitPathQuery/parseHeader return tuples of COMPUTED strings
// (see 28_tuple_return_heap). Both are fixed; this locks the parser's real behaviour.
import web.request;
import assert;

@test
fn test_request_line_and_query() {
    let raw = "GET /search?q=hello%20world&tag=a%2Bb HTTP/1.1\r\nHost: example.com\r\n\r\nbody";
    let req = request.Request.fromString(raw);
    assert.equalStr(req.method, "GET");
    assert.equalStr(req.path, "/search");
    // %20 and %2B are percent-decoded (parseQuery now runs url.decode).
    assert.equalStr(req.query.get("q") ?? "", "hello world");
    assert.equalStr(req.query.get("tag") ?? "", "a+b");
    assert.equalStr(req.body, "body");
}

@test
fn test_headers_case_insensitive() {
    let raw = "POST /api HTTP/1.1\r\nContent-Type: application/json\r\nX-Token: abc123\r\n\r\n{}";
    let req = request.Request.fromString(raw);
    // getHeader lowercases both sides.
    assert.equalStr(req.getHeader("content-type") ?? "", "application/json");
    assert.equalStr(req.getHeader("X-TOKEN") ?? "", "abc123");
    assert.equalStr(req.method, "POST");
    assert.equalStr(req.body, "{}");
}

@test
fn test_cookies() {
    let raw = "GET / HTTP/1.1\r\nCookie: session=xyz; theme=dark\r\n\r\n";
    let req = request.Request.fromString(raw);
    assert.equalStr(req.getCookie("session") ?? "", "xyz");
    assert.equalStr(req.getCookie("theme") ?? "", "dark");
}

@test
fn test_no_body_no_query() {
    let req = request.Request.fromString("GET /plain HTTP/1.1\r\n\r\n");
    assert.equalStr(req.path, "/plain");
    assert.equalStr(req.body, "");
}
