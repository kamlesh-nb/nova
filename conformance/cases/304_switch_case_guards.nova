// I (parser gaps): a switch case guard -- `case v if cond:` -- was rejected (the parser expected `:` right
// after the case value). A guarded case matches only when the value matches AND the guard is true; a
// matched-but-guard-false case falls through to `default`. The parser now accepts `if <expr>` before the
// `:`, the guard is checked/typed after the case's payload bindings are in scope, and codegen evaluates it
// after binding and branches to `default` when it is false. A guarded case does not satisfy exhaustiveness,
// so a `default` is required.
//
// NB: because a switch lowers to an integer jump table, each value/variant may appear in at most ONE case;
// the fallback for a guarded case is `default`, not a second case for the same value.

import assert;

@test
fn test_int_guard_true(): void {
    let x = 5;
    let label = "";
    switch (x) {
        case 5 if x > 3: { label = "big5"; }
        default: { label = "other"; }
    }
    assert.equalStr(label, "big5");
}

@test
fn test_int_guard_false_falls_to_default(): void {
    let x = 2;
    let label = "";
    switch (x) {
        case 2 if x > 3: { label = "big2"; }
        default: { label = "small"; }
    }
    assert.equalStr(label, "small");
}

enum Shape { Circle(int), Rect(int, int) }

fn describe(s: Shape): string {
    switch (s) {
        case Shape.Rect(w, h) if w == h: { return "square"; }   // guard references payload bindings
        case Shape.Circle(r) if r > 10: { return "big-circle"; }
        default: { return "other"; }
    }
}

@test
fn test_payload_binding_guard(): void {
    assert.equalStr(describe(Shape.Rect(4, 4)), "square");
    assert.equalStr(describe(Shape.Rect(3, 5)), "other");    // guard false -> default
    assert.equalStr(describe(Shape.Circle(20)), "big-circle");
    assert.equalStr(describe(Shape.Circle(2)), "other");     // guard false -> default
}
