
import assert;

@test
fn test_int_guard_true(): void {
    let x = 5;
    let label = "";
    switch (x) {
        case 5 if x > 3: { label = "big5"; }
        default: { label = "other"; }
    }
    assert.equalStr(label, "big5");
}

@test
fn test_int_guard_false_falls_to_default(): void {
    let x = 2;
    let label = "";
    switch (x) {
        case 2 if x > 3: { label = "big2"; }
        default: { label = "small"; }
    }
    assert.equalStr(label, "small");
}

enum Shape { Circle(int), Rect(int, int) }

fn describe(s: Shape): string {
    switch (s) {
        case Shape.Rect(w, h) if w == h: { return "square"; }
        case Shape.Circle(r) if r > 10: { return "big-circle"; }
        default: { return "other"; }
    }
}

@test
fn test_payload_binding_guard(): void {
    assert.equalStr(describe(Shape.Rect(4, 4)), "square");
    assert.equalStr(describe(Shape.Rect(3, 5)), "other");
    assert.equalStr(describe(Shape.Circle(20)), "big-circle");
    assert.equalStr(describe(Shape.Circle(2)), "other");
}
