// 184 — async I/O on a NULL/failed socket must return an error, NOT crash the process. Regression for a
// SIGSEGV where nova_asend/nova_arecv/nova_arecv_deadline dereferenced socket handle 0 (what asyncConnect
// returns on a refused/timed-out connect). A caller that does I/O on a failed connection without first
// checking the handle — e.g. a DB driver sending its handshake before testing the connect result — must
// get a -1 back, not take down the whole program. Handle 0 is used directly so the test is deterministic
// (no dependency on a port being closed).
import assert;
import net.asyncio;

async fn writeNull(): int {
    return await asyncio.async_write(0, "hello");
}

async fn readNull(): int {
    let buf = bytes.alloc(16);
    let n = await asyncio.async_read_deadline(0, buf, 16, 100);
    bytes.free(buf);
    return n;
}

@test
fn test_async_write_null_socket(): void {
    // -1 = error, and crucially: we're still alive to assert it.
    assert.equalInt(writeNull(), -1);
}

@test
fn test_async_read_null_socket(): void {
    assert.equalInt(readNull(), -1);
}

// The whole point: after both bad-socket operations the process is intact and keeps running.
@test
fn test_survives_multiple_bad_io(): void {
    let i = 0;
    let last = 0;
    while (i < 5) {
        last = writeNull();
        i = i + 1;
    }
    assert.equalInt(last, -1);
    assert.equalInt(i, 5);   // reached here = never crashed
}
