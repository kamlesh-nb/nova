import assert;

fn invokeStr(handler: (string) -> string, arg: string): string {
    return nova_invoke_str_closure(handler, arg);
}

@test
fn test_typed_lambda_param_string(): void {
    let prefix = "got:";
    let f = (s: string) => { return prefix + s; };
    assert.equalStr(f("hi"), "got:hi");
    assert.equalStr(invokeStr(f, "x"), "got:x");
}

@test
fn test_typed_lambda_multi_param(): void {
    let join = (a: string, b: string) => { return a + "|" + b; };
    assert.equalStr(join("x", "y"), "x|y");
    let tag = (s: string) => "[" + s + "]";
    assert.equalStr(tag("z"), "[z]");
}
