// Pins Map<K,V> behavior across resize, and the fn-value convention beneath it.
//
// Guards spec §10 #16/#18: a bare `fn` (e.g. `string.hash`) stored in a field and
// then called through a local was compiled as a closure box, so it loaded the
// function's own first instruction as the call target -> SIGBUS the moment a Map
// grew past its load factor. Map had zero conformance cases, which is exactly why
// that survived. `test_bare_fn_*` pin the convention directly so a regression
// names the cause, not just the symptom.
import assert;
import collections.map;
import string;
import list;

fn double(x: int): int { return x * 2; }

struct FnHolder {
    pub f: (int) -> int,
    init(f: (int) -> int) { self.f = f; }
    // Calling the field directly and calling it through a local must agree.
    pub fn callDirect(self: FnHolder, x: int): int { return (self.f)(x); }
    pub fn callViaLocal(self: FnHolder, x: int): int {
        let g = self.f;
        return (g)(x);
    }
}

@test
fn test_map_basic(): void {
    let m = map.Map<string, int>(16, string.hash);
    assert.equalInt(m.size(), 0);
    m.set("a", 1);
    m.set("b", 2);
    assert.equalInt(m.size(), 2);
    assert.equalInt(m.get("a"), 1);
    assert.equalInt(m.get("b"), 2);
    assert.isTrue(m.has("a"));
    assert.isFalse(m.has("zz"));
}

@test
fn test_map_overwrite(): void {
    let m = map.Map<string, int>(16, string.hash);
    m.set("k", 1);
    m.set("k", 9);
    assert.equalInt(m.size(), 1);
    assert.equalInt(m.get("k"), 9);
}

// The original crash: 20 inserts into cap=16 trips the load factor and resizes.
@test
fn test_map_resize_survives(): void {
    let m = map.Map<string, int>(16, string.hash);
    let i = 0;
    while (i < 20) {
        m.set(`k${i}`, i);
        i = i + 1;
    }
    assert.equalInt(m.size(), 20);
}

// Every key must survive rehashing, with its value intact, across several grows.
@test
fn test_map_resize_preserves_all_entries(): void {
    let m = map.Map<string, int>(4, string.hash);
    let i = 0;
    while (i < 200) {
        m.set(`key${i}`, i * 3);
        i = i + 1;
    }
    assert.equalInt(m.size(), 200);

    let mismatches = 0;
    i = 0;
    while (i < 200) {
        if (m.get(`key${i}`) != i * 3) {
            mismatches = mismatches + 1;
        }
        i = i + 1;
    }
    assert.zero(mismatches);
}

// Deletes leave tombstones; probing must still find live keys, and reuse must not
// resurrect deleted ones.
@test
fn test_map_delete_tombstone_churn(): void {
    let m = map.Map<string, int>(8, string.hash);
    let i = 0;
    while (i < 60) {
        m.set(`t${i}`, i);
        i = i + 1;
    }
    // Delete every other key.
    i = 0;
    while (i < 60) {
        assert.isTrue(m.delete_key(`t${i}`));
        i = i + 2;
    }
    assert.equalInt(m.size(), 30);

    // Survivors intact, deleted keys gone.
    i = 0;
    while (i < 60) {
        if (i % 2 == 0) {
            assert.isFalse(m.has(`t${i}`));
        } else {
            assert.equalInt(m.get(`t${i}`), i);
        }
        i = i + 1;
    }

    // Re-insert over the tombstones and force more growth.
    i = 0;
    while (i < 60) {
        m.set(`t${i}`, i * 10);
        i = i + 2;
    }
    assert.equalInt(m.size(), 60);
    assert.equalInt(m.get("t0"), 0);
    assert.equalInt(m.get("t2"), 20);
    assert.equalInt(m.get("t3"), 3);
}

@test
fn test_map_keys_and_values(): void {
    let m = map.Map<string, int>(4, string.hash);
    let i = 0;
    while (i < 30) {
        m.set(`n${i}`, i);
        i = i + 1;
    }
    assert.equalInt(m.keys().size(), 30);
    assert.equalInt(m.values().size(), 30);
}

// §10 #18 proper: the two call paths must not diverge.
@test
fn test_bare_fn_via_field_and_local_agree(): void {
    let h = FnHolder(double);
    assert.equalInt(h.callDirect(21), 42);
    assert.equalInt(h.callViaLocal(21), 42);
}

@test
fn test_bare_fn_through_local(): void {
    let f = double;
    assert.equalInt((f)(4), 8);
    // A direct call to the same fn must still work.
    assert.equalInt(double(4), 8);
}

// A fn value must have a stable identity — map.nova's keysEqual relies on
// `self.hashFn == string.hash` to pick string comparison.
@test
fn test_bare_fn_value_identity(): void {
    let a = double;
    let b = double;
    assert.isTrue(a == b);
}

// Multi-arg bare fn through a local (arity > 1 exercises argument shifting).
@test
fn test_bare_fn_multi_arg(): void {
    let eq = string.eql;
    assert.isTrue((eq)("ab", "ab"));
    assert.isFalse((eq)("ab", "cd"));
}
