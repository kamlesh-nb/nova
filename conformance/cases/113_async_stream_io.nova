// A1 async-first seam (Stage 2): AsyncStream — non-blocking socket I/O over the asio layer.
//
// A full in-process round trip proves the seam end-to-end: a server coroutine binds + parks on
// `await aaccept`, a client `await asyncConnect`s, `await`s a send, the server `await`s the recv
// and replies, the client `await`s the reply. Every await PARKS the coroutine (kqueue/epoll, no
// thread held) — this is exactly the shape a DB driver uses so its socket recv stops blocking the
// scheduler thread. The `serverListen` bind is synchronous, so the port is listening before the
// client connects (no accept/connect race).
import assert;
import bytes;
import string;
import net.asyncio;

// Turn the first `n` bytes of a recv buffer into a Nova string (length-headed, binary-safe).
fn bufToStr(buf: ptr, n: int): string {
    if (n <= 0) { return ""; }
    let out = bytes.alloc(n);
    let i = 0;
    while (i < n) { bytes.write_byte(out, i, bytes.read_byte(buf, i)); i = i + 1; }
    return out as string;
}

// Server coroutine: accept one connection (parks), read the request (parks), reply "PONG".
async fn serveOnce(srv: long): int {
    let client = await asyncio.aaccept(srv);
    let buf = bytes.alloc(64);
    let n = await asyncio.async_read(client, buf as int, 64);
    let got = bufToStr(buf, n);
    // Reply depends on what we received, proving the recv actually delivered the bytes.
    if (string.eql(got, "PING")) {
        await asyncio.async_write(client, "PONG");
    } else {
        await asyncio.async_write(client, "ERR");
    }
    asyncio.aclose(client);
    return n;
}

// Client coroutine via AsyncStream: connect (parks), send (parks), recv the reply (parks).
async fn clientOnce(port: int): string {
    let s = await asyncio.asyncConnect("127.0.0.1", port);
    let w = await s.sendStr("PING");
    let buf = bytes.alloc(64);
    let n = await s.recvInto(buf as int, 64);
    s.close();
    return bufToStr(buf, n);
}

// Bind synchronously, spawn the server, then run the client and join its result.
async fn roundtrip(port: int): string {
    let srv = asyncio.serverListen(port);
    if (srv == 0) { return "BIND-FAIL"; }
    spawn serveOnce(srv);
    let reply = await clientOnce(port);
    asyncio.aclose(srv);
    return reply;
}

@test
fn test_async_stream_roundtrip(): void {
    // Real loopback over AsyncStream: the client's "PING" reaches the server, whose "PONG"
    // reaches the client — all via parking (await) I/O.
    assert.equalStr(roundtrip(18461), "PONG");
}

// A reader written ONLY against the AsyncIO trait — the DB-seam shape: a driver's reader holds an
// AsyncIO and works over plaintext (AsyncStream) or TLS (TlsStream) unchanged. This exercises
// async trait-method dispatch over a REAL socket, nested (roundtrip → clientVia → pingVia).
async fn pingVia(io: asyncio.AsyncIO): string {
    let w = await io.sendStr("PING");                 // async trait method via dynamic dispatch
    let buf = bytes.alloc(64);
    let n = await io.recvInto(buf as int, 64);        // async trait method via dynamic dispatch
    return bufToStr(buf, n);
}
async fn clientVia(port: int): string {
    let s = await asyncio.asyncConnect("127.0.0.1", port);
    let r = await pingVia(s);                          // AsyncStream widened to AsyncIO param
    s.close();
    return r;
}
async fn roundtripVia(port: int): string {
    let srv = asyncio.serverListen(port);
    if (srv == 0) { return "BIND-FAIL"; }
    spawn serveOnce(srv);
    let reply = await clientVia(port);
    asyncio.aclose(srv);
    return reply;
}

@test
fn test_asyncio_trait_dispatch(): void {
    // The same round trip, but the client reads/writes through the AsyncIO TRAIT (dynamic
    // dispatch over a live socket) — the shape a driver's reader uses.
    assert.equalStr(roundtripVia(18465), "PONG");
}

@test
fn test_async_stream_helpers(): void {
    let s = asyncio.AsyncStream(0);
    assert.isFalse(s.isOpen());        // sock 0 = not open
    s.close();                          // idempotent on a closed stream
    assert.isFalse(s.isOpen());
    let s2 = asyncio.AsyncStream(42);
    assert.isTrue(s2.isOpen());
}
