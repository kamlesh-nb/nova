import assert;

@test
fn test_nan_not_equal_itself(): void {
    let nan = 0.0 / 0.0;
    assert.isTrue(nan != nan);
}

@test
fn test_nan_not_equal_by_eq(): void {
    let nan = 0.0 / 0.0;
    assert.isFalse(nan == nan);
}

@test
fn test_ordinary_float_compare(): void {
    let a = 2.5;
    let b = 2.5;
    assert.isFalse(a != b);
    assert.isTrue(a != 3.5);
    assert.isTrue(a == b);
    assert.isFalse(a == 3.5);
}
