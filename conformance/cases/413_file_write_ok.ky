import io.file;
import io.dir;
import assert;

@test
fn write_ok_to_writable_path(): void {
    // NOT "/tmp/...": on Windows a leading "/" resolves against the current drive
    // root, so this asked for C:\tmp\, which need not exist — the write then failed
    // and the case read as a stdlib gap rather than a bad path. `tempDir()` is the
    // portable spelling (see conformance 211, which already does this).
    let path = dir.Dir.tempDir() + "/kyte_writeok_413.txt";
    assert.isTrue(file.File.writeTextOk(path, "hello"));
    assert.equalStr(file.File.readText(path), "hello");
}

@test
fn write_ok_false_on_bad_path(): void {
    assert.isTrue(!file.File.writeTextOk("/no/such/dir/kyte_413.txt", "x"));
}
