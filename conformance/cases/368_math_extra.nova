// Pins the gap-8 math leaves: asin/acos, hyperbolics (sinh/cosh/tanh), gcd/lcm.
import math;
import assert;

@test
fn test_inverse_trig(): void {
    assert.isTrue(math.fabs(math.asin(0.5) - (math.pi() / 6.0)) < 0.0005);
    assert.isTrue(math.fabs(math.acos(0.5) - (math.pi() / 3.0)) < 0.0005);
    // domain clamp: asin of an out-of-range value saturates rather than producing NaN
    assert.isTrue(math.fabs(math.asin(2.0) - (math.pi() / 2.0)) < 0.0001);
}

@test
fn test_hyperbolic(): void {
    assert.isTrue(math.fabs(math.sinh(0.0)) < 0.0001);
    assert.isTrue(math.fabs(math.cosh(0.0) - 1.0) < 0.0001);
    assert.isTrue(math.fabs(math.tanh(0.0)) < 0.0001);
    // cosh^2 - sinh^2 == 1 for any argument
    let s = math.sinh(0.9);
    let c = math.cosh(0.9);
    assert.isTrue(math.fabs((c * c) - (s * s) - 1.0) < 0.0005);
}

@test
fn test_gcd_lcm(): void {
    assert.equalInt(6, math.gcd(54, 24));
    assert.equalInt(6, math.gcd(24, 54));
    assert.equalInt(6, math.gcd(0 - 54, 24));
    assert.equalInt(0, math.gcd(0, 0));
    assert.equalInt(7, math.gcd(7, 0));
    assert.equalInt(36, math.lcm(12, 18));
    assert.equalInt(0, math.lcm(5, 0));
}
