import assert;

fn idiv(a: int, b: int): int { return a / b; }
fn imod(a: int, b: int): int { return a % b; }
fn ishr(a: int, b: int): int { return a >> b; }
fn ldiv(a: long, b: long): long { return a / b; }
fn lmod(a: long, b: long): long { return a % b; }
fn combo(a: int, b: int, c: int): int { return (a / b) % c + (a >> 1); }

@test
fn test_int_div_mod(): void {
    assert.equalInt(idiv(17, 5), 3);
    assert.equalInt(imod(17, 5), 2);
    assert.equalInt(idiv(-17, 5), -3);
    assert.equalInt(imod(-17, 5), -2);
    assert.equalInt(idiv(17, -5), -3);
    assert.equalInt(imod(17, -5), 2);
}

@test
fn test_arithmetic_shr(): void {
    assert.equalInt(ishr(255, 4), 15);
    assert.equalInt(ishr(-16, 2), -4);
    assert.equalInt(ishr(-1, 8), -1);
}

@test
fn test_long_div_mod(): void {
    assert.isTrue(ldiv(9223372036854775807, 3) == 3074457345618258602);
    assert.isTrue(lmod(9223372036854775807, 3) == 1);
    assert.isTrue(ldiv(-100, 7) == -14);
    assert.isTrue(lmod(-100, 7) == -2);
}

@test
fn test_combined(): void {
    assert.equalInt(combo(20, 3, 4), 12);
}
