import assert;

fn sumTo(n: int): int {
    let s = 0;
    for (let i = 0; i < n; i = i + 1) { s = s + i; }
    return s;
}

fn sumUntil(n: int, stop: int): int {
    let s = 0;
    for (let i = 0; i < n; i = i + 1) {
        if (i == stop) { break; }
        s = s + i;
    }
    return s;
}

fn grid(n: int): int {
    let c = 0;
    for (let i = 0; i < n; i = i + 1) {
        for (let j = 0; j < n; j = j + 1) { c = c + 1; }
    }
    return c;
}

@test
fn test_for_loops(): void {
    assert.equalInt(sumTo(5), 10);
    assert.equalInt(sumTo(1), 0);
    assert.equalInt(sumUntil(10, 3), 3);
    assert.equalInt(grid(3), 9);
    assert.equalInt(grid(0), 0);
}
