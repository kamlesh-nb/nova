// FR-safety-5: error ergonomics over Nova's `T | E` union model.
//  - `try? e` turns an error-union call into an optional (value, or `undefined` on error). Pure sugar
//    for `e catch undefined`, composing with `??`.
//  - `Result<T, E>` (std/result) is the named, value-style companion for callback/async seams, with
//    map / flatMap / getOr.
import assert;
import result;

enum E { Fail }

fn work(fail: bool): int | E {
    if (fail) { return E.Fail; }
    return 42;
}

fn dbl(x: int): int { return x * 2; }

@test
fn try_optional(): void {
    let a = try? work(false);        // int | undefined = 42
    assert.equalInt(a ?? -1, 42);
    let b = try? work(true);         // undefined
    assert.isTrue(b == undefined);
    assert.equalInt(b ?? -1, -1);
}

@test
fn result_map_and_get(): void {
    let okv = result.ok<int, string>(21, "");
    assert.isTrue(okv.ok());
    assert.equalInt(okv.map(dbl).getOr(-1), 42);        // maps the value

    let ev = result.err<int, string>("boom", 0);
    assert.isTrue(ev.isErr());
    assert.equalInt(ev.map(dbl).getOr(-1), -1);          // map is a no-op on error
    assert.equalStr(ev.errorOr("none"), "boom");
}

fn addFive(v: int): result.Result<int, string> {
    return result.ok<int, string>(v + 5, "");
}

@test
fn result_flatmap(): void {
    let start = result.ok<int, string>(10, "");
    let chained = start.flatMap(addFive);
    assert.equalInt(chained.getOr(-1), 15);
}
