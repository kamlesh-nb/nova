// Arming a descriptor that has NOTHING to read must not report it ready.
//
// 192_reactor_echo already covers the opposite case -- data is written before the poll, so the
// readiness report is immediate and correct. That is the easy direction, and it passes on both Linux
// backends. This case covers the direction a server actually spends its time in: an idle connection,
// armed for readability, with no bytes pending. The reactor must simply time out.
//
// It is a backend-parity case, and the interesting half only runs under `KYTE_REACTOR=uring`, where
// readiness is EMULATED on a completion engine (a poll-add SQE) rather than being a native interest
// registration. An emulation that completes immediately on an idle fd turns every such wait into a
// spurious "readable", and the caller then reads 0 bytes and reasonably concludes the peer hung up --
// closing a live connection. Under epoll this is a plain EPOLL_CTL_ADD and the timeout is trivially
// correct, so running the case there is a control, not a duplicate.
import assert;
import bytes;
import os.sys;
import net.poller;

@test
fn test_idle_fd_is_not_reported_readable(): void {
    let (client, server) = sys.newSocketPair(sys.AF_UNIX, sys.SOCK_STREAM);
    assert.isTrue(client >= 0);
    assert.isTrue(server >= 0);

    let r = poller.Reactor(16, 4096, 8);
    assert.isTrue(r.ok());
    assert.equalInt(r.addRead(server, server as long), 0);

    // Nothing has been written to `client`, so `server` has no readable bytes. A 50 ms wait must
    // report zero events rather than a phantom one.
    let n = r.poll(50);
    assert.equalInt(n, 0);

    // And the descriptor must still be usable afterwards: arm it again, this time WITH data, and
    // confirm the reactor reports exactly one ready event for the fd it was told about. This is what
    // catches a first-wait that leaves the arm record or the completion queue in a bad state.
    let out = bytes.alloc(2);
    bytes.write_byte(out, 0, 79);
    bytes.write_byte(out, 1, 75);
    assert.isTrue(sys.write(client, out, 2) == 2);

    let n2 = r.poll(1000);
    assert.equalInt(n2, 1);
    assert.equalInt(r.readyFd(0), server);

    let buf = bytes.alloc(8);
    assert.isTrue(sys.read(server, buf, 8) == 2);
    assert.equalInt(bytes.read_byte(buf, 0) as int, 79);

    bytes.free(out);
    bytes.free(buf);
    r.delRead(server);
    r.destroy();
    assert.equalInt(sys.close(client), 0);
    assert.equalInt(sys.close(server), 0);
}
