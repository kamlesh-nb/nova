// A single parenthesised type is GROUPING, not a one-element tuple: `(T)` is just `T`. The parser used to
// build a 1-element `.tuple` for `(T)`, so `(int | undefined)` became a one-tuple and `(int | undefined) |
// undefined` became Optional<Tuple<Optional<int>>>. Assigning a scalar to that miscompiled and SIGSEGV'd in
// nova_retain on the `??` unbox. Fix: `(T)` with one member returns the member unwrapped (a real tuple needs
// two or more), and an optional is idempotent so a nested `.optional` (`T??`, `(T | undefined) | undefined`)
// collapses to a single `T | undefined`. The legit `(T | undefined) | E` triple union is an error_union, not
// a nested optional, so it is untouched (case 293). Real 2+ element tuples are untouched (cases 336/358).
import assert;

fn takeParenOpt(x: (int | undefined) | undefined): int { return x ?? 1; }
fn takeGroup(x: (int)): int { return x; }

@test
fn test_grouped_and_nested_optional(): void {
    // grouping: (T) is T
    assert.equalInt(takeGroup(8), 8);
    let g: (int) = 5;
    assert.equalInt(g, 5);

    // nested optionals collapse to a single value optional, present + absent both round-trip
    let a: (int | undefined) | undefined = 3;
    assert.equalInt(a ?? 7, 3);
    let b: int?? = 4;
    assert.equalInt(b ?? 9, 4);
    let c: ((int | undefined) | undefined) | undefined = undefined;
    assert.equalInt(c ?? 42, 42);

    // reference-payload grouped optional
    let s: (string | undefined) = "hi";
    assert.equalInt(len(s ?? "x"), 2);

    // through a parameter
    assert.equalInt(takeParenOpt(6), 6);
    assert.equalInt(takeParenOpt(undefined), 1);
}
