import assert;

fn takeParenOpt(x: (int | undefined) | undefined): int { return x ?? 1; }
fn takeGroup(x: (int)): int { return x; }

@test
fn test_grouped_and_nested_optional(): void {
    assert.equalInt(takeGroup(8), 8);
    let g: (int) = 5;
    assert.equalInt(g, 5);

    let a: (int | undefined) | undefined = 3;
    assert.equalInt(a ?? 7, 3);
    let b: int?? = 4;
    assert.equalInt(b ?? 9, 4);
    let c: ((int | undefined) | undefined) | undefined = undefined;
    assert.equalInt(c ?? 42, 42);

    let s: (string | undefined) = "hi";
    assert.equalInt(len(s ?? "x"), 2);

    assert.equalInt(takeParenOpt(6), 6);
    assert.equalInt(takeParenOpt(undefined), 1);
}
