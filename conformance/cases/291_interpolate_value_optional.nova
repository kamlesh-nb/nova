
import assert;

fn getInt(present: bool): int | undefined { if (present) { return 42; } return undefined; }
fn getLong(present: bool): long | undefined { if (present) { return 5000000000; } return undefined; }
fn getStr(present: bool): string | undefined { if (present) { return "hi"; } return undefined; }

@test
fn test_value_optional_present(): void {
    let x = getInt(true);
    assert.equalStr(`v=${x}`, "v=42");
}

@test
fn test_value_optional_absent(): void {
    let x = getInt(false);
    assert.equalStr(`v=${x}`, "v=undefined");
}

@test
fn test_long_optional_present(): void {
    let x = getLong(true);
    assert.equalStr(`v=${x}`, "v=5000000000");
}

@test
fn test_heap_optional_string_present(): void {
    let s = getStr(true);
    assert.equalStr(`s=${s}`, "s=hi");
}

@test
fn test_heap_optional_string_absent(): void {
    let s = getStr(false);
    assert.equalStr(`s=${s}`, "s=undefined");
}

@test
fn test_narrowed_interpolation_still_works(): void {
    let x = getInt(true);
    assert.equalStr(`v=${x ?? -1}`, "v=42");
    let y = getInt(false);
    assert.equalStr(`v=${y ?? -1}`, "v=-1");
}
