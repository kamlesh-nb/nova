import assert;

const MASK32: long = 0xffffffff;
const A: int = 7;
const B: int = 11;
const FLAG: bool = true;
const SEED: int = compute();

fn compute(): int { return 40 + 2; }

fn rotr32(x: long, n: int): long { return ((x >> n) | (x << (32 - n))) & MASK32; }
fn maskLow(x: long): long { return x & MASK32; }
fn addConsts(): int { return A + B + A * B; }
fn pickFlag(): int { if (FLAG) { return 9; } return 1; }
fn seeded(): int { return SEED + 1; }

@test
fn test_mask_and_rotate(): void {
    assert.isTrue(maskLow(0x1000000ff) == 0xff);
    assert.isTrue(rotr32(0x12345678, 8) == 0x78123456);
    assert.isTrue(rotr32(1, 1) == 0x80000000);
}

@test
fn test_scalar_consts(): void {
    assert.equalInt(addConsts(), 95);
    assert.equalInt(pickFlag(), 9);
    assert.equalInt(seeded(), 43);
}
