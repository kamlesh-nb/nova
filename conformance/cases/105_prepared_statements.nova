// D6: prepared statements over the db seam. Two halves, both offline:
//  (1) the PostgreSQL extended-query FRAME builders (Parse/Bind/Describe/Execute/Sync) — pure
//      over byte buffers, so we assert their wire shape without a server (live behavior is
//      verified separately against a running PostgreSQL);
//  (2) the seam-level prepare/queryPrepared/execPrepared contract via a mock connection that
//      echoes the bound params — so handle threading + bounds are gated deterministically.
import assert;
import list;
import string;
import db;
import postgres;

// --- (1) PG extended-query frame shape ----------------------------------------

@test
fn test_parse_frame_shape(): void {
    // Parse ('P'=80): [80][len i32][name\0][sql\0][i16 0 param-types].
    let f = postgres.buildParse("s0", "SELECT 1");
    assert.equalInt(f[0], 80);
    // total length = 1 (type) + 4 (len) + "s0\0"(3) + "SELECT 1\0"(9) + 2 = 19
    assert.equalInt(f.length, 19);
    // length field (bytes 1..4, big-endian) counts everything after the type byte = 18
    let lenField = ((f[1] * 256 + f[2]) * 256 + f[3]) * 256 + f[4];
    assert.equalInt(lenField, 18);
}

@test
fn test_bind_frame_shape(): void {
    // Bind ('B'=66) with two text params.
    let params = List<DbValue>();
    params.push(db.dbInt(5));
    params.push(db.dbText("hi"));
    let f = postgres.buildBind("", "s0", params);
    assert.equalInt(f[0], 66);
    // portal "\0" + stmt "s0\0" + i16(0 fmt) + i16(2 params)
    //   + [i32(1)+"5"] + [i32(2)+"hi"] + i16(0 result fmt)
    // = 1 + 3 + 2 + 2 + (4+1) + (4+2) + 2 = 21 payload; +1 type +4 len = 26
    assert.equalInt(f.length, 26);
}

@test
fn test_sync_and_describe_and_execute(): void {
    let s = postgres.buildSync();       // 'S'=83, empty payload -> len 4, total 5
    assert.equalInt(s[0], 83);
    assert.equalInt(s.length, 5);

    let d = postgres.buildDescribeStmt("s0");   // 'D'=68, 'S'=83 + "s0\0"
    assert.equalInt(d[0], 68);
    assert.equalInt(d[5], 83);           // first payload byte = 'S' (describe statement)

    let e = postgres.buildExecute("", 0);   // 'E'=69
    assert.equalInt(e[0], 69);
}

// --- (2) seam-level prepare/queryPrepared/execPrepared contract ---------------

// A mock that records prepared SQL and, on queryPrepared, returns a one-row result whose two
// cells are the FIRST bound param (as int) and the prepared SQL text — so a test can prove the
// handle selected the right statement and the params were threaded through.
struct EchoConn impl Connection {
    pub prepared: List<string>,
    init() { self.prepared = List<string>(); }

    pub async fn exec(self, sql: string, params: List<DbValue>): ExecResult {
        return ExecResult(params.size(), sql);
    }
    pub async fn query(self, sql: string, params: List<DbValue>): ResultSet {
        let rs = ResultSet();
        rs.columns.push(Column("p0", DbType.Int4));
        rs.columns.push(Column("sql", DbType.Text));
        let r = Row();
        let first = params.get(0) ?? db.dbInt(-1);
        r.cells.push(db.dbInt(first.asInt()));
        r.cells.push(db.dbText(sql));
        rs.rows.push(r);
        rs.rows_affected = 1;
        return rs;
    }
    pub fn close(self): void {}
    pub fn setTimeout(self, ms: int): int { return 0; }

    // emulated prepared statements (the fallback every non-extended driver uses)
    pub async fn prepare(self, sql: string): int {
        let i = 0;
        while (i < self.prepared.size()) {
            if (string.eql(self.prepared.get(i) ?? "", sql)) { return i; }
            i = i + 1;
        }
        self.prepared.push(sql);
        return self.prepared.size() - 1;
    }
    pub async fn queryPrepared(self, stmt: int, params: List<DbValue>): ResultSet {
        if (stmt < 0 || stmt >= self.prepared.size()) { return ResultSet(); }
        return await self.query(self.prepared.get(stmt) ?? "", params);
    }
    pub async fn execPrepared(self, stmt: int, params: List<DbValue>): ExecResult {
        if (stmt < 0 || stmt >= self.prepared.size()) { return ExecResult(0, ""); }
        return await self.exec(self.prepared.get(stmt) ?? "", params);
    }
}

@test
fn test_prepare_threads_params_and_sql(): void {
    let c = EchoConn();
    let h = c.prepare("SELECT a FROM t WHERE id = $1");
    assert.equalInt(h, 0);

    let p = List<DbValue>();
    p.push(db.dbInt(42));
    let rs = c.queryPrepared(h, p);
    assert.equalInt(rs.rowCount(), 1);
    assert.equalInt(rs.row(0).getInt(0), 42);                          // param threaded
    assert.equalStr(rs.row(0).getText(1), "SELECT a FROM t WHERE id = $1");  // right statement
}

@test
fn test_prepare_dedups_same_sql(): void {
    let c = EchoConn();
    let h1 = c.prepare("SELECT 1");
    let h2 = c.prepare("SELECT 2");
    let h3 = c.prepare("SELECT 1");    // same as h1
    assert.equalInt(h1, 0);
    assert.equalInt(h2, 1);
    assert.equalInt(h3, 0);            // deduped to the first handle
}

@test
fn test_prepared_handle_out_of_range_is_empty(): void {
    let c = EchoConn();
    let h = c.prepare("SELECT 1");
    let p = List<DbValue>();
    p.push(db.dbInt(1));
    let rsBad = c.queryPrepared(h + 5, p);   // no such handle
    assert.equalInt(rsBad.rowCount(), 0);
    let exBad = c.execPrepared(-1, p);
    assert.equalInt(exBad.rows_affected as int, 0);
}

@test
fn test_execPrepared_counts_params(): void {
    let c = EchoConn();
    let h = c.prepare("UPDATE t SET a=$1 WHERE id=$2");
    let p = List<DbValue>();
    p.push(db.dbInt(1));
    p.push(db.dbInt(2));
    let ex = c.execPrepared(h, p);
    assert.equalInt(ex.rows_affected as int, 2);   // EchoConn.exec returns params.size()
}
