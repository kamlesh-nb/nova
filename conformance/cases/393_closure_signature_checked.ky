import list;
import assert;
@test
fn typed_and_aliased(): void {
    let f = (x: int) => x + 1;
    let g = f;
    assert.equalInt(g(41), 42);
}
@test
fn untyped_infers_from_context(): void {
    let l = List<int>();
    l.push(1); l.push(2);
    let d = l.map((x) => x * 2);
    assert.equalInt(d.get(0) ?? 0, 2);
    assert.equalInt(d.get(1) ?? 0, 4);
}
