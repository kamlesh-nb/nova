// SHA-384 transcript path: a full pure-Nova TLS 1.3 handshake where the SERVER is restricted to
// AES-256-GCM-SHA384 (0x1302) only -- exactly the "AES-256-GCM-SHA384-only server" that the feature
// inventory flagged. The client offers all three suites; the server negotiates 0x1302, so the ENTIRE key
// schedule (transcript hash, HKDF-Expand-Label, Finished HMAC, traffic keys) runs on SHA-384 (kind=1)
// end to end on both sides. If any part of the SHA-384 branch were wrong the Finished MACs would not
// verify and the handshake would fail. After the handshake we exchange application data both directions to
// prove the 48-byte-secret AES-256-GCM record layer works too.
import net.tlsmembio;
import bytes;
import assert;

const CERT: string = "";
const PRIV: string = "accfe82d31600d5810b9984176898804a4ba458216b1ac913231be5008ca82f1";
const CERT_LEN: int = 421;

fn hexNib(c: int): int { if (c >= 48 && c <= 57) { return c - 48; } if (c >= 97 && c <= 102) { return c - 87; } return 0; }
fn hexBuf(hex: string): ptr {
    let n = hex.length / 2;
    let b = bytes.alloc(n);
    let i = 0;
    while (i < n) { bytes.write_byte(b, i, hexNib(hex[i * 2]) * 16 + hexNib(hex[i * 2 + 1])); i = i + 1; }
    return b;
}

fn handshake(cb: tlsmembio.ClientBio, sb: tlsmembio.ServerBio, tmp: ptr): bool {
    let cdone = false; let sdone = false;
    let i = 0;
    while (i < 20 && !(cdone && sdone)) {
        while (cb.pendingOut() > 0) { let n = cb.pull(tmp, 33792); sb.feed(tmp, n); }
        let ss = sb.step();
        if (ss < 0) { return false; }
        if (ss == 0) { sdone = true; }
        while (sb.pendingOut() > 0) { let n = sb.pull(tmp, 33792); cb.feed(tmp, n); }
        let cs = cb.step();
        if (cs < 0) { return false; }
        if (cs == 0) { cdone = true; }
        i = i + 1;
    }
    return cdone && sdone;
}

@test
fn sha384_only_server_handshake_succeeds(): void {
    let cb = tlsmembio.newClientBio("localhost");
    let sb = tlsmembio.newServerBio(hexBuf(CERT), CERT_LEN, hexBuf(PRIV));
    sb.restrictSuite(0x1302);                             // server offers ONLY AES-256-GCM-SHA384

    let tmp = bytes.alloc(33792);
    assert.isTrue(handshake(cb, sb, tmp));                // Finished MACs (SHA-384) verify on both sides

    // Both sides landed on SHA-384 (kind 1), suite index 1 (AES-256-GCM).
    assert.equalInt(1, sb.negotiatedKind());
    assert.equalInt(1, sb.negotiatedSuite());
    assert.equalInt(1, cb.negotiatedKind());
    assert.equalInt(1, cb.negotiatedSuite());
}

@test
fn sha384_record_layer_roundtrips_app_data(): void {
    let cb = tlsmembio.newClientBio("localhost");
    let sb = tlsmembio.newServerBio(hexBuf(CERT), CERT_LEN, hexBuf(PRIV));
    sb.restrictSuite(0x1302);
    let tmp = bytes.alloc(33792);
    assert.isTrue(handshake(cb, sb, tmp));

    // Client -> server application record under the AES-256-GCM-SHA384 keys.
    let msg = bytes.alloc(5);
    bytes.write_byte(msg, 0, 104); bytes.write_byte(msg, 1, 101); bytes.write_byte(msg, 2, 108);
    bytes.write_byte(msg, 3, 108); bytes.write_byte(msg, 4, 111);   // "hello"
    let w = cb.writeApp(msg, 5);
    assert.isTrue(w > 0);
    while (cb.pendingOut() > 0) { let n = cb.pull(tmp, 33792); sb.feed(tmp, n); }
    let rd = bytes.alloc(64);
    let got = sb.readApp(rd, 64);
    assert.equalInt(5, got);
    assert.equalInt(104, bytes.read_byte(rd, 0));
    assert.equalInt(111, bytes.read_byte(rd, 4));
}
