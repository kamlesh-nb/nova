import assert;
import web.app;
import web.di;
import web.request;
import web.response;
import web.status;
import web.routing;
import web.mediator;
import serde.json;
import serde.source;
import string;

struct Counter impl Service {
    pub count: int,
    init() { self.count = 0; }
    pub fn next(self: Counter): int { self.count = self.count + 1; return self.count; }
}

struct Greeter impl Service {
    pub prefix: string,
    init(p: string) { self.prefix = p; }
    pub fn greet(self: Greeter, name: string): string { return self.prefix + ", " + name + "!"; }
}

@serializable struct Hit impl Message { pub name: string }
@serializable struct HitDto { pub n: int, pub msg: string }

struct HitHandler impl RequestHandler<Hit, HitDto> {
    counter: Counter,
    greeter: Greeter,
    init(counter: Counter, greeter: Greeter) { self.counter = counter; self.greeter = greeter; }
    async fn handle(self: HitHandler, q: Hit): HitDto {
        let n = self.counter.next();
        return HitDto{ n: n, msg: self.greeter.greet(q.name) };
    }
}

fn makeApp(): App {
    let services = ServiceCollection();
    services.addSingleton("Counter", (sp) => { return Counter(); });
    services.addSingleton("Greeter", (sp) => { return Greeter("Hello"); });
    let a = App();
    a.useServices(services);
    a.get<Hit>("/hit/{name}");
    return a;
}

@test
fn test_di_injected_handler_runs(): void {
    let a = makeApp();
    let resp = a.dispatch(Request.fromString("GET /hit/Ada HTTP/1.1\r\nHost: x\r\n\r\n"));
    assert.equalStr(resp.body, `{"n":1,"msg":"Hello, Ada!"}`);
}

@test
fn test_di_singleton_persists_across_requests(): void {
    let a = makeApp();
    let r1 = a.dispatch(Request.fromString("GET /hit/A HTTP/1.1\r\nHost: x\r\n\r\n"));
    let r2 = a.dispatch(Request.fromString("GET /hit/B HTTP/1.1\r\nHost: x\r\n\r\n"));
    let r3 = a.dispatch(Request.fromString("GET /hit/C HTTP/1.1\r\nHost: x\r\n\r\n"));
    assert.equalStr(r1.body, `{"n":1,"msg":"Hello, A!"}`);
    assert.equalStr(r2.body, `{"n":2,"msg":"Hello, B!"}`);
    assert.equalStr(r3.body, `{"n":3,"msg":"Hello, C!"}`);
}
