// 268 — Constructor injection into a TYPED handler. A `RequestHandler<TReq, TResp>` handler declares
// its dependencies as constructor parameters, and the compiler-generated dispatch resolves each one
// from the App-owned DI container (ASP.NET-style). No manual `H(provider.require(...) as T)` wiring.
//
//   struct GetProductByIdHandler impl RequestHandler<GetProductById, ProductDto> {
//       repo: ProductRepository,
//       init(repo: ProductRepository) { self.repo = repo; }   // injected
//       async fn handle(self, q) { return self.repo.findById(q.id); }
//   }
//   services.addSingleton("ProductRepository", (sp) => { return ProductRepository(); });
//   app.useServices(services); app.get<GetProductById>("/api/products/{id:int}");
//
// The generated dispatch builds the handler as `H(__provider.require("ProductRepository") as
// ProductRepository)` and runs it, so a dispatched request reaches a handler with its dependency in place.
import assert;
import string;
import web.app;
import web.di;
import web.request;
import web.response;
import web.status;
import web.routing;
import web.mediator;
import serde.json;
import serde.source;

// A stateful SINGLETON repository, the injected dependency.
struct ProductRepository impl Service {
    pub calls: int,
    init() { self.calls = 0; }
    pub fn findById(self: ProductRepository, id: int): ProductDto {
        self.calls = self.calls + 1;
        return ProductDto{ id: id, name: `product-${id}` };
    }
}

@serializable struct GetProductById impl Message { pub id: int }
@serializable struct ProductDto { pub id: int, pub name: string }

// The handler holds its dependency as a field, injected through its constructor, not a field-less `H{}`.
struct GetProductByIdHandler impl RequestHandler<GetProductById, ProductDto> {
    repo: ProductRepository,
    init(repo: ProductRepository) { self.repo = repo; }
    async fn handle(self: GetProductByIdHandler, q: GetProductById): ProductDto {
        return self.repo.findById(q.id);
    }
}

fn makeApp(): App {
    let services = ServiceCollection();
    services.addSingleton("ProductRepository", (sp) => { return ProductRepository(); });
    let a = App();
    a.useServices(services);
    a.get<GetProductById>("/api/products/{id:int}");
    return a;
}

// A dispatched request runs the typed handler with its injected repository.
@test
fn test_typed_di_injected(): void {
    let a = makeApp();
    let req = Request.fromString("GET /api/products/7 HTTP/1.1\r\nHost: x\r\n\r\n");
    let resp = a.dispatch(req);
    assert.equalStr(resp.body, `{"id":7,"name":"product-7"}`);
    assert.equalInt(resp.status.toCode(), 200);
}

// The injected singleton persists across requests on one App: the repo's call count advances 1 -> 2.
@test
fn test_typed_di_singleton_persists(): void {
    let a = makeApp();
    let r1 = a.dispatch(Request.fromString("GET /api/products/1 HTTP/1.1\r\nHost: x\r\n\r\n"));
    let r2 = a.dispatch(Request.fromString("GET /api/products/2 HTTP/1.1\r\nHost: x\r\n\r\n"));
    assert.equalStr(r1.body, `{"id":1,"name":"product-1"}`);
    assert.equalStr(r2.body, `{"id":2,"name":"product-2"}`);
}
