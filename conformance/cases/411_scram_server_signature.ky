import crypto.scram;
import assert;

@test
fn expected_server_signature_rfc7677() {
    let c = scram.ScramClient{ username: "user", password: "pencil", clientNonce: "rOprNGfwEbeRWgbNEkqO" };
    let serverFirst = "r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,s=W22ZaJ0SNY7soEsUEjb6gQ==,i=4096";
    assert.equalStr(c.expectedServerSignature(serverFirst), "6rriTRBi23WpRR/wtup+mMhUZUn/dB5nLTJRsjl95G4=");
}

@test
fn expected_server_signature_sha1_rfc5802() {
    let c = scram.ScramClient{ username: "user", password: "pencil", clientNonce: "fyko+d2lbbFgONRv9qkxdawL" };
    let serverFirst = "r=fyko+d2lbbFgONRv9qkxdawL3rfcNHYJY1ZVvWVs7j,s=QSXCR+Q6sek8bf92,i=4096";
    assert.equalStr(c.expectedServerSignatureSha1(serverFirst), "rmF9pqV8S7suAoZWja4dJRkFsKQ=");
}

@test
fn wrong_password_yields_different_signature() {
    let good = scram.ScramClient{ username: "user", password: "pencil", clientNonce: "rOprNGfwEbeRWgbNEkqO" };
    let bad = scram.ScramClient{ username: "user", password: "wrong", clientNonce: "rOprNGfwEbeRWgbNEkqO" };
    let sf = "r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,s=W22ZaJ0SNY7soEsUEjb6gQ==,i=4096";
    assert.equalInt(0, if (good.expectedServerSignature(sf) == bad.expectedServerSignature(sf)) 1 else 0);
}
