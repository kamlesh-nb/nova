import assert;
import string;
import io.file;
import io.dir;
import web.app;
import web.request;
import web.status;
import web.static_content;

@test
fn test_static_cache_persists(): void {
    let root = dir.Dir.tempDir();
    let path = root + "/kyte_static_cache_gate.txt";
    file.File.writeText(path, "cached-body");

    let mount = static_content.StaticMount("/s", root, 16);
    let r1 = mount.serve("/s/kyte_static_cache_gate.txt");
    assert.isTrue(r1 != undefined);

    let _ = dir.Dir.remove(path);
    let r2 = mount.serve("/s/kyte_static_cache_gate.txt");
    assert.isTrue(r2 != undefined);

    let miss = mount.serve("/s/never_existed.txt");
    assert.isTrue(miss == undefined);
}

@test
fn test_static_serve_through_app(): void {
    let root = dir.Dir.tempDir();
    file.File.writeText(root + "/kyte_static_gate_index.html", "<h1>Static OK</h1>");
    file.File.writeText(root + "/kyte_static_gate_app.css", "body{color:red}");

    let a = app.App();
    a.useStatic("/s", root);

    let r1 = a.dispatch(request.Request.fromString("GET /s/kyte_static_gate_index.html HTTP/1.1\r\nHost:x\r\n\r\n"));
    assert.isTrue(string.indexOf(r1.body, "Static OK") != -1);
    assert.equalStr(r1.headers.get("Content-Type") ?? "?", "text/html");

    let r2 = a.dispatch(request.Request.fromString("GET /s/kyte_static_gate_app.css HTTP/1.1\r\nHost:x\r\n\r\n"));
    assert.equalStr(r2.headers.get("Content-Type") ?? "?", "text/css");
    let r2b = a.dispatch(request.Request.fromString("GET /s/kyte_static_gate_app.css HTTP/1.1\r\nHost:x\r\n\r\n"));
    assert.isTrue(string.indexOf(r2b.body, "color:red") != -1);

    let rbad = a.dispatch(request.Request.fromString("GET /s/../etc/passwd HTTP/1.1\r\nHost:x\r\n\r\n"));
    assert.isTrue(Status.toCode(rbad.status) == 403);

    let rmiss = a.dispatch(request.Request.fromString("GET /s/nope.txt HTTP/1.1\r\nHost:x\r\n\r\n"));
    assert.isTrue(Status.toCode(rmiss.status) == 404);
}
