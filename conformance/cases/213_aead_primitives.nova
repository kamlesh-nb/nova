// M9 (TLS in Nova), slice 1: the AEAD record-layer primitives. AES-128/256-GCM and
// ChaCha20-Poly1305 are bound from vetted wolfCrypt (never reimplemented in Nova); the Nova TLS
// record layer, key schedule, and handshake that will drive them come next. This checks the
// bindings against published known-answer vectors (NIST GCM, RFC 8439 ChaCha20-Poly1305) so a
// silently-wrong or passthrough binding is caught, plus a round trip and a tamper-detection check.
import crypto.aead;
import bytes;
import assert;

fn hexNib(c: int): int {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    if (c >= 65 && c <= 70) { return c - 55; }
    return 0;
}

// Parse a hex string into dst, returning the byte count.
fn hexInto(dst: ptr, hex: string): int {
    let n = hex.length / 2;
    let i = 0;
    while (i < n) {
        bytes.write_byte(dst, i, hexNib(hex[i * 2]) * 16 + hexNib(hex[i * 2 + 1]));
        i = i + 1;
    }
    return n;
}

// True if the first n bytes of buf equal the given hex string.
fn eqHex(buf: ptr, n: int, hex: string): bool {
    if (hex.length != n * 2) { return false; }
    let i = 0;
    while (i < n) {
        if (bytes.read_byte(buf, i) != hexNib(hex[i * 2]) * 16 + hexNib(hex[i * 2 + 1])) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

@test
fn aes128gcm_nist_empty(): void {
    // NIST GCM test case 1: K=0^128, IV=0^96, empty AAD and plaintext, tag known.
    let key = bytes.alloc(16);
    let iv = bytes.alloc(12);
    let dummy = bytes.alloc(1);
    let tag = bytes.alloc(16);
    assert.isTrue(aead.aesgcmSeal(key, aead.AES128_KEY_LEN, iv, dummy, 0, dummy, 0, dummy, tag));
    assert.isTrue(eqHex(tag, 16, "58e2fccefa7e3061367f1d57a4e7455a"));
    bytes.free(key); bytes.free(iv); bytes.free(dummy); bytes.free(tag);
}

@test
fn aes256gcm_nist_empty(): void {
    // NIST GCM test case 13: K=0^256, IV=0^96, empty AAD and plaintext, tag known.
    let key = bytes.alloc(32);
    let iv = bytes.alloc(12);
    let dummy = bytes.alloc(1);
    let tag = bytes.alloc(16);
    assert.isTrue(aead.aesgcmSeal(key, aead.AES256_KEY_LEN, iv, dummy, 0, dummy, 0, dummy, tag));
    assert.isTrue(eqHex(tag, 16, "530f8afbc74536b9a963b4f1c4cb738b"));
    bytes.free(key); bytes.free(iv); bytes.free(dummy); bytes.free(tag);
}

@test
fn chacha20poly1305_rfc8439(): void {
    // RFC 8439 section 2.8.2 known-answer vector.
    let key = bytes.alloc(32);
    let iv = bytes.alloc(12);
    let aad = bytes.alloc(12);
    let pt = bytes.alloc(114);
    let ct = bytes.alloc(114);
    let tag = bytes.alloc(16);

    hexInto(key, "808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f");
    hexInto(iv, "070000004041424344454647");
    let aadLen = hexInto(aad, "50515253c0c1c2c3c4c5c6c7");
    let ptLen = hexInto(pt, "4c616469657320616e642047656e746c656d656e206f662074686520636c617373206f66202739393a204966204920636f756c64206f6666657220796f75206f6e6c79206f6e652074697020666f7220746865206675747572652c2073756e73637265656e20776f756c642062652069742e");

    assert.isTrue(aead.chachaPolySeal(key, iv, aad, aadLen, pt, ptLen, ct, tag));
    assert.isTrue(eqHex(ct, 114, "d31a8d34648e60db7b86afbc53ef7ec2a4aded51296e08fea9e2b5a736ee62d63dbea45e8ca9671282fafb69da92728b1a71de0a9e060b2905d6a5b67ecd3b3692ddbd7f2d778b8c9803aee328091b58fab324e4fad675945585808b4831d7bc3ff4def08e4b7a9de576d26586cec64b6116"));
    assert.isTrue(eqHex(tag, 16, "1ae10b594f09e26a7e902ecbd0600691"));

    // Open recovers the plaintext.
    let rt = bytes.alloc(114);
    assert.isTrue(aead.chachaPolyOpen(key, iv, aad, aadLen, ct, ptLen, tag, rt));
    let i = 0;
    while (i < ptLen) {
        assert.equalInt(bytes.read_byte(rt, i), bytes.read_byte(pt, i));
        i = i + 1;
    }

    // A flipped tag byte must fail authentication (open returns false).
    bytes.write_byte(tag, 0, bytes.read_byte(tag, 0) + 1);
    assert.isFalse(aead.chachaPolyOpen(key, iv, aad, aadLen, ct, ptLen, tag, rt));

    bytes.free(key); bytes.free(iv); bytes.free(aad); bytes.free(pt);
    bytes.free(ct); bytes.free(tag); bytes.free(rt);
}

@test
fn aesgcm_roundtrip_and_tamper(): void {
    // AES-256-GCM round trip on a real payload, then tamper detection.
    let key = bytes.alloc(32);
    let iv = bytes.alloc(12);
    let aad = bytes.alloc(8);
    let pt = bytes.alloc(32);
    let ct = bytes.alloc(32);
    let tag = bytes.alloc(16);
    let rt = bytes.alloc(32);

    let i = 0;
    while (i < 32) { bytes.write_byte(key, i, i + 1); i = i + 1; }
    i = 0;
    while (i < 12) { bytes.write_byte(iv, i, i * 7); i = i + 1; }
    i = 0;
    while (i < 8) { bytes.write_byte(aad, i, i + 100); i = i + 1; }
    i = 0;
    while (i < 32) { bytes.write_byte(pt, i, i * 3 + 5); i = i + 1; }

    assert.isTrue(aead.aesgcmSeal(key, aead.AES256_KEY_LEN, iv, aad, 8, pt, 32, ct, tag));
    assert.isTrue(aead.aesgcmOpen(key, aead.AES256_KEY_LEN, iv, aad, 8, ct, 32, tag, rt));
    i = 0;
    while (i < 32) { assert.equalInt(bytes.read_byte(rt, i), bytes.read_byte(pt, i)); i = i + 1; }

    // Flip one ciphertext byte: authentication must fail.
    bytes.write_byte(ct, 5, bytes.read_byte(ct, 5) + 1);
    assert.isFalse(aead.aesgcmOpen(key, aead.AES256_KEY_LEN, iv, aad, 8, ct, 32, tag, rt));

    bytes.free(key); bytes.free(iv); bytes.free(aad); bytes.free(pt);
    bytes.free(ct); bytes.free(tag); bytes.free(rt);
}
