import assert;
import bytes;
import os.sys;
import net.poller;
import net.eventedio;

async fn timedRecv(fd: int, kq: int, timeoutMs: int, result: long): void {
    let s = eventedio.ReactorStream(fd, kq);
    let buf = bytes.alloc(64);
    let n = await s.recvIntoDeadline(buf, 64, timeoutMs);
    bytes.write_i32(result, 0, (n + 1000) as long);
    bytes.free(buf);
    s.close();
}

async fn sender(fd: int, kq: int): void {
    let s = eventedio.ReactorStream(fd, kq);
    let msg = bytes.alloc(2);
    bytes.write_byte(msg, 0, 104); bytes.write_byte(msg, 1, 105);
    let _ = await s.sendBuf(msg, 2);
    bytes.free(msg);
}

@test
fn test_recv_deadline_times_out(): void {
    let (a, b) = sys.newSocketPair(sys.AF_UNIX, sys.SOCK_STREAM);
    sys.setNonBlocking(a);
    sys.setNonBlocking(b);
    let r = poller.Reactor(16, 1024, 4);
    poller.setCurrent(r.kq);
    let result = bytes.alloc(4);
    bytes.write_i32(result, 0, 0);
    coroStart(timedRecv(b, r.kq, 40, result));

    let guard = 0;
    while ((bytes.read_i32(result, 0) as int) == 0 && guard < 400) {
        let n = r.pollComplete(500);
        poller.batchBegin();
        let i = 0;
        while (i < n) { nova_reactor_resume(r.completedToken(i)); i = i + 1; }
        guard = guard + 1;
    }

    assert.equalInt(bytes.read_i32(result, 0) as int, 998);
    poller.setCurrent(0);
    bytes.free(result);
    r.destroy();
    sys.close(a);
}

@test
fn test_recv_deadline_gets_data(): void {
    let (a, b) = sys.newSocketPair(sys.AF_UNIX, sys.SOCK_STREAM);
    sys.setNonBlocking(a);
    sys.setNonBlocking(b);
    let r = poller.Reactor(16, 1024, 4);
    poller.setCurrent(r.kq);
    let result = bytes.alloc(4);
    bytes.write_i32(result, 0, 0);
    coroStart(timedRecv(b, r.kq, 5000, result));
    coroStart(sender(a, r.kq));

    let guard = 0;
    while ((bytes.read_i32(result, 0) as int) == 0 && guard < 400) {
        let n = r.pollComplete(500);
        poller.batchBegin();
        let i = 0;
        while (i < n) { nova_reactor_resume(r.completedToken(i)); i = i + 1; }
        guard = guard + 1;
    }

    assert.equalInt(bytes.read_i32(result, 0) as int, 1002);
    poller.setCurrent(0);
    bytes.free(result);
    r.destroy();
    sys.close(a);
    sys.close(b);
}
