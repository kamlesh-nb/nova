// B3-family — a generic fn returning a value of its type parameter (`fn id<T>(v: T): T { return v; }`).
//
// A function result is +1 (the caller owns it), so returning a borrowed parameter must RETAIN it. The
// concrete case did (`fn f(v: Dto): Dto` emitted a retain-on-return), but the GENERIC case did not: the
// retain-on-return keys on `isOwnedExpr`, which resolved a type parameter only through the STRUCT-method
// instantiation (`current_instantiation_id`) and not through a FREE generic fn's `current_method_subst`.
// So `id<Dto>(d)` returned `d` without a retain; the result aliased the caller's `d` and both were
// released -> double-free / use-after-free (in the SYNC and ASYNC paths alike).
//
// Fix: when the returned expression's type is still a bare type parameter, resolve it through the
// method-substitution string (`resolveExpressionTypeName`) and decide ownership by the concrete name.

import assert;

struct Dto { pub id: int, pub name: string, init(i: int, n: string) { self.id = i; self.name = n; } }

fn idG<T>(v: T): T { return v; }
fn pickFirst<T>(a: T, b: T): T { return a; }
async fn idGAsync<T>(v: T): T { return v; }

// (1) return an owned struct type-param argument (was a double-free).
@test
fn test_return_struct(): void {
    let d = Dto(7, "x");
    let a = idG<Dto>(d);
    assert.equalInt(7, a.id);
    assert.equalStr("x", a.name);
}

// (2) an owned string type-param.
@test
fn test_return_string(): void {
    let s = "payload";
    let a = idG<string>(s);
    assert.equalStr("payload", a);
}

// (3) a VALUE type-param must NOT be spuriously retained (no leak / no bogus refcount op).
@test
fn test_return_int(): void {
    let a = idG<int>(42);
    assert.equalInt(42, a);
}

// (4) return ONE of two owned type-param arguments (the other must still be released once).
@test
fn test_pick_first(): void {
    let x = Dto(1, "a");
    let y = Dto(2, "b");
    let r = pickFirst<Dto>(x, y);
    assert.equalInt(1, r.id);
}

// (5) the ASYNC path: a generic async fn returning its owned type-param argument.
@test
fn test_return_struct_async(): void {
    let d = Dto(9, "z");
    let a = idGAsync<Dto>(d);
    assert.equalInt(9, a.id);
    assert.equalStr("z", a.name);
}
