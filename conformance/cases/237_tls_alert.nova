import net.tlsmembio;
import bytes;
import assert;

const SRV_CERT: string = "";
const SRV_PRIV: string = "accfe82d31600d5810b9984176898804a4ba458216b1ac913231be5008ca82f1";

fn hexNib(c: int): int { if (c >= 48 && c <= 57) { return c - 48; } if (c >= 97 && c <= 102) { return c - 87; } return 0; }
fn hexBuf(hex: string): ptr {
    let n = hex.length / 2;
    let b = bytes.alloc(n);
    let i = 0;
    while (i < n) { bytes.write_byte(b, i, hexNib(hex[i * 2]) * 16 + hexNib(hex[i * 2 + 1])); i = i + 1; }
    return b;
}
fn transfer(a: tlsmembio.TlsBio, b: tlsmembio.TlsBio, tmp: ptr): void {
    while (a.pendingOut() > 0) { let n = a.pull(tmp, 33792); if (n <= 0) { return; } b.feed(tmp, n); }
}

@test
fn close_notify_detected(): void {
    let cb = tlsmembio.newClientBio("localhost");
    let sb = tlsmembio.newServerBio(hexBuf(SRV_CERT), 421, hexBuf(SRV_PRIV));
    let cw: tlsmembio.TlsBio = cb;
    let sw: tlsmembio.TlsBio = sb;
    let tmp = bytes.alloc(33792);

    let cdone = false; let sdone = false; let i = 0;
    while (i < 20 && !(cdone && sdone)) {
        transfer(cw, sw, tmp);
        if (sw.step() == 0) { sdone = true; }
        transfer(sw, cw, tmp);
        if (cw.step() == 0) { cdone = true; }
        i = i + 1;
    }
    assert.isTrue(cdone && sdone);

    cb.closeNotify();
    transfer(cw, sw, tmp);
    let out = bytes.alloc(256);
    assert.equalInt(sw.readApp(out, 256), 0 - 1);

    cb.closeBio();
    sb.closeBio();
}
