import assert;
import bytes;

@test
fn u8x16_load_xor_store(): void {
    let a = bytes.alloc(16);
    let b = bytes.alloc(16);
    let d = bytes.alloc(16);
    let i = 0;
    while (i < 16) {
        bytes.write_byte(a, i, i);
        bytes.write_byte(b, i, 0xff);
        i = i + 1;
    }
    let vx = simd.xorU8x16(simd.loadU8x16(a, 0), simd.loadU8x16(b, 0));
    simd.storeU8x16(d, 0, vx);
    i = 0;
    while (i < 16) { assert.equalInt(bytes.read_byte(d, i), 255 - i); i = i + 1; }
}

@test
fn u8x16_eq_movemask(): void {
    let a = bytes.alloc(16);
    let i = 0;
    while (i < 16) { bytes.write_byte(a, i, if (i == 3 || i == 7) 0x41 else 0x00); i = i + 1; }
    let eqv = simd.eqU8x16(simd.loadU8x16(a, 0), simd.splatU8x16(0x41));
    assert.equalInt(simd.movemaskU8x16(eqv), 0x88);
}

@test
fn u8x16_add_and_or(): void {
    let a = bytes.alloc(16);
    let b = bytes.alloc(16);
    let d = bytes.alloc(16);
    let i = 0;
    while (i < 16) { bytes.write_byte(a, i, 0x30); bytes.write_byte(b, i, 0x0f); i = i + 1; }
    simd.storeU8x16(d, 0, simd.addU8x16(simd.loadU8x16(a, 0), simd.loadU8x16(b, 0)));
    assert.equalInt(bytes.read_byte(d, 0), 0x3f);
    simd.storeU8x16(d, 0, simd.andU8x16(simd.loadU8x16(a, 0), simd.loadU8x16(b, 0)));
    assert.equalInt(bytes.read_byte(d, 0), 0x00);
    simd.storeU8x16(d, 0, simd.orU8x16(simd.loadU8x16(a, 0), simd.loadU8x16(b, 0)));
    assert.equalInt(bytes.read_byte(d, 0), 0x3f);
}

@test
fn u32x4_add_and_shift(): void {
    let buf = bytes.alloc(16);
    let i = 0;
    while (i < 4) { bytes.write_i32(buf, i * 4, i + 1); i = i + 1; }
    let v = simd.loadU32x4(buf, 0);
    let out = bytes.alloc(16);
    simd.storeU32x4(out, 0, simd.shlU32x4(v, 1));
    i = 0;
    while (i < 4) { assert.equalInt(bytes.read_i32(out, i * 4), (i + 1) * 2); i = i + 1; }
    simd.storeU32x4(out, 0, simd.addU32x4(v, simd.splatU32x4(10)));
    i = 0;
    while (i < 4) { assert.equalInt(bytes.read_i32(out, i * 4), (i + 1) + 10); i = i + 1; }
    simd.storeU32x4(out, 0, simd.shrU32x4(simd.splatU32x4(16), 2));
    assert.equalInt(bytes.read_i32(out, 0), 4);
}

@test
fn u64x2_add_xor(): void {
    let buf = bytes.alloc(16);
    bytes.write_i32(buf, 0, 5); bytes.write_i32(buf, 4, 0);
    bytes.write_i32(buf, 8, 9); bytes.write_i32(buf, 12, 0);
    let v = simd.loadU64x2(buf, 0);
    let out = bytes.alloc(16);
    simd.storeU64x2(out, 0, simd.addU64x2(v, simd.splatU64x2(3)));
    assert.equalInt(bytes.read_i32(out, 0), 8);
    assert.equalInt(bytes.read_i32(out, 8), 12);
    simd.storeU64x2(out, 0, simd.xorU64x2(v, v));
    assert.equalInt(bytes.read_i32(out, 0), 0);
    assert.equalInt(bytes.read_i32(out, 8), 0);
}
