// TLS 1.3 server-side negotiation (RFC 8446): a pure-Nova client<->server handshake driven in memory,
// exercising the server's cipher-suite / group / ALPN selection. The client offers a subset and the
// server picks: ALPN echo (server chooses from its offer list) and secp256r1 group negotiation (the
// client offers only a P-256 key_share, so the server must run P-256 ECDH). Complements the SHA-256 /
// x25519 loopback in case 235.
import net.tlsmembio;
import bytes;
import assert;

const SRV_CERT: string = "";
const SRV_PRIV: string = "accfe82d31600d5810b9984176898804a4ba458216b1ac913231be5008ca82f1";

fn hexNib(c: int): int { if (c >= 48 && c <= 57) { return c - 48; } if (c >= 97 && c <= 102) { return c - 87; } return 0; }
fn hexBuf(hex: string): ptr {
    let n = hex.length / 2;
    let b = bytes.alloc(n);
    let i = 0;
    while (i < n) { bytes.write_byte(b, i, hexNib(hex[i * 2]) * 16 + hexNib(hex[i * 2 + 1])); i = i + 1; }
    return b;
}
fn strEq(a: string, b: string): bool {
    if (a.length != b.length) { return false; }
    let i = 0; while (i < a.length) { if (a[i] != b[i]) { return false; } i = i + 1; }
    return true;
}

// Drive a client<->server handshake to completion; returns true iff both sides finished.
fn handshake(cb: tlsmembio.ClientBio, sb: tlsmembio.ServerBio, tmp: ptr): bool {
    let cdone = false; let sdone = false;
    let i = 0;
    while (i < 20 && !(cdone && sdone)) {
        while (cb.pendingOut() > 0) { let n = cb.pull(tmp, 33792); sb.feed(tmp, n); }
        let ss = sb.step();
        if (ss < 0) { return false; }
        if (ss == 0) { sdone = true; }
        while (sb.pendingOut() > 0) { let n = sb.pull(tmp, 33792); cb.feed(tmp, n); }
        let cs = cb.step();
        if (cs < 0) { return false; }
        if (cs == 0) { cdone = true; }
        i = i + 1;
    }
    return cdone && sdone;
}

// The server echoes an ALPN protocol chosen from its own offer list.
@test
fn server_alpn_echo(): void {
    let cb = tlsmembio.newClientBioAlpn("localhost", "h2,http/1.1");
    let sb = tlsmembio.newServerBio(hexBuf(SRV_CERT), 421, hexBuf(SRV_PRIV));
    sb.offerAlpn("http/1.1");                       // server supports only http/1.1
    let tmp = bytes.alloc(33792);
    assert.isTrue(handshake(cb, sb, tmp));
    assert.isTrue(strEq(sb.selectedAlpn(), "http/1.1"));
    assert.isTrue(strEq(cb.selectedAlpn(), "http/1.1"));
}

// With no server ALPN offer, nothing is negotiated even if the client offers protocols.
@test
fn server_alpn_none(): void {
    let cb = tlsmembio.newClientBioAlpn("localhost", "h2,http/1.1");
    let sb = tlsmembio.newServerBio(hexBuf(SRV_CERT), 421, hexBuf(SRV_PRIV));
    let tmp = bytes.alloc(33792);
    assert.isTrue(handshake(cb, sb, tmp));
    assert.isTrue(strEq(cb.selectedAlpn(), ""));
}

// The client offers only a secp256r1 key_share, so the server must negotiate the P-256 group and the
// handshake still completes with bidirectional application data.
@test
fn server_p256_group(): void {
    let cb = tlsmembio.newClientBioGroups("localhost", "", 2);   // groupMask 2 = secp256r1 only
    let sb = tlsmembio.newServerBio(hexBuf(SRV_CERT), 421, hexBuf(SRV_PRIV));
    let tmp = bytes.alloc(33792);
    assert.isTrue(handshake(cb, sb, tmp));
    assert.equalInt(sb.srv.group, 0x0017);          // server selected secp256r1

    let msg = bytes.alloc(3);
    bytes.write_byte(msg, 0, 88); bytes.write_byte(msg, 1, 89); bytes.write_byte(msg, 2, 90);
    cb.writeApp(msg, 3);
    while (cb.pendingOut() > 0) { let n = cb.pull(tmp, 33792); sb.feed(tmp, n); }
    let out = bytes.alloc(64);
    assert.equalInt(sb.readApp(out, 64), 3);
    assert.equalInt(bytes.read_byte(out, 0), 88);
    assert.equalInt(bytes.read_byte(out, 2), 90);
}
