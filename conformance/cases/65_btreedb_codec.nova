// The typed BTreeDB driver's wire CODEC (data/btree/btreedb.nova) — gated OFFLINE against
// hand-built byte buffers matching the binary protocol (btree proto/wire.zig), so the
// encode/decode is verified without a live server. Covers: request-frame encoding, typed
// RowDescription + DataRow decode (int/text/bool/NULL), CommandComplete + Error decode,
// and client-side $N parameter substitution with the server's escaping.
import assert;
import bytes;
import string;
import list;
import db;
import btreedb;

// Local big-endian byte-string builders (mirror the server's encoding) to synthesize wire
// payloads. A Nova string is a length-headed byte buffer, so `+` concatenation is binary-safe.
fn u16b(v: int): string {
    let p = bytes.alloc(2);
    bytes.write_byte(p, 0, (v / 256) % 256);
    bytes.write_byte(p, 1, v % 256);
    return p as string;
}
fn u32b(v: int): string {
    let p = bytes.alloc(4);
    bytes.write_byte(p, 0, (v / 16777216) % 256);
    bytes.write_byte(p, 1, (v / 65536) % 256);
    bytes.write_byte(p, 2, (v / 256) % 256);
    bytes.write_byte(p, 3, v % 256);
    return p as string;
}
fn s16(s: string): string { return u16b(s.length) + s; }

// RowDescription field: name, table_id(u32), col_no(u16), type_oid(u32), type_size(u16),
// type_mod(u32), format(u16).
fn field(name: string, oid: int, size: int): string {
    return s16(name) + u32b(0) + u16b(0) + u32b(oid) + u16b(size) + u32b(0) + u16b(0);
}

@test
fn test_request_frame_encoding(): void {
    // 'Q' query frame: [81][u32 len][u16 slen]["Q"]. len = 4 + (2 + 1) = 7.
    let f = btreedb.buildQueryFrame("Q");
    assert.equalInt(f.length, 8);           // 1 + 4 + 2 + 1
    assert.equalInt(f[0], 81);              // 'Q'
    assert.equalInt(f[1], 0);
    assert.equalInt(f[2], 0);
    assert.equalInt(f[3], 0);
    assert.equalInt(f[4], 7);               // length = 7
    assert.equalInt(f[5], 0);
    assert.equalInt(f[6], 1);               // slen = 1
    assert.equalInt(f[7], 81);              // 'Q'
}

@test
fn test_rowdesc_decode_types(): void {
    // Columns: id INT4(2), name TEXT(9), active BOOL(1).
    let rd = u16b(3) + field("id", 2, 4) + field("name", 9, 65535) + field("active", 1, 1);
    let cols = btreedb.decodeRowDesc(rd);
    assert.equalInt(cols.size(), 3);

    let c0 = cols.get(0) ?? Column("", DbType.Null);
    assert.equalStr(c0.name, "id");
    assert.isTrue(c0.type_oid == DbType.Int4);

    let c1 = cols.get(1) ?? Column("", DbType.Null);
    assert.equalStr(c1.name, "name");
    assert.isTrue(c1.type_oid == DbType.Text);

    let c2 = cols.get(2) ?? Column("", DbType.Null);
    assert.isTrue(c2.type_oid == DbType.Bool);
}

@test
fn test_datarow_typed_decode(): void {
    let rd = u16b(3) + field("id", 2, 4) + field("name", 9, 65535) + field("active", 1, 1);
    let cols = btreedb.decodeRowDesc(rd);

    // Row: id=1, name="ada", active=true  (text-format values).
    let dr = u16b(3) + u32b(1) + "1" + u32b(3) + "ada" + u32b(4) + "true";
    let row = btreedb.decodeDataRow(dr, cols);
    assert.equalInt(row.getInt(0), 1);       // typed int, not the string "1"
    assert.equalStr(row.getText(1), "ada");
    assert.isTrue(row.getBool(2));

    // Row with a NULL: id=2, name=NULL (len -1), active=false.
    let dr2 = u16b(3) + u32b(1) + "2" + u32b(4294967295) + u32b(5) + "false";
    let row2 = btreedb.decodeDataRow(dr2, cols);
    assert.equalInt(row2.getInt(0), 2);
    assert.isTrue(row2.isNull(1));
    assert.isTrue(!row2.getBool(2));
}

@test
fn test_tag_and_error_decode(): void {
    // CommandComplete 'C' payload is a str16 tag.
    let tag = btreedb.decodeTag(s16("SELECT 2"));
    assert.equalStr(tag, "SELECT 2");

    // ErrorResponse 'E' payload: severity, code, message (each str16).
    let ep = s16("ERROR") + s16("42P01") + s16("no such table");
    let err = btreedb.decodeError(ep);
    assert.equalStr(err.code, "42P01");
    assert.equalStr(err.message, "no such table");
    assert.isTrue(!err.isEmpty());
}

@test
fn test_param_substitution(): void {
    let params = List<DbValue>();
    params.push(db.dbInt(42));
    params.push(db.dbText("o'brien"));   // must be escaped -> 'o''brien'
    let sql = btreedb.substituteParams("INSERT INTO t VALUES ($1, $2)", params);
    assert.equalStr(sql, "INSERT INTO t VALUES (42, 'o''brien')");

    // NULL and bool.
    let p2 = List<DbValue>();
    p2.push(db.dbNull());
    p2.push(db.dbBool(true));
    let sql2 = btreedb.substituteParams("VALUES ($1, $2)", p2);
    assert.equalStr(sql2, "VALUES (NULL, true)");
}
