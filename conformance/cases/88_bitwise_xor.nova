// Gates the bitwise operators `^` (XOR) and `~` (NOT): C-family precedence
// (`&` > `^` > `|`), one's complement, `x & ~mask` bit-clearing, 64-bit `ulong`.
import assert;

@test
fn test_bitwise_not(): void {
    assert.equalInt(~0, -1);           // all ones
    assert.equalInt(~5, -6);           // one's complement: ~x == -x - 1
    assert.equalInt(~~42, 42);         // involution
    assert.equalInt(255 & ~15, 240);   // clear the low nibble (the common idiom)
    // `~x == x ^ -1`.
    assert.equalInt(~123, 123 ^ -1);
}

@test
fn test_xor_values(): void {
    assert.equalInt(12 ^ 10, 6);
    assert.equalInt(255 ^ 0, 255);
    assert.equalInt(5 ^ 5, 0);
    assert.equalInt(0 ^ 123, 123);
    // XOR is its own inverse: (x ^ k) ^ k == x.
    assert.equalInt((42 ^ 1337) ^ 1337, 42);
}

@test
fn test_xor_precedence(): void {
    // `&` binds tighter than `^` binds tighter than `|`:
    //   1 & 3 ^ 4 | 8  ==  ((1 & 3) ^ 4) | 8  ==  (1 ^ 4) | 8  ==  5 | 8  ==  13
    assert.equalInt(1 & 3 ^ 4 | 8, 13);
    // Explicit parens agree.
    assert.equalInt(((1 & 3) ^ 4) | 8, 13);
    // `^` looser than `&`: 6 ^ 3 & 2 == 6 ^ (3 & 2) == 6 ^ 2 == 4
    assert.equalInt(6 ^ 3 & 2, 4);
}

@test
fn test_bitwise_compound_assign(): void {
    // &=  |=  ^=  <<=  >>=  desugar to `x = x <op> y`.
    let x = 12;
    x &= 10; assert.equalInt(x, 8);    // 12 & 10
    x |= 1;  assert.equalInt(x, 9);    // 8 | 1
    x ^= 5;  assert.equalInt(x, 12);   // 9 ^ 5
    x <<= 2; assert.equalInt(x, 48);   // 12 << 2
    x >>= 1; assert.equalInt(x, 24);   // 48 >> 1
    // combines with `~`
    let m = 255;
    m &= ~15; assert.equalInt(m, 240);
}

@test
fn test_xor_ulong(): void {
    let a: ulong = 6148914691236517205;   // 0x5555555555555555
    let r: ulong = a ^ 255;               // flip the low byte: 0x55 ^ 0xFF = 0xAA
    // low byte becomes 0xAA (170); the value stays huge and positive.
    assert.equalInt((r & 255) as int, 170);
    // self-inverse holds at 64 bits too.
    assert.equalInt((((a ^ 987654321) ^ 987654321) == a) as int, 1);
}
