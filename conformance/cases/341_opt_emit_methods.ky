import assert;

class Counter {
    n: int,

    fn get(self: Counter): int { return self.n; }
    fn addN(self: Counter, k: int): int { return self.n + k; }
    fn bump(self: Counter, d: int): int { self.n = self.n + d; return self.n; }
    fn doubled(self: Counter): int { return self.get() * 2; }
    fn clamp(self: Counter, lo: int, hi: int): int {
        if (self.n < lo) { return lo; }
        if (self.n > hi) { return hi; }
        return self.n;
    }
    fn maskLow(self: Counter): int { return self.n & 255; }
}

@test
fn test_field_read_and_args(): void {
    let c = Counter{ n: 10 };
    assert.equalInt(c.get(), 10);
    assert.equalInt(c.addN(5), 15);
    assert.equalInt(c.doubled(), 20);
}

@test
fn test_field_write(): void {
    let c = Counter{ n: 5 };
    assert.equalInt(c.bump(4), 9);
    assert.equalInt(c.get(), 9);
}

@test
fn test_control_and_mask(): void {
    let c = Counter{ n: 50 };
    assert.equalInt(c.clamp(0, 20), 20);
    assert.equalInt(c.clamp(100, 200), 100);
    let d = Counter{ n: 0x1ff };
    assert.equalInt(d.maskLow(), 255);
}
