import crypto.tls.truststore;
import bytes;
import assert;

const ROOT_PEM: string = "-----BEGIN CERTIFICATE-----\nMIIBjjCCATOgAwIBAgIUHbZhpCUOFkfCDqv/JeotLJDyeXMwCgYIKoZIzj0EAwIw\nHDEaMBgGA1UEAwwRTm92YSBUZXN0IFJvb3QgQ0EwHhcNMjYwNzI5MTgwOTIyWhcN\nMzYwNzI2MTgwOTIyWjAcMRowGAYDVQQDDBFOb3ZhIFRlc3QgUm9vdCBDQTBZMBMG\nByqGSM49AgEGCCqGSM49AwEHA0IABNqn/zlADJ/12wkVnD6USO641XXalyG/QvZ5\nqqxdqo1yIovs15f1M+DBJqfkqrbehbV6j3prLWU4rnfaEUGSj0ujUzBRMB0GA1Ud\nDgQWBBTfDvA8kCM/LHd0JGhivHtUZR6M1zAfBgNVHSMEGDAWgBTfDvA8kCM/LHd0\nJGhivHtUZR6M1zAPBgNVHRMBAf8EBTADAQH/MAoGCCqGSM49BAMCA0kAMEYCIQC8\n154wFHubZjSBCEqyZyyn8k4VrnEt470nLpHn6GSwUQIhAKg2/3w49bVXLlTlQS3A\nzLPSa2emofa5mz9B5PV4lkqg\n-----END CERTIFICATE-----\n";
const LEAF_HEX: string = "";

fn hexNib(c: int): int { if (c >= 48 && c <= 57) { return c - 48; } if (c >= 97 && c <= 102) { return c - 87; } return 0; }
fn hexBuf(hex: string): ptr {
    let n = hex.length / 2;
    let b = bytes.alloc(n);
    let i = 0;
    while (i < n) { bytes.write_byte(b, i, hexNib(hex[i * 2]) * 16 + hexNib(hex[i * 2 + 1])); i = i + 1; }
    return b;
}

fn leafList(hex: string, lenOut: ptr): ptr {
    let n = hex.length / 2;
    let leaf = hexBuf(hex);
    let list = bytes.alloc(3 + n + 2);
    bytes.write_byte(list, 0, (n >> 16) & 0xff); bytes.write_byte(list, 1, (n >> 8) & 0xff); bytes.write_byte(list, 2, n & 0xff);
    let i = 0;
    while (i < n) { bytes.write_byte(list, 3 + i, bytes.read_byte(leaf, i)); i = i + 1; }
    bytes.write_byte(list, 3 + n, 0); bytes.write_byte(list, 3 + n + 1, 0);
    bytes.free(leaf);
    bytes.write_i32(lenOut, 0, 3 + n + 2);
    return list;
}

@test
fn trust_accepts_valid_chain(): void {
    let store = truststore.loadPemBundle(ROOT_PEM);
    assert.equalInt(store.count(), 1);
    let lo = bytes.alloc(4);
    let list = leafList(LEAF_HEX, lo);
    let listLen = bytes.read_byte(lo, 0) | (bytes.read_byte(lo, 1) << 8) | (bytes.read_byte(lo, 2) << 16);
    assert.isTrue(store.trusts(list, listLen, "localhost", 20270101000000));
}

@test
fn trust_rejects_wrong_host(): void {
    let store = truststore.loadPemBundle(ROOT_PEM);
    let lo = bytes.alloc(4);
    let list = leafList(LEAF_HEX, lo);
    let listLen = bytes.read_byte(lo, 0) | (bytes.read_byte(lo, 1) << 8) | (bytes.read_byte(lo, 2) << 16);
    assert.isTrue(!store.trusts(list, listLen, "evil.example.com", 20270101000000));
}

@test
fn trust_rejects_out_of_validity(): void {
    let store = truststore.loadPemBundle(ROOT_PEM);
    let lo = bytes.alloc(4);
    let list = leafList(LEAF_HEX, lo);
    let listLen = bytes.read_byte(lo, 0) | (bytes.read_byte(lo, 1) << 8) | (bytes.read_byte(lo, 2) << 16);
    assert.isTrue(!store.trusts(list, listLen, "localhost", 20200101000000));
    assert.isTrue(!store.trusts(list, listLen, "localhost", 20300101000000));
}

@test
fn trust_rejects_empty_store(): void {
    let store = truststore.loadPemBundle("no certificates here");
    assert.equalInt(store.count(), 0);
    let lo = bytes.alloc(4);
    let list = leafList(LEAF_HEX, lo);
    let listLen = bytes.read_byte(lo, 0) | (bytes.read_byte(lo, 1) << 8) | (bytes.read_byte(lo, 2) << 16);
    assert.isTrue(!store.trusts(list, listLen, "localhost", 20270101000000));
}
