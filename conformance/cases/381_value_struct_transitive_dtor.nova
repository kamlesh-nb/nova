// P0 (value-semantics completion): a value struct that transitively owns heap data — i.e. it has NO
// directly-owned field, only nested VALUE-struct fields whose leaves are owned (a `string`) — must still
// get its destructor scheduled at scope exit. Before the fix, `valueStructHasOwnedFields` checked only
// DIRECT fields, so `Outer{inner:S{data:string}}` and `Two{a:S,b:S}` got no drop and leaked S.data on
// every construction (600-object ARC-audit leak). This case exercises both the block-scope and the
// function-scope cleanup paths; the --arc / --asan gates turn a regression here into a hard failure.
import assert;

struct S {
    pub data: string,
    init(d: string) { self.data = d; }
}
struct Outer {
    pub inner: S,
    init(d: string) { self.inner = S(d); }
}
struct Two {
    pub a: S,
    pub b: S,
    init(x: string, y: string) { self.a = S(x); self.b = S(y); }
}

// Build a fresh HEAP string each call so a missing destructor is a real, detectable leak.
fn intToStr(n: int): string {
    if (n == 0) { return "0"; }
    let s = "";
    let m = n;
    while (m > 0) { s = digit(m % 10) + s; m = m / 10; }
    return s;
}
fn digit(d: int): string {
    if (d == 0) { return "0"; } if (d == 1) { return "1"; } if (d == 2) { return "2"; }
    if (d == 3) { return "3"; } if (d == 4) { return "4"; } if (d == 5) { return "5"; }
    if (d == 6) { return "6"; } if (d == 7) { return "7"; } if (d == 8) { return "8"; }
    return "9";
}

// Value semantics: a copy of a nested value struct must be independent of the original.
@test
fn nested_value_struct_is_copied(): void {
    let a = Outer("original-payload-string");
    let b = a;                       // value copy (deep, inline)
    b.inner.data = "mutated-in-b";
    assert.equalStr(a.inner.data, "original-payload-string");  // a is untouched
    assert.equalStr(b.inner.data, "mutated-in-b");
}

// P1: copying a value struct must RETAIN its transitively-owned heap data, or dropping both the original
// and the copy double-frees it (heap-use-after-free). A string literal would not exercise this (constant,
// not heap), so use a fresh heap string per iteration. Two nesting levels checks the recursion depth.
struct Mid { pub s: S, init(d: string) { self.s = S(d); } }
struct Deep { pub m: Mid, init(d: string) { self.m = Mid(d); } }
@test
fn copy_retains_nested_owned(): void {
    let i = 0;
    while (i < 100) {
        let a = Outer("heap-" + intToStr(i) + "-payload");
        let b = a;                   // must retain a.inner.data; a AND b drop here
        assert.equalStr(b.inner.data, a.inner.data);
        i = i + 1;
    }
    assert.isTrue(true);
}
@test
fn copy_retains_two_levels(): void {
    let i = 0;
    while (i < 100) {
        let a = Deep("deep-" + intToStr(i));
        let b = a;
        assert.equalStr(b.m.s.data, a.m.s.data);
        i = i + 1;
    }
    assert.isTrue(true);
}

// Block-scope drop: each loop iteration's Outer must release its transitively-owned string.
@test
fn block_scope_no_leak(): void {
    let i = 0;
    while (i < 100) {
        let o = Outer("blk-" + intToStr(i) + "-tail");
        assert.equalStr(o.inner.data, o.inner.data);
        i = i + 1;
    }
    assert.isTrue(true);
}

// Function-scope drop: a value struct that is a direct function-scope local (no enclosing block) must
// release its transitively-owned data at return.
fn makeAndDrop(i: int): void {
    let t = Two("x-" + intToStr(i), "y-" + intToStr(i));
    assert.equalStr(t.a.data, t.a.data);
}
@test
fn function_scope_no_leak(): void {
    let i = 0;
    while (i < 100) { makeAndDrop(i); i = i + 1; }
    assert.isTrue(true);
}
