// 167 — I1 reverse-proxy backend Pool + round-robin selection (the offline-testable surface of
// net/proxy). The full L7 proxy (accept → frame request → forward → frame response → stream back) is
// proven live end-to-end separately; here we lock in the round-robin cursor + empty-pool sentinel that
// the accept loop relies on.
import assert;
import net.proxy;

@test
fn test_round_robin_cycles(): void {
    let p = proxy.Pool();
    p.add("127.0.0.1", 5001);
    p.add("127.0.0.1", 5002);
    p.add("127.0.0.1", 5003);
    assert.equalInt(p.size(), 3);
    assert.equalInt(p.next().port, 5001);
    assert.equalInt(p.next().port, 5002);
    assert.equalInt(p.next().port, 5003);
    assert.equalInt(p.next().port, 5001);   // wraps back to the head
    assert.equalInt(p.next().port, 5002);
}

@test
fn test_single_backend(): void {
    let p = proxy.Pool();
    p.add("10.0.0.9", 8080);
    assert.equalInt(p.next().port, 8080);
    assert.equalInt(p.next().port, 8080);   // one backend → always itself
    assert.equalStr(p.next().host, "10.0.0.9");
}

@test
fn test_empty_pool_sentinel(): void {
    let p = proxy.Pool();
    assert.equalInt(p.size(), 0);
    let b = p.next();
    assert.equalInt(b.port, 0);             // empty → port-0 sentinel (caller answers 502)
}
