import assert;
import serde.source;
import web.response;
import web.status;
import web.di;

trait RequestHandler<TReq, TResp> {
    fn handle(self, req: TReq): TResp;
}

@serializable struct GetUser { pub id: int }
@serializable struct UserDto { pub id: int, pub name: string }

struct GetUserHandler impl RequestHandler<GetUser, UserDto> {
    fn handle(self, req: GetUser): UserDto {
        return UserDto{ id: req.id, name: "Ada" };
    }
}

@test
fn test_discovered_dispatch(): void {
    let provider = ServiceCollection().buildServiceProvider();
    let out = __mediator_dispatch_GetUser(source.fromJson("{\"id\": 7}"), provider);
    assert.equalStr(out.body, "{\"id\":7,\"name\":\"Ada\"}");
}
