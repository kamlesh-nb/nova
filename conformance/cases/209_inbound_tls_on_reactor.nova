const SO_REUSEADDR: int = 4;

fn bump(cell: long): void { bytes.write_i32(cell, 0, (bytes.read_i32(cell, 0) as int) + 1); }
fn count(cell: long): int { return bytes.read_i32(cell, 0) as int; }

fn containsAscii(buf: long, n: int, s: string): bool {
    if (s.length == 0 || n < s.length) { return false; }
    let i = 0;
    while (i + s.length <= n) {
        let j = 0;
        let eq = true;
        while (j < s.length) {
            if ((bytes.read_byte(buf, i + j) as int) != s[j]) { eq = false; j = s.length; }
            else { j = j + 1; }
        }
        if (eq) { return true; }
        i = i + 1;
    }
    return false;
}

async fn tlsServer(fd: int, kq: int, done: long): void {
    let base = asyncio.AsyncStream(fd as long);
    base.kq = kq;
    let ts = await asynctls.tlsAccept(base, TEST_CERT, TEST_KEY);
    if (ts.ok()) {
        let buf = bytes.alloc(1024);
        let n = await ts.recvInto(buf, 1024);
        let body = `{"ok":true}`;
        let resp = "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 11\r\nConnection: close\r\n\r\n" + body;
        let _ = await ts.sendStr(resp);
        bytes.free(buf);
    }
    ts.close();
    bump(done);
}

// Completion-model accept: await one connection and spawn the TLS server coroutine, then complete.
async fn tlsAcceptOne(lfd: int, kq: int, done: long): void {
    let s = await reactorio.reactorAccept(lfd, kq);
    if (s.isOpen()) { coroStart(tlsServer(s.fdOf(), kq, done)); }
}

async fn tlsClient(host: string, port: int, done: long, gotOk: long): void {
    let ts = await asynctls.tlsConnect(host, port, false);   // reactor-native asyncConnect underneath
    if (ts.ok()) {
        let _ = await ts.sendStr("GET /ping HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n");
        let buf = bytes.alloc(1024);
        let n = await ts.recvInto(buf, 1024);
        if (containsAscii(buf, n, `"ok":true`)) { bytes.write_i32(gotOk, 0, 1); }
        bytes.free(buf);
    }
    ts.close();
    bump(done);
}

@test
fn test_inbound_tls_on_reactor(): void {
    let lfd = sys.socket(sys.AF_INET, sys.SOCK_STREAM, 0);
    let one = bytes.alloc(4); bytes.write_i32(one, 0, 1);
    sys.setsockopt(lfd, sys.SOL_SOCKET, SO_REUSEADDR, one, 4);
    bytes.free(one);
    let sa = sys.makeSockaddrIn(0, reactorio.parseIPv4("127.0.0.1"));
    assert.equalInt(sys.bind(lfd, sa, 16), 0);
    bytes.free(sa);
    sys.listen(lfd, 16);
    sys.setNonBlocking(lfd);
    let port = sys.boundPort(lfd);

    let r = reactor.Reactor(64, 20480, 32);
    reactor.setCurrent(r.kq);
    let done = bytes.alloc(4); bytes.write_i32(done, 0, 0);
    let gotOk = bytes.alloc(4); bytes.write_i32(gotOk, 0, 0);

    coroStart(tlsAcceptOne(lfd, r.kq, done));
    coroStart(tlsClient("127.0.0.1", port, done, gotOk));

    let guard = 0;
    while (count(done) < 2 && guard < 4000) {
        let nev = r.pollComplete(500);
        reactor.batchBegin();
        let i = 0;
        while (i < nev) {
            nova_reactor_resume(r.completedToken(i));
            i = i + 1;
        }
        guard = guard + 1;
    }

    assert.equalInt(count(done), 2);
    assert.equalInt(bytes.read_i32(gotOk, 0) as int, 1);

    reactor.setCurrent(0);
    bytes.free(done); bytes.free(gotOk);
    r.destroy();
    sys.close(lfd);
}
