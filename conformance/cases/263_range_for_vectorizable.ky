import assert;

fn saxpy(a: double[128], b: double[128], c: double[128], s: double, n: int): void {
    for (i in 0..n) { c[i] = a[i] * s + b[i]; }
}

@test
fn range_for_forward_index(): void {
    let a: int[8] = [0; 8];
    for (i in 0..8) { a[i] = i * i; }
    assert.equalInt(0, a[0]);
    assert.equalInt(1, a[1]);
    assert.equalInt(49, a[7]);
}

@test
fn range_for_saxpy(): void {
    let a: double[128] = [1.0; 128];
    let b: double[128] = [2.0; 128];
    let c: double[128] = [0.0; 128];
    saxpy(a, b, c, 3.0, 128);
    assert.isTrue(c[0] > 4.99 && c[0] < 5.01);
    assert.isTrue(c[127] > 4.99 && c[127] < 5.01);
}

@test
fn range_for_reduction(): void {
    let a: double[16] = [0.0; 16];
    for (i in 0..16) { a[i] = (i as double); }
    let s = 0.0;
    for (i in 0..16) { s = s + a[i]; }
    assert.isTrue(s > 119.9 && s < 120.1);
}

@test
fn range_for_partial_bound(): void {
    let a: int[10] = [7; 10];
    for (i in 0..4) { a[i] = i; }
    assert.equalInt(0, a[0]);
    assert.equalInt(3, a[3]);
    assert.equalInt(7, a[4]);
    assert.equalInt(7, a[9]);
}
