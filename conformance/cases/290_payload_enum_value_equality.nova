// F2: `==` on payload-carrying enum variants compared heap IDENTITY, not value, so `E.A(3) == E.A(3)` was
// false (two different boxes). Every variant box of an enum is allocated at the same size (tag + max payload
// words) and zero-padded, so codegen now compares the two boxes word-by-word (tag + payload). Value-type
// payloads compare by value; a string / heap payload field still compares by identity (documented
// limitation). Payload-LESS enums are integer tags and were already correct.

import assert;

enum E { A(int), B(int) }
enum Color { Red, Green, Blue }
enum Msg { Text(string), Code(int) }

@test
fn test_same_variant_same_payload_is_equal(): void {
    let x = E.A(3);
    let y = E.A(3);
    assert.isTrue(x == y);      // was false (identity)
}

@test
fn test_same_variant_different_payload_is_not_equal(): void {
    assert.isFalse(E.A(3) == E.A(4));
}

@test
fn test_different_variant_is_not_equal(): void {
    assert.isFalse(E.A(3) == E.B(3));
}

@test
fn test_ne_operator(): void {
    assert.isTrue(E.A(3) != E.A(4));
    assert.isFalse(E.A(3) != E.A(3));
}

@test
fn test_aliased_box_is_equal(): void {
    let x = E.A(7);
    let y = x;
    assert.isTrue(x == y);
}

@test
fn test_payloadless_enum_still_correct(): void {
    let a = Color.Green;
    assert.isTrue(a == Color.Green);
    assert.isFalse(a == Color.Red);
}

@test
fn test_value_payload_across_variants_with_heap_variant(): void {
    // An int-payload variant of an enum that ALSO has a string variant still compares by value.
    assert.isTrue(Msg.Code(5) == Msg.Code(5));
    assert.isFalse(Msg.Code(5) == Msg.Code(6));
    let t = Msg.Text("hi");
    assert.isTrue(t == t);      // same box -> equal (no crash)
}
