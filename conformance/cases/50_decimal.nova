// specs §3.1: `decimal` is IEEE 754-2008 decimal128 (BID) — a 16-byte ARC-managed heap object. Stage 1:
// `m`-suffixed literals + toString/interpolation. The point is EXACTNESS (`0.1m` is not representable in
// a binary double) and 34-significant-digit range, both of which BSON's decimal128 requires. Must be
// leak-free under --arc (decimal is heap-ARC) and clean under --asan.
import assert;

@test
fn test_decimal_roundtrip(): void {
    let a: decimal = 10.5m;
    assert.equalStr(`${a}`, "10.5");
    let hundred: decimal = 100m;
    assert.equalStr(`${hundred}`, "100");
}

@test
fn test_decimal_exact_fraction(): void {
    // 0.1 and 0.001 have no exact binary double — decimal128 holds them precisely.
    let tenth: decimal = 0.1m;
    assert.equalStr(`${tenth}`, "0.1");
    let milli: decimal = 0.001m;
    assert.equalStr(`${milli}`, "0.001");
}

@test
fn test_decimal_negative(): void {
    let neg: decimal = -3.14m;
    assert.equalStr(`${neg}`, "-3.14");
}

@test
fn test_decimal_full_precision(): void {
    // 34 significant digits — the decimal128 maximum.
    let big: decimal = 12345678901234567890123456789012.34m;
    assert.equalStr(`${big}`, "12345678901234567890123456789012.34");
}
