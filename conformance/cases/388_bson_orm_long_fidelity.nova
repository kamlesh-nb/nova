// E1 fix: the BSON ORM write path must not truncate a 64-bit `long` field to int32. A value that fits
// int32 is stored as BSON int32 (type 16); a larger one as int64 (type 18, hi/lo halves), losslessly.
import assert;
import data.orm;
import serde.bson;
import list;
import string;
@serializable struct Rec { pub small: long, pub big: long }
@test fn bson_long_preserved(): void {
    let obj = Rec{ small: 42, big: 5000000000 };
    let doc = orm.toBson<Rec>(obj);
    let i = 0;
    while (i < doc.entries.size()) {
        let e = doc.entries.at(i);
        if (string.eql(e.key, "big")) {
            assert.equalInt(e.type_id, 18);                             // int64 tag (not truncated to int32)
            let recon = (e.int_val << 32) | (e.int_val2 as long & 4294967295);
            assert.isTrue(recon == 5000000000);                         // full value preserved
        }
        if (string.eql(e.key, "small")) {
            assert.equalInt(e.type_id, 16);                             // small fits int32
            assert.isTrue(e.int_val == 42);
        }
        i = i + 1;
    }
}
