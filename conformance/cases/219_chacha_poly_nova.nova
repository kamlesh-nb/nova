import crypto.cipher.chacha20;
import crypto.mac.poly1305;
import bytes;
import assert;

fn hexNib(c: int): int {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    if (c >= 65 && c <= 70) { return c - 55; }
    return 0;
}

fn eqHex(buf: ptr, n: int, hex: string): bool {
    if (hex.length != n * 2) { return false; }
    let i = 0;
    while (i < n) {
        if (bytes.read_byte(buf, i) != hexNib(hex[i * 2]) * 16 + hexNib(hex[i * 2 + 1])) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn hexInto(dst: ptr, hex: string): int {
    let n = hex.length / 2;
    let i = 0;
    while (i < n) {
        bytes.write_byte(dst, i, hexNib(hex[i * 2]) * 16 + hexNib(hex[i * 2 + 1]));
        i = i + 1;
    }
    return n;
}

fn strBuf(s: string): ptr {
    let n = s.length;
    let b = bytes.alloc(n + 1);
    let i = 0;
    while (i < n) { bytes.write_byte(b, i, s[i]); i = i + 1; }
    return b;
}

fn stdKey(): ptr {
    let key = bytes.alloc(32);
    hexInto(key, "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f");
    return key;
}

@test
fn t_chacha20_block(): void {
    let key = stdKey();
    let nonce = bytes.alloc(12);
    hexInto(nonce, "000000090000004a00000000");
    let out = bytes.alloc(64);
    chacha20.keystreamBlock(key, 1, nonce, out);
    assert.isTrue(eqHex(out, 64, "10f1e7e4d13b5915500fdd1fa32071c4c7d1f4c733c068030422aa9ac3d46c4ed2826446079faa0914c2d705d98b02a2b5129cd1de164eb9cbd083e8a2503c4e"));
}

@test
fn t_chacha20_encrypt(): void {
    let key = stdKey();
    let nonce = bytes.alloc(12);
    hexInto(nonce, "000000000000004a00000000");
    let pt = strBuf("Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it.");
    let ct = bytes.alloc(114);
    chacha20.applyKeystream(key, 1, nonce, pt, 114, ct);
    assert.isTrue(eqHex(ct, 114, "6e2e359a2568f98041ba0728dd0d6981e97e7aec1d4360c20a27afccfd9fae0bf91b65c5524733ab8f593dabcd62b3571639d624e65152ab8f530c359f0861d807ca0dbf500d6a6156a38e088a22b65e52bc514d16ccf806818ce91ab77937365af90bbf74a35be6b40b8eedf2785e42874d"));

    let rt = bytes.alloc(114);
    chacha20.applyKeystream(key, 1, nonce, ct, 114, rt);
    let i = 0;
    while (i < 114) { assert.equalInt(bytes.read_byte(rt, i), bytes.read_byte(pt, i)); i = i + 1; }
}

@test
fn poly1305_tag(): void {
    let key = bytes.alloc(32);
    hexInto(key, "85d6be7857556d337f4452fe42d506a80103808afb0db2fd4abff6af4149f51b");
    let msg = strBuf("Cryptographic Forum Research Group");
    let tag = bytes.alloc(16);
    poly1305.authInto(key, msg, 34, tag);
    assert.isTrue(eqHex(tag, 16, "a8061dc1305136c6c22b8baf0c0127a9"));
}

@test
fn poly1305_empty_and_block(): void {
    let key = bytes.alloc(32);
    hexInto(key, "0000000000000000000000000000000036e5f6b5c5e06070f0efca96227a863e");
    let tag = bytes.alloc(16);
    poly1305.authInto(key, bytes.alloc(1), 0, tag);
    assert.isTrue(eqHex(tag, 16, "36e5f6b5c5e06070f0efca96227a863e"));
}
