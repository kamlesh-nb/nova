import assert;

@test
fn test_trace_is_a_noop_when_disabled(): void {
    nova_trace_msg("this line only appears when NOVA_TRACE is set");
    let i = 0;
    while (i < 3) {
        nova_trace_kv("iteration", i as long);
        i = i + 1;
    }
    assert.isTrue(nova_trace_enabled() == 0 || nova_trace_enabled() == 1);
}
