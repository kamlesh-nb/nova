import assert;

trait G { fn v(self: G): int; }
struct A impl G { fn v(self: A): int { return 3; } }
struct B impl G { fn v(self: B): int { return 7; } }

struct Holder { pub g: G  init(){ self.g = A{}; } }
@test
fn test_init_body_field_assign(): void {
    let h = Holder();
    assert.equalInt(h.g.v(), 3);
}

struct Box { pub g: G  init(){ self.g = A{}; } fn setB(self: Box): void { self.g = B{}; } }
@test
fn test_method_field_reassign(): void {
    let x = Box();
    assert.equalInt(x.g.v(), 3);
    x.setB();
    assert.equalInt(x.g.v(), 7);
}
