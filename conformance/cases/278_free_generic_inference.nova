// B1/B3: a bare call to a generic FREE function (no explicit `<T>`) must infer its type arguments
// from the argument types and resolve to the monomorphised instance, including when the return value
// is owned. Previously the inferred instance was never registered for emission and the bare call
// resolved to the un-emitted base name ("Function 'id' not found"); the owned-return path (B3) also
// lacked its instance. Explicit `id<T>(x)` already worked; this covers the inference path.
import assert;
import list;

fn ident<T>(x: T): T { return x; }

fn firstOf<T>(xs: List<T>): T { return xs.at(0); }

@test
fn test_infer_scalar(): void {
    assert.equalInt(ident(42), 42);
    assert.equalStr(ident("hi"), "hi");
}

@test
fn test_infer_owned_passthrough(): void {
    let a = "owned-value";
    let b = ident(a);              // inferred T=string, returns the owned value
    assert.equalStr(b, "owned-value");
    assert.equalStr(a, "owned-value");   // original still valid (no double free)
}

@test
fn test_infer_owned_from_container(): void {
    let xs = List<string>();
    xs.push("first");
    xs.push("second");
    let s = firstOf(xs);           // inferred T=string via List<T>, owned element
    assert.equalStr(s, "first");
}

@test
fn test_explicit_still_works(): void {
    assert.equalInt(ident<int>(7), 7);
    let xs = List<int>();
    xs.push(99);
    assert.equalInt(firstOf<int>(xs), 99);
}
