import list;
import map;
import assert;

fn plain(o: int | undefined): int { return o ?? -1; }

fn narrow(x: int | undefined): int {
    if (x == undefined) { return -1; }
    return x ?? -2;
}

fn hh(k: int): int { return k; }

@test
fn flat_direct(): void {
    let l = list.List<int>();
    l.push(10);
    assert.equalInt(plain(l.get(0)), 10);
    assert.equalInt(narrow(l.get(0)), 10);
    assert.equalInt(plain(l.get(99)), -1);
    assert.equalInt(narrow(l.get(99)), -1);
}

@test
fn flat_local(): void {
    let l = list.List<int>();
    l.push(10);
    let g = l.get(0);
    assert.equalInt(plain(g), 10);
    assert.equalInt(narrow(g), 10);
}

@test
fn nested_direct(): void {
    let l = list.List<int | undefined>();
    l.push(10);
    assert.equalInt(plain(l.get(0)), 10);
    assert.equalInt(narrow(l.get(0)), 10);
}

@test
fn nested_local(): void {
    let l = list.List<int | undefined>();
    l.push(10);
    let g = l.get(0);
    assert.equalInt(plain(g), 10);
    assert.equalInt(narrow(g), 10);
}

@test
fn map_local(): void {
    let m = map.Map<int, int>(16, hh);
    m.set(5, 42);
    let g = m.get(5);
    assert.equalInt(plain(g), 42);
    assert.equalInt(narrow(g), 42);
    assert.equalInt(plain(m.get(7)), -1);
}
