// B5 (partial): a generic struct instantiation `Cell<int>{ value: 42 }` was inferred with NO type
// arguments, so any `T`-typed field or method return stayed an erased type-parameter. Using such a value
// where its concrete type matters -- string interpolation `${...}` -- then stringified a raw `int` as a
// string pointer and SEGV'd in StringBuilder_append. Fix: struct-init inference recovers the instantiation
// from the field values (solving the struct's type parameters against the inferred field-value types), so
// the value carries `Cell<int>` and its `T` resolves to `int`.
//
// Still open (tracked separately): dispatch of such a method through a TRAIT OBJECT vtable, where the
// vtable points to the erased shared method body rather than the per-instantiation monomorphisation.

import assert;

struct Cell<T> {
    value: T,
    fn get(self: Cell<T>): T { return self.value; }
    fn render(self: Cell<T>): string { return `[${self.value}]`; }
}

@test
fn test_interpolate_generic_field_int(): void {
    let c = Cell<int>{ value: 42 };
    assert.equalStr(c.render(), "[42]");
}

@test
fn test_interpolate_generic_field_string(): void {
    let s = Cell<string>{ value: "hi" };
    assert.equalStr(s.render(), "[hi]");
}

@test
fn test_interpolate_generic_method_return(): void {
    let c = Cell<int>{ value: 42 };
    let v = c.get();                 // v resolves to the concrete `int`, not the erased `T`
    assert.equalStr(`${v}`, "42");
    assert.equalInt(v, 42);
}

@test
fn test_generic_field_still_usable_as_value(): void {
    let c = Cell<long>{ value: 5000000000 };
    assert.isTrue(c.get() == 5000000000);
    assert.equalStr(`${c.get()}`, "5000000000");
}
