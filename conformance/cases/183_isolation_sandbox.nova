// 183 — I4 container-grade isolation: the offline / cross-platform surface. The IsolationSpec DIAL
// (level 0/1/3 → namespace flags, caps, seccomp), the orchestrator Spec carrying isolationLevel+rootfs,
// and the macOS-DEGRADE path (an isolated spawn runs as a plain process where namespaces don't exist).
// The real Linux isolation (PID/mount ns invisibility, private rootfs, dropped caps, seccomp EPERM) is
// Docker-verified separately — none of it exists on the macOS test host.
import assert;
import list;
import os.sandbox;
import orch.spec;

// The isolation dial: each level ORs the right namespace bits and toggles caps/seccomp.
@test
fn test_sandbox_levels(): void {
    let l0 = sandbox.level0();
    assert.equalInt(l0.nsFlags, 0);              // no isolation
    assert.isTrue(!l0.dropCaps);
    assert.isTrue(!l0.seccomp);

    // level 1 = PID|MOUNT|UTS|IPC = 1|2|4|8 = 15; drop caps + no_new_privs; NO seccomp, NO user ns
    let l1 = sandbox.level1("/rootfs/web", "web");
    assert.equalInt(l1.nsFlags, 15);
    assert.isTrue(l1.dropCaps);
    assert.isTrue(l1.noNewPrivs);
    assert.isTrue(!l1.seccomp);
    assert.equalStr(l1.rootfs, "/rootfs/web");
    assert.equalStr(l1.hostname, "web");

    // level 3 = level 1 + USER(32) + seccomp = 15|32 = 47
    let l3 = sandbox.level3("/rootfs/db", "db");
    assert.equalInt(l3.nsFlags, 47);
    assert.isTrue(l3.seccomp);
    assert.isTrue(l3.dropCaps);
}

// The NS_* bits compose as documented.
@test
fn test_ns_bits(): void {
    assert.equalInt(sandbox.NS_PID, 1);
    assert.equalInt(sandbox.NS_MOUNT, 2);
    assert.equalInt(sandbox.NS_UTS, 4);
    assert.equalInt(sandbox.NS_IPC, 8);
    assert.equalInt(sandbox.NS_NET, 16);
    assert.equalInt(sandbox.NS_USER, 32);
    assert.equalInt(sandbox.NS_PID | sandbox.NS_NET, 17);
}

// On a host without namespaces (macOS test box), an isolated spawn DEGRADES to a plain spawn and still
// runs the binary — so orchestration never breaks off-Linux. (On Linux the same call clone()s into the
// sandbox; that path is Docker-verified.)
@test
fn test_isolated_spawn_degrades(): void {
    let args = list.List<string>();
    args.push("-c");
    args.push("echo sandbox_ran");
    let p = sandbox.spawn("/bin/sh", args, sandbox.level1("", "t"));
    let out = p.read(64);
    let _ = p.wait();
    p.close();
    assert.isTrue(string_contains(out, "sandbox_ran"));
}

// The orchestrator Spec carries the isolation dial; specsEqual treats it as run-affecting.
@test
fn test_spec_isolation_fields(): void {
    let s = spec.parseSpec("{\"name\":\"w\",\"binaryPath\":\"/w\",\"isolationLevel\":1,\"rootfs\":\"/r/w\"}");
    assert.equalInt(s.isolationLevel, 1);
    assert.equalStr(s.rootfs, "/r/w");
    let d = spec.parseSpec("{\"name\":\"w\",\"binaryPath\":\"/w\"}");
    assert.equalInt(d.isolationLevel, 0);        // default = no isolation
    // changing the level is a spec change (triggers a workload restart)
    assert.isTrue(!spec.specsEqual(s, d));
}

fn string_contains(hay: string, needle: string): bool {
    return string_indexOf(hay, needle) >= 0;
}
fn string_indexOf(hay: string, needle: string): int {
    let hl = hay.length; let nl = needle.length;
    if (nl == 0) { return 0; }
    let i = 0;
    while (i + nl <= hl) {
        let j = 0; let ok = true;
        while (j < nl) { if (hay[i + j] != needle[j]) { ok = false; break; } j = j + 1; }
        if (ok) { return i; }
        i = i + 1;
    }
    return -1;
}
