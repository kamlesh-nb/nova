import assert;
import list;

struct Point { pub x: int, pub y: int, init(x: int, y: int) { self.x = x; self.y = y; } }
struct Rec { pub id: int, pub name: string, init(id: int, name: string) { self.id = id; self.name = name; } }

@test
fn test_list_scalar_value_struct_inline(): void {
    let l = List<Point>();
    l.push(Point(10, 20));
    l.push(Point(30, 40));
    l.set(0, Point(11, 21));
    assert.equalInt(l.at(0).x, 11);
    assert.equalInt(l.at(1).y, 40);
    assert.equalInt(l.size(), 2);
}

@test
fn test_list_owned_field_value_struct_inline(): void {
    let l = List<Rec>();
    l.push(Rec(1, "alpha"));
    l.push(Rec(2, "beta"));
    l.set(0, Rec(1, "gamma"));
    assert.equalStr(l.at(0).name, "gamma");
    assert.equalStr(l.at(1).name, "beta");
    assert.equalInt(l.size(), 2);
}
