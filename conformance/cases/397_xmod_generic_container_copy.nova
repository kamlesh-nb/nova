// Regression: copying a generic struct that has a container field of its OWN type parameter (`List<T>`),
// instantiated in a DIFFERENT module, used to SEGFAULT the compiler -- cross-module mono does not substitute
// the value-struct field type, so the container-copy path looked up a `List<T>` copy fn and dereferenced a
// garbage ref. Now it falls back to a retain-alias (shared container) instead of crashing.
import list;
import assert;
struct Box<T> {
    pub buf: list.List<T>,
    init() { self.buf = list.List<T>(); }
    pub fn depth(self: Box<T>): int { return self.buf.size(); }
    pub fn add(self: Box<T>, v: T): void { self.buf.push(v); }
}
@test
fn xmod_generic_container_copy(): void {
    let b = Box<int>();
    b.add(7);
    let b2 = b;                     // COPY -> value-struct owned-field retain path (was the crash)
    assert.equalInt(b2.depth(), 1);
}
