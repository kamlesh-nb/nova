import assert;
import web.app;
import web.di;
import web.request;
import web.response;
import web.status;
import web.routing;
import web.mediator;
import serde.json;
import serde.source;
import string;

struct SCount impl Service { pub v: int, init() { self.v = 0; } pub fn inc(self: SCount): int { self.v = self.v + 1; return self.v; } }
struct GCount impl Service { pub v: int, init() { self.v = 0; } pub fn inc(self: GCount): int { self.v = self.v + 1; return self.v; } }

@serializable struct Req impl Message { pub x: int }
@serializable struct CountDto { pub scoped: int, pub singleton: int }

struct H impl RequestHandler<Req, CountDto> {
    scoped: SCount,
    singleton: GCount,
    init(scoped: SCount, singleton: GCount) { self.scoped = scoped; self.singleton = singleton; }
    async fn handle(self: H, q: Req): CountDto {
        return CountDto{ scoped: self.scoped.inc(), singleton: self.singleton.inc() };
    }
}

fn makeApp(): App {
    let services = ServiceCollection();
    services.addScoped("SCount", (sp) => { return SCount(); });
    services.addSingleton("GCount", (sp) => { return GCount(); });
    let a = App();
    a.useServices(services);
    a.get<Req>("/count/{x:int}");
    return a;
}

@test
fn test_scoped_resets_singleton_persists(): void {
    let a = makeApp();
    let r1 = a.dispatch(Request.fromString("GET /count/1 HTTP/1.1\r\nHost: x\r\n\r\n"));
    let r2 = a.dispatch(Request.fromString("GET /count/2 HTTP/1.1\r\nHost: x\r\n\r\n"));
    assert.equalStr(r1.body, `{"scoped":1,"singleton":1}`);
    assert.equalStr(r2.body, `{"scoped":1,"singleton":2}`);
}
