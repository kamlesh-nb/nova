// H2 optionals soundness: the SOUND ways to use a `T | undefined` all compile and work.
// (The unguarded form is a compile error — see expect_fail/optional_unguarded.)
//   at(i)              -> T directly, traps loudly on absent (Rust/Swift indexed access)
//   x ?? default       -> T (coalesce strips the optional)
//   if (x != undefined) -> narrows x to T in the branch
//   if (x == undefined) return -> narrows x to T for the rest of the block (early exit)
import list;
import map;
import string;
import assert;

struct Box { pub v: int, init(n: int) { self.v = n; } pub fn twice(self: Box): int { return self.v * 2; } }

@test
fn test_at_returns_value(): void {
    let l = List<Box>();
    l.push(Box(21));
    assert.equalInt(l.at(0).v, 21);        // at -> Box directly
    assert.equalInt(l.at(0).twice(), 42);  // method too
}

@test
fn test_coalesce_strips_optional(): void {
    let l = List<int>();
    l.push(7);
    let v = l.get(9) ?? 99;   // absent -> default; result is `int`, not `int | undefined`
    assert.equalInt(v, 99);
    let w = l.get(0) ?? 99;   // present -> the value
    assert.equalInt(w, 7);
}

@test
fn test_narrow_in_branch(): void {
    let l = List<Box>();
    l.push(Box(5));
    let b = l.get(0);
    if (b != undefined) {
        assert.equalInt(b.v, 5);   // narrowed to Box inside the branch
    }
}

@test
fn test_early_exit_narrow(): void {
    let l = List<Box>();
    l.push(Box(8));
    assert.equalInt(unwrapFirst(l), 8);
}

fn unwrapFirst(l: List<Box>): int {
    let b = l.get(0);
    if (b == undefined) { return -1; }
    return b.v;   // b narrowed to Box for the rest of the block
}

@test
fn test_map_at(): void {
    let m = map.Map<string, int>(8, string.hash);
    m.set("k", 42);
    assert.equalInt(m.at("k"), 42);   // Map.at -> V directly
}
