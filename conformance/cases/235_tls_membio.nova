// Pure-Nova TLS 1.3 memory-BIO (M11 stage C): a full client<->server handshake and bidirectional
// application-data exchange driven entirely in memory (no sockets) through net/tlsmembio's TlsBio
// trait objects. Proves the memory-BIO that backs net/asynctls without needing a live peer.
import net.tlsmembio;
import bytes;
import assert;

const SRV_CERT: string = "";
const SRV_PRIV: string = "accfe82d31600d5810b9984176898804a4ba458216b1ac913231be5008ca82f1";

fn hexNib(c: int): int { if (c >= 48 && c <= 57) { return c - 48; } if (c >= 97 && c <= 102) { return c - 87; } return 0; }
fn hexBuf(hex: string): ptr {
    let n = hex.length / 2;
    let b = bytes.alloc(n);
    let i = 0;
    while (i < n) { bytes.write_byte(b, i, hexNib(hex[i * 2]) * 16 + hexNib(hex[i * 2 + 1])); i = i + 1; }
    return b;
}

// Shuttle all pending outbound ciphertext from a -> b.
fn transfer(a: tlsmembio.TlsBio, b: tlsmembio.TlsBio, tmp: ptr, cap: int): void {
    while (a.pendingOut() > 0) {
        let n = a.pull(tmp, cap);
        if (n <= 0) { return; }
        b.feed(tmp, n);
    }
}

@test
fn tls13_loopback(): void {
    let cb: tlsmembio.TlsBio = tlsmembio.newClientBio("localhost");
    let sb: tlsmembio.TlsBio = tlsmembio.newServerBio(hexBuf(SRV_CERT), 421, hexBuf(SRV_PRIV));
    let tmp = bytes.alloc(33792);

    let cdone = false; let sdone = false;
    let i = 0;
    while (i < 20 && !(cdone && sdone)) {
        transfer(cb, sb, tmp, 33792);
        let ss = sb.step();
        assert.isTrue(ss >= 0);
        if (ss == 0) { sdone = true; }
        transfer(sb, cb, tmp, 33792);
        let cs = cb.step();
        assert.isTrue(cs >= 0);
        if (cs == 0) { cdone = true; }
        i = i + 1;
    }
    assert.isTrue(cdone);
    assert.isTrue(sdone);

    // App data client -> server.
    let msg = bytes.alloc(5);
    bytes.write_byte(msg, 0, 104); bytes.write_byte(msg, 1, 101); bytes.write_byte(msg, 2, 108); bytes.write_byte(msg, 3, 108); bytes.write_byte(msg, 4, 111);
    cb.writeApp(msg, 5);
    transfer(cb, sb, tmp, 33792);
    let out = bytes.alloc(256);
    let k = sb.readApp(out, 256);
    assert.equalInt(k, 5);
    assert.equalInt(bytes.read_byte(out, 0), 104);
    assert.equalInt(bytes.read_byte(out, 4), 111);

    // App data server -> client.
    sb.writeApp(out, 5);
    transfer(sb, cb, tmp, 33792);
    let out2 = bytes.alloc(256);
    let k2 = cb.readApp(out2, 256);
    assert.equalInt(k2, 5);
    assert.equalInt(bytes.read_byte(out2, 0), 104);

    cb.closeBio();
    sb.closeBio();
}
