// M2 tail of the C++ runtime retirement plan: a WHOLE web request runs on the Nova reactor, no Asio.
// A real App (one typed route + handler) serves a request through web.app's serveReactorConn, which
// wraps the accepted fd in a reactor-native AsyncStream and runs the same handleConn pipeline (parse,
// route match, mediator dispatch, handler, response) as the Asio server. Here a client coroutine and
// the server coroutine run on ONE reactor over a socketpair: the request is parsed, dispatched to the
// handler, and the response is written, all reactor-native. This is the inbound half that lets a full
// request plus its per-request database call run on the reactor.
import assert;
import bytes;
import os.sys;
import net.reactor;
import net.reactorio;
import web.app;
import web.request;
import web.response;
import web.status;
import serde.source;

@serializable struct Ping { pub n: int }

struct PingHandler impl MessageHandler {
    async fn handle(self: PingHandler, src: ValueSource): Response {
        return json(`{"pong":1}`);
    }
}

fn makeApp(): App {
    let a = App();
    a.handle<Ping>(PingHandler{});
    a.get<Ping>("/ping");
    return a;
}

fn bump(cell: long): void {
    bytes.write_i32(cell, 0, (bytes.read_i32(cell, 0) as int) + 1);
}
fn count(cell: long): int {
    return bytes.read_i32(cell, 0) as int;
}

// Does the response buffer (length n) contain the ASCII bytes of "pong"?
fn hasPong(buf: long, n: int): bool {
    let i = 0;
    while (i + 4 <= n) {
        if (bytes.read_byte(buf, i) == 112 && bytes.read_byte(buf, i + 1) == 111 &&
            bytes.read_byte(buf, i + 2) == 110 && bytes.read_byte(buf, i + 3) == 103) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

async fn serverSide(application: App, fd: int, kq: int, done: long): void {
    let _ = await app.serveReactorConn(application, fd, kq);
    bump(done);
}

async fn clientSide(fd: int, kq: int, done: long, gotStatus: long, gotBody: long): void {
    let s = reactorio.ReactorStream(fd, kq);
    await s.sendStr("GET /ping HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n");
    let buf = bytes.alloc(2048);
    let n = await s.recvInto(buf, 2048);
    if (n > 12) {
        let code = ((bytes.read_byte(buf, 9) as int) - 48) * 100 +
                   ((bytes.read_byte(buf, 10) as int) - 48) * 10 +
                   ((bytes.read_byte(buf, 11) as int) - 48);
        bytes.write_i32(gotStatus, 0, code as long);
        if (hasPong(buf, n)) { bytes.write_i32(gotBody, 0, 1); }
    }
    bytes.free(buf);
    s.close();
    bump(done);
}

@test
fn test_app_request_served_on_reactor(): void {
    let application = makeApp();

    let (a, b) = sys.newSocketPair(sys.AF_UNIX, sys.SOCK_STREAM);
    assert.isTrue(a >= 0 && b >= 0);
    sys.setNonBlocking(a);
    sys.setNonBlocking(b);

    let r = reactor.Reactor(64, 8192, 16);
    reactor.setCurrent(r.kq);
    let done = bytes.alloc(4); bytes.write_i32(done, 0, 0);
    let gotStatus = bytes.alloc(4); bytes.write_i32(gotStatus, 0, 0);
    let gotBody = bytes.alloc(4); bytes.write_i32(gotBody, 0, 0);

    coroStart(serverSide(application, b, r.kq, done));
    coroStart(clientSide(a, r.kq, done, gotStatus, gotBody));

    let guard = 0;
    while (count(done) < 2 && guard < 2000) {
        let nev = r.poll(500);
        reactor.batchBegin();
        let i = 0;
        while (i < nev) { nova_reactor_resume(r.readyToken(i)); i = i + 1; }
        guard = guard + 1;
    }

    assert.equalInt(count(done), 2);
    assert.equalInt(bytes.read_i32(gotStatus, 0) as int, 200);
    assert.equalInt(bytes.read_i32(gotBody, 0) as int, 1);

    reactor.setCurrent(0);
    bytes.free(done);
    bytes.free(gotStatus);
    bytes.free(gotBody);
    r.destroy();
}
