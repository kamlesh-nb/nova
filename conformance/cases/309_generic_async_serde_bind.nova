
import assert;
import serde.source;

@serializable struct Dto { pub id: int, pub name: string }

async fn fetchTag(): int { return 1; }

async fn queryAs<T>(js: ValueSource): T {
    let _ = await fetchTag();
    return serde.bind<T>(js);
}

async fn makeOne<T>(js: ValueSource): T {
    return serde.bind<T>(js);
}

async fn viaAwait(js: ValueSource): int {
    let d = await queryAs<Dto>(js);
    return d.id;
}

@test
fn test_query_as_from_sync(): void {
    let js: ValueSource = source.fromJson("{\"id\": 5, \"name\": \"Zed\"}");
    let d = queryAs<Dto>(js);
    assert.equalInt(5, d.id);
    assert.equalStr("Zed", d.name);
}

@test
fn test_present_zero(): void {
    let js: ValueSource = source.fromJson("{\"id\": 0, \"name\": \"Zero\"}");
    let d = makeOne<Dto>(js);
    assert.equalInt(0, d.id);
    assert.equalStr("Zero", d.name);
}

@test
fn test_await_generic_async(): void {
    let js: ValueSource = source.fromJson("{\"id\": 8, \"name\": \"Q\"}");
    assert.equalInt(8, viaAwait(js));
}
