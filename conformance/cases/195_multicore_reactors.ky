import assert;
import bytes;
import os.sys;
import net.poller;

async fn echoW(r: poller.Reactor, fd: int): void {
    r.addRead(fd, currentCoro());
    coroSuspend();
    let buf = r.getBuffer();
    let n = sys.read(fd, buf, 256);
    if (n > 0) { sys.write(fd, buf, n); }
    r.putBuffer(buf);
}

fn worker(idx: int): void {
    let (a, b) = sys.newSocketPair(sys.AF_UNIX, sys.SOCK_STREAM);
    let r = poller.Reactor(8, 512, 4);
    coroStart(echoW(r, b));

    let out = bytes.alloc(2);
    bytes.write_byte(out, 0, 88);
    bytes.write_byte(out, 1, 89);
    sys.write(a, out, 2);

    let n = r.poll(1000);
    if (n == 1) {
        kyte_reactor_resume(r.readyToken(0));
    }

    let inb = bytes.alloc(8);
    let got = sys.read(a, inb, 8);
    let _ = got;

    bytes.free(out);
    bytes.free(inb);
    sys.close(a);
    sys.close(b);
    r.destroy();
}

@test
fn test_multicore_reactors(): void {
    poller.runReactors(4, worker);
    assert.isTrue(true);
}
