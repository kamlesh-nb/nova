// Stapled OCSP wired into ClientBio end to end: an all-Nova verifying handshake where the SERVER staples
// an OCSP response in the leaf CertificateEntry and the CLIENT captures it and enforces revocation during
// its chain-trust check. A `good` staple lets the handshake complete; a `revoked` staple makes the
// verifying client ABORT even though the chain itself is valid; no staple soft-fails (chain trust
// decides). Also unit-tests the pure findOcspStaple extractor on a synthetic CertificateEntry.
import net.tlsmembio;
import crypto.tls.truststore;
import crypto.tls.revocation;
import crypto.tls.13.tlsClient;
import crypto.x509;
import crypto.ocsp;
import bytes;
import assert;

const CERT: string = "";
const PRIV: string = "accfe82d31600d5810b9984176898804a4ba458216b1ac913231be5008ca82f1";
const CLEN: int = 421;

fn hexNib(c: int): int { if (c >= 48 && c <= 57) { return c - 48; } if (c >= 97 && c <= 102) { return c - 87; } return 0; }
fn hexBuf(hex: string): ptr {
    let n = hex.length / 2; let b = bytes.alloc(n);
    let i = 0; while (i < n) { bytes.write_byte(b, i, hexNib(hex[i * 2]) * 16 + hexNib(hex[i * 2 + 1])); i = i + 1; }
    return b;
}
fn mkTime(): ptr { let t = "20260803120000Z"; let b = bytes.alloc(15); let i = 0; while (i < 15) { bytes.write_byte(b, i, t[i]); i = i + 1; } return b; }
fn keyHash(): ptr { let b = bytes.alloc(20); let i = 0; while (i < 20) { bytes.write_byte(b, i, 0x33); i = i + 1; } return b; }

fn handshake(cb: tlsmembio.ClientBio, sb: tlsmembio.ServerBio, tmp: ptr): bool {
    let cdone = false; let sdone = false; let i = 0;
    while (i < 20 && !(cdone && sdone)) {
        while (cb.pendingOut() > 0) { let n = cb.pull(tmp, 33792); sb.feed(tmp, n); }
        let ss = sb.step(); if (ss < 0) { return false; } if (ss == 0) { sdone = true; }
        while (sb.pendingOut() > 0) { let n = sb.pull(tmp, 33792); cb.feed(tmp, n); }
        let cs = cb.step(); if (cs < 0) { return false; } if (cs == 0) { cdone = true; }
        i = i + 1;
    }
    return cdone && sdone;
}

fn ocspFor(status: int): ptr {
    let certBuf = hexBuf(CERT);
    let leaf = x509.parseCert(certBuf, CLEN);
    let serial = (certBuf as long + leaf.serialStart) as ptr;
    let out = bytes.alloc(1024);
    ocsp.buildTestResponse(serial, leaf.serialLen, status, hexBuf(PRIV), keyHash(), mkTime(), out);
    return out;
}
fn ocspLenFor(status: int): int {
    let certBuf = hexBuf(CERT);
    let leaf = x509.parseCert(certBuf, CLEN);
    let serial = (certBuf as long + leaf.serialStart) as ptr;
    let out = bytes.alloc(1024);
    return ocsp.buildTestResponse(serial, leaf.serialLen, status, hexBuf(PRIV), keyHash(), mkTime(), out);
}

// After a verifying handshake the ClientBio has CAPTURED any stapled OCSP; an app enforces revocation on
// it (crypto/tls/revocation). A good staple accepts, a revoked staple rejects, both with a completed
// handshake (revocation is an application policy layer, kept out of the universal TLS import graph).
@test
fn staple_good_captured_and_accepted(): void {
    let store = truststore.newTrustStoreDer(hexBuf(CERT), CLEN);
    let cb = tlsmembio.newClientBioVerify("localhost", store);
    let sb = tlsmembio.newServerBio(hexBuf(CERT), CLEN, hexBuf(PRIV));
    sb.setStapledOcsp(ocspFor(ocsp.CERT_GOOD), ocspLenFor(ocsp.CERT_GOOD));
    assert.isTrue(handshake(cb, sb, bytes.alloc(33792)));
    assert.isTrue(cb.stapledOcspSize() > 0);                      // captured from the Certificate message
    let store2 = truststore.newTrustStoreDer(hexBuf(CERT), CLEN);
    assert.isTrue(revocation.trustsNotRevoked(store2, cb.peerCertListPtr(), cb.peerCertListSize(), "localhost",
                  20260803120000, cb.stapledOcspPtr(), cb.stapledOcspSize(), bytes.alloc(1), 0));
}

@test
fn staple_revoked_captured_and_rejected(): void {
    let store = truststore.newTrustStoreDer(hexBuf(CERT), CLEN);
    let cb = tlsmembio.newClientBioVerify("localhost", store);
    let sb = tlsmembio.newServerBio(hexBuf(CERT), CLEN, hexBuf(PRIV));
    sb.setStapledOcsp(ocspFor(ocsp.CERT_REVOKED), ocspLenFor(ocsp.CERT_REVOKED));
    assert.isTrue(handshake(cb, sb, bytes.alloc(33792)));         // chain valid -> handshake completes
    assert.isTrue(cb.stapledOcspSize() > 0);
    let store2 = truststore.newTrustStoreDer(hexBuf(CERT), CLEN);
    // the captured staple says REVOKED -> the app's revocation check rejects
    assert.isFalse(revocation.trustsNotRevoked(store2, cb.peerCertListPtr(), cb.peerCertListSize(), "localhost",
                   20260803120000, cb.stapledOcspPtr(), cb.stapledOcspSize(), bytes.alloc(1), 0));
}

@test
fn no_staple_soft_fails_to_trust(): void {
    let store = truststore.newTrustStoreDer(hexBuf(CERT), CLEN);
    let cb = tlsmembio.newClientBioVerify("localhost", store);
    let sb = tlsmembio.newServerBio(hexBuf(CERT), CLEN, hexBuf(PRIV));   // no staple
    assert.isTrue(handshake(cb, sb, bytes.alloc(33792)));
    assert.equalInt(0, cb.stapledOcspSize());                    // nothing captured
}

@test
fn findOcspStaple_extracts(): void {
    // a synthetic CertificateEntry extensions block: status_request (0x0005) wrapping a 6-byte "OCSP"
    let ocspDer = bytes.alloc(6); let i = 0; while (i < 6) { bytes.write_byte(ocspDer, i, 0x40 + i); i = i + 1; }
    // extensions = [type 0005][extDataLen 000a][status_type 01][ocspLen 000006][6 bytes]
    let buf = bytes.alloc(64);
    bytes.write_byte(buf, 0, 0x00); bytes.write_byte(buf, 1, 0x05);           // status_request
    bytes.write_byte(buf, 2, 0x00); bytes.write_byte(buf, 3, 0x0a);           // ext_data len = 1+3+6
    bytes.write_byte(buf, 4, 0x01);                                            // status_type ocsp
    bytes.write_byte(buf, 5, 0x00); bytes.write_byte(buf, 6, 0x00); bytes.write_byte(buf, 7, 0x06);  // OCSP len
    let j = 0; while (j < 6) { bytes.write_byte(buf, 8 + j, bytes.read_byte(ocspDer, j)); j = j + 1; }
    let extTotal = 4 + 10;                                                     // type(2)+len(2)+extData(10)
    let st = tlsClient.findOcspStaple(buf, 0, extTotal);
    assert.equalInt(6, st.len);
    assert.equalInt(8, st.off);
    let k = 0; while (k < 6) { assert.equalInt(bytes.read_byte(ocspDer, k), bytes.read_byte(buf, st.off + k)); k = k + 1; }

    // no status_request -> no staple
    let empty = tlsClient.findOcspStaple(bytes.alloc(4), 0, 0);
    assert.equalInt(0, empty.len);
}
