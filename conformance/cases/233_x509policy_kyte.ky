import crypto.x509;
import bytes;
import assert;

fn hexNib(c: int): int {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    return 0;
}
fn hexBuf(hex: string): ptr {
    let n = hex.length / 2;
    let b = bytes.alloc(n);
    let i = 0;
    while (i < n) { bytes.write_byte(b, i, hexNib(hex[i * 2]) * 16 + hexNib(hex[i * 2 + 1])); i = i + 1; }
    return b;
}

const ROOT: string = "";
const INT: string = "";
const LEAF: string = "";

const NOW: long = 20270101000000;


@test
fn chain_valid(): void {
    let root = x509.parseCert(hexBuf(ROOT), 391);
    let inter = x509.parseCert(hexBuf(INT), 400);
    let leaf = x509.parseCert(hexBuf(LEAF), 440);
    assert.isTrue(root.ok && inter.ok && leaf.ok);
    assert.isTrue(x509.verifyChain3(leaf, inter, root, "leaf.nova.test", NOW));
}

@test
fn ca_constraints(): void {
    let root = x509.parseCert(hexBuf(ROOT), 391);
    let inter = x509.parseCert(hexBuf(INT), 400);
    let leaf = x509.parseCert(hexBuf(LEAF), 440);
    assert.isTrue(x509.isCA(root));
    assert.isTrue(x509.isCA(inter));
    assert.isTrue(!x509.isCA(leaf));
}

@test
fn hostname_matching(): void {
    let leaf = x509.parseCert(hexBuf(LEAF), 440);
    assert.isTrue(x509.matchHostname(leaf, "leaf.nova.test"));
    assert.isTrue(x509.matchHostname(leaf, "anything.wild.nova.test"));
    assert.isTrue(!x509.matchHostname(leaf, "wild.nova.test"));
    assert.isTrue(!x509.matchHostname(leaf, "a.b.wild.nova.test"));
    assert.isTrue(!x509.matchHostname(leaf, "evil.com"));
}

@test
fn wrong_hostname_rejected(): void {
    let root = x509.parseCert(hexBuf(ROOT), 391);
    let inter = x509.parseCert(hexBuf(INT), 400);
    let leaf = x509.parseCert(hexBuf(LEAF), 440);
    assert.isTrue(!x509.verifyChain3(leaf, inter, root, "evil.com", NOW));
}

@test
fn validity_window(): void {
    let leaf = x509.parseCert(hexBuf(LEAF), 440);
    assert.isTrue(x509.checkValidity(leaf, NOW));
    assert.isTrue(!x509.checkValidity(leaf, 20200101000000));
    assert.isTrue(!x509.checkValidity(leaf, 20400101000000));
    let root = x509.parseCert(hexBuf(ROOT), 391);
    let inter = x509.parseCert(hexBuf(INT), 400);
    assert.isTrue(!x509.verifyChain3(leaf, inter, root, "leaf.nova.test", 20400101000000));
}

@test
fn broken_chain_rejected(): void {
    let root = x509.parseCert(hexBuf(ROOT), 391);
    let leaf = x509.parseCert(hexBuf(LEAF), 440);
    assert.isTrue(!x509.verifyChain2(leaf, root, "leaf.nova.test", NOW));
}

fn w3(buf: ptr, off: int, v: int): void {
    bytes.write_byte(buf, off, (v >> 16) & 0xff);
    bytes.write_byte(buf, off + 1, (v >> 8) & 0xff);
    bytes.write_byte(buf, off + 2, v & 0xff);
}
fn addEntry(list: ptr, p: int, certHex: string, certLen: int): int {
    w3(list, p, certLen); p = p + 3;
    let der = hexBuf(certHex);
    let i = 0;
    while (i < certLen) { bytes.write_byte(list, p + i, bytes.read_byte(der, i)); i = i + 1; }
    p = p + certLen;
    bytes.write_byte(list, p, 0); bytes.write_byte(list, p + 1, 0); p = p + 2;
    return p;
}

@test
fn cert_list_chain(): void {
    let list = bytes.alloc(1024);
    let p = addEntry(list, 0, LEAF, 440);
    p = addEntry(list, p, INT, 400);
    assert.isTrue(x509.verifyCertList(list, p, hexBuf(ROOT), 391, "leaf.nova.test", NOW));
    assert.isTrue(!x509.verifyCertList(list, p, hexBuf(ROOT), 391, "evil.com", NOW));

    let solo = bytes.alloc(512);
    let q = addEntry(solo, 0, LEAF, 440);
    assert.isTrue(!x509.verifyCertList(solo, q, hexBuf(ROOT), 391, "leaf.nova.test", NOW));
}

fn addEntry12(list: ptr, p: int, certHex: string, certLen: int): int {
    w3(list, p, certLen); p = p + 3;
    let der = hexBuf(certHex);
    let i = 0;
    while (i < certLen) { bytes.write_byte(list, p + i, bytes.read_byte(der, i)); i = i + 1; }
    return p + certLen;
}

@test
fn cert_list12_chain(): void {
    let list = bytes.alloc(1024);
    let p = addEntry12(list, 0, LEAF, 440);
    p = addEntry12(list, p, INT, 400);
    assert.isTrue(x509.verifyCertList12(list, p, hexBuf(ROOT), 391, "leaf.nova.test", NOW));
    assert.isTrue(!x509.verifyCertList12(list, p, hexBuf(ROOT), 391, "evil.com", NOW));

    assert.isTrue(!x509.verifyCertList(list, p, hexBuf(ROOT), 391, "leaf.nova.test", NOW));

    let solo = bytes.alloc(512);
    let q = addEntry12(solo, 0, LEAF, 440);
    assert.isTrue(!x509.verifyCertList12(solo, q, hexBuf(ROOT), 391, "leaf.nova.test", NOW));
}
