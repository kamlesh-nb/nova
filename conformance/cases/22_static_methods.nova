// Gates static/associated method calls: `Struct.staticMethod()`. Sema didn't type the
// RESULT of a static call (methodReturn infers the receiver as a value, but the receiver
// here is the struct NAME), so `let q = Point.origin()` was untyped and any `q.method()`
// on it failed with MethodOrFunctionNotFound. This blocked factory methods like
// `File.open()`. Now static calls are typed by their declared return type.
import assert;

struct Point {
    pub x: int,
    pub y: int,
    init(x: int, y: int) { self.x = x; self.y = y; }

    // Static/associated methods (no `self`).
    pub fn origin(): Point { return Point(0, 0); }
    pub fn at(x: int, y: int): Point { return Point(x, y); }

    // Instance method.
    pub fn sum(self: Point): int { return self.x + self.y; }
}

@test
fn test_static_factory_then_instance_method(): void {
    let o = Point.origin();          // static call, result must be typed Point...
    assert.equalInt(0, o.sum());     // ...so this instance call resolves

    let p = Point.at(3, 4);          // static call with args
    assert.equalInt(7, p.sum());
    assert.equalInt(3, p.x);
}

@test
fn test_static_call_result_directly(): void {
    // The static result used inline (not via a let) must also carry its type.
    assert.equalInt(12, Point.at(5, 7).sum());
}
