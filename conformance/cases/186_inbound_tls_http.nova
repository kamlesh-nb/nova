fn toStr(buf: long, n: int): string {
    if (n <= 0) { return ""; }
    let out = bytes.alloc(n);
    let i = 0;
    while (i < n) { bytes.write_byte(out, i, bytes.read_byte(buf, i)); i = i + 1; }
    return out as string;
}

async fn httpsServer(srv: long): int {
    let client = await asyncio.aaccept(srv);
    let base = asyncio.AsyncStream(client);
    let ts = await asynctls.tlsAccept(base, TEST_CERT, TEST_KEY);
    if (!ts.ok()) { ts.close(); return -1; }
    let buf: long = bytes.alloc(1024);              // long: the recv address must NOT truncate
    let n = await ts.recvInto(buf, 1024);           // pass the 64-bit address directly (widened seam)
    let req = toStr(buf, n);
    bytes.free(buf);
    let ok = string.startsWith(req, "GET /ping");
    let body = if (ok) "{\"ok\":true}" else "{\"ok\":false}";
    let resp = "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: " + `${body.length}` + "\r\nConnection: close\r\n\r\n" + body;
    let w = await ts.sendStr(resp);
    ts.close();
    return n;
}

async fn httpsClient(port: int): string {
    let ts = await asynctls.tlsConnect("localhost", port, false);
    if (!ts.ok()) { return "HS-FAIL"; }
    let w = await ts.sendStr("GET /ping/7 HTTP/1.1\r\nHost: localhost\r\n\r\n");
    let buf: long = bytes.alloc(1024);
    let n = await ts.recvInto(buf, 1024);
    let resp = toStr(buf, n);
    bytes.free(buf);
    ts.close();
    // Return just the body (after the header terminator) for a clean assert.
    let idx = string.indexOf(resp, "\r\n\r\n");
    if (idx == -1) { return resp; }
    return string.slice(resp, idx + 4, resp.length);
}

async fn httpsRoundtrip(port: int): string {
    let srv = asyncio.serverListen(port);
    if (srv == 0) { return "BIND-FAIL"; }
    spawn httpsServer(srv);
    let reply = await httpsClient(port);
    asyncio.aclose(srv);
    return reply;
}

@test
fn test_inbound_tls_http(): void {
    // A full HTTPS request -> HTTP response over an async TLS session.
    assert.equalStr(httpsRoundtrip(18486), "{\"ok\":true}");
}
