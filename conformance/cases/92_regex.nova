import list;
import string;
import text.regex;
import assert;

@test
fn test_literals_dot_quantifiers(): void {
    assert.isTrue(regex.compile("a.c").test("axc"));
    assert.isTrue(!regex.compile("a.c").test("ac"));
    assert.isTrue(regex.compile("ab*c").test("ac"));
    assert.isTrue(regex.compile("ab*c").test("abbbc"));
    assert.isTrue(regex.compile("ab+c").test("abc"));
    assert.isTrue(!regex.compile("ab+c").test("ac"));
    assert.isTrue(regex.compile("ab?c").test("ac"));
    assert.isTrue(!regex.compile("ab?c").test("abbc"));
}

@test
fn test_alternation_anchors_braces(): void {
    assert.isTrue(regex.compile("cat|dog").test("i have a dog"));
    assert.isTrue(!regex.compile("cat|dog").test("i have a fish"));
    assert.isTrue(regex.compile("^abc$").test("abc"));
    assert.isTrue(!regex.compile("^abc$").test("xabc"));
    assert.isTrue(regex.compile("^a{2,4}$").test("aaaa"));
    assert.isTrue(!regex.compile("^a{2,4}$").test("aaaaa"));
    assert.isTrue(regex.compile("^a{2,}$").test("aaaaaa"));
}

@test
fn test_classes_and_escapes(): void {
    assert.isTrue(regex.compile("[a-z]+").test("Hello"));
    assert.isTrue(regex.compile("[^0-9]").test("a1"));
    assert.isTrue(!regex.compile("[^0-9]+$").test("123"));
    assert.isTrue(regex.compile("\\d\\d\\d").test("id=456!"));
    assert.isTrue(regex.compile("\\w+").test("_var2"));
    assert.isTrue(regex.compile("a\\sb").test("a b"));
    assert.isTrue(regex.compile("a\\.b").test("a.b"));
    assert.isTrue(!regex.compile("a\\.b").test("axb"));
}

@test
fn test_captures_findall_replace(): void {
    let m = regex.compile("(\\d+)-(\\d+)").exec("code 12-345 end");
    assert.isTrue(m.matched);
    assert.equalStr(m.group(0), "12-345");
    assert.equalStr(m.group(1), "12");
    assert.equalStr(m.group(2), "345");

    let nums = regex.compile("\\d+").findAll("a1 bb22 c333");
    assert.equalInt(nums.size(), 3);
    assert.equalStr(nums.at(2), "333");

    assert.equalStr(regex.compile("\\d+").replaceAll("a1b22c", "#"), "a#b#c");
    assert.equalStr(regex.compile("(\\w+)@(\\w+)").replaceAll("x a@b y", "x $2.$1"), "x x b.a y");

    let ident = regex.compile("^[a-zA-Z_][a-zA-Z0-9_]*$");
    assert.isTrue(ident.test("my_var2"));
    assert.isTrue(!ident.test("2bad"));
}
