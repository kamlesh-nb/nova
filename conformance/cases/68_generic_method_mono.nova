// Method-level monomorphization: a REAL, visible generic method whose BODY is
// specialized per type argument. `Reg.decode<T>(src)` reifies `T` inside its own
// body via `serde.bind<T>` (the compiler-generated `<T>__bind`) — the compiler emits
// `Reg_decode__GetUser` / `Reg_decode__AddReq`, each with `T` substituted to the
// concrete type, so the right binder runs. `serde.typeName<T>()` yields the concrete
// name (the mediator registry key). These two reifies are what `app.get<T>` route
// methods are built from.
//
// This is the honest test the earlier `box<T>` spike was NOT: `box<T>` returned `1`
// regardless of `T` and so passed even under total type-erasure. Here the return
// VALUE depends on `T`'s fields, so a green means `T` genuinely became concrete
// inside the method body.
import assert;
import serde.source;

@serializable struct GetUser { pub id: int }
@serializable struct AddReq { pub a: int, pub b: int }

struct Reg {
    init() {}
    // A generic method with its OWN type-param, reifying a value inside the body.
    fn decode<T>(self: Reg, src: ValueSource): T {
        return serde.bind<T>(src);
    }
    fn nameOf<T>(self: Reg): string {
        return serde.typeName<T>();
    }
}

@test
fn test_generic_method_reifies_per_type(): void {
    let r = Reg();
    let u = r.decode<GetUser>(source.fromJson("{\"id\": 7}"));
    assert.equalInt(u.id, 7);

    let a = r.decode<AddReq>(source.fromJson("{\"a\": 20, \"b\": 22}"));
    assert.equalInt(a.a, 20);
    assert.equalInt(a.b, 22);
}

@test
fn test_generic_method_typename(): void {
    let r = Reg();
    assert.equalStr(r.nameOf<GetUser>(), "GetUser");
    assert.equalStr(r.nameOf<AddReq>(), "AddReq");
}

// A CLOSURE created inside a generic method must reify the method's type-param too — the lifted
// lambda inherits the method subst (closure monomorphization). Captures a value AND reifies T.
struct Builder {
    init() {}
    fn build<T>(self: Builder, base: int, src: ValueSource): int {
        let f = (s) => serde.bind<T>(s).id + base;   // captures `base`, reifies T inside the lambda
        return f(src);
    }
}

@test
fn test_closure_in_generic_method_reifies_t(): void {
    let b = Builder();
    // GetUser.id (7) + base (100) == 107 — proves T became concrete inside the lifted lambda.
    assert.equalInt(b.build<GetUser>(100, source.fromJson("{\"id\": 7}")), 107);
}
