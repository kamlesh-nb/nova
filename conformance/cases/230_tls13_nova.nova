import crypto.ecc.x25519;
import crypto.tls.13.tls;
import bytes;
import assert;

fn hexNib(c: int): int {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    return 0;
}
fn hexBuf(hex: string): ptr {
    let n = hex.length / 2;
    let b = bytes.alloc(n);
    let i = 0;
    while (i < n) { bytes.write_byte(b, i, hexNib(hex[i * 2]) * 16 + hexNib(hex[i * 2 + 1])); i = i + 1; }
    return b;
}
fn eqHex(buf: ptr, n: int, hex: string): bool {
    if (hex.length != n * 2) { return false; }
    let i = 0;
    while (i < n) {
        if (bytes.read_byte(buf, i) != hexNib(hex[i * 2]) * 16 + hexNib(hex[i * 2 + 1])) { return false; }
        i = i + 1;
    }
    return true;
}
fn eqBuf(a: ptr, b: ptr, n: int): bool {
    let i = 0;
    while (i < n) { if (bytes.read_byte(a, i) != bytes.read_byte(b, i)) { return false; } i = i + 1; }
    return true;
}

const CLIENT_PRIV: string = "49af42ba7f7994852d713ef2784bcbcaa7911de26adc5642cb634540e7ea5005";
const SERVER_PUB: string  = "c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f";
const ECDHE: string       = "8bd4054fb55b9d63fdfbacf9f04b9f0d35e6d63f537563efd46272900f89492d";
const EARLY: string       = "33ad0a1c607ec03b09e6cd9893680ce210adf300aa1f2660e1b22e10f170f92a";
const DERIVED: string     = "6f2615a108c702c5678f54fc9dbab69716c076189c48250cebeac3576c3611ba";
const HANDSHAKE: string   = "1dc826e93606aa6fdc0aadc12f741b01046aa6b99f691ed221a9f0ca043fbeac";
const TRANSCRIPT: string  = "860c06edc07858ee8e78f0e7428c58edd6b43f2ca3e6e95f02ed063cf0e1cad8";
const CLIENT_HS: string   = "b3eddb126e067f35a780b3abf45e2d8f3b1a950738f52e9600746a0e27a55a21";
const SERVER_HS: string   = "b67b7d690cc16c4e75e54213cb2d37b4e9c912bcded9105d42befd59d391ad38";
const SERVER_KEY: string  = "3fce516009c21727d0f2e4e86ee403bc";
const SERVER_IV: string   = "5d313eb2671276ee13000b30";

@test
fn ecdhe(): void {
    let out = bytes.alloc(32);
    x25519.scalarMult(out, hexBuf(CLIENT_PRIV), hexBuf(SERVER_PUB));
    assert.isTrue(eqHex(out, 32, ECDHE));
}

@test
fn key_schedule(): void {
    let early = bytes.alloc(32);
    tls.earlySecret(0, early);
    assert.isTrue(eqHex(early, 32, EARLY));

    let derived = bytes.alloc(32);
    tls.deriveDerived(0, early, derived);
    assert.isTrue(eqHex(derived, 32, DERIVED));

    let hs = bytes.alloc(32);
    tls.extractSecret(0, derived, hexBuf(ECDHE), 32, hs);
    assert.isTrue(eqHex(hs, 32, HANDSHAKE));

    let chs = bytes.alloc(32);
    tls.deriveTraffic(0, hs, "c hs traffic", hexBuf(TRANSCRIPT), chs);
    assert.isTrue(eqHex(chs, 32, CLIENT_HS));

    let shs = bytes.alloc(32);
    tls.deriveTraffic(0, hs, "s hs traffic", hexBuf(TRANSCRIPT), shs);
    assert.isTrue(eqHex(shs, 32, SERVER_HS));

    let key = bytes.alloc(16);
    let iv = bytes.alloc(12);
    tls.deriveKeyIv(0, 0, shs, key, iv);
    assert.isTrue(eqHex(key, 16, SERVER_KEY));
    assert.isTrue(eqHex(iv, 12, SERVER_IV));
}

const REC: string = "";
const PAY: string = "";

@test
fn record_unprotect(): void {
    let key = hexBuf(SERVER_KEY);
    let iv = hexBuf(SERVER_IV);
    let rec = hexBuf(REC);
    let out = bytes.alloc(700);
    let innerLen = tls.recordUnprotect(0, key, iv, 0, rec, 679, out);
    assert.equalInt(innerLen, 658);
    assert.isTrue(eqHex(out, 657, PAY));
    assert.equalInt(bytes.read_byte(out, 657), 0x16);
}

@test
fn record_protect(): void {
    let key = hexBuf(SERVER_KEY);
    let iv = hexBuf(SERVER_IV);
    let out = bytes.alloc(700);
    let recLen = tls.recordProtect(0, key, iv, 0, hexBuf(PAY), 657, 0x16, out);
    assert.equalInt(recLen, 679);
    assert.isTrue(eqBuf(out, hexBuf(REC), 679));
}
