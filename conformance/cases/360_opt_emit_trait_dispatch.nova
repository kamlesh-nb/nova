import assert;

trait Shape {
    fn area(self: Shape): int;
    fn kind(self: Shape): int;
}

struct Sq impl Shape {
    pub s: int,
    pub fn area(self: Sq): int { return self.s * self.s; }
    pub fn kind(self: Sq): int { return 1; }
}

struct Rec impl Shape {
    pub w: int,
    pub h: int,
    pub fn area(self: Rec): int { return self.w * self.h; }
    pub fn kind(self: Rec): int { return 2; }
}

struct Tri impl Shape {
    pub b: int,
    pub hh: int,
    pub fn area(self: Tri): int { return (self.b * self.hh) / 2; }
    pub fn kind(self: Tri): int { return 3; }
}

fn measure(sh: Shape): int { return sh.area(); }
fn twice(sh: Shape): int { return sh.area() + sh.area(); }
fn bigger(sh: Shape): bool { return sh.area() > 20; }
fn secondSlot(sh: Shape): int { return sh.kind(); }

@test
fn test_dispatch_single(): void {
    let a: Shape = Sq{ s: 5 };
    let b: Shape = Rec{ w: 3, h: 4 };
    let c: Shape = Tri{ b: 6, hh: 4 };
    assert.equalInt(measure(a), 25);
    assert.equalInt(measure(b), 12);
    assert.equalInt(measure(c), 12);
}

@test
fn test_dispatch_repeated_and_cmp(): void {
    let a: Shape = Sq{ s: 5 };
    let b: Shape = Rec{ w: 3, h: 4 };
    assert.equalInt(twice(a), 50);
    assert.isTrue(bigger(a));
    assert.isFalse(bigger(b));
}

@test
fn test_dispatch_second_vtable_slot(): void {
    let a: Shape = Sq{ s: 2 };
    let b: Shape = Rec{ w: 1, h: 1 };
    let c: Shape = Tri{ b: 2, hh: 2 };
    assert.equalInt(secondSlot(a), 1);
    assert.equalInt(secondSlot(b), 2);
    assert.equalInt(secondSlot(c), 3);
}
