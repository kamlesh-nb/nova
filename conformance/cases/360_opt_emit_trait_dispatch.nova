// Emit-subset growth (D5): SYNCHRONOUS trait dynamic dispatch now emits from the optimiser IR. A function
// that takes a trait-typed parameter and calls a trait method on it dispatches through the trait fat pointer
// -- a heap {struct_ptr, vtable} pair -- exactly as the AST path's buildTraitVtableCall does: load the
// receiver's struct_ptr, load its vtable, load the method's fn pointer from vtable slot (k+1)*8 (slot 0 is
// the destructor), then an indirect call passing struct_ptr as self. All params/return are the i64 word,
// the fixed trait-method ABI. Under NOVA_OPT_EMIT the dispatch functions (`measure`, `twice`, `bigger`)
// compile from the optimised IR; under the default build from the AST. Both must agree.
//
// Deliberately still on the AST (rejected by the emit gates, exercised here only for AST==emit agreement):
//   - trait WIDENING (`let s: Shape = Sq{...}`): the emit path does not build the fat pointer, so a function
//     that constructs a trait object, or passes a value into a trait-typed parameter, falls back.
//   - ASYNC trait methods: a coroutine, left to the AST.
import assert;

trait Shape {
    fn area(self: Shape): int;
    fn kind(self: Shape): int;
}

struct Sq impl Shape {
    pub s: int,
    pub fn area(self: Sq): int { return self.s * self.s; }
    pub fn kind(self: Sq): int { return 1; }
}

struct Rec impl Shape {
    pub w: int,
    pub h: int,
    pub fn area(self: Rec): int { return self.w * self.h; }
    pub fn kind(self: Rec): int { return 2; }
}

struct Tri impl Shape {
    pub b: int,
    pub hh: int,
    pub fn area(self: Tri): int { return (self.b * self.hh) / 2; }
    pub fn kind(self: Tri): int { return 3; }
}

// These are the functions that EMIT: a trait param dispatched dynamically.
fn measure(sh: Shape): int { return sh.area(); }
fn twice(sh: Shape): int { return sh.area() + sh.area(); }
fn bigger(sh: Shape): bool { return sh.area() > 20; }
fn secondSlot(sh: Shape): int { return sh.kind(); }

@test
fn test_dispatch_single(): void {
    let a: Shape = Sq{ s: 5 };
    let b: Shape = Rec{ w: 3, h: 4 };
    let c: Shape = Tri{ b: 6, hh: 4 };
    assert.equalInt(measure(a), 25);
    assert.equalInt(measure(b), 12);
    assert.equalInt(measure(c), 12);
}

@test
fn test_dispatch_repeated_and_cmp(): void {
    let a: Shape = Sq{ s: 5 };
    let b: Shape = Rec{ w: 3, h: 4 };
    assert.equalInt(twice(a), 50);
    assert.isTrue(bigger(a));
    assert.isFalse(bigger(b));
}

@test
fn test_dispatch_second_vtable_slot(): void {
    // kind() is the SECOND trait method: exercises vtable slot indexing (slot 2 = index 1 + 1 for dtor).
    let a: Shape = Sq{ s: 2 };
    let b: Shape = Rec{ w: 1, h: 1 };
    let c: Shape = Tri{ b: 2, hh: 2 };
    assert.equalInt(secondSlot(a), 1);
    assert.equalInt(secondSlot(b), 2);
    assert.equalInt(secondSlot(c), 3);
}
