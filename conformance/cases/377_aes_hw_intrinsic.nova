import assert;
import bytes;
const SBOX: string = "";
fn hexNib(c: int): int { if (c >= 48 && c <= 57) { return c - 48; } if (c >= 97 && c <= 102) { return c - 87; } return 0; }
fn hexBuf(hex: string): ptr { let n = hex.length / 2; let b = bytes.alloc(n); let i = 0; while (i < n) { bytes.write_byte(b, i, hexNib(hex[i * 2]) * 16 + hexNib(hex[i * 2 + 1])); i = i + 1; } return b; }
fn xtime(a: int): int { let r = (a << 1) & 0xff; if ((a & 0x80) != 0) { r = r ^ 0x1b; } return r; }
fn sub(sbox: ptr, b: int): int { return bytes.read_byte(sbox, b & 0xff); }
fn keyExpand256(sbox: ptr, key: ptr, rk: ptr): void {
    let i = 0; while (i < 32) { bytes.write_byte(rk, i, bytes.read_byte(key, i)); i = i + 1; }
    let rcon = 1; let w = 8;
    while (w < 60) {
        let t0 = bytes.read_byte(rk, (w-1)*4+0); let t1 = bytes.read_byte(rk, (w-1)*4+1);
        let t2 = bytes.read_byte(rk, (w-1)*4+2); let t3 = bytes.read_byte(rk, (w-1)*4+3);
        if (w % 8 == 0) {
            let n0 = sub(sbox, t1) ^ rcon; let n1 = sub(sbox, t2); let n2 = sub(sbox, t3); let n3 = sub(sbox, t0);
            t0 = n0; t1 = n1; t2 = n2; t3 = n3; rcon = xtime(rcon);
        } else if (w % 8 == 4) {
            t0 = sub(sbox, t0); t1 = sub(sbox, t1); t2 = sub(sbox, t2); t3 = sub(sbox, t3);
        }
        bytes.write_byte(rk, w*4+0, bytes.read_byte(rk, (w-8)*4+0) ^ t0);
        bytes.write_byte(rk, w*4+1, bytes.read_byte(rk, (w-8)*4+1) ^ t1);
        bytes.write_byte(rk, w*4+2, bytes.read_byte(rk, (w-8)*4+2) ^ t2);
        bytes.write_byte(rk, w*4+3, bytes.read_byte(rk, (w-8)*4+3) ^ t3);
        w = w + 1;
    }
}
@test
fn aes256_hw_block(): void {
    let sbox = hexBuf(SBOX);
    let key = hexBuf("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f");
    let pt  = hexBuf("00112233445566778899aabbccddeeff");
    let rk = bytes.alloc(240);
    keyExpand256(sbox, key, rk);
    let out = bytes.alloc(16);
    let state = simd.xorU8x16(simd.loadU8x16(pt, 0), simd.loadU8x16(rk, 0));
    let r = 1; while (r < 14) { state = simd.aesencU8x16(state, simd.loadU8x16(rk, r*16)); r = r + 1; }
    state = simd.aesenclastU8x16(state, simd.loadU8x16(rk, 14*16));
    simd.storeU8x16(out, 0, state);
    let want = hexBuf("8ea2b7ca516745bfeafc49904b496089");
    let i = 0; while (i < 16) { assert.equalInt(bytes.read_byte(out, i), bytes.read_byte(want, i)); i = i + 1; }
}
