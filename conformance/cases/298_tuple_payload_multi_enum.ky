
import assert;

enum Shape {
    Circle(int),
    Rect(int, int),
    Named(string, int)
}

fn area(s: Shape): int {
    switch (s) {
        case Shape.Circle(r): { return r * r * 3; }
        case Shape.Rect(w, h): { return w * h; }
        case Shape.Named(n, v): { return v; }
    }
}

@test
fn test_rect_two_payloads(): void {
    assert.equalInt(area(Shape.Rect(3, 4)), 12);
}

@test
fn test_single_payload_still_works(): void {
    assert.equalInt(area(Shape.Circle(2)), 12);
}

@test
fn test_owned_string_payload(): void {
    let s = Shape.Named("hello", 9);
    switch (s) {
        case Shape.Named(n, v): {
            assert.equalStr(n, "hello");
            assert.equalInt(v, 9);
        }
        case Shape.Circle(r): { assert.isTrue(false); }
        case Shape.Rect(w, h): { assert.isTrue(false); }
    }
}

enum Triple { T(int, int, int) }

@test
fn test_three_payloads(): void {
    switch (Triple.T(1, 2, 3)) {
        case Triple.T(a, b, c): { assert.equalInt(a + b + c, 6); }
    }
}
