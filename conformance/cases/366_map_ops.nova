// Gap 8 stdlib depth: Map convenience ops (getOrDefault/merge/entries/clear).
import assert;
import map;

@test
fn test_map_ops(): void {
    let m = Map<int, int>(8, (k: int) => k);
    m.set(1, 10); m.set(2, 20);

    assert.equalInt(m.getOrDefault(1, -1), 10);
    assert.equalInt(m.getOrDefault(9, -1), -1);   // absent -> default

    let other = Map<int, int>(8, (k: int) => k);
    other.set(2, 99); other.set(3, 30);
    m.merge(other);
    assert.equalInt(m.getOrDefault(2, 0), 99);    // overwritten
    assert.equalInt(m.getOrDefault(3, 0), 30);    // added
    assert.equalInt(m.size(), 3);

    let es = m.entries();
    assert.equalInt(es.size(), 3);

    m.clear();
    assert.equalInt(m.size(), 0);
    assert.equalInt(m.getOrDefault(1, -7), -7);
    m.set(5, 50);                                  // reuse after clear
    assert.equalInt(m.getOrDefault(5, 0), 50);
}
