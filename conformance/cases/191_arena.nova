// Phase 3: the per-connection bump arena (nginx pool model). Proves bump allocation with
// alignment, payload read/write, reset reusing memory from the start, and exhaustion. Outside
// ARC (plain addresses).
import assert;
import bytes;
import io.arena;

@test
fn test_arena_bump_and_reset(): void {
    let ar = arena.Arena(256);
    let p1 = ar.alloc(10);
    let p2 = ar.alloc(20);
    assert.isTrue(p1 != 0);
    assert.isTrue(p2 != 0);
    assert.isTrue(p2 > p1);
    assert.isTrue(p2 - p1 == 16);        // 10 rounded up to an 8-byte multiple

    bytes.write_i32(p1, 0, 111);
    bytes.write_i32(p2, 0, 222);
    assert.equalInt(bytes.read_i32(p1, 0) as int, 111);
    assert.equalInt(bytes.read_i32(p2, 0) as int, 222);

    ar.reset();
    let p3 = ar.alloc(10);
    assert.isTrue(p3 == p1);             // reset reuses from the start
    ar.destroy();
}

// M-6: the arena now GROWS on overflow (chains a new block) instead of failing, so one big
// request cannot starve the others. alloc never returns 0.
@test
fn test_arena_grows_past_first_block(): void {
    let ar = arena.Arena(16);
    assert.equalInt(ar.blockCount(), 1);
    let a = ar.alloc(16);                // fills the first block
    assert.isTrue(a != 0);
    let b = ar.alloc(8);                 // over the first block -> chains a new one, never 0
    assert.isTrue(b != 0);
    assert.isTrue(ar.blockCount() > 1);
    ar.destroy();
}
