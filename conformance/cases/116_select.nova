// A1 async-first seam: `select` over futures — await the FIRST of several futures to complete and
// learn which one won (its index), WITHOUT consuming it (so the winner's value is still readable
// via `await fs.at(idx)`). Built on a runtime `nova_when_any` that polls the handles and, when none
// is ready, arms the current coroutine as the waiter on ALL of them (first to complete reschedules
// it); a ready hit disarms it from the rest so a later completion cannot double-wake it. This is
// the primitive under query-timeouts-as-a-race and first-of-N-replicas patterns.
//
// Determinism: the "slow" futures are gated on an async channel that is never fed until after the
// select resolves, so the immediate future is unambiguously first. The blocked futures are drained
// (channel fed + awaited) before the test returns so no coroutine frame leaks.
import assert;
import list;
import concurrency.async_util;
import concurrency.asyncchan;

async fn immediate(v: int): int { return v; }
async fn gated(ch: long): int { return await asyncchan.chanRecv(ch); }

// Run a select where the winner is at position `winnerAt` (an immediate future); the other slots
// are futures blocked on `gate`. Returns the selected index; drains the blocked ones afterward.
async fn selectWith(winnerAt: int, total: int, gate: long): int {
    let fs = List<future<int>>();
    let i = 0;
    while (i < total) {
        if (i == winnerAt) { fs.push(spawn immediate(1000 + i)); }
        else { fs.push(spawn gated(gate)); }
        i = i + 1;
    }
    let idx = await async_util.selectAny<int>(fs);
    let val = await fs.at(idx);            // winner still readable (select did not consume it)
    // release + drain the blocked losers so their frames are freed.
    let k = 0;
    while (k < total) {
        if (k != winnerAt) { asyncchan.chanSend(gate, 0); }
        k = k + 1;
    }
    let d = 0;
    while (d < total) { if (d != winnerAt) { let x = await fs.at(d); } d = d + 1; }
    // encode both facts into the return: idx in low bits, value delta verifies non-consumption.
    if (val != 1000 + idx) { return -1; }
    return idx;
}

@test
fn test_select_picks_the_ready_future(): void {
    let gate = asyncchan.chanNew();
    // winner in the middle of 3.
    assert.equalInt(selectWith(1, 3, gate), 1);
    asyncchan.chanFree(gate);
}

@test
fn test_select_winner_first(): void {
    let gate = asyncchan.chanNew();
    assert.equalInt(selectWith(0, 4, gate), 0);
    asyncchan.chanFree(gate);
}

@test
fn test_select_winner_last(): void {
    let gate = asyncchan.chanNew();
    assert.equalInt(selectWith(3, 4, gate), 3);
    asyncchan.chanFree(gate);
}

@test
fn test_select_empty_is_minus_one(): void {
    let fs = List<future<int>>();
    assert.equalInt(async_util.selectAny<int>(fs), -1);   // nothing to select -> -1
}
