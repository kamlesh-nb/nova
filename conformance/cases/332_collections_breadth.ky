import assert;
import list;
import set;

fn cmpInt(a: int, b: int): int { return a - b; }

@test
fn list_sort_slice_concat(): void {
    let xs = List<int>();
    xs.push(3); xs.push(1); xs.push(2);
    xs.sort(cmpInt);
    assert.equalInt(xs.at(0), 1); assert.equalInt(xs.at(1), 2); assert.equalInt(xs.at(2), 3);
    let sl = xs.slice(1, 3);
    assert.equalInt(sl.size(), 2); assert.equalInt(sl.at(0), 2);
    let ys = List<int>(); ys.push(4); ys.push(5);
    let c = xs.concat(ys);
    assert.equalInt(c.size(), 5); assert.equalInt(c.at(4), 5);
}

@test
fn set_algebra(): void {
    let a = Set<int>(8, set.i32Hash);
    a.add(1); a.add(2); a.add(3);
    let b = Set<int>(8, set.i32Hash);
    b.add(2); b.add(3); b.add(4);
    assert.equalInt(a.unionWith(b).size(), 4);
    assert.equalInt(a.intersection(b).size(), 2);
    let d = a.difference(b);
    assert.equalInt(d.size(), 1); assert.isTrue(d.has(1)); assert.isTrue(!d.has(2));
}
