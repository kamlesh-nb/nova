// Emit-subset growth (C5, the template sub-form): string interpolation `` `${a} text ${b}` `` now emits when
// EVERY part is a string. It lowers to a dedicated `.template` MIR op (produced only on the emit path; the
// shadow keeps its aggregate placeholder), which the emit path reproduces byte-identically to the AST's
// StringBuilder lowering: alloc + StringBuilder_init, one StringBuilder_append per part (append COPIES and
// BORROWS, so no per-part ARC), StringBuilder_toString (the owned result), StringBuilder_delete, then
// nova_release(sb, null) on the StringBuilder itself. A NON-string interpolated part (int/float/decimal/
// optional) needs the AST's type-dispatched append (numToString + release) and is NOT modelled here, so any
// such template falls back to the AST. Under NOVA_OPT_EMIT these helpers compile from the emit path; both must
// agree AND stay ARC-balanced (the --arc gate: the StringBuilder is released once, the parts are borrowed).
import assert;
import string;

fn single(s: string): int {                     // `${s}` -- single string var
    let r = `${s}`;
    return r.len();
}
fn wrapped(s: string): int {                     // `a${s}b` -- literal text + one var
    let r = `<${s}>`;
    return r.len();
}
fn joinTwo(a: string, b: string): int {          // two string vars + literal text between/around
    let r = `[${a}]-[${b}]!`;
    return r.len();
}

@test
fn test_template_string_parts(): void {
    assert.equalInt(single("hello"), 5);
    assert.equalInt(wrapped("hi"), 4);          // <hi> = 4
    assert.equalInt(joinTwo("cat", "dog"), 12); // [cat]-[dog]! = 12
    // Loop to exercise the StringBuilder alloc/release balance under repeated construction (ARC-clean).
    let i = 0;
    while (i < 500) {
        assert.equalInt(joinTwo("x", "y"), 8);   // [x]-[y]! = 8
        i = i + 1;
    }
}
