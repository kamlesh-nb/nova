// Gates the console/bytes-in-closure fix: a builtin receiver (console.log, bytes.alloc)
// used inside a closure was captured as a phantom free variable and died with
// "Identifier 'console' not found" — which blocked web/server (fiber closures log).
import assert;

fn runInt(f: () -> int): int { return f(); }
fn runVoid(f: () -> void): void { f(); }

@test
fn test_console_in_closure(): void {
    // console.log inside a closure must resolve (was the crash). No assertion on output;
    // reaching here without a compile error is the gate.
    runVoid(() => {
        console.log("hello from a closure");
    });
    assert.isTrue(true);
}

@test
fn test_bytes_in_closure(): void {
    // bytes.* inside a closure; return the value out (closures capture by value).
    let r = runInt(() => {
        let p = bytes.alloc(4);
        bytes.write_byte(p, 0, 65);
        let r = bytes.read_byte(p, 0);
        bytes.free(p);   // bytes.alloc is MANUAL memory (alloc/free pair) — free before return
        return r;
    });
    assert.equalInt(r, 65);   // 'A'
}
