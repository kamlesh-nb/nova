import crypto.tls.13.tlsClient;
import bytes;
import assert;

fn hexNib(c: int): int {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    return 0;
}
fn hexBuf(hex: string): ptr {
    let n = hex.length / 2;
    let b = bytes.alloc(n);
    let i = 0;
    while (i < n) { bytes.write_byte(b, i, hexNib(hex[i * 2]) * 16 + hexNib(hex[i * 2 + 1])); i = i + 1; }
    return b;
}
fn eqHex(buf: ptr, n: int, hex: string): bool {
    if (hex.length != n * 2) { return false; }
    let i = 0;
    while (i < n) {
        let want = hexNib(hex[i * 2]) * 16 + hexNib(hex[i * 2 + 1]);
        if (bytes.read_byte(buf, i) != want) { return false; }
        i = i + 1;
    }
    return true;
}
fn findPattern(out: ptr, n: int, hex: string): int {
    let np = hexBuf(hex);
    let m = hex.length / 2;
    let i = 0;
    while (i + m <= n) {
        let j = 0;
        while (j < m && bytes.read_byte(out, i + j) == bytes.read_byte(np, j)) { j = j + 1; }
        if (j == m) { bytes.free(np); return i; }
        i = i + 1;
    }
    bytes.free(np);
    return 0 - 1;
}

const HRR: string = "020000340303cf21ad74e59a6111be1d8c021e65b891c2a211167abb8c5e079e09e2c8a8339c00130100000c002b00020304003300020017";

@test
fn hrr_detection(): void {
    assert.isTrue(tlsClient.isHelloRetryRequest(hexBuf(HRR)));
    let sh = bytes.alloc(64);
    bytes.write_byte(sh, 0, 0x02);
    assert.isTrue(!tlsClient.isHelloRetryRequest(sh));
}

const TH_AFTER_HRR: string = "7fa5da070c64824f9e38a8317718e256ad5604a50bed6c1fdf401775780d22e4";

@test
fn hrr_transcript_rewrite(): void {
    let c = tlsClient.newClient(bytes.alloc(32), bytes.alloc(32), bytes.alloc(48));
    c.addClientHello(hexBuf("000102030405060708090a0b0c0d0e0f10111213"), 20);
    let group = c.processHelloRetryRequest(hexBuf(HRR), 56);
    assert.equalInt(group, 0x0017);
    let th = bytes.alloc(32);
    c.transcriptHashInto(th);
    assert.isTrue(eqHex(th, 32, TH_AFTER_HRR));
}

const HRR_COOKIE: string = "0200003d0303cf21ad74e59a6111be1d8c021e65b891c2a211167abb8c5e079e09e2c8a8339c001301000015002b00020304003300020017002c00050003616263";

@test
fn hrr_cookie_captured(): void {
    let c = tlsClient.newClient(bytes.alloc(32), bytes.alloc(32), bytes.alloc(48));
    c.addClientHello(hexBuf("000102030405060708090a0b0c0d0e0f10111213"), 20);
    let group = c.processHelloRetryRequest(hexBuf(HRR_COOKIE), 65);
    assert.equalInt(group, 0x0017);
    assert.equalInt(c.hrrCookieSize(), 3);
    assert.isTrue(eqHex(c.hrrCookiePtr(), 3, "616263"));
}

@test
fn hrr_client_hello2(): void {
    let c = tlsClient.newClient(bytes.alloc(32), bytes.alloc(32), bytes.alloc(48));
    c.addClientHello(hexBuf("000102030405060708090a0b0c0d0e0f10111213"), 20);
    c.processHelloRetryRequest(hexBuf(HRR_COOKIE), 65);
    let rnd = bytes.alloc(32);
    let sid = bytes.alloc(32);
    let pk = bytes.alloc(32);
    let pkP = bytes.alloc(65); bytes.write_byte(pkP, 0, 4);
    let out = bytes.alloc(512);
    let noPsk = bytes.alloc(1);
    let n = tlsClient.buildClientHelloEx(rnd, sid, pk, pkP, bytes.alloc(97), "example.com", "", 2, c.hrrCookiePtr(), c.hrrCookieSize(), noPsk, 0, 0, 0, 0, out);
    assert.isTrue(findPattern(out, n, "003300470045001700410400000000") >= 0);
    assert.isTrue(findPattern(out, n, "002c00050003616263") >= 0);
}
