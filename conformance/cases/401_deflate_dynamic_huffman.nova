// The DEFLATE encoder emits DYNAMIC Huffman blocks (BTYPE=10) with a dual-hash LAZY matcher (Go flate
// level-6 model), choosing the smallest of stored/fixed/dynamic per block -- not fixed-Huffman greedy. Verify
// a byte-exact round trip and a strong ratio that only dynamic + good matching can reach.
import compress.deflate;
import string;
import assert;
@test
fn roundtrip_byte_exact(): void {
    let src = "";
    let i = 0;
    while (i < 200) { src = src + "the quick brown fox jumps over the lazy dog 12345 "; i = i + 1; }
    let comp = deflate.deflateRaw(src).toString();
    let back = deflate.inflate(comp).toString();
    assert.isTrue(string.eql(back, src));
    assert.isTrue(comp.length * 20 < src.length);   // >20x: dynamic Huffman + lazy matching
}
@test
fn tiny_and_incompressible_roundtrip(): void {
    let a = deflate.deflateRaw("hi").toString();
    assert.isTrue(string.eql(deflate.inflate(a).toString(), "hi"));
    let b = deflate.deflateRaw("").toString();
    assert.isTrue(string.eql(deflate.inflate(b).toString(), ""));
}
