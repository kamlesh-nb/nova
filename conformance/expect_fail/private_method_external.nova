// EXPECT-FAIL: typecheck
// A genuinely PRIVATE method (non-`pub`, and NOT implementing any trait method) must stay
// un-callable from outside its own struct. Guards the trait-contract visibility exception
// (gate 171 / methodIsTraitContract) against over-widening: only trait-method impls are
// promoted to public — a plain private helper called and let-bound externally must still be
// rejected. `secret` is not part of any trait the struct implements.

import assert;

struct S {
    pub x: int,
    init() { self.x = 0; }
    fn secret(self): int { return 42; }   // private helper, no trait
}

@test
fn t(): void {
    let s = S();
    let r = s.secret();                    // external call of a private method — must be rejected
    assert.equalInt(r, 42);
}
