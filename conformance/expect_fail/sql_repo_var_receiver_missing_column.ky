import data.db;
import data.repository;
import serde.json;
import serde.source;
import list;
@serializable struct Product { pub id: int, pub name: string }
async fn load(conn: db.Connection): void {
    let repo = repository.Repository<Product>(conn, "products");
    let p = list.List<db.DbValue>();
    let _ = await repo.query("SELECT id, naem FROM products", p);
}
fn main(): void {}
