// EXPECT-FAIL: typecheck
//
// `opt ?? Fallback().field` parses as `opt ?? (Fallback().field)`, so the
// accessor binds to the FALLBACK, not to the unwrapped optional. Here the
// present branch is a `Box` (a heap pointer) and the fallback branch is an
// `int`. That must be a type error: without it, codegen returns the present
// path's `Box` pointer REINTERPRETED as an `int` (a different value every run,
// classic pointer-as-scalar UB). The correct spelling parenthesises the unwrap:
// `(opt ?? fb()).v`. See the type_checker `nullish_coalesce` guard.
class Box {
    pub v: int,
    init(x: int) { self.v = x; }
}

fn present(): Box | undefined { return Box(7); }
fn fb(): Box { return Box(99); }

@test
fn coalesce_field_reinterpret(): void {
    let opt: Box | undefined = present();
    let n: int = opt ?? fb().v;
}
