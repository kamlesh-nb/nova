// A live TLS 1.3 server in pure Nova (no external crypto library), driving crypto/tls13server over a
// blocking socket. It accepts one connection, completes the handshake (signing its CertificateVerify with
// the Nova ECDSA-P256 signer), verifies the client Finished, and answers an HTTP request over the
// encrypted channel. Verified against openssl s_client:
//
//   nova examples/tls13_server.nova -o srv && ./srv
//   echo -e "GET / HTTP/1.0\r\n\r\n" | openssl s_client -connect 127.0.0.1:4433 -tls1_3 -quiet
import os.sys;
import net.reactorio;
import crypto.tls.13.tlsServer;
import crypto.random;
import bytes;

// Self-signed EC (P-256) server certificate and its raw private scalar (generated with OpenSSL).
const SRV_CERT: string = "";
const SRV_PRIV: string = "accfe82d31600d5810b9984176898804a4ba458216b1ac913231be5008ca82f1";

fn at(b: ptr, off: int): ptr { return (b as long + off) as ptr; }
fn logStr(s: string): void {
    let b = bytes.alloc(s.length + 1);
    let i = 0;
    while (i < s.length) { bytes.write_byte(b, i, s[i]); i = i + 1; }
    bytes.write_byte(b, s.length, 10);
    sys.write(1, b, (s.length + 1) as long);
    bytes.free(b);
}
fn hexNib(c: int): int {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    return 0;
}
fn hexBuf(hex: string): ptr {
    let n = hex.length / 2;
    let b = bytes.alloc(n);
    let i = 0;
    while (i < n) { bytes.write_byte(b, i, hexNib(hex[i * 2]) * 16 + hexNib(hex[i * 2 + 1])); i = i + 1; }
    return b;
}
fn fillRandom(buf: ptr, n: int): void {
    let s = random.randomBytes(n);
    let i = 0;
    while (i < n) { bytes.write_byte(buf, i, s[i] & 0xff); i = i + 1; }
}
fn readN(fd: int, buf: ptr, off: int, n: int): int {
    let got = 0;
    while (got < n) {
        let r = sys.read(fd, at(buf, off + got), (n - got) as long);
        if (r <= 0) { return -1; }
        got = got + (r as int);
    }
    return 0;
}
fn readRecord(fd: int, buf: ptr): int {
    if (readN(fd, buf, 0, 5) != 0) { return -1; }
    let len = (bytes.read_byte(buf, 3) << 8) | bytes.read_byte(buf, 4);
    if (readN(fd, buf, 5, len) != 0) { return -1; }
    return 5 + len;
}
fn writeAll(fd: int, buf: ptr, n: int): void {
    let sent = 0;
    while (sent < n) {
        let w = sys.write(fd, at(buf, sent), (n - sent) as long);
        if (w <= 0) { return; }
        sent = sent + (w as int);
    }
}
// Read the next record that is not a ChangeCipherSpec (0x14). Returns the record length or -1.
fn nextRealRecord(fd: int, buf: ptr): int {
    let m = readRecord(fd, buf);
    while (m > 0 && bytes.read_byte(buf, 0) == 0x14) { m = readRecord(fd, buf); }
    return m;
}

fn main(): int {
    let lfd = sys.socket(sys.AF_INET, sys.SOCK_STREAM, 0);
    let one = bytes.alloc(4); bytes.write_i32(one, 0, 1);
    sys.setsockopt(lfd, sys.SOL_SOCKET, 4, one, 4);          // SO_REUSEADDR
    let sa = sys.makeSockaddrIn(4433, reactorio.parseIPv4("127.0.0.1"));
    if (sys.bind(lfd, sa, 16) != 0) { logStr("bind failed"); return 1; }
    sys.listen(lfd, 16);
    logStr("Nova TLS 1.3 server listening on 127.0.0.1:4433");

    let addrBuf = bytes.alloc(16); let addrLen = bytes.alloc(4); bytes.write_i32(addrLen, 0, 16);
    let fd = sys.accept(lfd, addrBuf, addrLen);
    if (fd < 0) { logStr("accept failed"); return 1; }
    logStr("client connected");

    let buf = bytes.alloc(32768);
    let n = readRecord(fd, buf);
    if (n < 0 || bytes.read_byte(buf, 0) != 0x16) { logStr("no ClientHello"); return 1; }

    let ephPriv = bytes.alloc(32); fillRandom(ephPriv, 32);
    let ephPrivP = bytes.alloc(32); fillRandom(ephPrivP, 32);
    let srv = tlsServer.newServer(hexBuf(SRV_CERT), 421, hexBuf(SRV_PRIV), ephPriv, ephPrivP);
    srv.processClientHello(at(buf, 5), n - 5);

    // ServerHello.
    let sr = bytes.alloc(32); fillRandom(sr, 32);
    let sh = bytes.alloc(1024);
    let shLen = srv.buildServerHello(sr, sh);
    let rec = bytes.alloc(shLen + 5);
    bytes.write_byte(rec, 0, 0x16); bytes.write_byte(rec, 1, 0x03); bytes.write_byte(rec, 2, 0x03);
    bytes.write_byte(rec, 3, (shLen >> 8) & 0xff); bytes.write_byte(rec, 4, shLen & 0xff);
    let i = 0;
    while (i < shLen) { bytes.write_byte(rec, 5 + i, bytes.read_byte(sh, i)); i = i + 1; }
    writeAll(fd, rec, shLen + 5);
    writeAll(fd, hexBuf("140303000101"), 6);                 // dummy ChangeCipherSpec

    // Encrypted flight (EncryptedExtensions, Certificate, CertificateVerify, Finished).
    let flight = bytes.alloc(8192);
    let fLen = srv.buildFlight(flight);
    writeAll(fd, flight, fLen);
    logStr("sent ServerHello + certificate flight");

    // Client Finished.
    let m = nextRealRecord(fd, buf);
    if (m < 0 || !srv.processClientFinished(buf, m)) { logStr("client Finished FAILED"); return 1; }
    logStr("handshake complete: client Finished verified");

    // Read the client's request and answer over the encrypted channel.
    let out = bytes.alloc(32768);
    let m2 = nextRealRecord(fd, buf);
    if (m2 > 0) { srv.decryptApp(buf, m2, out); }
    logStr("got encrypted request; sending response");

    let resp = "HTTP/1.0 200 OK\r\nContent-Type: text/plain\r\n\r\nHello from a pure-Nova TLS 1.3 server!\n";
    let respBuf = bytes.alloc(resp.length);
    i = 0;
    while (i < resp.length) { bytes.write_byte(respBuf, i, resp[i]); i = i + 1; }
    let app = bytes.alloc(resp.length + 64);
    let aLen = srv.encryptApp(respBuf, resp.length, app);
    writeAll(fd, app, aLen);

    sys.close(fd); sys.close(lfd);
    logStr("done");
    return 0;
}
