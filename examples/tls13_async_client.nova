// A reactor-async TLS 1.3 client in pure Nova: the handshake and application I/O run non-blocking on a
// Nova reactor coroutine (no thread held while waiting on the network), via net/tls13async over the
// crypto/tls13client state machine. Verified live against `openssl s_server -tls1_3 -www`.
//
//   openssl s_server -accept 127.0.0.1:4433 -cert cert.pem -key key.pem -tls1_3 -www
//   nova examples/tls13_async_client.nova -o c && ./c
import net.reactor;
import net.reactorio;
import net.tls13async;
import crypto.tls.13.tlsClient;
import crypto.ecc.x25519;
import crypto.random;
import os.sys;
import bytes;

fn fillRandom(buf: ptr, n: int): void {
    let s = random.randomBytes(n);
    let i = 0;
    while (i < n) { bytes.write_byte(buf, i, s[i] & 0xff); i = i + 1; }
}
fn base9(): ptr {
    let b = bytes.alloc(32);
    bytes.write_byte(b, 0, 9);
    let i = 1;
    while (i < 32) { bytes.write_byte(b, i, 0); i = i + 1; }
    return b;
}

// The reactor coroutine: connect, handshake, GET, print the response, then signal `done`.
async fn run(done: ptr): int {
    let kq = reactor.currentKq();
    let rs = await reactorio.reactorConnect("127.0.0.1", 4433, kq);
    if (rs.fdOf() < 0) { console.log("connect failed"); bytes.write_byte(done, 0, 1); return 1; }
    console.log("connected (reactor coroutine)");

    let io = tls13async.newIO(rs.fdOf(), kq);
    let priv = bytes.alloc(32); fillRandom(priv, 32);
    let epub = bytes.alloc(32); x25519.scalarMult(epub, priv, base9());
    let cl = tlsClient.newClient(priv);

    if (await tls13async.handshake(io, cl, epub, "localhost") < 0) {
        console.log("handshake FAILED"); bytes.write_byte(done, 0, 1); return 1;
    }
    console.log("async TLS 1.3 handshake complete + server verified");

    let req = "GET / HTTP/1.0\r\nHost: localhost\r\nConnection: close\r\n\r\n";
    let reqBuf = bytes.alloc(req.length);
    let i = 0;
    while (i < req.length) { bytes.write_byte(reqBuf, i, req[i]); i = i + 1; }
    await tls13async.write(io, cl, reqBuf, req.length);
    console.log("sent encrypted HTTP request");

    let out = bytes.alloc(33792);
    let got = await tls13async.read(io, cl, out);
    if (got > 0) {
        console.log("--- decrypted application data (first 200 bytes) ---");
        let show = got;
        if (show > 200) { show = 200; }
        sys.write(1, out, show as long);
        sys.write(1, base9(), 0);   // no-op flush guard
    }
    sys.close(rs.fdOf());
    bytes.write_byte(done, 0, 1);
    return 0;
}

fn main(): int {
    let r = reactor.Reactor(1024, 16384, 1024);
    reactor.setCurrent(r.kq);
    let done = bytes.alloc(1); bytes.write_byte(done, 0, 0);
    coroStart(run(done));
    while (bytes.read_byte(done, 0) == 0) {
        let n = r.poll(2000);
        reactor.batchBegin();
        let i = 0;
        while (i < n) { nova_reactor_resume(r.readyToken(i)); i = i + 1; }
        if (n == 0) { bytes.write_byte(done, 0, 1); }   // 2s idle timeout guard
    }
    console.log("done");
    return 0;
}
