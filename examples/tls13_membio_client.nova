// A live TLS 1.3 client over the pure-Nova memory-BIO (net/tlsmembio), driven over a blocking socket.
// Completes a real handshake against openssl s_server and decrypts the HTTP response. This is the same
// TlsBio that net/asynctls pumps on the reactor; here it is driven synchronously for a self-contained demo.
//
//   openssl s_server -accept 127.0.0.1:4433 -cert ec.crt -key ec.key -tls1_3 -www -quiet
//   nova examples/tls13_membio_client.nova -o mbcli && ./mbcli
import os.sys;
import net.eventedio;
import net.tlsmembio;
import bytes;

fn at(b: ptr, off: int): ptr { return (b as long + off) as ptr; }
fn logS(s: string): void { let b=bytes.alloc(s.length+1); let i=0; while(i<s.length){bytes.write_byte(b,i,s[i]);i=i+1;} bytes.write_byte(b,s.length,10); sys.write(1,b,(s.length+1) as long); bytes.free(b); }

fn main(): int {
    let fd = sys.socket(sys.AF_INET, sys.SOCK_STREAM, 0);
    let sa = sys.makeSockaddrIn(4433, eventedio.parseIPv4("127.0.0.1"));
    if (sys.connect(fd, sa, 16) != 0) { logS("connect failed"); return 1; }
    let cb: tlsmembio.TlsBio = tlsmembio.newClientBio("localhost");
    let tmp = bytes.alloc(33792);
    let rx = bytes.alloc(33792);

    // Handshake pump.
    let done = false;
    let guard = 0;
    while (!done && guard < 50) {
        while (cb.pendingOut() > 0) { let n = cb.pull(tmp, 33792); sys.write(fd, tmp, n as long); }
        let st = cb.step();
        if (st == 0) { done = true; }
        else if (st < 0) { logS("handshake FAILED"); return 1; }
        else {
            let r = sys.read(fd, rx, 33792);
            if (r <= 0) { logS("read EOF in handshake"); return 1; }
            cb.feed(rx, r as int);
        }
        guard = guard + 1;
    }
    if (!done) { logS("handshake did not complete"); return 1; }
    logS("pure-Nova TLS 1.3 handshake complete vs openssl s_server");

    // Send an HTTP request over the encrypted channel.
    let req = "GET / HTTP/1.0\r\nHost: localhost\r\n\r\n";
    let rb = bytes.alloc(req.length); let i = 0;
    while (i < req.length) { bytes.write_byte(rb, i, req[i]); i = i + 1; }
    cb.writeApp(rb, req.length);
    while (cb.pendingOut() > 0) { let n = cb.pull(tmp, 33792); sys.write(fd, tmp, n as long); }

    // Read the response.
    let out = bytes.alloc(33792);
    let got = 0;
    while (got < 40) {
        let plen = cb.readApp(out, 33792);
        if (plen > 0) {
            logS("--- decrypted response (first line) ---");
            let show = plen; if (show > 60) { show = 60; }
            sys.write(1, out, show as long);
            return 0;
        }
        let r = sys.read(fd, rx, 33792);
        if (r <= 0) { return 0; }
        cb.feed(rx, r as int);
        got = got + 1;
    }
    return 0;
}
