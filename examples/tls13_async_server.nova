// A reactor-async TLS 1.3 server in pure Nova: accepts a connection on the reactor, runs the handshake
// (signing its CertificateVerify with the Nova ECDSA signer) and answers over the encrypted channel, all
// non-blocking on a reactor coroutine. Verified live against openssl s_client:
//
//   nova examples/tls13_async_server.nova -o asrv && ./asrv
//   echo -e "GET / HTTP/1.0\r\n\r\n" | openssl s_client -connect 127.0.0.1:4433 -tls1_3 -quiet
import net.reactor;
import net.reactorio;
import net.tls13async;
import crypto.tls13server;
import crypto.random;
import os.sys;
import bytes;

const SRV_CERT: string = "";
const SRV_PRIV: string = "accfe82d31600d5810b9984176898804a4ba458216b1ac913231be5008ca82f1";

fn hexNib(c: int): int {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    return 0;
}
fn hexBuf(hex: string): ptr {
    let n = hex.length / 2;
    let b = bytes.alloc(n);
    let i = 0;
    while (i < n) { bytes.write_byte(b, i, hexNib(hex[i * 2]) * 16 + hexNib(hex[i * 2 + 1])); i = i + 1; }
    return b;
}
fn fillRandom(buf: ptr, n: int): void {
    let s = random.randomBytes(n);
    let i = 0;
    while (i < n) { bytes.write_byte(buf, i, s[i] & 0xff); i = i + 1; }
}

async fn serveOne(lfd: int, kq: int, done: ptr): int {
    let rs = await reactorio.reactorAccept(lfd, kq);
    if (rs.fdOf() < 0) { console.log("accept failed"); bytes.write_byte(done, 0, 1); return 1; }
    console.log("client connected (reactor coroutine)");

    let io = tls13async.newIO(rs.fdOf(), kq);
    let ephPriv = bytes.alloc(32); fillRandom(ephPriv, 32);
    let srv = tls13server.newServer(hexBuf(SRV_CERT), 421, hexBuf(SRV_PRIV), ephPriv);
    let sr = bytes.alloc(32); fillRandom(sr, 32);

    if (await tls13async.serveHandshake(io, srv, sr) < 0) {
        console.log("handshake FAILED"); bytes.write_byte(done, 0, 1); return 1;
    }
    console.log("async TLS 1.3 handshake complete + client Finished verified");

    let out = bytes.alloc(32768);
    let got = await tls13async.serverRead(io, srv, out);
    console.log("got encrypted request; sending response");

    let resp = "HTTP/1.0 200 OK\r\nContent-Type: text/plain\r\n\r\nHello from a reactor-async pure-Nova TLS 1.3 server!\n";
    let rb = bytes.alloc(resp.length);
    let i = 0;
    while (i < resp.length) { bytes.write_byte(rb, i, resp[i]); i = i + 1; }
    await tls13async.serverWrite(io, srv, rb, resp.length);

    sys.close(rs.fdOf());
    bytes.write_byte(done, 0, 1);
    return 0;
}

fn main(): int {
    let lfd = sys.socket(sys.AF_INET, sys.SOCK_STREAM, 0);
    let one = bytes.alloc(4); bytes.write_i32(one, 0, 1);
    sys.setsockopt(lfd, sys.SOL_SOCKET, 4, one, 4);          // SO_REUSEADDR
    let sa = sys.makeSockaddrIn(4433, reactorio.parseIPv4("127.0.0.1"));
    if (sys.bind(lfd, sa, 16) != 0) { console.log("bind failed"); return 1; }
    sys.listen(lfd, 16);
    sys.setNonBlocking(lfd);
    console.log("Nova reactor-async TLS 1.3 server listening on 127.0.0.1:4433");

    let r = reactor.Reactor(1024, 16384, 1024);
    reactor.setCurrent(r.kq);
    let done = bytes.alloc(1); bytes.write_byte(done, 0, 0);
    coroStart(serveOne(lfd, r.kq, done));
    while (bytes.read_byte(done, 0) == 0) {
        let n = r.poll(5000);
        reactor.batchBegin();
        let i = 0;
        while (i < n) { nova_reactor_resume(r.readyToken(i)); i = i + 1; }
        if (n == 0) { bytes.write_byte(done, 0, 1); }
    }
    console.log("done");
    return 0;
}
