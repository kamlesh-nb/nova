
import bytes;
import mem.allocator;
import collections.list;
import os.sys;

// Directory I/O in Nova over the raw POSIX syscalls in os/sys (M5). A Dir holds an open DIR*
// from opendir; read walks it with readdir, reading the entry name out of struct dirent.
pub struct Dir {
    pub handle: ptr,
    pub path: string,
    pub allocator: allocator.Allocator,

    pub fn open(path: string): Dir {
        let d = bytes.new_with_allocator<Dir>(allocator.globalAllocator());
        d.allocator = allocator.globalAllocator();
        d.path = path;
        let cp = sys.cstr(path);
        d.handle = sys.opendir(cp);
        bytes.free(cp);
        return d;
    }

    pub fn read(self: Dir): string | undefined {
        if (self.handle == 0) {
            return undefined;
        }
        let ent = sys.readdir(self.handle);
        if (ent == 0) {
            return undefined;
        }

        // struct dirent: the NUL-terminated d_name starts at offset 21 on macOS/BSD.
        let clen = 0;
        while (bytes.read_byte(ent, 21 + clen) != 0) {
            clen = clen + 1;
        }

        let buf = allocator.globalAllocator().alloc(clen);
        let i = 0;
        while (i < clen) {
            bytes.write_byte(buf, i, bytes.read_byte(ent, 21 + i));
            i = i + 1;
        }
        return buf as string;
    }

    pub fn entries(self: Dir): List<string> {
        let result = List<string>();
        while (true) {
            let entry = self.read();
            if (entry == undefined) {
                break;
            }
            result.push(entry ?? "");
        }
        return result;
    }

    pub fn close(self: Dir): void {
        if (self.handle != 0) {
            sys.closedir(self.handle);
        }
        self.handle = 0;
    }

    pub fn create(path: string, mode: int): int {
        let cp = sys.cstr(path);
        let r = sys.mkdir(cp, mode);
        bytes.free(cp);
        return r;
    }

    pub fn remove(path: string): int {
        let cp = sys.cstr(path);
        let r = sys.rmdir(cp);
        bytes.free(cp);
        return r;
    }

    pub fn rename(oldPath: string, newPath: string): int {
        let a = sys.cstr(oldPath);
        let b = sys.cstr(newPath);
        let r = sys.rename(a, b);
        bytes.free(a);
        bytes.free(b);
        return r;
    }

    pub fn exists(path: string): bool {
        return sys.pathIsDir(path);
    }

    pub fn isDir(path: string): bool {
        return sys.pathIsDir(path);
    }

    pub fn getCwd(): string {
        let buf = bytes.alloc(4096);
        let r = sys.getcwd(buf, 4096);
        if (r == 0) {
            bytes.free(buf);
            return "";
        }

        let clen = 0;
        while (bytes.read_byte(buf, clen) != 0) {
            clen = clen + 1;
        }

        let out = allocator.globalAllocator().alloc(clen);
        let i = 0;
        while (i < clen) {
            bytes.write_byte(out, i, bytes.read_byte(buf, i));
            i = i + 1;
        }
        bytes.free(buf);
        return out as string;
    }

    pub fn chdir(path: string): int {
        let cp = sys.cstr(path);
        let r = sys.chdir(cp);
        bytes.free(cp);
        return r;
    }

    // A writable temporary directory, without a trailing separator: TMPDIR (the POSIX convention,
    // always set on macOS), then TEMP/TMP (always set on Windows), then the POSIX default. Callers
    // build paths from this instead of hardcoding "/tmp", which does not exist on Windows — Win32
    // resolves a leading "/" against the current drive root, so "/tmp/x" silently means "C:\tmp\x".
    pub fn tempDir(): string {
        let t = envDir("TMPDIR");
        if (t.length > 0) { return t; }
        t = envDir("TEMP");
        if (t.length > 0) { return t; }
        t = envDir("TMP");
        if (t.length > 0) { return t; }
        return "/tmp";
    }
}

// One environment variable as a Nova string, with any trailing '/' or '\' trimmed so callers can
// always join with a single separator. "" when unset.
fn envDir(name: string): string {
    let cp = sys.cstr(name);
    let v = sys.getenv(cp);
    bytes.free(cp);
    if (v == 0) {
        return "";
    }

    let clen = 0;
    while (bytes.read_byte(v, clen) != 0) {
        clen = clen + 1;
    }
    while (clen > 0) {
        let last = bytes.read_byte(v, clen - 1);
        if (last != 47 && last != 92) { break; }   // '/' '\'
        clen = clen - 1;
    }

    let out = allocator.globalAllocator().alloc(clen);
    let i = 0;
    while (i < clen) {
        bytes.write_byte(out, i, bytes.read_byte(v, i));
        i = i + 1;
    }
    return out as string;
}
