// map.nova — Generic hash map (open addressing, linear probing, dynamic resize)
import bytes;
import list;
import string;
import assert;

const TOMBSTONE_SIZE: int = 1;
const LOAD_FACTOR_MAX: float = 0.75;

fn allocZero(size: int): ptr {
    let ptr = bytes.alloc_persistent(size);
    let i = 0;
    while (i < size) {
        bytes.write_byte(ptr, i, 0);
        i = i + 1;
    }
    return ptr;
}

fn nextPowerOfTwo(n: int): int {
    let v = n - 1;
    v = v | (v >> 1);
    v = v | (v >> 2);
    v = v | (v >> 4);
    v = v | (v >> 8);
    v = v | (v >> 16);
    return v + 1;
}

pub struct Map<K, V> {
    pub cap: int,
    pub len: int,
    // `Storage<K>`/`Storage<V>`, not raw ints: ARC releases a TYPED field, and the
    // generated `__destruct_Storage_K` releases the slots. That is what lets the
    // CALL-SITE retain (`retainIfGenericStore`) be deleted — Map was the last thing
    // depending on it to take ownership of what it stores.
    pub keys: Storage<K>,
    pub vals: Storage<V>,
    pub tombstones: ptr,
    pub hashFn: (K) -> int,

    init(initialCap: int, hashFn: (K) -> int) {
        let cap = if (initialCap <= 0) 8 else nextPowerOfTwo(initialCap);
        let ps = bytes.ptr_size();
        self.cap = cap;
        self.len = 0;
        self.keys = Storage<K>(cap);
        self.vals = Storage<V>(cap);
        self.tombstones = allocZero(cap);
        self.hashFn = hashFn;
    }

    fn keysEqual(self: Map<K, V>, a: K, b: K): bool {
        if (self.hashFn == string.hash) {
            return string.eql(a, b);
        }
        return a == b;
    }

    pub fn set(self: Map<K, V>, key: K, value: V): void {
        if ((self.len + 1) * 4 > self.cap * 3) {
            self.resize();
        }

        let ps = bytes.ptr_size();
        let hash = (self.hashFn)(key);
        let idx = hash & (self.cap - 1);
        let startIdx = idx;
        let firstTombstone = -1;

        while (true) {
            let tomb = bytes.read_byte(self.tombstones, idx);
            if (tomb == 1) {
                if (firstTombstone == -1) {
                    firstTombstone = idx;
                }
            } else {
                let curKey = self.keys.get(idx);
                if (curKey == 0) {
                    let insertIdx = if (firstTombstone != -1) firstTombstone else idx;
                    self.keys.set(insertIdx, key);
                    self.vals.set(insertIdx, value);
                    bytes.write_byte(self.tombstones, insertIdx, 0);
                    self.len = self.len + 1;
                    return;
                }
                if (self.keysEqual(curKey, key)) {
                    self.vals.set(idx, value);
                    return;
                }
            }
            idx = (idx + 1) & (self.cap - 1);
            if (idx == startIdx) {
                // Scanned the whole table without finding an empty slot or a
                // matching key. Reuse a tombstone if we saw one; otherwise the
                // table is saturated with live entries — grow and retry. This
                // prevents the infinite loop under insert/delete churn.
                if (firstTombstone != -1) {
                    self.keys.set(firstTombstone, key);
                    self.vals.set(firstTombstone, value);
                    bytes.write_byte(self.tombstones, firstTombstone, 0);
                    self.len = self.len + 1;
                    return;
                }
                self.resize();
                self.set(key, value);
                return;
            }
        }
    }

    pub fn get(self: Map<K, V>, key: K): V | undefined {
        if (self.len == 0) {
            return undefined;
        }
        let ps = bytes.ptr_size();
        let hash = (self.hashFn)(key);
        let idx = hash & (self.cap - 1);
        let startIdx = idx;

        while (true) {
            let tomb = bytes.read_byte(self.tombstones, idx);
            if (tomb == 0) {
                let curKey = self.keys.get(idx);
                if (curKey == 0) {
                    return undefined;
                }
                if (self.keysEqual(curKey, key)) {
                    return self.vals.get(idx);
                }
            }
            idx = (idx + 1) & (self.cap - 1);
            if (idx == startIdx) {
                return undefined;
            }
        }
    }

    /// Keyed access that returns `V` directly (not `V | undefined`). Use when the key is
    /// known present — `get` requires `?.`/`??` on every access. A missing key is a LOUD
    /// located abort, never a silent read. For a maybe-absent key, use `get`.
    pub fn at(self: Map<K, V>, key: K): V {
        if (self.len != 0) {
            let hash = (self.hashFn)(key);
            let idx = hash & (self.cap - 1);
            let startIdx = idx;
            while (true) {
                let tomb = bytes.read_byte(self.tombstones, idx);
                if (tomb == 0) {
                    let curKey = self.keys.get(idx);
                    if (curKey == 0) {
                        break;
                    }
                    if (self.keysEqual(curKey, key)) {
                        return self.vals.get(idx);
                    }
                }
                idx = (idx + 1) & (self.cap - 1);
                if (idx == startIdx) {
                    break;
                }
            }
        }
        nova_panic("Map.at: key not found");
        return self.vals.get(0); // unreachable — nova_panic exits; satisfies the V return type
    }

    pub fn delete_key(self: Map<K, V>, key: K): bool {
        if (self.len == 0) {
            return false;
        }
        let ps = bytes.ptr_size();
        let hash = (self.hashFn)(key);
        let idx = hash & (self.cap - 1);
        let startIdx = idx;

        while (true) {
            let tomb = bytes.read_byte(self.tombstones, idx);
            if (tomb == 0) {
                let curKey = self.keys.get(idx);
                if (curKey == 0) {
                    return false;
                }
                if (self.keysEqual(curKey, key)) {
                    self.keys.set(idx, 0);
                    self.vals.set(idx, 0);
                    bytes.write_byte(self.tombstones, idx, 1);
                    self.len = self.len - 1;
                    return true;
                }
            }
            idx = (idx + 1) & (self.cap - 1);
            if (idx == startIdx) {
                return false;
            }
        }
    }

    pub fn has(self: Map<K, V>, key: K): bool {
        let val = self.get(key);
        return val != undefined;
    }

    pub fn size(self: Map<K, V>): int {
        return self.len;
    }

    pub fn forEach(self: Map<K, V>, fn: (K, V) => void): void {
        let ps = bytes.ptr_size();
        let i = 0;
        while (i < self.cap) {
            let tomb = bytes.read_byte(self.tombstones, i);
            if (tomb == 0) {
                let key = self.keys.get(i);
                if (key != 0) {
                    let val = self.vals.get(i);
                    fn(key, val);
                }
            }
            i = i + 1;
        }
    }

    pub fn keys(self: Map<K, V>): list.List<K> {
        let result = list.List<K>();
        self.forEach((k, v) => result.push(k));
        return result;
    }

    pub fn values(self: Map<K, V>): list.List<V> {
        let result = list.List<V>();
        self.forEach((k, v) => result.push(v));
        return result;
    }

    fn resize(self: Map<K, V>): void {
        let ps = bytes.ptr_size();
        let oldCap = self.cap;
        let oldKeys = self.keys;
        let oldVals = self.vals;
        let oldTombstones = self.tombstones;
        let oldHashFn = self.hashFn;

        let newCap = oldCap * 2;
        let newKeys = Storage<K>(newCap);
        let newVals = Storage<V>(newCap);
        let newTombstones = allocZero(newCap);

        let i = 0;
        while (i < oldCap) {
            let tomb = bytes.read_byte(oldTombstones, i);
            if (tomb == 0) {
                let key = oldKeys.get(i);
                if (key != 0) {
                    let val = oldVals.get(i);
                    let hash = (oldHashFn)(key);
                    let idx = hash & (newCap - 1);
                    while (true) {
                        let nt = bytes.read_byte(newTombstones, idx);
                        if (nt == 0) {
                            let cur = newKeys.get(idx);
                            if (cur == 0) {
                                newKeys.set(idx, key);
                                newVals.set(idx, val);
                                bytes.write_byte(newTombstones, idx, 0);
                                break;
                            }
                        }
                        idx = (idx + 1) & (newCap - 1);
                    }
                }
            }
            i = i + 1;
        }

        // The old Storages are NOT freed by hand: `oldKeys`/`oldVals` are locals of
        // an owned type, so ARC releases them at scope exit — and their slots with
        // them. `tombstones` is a raw BYTE array (flags, not elements), so `bytes`
        // remains the right primitive for it and it is still freed explicitly.
        if (oldTombstones != 0) bytes.free(oldTombstones);

        self.cap = newCap;
        self.keys = newKeys;
        self.vals = newVals;
        self.tombstones = newTombstones;
    }

    // `delete()` is GONE for keys/vals: they are `Storage<K>`/`Storage<V>` typed
    // fields, so ARC releases them and their slots. `tombstones` is a raw byte array
    // and has no owner, which is the one thing left for a hook — kept private and
    // called only by ARC, never by hand.
    fn delete(self: Map<K, V>): void {
        if (self.tombstones != 0) {
            bytes.free(self.tombstones);
            self.tombstones = 0;
        }
    }
}

@test
fn test_map(): void {
    let map = Map<string, int>(16, string.hash);
    assert.equalInt(0, map.size());

    map.set("alice", 100);
    map.set("bob", 200);
    assert.equalInt(2, map.size());

    assert.equalInt(100, map.get("alice") ?? 0);
    assert.equalInt(200, map.get("bob") ?? 0);
    assert.isTrue(map.has("alice"));
    assert.isFalse(map.has("charlie"));

    map.delete_key("alice");
    assert.equalInt(1, map.size());
    assert.isFalse(map.has("alice"));
}