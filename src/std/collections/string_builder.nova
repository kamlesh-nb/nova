
import bytes;
import assert;

pub class StringBuilder {
    pub buf: ptr,
    pub len: int,
    pub cap: int,

    init() {
        self.cap = 16;
        self.len = 0;
        self.buf = bytes.alloc_persistent_nz(16);
    }

    pub fn append(self: StringBuilder, s: string): void {
        let slen = s.length;
        if (slen == 0) return;
        self.ensureCapacity(self.len + slen);
        // Bulk memcpy the string's bytes in at the write cursor. The old per-byte loop made append O(n)
        // Nova calls and was the response-render throughput ceiling. `(buf as long)+(len as long)` keeps
        // the destination address 64-bit (an int add would truncate a >4GB heap address).
        bytes.copy((self.buf as long) + (self.len as long), s as long, slen);
        self.len = self.len + slen;
    }

    pub fn appendChar(self: StringBuilder, c: int): void {
        self.ensureCapacity(self.len + 1);
        bytes.write_byte(self.buf, self.len, c);
        self.len = self.len + 1;
    }

    // Append the byte range [start, end) of `s` WITHOUT allocating an intermediate substring. Used by the
    // escape-into-builder path so a `{expr}` interpolation writes its clean runs straight into the render
    // buffer -- no per-interpolation string allocation. `(s as long)+start` keeps the source address 64-bit.
    pub fn appendRange(self: StringBuilder, s: string, start: int, end: int): void {
        let n = end - start;
        if (n <= 0) return;
        self.ensureCapacity(self.len + n);
        bytes.copy((self.buf as long) + (self.len as long), (s as long) + (start as long), n);
        self.len = self.len + n;
    }

    // Append `n` raw bytes from an arbitrary source address (a BORROWED slice — a StrView / DB row buffer),
    // not an owned Nova string. The caller guarantees `srcPtr` stays valid for the copy. This is the sink
    // for the P10 borrowed-string path: the render copies clean bytes straight out of a borrowed buffer
    // into the output, minting NO owned intermediate string.
    pub fn appendBytes(self: StringBuilder, srcPtr: long, n: int): void {
        if (n <= 0) return;
        self.ensureCapacity(self.len + n);
        bytes.copy((self.buf as long) + (self.len as long), srcPtr, n);
        self.len = self.len + n;
    }

    pub fn toString(self: StringBuilder): string {
        if (self.len == 0) return "";

        let sptr = bytes.alloc_persistent_nz(self.len);
        bytes.copy(sptr as long, self.buf as long, self.len);
        return sptr as string;
    }

    pub fn ensureCapacity(self: StringBuilder, minCap: int): void {
        if (minCap <= self.cap) return;
        let newCap = self.cap * 2;
        if (newCap < minCap) newCap = minCap;
        let newBuf = bytes.alloc_persistent_nz(newCap);
        bytes.copy(newBuf as long, self.buf as long, self.len);
        if (self.buf != 0) {
            bytes.free(self.buf);
        }
        self.buf = newBuf;
        self.cap = newCap;
    }

    pub fn delete(self: StringBuilder): void {
        if (self.buf != 0) {
            bytes.free(self.buf);
            self.buf = 0;
        }
    }
}

@test
fn test_string_builder(): void {
    let sb = StringBuilder();
    sb.append("hello");
    sb.append(" ");
    sb.append("world");
    let res = sb.toString();
    assert.isTrue(res == "hello world");
}
