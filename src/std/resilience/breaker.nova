// breaker.nova — a circuit breaker: a pure resilience state machine reusable by ANY caller
// that talks to a flaky dependency (an HTTP upstream, a database, a queue). Extracted here so
// neither `web` nor `data` has to depend on the other to get it — it needs only a millisecond
// clock.
//
//   CLOSED     — calls pass; N consecutive failures -> OPEN.
//   OPEN       — calls fail fast; after timeoutMs -> HALF_OPEN (one probe window).
//   HALF_OPEN  — calls pass; M successes -> CLOSED; any failure -> OPEN.
//
// A breaker turns "hammer a dead dependency, and hang every caller for the full timeout each
// time" into "fail fast immediately, then probe for recovery" — the natural complement to the
// per-op timeouts + connection pool.
import datetime;

pub const STATE_CLOSED: int = 0;
pub const STATE_OPEN: int = 1;
pub const STATE_HALF_OPEN: int = 2;

fn nowMs(): long {
    return datetime.nowNs() / 1000000;
}

pub struct CircuitBreaker {
    pub state: int,
    pub failureCount: int,
    pub successCount: int,
    pub lastStateChange: long, // ms

    pub failureThreshold: int,
    pub successThreshold: int,
    pub timeoutMs: long,

    init(failureThreshold: int, successThreshold: int, timeoutMs: long) {
        self.state = STATE_CLOSED;
        self.failureCount = 0;
        self.successCount = 0;
        self.lastStateChange = nowMs();
        self.failureThreshold = failureThreshold;
        self.successThreshold = successThreshold;
        self.timeoutMs = timeoutMs;
    }

    /// Whether a call may proceed. OPEN fails fast until the cooldown elapses, then probes.
    pub fn shouldAllow(self: CircuitBreaker): bool {
        if (self.state == STATE_CLOSED) { return true; }
        if (self.state == STATE_HALF_OPEN) { return true; }
        // OPEN
        let elapsed = nowMs() - self.lastStateChange;
        if (elapsed >= self.timeoutMs) {
            self.state = STATE_HALF_OPEN;
            self.failureCount = 0;
            self.successCount = 0;
            self.lastStateChange = nowMs();
            return true;
        }
        return false;
    }

    pub fn recordSuccess(self: CircuitBreaker): void {
        if (self.state == STATE_HALF_OPEN) {
            self.successCount = self.successCount + 1;
            if (self.successCount >= self.successThreshold) {
                self.state = STATE_CLOSED;
                self.failureCount = 0;
                self.successCount = 0;
                self.lastStateChange = nowMs();
            }
        } else {
            // CLOSED or OPEN: a success clears the failure streak.
            self.failureCount = 0;
        }
    }

    pub fn recordFailure(self: CircuitBreaker): void {
        self.failureCount = self.failureCount + 1;
        if (self.state == STATE_CLOSED) {
            if (self.failureCount >= self.failureThreshold) {
                self.state = STATE_OPEN;
                self.lastStateChange = nowMs();
            }
        } else if (self.state == STATE_HALF_OPEN) {
            // A failed probe re-opens immediately.
            self.state = STATE_OPEN;
            self.successCount = 0;
            self.lastStateChange = nowMs();
        } else {
            // OPEN: refresh the cooldown window.
            self.lastStateChange = nowMs();
        }
    }

    pub fn getState(self: CircuitBreaker): int {
        return self.state;
    }

    pub fn reset(self: CircuitBreaker): void {
        self.state = STATE_CLOSED;
        self.failureCount = 0;
        self.successCount = 0;
        self.lastStateChange = nowMs();
    }
}
