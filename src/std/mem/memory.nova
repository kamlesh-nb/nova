// mem.memory: raw bulk memory primitives over addresses (`long`), the memcpy/memmove/memset/memcmp/memchr
// family, plus the generic dealloc. Addresses are the low-level pointer values returned by `bytes.alloc`,
// `RawBuffer.base()`, and the like. All lengths are byte counts. These are thin, checked wrappers over the
// runtime's libc-backed primitives; a null address or a non-positive length is a safe no-op.
import bytes;

extern("c") fn nova_bytes_copy(dst: long, src: long, len: long): void;
extern("c") fn nova_mem_set(dst: long, byteVal: long, len: long): void;
extern("c") fn nova_mem_cmp(a: long, b: long, len: long): long;
extern("c") fn nova_mem_find(p: long, byteVal: long, len: long): long;

// Copy `len` bytes from `src` to `dst`. Overlap-safe (backed by memmove), so it doubles as `move`.
pub fn copy(dst: long, src: long, len: long): void { nova_bytes_copy(dst, src, len); }

// Explicit overlap-safe move (same guarantee as copy; named for intent at call sites).
pub fn move(dst: long, src: long, len: long): void { nova_bytes_copy(dst, src, len); }

// Set `len` bytes at `dst` to the low 8 bits of `byteVal`.
pub fn set(dst: long, byteVal: int, len: long): void { nova_mem_set(dst, byteVal as long, len); }

// Zero `len` bytes at `dst`.
pub fn zero(dst: long, len: long): void { nova_mem_set(dst, 0 as long, len); }

// Compare `len` bytes: negative if a < b, 0 if equal, positive if a > b (memcmp semantics).
pub fn compare(a: long, b: long, len: long): int { return nova_mem_cmp(a, b, len) as int; }

// Whether the first `len` bytes at `a` and `b` are byte-for-byte equal.
pub fn equal(a: long, b: long, len: long): bool { return nova_mem_cmp(a, b, len) == (0 as long); }

// Offset of the first byte equal to the low 8 bits of `byteVal` within `len` bytes at `p`, or -1.
pub fn find(p: long, byteVal: int, len: long): long { return nova_mem_find(p, byteVal as long, len); }

pub fn dealloc<T>(obj: T): void {
    bytes.free(obj);
}
