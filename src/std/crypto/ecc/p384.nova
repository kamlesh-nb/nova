// NIST P-384 (secp384r1) ECDH, implemented in Nova with no external library (M12-B).
//
// A 12-limb (32-bit, little-endian) sibling of crypto/ecc/p256: the base field GF(p), p = 2^384 - 2^128
// - 2^96 + 2^32 - 1, uses the same CIOS Montgomery multiply (Montgomery n0' = -p^-1 mod 2^32 = 1 for
// this modulus, as for P-256). Field elements are twelve 32-bit limbs in a 96-byte buffer, fully reduced
// to [0, p). Point arithmetic reuses the a = -3 short-Weierstrass Jacobian double/add formulas (identical
// to P-256) and the 2-bit-window constant-time ladder. Field inversion is Fermat z^(p-2) with a plain
// binary schedule over the fixed public exponent. Only the ECDH surface is provided (no ECDSA).
//
// References: FIPS 186-4 P-384 domain parameters, the standard Montgomery CIOS algorithm. Verified
// against an independent P-384 ECDH computation (derivePublic + shared secret).
import bytes;

const MASK32: ulong = 0xffffffff;
const U0: ulong = 0;
const U1: ulong = 1;

// ---- field element storage (12 limbs of 32 bits, little-endian, in a 96-byte buffer) ----

fn newFe(): ptr { return bytes.alloc(96); }
fn getw(f: ptr, i: int): ulong { return (bytes.read_ptr(f, i * 8) as long) as ulong; }
fn setw(f: ptr, i: int, v: ulong): void { bytes.write_ptr(f, i * 8, (v as long) as ptr); }

// The i-th limb of p (little-endian): p = ...ffffffff fffffffe ffffffff 00000000 00000000 ffffffff.
fn pl(i: int): ulong {
    if (i == 1) { return U0; }
    if (i == 2) { return U0; }
    if (i == 4) { return 0xfffffffe; }
    return MASK32;
}

fn feCopy(out: ptr, a: ptr): void { let i = 0; while (i < 12) { setw(out, i, getw(a, i)); i = i + 1; } }
fn feZero(out: ptr): void { let i = 0; while (i < 12) { setw(out, i, U0); i = i + 1; } }

// Conditional subtract of p: t[0..12] (t < 2p, t[12] the top carry) -> t-p if t >= p else t, into out.
fn condSubP(out: ptr, t: ptr): void {
    let d = bytes.alloc(96);
    let borrow: ulong = 0;
    let j = 0;
    while (j < 12) {
        let x = getw(t, j) - pl(j) - borrow;
        setw(d, j, x & MASK32);
        borrow = (x >> 32) & U1;
        j = j + 1;
    }
    let x12 = getw(t, 12) - borrow;
    borrow = (x12 >> 32) & U1;              // 1 => t < p (keep t); 0 => t >= p (take d)
    let mask = U0 - (borrow ^ U1);
    j = 0;
    while (j < 12) {
        setw(out, j, (getw(d, j) & mask) | (getw(t, j) & (~mask)));
        j = j + 1;
    }
    bytes.free(d);
}

fn feAdd(out: ptr, a: ptr, b: ptr): void {
    let t = bytes.alloc(112);
    let carry: ulong = 0;
    let j = 0;
    while (j < 12) {
        let s = getw(a, j) + getw(b, j) + carry;
        setw(t, j, s & MASK32);
        carry = s >> 32;
        j = j + 1;
    }
    setw(t, 12, carry);
    condSubP(out, t);
    bytes.free(t);
}

fn feSub(out: ptr, a: ptr, b: ptr): void {
    let d = bytes.alloc(96);
    let borrow: ulong = 0;
    let j = 0;
    while (j < 12) {
        let x = getw(a, j) - getw(b, j) - borrow;
        setw(d, j, x & MASK32);
        borrow = (x >> 32) & U1;
        j = j + 1;
    }
    let mask = U0 - borrow;                 // all ones when a < b: add p back
    let carry: ulong = 0;
    j = 0;
    while (j < 12) {
        let s = getw(d, j) + (pl(j) & mask) + carry;
        setw(out, j, s & MASK32);
        carry = s >> 32;
        j = j + 1;
    }
    bytes.free(d);
}

// Montgomery multiply (CIOS): out = a*b*R^-1 mod p, R = 2^384. n0' = 1. Inputs/output canonical (< p).
fn feMul(out: ptr, a: ptr, b: ptr): void {
    let t = bytes.alloc(112);               // t[0..13]
    let j = 0;
    while (j < 14) { setw(t, j, U0); j = j + 1; }
    let i = 0;
    while (i < 12) {
        let bi = getw(b, i);
        let carry: ulong = 0;
        j = 0;
        while (j < 12) {
            let s = getw(t, j) + getw(a, j) * bi + carry;
            setw(t, j, s & MASK32);
            carry = s >> 32;
            j = j + 1;
        }
        let s12 = getw(t, 12) + carry;
        setw(t, 12, s12 & MASK32);
        setw(t, 13, s12 >> 32);
        // reduction: m = t[0] * n0' mod 2^32, n0' = 1.
        let m = getw(t, 0);
        let c2 = (getw(t, 0) + m * pl(0)) >> 32;
        j = 1;
        while (j < 12) {
            let s = getw(t, j) + m * pl(j) + c2;
            setw(t, j - 1, s & MASK32);
            c2 = s >> 32;
            j = j + 1;
        }
        let s11 = getw(t, 12) + c2;
        setw(t, 11, s11 & MASK32);
        setw(t, 12, getw(t, 13) + (s11 >> 32));
        i = i + 1;
    }
    condSubP(out, t);
    bytes.free(t);
}
fn feSq(out: ptr, a: ptr): void { feMul(out, a, a); }

// Convert into Montgomery form: out = a*R mod p, by 384 successive doublings.
fn toMont(out: ptr, a: ptr): void {
    feCopy(out, a);
    let i = 0;
    while (i < 384) { feAdd(out, out, out); i = i + 1; }
}
fn fromMont(out: ptr, x: ptr): void {
    let one = newFe(); feZero(one); setw(one, 0, U1);
    feMul(out, x, one);
    bytes.free(one);
}

fn feEq(a: ptr, b: ptr): bool {
    let diff: ulong = 0;
    let j = 0;
    while (j < 12) { diff = diff | (getw(a, j) ^ getw(b, j)); j = j + 1; }
    return diff == U0;
}
fn feLtP(a: ptr): bool {
    let borrow: ulong = 0;
    let j = 0;
    while (j < 12) {
        let x = getw(a, j) - pl(j) - borrow;
        borrow = (x >> 32) & U1;
        j = j + 1;
    }
    return borrow == U1;
}

fn nib(c: int): int {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    return c - 55;
}
fn setHex(buf: ptr, hex: string): void {
    let n = hex.length / 2;
    let i = 0;
    while (i < n) { bytes.write_byte(buf, i, nib(hex[i * 2]) * 16 + nib(hex[i * 2 + 1])); i = i + 1; }
}

// Field inversion in Montgomery form: out = (aR)^(p-2) in the Montgomery domain (a binary schedule over
// the fixed public exponent p-2).
fn feInvert(out: ptr, a: ptr): void {
    let r = newFe(); montOne(r);
    let e = bytes.alloc(48);
    setHex(e, "fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffeffffffff0000000000000000fffffffd");
    let k = 383;
    while (k >= 0) {
        feSq(r, r);
        let bitVal = (bytes.read_byte(e, 47 - (k >> 3)) >> (k & 7)) & 1;
        if (bitVal == 1) { feMul(r, r, a); }
        k = k - 1;
    }
    feCopy(out, r);
    bytes.free(r); bytes.free(e);
}
fn montOne(out: ptr): void {
    let one = newFe(); feZero(one); setw(one, 0, U1);
    toMont(out, one);
    bytes.free(one);
}

// ---- big-endian byte <-> field element ----

fn feFromBE(out: ptr, buf: ptr, off: int): void {
    let i = 0;
    while (i < 12) {
        let base = off + (11 - i) * 4;
        let w = ((bytes.read_byte(buf, base) as ulong) << 24)
              | ((bytes.read_byte(buf, base + 1) as ulong) << 16)
              | ((bytes.read_byte(buf, base + 2) as ulong) << 8)
              | (bytes.read_byte(buf, base + 3) as ulong);
        setw(out, i, w);
        i = i + 1;
    }
}
fn feToBE(buf: ptr, off: int, a: ptr): void {
    let i = 0;
    while (i < 12) {
        let base = off + (11 - i) * 4;
        let w = getw(a, i);
        bytes.write_byte(buf, base, ((w >> 24) & 0xff) as int);
        bytes.write_byte(buf, base + 1, ((w >> 16) & 0xff) as int);
        bytes.write_byte(buf, base + 2, ((w >> 8) & 0xff) as int);
        bytes.write_byte(buf, base + 3, (w & 0xff) as int);
        i = i + 1;
    }
}

fn bMont(out: ptr): void {
    let b = bytes.alloc(48);
    setHex(b, "b3312fa7e23ee7e4988e056be3f82d19181d9c6efe8141120314088f5013875ac656398d8a2ed19d2a85c8edd3ec2aef");
    let t = newFe();
    feFromBE(t, b, 0);
    toMont(out, t);
    bytes.free(b); bytes.free(t);
}

// ---- Jacobian points: 288-byte buffer, X at 0, Y at 96, Z at 192 (each a Montgomery field element) ----

fn newPt(): ptr { return bytes.alloc(288); }
fn px(p: ptr): ptr { return p; }
fn py(p: ptr): ptr { return (p as long + 96) as ptr; }
fn pz(p: ptr): ptr { return (p as long + 192) as ptr; }

fn ptCopy(d: ptr, s: ptr): void { let i = 0; while (i < 36) { setw(d, i, getw(s, i)); i = i + 1; } }
fn ptZero(p: ptr): void { let i = 0; while (i < 36) { setw(p, i, U0); i = i + 1; } }
fn ptCcopy(d: ptr, s: ptr, flag: ulong): void {
    let mask = U0 - flag;
    let i = 0;
    while (i < 36) { setw(d, i, (getw(s, i) & mask) | (getw(d, i) & (~mask))); i = i + 1; }
}

fn jDouble(q: ptr): void {
    let t1 = newFe(); let t2 = newFe(); let t3 = newFe(); let t4 = newFe();
    feSq(t1, pz(q));
    feAdd(t2, px(q), t1);
    feSub(t1, px(q), t1);
    feMul(t3, t1, t2);
    feAdd(t1, t3, t3);
    feAdd(t1, t3, t1);                     // m = 3*(x+z^2)*(x-z^2)
    feSq(t3, py(q));
    feAdd(t3, t3, t3);                     // 2*y^2
    feMul(t2, px(q), t3);
    feAdd(t2, t2, t2);                     // s = 4*x*y^2
    feSq(px(q), t1);
    feSub(px(q), px(q), t2);
    feSub(px(q), px(q), t2);               // x' = m^2 - 2s
    feMul(t4, py(q), pz(q));
    feAdd(pz(q), t4, t4);                  // z' = 2*y*z
    feSub(t2, t2, px(q));
    feMul(py(q), t1, t2);
    feSq(t4, t3);
    feAdd(t4, t4, t4);                     // 8*y^4
    feSub(py(q), py(q), t4);               // y'
    bytes.free(t1); bytes.free(t2); bytes.free(t3); bytes.free(t4);
}

fn jAdd(p1: ptr, p2: ptr): void {
    let t1 = newFe(); let t2 = newFe(); let t3 = newFe(); let t4 = newFe();
    let t5 = newFe(); let t6 = newFe(); let t7 = newFe();
    feSq(t3, pz(p2));
    feMul(t1, px(p1), t3);                 // u1
    feMul(t4, pz(p2), t3);
    feMul(t3, py(p1), t4);                 // s1
    feSq(t4, pz(p1));
    feMul(t2, px(p2), t4);                 // u2
    feMul(t5, pz(p1), t4);
    feMul(t4, py(p2), t5);                 // s2
    feSub(t2, t2, t1);                     // h
    feSub(t4, t4, t3);                     // r
    feSq(t7, t2);
    feMul(t6, t1, t7);
    feMul(t5, t7, t2);                     // h^3
    feSq(px(p1), t4);
    feSub(px(p1), px(p1), t5);
    feSub(px(p1), px(p1), t6);
    feSub(px(p1), px(p1), t6);             // x3
    feSub(t6, t6, px(p1));
    feMul(py(p1), t4, t6);
    feMul(t1, t5, t3);
    feSub(py(p1), py(p1), t1);             // y3
    feMul(t1, pz(p1), pz(p2));
    feMul(pz(p1), t1, t2);                 // z3
    bytes.free(t1); bytes.free(t2); bytes.free(t3); bytes.free(t4);
    bytes.free(t5); bytes.free(t6); bytes.free(t7);
}

fn neqZero(v: ulong): ulong { return ((v | (U0 - v)) >> 63) & U1; }
fn eqVal(v: ulong, c: ulong): ulong { return neqZero(v ^ c) ^ U1; }

// Multiply Jacobian point p by the big-endian scalar x[0..xlen), in place (2-bit window ladder).
fn scalarMultPoint(p: ptr, x: ptr, xlen: int): void {
    let p2 = newPt(); ptCopy(p2, p); jDouble(p2);
    let p3 = newPt(); ptCopy(p3, p); jAdd(p3, p2);
    let q = newPt(); ptZero(q);
    let tt = newPt(); let uu = newPt();
    let qz: ulong = 1;
    let bi = 0;
    while (bi < xlen) {
        let byteV = bytes.read_byte(x, bi);
        let k = 6;
        while (k >= 0) {
            jDouble(q); jDouble(q);
            ptCopy(tt, p);
            ptCopy(uu, q);
            let bitsPair = ((byteV >> k) & 3) as ulong;
            let bnz = neqZero(bitsPair);
            ptCcopy(tt, p2, eqVal(bitsPair, 2));
            ptCcopy(tt, p3, eqVal(bitsPair, 3));
            jAdd(uu, tt);
            ptCcopy(q, tt, bnz & qz);
            ptCcopy(q, uu, bnz & (qz ^ U1));
            qz = qz & (bnz ^ U1);
            k = k - 2;
        }
        bi = bi + 1;
    }
    ptCopy(p, q);
    bytes.free(p2); bytes.free(p3); bytes.free(q); bytes.free(tt); bytes.free(uu);
}

fn toAffine(p: ptr, xaOut: ptr, yaOut: ptr): void {
    let zinv = newFe(); feInvert(zinv, pz(p));
    let z2 = newFe(); feSq(z2, zinv);
    let xm = newFe(); feMul(xm, px(p), z2);
    let z3 = newFe(); feMul(z3, z2, zinv);
    let ym = newFe(); feMul(ym, py(p), z3);
    fromMont(xaOut, xm);
    fromMont(yaOut, ym);
    bytes.free(zinv); bytes.free(z2); bytes.free(xm); bytes.free(z3); bytes.free(ym);
}

fn baseG(p: ptr): void {
    let gx = bytes.alloc(48);
    setHex(gx, "aa87ca22be8b05378eb1c71ef320ad746e1d3b628ba79b9859f741e082542a385502f25dbf55296c3a545e3872760ab7");
    let gy = bytes.alloc(48);
    setHex(gy, "3617de4a96262c6f5d9e98bf9292dc29f8f41dbd289a147ce9da3113b5f0b8c00a60b1ce1d7e819d7a431d7c90ea0e5f");
    let t = newFe();
    feFromBE(t, gx, 0); toMont(px(p), t);
    feFromBE(t, gy, 0); toMont(py(p), t);
    feZero(t); setw(t, 0, U1); toMont(pz(p), t);
    bytes.free(gx); bytes.free(gy); bytes.free(t);
}

fn onCurve(xn: ptr, yn: ptr): bool {
    let xm = newFe(); let ym = newFe();
    toMont(xm, xn); toMont(ym, yn);
    let l = newFe(); feSq(l, ym);
    let r = newFe(); feSq(r, xm); feMul(r, r, xm);
    let t = newFe(); feAdd(t, xm, xm); feAdd(t, t, xm);
    feSub(r, r, t);                                  // x^3 - 3x
    let bm = newFe(); bMont(bm); feAdd(r, r, bm);
    let ok = feEq(l, r);
    bytes.free(xm); bytes.free(ym); bytes.free(l); bytes.free(r); bytes.free(t); bytes.free(bm);
    return ok;
}

// ---- public API ----

// Derive the uncompressed public key (0x04 || X || Y, 97 bytes) for a 48-byte big-endian private scalar.
pub fn derivePublic(outPub97: ptr, scalar48: ptr): void {
    let g = newPt(); baseG(g);
    scalarMultPoint(g, scalar48, 48);
    let xa = newFe(); let ya = newFe();
    toAffine(g, xa, ya);
    bytes.write_byte(outPub97, 0, 4);
    feToBE(outPub97, 1, xa);
    feToBE(outPub97, 49, ya);
    bytes.free(g); bytes.free(xa); bytes.free(ya);
}

// ECDH: shared secret (48-byte big-endian X coordinate) from our 48-byte scalar and the peer's
// uncompressed public point (97 bytes). Returns 1 on success, 0 if the peer point is invalid.
pub fn ecdh(outSecret48: ptr, scalar48: ptr, peerPub97: ptr): int {
    if (bytes.read_byte(peerPub97, 0) != 4) { return 0; }
    let xn = newFe(); let yn = newFe();
    feFromBE(xn, peerPub97, 1); feFromBE(yn, peerPub97, 49);
    if (!feLtP(xn) || !feLtP(yn) || !onCurve(xn, yn)) {
        bytes.free(xn); bytes.free(yn);
        return 0;
    }
    let q = newPt();
    toMont(px(q), xn); toMont(py(q), yn);
    let one = newFe(); feZero(one); setw(one, 0, U1); toMont(pz(q), one);
    scalarMultPoint(q, scalar48, 48);
    let xa = newFe(); let ya = newFe();
    toAffine(q, xa, ya);
    feToBE(outSecret48, 0, xa);
    bytes.free(xn); bytes.free(yn); bytes.free(q); bytes.free(one);
    bytes.free(xa); bytes.free(ya);
    return 1;
}
