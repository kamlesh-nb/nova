// A CA trust store (M12): a set of trusted root certificates, loaded from a PEM bundle in memory. A
// server certificate chain is trusted iff it validates against at least one root in the store, at the
// given time, for the given hostname - reusing the verified x509 chain logic (crypto/x509.verifyCertList,
// which checks signatures, validity windows, CA constraints, name chaining, and SAN hostname matching).
//
// This module is PURE (base64 + x509 only, no os.sys): loading reads a PEM string the CALLER supplies, so
// importing it does not drag the os.sys socket/file externs into a TLS consumer's namespace. The system
// CA bundle file is read by the application (or web/client) and handed to loadPemBundle as a string.
import bytes;
import list;
import crypto.x509;
import crypto.tls.revocation;
import crypto.base64;
import datetime;

// Current UTC time as the YYYYMMDDHHMMSS number x509 validity checks expect. Computed directly from the
// Unix timestamp (Howard Hinnant's civil-from-days), so it is UTC regardless of the local timezone.
pub fn nowUtc(): long {
    let t = datetime.now() as long;              // Unix seconds (UTC epoch)
    let days = t / 86400;
    let sod = t - days * 86400;
    let hh = sod / 3600;
    let mi = (sod - hh * 3600) / 60;
    let ss = sod - hh * 3600 - mi * 60;
    let z = days + 719468;
    let era = z / 146097;
    let doe = z - era * 146097;
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    let y = yoe + era * 400;
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    let mp = (5 * doy + 2) / 153;
    let d = doy - (153 * mp + 2) / 5 + 1;
    let m = mp + 3;
    if (mp >= 10) { m = mp - 9; }
    if (m <= 2) { y = y + 1; }
    return ((((y * 100 + m) * 100 + d) * 100 + hh) * 100 + mi) * 100 + ss;
}

const BEGIN_MARK: string = "-----BEGIN CERTIFICATE-----";
const END_MARK: string = "-----END CERTIFICATE-----";

pub struct TrustStore {
    pub ders: List<long>,          // DER root-cert buffer pointers (owned)
    pub lens: List<int>,

    pub fn count(self: TrustStore): int { return self.ders.size(); }

    // Is `certList` (a TLS Certificate message's certificate_list content: runs of cert<3> || ext<2>)
    // trusted for `host` at `now` (a YYYYMMDDHHMMSS number) by any root in this store?
    pub fn trusts(self: TrustStore, certList: ptr, listLen: int, host: string, now: long): bool {
        let i = 0;
        while (i < self.ders.size()) {
            let d = (self.ders.get(i) ?? 0) as ptr;
            let n = self.lens.get(i) ?? 0;
            if (x509.verifyCertList(certList, listLen, d, n, host, now)) { return true; }
            i = i + 1;
        }
        return false;
    }

    // TLS 1.2 variant: the cert_list has no per-cert extension bytes (see x509.verifyCertList12).
    pub fn trusts12(self: TrustStore, certList: ptr, listLen: int, host: string, now: long): bool {
        let i = 0;
        while (i < self.ders.size()) {
            let d = (self.ders.get(i) ?? 0) as ptr;
            let n = self.lens.get(i) ?? 0;
            if (x509.verifyCertList12(certList, listLen, d, n, host, now)) { return true; }
            i = i + 1;
        }
        return false;
    }

    // The leaf's issuer for a revocation check: the intermediate from the cert_list if present and it
    // matches, otherwise the store root whose subject is the leaf's issuer name.
    fn issuerFor(self: TrustStore, leaf: x509.Cert, inter: x509.Cert): x509.Cert {
        if (inter.ok && x509.nameMatches(leaf, inter)) { return inter; }
        let i = 0;
        while (i < self.ders.size()) {
            let root = x509.parseCert((self.ders.get(i) ?? 0) as ptr, self.lens.get(i) ?? 0);
            if (root.ok && x509.nameMatches(leaf, root)) { return root; }
            i = i + 1;
        }
        return leaf;                                    // self-issued fallback
    }

    // Chain-verify AND revocation-check (TLS 1.3 cert_list). The chain must be trusted for `host` at
    // `now`, AND the leaf must not be revoked by the stapled OCSP response (ocspLen>0) or the CRL
    // (crlLen>0). Policy: HARD-FAIL on a proven revocation, SOFT-FAIL on UNKNOWN (accept when revocation
    // cannot be determined -- no material, non-EC issuer, unverifiable response). Pass len 0 to skip one.
    pub fn trustsNotRevoked(self: TrustStore, certList: ptr, listLen: int, host: string, now: long,
                            ocspDer: ptr, ocspLen: int, crlDer: ptr, crlLen: int): bool {
        if (!self.trusts(certList, listLen, host, now)) { return false; }
        let leaf = x509.leafCert(certList, listLen);
        let issuer = self.issuerFor(leaf, x509.interCert13(certList, listLen));
        if (ocspLen > 0 && revocation.checkOcspStapled(leaf, issuer, ocspDer, ocspLen) == revocation.REV_REVOKED) { return false; }
        if (crlLen > 0 && revocation.checkCrl(leaf, issuer, crlDer, crlLen) == revocation.REV_REVOKED) { return false; }
        return true;
    }

    // TLS 1.2 variant (cert_list has no per-cert extension bytes).
    pub fn trustsNotRevoked12(self: TrustStore, certList: ptr, listLen: int, host: string, now: long,
                              ocspDer: ptr, ocspLen: int, crlDer: ptr, crlLen: int): bool {
        if (!self.trusts12(certList, listLen, host, now)) { return false; }
        let leaf = x509.leafCert(certList, listLen);
        let issuer = self.issuerFor(leaf, x509.interCert12(certList, listLen));
        if (ocspLen > 0 && revocation.checkOcspStapled(leaf, issuer, ocspDer, ocspLen) == revocation.REV_REVOKED) { return false; }
        if (crlLen > 0 && revocation.checkCrl(leaf, issuer, crlDer, crlLen) == revocation.REV_REVOKED) { return false; }
        return true;
    }

    pub fn free(self: TrustStore): void {
        let i = 0;
        while (i < self.ders.size()) { bytes.free((self.ders.get(i) ?? 0) as ptr); i = i + 1; }
    }
}

fn readI32(b: ptr, o: int): int {
    return bytes.read_byte(b, o) | (bytes.read_byte(b, o + 1) << 8) | (bytes.read_byte(b, o + 2) << 16) | (bytes.read_byte(b, o + 3) << 24);
}

fn indexFrom(hay: string, needle: string, from: int): int {
    let n = hay.length; let m = needle.length;
    let i = from;
    while (i + m <= n) {
        let j = 0;
        while (j < m && hay[i + j] == needle[j]) { j = j + 1; }
        if (j == m) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// Base64-decode the body between offsets [start, end) (whitespace stripped) into an owned DER buffer.
// Returns the buffer pointer; writes its length to lenOut[0].
fn decodeBlock(pem: string, start: int, end: int, lenOut: ptr): ptr {
    let clean = bytes.alloc(end - start);
    let cn = 0;
    let i = start;
    while (i < end) {
        let c = pem[i];
        if (c != 10 && c != 13 && c != 32 && c != 9) { bytes.write_byte(clean, cn, c); cn = cn + 1; }
        i = i + 1;
    }
    let b64 = bytes.alloc(cn);
    let j = 0;
    while (j < cn) { bytes.write_byte(b64, j, bytes.read_byte(clean, j)); j = j + 1; }
    bytes.free(clean);
    let der = base64.decode(b64 as string);
    bytes.free(b64);
    let n = der.length;
    let buf = bytes.alloc(n);
    j = 0;
    while (j < n) { bytes.write_byte(buf, j, bytes.read_byte(der as ptr, j)); j = j + 1; }
    bytes.write_i32(lenOut, 0, n);
    return buf;
}

// Build a trust store from a PEM bundle (one or many "-----BEGIN CERTIFICATE-----" blocks).
// A trust store seeded with one DER root certificate (the buffer is retained; free() owns it).
pub fn newTrustStoreDer(der: ptr, len: int): TrustStore {
    let store = TrustStore { ders: List<long>(), lens: List<int>() };
    store.ders.push(der as long);
    store.lens.push(len);
    return store;
}

pub fn loadPemBundle(pem: string): TrustStore {
    let store = TrustStore { ders: List<long>(), lens: List<int>() };
    let lenOut = bytes.alloc(4);
    let pos = 0;
    while (true) {
        let bs = indexFrom(pem, BEGIN_MARK, pos);
        if (bs < 0) { break; }
        let bodyStart = bs + BEGIN_MARK.length;
        let es = indexFrom(pem, END_MARK, bodyStart);
        if (es < 0) { break; }
        let buf = decodeBlock(pem, bodyStart, es, lenOut);
        store.ders.push(buf as long);
        store.lens.push(readI32(lenOut, 0));
        pos = es + END_MARK.length;
    }
    bytes.free(lenOut);
    return store;
}
