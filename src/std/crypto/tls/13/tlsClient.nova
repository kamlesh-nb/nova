// TLS 1.3 (RFC 8446) client handshake state machine in Nova, no external library (M9 phase E). This is
// the I/O-agnostic driver: it consumes the handshake messages a server sends and produces the client's
// responses, threading the tls13 key schedule, the tls13hs authentication, and the record layer. Wiring
// it to a socket (the reactor AsyncStream) is done by the caller; see the TLS client example.
//
// References: RFC 8446. Verified against the RFC 8448 "Simple 1-RTT Handshake" trace.
import bytes;
import crypto.tls.13.tls;
import crypto.tls.13.handshake;
import crypto.ecc.x25519;
import crypto.ecc.p256;
import crypto.ecc.p384;
import crypto.x509;
import crypto.hash.sha256;
import crypto.hash.sha512;
import crypto.mac.hmac;

fn at(buf: ptr, off: int): ptr { return (buf as long + off) as ptr; }

fn chNib(c: int): int {
    if (c >= 48 && c <= 57) { return c - 48; }
    return c - 87;
}
fn putHex(out: ptr, p: int, hex: string): int {
    let n = hex.length / 2;
    let i = 0;
    while (i < n) { bytes.write_byte(out, p + i, chNib(hex[i * 2]) * 16 + chNib(hex[i * 2 + 1])); i = i + 1; }
    return p + n;
}

// Write an application_layer_protocol_negotiation extension (RFC 7301) for the comma-separated protocol
// list `alpn` at out[p]. Returns the new position (unchanged if `alpn` is empty).
fn putAlpn(out: ptr, p: int, alpn: string): int {
    if (alpn.length == 0) { return p; }
    bytes.write_byte(out, p, 0x00); bytes.write_byte(out, p + 1, 0x10); p = p + 2;   // ext_type: ALPN
    let extLenPos = p; p = p + 2;                  // extension_data length (backpatched)
    let listLenPos = p; p = p + 2;                 // ProtocolNameList length (backpatched)
    let listStart = p;
    let i = 0;
    while (i < alpn.length) {
        let j = i;
        while (j < alpn.length && alpn[j] != 44) { j = j + 1; }   // 44 = ','
        let tlen = j - i;
        if (tlen > 0) {
            bytes.write_byte(out, p, tlen); p = p + 1;
            let k = 0;
            while (k < tlen) { bytes.write_byte(out, p + k, alpn[i + k]); k = k + 1; }
            p = p + tlen;
        }
        i = j + 1;
    }
    let listLen = p - listStart;
    bytes.write_byte(out, listLenPos, (listLen >> 8) & 0xff); bytes.write_byte(out, listLenPos + 1, listLen & 0xff);
    let extLen = p - (extLenPos + 2);
    bytes.write_byte(out, extLenPos, (extLen >> 8) & 0xff); bytes.write_byte(out, extLenPos + 1, extLen & 0xff);
    return p;
}

// Write a server_name (SNI) extension (RFC 6066) for `host` at out[p]. Returns the new position.
fn putSni(out: ptr, p: int, host: string): int {
    let hl = host.length;
    p = putHex(out, p, "0000");                    // extension_type: server_name
    bytes.write_byte(out, p, ((5 + hl) >> 8) & 0xff); bytes.write_byte(out, p + 1, (5 + hl) & 0xff); p = p + 2;
    bytes.write_byte(out, p, ((3 + hl) >> 8) & 0xff); bytes.write_byte(out, p + 1, (3 + hl) & 0xff); p = p + 2;
    bytes.write_byte(out, p, 0); p = p + 1;        // name_type: host_name
    bytes.write_byte(out, p, (hl >> 8) & 0xff); bytes.write_byte(out, p + 1, hl & 0xff); p = p + 2;
    let i = 0;
    while (i < hl) { bytes.write_byte(out, p + i, host[i]); i = i + 1; }
    return p + hl;
}

// Build a TLS 1.3 ClientHello handshake message into out for the given server hostname. Offers X25519 +
// AES-128-GCM-SHA256 / AES-256-GCM-SHA384 / ChaCha20-Poly1305 with server_name (SNI),
// supported_versions=1.3, supported_groups=x25519+secp256r1, signature_algorithms (RSA-PSS/PKCS1 + ECDSA
// P-256, all SHA-256), psk_key_exchange_modes (psk_dhe_ke), and two key_share entries carrying our
// ephemeral public keys (the server picks one group). random and sessionId are 32 bytes each; ephPub is
// our 32-byte X25519 public key and ephPubP256 is our 65-byte uncompressed secp256r1 point. `alpn` is a
// comma-separated list of ALPN protocol names to offer (e.g. "h2,http/1.1"); an empty string omits the
// application_layer_protocol_negotiation extension. Returns the message length.
pub fn buildClientHello(random: ptr, sessionId: ptr, ephPub: ptr, ephPubP256: ptr, host: string, alpn: string, out: ptr): int {
    let empty = bytes.alloc(1);
    let n = buildClientHelloEx(random, sessionId, ephPub, ephPubP256, empty, host, alpn, 3, empty, 0, empty, 0, 0, 0, 0, out);
    bytes.free(empty);
    return n;
}

// The general ClientHello builder. `groupMask` selects which key_share entries to include: bit 0 (value
// 1) = x25519, bit 1 (value 2) = secp256r1 (3 = both, the initial ClientHello). supported_groups always
// lists both groups regardless. `cookie`/`cookieLen` echo a HelloRetryRequest cookie (RFC 8446 4.2.2)
// when cookieLen > 0. A ClientHello2 (the retry) sets groupMask to just the server-selected group and
// carries the cookie; everything else matches the first ClientHello.
pub fn buildClientHelloEx(random: ptr, sessionId: ptr, ephPub: ptr, ephPubP256: ptr, ephPubP384: ptr, host: string, alpn: string,
                          groupMask: int, cookie: ptr, cookieLen: int,
                          pskTicket: ptr, pskTicketLen: int, obfAge: long, binderLen: int, earlyData: int, out: ptr): int {
    let p = 4;                                     // reserve the 4-byte handshake header
    bytes.write_byte(out, p, 0x03); bytes.write_byte(out, p + 1, 0x03); p = p + 2;   // legacy_version
    let i = 0;
    while (i < 32) { bytes.write_byte(out, p + i, bytes.read_byte(random, i)); i = i + 1; }
    p = p + 32;
    bytes.write_byte(out, p, 0x20); p = p + 1;     // legacy_session_id (32 bytes, middlebox compat)
    i = 0;
    while (i < 32) { bytes.write_byte(out, p + i, bytes.read_byte(sessionId, i)); i = i + 1; }
    p = p + 32;
    p = putHex(out, p, "0006130113021303");        // cipher_suites: AES-128-GCM-SHA256, AES-256-GCM-SHA384, CHACHA20-POLY1305-SHA256
    p = putHex(out, p, "0100");                    // legacy_compression_methods: null

    let extLenPos = p; p = p + 2;                  // extensions length (backpatched)
    let extStart = p;
    p = putSni(out, p, host);                      // server_name (SNI)
    p = putHex(out, p, "002b0003020304");          // supported_versions: TLS 1.3
    p = putHex(out, p, "000a00080006001d00170018");// supported_groups: x25519, secp256r1, secp384r1
    p = putHex(out, p, "000d00080006080404030401");// signature_algorithms: rsa_pss/ecdsa/rsa_pkcs1 SHA-256
    p = putHex(out, p, "002d00020101");            // psk_key_exchange_modes: psk_dhe_ke
    p = putHex(out, p, "001c00024001");            // record_size_limit: 16385 (TLS 1.3 max) (RFC 8449)
    p = putAlpn(out, p, alpn);                      // application_layer_protocol_negotiation (if offered)
    if (cookieLen > 0) {                            // cookie: echo the HelloRetryRequest cookie
        bytes.write_byte(out, p, 0x00); bytes.write_byte(out, p + 1, 0x2c); p = p + 2;   // ext_type: cookie
        let cExt = cookieLen + 2;
        bytes.write_byte(out, p, (cExt >> 8) & 0xff); bytes.write_byte(out, p + 1, cExt & 0xff); p = p + 2;
        bytes.write_byte(out, p, (cookieLen >> 8) & 0xff); bytes.write_byte(out, p + 1, cookieLen & 0xff); p = p + 2;
        let ci = 0;
        while (ci < cookieLen) { bytes.write_byte(out, p + ci, bytes.read_byte(cookie, ci)); ci = ci + 1; }
        p = p + cookieLen;
    }
    // key_share: ext_type 0033, then client_shares (backpatched lengths). Entries are selected by
    // groupMask: x25519 (001d, 32 bytes) and/or secp256r1 (0017, 65-byte uncompressed point).
    bytes.write_byte(out, p, 0x00); bytes.write_byte(out, p + 1, 0x33); p = p + 2;   // ext_type: key_share
    let ksExtLenPos = p; p = p + 2;                // extension_data length (backpatched)
    let ksListLenPos = p; p = p + 2;               // client_shares length (backpatched)
    let ksListStart = p;
    if ((groupMask & 1) != 0) {
        p = putHex(out, p, "001d0020");
        i = 0;
        while (i < 32) { bytes.write_byte(out, p + i, bytes.read_byte(ephPub, i)); i = i + 1; }
        p = p + 32;
    }
    if ((groupMask & 2) != 0) {
        p = putHex(out, p, "00170041");
        i = 0;
        while (i < 65) { bytes.write_byte(out, p + i, bytes.read_byte(ephPubP256, i)); i = i + 1; }
        p = p + 65;
    }
    if ((groupMask & 4) != 0) {                    // secp384r1 (0018, 97-byte uncompressed point)
        p = putHex(out, p, "00180061");
        i = 0;
        while (i < 97) { bytes.write_byte(out, p + i, bytes.read_byte(ephPubP384, i)); i = i + 1; }
        p = p + 97;
    }
    let ksListLen = p - ksListStart;
    bytes.write_byte(out, ksListLenPos, (ksListLen >> 8) & 0xff); bytes.write_byte(out, ksListLenPos + 1, ksListLen & 0xff);
    let ksExtLen = p - (ksExtLenPos + 2);
    bytes.write_byte(out, ksExtLenPos, (ksExtLen >> 8) & 0xff); bytes.write_byte(out, ksExtLenPos + 1, ksExtLen & 0xff);

    if (earlyData != 0) { p = putHex(out, p, "002a0000"); }   // early_data extension (empty in ClientHello)
    // pre_shared_key (RFC 8446 4.2.11) MUST be the LAST extension. The binder value is left zeroed here;
    // the caller fills it via fillResumptionBinder once the truncated-ClientHello transcript is known.
    if (binderLen > 0) {
        bytes.write_byte(out, p, 0x00); bytes.write_byte(out, p + 1, 0x29); p = p + 2;   // ext_type: pre_shared_key
        let idLen = 2 + pskTicketLen + 4;              // one PskIdentity: opaque<2> ticket + uint32 age
        let bindersLen = 1 + binderLen;                // one PskBinderEntry: opaque<1> value
        let pskExtLen = 2 + idLen + 2 + bindersLen;
        bytes.write_byte(out, p, (pskExtLen >> 8) & 0xff); bytes.write_byte(out, p + 1, pskExtLen & 0xff); p = p + 2;
        bytes.write_byte(out, p, (idLen >> 8) & 0xff); bytes.write_byte(out, p + 1, idLen & 0xff); p = p + 2;
        bytes.write_byte(out, p, (pskTicketLen >> 8) & 0xff); bytes.write_byte(out, p + 1, pskTicketLen & 0xff); p = p + 2;
        let ti = 0;
        while (ti < pskTicketLen) { bytes.write_byte(out, p + ti, bytes.read_byte(pskTicket, ti)); ti = ti + 1; }
        p = p + pskTicketLen;
        bytes.write_byte(out, p, ((obfAge >> 24) & 0xff) as int); bytes.write_byte(out, p + 1, ((obfAge >> 16) & 0xff) as int);
        bytes.write_byte(out, p + 2, ((obfAge >> 8) & 0xff) as int); bytes.write_byte(out, p + 3, (obfAge & 0xff) as int); p = p + 4;
        bytes.write_byte(out, p, (bindersLen >> 8) & 0xff); bytes.write_byte(out, p + 1, bindersLen & 0xff); p = p + 2;
        bytes.write_byte(out, p, binderLen); p = p + 1;
        let bz = 0;
        while (bz < binderLen) { bytes.write_byte(out, p + bz, 0); bz = bz + 1; }
        p = p + binderLen;
    }

    let extLen = p - extStart;
    bytes.write_byte(out, extLenPos, (extLen >> 8) & 0xff);
    bytes.write_byte(out, extLenPos + 1, extLen & 0xff);

    let bodyLen = p - 4;                            // handshake header: type 0x01 + 3-byte length
    bytes.write_byte(out, 0, 0x01);
    bytes.write_byte(out, 1, (bodyLen >> 16) & 0xff);
    bytes.write_byte(out, 2, (bodyLen >> 8) & 0xff);
    bytes.write_byte(out, 3, bodyLen & 0xff);
    return p;
}

// Downgrade protection (RFC 8446 section 4.1.3): if a TLS 1.3 client sees the "DOWNGRD" sentinel in the
// last 8 bytes of the ServerHello random, a middlebox forced a lower version and the client must abort.
pub fn hasDowngradeSentinel(shMsg: ptr): bool {
    let tag = "444f574e47524400";                  // "DOWNGRD" + 0x00 (0x01 variant differs only in the last byte)
    let i = 0;
    while (i < 7) {
        if (bytes.read_byte(shMsg, 30 + i) != chNib(tag[i * 2]) * 16 + chNib(tag[i * 2 + 1])) { return false; }
        i = i + 1;
    }
    let last = bytes.read_byte(shMsg, 37);
    return last == 0 || last == 1;
}

// A ServerHello is a HelloRetryRequest when its random equals the fixed SHA-256("HelloRetryRequest")
// sentinel (RFC 8446 section 4.1.3). shMsg is the ServerHello handshake message.
pub fn isHelloRetryRequest(shMsg: ptr): bool {
    let hrr = "cf21ad74e59a6111be1d8c021e65b891c2a211167abb8c5e079e09e2c8a8339c";
    let i = 0;
    while (i < 32) {
        let want = chNib(hrr[i * 2]) * 16 + chNib(hrr[i * 2 + 1]);
        if (bytes.read_byte(shMsg, 6 + i) != want) { return false; }   // random starts at offset 6
        i = i + 1;
    }
    return true;
}

struct TlsClient {
    pub kind: int,                       // HKDF hash: 0 = SHA-256
    pub suite: int,                      // 0 = AES-128-GCM, 1 = AES-256-GCM, 2 = ChaCha20-Poly1305
    pub eph: ptr,                        // our ephemeral X25519 private key (32 bytes)
    pub ephP256: ptr,                    // our ephemeral secp256r1 private scalar (32 bytes)
    pub ephP384: ptr,                    // our ephemeral secp384r1 private scalar (48 bytes)
    pub trBuf: ptr, pub trLen: int, pub trCap: int,
    pub hs: ptr,                         // handshake secret
    pub chs: ptr, pub shs: ptr,          // client / server handshake traffic secrets
    pub cKey: ptr, pub cIv: ptr,         // client handshake write key / IV
    pub sKey: ptr, pub sIv: ptr,         // server handshake write key / IV
    pub master: ptr,
    pub cap: ptr, pub sap: ptr,          // client / server application traffic secrets
    pub capKey: ptr, pub capIv: ptr,
    pub sapKey: ptr, pub sapIv: ptr,
    pub sSeq: long, pub cSeq: long,      // server / client record sequence numbers
    pub certVerifyOk: bool,
    pub finishedOk: bool,
    pub hsBuf: ptr, pub hsCap: int, pub hsLen: int, pub hsPos: int,   // handshake reassembly buffer
    pub leafOff: int, pub leafLen: int,  // leaf certificate location within hsBuf
    pub certListOff: int, pub certListLen: int,   // certificate_list region within hsBuf
    pub alpnSel: string,                          // ALPN protocol the server selected ("" = none)
    pub hrrCookie: ptr, pub hrrCookieLen: int,    // cookie echoed from a HelloRetryRequest (len 0 = none)
    pub resMaster: ptr,                           // resumption_master_secret (derived at handshake end)
    pub ticket: ptr, pub ticketLen: int,          // a received (or offered) session ticket
    pub ticketPsk: ptr, pub ticketAgeAdd: long,   // its derived PSK + ticket_age_add
    pub ticketKind: int, pub haveTicket: bool,    // the PSK's hash (0 SHA-256 / 1 SHA-384) + presence
    pub offerPsk: bool, pub pskAccepted: bool,    // this handshake offers a PSK / the server accepted it
    pub eKey: ptr, pub eIv: ptr, pub eSeq: long,  // 0-RTT client_early_traffic key/IV/sequence
    pub offerEarly: bool, pub earlyAccepted: bool, // this handshake offers 0-RTT / the server accepted it
    pub sendLimit: int,                           // peer's record_size_limit (RFC 8449); max send plaintext = sendLimit-1
}

pub fn newClient(ephPriv: ptr, ephPrivP256: ptr, ephPrivP384: ptr): TlsClient {
    return TlsClient {
        kind: 0, suite: 0, eph: ephPriv, ephP256: ephPrivP256, ephP384: ephPrivP384, trBuf: bytes.alloc(4096), trLen: 0, trCap: 4096,
        hs: bytes.alloc(48), chs: bytes.alloc(48), shs: bytes.alloc(48),
        cKey: bytes.alloc(32), cIv: bytes.alloc(12), sKey: bytes.alloc(32), sIv: bytes.alloc(12),
        master: bytes.alloc(48), cap: bytes.alloc(48), sap: bytes.alloc(48),
        capKey: bytes.alloc(32), capIv: bytes.alloc(12), sapKey: bytes.alloc(32), sapIv: bytes.alloc(12),
        sSeq: 0, cSeq: 0, certVerifyOk: false, finishedOk: false,
        hsBuf: bytes.alloc(8192), hsCap: 8192, hsLen: 0, hsPos: 0, leafOff: 0, leafLen: 0,
        certListOff: 0, certListLen: 0, alpnSel: "", hrrCookie: bytes.alloc(1), hrrCookieLen: 0,
        resMaster: bytes.alloc(48), ticket: bytes.alloc(1), ticketLen: 0, ticketPsk: bytes.alloc(48),
        ticketAgeAdd: 0, ticketKind: 0, haveTicket: false, offerPsk: false, pskAccepted: false,
        eKey: bytes.alloc(32), eIv: bytes.alloc(12), eSeq: 0, offerEarly: false, earlyAccepted: false,
        sendLimit: 16385,
    };
}

// A client that resumes with a previously issued ticket: it offers the PSK (pre_shared_key) alongside the
// normal (EC)DHE key_share. `psk` is the resumption PSK (pskLen bytes = the ticket's hash length), `kind`
// its hash (0 SHA-256 / 1 SHA-384), `ticket` the opaque ticket identity, and `ageAdd` the ticket_age_add.
pub fn newClientResume(ephPriv: ptr, ephPrivP256: ptr, ephPrivP384: ptr, psk: ptr, pskLen: int, kind: int,
                       ticket: ptr, ticketLen: int, ageAdd: long): TlsClient {
    let c = newClient(ephPriv, ephPrivP256, ephPrivP384);
    c.offerPsk = true;
    c.haveTicket = true;
    c.ticketKind = kind;
    c.kind = kind;
    bytes.free(c.ticketPsk); c.ticketPsk = bytes.alloc(pskLen);
    let i = 0;
    while (i < pskLen) { bytes.write_byte(c.ticketPsk, i, bytes.read_byte(psk, i)); i = i + 1; }
    bytes.free(c.ticket); c.ticket = bytes.alloc(ticketLen);
    i = 0;
    while (i < ticketLen) { bytes.write_byte(c.ticket, i, bytes.read_byte(ticket, i)); i = i + 1; }
    c.ticketLen = ticketLen;
    c.ticketAgeAdd = ageAdd;
    return c;
}

// Process a HelloRetryRequest (RFC 8446 sections 4.1.4 + 4.4.1). Parses the selected cipher suite (which
// fixes the transcript hash), the retry's selected_group (0 if the HRR carried no key_share), and an
// optional cookie (stored for the second ClientHello to echo). Performs the special transcript rewrite:
// ClientHello1 is replaced by a synthetic "message_hash" message, then the HRR is appended. `hrr` is the
// HelloRetryRequest handshake message and `hrrLen` its length. Returns the selected group (or 0).
pub fn processHelloRetryRequest(self: TlsClient, hrr: ptr, hrrLen: int): int {
    let p = 4 + 2 + 32;                            // msg header, legacy_version, random
    let sidLen = bytes.read_byte(hrr, p);
    p = p + 1 + sidLen;
    let cipher = (bytes.read_byte(hrr, p) << 8) | bytes.read_byte(hrr, p + 1);
    p = p + 2 + 1;                                 // cipher_suite + legacy_compression_method
    if (cipher == 0x1302) { self.suite = 1; self.kind = 1; }
    else if (cipher == 0x1303) { self.suite = 2; self.kind = 0; }
    else { self.suite = 0; self.kind = 0; }
    let extLen = (bytes.read_byte(hrr, p) << 8) | bytes.read_byte(hrr, p + 1);
    p = p + 2;
    let end = p + extLen;
    let group = 0;
    while (p + 4 <= end) {
        let etype = (bytes.read_byte(hrr, p) << 8) | bytes.read_byte(hrr, p + 1);
        let elen = (bytes.read_byte(hrr, p + 2) << 8) | bytes.read_byte(hrr, p + 3);
        let body = p + 4;
        if (etype == 0x0033) {                     // key_share: the retry carries only selected_group
            group = (bytes.read_byte(hrr, body) << 8) | bytes.read_byte(hrr, body + 1);
        } else if (etype == 0x002c) {              // cookie (RFC 8446 4.2.2)
            let clen = (bytes.read_byte(hrr, body) << 8) | bytes.read_byte(hrr, body + 1);
            bytes.free(self.hrrCookie);
            self.hrrCookie = bytes.alloc(clen);
            let k = 0;
            while (k < clen) { bytes.write_byte(self.hrrCookie, k, bytes.read_byte(hrr, body + 2 + k)); k = k + 1; }
            self.hrrCookieLen = clen;
        }
        p = body + elen;
    }
    // Transcript rewrite (RFC 8446 4.4.1): replace ClientHello1 with
    //   message_hash(254) || 00 00 Hash.length || Hash(ClientHello1)
    // using the now-negotiated suite hash, then append the HelloRetryRequest.
    let hl = trHashLen(self);
    let h1 = bytes.alloc(hl);
    trHash(self, h1);                              // hash of ClientHello1 (the whole current transcript)
    self.trLen = 0;
    let mh = bytes.alloc(4 + hl);
    bytes.write_byte(mh, 0, 0xfe);                 // HandshakeType message_hash(254)
    bytes.write_byte(mh, 1, 0); bytes.write_byte(mh, 2, 0); bytes.write_byte(mh, 3, hl);
    let k = 0;
    while (k < hl) { bytes.write_byte(mh, 4 + k, bytes.read_byte(h1, k)); k = k + 1; }
    trAdd(self, mh, 4 + hl);
    trAdd(self, hrr, hrrLen);
    bytes.free(mh); bytes.free(h1);
    return group;
}

pub fn hrrCookiePtr(self: TlsClient): ptr { return self.hrrCookie; }
pub fn hrrCookieSize(self: TlsClient): int { return self.hrrCookieLen; }

// Running transcript held as a growable buffer directly in the client (the prefix is hashed on demand).
fn trAdd(self: TlsClient, msg: ptr, n: int): void {
    if (self.trLen + n > self.trCap) {
        let nc = (self.trLen + n) * 2;
        let nb = bytes.alloc(nc);
        let i = 0;
        while (i < self.trLen) { bytes.write_byte(nb, i, bytes.read_byte(self.trBuf, i)); i = i + 1; }
        bytes.free(self.trBuf);
        self.trBuf = nb;
        self.trCap = nc;
    }
    let i = 0;
    while (i < n) { bytes.write_byte(self.trBuf, self.trLen + i, bytes.read_byte(msg, i)); i = i + 1; }
    self.trLen = self.trLen + n;
}
// Transcript hash with the negotiated suite's hash (SHA-256 for kind 0, SHA-384 for kind 1).
fn trHash(self: TlsClient, out: ptr): void {
    if (self.kind == 1) { sha512.hash384Into(self.trBuf, self.trLen, out); }
    else { sha256.hashInto(self.trBuf, self.trLen, out); }
}
fn trHashLen(self: TlsClient): int { if (self.kind == 1) { return 48; } return 32; }

// Record the ClientHello handshake-message bytes into the transcript (the caller built and sent them).
pub fn addClientHello(self: TlsClient, chMsg: ptr, chLen: int): void {
    trAdd(self, chMsg, chLen);
}

// Process the ServerHello: negotiate the suite, run the ECDHE, and derive the handshake-phase secrets
// and keys. shMsg is the ServerHello handshake message.
pub fn processServerHello(self: TlsClient, shMsg: ptr, shLen: int): void {
    let serverPub = bytes.alloc(97);               // fits x25519 (32) / secp256r1 (65) / secp384r1 (97)
    let groupBuf = bytes.alloc(2);
    let cipher = handshake.parseServerHello(shMsg, shLen, serverPub, groupBuf);
    let group = (bytes.read_byte(groupBuf, 0) << 8) | bytes.read_byte(groupBuf, 1);
    if (cipher == 0x1302) { self.suite = 1; self.kind = 1; }
    else if (cipher == 0x1303) { self.suite = 2; self.kind = 0; }
    else { self.suite = 0; self.kind = 0; }

    // Run the ECDHE for the group the server selected in its key_share (the shared secret is 32 bytes for
    // x25519/P-256, 48 bytes for P-384).
    let ecdhe = bytes.alloc(48);
    let ecdheLen = 32;
    if (group == 0x0018) { p384.ecdh(ecdhe, self.ephP384, serverPub); ecdheLen = 48; }
    else if (group == 0x0017) { p256.ecdh(ecdhe, self.ephP256, serverPub); }
    else { x25519.scalarMult(ecdhe, self.eph, serverPub); }
    // Early Secret: keyed by the resumption PSK when we offered one and the server accepted it
    // (pre_shared_key echoed), otherwise the all-zero PSK. psk_dhe_ke mixes the ECDHE in either way.
    let early = bytes.alloc(48);
    if (self.offerPsk && handshake.serverAcceptedPsk(shMsg, shLen)) {
        self.pskAccepted = true;
        tls.earlySecretPsk(self.kind, self.ticketPsk, trHashLen(self), early);
    } else {
        tls.earlySecret(self.kind, early);
    }
    let derived = bytes.alloc(48); tls.deriveDerived(self.kind, early, derived);
    tls.extractSecret(self.kind, derived, ecdhe, ecdheLen, self.hs);

    trAdd(self, shMsg, shLen);
    let hSH = bytes.alloc(48); trHash(self, hSH);
    tls.deriveTraffic(self.kind, self.hs, "c hs traffic", hSH, self.chs);
    tls.deriveTraffic(self.kind, self.hs, "s hs traffic", hSH, self.shs);
    tls.deriveKeyIv(self.kind, self.suite, self.chs, self.cKey, self.cIv);
    tls.deriveKeyIv(self.kind, self.suite, self.shs, self.sKey, self.sIv);
    bytes.free(serverPub); bytes.free(groupBuf); bytes.free(ecdhe); bytes.free(early); bytes.free(derived); bytes.free(hSH);
}

// Decrypt and process the server's encrypted handshake flight (one TLSCiphertext record containing
// EncryptedExtensions, Certificate, CertificateVerify, and Finished). Verifies the CertificateVerify
// signature and the server Finished MAC. Returns true iff both verify.
pub fn processFlight(self: TlsClient, record: ptr, recLen: int): bool {
    let inner = bytes.alloc(recLen);
    let innerLen = tls.recordUnprotect(self.suite, self.sKey, self.sIv, self.sSeq, record, recLen, inner);
    self.sSeq = self.sSeq + 1;
    if (innerLen < 0) { bytes.free(inner); return false; }
    let typeOut = bytes.alloc(1);
    let contentLen = tls.innerParse(inner, innerLen, typeOut);     // strip type byte + padding
    bytes.free(typeOut);

    let leafBuf: ptr = inner;
    let leafLen = 0;
    let p = 0;
    while (p < contentLen) {
        let mtype = bytes.read_byte(inner, p);
        let mlen = (bytes.read_byte(inner, p + 1) << 16) | (bytes.read_byte(inner, p + 2) << 8)
                 | bytes.read_byte(inner, p + 3);
        let msgLen = 4 + mlen;
        if (mtype == 0x0b) {                         // Certificate
            let clen = (bytes.read_byte(inner, p + 8) << 16) | (bytes.read_byte(inner, p + 9) << 8)
                     | bytes.read_byte(inner, p + 10);
            leafBuf = at(inner, p + 11);
            leafLen = clen;
            trAdd(self, at(inner, p), msgLen);
        } else if (mtype == 0x0f) {                  // CertificateVerify
            let hCert = bytes.alloc(48);
            trHash(self, hCert);       // transcript through Certificate
            let scheme = (bytes.read_byte(inner, p + 4) << 8) | bytes.read_byte(inner, p + 5);
            let siglen = (bytes.read_byte(inner, p + 6) << 8) | bytes.read_byte(inner, p + 7);
            let cert = x509.parseCert(leafBuf, leafLen);
            self.certVerifyOk = handshake.verifyCertificateVerify(cert, scheme, at(inner, p + 8), siglen, hCert, trHashLen(self));
            bytes.free(hCert);
            trAdd(self, at(inner, p), msgLen);
        } else if (mtype == 0x14) {                  // Finished
            let hCV = bytes.alloc(48);
            trHash(self, hCV);         // transcript through CertificateVerify
            self.finishedOk = handshake.verifyFinished(self.kind, self.shs, hCV, at(inner, p + 4));
            bytes.free(hCV);
            trAdd(self, at(inner, p), msgLen);
        } else if (mtype == 0x08) {                  // EncryptedExtensions (carries the ALPN selection)
            self.alpnSel = handshake.parseAlpnSelection(inner, p);
            if (self.offerEarly) { self.earlyAccepted = handshake.serverAcceptedEarlyData(inner, p); }
            let rsl1 = handshake.parseRecordSizeLimit(inner, p); if (rsl1 > 0) { self.sendLimit = rsl1; }
            trAdd(self, at(inner, p), msgLen);
        } else {
            trAdd(self, at(inner, p), msgLen);
        }
        p = p + msgLen;
    }
    bytes.free(inner);
    return self.certVerifyOk && self.finishedOk;
}

fn hsAppend(self: TlsClient, src: ptr, n: int): void {
    if (self.hsLen + n > self.hsCap) {
        let nc = (self.hsLen + n) * 2;
        let nb = bytes.alloc(nc);
        let i = 0;
        while (i < self.hsLen) { bytes.write_byte(nb, i, bytes.read_byte(self.hsBuf, i)); i = i + 1; }
        bytes.free(self.hsBuf);
        self.hsBuf = nb;
        self.hsCap = nc;
    }
    let i = 0;
    while (i < n) { bytes.write_byte(self.hsBuf, self.hsLen + i, bytes.read_byte(src, i)); i = i + 1; }
    self.hsLen = self.hsLen + n;
}

// Feed one decrypted-or-not server record during the handshake. Real servers fragment the flight across
// several records (and may coalesce), so the handshake messages are reassembled in hsBuf and processed as
// each becomes complete. Returns 1 once the server Finished has been processed, 0 if more records are
// needed, or -1 on a decryption failure. Non-handshake records (e.g. a ChangeCipherSpec) are ignored.
pub fn feedHandshake(self: TlsClient, record: ptr, recLen: int): int {
    let rtype = bytes.read_byte(record, 0);
    if (rtype != 0x17) { return 0; }               // e.g. ChangeCipherSpec, skip
    let inner = bytes.alloc(recLen);
    let innerLen = tls.recordUnprotect(self.suite, self.sKey, self.sIv, self.sSeq, record, recLen, inner);
    self.sSeq = self.sSeq + 1;
    if (innerLen < 0) { bytes.free(inner); return -1; }
    let typeOut = bytes.alloc(1);
    let contentLen = tls.innerParse(inner, innerLen, typeOut);
    let ctype = bytes.read_byte(typeOut, 0);
    bytes.free(typeOut);
    if (ctype == 0x16) { hsAppend(self, inner, contentLen); }
    bytes.free(inner);

    let done = 0;
    while (self.hsPos + 4 <= self.hsLen) {
        let mlen = (bytes.read_byte(self.hsBuf, self.hsPos + 1) << 16)
                 | (bytes.read_byte(self.hsBuf, self.hsPos + 2) << 8)
                 | bytes.read_byte(self.hsBuf, self.hsPos + 3);
        let msgLen = 4 + mlen;
        if (self.hsPos + msgLen > self.hsLen) { return done; }   // message not fully received yet
        let mtype = bytes.read_byte(self.hsBuf, self.hsPos);
        let mp = self.hsPos;
        if (mtype == 0x0b) {                       // Certificate
            self.certListLen = (bytes.read_byte(self.hsBuf, mp + 5) << 16) | (bytes.read_byte(self.hsBuf, mp + 6) << 8)
                             | bytes.read_byte(self.hsBuf, mp + 7);
            self.certListOff = mp + 8;             // start of the first CertificateEntry
            let clen = (bytes.read_byte(self.hsBuf, mp + 8) << 16) | (bytes.read_byte(self.hsBuf, mp + 9) << 8)
                     | bytes.read_byte(self.hsBuf, mp + 10);
            self.leafOff = mp + 11;
            self.leafLen = clen;
            trAdd(self, at(self.hsBuf, mp), msgLen);
        } else if (mtype == 0x0f) {                // CertificateVerify
            let hCert = bytes.alloc(48);
            trHash(self, hCert);
            let scheme = (bytes.read_byte(self.hsBuf, mp + 4) << 8) | bytes.read_byte(self.hsBuf, mp + 5);
            let siglen = (bytes.read_byte(self.hsBuf, mp + 6) << 8) | bytes.read_byte(self.hsBuf, mp + 7);
            let cert = x509.parseCert(at(self.hsBuf, self.leafOff), self.leafLen);
            self.certVerifyOk = handshake.verifyCertificateVerify(cert, scheme, at(self.hsBuf, mp + 8), siglen, hCert, trHashLen(self));
            bytes.free(hCert);
            trAdd(self, at(self.hsBuf, mp), msgLen);
        } else if (mtype == 0x14) {                // Finished
            let hCV = bytes.alloc(48);
            trHash(self, hCV);
            self.finishedOk = handshake.verifyFinished(self.kind, self.shs, hCV, at(self.hsBuf, mp + 4));
            bytes.free(hCV);
            trAdd(self, at(self.hsBuf, mp), msgLen);
            done = 1;
        } else if (mtype == 0x08) {                // EncryptedExtensions (carries the ALPN selection)
            self.alpnSel = handshake.parseAlpnSelection(self.hsBuf, mp);
            if (self.offerEarly) { self.earlyAccepted = handshake.serverAcceptedEarlyData(self.hsBuf, mp); }
            let rsl2 = handshake.parseRecordSizeLimit(self.hsBuf, mp); if (rsl2 > 0) { self.sendLimit = rsl2; }
            trAdd(self, at(self.hsBuf, mp), msgLen);
        } else {
            trAdd(self, at(self.hsBuf, mp), msgLen);
        }
        self.hsPos = self.hsPos + msgLen;
    }
    return done;
}

// Derive the application traffic secrets and keys over the transcript through the SERVER Finished. Call
// this before any EndOfEarlyData is added (the application secrets must not cover it).
pub fn deriveAppSecrets(self: TlsClient): void {
    let hSF = bytes.alloc(48);
    trHash(self, hSF);                 // transcript through server Finished
    handshake.masterSecret(self.kind, self.hs, self.master);
    tls.deriveTraffic(self.kind, self.master, "c ap traffic", hSF, self.cap);
    tls.deriveTraffic(self.kind, self.master, "s ap traffic", hSF, self.sap);
    tls.deriveKeyIv(self.kind, self.suite, self.cap, self.capKey, self.capIv);
    tls.deriveKeyIv(self.kind, self.suite, self.sap, self.sapKey, self.sapIv);
    bytes.free(hSF);
}

// Compute the client Finished verify_data over the CURRENT transcript (through the server Finished, or
// through EndOfEarlyData for an accepted 0-RTT), keyed by the client handshake traffic secret, then close
// the transcript with the client Finished and derive resumption_master_secret. deriveAppSecrets() must
// have been called first. Writes verify_data (hashLen bytes) to vdOut.
pub fn clientFinished(self: TlsClient, vdOut: ptr): void {
    let hl = trHashLen(self);
    let hCtx = bytes.alloc(48);
    trHash(self, hCtx);
    handshake.finishedVerifyData(self.kind, self.chs, hCtx, vdOut);
    bytes.free(hCtx);

    // resumption_master_secret = Derive-Secret(master, "res master", ClientHello...client Finished).
    let cf = bytes.alloc(4 + hl);
    bytes.write_byte(cf, 0, 0x14); bytes.write_byte(cf, 1, 0); bytes.write_byte(cf, 2, 0); bytes.write_byte(cf, 3, hl);
    let ci = 0;
    while (ci < hl) { bytes.write_byte(cf, 4 + ci, bytes.read_byte(vdOut, ci)); ci = ci + 1; }
    trAdd(self, cf, 4 + hl);
    let hCF = bytes.alloc(hl);
    trHash(self, hCF);
    tls.deriveResMaster(self.kind, self.master, hCF, self.resMaster);
    bytes.free(cf); bytes.free(hCF);
}

// Wrap the client Finished verify_data as an encrypted handshake record (using the client handshake
// key/IV/sequence), written to out; returns the record length. verifyData is the 32-byte value from
// clientFinished. The message is 14 00 00 20 || verify_data.
pub fn clientFinishedRecord(self: TlsClient, verifyData: ptr, out: ptr): int {
    let hl = trHashLen(self);
    let msg = bytes.alloc(4 + hl);
    bytes.write_byte(msg, 0, 0x14);
    bytes.write_byte(msg, 1, 0);
    bytes.write_byte(msg, 2, 0);
    bytes.write_byte(msg, 3, hl);
    let i = 0;
    while (i < hl) { bytes.write_byte(msg, 4 + i, bytes.read_byte(verifyData, i)); i = i + 1; }
    let n = tls.recordProtect(self.suite, self.cKey, self.cIv, self.cSeq, msg, 4 + hl, 0x16, out);
    bytes.free(msg);
    // Switching to application keys resets both record sequence numbers to 0 (RFC 8446 section 5.3).
    self.cSeq = 0;
    self.sSeq = 0;
    return n;
}

// Encrypt application data as a TLSCiphertext record with the client application key (content type
// 0x17). Returns the record length.
pub fn encryptApp(self: TlsClient, data: ptr, dataLen: int, out: ptr): int {
    let n = tls.recordProtect(self.suite, self.capKey, self.capIv, self.cSeq, data, dataLen, 0x17, out);
    self.cSeq = self.cSeq + 1;
    return n;
}

// Encrypt an Alert (RFC 8446 section 6): a 2-byte {level, description} body under the application key
// with inner content type 0x15. Used to send close_notify (level 1 warning, description 0) at shutdown.
pub fn encryptAlert(self: TlsClient, level: int, desc: int, out: ptr): int {
    let a = bytes.alloc(2);
    bytes.write_byte(a, 0, level); bytes.write_byte(a, 1, desc);
    let n = tls.recordProtect(self.suite, self.capKey, self.capIv, self.cSeq, a, 2, 0x15, out);
    self.cSeq = self.cSeq + 1;
    bytes.free(a);
    return n;
}

// ---- KeyUpdate (RFC 8446 section 4.6.3 / 7.2) ----

// Rotate the SERVER application traffic secret to the next generation, re-derive the read key/IV, and
// reset the server record sequence to 0. Call this after a server KeyUpdate is received (the record that
// carried it was decrypted under the previous key).
pub fn updateServerKey(self: TlsClient): void {
    let ns = bytes.alloc(48);
    tls.deriveTrafficUpdate(self.kind, self.sap, ns);
    let i = 0;
    while (i < 48) { bytes.write_byte(self.sap, i, bytes.read_byte(ns, i)); i = i + 1; }
    bytes.free(ns);
    tls.deriveKeyIv(self.kind, self.suite, self.sap, self.sapKey, self.sapIv);
    self.sSeq = 0;
}

// Rotate the CLIENT application traffic secret to the next generation, re-derive the write key/IV, and
// reset the client record sequence to 0. Call this AFTER sending our own KeyUpdate (the sender switches
// to the next-generation keys only after the KeyUpdate has been sent).
pub fn updateClientKey(self: TlsClient): void {
    let ns = bytes.alloc(48);
    tls.deriveTrafficUpdate(self.kind, self.cap, ns);
    let i = 0;
    while (i < 48) { bytes.write_byte(self.cap, i, bytes.read_byte(ns, i)); i = i + 1; }
    bytes.free(ns);
    tls.deriveKeyIv(self.kind, self.suite, self.cap, self.capKey, self.capIv);
    self.cSeq = 0;
}

// Build and encrypt a KeyUpdate handshake message (content type 0x16) under the CURRENT client app key.
// request is 0 (update_not_requested) or 1 (update_requested). The caller must call updateClientKey()
// afterwards to switch its send key to the next generation.
pub fn keyUpdateRecord(self: TlsClient, request: int, out: ptr): int {
    let msg = bytes.alloc(5);
    bytes.write_byte(msg, 0, 0x18);                // handshake type: key_update
    bytes.write_byte(msg, 1, 0); bytes.write_byte(msg, 2, 0); bytes.write_byte(msg, 3, 1);   // length 1
    bytes.write_byte(msg, 4, request);
    let n = tls.recordProtect(self.suite, self.capKey, self.capIv, self.cSeq, msg, 5, 0x16, out);
    self.cSeq = self.cSeq + 1;
    bytes.free(msg);
    return n;
}

// Decrypt an application-data record with the server application key. Returns the inner plaintext length
// (including the trailing content-type byte), or -1 on failure.
pub fn decryptApp(self: TlsClient, record: ptr, recLen: int, out: ptr): int {
    let n = tls.recordUnprotect(self.suite, self.sapKey, self.sapIv, self.sSeq, record, recLen, out);
    self.sSeq = self.sSeq + 1;
    return n;
}

// Trust decision: validate the server's certificate chain (captured during the handshake) against a
// trusted root, for `host` at `now` (a YYYYMMDDHHMMSS number). This is separate from the handshake's
// CertificateVerify check (which only proves the server holds the leaf key); call it after the handshake
// to decide whether to trust the leaf. Returns true iff the chain is trusted.
pub fn verifyServerChain(self: TlsClient, rootDer: ptr, rootLen: int, host: string, now: long): bool {
    if (self.certListLen <= 0) { return false; }
    return x509.verifyCertList(at(self.hsBuf, self.certListOff), self.certListLen, rootDer, rootLen, host, now);
}

// The captured server certificate_list (for verifying against a multi-root trust store). The pointer math
// is inlined rather than via the local `at` helper: a public fn that RETURNS at(...) trips a name clash
// with serde/json's `at` (JsonValue) when both are in one compile graph (e.g. web/client).
pub fn certListPtr(self: TlsClient): ptr { return (self.hsBuf as long + self.certListOff) as ptr; }
pub fn certListSize(self: TlsClient): int { return self.certListLen; }

// The ALPN protocol the server selected in EncryptedExtensions, or "" if none was negotiated.
pub fn selectedAlpn(self: TlsClient): string { return self.alpnSel; }

// Hash of the current running transcript with the negotiated suite hash (exposed for tests / diagnostics).
pub fn transcriptHashInto(self: TlsClient, out: ptr): void { trHash(self, out); }

// ---- resumption (RFC 8446 2.2, 4.2.11, 4.6.1) ----

// Compute and write the PSK binder into a resumption ClientHello that buildClientHelloEx left zeroed.
// The binder is HMAC(finished_key, Transcript-Hash(truncated ClientHello)), where the truncation removes
// the binder entry (its value and 1-byte length) but keeps everything up to the binders-list length. The
// transcript also includes any prior handshake messages (empty for a first-flight resumption).
pub fn fillResumptionBinder(self: TlsClient, out: ptr, chLen: int): void {
    let hl = trHashLen(self);
    // Truncate() ends "up to and including the identities field" (RFC 8446 4.2.11.2): exclude the binder
    // value (hl), its 1-byte length, AND the 2-byte binders-list length.
    let truncLen = chLen - hl - 3;
    let tmp = bytes.alloc(self.trLen + truncLen);
    let i = 0;
    while (i < self.trLen) { bytes.write_byte(tmp, i, bytes.read_byte(self.trBuf, i)); i = i + 1; }
    let j = 0;
    while (j < truncLen) { bytes.write_byte(tmp, self.trLen + j, bytes.read_byte(out, j)); j = j + 1; }
    let th = bytes.alloc(hl);
    if (self.kind == 1) { sha512.hash384Into(tmp, self.trLen + truncLen, th); }
    else { sha256.hashInto(tmp, self.trLen + truncLen, th); }
    let es = bytes.alloc(hl); tls.earlySecretPsk(self.kind, self.ticketPsk, hl, es);
    let bk = bytes.alloc(hl); tls.deriveResBinderKey(self.kind, es, bk);
    let fk = bytes.alloc(hl); handshake.finishedKey(self.kind, bk, fk);
    let binder = bytes.alloc(hl);
    if (self.kind == 1) { hmac.hmacSha384(fk, hl, th, hl, binder); }
    else { hmac.hmacSha256(fk, hl, th, hl, binder); }
    let k = 0;
    while (k < hl) { bytes.write_byte(out, chLen - hl + k, bytes.read_byte(binder, k)); k = k + 1; }
    bytes.free(tmp); bytes.free(th); bytes.free(es); bytes.free(bk); bytes.free(fk); bytes.free(binder);
}

// Parse a NewSessionTicket (RFC 8446 4.6.1) and derive its PSK from resumption_master_secret. `buf` holds
// the handshake message and `off` its start (the 0x04 type byte). Stores the ticket, PSK, and
// ticket_age_add for a later resumption; getters below hand them to a session cache.
pub fn parseNewSessionTicket(self: TlsClient, buf: ptr, off: int): void {
    let p = off + 4;                               // skip handshake header
    p = p + 4;                                     // ticket_lifetime (unused here)
    let ageAdd = ((bytes.read_byte(buf, p) as long) << 24) | ((bytes.read_byte(buf, p + 1) as long) << 16)
               | ((bytes.read_byte(buf, p + 2) as long) << 8) | (bytes.read_byte(buf, p + 3) as long);
    p = p + 4;
    let nonceLen = bytes.read_byte(buf, p); p = p + 1;
    let noncePos = p; p = p + nonceLen;
    let tlen = (bytes.read_byte(buf, p) << 8) | bytes.read_byte(buf, p + 1); p = p + 2;
    let tpos = p;
    bytes.free(self.ticket);
    self.ticket = bytes.alloc(tlen);
    let i = 0;
    while (i < tlen) { bytes.write_byte(self.ticket, i, bytes.read_byte(buf, tpos + i)); i = i + 1; }
    self.ticketLen = tlen;
    self.ticketAgeAdd = ageAdd;
    self.ticketKind = self.kind;
    tls.deriveResumptionPsk(self.kind, self.resMaster, (buf as long + noncePos) as ptr, nonceLen, self.ticketPsk);
    self.haveTicket = true;
}

pub fn ticketPtr(self: TlsClient): ptr { return self.ticket; }
pub fn ticketSize(self: TlsClient): int { return self.ticketLen; }
pub fn ticketPskPtr(self: TlsClient): ptr { return self.ticketPsk; }
pub fn ticketAge(self: TlsClient): long { return self.ticketAgeAdd; }
pub fn ticketHashKind(self: TlsClient): int { return self.ticketKind; }
pub fn hasTicket(self: TlsClient): bool { return self.haveTicket; }
pub fn pskWasAccepted(self: TlsClient): bool { return self.pskAccepted; }

// ---- 0-RTT early data (RFC 8446 2.3, 4.2.10) ----

// Derive the client_early_traffic key/IV from the resumption PSK and the ClientHello transcript hash.
// Call after addClientHello (so the transcript is exactly the ClientHello). Sets offerEarly.
pub fn deriveEarlyKeys(self: TlsClient): void {
    let hl = trHashLen(self);
    let es = bytes.alloc(hl); tls.earlySecretPsk(self.kind, self.ticketPsk, hl, es);
    let chHash = bytes.alloc(hl); trHash(self, chHash);
    let cet = bytes.alloc(hl); tls.deriveEarlyTraffic(self.kind, es, chHash, cet);
    tls.deriveKeyIv(self.kind, self.suite, cet, self.eKey, self.eIv);
    self.eSeq = 0;
    self.offerEarly = true;
    bytes.free(es); bytes.free(chHash); bytes.free(cet);
}

// Encrypt 0-RTT application data with the client_early_traffic key (content type 0x17). Returns the
// record length. Sent right after the ClientHello, before the handshake completes.
pub fn encryptEarly(self: TlsClient, data: ptr, dataLen: int, out: ptr): int {
    let n = tls.recordProtect(self.suite, self.eKey, self.eIv, self.eSeq, data, dataLen, 0x17, out);
    self.eSeq = self.eSeq + 1;
    return n;
}

// Build+encrypt EndOfEarlyData (handshake type 0x05, empty body) under the client_early_traffic key
// (RFC 8446 2.3 legend: EndOfEarlyData uses the 0-RTT keys), and add it to the transcript. Sent after the
// server flight and before the client Finished when 0-RTT was accepted. Returns the record length.
pub fn endOfEarlyDataRecord(self: TlsClient, out: ptr): int {
    let msg = bytes.alloc(4);
    bytes.write_byte(msg, 0, 0x05); bytes.write_byte(msg, 1, 0); bytes.write_byte(msg, 2, 0); bytes.write_byte(msg, 3, 0);
    trAdd(self, msg, 4);
    let n = tls.recordProtect(self.suite, self.eKey, self.eIv, self.eSeq, msg, 4, 0x16, out);
    self.eSeq = self.eSeq + 1;
    bytes.free(msg);
    return n;
}

pub fn earlyWasAccepted(self: TlsClient): bool { return self.earlyAccepted; }
