// orch/nativelet.nova — the node agent (I2 native orchestrator, native-k8s MVP).
//
// Watches a manifest directory of JSON Specs and RECONCILES desired state against actual: it starts a
// Supervisor for each new manifest, restarts a workload whose spec changed, polls running ones to
// restart crashed replicas, and stops workloads whose manifest was deleted. One async coroutine drives
// the whole loop (non-blocking supervisors) — no thread per workload, unlike the Zig PoC.
//
//   let n = nativelet.Nativelet("manifests");
//   let _ = nativelet.run(n, 2000);        // reconcile every 2s, forever

import orch.spec;
import orch.supervisor;
import io.dir;
import io.file;
import list;
import string;
import net.asyncio;

// One scanned manifest file: its filename-stem key, the parsed spec, and whether the parse succeeded.
// valid=false means the file exists but couldn't be read/parsed THIS tick (keep, don't delete).
pub struct Manifest {
    pub key: string,
    pub spec: spec.Spec,
    pub valid: bool,
    init(key: string, sp: spec.Spec, valid: bool) {
        self.key = key;
        self.spec = sp;
        self.valid = valid;
    }
}

pub struct Job {
    pub name: string,
    pub sup: supervisor.Supervisor,
    pub desired: spec.Spec,     // the spec this supervisor was started from (for change detection)
    init(name: string, sup: supervisor.Supervisor, desired: spec.Spec) {
        self.name = name;
        self.sup = sup;
        self.desired = desired;
    }
}

pub struct Nativelet {
    pub manifestsDir: string,
    // Jobs keyed by name via linear scan (workloads are few; a Map<string,Job> mono-miscompiles a
    // cross-module struct value, and a list keeps ordering deterministic for reconcile anyway).
    pub jobs: list.List<Job>,
    // Propagated to every Supervisor: false in tests so reconcile logic runs without spawning binaries.
    pub manageProcesses: bool,
    init(manifestsDir: string) {
        self.manifestsDir = manifestsDir;
        self.jobs = list.List<Job>();
        self.manageProcesses = true;
    }

    pub fn findJobIdx(self: Nativelet, name: string): int {   // index or -1
        let i = 0;
        while (i < self.jobs.size()) {
            if (string.eql((self.jobs.get(i) ?? Job("", supervisor.Supervisor(spec.Spec("", "")), spec.Spec("", ""))).name, name)) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    // Scan the watch dir: one Manifest per `*.json` file, KEYED BY FILENAME STEM (`web.json` → `web`).
    // Presence comes from the file existing, NOT from a successful parse — a transient unreadable or
    // half-written file (e.g. a read interrupted by SIGCHLD when a child dies) yields a Manifest with
    // valid=false, so reconcile KEEPS the running workload instead of tearing it down. Missing dir →
    // empty list (reconcile then stops everything — an explicit "no desired state").
    pub fn scan(self: Nativelet): list.List<Manifest> {
        let out = list.List<Manifest>();
        if (!dir.Dir.exists(self.manifestsDir)) { return out; }
        let d = dir.Dir.open(self.manifestsDir);
        let names = d.entries();
        d.close();
        let i = 0;
        while (i < names.size()) {
            let nm = names.get(i) ?? "";
            if (string.endsWith(nm, ".json")) {
                let key = string.slice(nm, 0, string.len(nm) - 5);   // strip ".json"
                let text = file.readText(self.manifestsDir + "/" + nm);
                if (string.eql(text, "")) {
                    out.push(Manifest(key, spec.Spec("", ""), false)); // present but unreadable this tick
                } else {
                    let sp = spec.parseSpec(text);
                    out.push(Manifest(key, sp, !string.eql(sp.name, "")));
                }
            }
            i = i + 1;
        }
        return out;
    }

    fn newJob(self: Nativelet, key: string, sp: spec.Spec): void {
        let sup = supervisor.Supervisor(sp);
        sup.manageProcesses = self.manageProcesses;
        sup.start();
        self.jobs.push(Job(key, sup, sp));
    }

    // One reconcile pass: converge running supervisors toward the manifests on disk.
    pub fn reconcile(self: Nativelet): void {
        self.reconcileScan(self.scan());
    }

    // Adapter kept for in-memory tests: treat each Spec as a valid manifest keyed by its own name.
    pub fn reconcileWith(self: Nativelet, desired: list.List<spec.Spec>): void {
        let ms = list.List<Manifest>();
        let i = 0;
        while (i < desired.size()) {
            let sp = desired.get(i) ?? spec.Spec("", "");
            ms.push(Manifest(sp.name, sp, true));
            i = i + 1;
        }
        self.reconcileScan(ms);
    }

    // The reconcile DIFF over scanned manifests: start new, replace changed, poll unchanged, keep the
    // ones that failed to read this tick, and stop only workloads whose FILE is genuinely gone.
    pub fn reconcileScan(self: Nativelet, manifests: list.List<Manifest>): void {
        let presentKeys = list.List<string>();

        let i = 0;
        while (i < manifests.size()) {
            let m = manifests.get(i) ?? Manifest("", spec.Spec("", ""), false);
            presentKeys.push(m.key);                 // file exists → workload is "present" regardless of parse
            let at = self.findJobIdx(m.key);
            if (!m.valid) {
                // Unreadable/half-written this tick: keep an existing workload running (just poll it);
                // can't start a brand-new one without a spec, so skip.
                if (at >= 0) {
                    (self.jobs.get(at) ?? Job("", supervisor.Supervisor(spec.Spec("", "")), spec.Spec("", ""))).sup.poll();
                }
            } else if (at >= 0) {
                let job = self.jobs.get(at) ?? Job("", supervisor.Supervisor(spec.Spec("", "")), spec.Spec("", ""));
                if (!spec.specsEqual(job.desired, m.spec)) {
                    // Spec changed → stop the old supervisor and replace the job with a fresh one.
                    job.sup.stopAll();
                    let sup = supervisor.Supervisor(m.spec);
                    sup.manageProcesses = self.manageProcesses;
                    sup.start();
                    self.jobs.set(at, Job(m.key, sup, m.spec));
                } else {
                    job.sup.poll();                  // unchanged → restart any crashed replicas
                }
            } else {
                self.newJob(m.key, m.spec);
            }
            i = i + 1;
        }

        // Stop workloads whose manifest FILE was removed (present-but-unreadable ones stay, since their
        // key IS in presentKeys). Iterate + mutate in place.
        let j = 0;
        while (j < self.jobs.size()) {
            let job = self.jobs.get(j) ?? Job("", supervisor.Supervisor(spec.Spec("", "")), spec.Spec("", ""));
            if (!nameIn(presentKeys, job.name)) {
                job.sup.stopAll();
                self.jobs.remove(j);           // don't advance j — the next job shifted into this slot
            } else {
                j = j + 1;
            }
        }
    }

    // Total replicas running across all workloads (observability / test signal).
    pub fn totalRunning(self: Nativelet): int {
        let sum = 0;
        let j = 0;
        while (j < self.jobs.size()) {
            sum = sum + (self.jobs.get(j) ?? Job("", supervisor.Supervisor(spec.Spec("", "")), spec.Spec("", ""))).sup.running();
            j = j + 1;
        }
        return sum;
    }

    // Stop every workload (graceful). For daemon shutdown.
    pub fn shutdown(self: Nativelet): void {
        while (self.jobs.size() > 0) {
            let idx = self.jobs.size() - 1;
            (self.jobs.get(idx) ?? Job("", supervisor.Supervisor(spec.Spec("", "")), spec.Spec("", ""))).sup.stopAll();
            self.jobs.remove(idx);
        }
    }
}

fn nameIn(names: list.List<string>, target: string): bool {
    let i = 0;
    while (i < names.size()) {
        if (string.eql(names.get(i) ?? "", target)) { return true; }
        i = i + 1;
    }
    return false;
}

// The reconcile daemon: reconcile every `intervalMs`, forever. Runs as one coroutine — spawn it or call
// it from an async entry after holdReactors().
pub async fn run(n: Nativelet, intervalMs: int): int {
    while (true) {
        n.reconcile();
        let _ = await asyncio.sleep(intervalMs);
    }
    return 0;
}
