// orch/autoscaler.nova — PID-controller autoscaling for a supervised workload (I2), reusing the I1
// controller (net/autoscale.PidController). It regulates a live metric (default: the workload cgroup's
// CPU utilisation) to a setpoint by driving spec.replicas, which the Supervisor's ensureReplicas then
// spawns/trims toward. Same anti-windup + clamp + direct-acting controller proven for the proxy; only
// the actuation differs (spec.replicas + ensureReplicas instead of proxy pool slots).
//
//   let ws = autoscaler.WorkloadScaler(job.sup, 1, 8, 60.0);  // 1..8 replicas, target 60% CPU
//   ws.tick(cpuPercent, dtSeconds);                            // each control interval

import net.autoscale;
import orch.supervisor;
import orch.spec;
import orch.isolation;
import math;

pub struct WorkloadScaler {
    pub sup: supervisor.Supervisor,
    pub pid: autoscale.PidController,
    pub minReplicas: int,
    pub maxReplicas: int,
    // CPU-rate sampling state (Linux cgroup): last usage_usec + whether we have a baseline yet.
    pub lastUsageUsec: long,
    pub haveSample: bool,
    init(sup: supervisor.Supervisor, minReplicas: int, maxReplicas: int, setpoint: double) {
        self.sup = sup;
        // Reuse I1's PID: gentle P + I for a steady base count, no D (metrics are noisy). Direct-acting
        // (more load ⇒ more replicas); output clamped to the replica band; integral clamped for anti-windup.
        self.pid = autoscale.PidController(0.5, 0.1, 0.0, setpoint);
        self.pid.setDirectActing(true);
        self.minReplicas = if (minReplicas < 1) 1 else minReplicas;
        self.maxReplicas = if (maxReplicas < self.minReplicas) self.minReplicas else maxReplicas;
        self.pid.setOutputLimits(self.minReplicas as double, self.maxReplicas as double);
        self.pid.setIntegralLimits(0.0, self.maxReplicas as double);
        self.lastUsageUsec = 0;
        self.haveSample = false;
    }

    pub fn configure(self: WorkloadScaler, kp: double, ki: double, kd: double, setpoint: double): void {
        self.pid.kp = kp; self.pid.ki = ki; self.pid.kd = kd; self.pid.setpoint = setpoint;
    }

    // Turn a raw metric sample into a desired replica count (PID → round → clamp). Deterministic, so it
    // is unit-testable independent of any live workload.
    pub fn decide(self: WorkloadScaler, metric: double, dt: double): int {
        let out = self.pid.update(metric, dt);
        return math.clamp(math.fround(out) as int, self.minReplicas, self.maxReplicas);
    }

    // One control step from an explicit metric: compute the desired replica count and drive the workload
    // toward it (updates spec.replicas; ensureReplicas spawns/trims). Returns the new target.
    pub fn tick(self: WorkloadScaler, metric: double, dt: double): int {
        let desired = self.decide(metric, dt);
        self.sup.spec.replicas = desired;
        self.sup.ensureReplicas();
        return desired;
    }

    // Sample CPU utilisation (%) of the workload cgroup over `dt` seconds since the last sample, then
    // actuate. The FIRST call only establishes a baseline (needs two readings to form a rate) and makes
    // no change. Linux-only (cgroup cpu.stat); where unavailable it holds the current replica count.
    // utilisation% = (Δusage_usec / (dt · 1e6)) · 100  — 100% ≈ one fully-busy core.
    pub fn tickCpu(self: WorkloadScaler, dt: double): int {
        let usage = isolation.cpuUsageUsec(self.sup.spec.name);
        if (usage < 0) { return self.sup.spec.replicas; }        // no cgroup metric → hold
        if (!self.haveSample) {
            self.lastUsageUsec = usage;
            self.haveSample = true;
            return self.sup.spec.replicas;                        // baseline only
        }
        let delta = usage - self.lastUsageUsec;
        self.lastUsageUsec = usage;
        let deltaD = if (delta < 0) 0.0 else delta as double;
        let pct = (deltaD / (dt * 1000000.0)) * 100.0;
        return self.tick(pct, dt);
    }
}
