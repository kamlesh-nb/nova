// orch/supervisor.nova — keeps ONE workload's replica set running (I2 native orchestrator).
//
// A Supervisor owns N replica processes for a Spec. It is driven by the nativelet's reconcile loop (no
// per-supervisor thread, unlike the Zig PoC): every tick, `poll()` reaps exited replicas and restarts
// them per the Spec's restart policy, and `ensureReplicas()` tops up / trims to the desired count.
// Non-blocking throughout — it uses Process.tryWait (waitpid WNOHANG), never the blocking wait, so a
// single async reconcile coroutine can supervise many workloads. Graceful stop is SIGTERM → brief grace
// → SIGKILL.

import process;
import list;
import string;
import orch.spec;
import orch.isolation;

pub struct Supervisor {
    pub spec: spec.Spec,
    pub procs: list.List<process.Process>,  // live replica processes
    // Rolling count of restarts performed (observability / test signal).
    pub restarts: int,
    // When false (tests), the lifecycle methods manipulate no real processes — they no-op so the pure
    // policy logic can be exercised without spawning binaries.
    pub manageProcesses: bool,
    init(sp: spec.Spec) {
        self.spec = sp;
        self.procs = list.List<process.Process>();
        self.restarts = 0;
        self.manageProcesses = true;
    }

    fn spawnOne(self: Supervisor): void {
        if (!self.manageProcesses) { return; }
        let p = process.Process.spawn(self.spec.binaryPath, self.spec.args);
        // Apply cgroups-v2 limits (Linux; best-effort no-op elsewhere) to the freshly-spawned child.
        let _ = isolation.applyLimits(self.spec, p.pid());
        self.procs.push(p);
    }

    // SIGTERM a replica, give it a brief grace window (polling for exit), then SIGKILL if still alive,
    // reap, and free. Blocking wait is avoided — the grace loop polls tryWait.
    fn stopProc(self: Supervisor, p: process.Process): void {
        let _ = p.terminate();                 // SIGTERM
        let tries = 0;
        while (tries < 50) {                   // ~50 polls; caller paces via reconcile cadence anyway
            if (p.tryWait() != -2) { break; }  // exited
            tries = tries + 1;
        }
        if (p.tryWait() == -2) { let _ = p.forceKill(); }  // still alive → SIGKILL
        let _ = p.wait();                       // reap (returns immediately once dead)
        p.close();
    }

    fn killLast(self: Supervisor): void {
        let n = self.procs.size();
        if (n == 0) { return; }
        let idx = n - 1;
        if (self.manageProcesses) {
            let p = self.procs.get(idx) ?? process.Process.spawn("/bin/true", list.List<string>());
            self.stopProc(p);
        }
        self.procs.remove(idx);
    }

    // Bring the running replica count to spec.replicas (spawn up, stop down). Called on start and on any
    // scale change.
    pub fn ensureReplicas(self: Supervisor): void {
        if (!self.manageProcesses) { return; }
        while (self.procs.size() < self.spec.replicas) { self.spawnOne(); }
        while (self.procs.size() > self.spec.replicas) { self.killLast(); }
    }

    pub fn start(self: Supervisor): void { self.ensureReplicas(); }

    // Reap any exited replicas and restart them per policy. Non-blocking (tryWait). A replica that exits
    // under an "always"/"on-failure" policy is replaced (counting a restart); under "never" it stays
    // gone. After reaping, top back up to spec.replicas for restart policies (a crash under "always"
    // must return to N even if several died at once).
    pub fn poll(self: Supervisor): void {
        if (!self.manageProcesses) { return; }
        let i = 0;
        while (i < self.procs.size()) {
            let p = self.procs.get(i) ?? process.Process.spawn("/bin/true", list.List<string>());
            let st = p.tryWait();
            if (st == -2) {
                i = i + 1;                       // still running
            } else {
                // exited (st = code) or errored (-1) → reap + drop this slot
                p.close();
                self.procs.remove(i);
                if (spec.shouldRestart(self.spec.restartPolicy, st)) {
                    self.spawnOne();             // replace (pushed at the end; don't advance i)
                    self.restarts = self.restarts + 1;
                }
                // i unchanged: re-examine the element that shifted into this slot
            }
        }
    }

    // Stop ALL replicas (graceful). Leaves procs empty.
    pub fn stopAll(self: Supervisor): void {
        if (self.manageProcesses) {
            while (self.procs.size() > 0) { self.killLast(); }
        } else {
            while (self.procs.size() > 0) { self.procs.remove(self.procs.size() - 1); }
        }
    }

    pub fn running(self: Supervisor): int { return self.procs.size(); }
}
