
import list;
import string;

pub enum DbType {
    Null,
    Bool,
    Int4,
    Int8,
    Uint4,
    Uint8,
    Float4,
    Float8,
    Timestamp,
    Text,
    Blob,
    Decimal,
    Uuid,
    Json,
    Array,
}

pub struct DbValue {
    pub kind: DbType,
    pub i: long,
    pub f: double,
    pub dec: decimal,
    pub s: string,
    pub arr: List<DbValue>,   // element values when kind == Array (empty otherwise)

    init(kind: DbType, i: long, f: double, dec: decimal, s: string) {
        self.kind = kind;
        self.i = i;
        self.f = f;
        self.dec = dec;
        self.s = s;
        self.arr = List<DbValue>();
    }

    // Fluent: attach array elements. Returns self so `dbArray` composes without a second init.
    pub fn withArr(self: DbValue, elems: List<DbValue>): DbValue { self.arr = elems; return self; }

    pub fn isNull(self: DbValue): bool { return self.kind == DbType.Null; }
    pub fn asBool(self: DbValue): bool { return self.i != 0; }
    pub fn asInt(self: DbValue): int { return self.i as int; }
    pub fn asLong(self: DbValue): long { return self.i; }
    pub fn asDouble(self: DbValue): double { return self.f; }
    pub fn asDecimal(self: DbValue): decimal { return self.dec; }
    pub fn asText(self: DbValue): string { return self.s; }
    // Temporal values are carried as their normalized ISO-8601 text (in `s`) under DbType.Timestamp,
    // so a driver never lossily forces a date string through parseI64. asTimestamp == asText.
    pub fn asTimestamp(self: DbValue): string { return self.s; }
    pub fn asUuid(self: DbValue): string { return self.s; }   // canonical UUID string
    pub fn asJson(self: DbValue): string { return self.s; }   // raw JSON text
    pub fn asArray(self: DbValue): List<DbValue> { return self.arr; }   // element values (kind == Array)
    pub fn arrayLen(self: DbValue): int { return self.arr.size(); }

    // NULL-aware accessors: return the supplied default when the value is SQL NULL, instead of the
    // silent 0/"" the plain accessors give (which cannot distinguish NULL from a real 0 / empty string).
    pub fn asIntOr(self: DbValue, dflt: int): int { if (self.isNull()) { return dflt; } return self.i as int; }
    pub fn asLongOr(self: DbValue, dflt: long): long { if (self.isNull()) { return dflt; } return self.i; }
    pub fn asDoubleOr(self: DbValue, dflt: double): double { if (self.isNull()) { return dflt; } return self.f; }
    pub fn asTextOr(self: DbValue, dflt: string): string { if (self.isNull()) { return dflt; } return self.s; }
    pub fn asBoolOr(self: DbValue, dflt: bool): bool { if (self.isNull()) { return dflt; } return self.i != 0; }
}

pub fn dbNull(): DbValue { return DbValue(DbType.Null, 0, 0.0, 0m, ""); }
pub fn dbBool(b: bool): DbValue { return DbValue(DbType.Bool, b ? 1 : 0, 0.0, 0m, ""); }
pub fn dbInt(n: int): DbValue { return DbValue(DbType.Int4, n, 0.0, 0m, ""); }
pub fn dbLong(n: long): DbValue { return DbValue(DbType.Int8, n, 0.0, 0m, ""); }
pub fn dbDouble(d: double): DbValue { return DbValue(DbType.Float8, 0, d, 0m, ""); }
pub fn dbDecimal(d: decimal): DbValue { return DbValue(DbType.Decimal, 0, 0.0, d, ""); }
pub fn dbText(s: string): DbValue { return DbValue(DbType.Text, 0, 0.0, 0m, s); }
pub fn dbBlob(s: string): DbValue { return DbValue(DbType.Blob, 0, 0.0, 0m, s); }
// A temporal value as normalized ISO-8601 text (date / time / timestamp / timestamptz).
pub fn dbTimestamp(iso: string): DbValue { return DbValue(DbType.Timestamp, 0, 0.0, 0m, iso); }
// A UUID as its canonical 8-4-4-4-12 string, and a JSON/JSONB value as raw text.
pub fn dbUuid(s: string): DbValue { return DbValue(DbType.Uuid, 0, 0.0, 0m, s); }
pub fn dbJson(s: string): DbValue { return DbValue(DbType.Json, 0, 0.0, 0m, s); }
pub fn dbArray(elems: List<DbValue>): DbValue { return DbValue(DbType.Array, 0, 0.0, 0m, "").withArr(elems); }

pub struct Column {
    pub name: string,
    pub type_oid: DbType,
    init(name: string, type_oid: DbType) {
        self.name = name;
        self.type_oid = type_oid;
    }
}

pub struct Row {
    pub cells: List<DbValue>,
    init() { self.cells = List<DbValue>(); }

    pub fn size(self: Row): int { return self.cells.size(); }
    pub fn get(self: Row, i: int): DbValue { return self.cells.get(i) ?? dbNull(); }
    pub fn isNull(self: Row, i: int): bool { return self.get(i).isNull(); }
    pub fn getBool(self: Row, i: int): bool { return self.get(i).asBool(); }
    pub fn getInt(self: Row, i: int): int { return self.get(i).asInt(); }
    pub fn getLong(self: Row, i: int): long { return self.get(i).asLong(); }
    pub fn getDouble(self: Row, i: int): double { return self.get(i).asDouble(); }
    pub fn getDecimal(self: Row, i: int): decimal { return self.get(i).asDecimal(); }
    pub fn getText(self: Row, i: int): string { return self.get(i).asText(); }
    pub fn getArray(self: Row, i: int): List<DbValue> { return self.get(i).asArray(); }
    pub fn getTimestamp(self: Row, i: int): string { return self.get(i).asTimestamp(); }
}

// Normalized, cross-driver error categories. Each driver maps its NATIVE code (SQLSTATE string /
// MySQL or TDS number) onto one of these so callers can write portable retry/handling logic
// (`if (err.isDeadlock()) retry;`) without knowing the backend's private code space.
pub const DBERR_UNKNOWN: int = 0;
pub const DBERR_UNIQUE_VIOLATION: int = 1;   // duplicate key
pub const DBERR_NOT_NULL: int = 2;           // NOT NULL constraint
pub const DBERR_FOREIGN_KEY: int = 3;        // FK constraint
pub const DBERR_CHECK: int = 4;              // CHECK constraint
pub const DBERR_DEADLOCK: int = 5;           // deadlock victim (retryable)
pub const DBERR_SERIALIZATION: int = 6;      // serialization failure (retryable)
pub const DBERR_LOCK_TIMEOUT: int = 7;       // lock wait timeout (retryable)
pub const DBERR_SYNTAX: int = 8;             // SQL syntax / undefined object
pub const DBERR_AUTH: int = 9;               // authentication / permission
pub const DBERR_CONNECTION: int = 10;        // connection / network failure (retryable)

pub struct DbError {
    pub code: string,        // native string code (Postgres SQLSTATE, or "" if numeric-only)
    pub message: string,
    pub number: int,         // native numeric code (MySQL/TDS error number; 0 if none)
    pub kind: int,           // normalized DBERR_* category (set by the driver)
    init(code: string, message: string) {
        self.code = code;
        self.message = message;
        self.number = 0;
        self.kind = 0;
    }

    // Fluent enrichment used by drivers after building the base error. Returns self so it composes:
    // `DbError(sqlstate, msg).with(0, db.DBERR_DEADLOCK)`.
    pub fn with(self: DbError, number: int, kind: int): DbError {
        self.number = number;
        self.kind = kind;
        return self;
    }

    pub fn isEmpty(self: DbError): bool { return string.eql(self.code, "") && string.eql(self.message, ""); }
    pub fn isUniqueViolation(self: DbError): bool { return self.kind == DBERR_UNIQUE_VIOLATION; }
    pub fn isDeadlock(self: DbError): bool { return self.kind == DBERR_DEADLOCK; }
    // Transient failures worth an automatic retry (deadlock, serialization, lock timeout, connection loss).
    pub fn isTransient(self: DbError): bool {
        return self.kind == DBERR_DEADLOCK || self.kind == DBERR_SERIALIZATION
            || self.kind == DBERR_LOCK_TIMEOUT || self.kind == DBERR_CONNECTION;
    }
}

pub fn noError(): DbError { return DbError("", ""); }

pub struct ResultSet {
    pub columns: List<Column>,
    pub rows: List<Row>,
    pub tag: string,
    pub rows_affected: long,
    // The server-reported error for this statement, or noError() on success. Drivers populate it from
    // their wire ErrorResponse decoder; callers check `rs.ok()` / read `rs.err`. Defaulting to noError()
    // keeps existing `ResultSet()` construction and error-ignoring callers source-compatible.
    pub err: DbError,
    // Additional result sets beyond this one, in order, when a single batch / stored procedure returned
    // more than one SELECT. Empty for the common single-result case, so existing callers are unaffected.
    pub more: List<ResultSet>,

    init() {
        self.columns = List<Column>();
        self.rows = List<Row>();
        self.tag = "";
        self.rows_affected = 0;
        self.err = noError();
        self.more = List<ResultSet>();
    }

    pub fn rowCount(self: ResultSet): int { return self.rows.size(); }
    pub fn colCount(self: ResultSet): int { return self.columns.size(); }
    pub fn row(self: ResultSet, i: int): Row { return self.rows.get(i) ?? Row(); }
    pub fn ok(self: ResultSet): bool { return self.err.isEmpty(); }
    pub fn hasError(self: ResultSet): bool { return !self.err.isEmpty(); }
    // Total number of result sets (this one + any additional). 1 for a normal single-SELECT query.
    pub fn resultSetCount(self: ResultSet): int { return 1 + self.more.size(); }
    // The i-th result set (0 = this one, 1.. = the additional sets from a multi-statement batch).
    pub fn resultSet(self: ResultSet, i: int): ResultSet {
        if (i <= 0) { return self; }
        return self.more.get(i - 1) ?? ResultSet();
    }
}

pub struct ExecResult {
    pub rows_affected: long,
    pub tag: string,
    pub err: DbError,
    init(rows_affected: long, tag: string) {
        self.rows_affected = rows_affected;
        self.tag = tag;
        self.err = noError();
    }

    pub fn ok(self: ExecResult): bool { return self.err.isEmpty(); }
    pub fn hasError(self: ExecResult): bool { return !self.err.isEmpty(); }
}

// Constructors for the error path: a failed statement returns an empty result carrying the DbError.
pub fn errorResult(e: DbError): ResultSet {
    let r = ResultSet();
    r.err = e;
    return r;
}

pub fn errorExec(e: DbError): ExecResult {
    let x = ExecResult(0, "");
    x.err = e;
    return x;
}

// A forward cursor over a result. Today it iterates an already-materialized ResultSet (so it works
// uniformly across every driver without protocol changes), giving callers a streaming-shaped API:
//
//   let cur = db.streamRows(conn.query(sql, params));
//   while (cur.hasNext()) { let row = cur.next(); ... }
//
// True lazy fetch -- pulling rows from the server in batches without materializing the whole set
// (pg portals with Execute row-count, mysql row-by-row, mssql PLP) -- is the per-driver follow-on; it
// slots behind this same hasNext/next surface so callers do not change when a driver gains it.
pub struct RowStream {
    pub rs: ResultSet,
    pub pos: int,

    init(rs: ResultSet) {
        self.rs = rs;
        self.pos = 0;
    }

    pub fn hasNext(self: RowStream): bool { return self.pos < self.rs.rowCount(); }

    pub fn next(self: RowStream): Row | undefined {
        if (self.pos >= self.rs.rowCount()) { return undefined; }
        let r = self.rs.row(self.pos);
        self.pos = self.pos + 1;
        return r;
    }

    pub fn reset(self: RowStream): void { self.pos = 0; }
    pub fn remaining(self: RowStream): int { let n = self.rs.rowCount() - self.pos; return if (n > 0) n else 0; }
    // Surface the statement's error channel so a streaming caller can still check `.ok()`.
    pub fn ok(self: RowStream): bool { return self.rs.ok(); }
    pub fn err(self: RowStream): DbError { return self.rs.err; }
}

pub fn streamRows(rs: ResultSet): RowStream { return RowStream(rs); }

pub trait Connection {

    async fn exec(self, sql: string, params: List<DbValue>): ExecResult;
    async fn query(self, sql: string, params: List<DbValue>): ResultSet;
    fn close(self): void;

    fn setTimeout(self, ms: int): int;

    async fn prepare(self, sql: string): int;
    async fn queryPrepared(self, stmt: int, params: List<DbValue>): ResultSet;
    async fn execPrepared(self, stmt: int, params: List<DbValue>): ExecResult;

    // Transaction control. SQL drivers issue their dialect's BEGIN/COMMIT/ROLLBACK; the ExecResult
    // carries a DbError (via the T1 error channel) if the statement failed, so a caller can check
    // `.ok()` and, on error mid-transaction, `rollback()`. There is no auto-rollback-on-drop yet (a
    // sync destructor cannot await); use the try/errdefer pattern to roll back on the error path.
    async fn begin(self): ExecResult;
    async fn commit(self): ExecResult;
    async fn rollback(self): ExecResult;
}

pub trait Driver {

    async fn connect(self, dsn: string): Connection;
}
