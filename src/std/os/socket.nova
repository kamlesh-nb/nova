// os/socket: the backend-neutral socket API for the reactor (step 3 of the cross-platform reactor). This
// is the POSIX base (macOS + Linux) over os/sys; os/socket_windows.nova overrides it on Windows (Winsock).
// Splitting socket ops into their own module resolves the long-deferred collision between os/sys's bare
// `socket` extern and the `socket` MODULE (net/tcp/socket), and gives the reactor one socket surface whose
// Windows implementation speaks SOCKET handles + WSAGetLastError instead of fds + errno.
//
// Handles are `int` (fd) here; the Windows variant truncates SOCKET (UINT_PTR) to int at this boundary —
// real socket-handle values fit, and keeping int avoids an int->long migration across the reactor stack.
//
// The socket-option constants (SOL_SOCKET/SO_ERROR/SO_REUSEPORT) and EAGAIN differ between macOS and
// Linux; this file selects them by platform.os so it is correct on both (os/sys hardcodes the macOS
// values). No divergent externs are involved, so the platform branches compile on every target.

import os.sys;
import platform;
import bytes;

pub const AF_INET: int = 2;
pub const SOCK_STREAM: int = 1;

fn eagain(): int { return if (platform.isLinux) 11 else 35; }
fn solSocket(): int { return if (platform.isLinux) 1 else 65535; }
fn soErrorOpt(): int { return if (platform.isLinux) 4 else 4103; }
fn soReusePort(): int { return if (platform.isLinux) 15 else 512; }
const SO_REUSEADDR: int = 4;

pub fn newTcp(): int { return sys.socket(AF_INET, SOCK_STREAM, 0); }
pub fn close(fd: int): int { return sys.close(fd); }
pub fn bindSock(fd: int, addr: ptr, addrlen: int): int { return sys.bind(fd, addr, addrlen); }
pub fn listenSock(fd: int, backlog: int): int { return sys.listen(fd, backlog); }
pub fn acceptSock(fd: int, addr: ptr, addrlen: ptr): int { return sys.accept(fd, addr, addrlen); }
pub fn connectSock(fd: int, addr: ptr, addrlen: int): int { return sys.connect(fd, addr, addrlen); }

// recv/send: on POSIX read/write work on sockets, so they back these directly. The Windows variant maps
// them to recv/send (read/write do not work on a SOCKET).
pub fn recvSock(fd: int, buf: long, len: int): long { return sys.read(fd, buf, len as long); }
pub fn sendSock(fd: int, buf: long, len: int): long { return sys.write(fd, buf, len as long); }

pub fn setNonBlock(fd: int): int { return sys.setNonBlocking(fd); }

pub fn setReuseAddr(fd: int): int {
    let one = bytes.alloc(4);
    bytes.write_i32(one, 0, 1);
    let r = sys.setsockopt(fd, solSocket(), SO_REUSEADDR, one, 4);
    bytes.free(one);
    return r;
}
pub fn setReusePort(fd: int): int {
    let one = bytes.alloc(4);
    bytes.write_i32(one, 0, 1);
    let r = sys.setsockopt(fd, solSocket(), soReusePort(), one, 4);
    bytes.free(one);
    return r;
}

// Pending socket error via getsockopt(SO_ERROR): 0 = connect succeeded, non-zero = failure.
pub fn sockError(fd: int): int {
    let val = bytes.alloc(4);
    let len = bytes.alloc(4);
    bytes.write_i32(val, 0, 0);
    bytes.write_i32(len, 0, 4);
    let r = sys.getsockopt(fd, solSocket(), soErrorOpt(), val, len);
    let e = if (r == 0) (bytes.read_i32(val, 0) as int) else -1;
    bytes.free(val);
    bytes.free(len);
    return e;
}

// True if the last socket call failed only because it would block (the reactor's "await readiness" cue).
pub fn wouldBlock(): bool { return sys.errno() == eagain(); }

// True if a non-blocking connect() is still in progress (await writability, then check sockError).
fn einprogress(): int { return if (platform.isLinux) 115 else 36; }
pub fn connectInProgress(): bool { return sys.errno() == einprogress(); }

// sockaddr_in helpers (pure byte layout; identical on every platform).
pub fn makeSockaddrIn(port: int, addrBE: long): ptr { return sys.makeSockaddrIn(port, addrBE); }
pub fn boundPort(fd: int): int { return sys.boundPort(fd); }

// DNS resolution (getaddrinfo/freeaddrinfo). Kept behind the socket seam so callers don't import os.sys
// (which would drag its POSIX `socket` extern into the Windows graph and collide with winsock's).
pub fn getAddrInfo(node: ptr, service: ptr, hints: ptr, res: ptr): int { return sys.getaddrinfo(node, service, hints, res); }
pub fn freeAddrInfo(res: ptr): void { sys.freeaddrinfo(res); }

// --- blocking (synchronous) socket layer (M14.2: retires io.cpp's nova_socket_* to Nova) --------------
// The blocking TCP stack (net/tcp, sync web/client) is built on these. IPv4 only, matching the async
// reactor path (eventedio.resolveHost4); getaddrinfo's ai_addr offset differs by platform.

fn soRcvTimeo(): int { return if (platform.isLinux) 20 else 4102; }   // macOS SO_RCVTIMEO = 0x1006
fn soSndTimeo(): int { return if (platform.isLinux) 21 else 4101; }   // macOS SO_SNDTIMEO = 0x1005
fn aiAddrOffset(): int { return if (platform.isLinux) 24 else 32; }   // struct addrinfo ai_addr

fn isNumericIPv4(s: string): bool {
    if (s.length == 0) { return false; }
    let i = 0;
    while (i < s.length) {
        let c = s[i];
        if (!((c >= 48 && c <= 57) || c == 46)) { return false; }
        i = i + 1;
    }
    return true;
}
fn parseIPv4BE(s: string): long {
    let result = 0 as long;
    let cur = 0;
    let shift = 0;
    let i = 0;
    while (i < s.length) {
        let c = s[i];
        if (c == 46) { result = result | ((cur as long) << shift); shift = shift + 8; cur = 0; }
        else { cur = cur * 10 + (c - 48); }
        i = i + 1;
    }
    result = result | ((cur as long) << shift);
    return result;
}

// Resolve a host to the big-endian IPv4 address for makeSockaddrIn, or -1. Numeric IPv4 parsed directly;
// a hostname goes through getaddrinfo (a blocking DNS lookup, acceptable on the synchronous path).
pub fn resolveHost4(host: string): long {
    if (isNumericIPv4(host)) { return parseIPv4BE(host); }
    let n = host.length;
    let node = bytes.alloc(n + 1);
    let i = 0;
    while (i < n) { bytes.write_byte(node, i, host[i]); i = i + 1; }
    bytes.write_byte(node, n, 0);
    let res = bytes.alloc(8);
    bytes.write_ptr(res, 0, 0);
    let rc = getAddrInfo(node, 0, 0, res);
    bytes.free(node);
    if (rc != 0) { bytes.free(res); return -1 as long; }
    let head = bytes.read_ptr(res, 0);
    let ai = head;
    let addr = -1 as long;
    let off = aiAddrOffset();
    while (ai != 0 && addr == (-1 as long)) {
        let fam = bytes.read_i32(ai, 4) as int;
        if (fam == AF_INET) {
            let sa = bytes.read_ptr(ai, off);
            addr = bytes.read_i32(sa, 4) as long;
        } else {
            ai = bytes.read_ptr(ai, 40);
        }
    }
    if (head != 0) { freeAddrInfo(head); }
    bytes.free(res);
    return addr;
}

// Blocking connect to host:port. Returns a connected fd, or -1.
pub fn connectBlocking(host: string, port: int): int {
    let addr = resolveHost4(host);
    if (addr == (-1 as long)) { return -1; }
    let fd = newTcp();
    if (fd < 0) { return -1; }
    let sa = makeSockaddrIn(port, addr);
    let r = connectSock(fd, sa, 16);
    bytes.free(sa);
    if (r != 0) { close(fd); return -1; }
    return fd;
}

// A receive/send timeout in ms via SO_RCVTIMEO / SO_SNDTIMEO (a `struct timeval` on POSIX).
pub fn setTimeout(fd: int, ms: int): int {
    let tv = bytes.alloc(16);
    bytes.write_ptr(tv, 0, (if (ms > 0) (ms / 1000) else 0) as long);
    bytes.write_ptr(tv, 8, (if (ms > 0) ((ms % 1000) * 1000) else 0) as long);
    let r1 = sys.setsockopt(fd, solSocket(), soRcvTimeo(), tv, 16);
    let r2 = sys.setsockopt(fd, solSocket(), soSndTimeo(), tv, 16);
    bytes.free(tv);
    return if (r1 == 0 && r2 == 0) 0 else -1;
}

// Send all `len` bytes from `buf`; returns bytes sent or -1.
pub fn sendAll(fd: int, buf: long, len: int): int {
    let total = 0;
    while (total < len) {
        let n = sendSock(fd, buf + (total as long), len - total);
        if (n <= 0) { return if (total > 0) total else -1; }
        total = total + (n as int);
    }
    return total;
}
// Receive up to `max` bytes into `buf`; returns byte count (0 = EOF) or -1.
pub fn recvOnce(fd: int, buf: long, max: int): int {
    let n = recvSock(fd, buf, max);
    return if (n < 0) -1 else (n as int);
}

// Create a listening socket bound to INADDR_ANY:port (SO_REUSEADDR), backlog 128. Returns fd or -1.
pub fn listenAny(port: int): int {
    let fd = newTcp();
    if (fd < 0) { return -1; }
    setReuseAddr(fd);
    let sa = makeSockaddrIn(port, 0);
    let br = bindSock(fd, sa, 16);
    bytes.free(sa);
    if (br != 0 || listenSock(fd, 128) != 0) { close(fd); return -1; }
    return fd;
}
pub fn acceptOne(fd: int): int { return acceptSock(fd, 0, 0); }
