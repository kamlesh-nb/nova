
import list;
import bytes;

pub fn len(s: string): int {
    return s.length;
}

fn allocString(len: int): string {

    return bytes.alloc(len) as string;
}

pub fn concat(a: string, b: string): string {
    let len_a = a.length;
    let len_b = b.length;
    let total_len = len_a + len_b;
    let ptr = allocString(total_len);
    let i = 0;
    while (i < len_a) {
        bytes.write_byte(ptr, i, a[i]);
        i = i + 1;
    }
    let j = 0;
    while (j < len_b) {
        bytes.write_byte(ptr, len_a + j, b[j]);
        j = j + 1;
    }
    return ptr;
}

pub fn split(s: string, sep: string): List<string> {
    let result = List<string>();
    let s_len = s.length;
    let sep_len = sep.length;

    if (sep_len == 0) {

        let i = 0;
        while (i < s_len) {
            let char_len = 1;
            let char_ptr = allocString(1);
            bytes.write_byte(char_ptr, 0, s[i]);
            result.push(char_ptr);
            i = i + 1;
        }
        return result;
    }

    let start = 0;
    while (true) {
        let pos = indexOfFrom(s, sep, start);
        if (pos == -1) {

            let remaining = slice(s, start, s_len);
            result.push(remaining);
            break;
        }

        let part = slice(s, start, pos);
        result.push(part);
        start = pos + sep_len;
    }
    return result;
}

pub fn join(list: List<string>, sep: string): string {
    if (list.size() == 0) {
        return "";
    }
    let sep_len = sep.length;
    let list_len = list.size();

    let total_len = 0;
    let idx = 0;
    while (idx < list_len) {
        let s = list.get(idx);

        if (s != undefined) {
            total_len = total_len + s.length;
        }
        idx = idx + 1;
    }
    total_len = total_len + sep_len * (list_len - 1);

    let ptr = allocString(total_len);
    let offset = 0;
    let i = 0;
    while (i < list_len) {
        let s = list.get(i);
        if (s != undefined) {
            let len_s = s.length;
            let j = 0;
            while (j < len_s) {
                bytes.write_byte(ptr, offset + j, s[j]);
                j = j + 1;
            }
            offset = offset + len_s;
        }
        if (i < list_len - 1) {
            let k = 0;
            while (k < sep_len) {
                bytes.write_byte(ptr, offset + k, sep[k]);
                k = k + 1;
            }
            offset = offset + sep_len;
        }
        i = i + 1;
    }
    return ptr;
}

pub fn slice(s: string, start: int, end: int): string {
    let s_len = s.length;
    let start_clamped = if (start < 0) 0 else if (start > s_len) s_len else start;
    let end_clamped = if (end < start_clamped) start_clamped else if (end > s_len) s_len else end;
    let len = end_clamped - start_clamped;
    if (len <= 0) {
        return "";
    }
    let ptr = allocString(len);
    let i = 0;
    while (i < len) {
        bytes.write_byte(ptr, i, s[start_clamped + i]);
        i = i + 1;
    }
    return ptr;
}

pub fn trim(s: string): string {
    let len = s.length;
    let start = 0;
    while (start < len) {
        let c = s[start];
        if (c != 32 && c != 9 && c != 10 && c != 13) {
            break;
        }
        start = start + 1;
    }
    let end = len;
    while (end > start) {
        let c = s[end - 1];
        if (c != 32 && c != 9 && c != 10 && c != 13) {
            break;
        }
        end = end - 1;
    }
    return slice(s, start, end);
}

pub fn replace(s: string, old: string, new: string): string {
    let s_len = s.length;
    let old_len = old.length;
    let new_len = new.length;

    if (old_len == 0) {

        let result = bytes.alloc(s_len * (new_len + 1) + new_len);
        let offset = 0;
        let i = 0;
        while (i < s_len) {

            let k = 0;
            while (k < new_len) {
                bytes.write_byte(result, offset + k, new[k]);
                k = k + 1;
            }
            offset = offset + new_len;
            bytes.write_byte(result, offset, s[i]);
            offset = offset + 1;
            i = i + 1;
        }

        let k = 0;
        while (k < new_len) {
            bytes.write_byte(result, offset + k, new[k]);
            k = k + 1;
        }
        offset = offset + new_len;

        return slice(result, 0, offset);
    }

    let count = 0;
    let pos = 0;
    while (true) {
        let idx = indexOfFrom(s, old, pos);
        if (idx == -1) break;
        count = count + 1;
        pos = idx + old_len;
    }

    if (count == 0) {
        return s;
    }

    let result_len = s_len + count * (new_len - old_len);
    let result = allocString(result_len);
    let offset = 0;
    let search_start = 0;

    while (true) {
        let idx = indexOfFrom(s, old, search_start);
        if (idx == -1) {

            let remaining_len = s_len - search_start;
            let k = 0;
            while (k < remaining_len) {
                bytes.write_byte(result, offset + k, s[search_start + k]);
                k = k + 1;
            }
            break;
        }

        let before_len = idx - search_start;
        let k = 0;
        while (k < before_len) {
            bytes.write_byte(result, offset + k, s[search_start + k]);
            k = k + 1;
        }
        offset = offset + before_len;

        let k = 0;
        while (k < new_len) {
            bytes.write_byte(result, offset + k, new[k]);
            k = k + 1;
        }
        offset = offset + new_len;
        search_start = idx + old_len;
    }

    return result;
}

pub fn toLowerCase(s: string): string {
    let len = s.length;
    let ptr = allocString(len);
    let i = 0;
    while (i < len) {
        let c = s[i];
        if (c >= 65 && c <= 90) {
            bytes.write_byte(ptr, i, c + 32);
        } else {
            bytes.write_byte(ptr, i, c);
        }
        i = i + 1;
    }
    return ptr;
}

pub fn toUpperCase(s: string): string {
    let len = s.length;
    let ptr = allocString(len);
    let i = 0;
    while (i < len) {
        let c = s[i];
        if (c >= 97 && c <= 122) {
            bytes.write_byte(ptr, i, c - 32);
        } else {
            bytes.write_byte(ptr, i, c);
        }
        i = i + 1;
    }
    return ptr;
}

pub fn startsWith(s: string, prefix: string): bool {
    let s_len = s.length;
    let p_len = prefix.length;
    if (s_len < p_len) {
        return false;
    }
    let i = 0;
    while (i < p_len) {
        if (s[i] != prefix[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn endsWith(s: string, suffix: string): bool {
    let s_len = s.length;
    let suf_len = suffix.length;
    if (s_len < suf_len) {
        return false;
    }
    let i = 0;
    while (i < suf_len) {
        if (s[s_len - suf_len + i] != suffix[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn contains(s: string, substr: string): bool {
    let s_len = s.length;
    let sub_len = substr.length;
    if (s_len < sub_len) {
        return false;
    }
    if (sub_len == 0) {
        return true;
    }
    let i = 0;
    while (i <= s_len - sub_len) {
        let j = 0;
        let is_match = true;
        while (j < sub_len) {
            if (s[i + j] != substr[j]) {
                is_match = false;
                break;
            }
            j = j + 1;
        }
        if (is_match) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn indexOf(s: string, substr: string): int {
    return indexOfFrom(s, substr, 0);
}

pub fn lastIndexOf(s: string, substr: string): int {
    let s_len = s.length;
    let sub_len = substr.length;
    if (s_len < sub_len) { return -1; }
    if (sub_len == 0) { return s_len; }
    let i = s_len - sub_len;
    while (i >= 0) {
        let j = 0;
        let is_match = true;
        while (j < sub_len) {
            if (s[i + j] != substr[j]) { is_match = false; break; }
            j = j + 1;
        }
        if (is_match) { return i; }
        i = i - 1;
    }
    return -1;
}

fn indexOfFrom(s: string, substr: string, start: int): int {
    let s_len = s.length;
    let sub_len = substr.length;
    if (s_len < sub_len || start >= s_len) {
        return -1;
    }
    if (sub_len == 0) {
        return start;
    }
    let i = start;
    while (i <= s_len - sub_len) {
        let j = 0;
        let is_match = true;
        while (j < sub_len) {
            if (s[i + j] != substr[j]) {
                is_match = false;
                break;
            }
            j = j + 1;
        }
        if (is_match) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

pub fn eql(a: string, b: string): bool {
    if (a == undefined || b == undefined) {
        return a == undefined && b == undefined;
    }
    let len_a = a.length;
    let len_b = b.length;
    if (len_a != len_b) {
        return false;
    }
    let i = 0;
    while (i < len_a) {
        if (a[i] != b[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn compare(a: string, b: string): int {
    let len_a = a.length;
    let len_b = b.length;
    let min_len = len_a;
    if (len_b < len_a) {
        min_len = len_b;
    }
    let i = 0;
    while (i < min_len) {
        let char_a = a[i];
        let char_b = b[i];
        if (char_a < char_b) {
            return -1;
        }
        if (char_a > char_b) {
            return 1;
        }
        i = i + 1;
    }
    if (len_a < len_b) {
        return -1;
    }
    if (len_a > len_b) {
        return 1;
    }
    return 0;
}

pub fn hash(s: string): int {
    let len = s.length;
    let h = 5381;
    let i = 0;
    while (i < len) {
        let c = s[i];
        h = ((h << 5) + h) + c;
        i = i + 1;
    }
    return h;
}

pub fn parseI64(s: string): long {

    let len = s.length;
    if (len == 0) {
        return 0;
    }
    let result: long = 0;
    let i = 0;
    let sign: long = 1;
    if (s[0] == 45) {
        sign = -1;
        i = 1;
    }
    while (i < len) {
        let c = s[i];
        if (c >= 48 && c <= 57) {
            result = result * 10 + ((c - 48) as long);
        }
        i = i + 1;
    }
    return result * sign;
}

pub fn parseFloat(s: string): double {
    let len = s.length;
    let i = 0;
    let neg = false;
    if (len > 0 && s[0] == 45) {
        neg = true;
        i = 1;
    }
    let intPart = 0.0;
    while (i < len && s[i] != 46) {
        if (s[i] >= 48 && s[i] <= 57) {
            intPart = intPart * 10.0 + ((s[i] - 48) as double);
        }
        i = i + 1;
    }
    let frac = 0.0;
    let scale = 1.0;
    if (i < len && s[i] == 46) {
        i = i + 1;
        while (i < len) {
            if (s[i] >= 48 && s[i] <= 57) {
                scale = scale / 10.0;
                frac = frac + ((s[i] - 48) as double) * scale;
            }
            i = i + 1;
        }
    }
    let result = intPart + frac;
    if (neg) {
        result = 0.0 - result;
    }
    return result;
}

pub fn delete(self: string): void {
}

@test
fn test_string_helpers(): void {
    if (!startsWith("hello", "he")) { nova_test_fail("startsWith fail"); }
    if (startsWith("hello", "lo")) { nova_test_fail("startsWith negative fail"); }
    if (!endsWith("hello", "lo")) { nova_test_fail("endsWith fail"); }
    if (endsWith("hello", "he")) { nova_test_fail("endsWith negative fail"); }
    if (!contains("hello", "el")) { nova_test_fail("contains fail"); }
    if (contains("hello", "world")) { nova_test_fail("contains negative fail"); }

    if (indexOf("hello", "e") != 1) { nova_test_fail("indexOf fail"); }
    if (indexOf("hello", "z") != -1) { nova_test_fail("indexOf negative fail"); }

    if (!eql("abc", "abc")) { nova_test_fail("eql fail"); }
    if (eql("abc", "def")) { nova_test_fail("eql negative fail"); }

    if (compare("abc", "def") != -1) { nova_test_fail("compare < fail"); }
    if (compare("def", "abc") != 1) { nova_test_fail("compare > fail"); }
    if (compare("abc", "abc") != 0) { nova_test_fail("compare == fail"); }

    if (parseI64("1234") != 1234) { nova_test_fail("parseI64 positive fail"); }
    if (parseI64("-56") != -56) { nova_test_fail("parseI64 negative fail"); }
}
