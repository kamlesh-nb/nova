
import list;
import bytes;

pub fn len(s: string): int {
    return s.length;
}

fn allocString(len: int): string {

    return bytes.alloc(len) as string;
}

pub fn concat(a: string, b: string): string {
    let len_a = a.length;
    let len_b = b.length;
    let total_len = len_a + len_b;
    if (total_len == 0) { return ""; }
    let ptr = allocString(total_len);
    // Bulk memcpy each half in at its offset. The old per-byte loop made `+` on strings O(n) Nova calls
    // (bounds-checked a[i] + write_byte per byte), so a large `prof + html` (~190KB) copied byte-by-byte
    // every request -- it dominated the server profile (string_concat = ~21% of CPU under load). bytes.copy
    // is a single memmove; `(ptr as long)+len_a` keeps the destination address 64-bit.
    if (len_a > 0) { bytes.copy(ptr as long, a as long, len_a); }
    if (len_b > 0) { bytes.copy((ptr as long) + (len_a as long), b as long, len_b); }
    return ptr;
}

pub fn split(s: string, sep: string): List<string> {
    let result = List<string>();
    let s_len = s.length;
    let sep_len = sep.length;

    if (sep_len == 0) {

        let i = 0;
        while (i < s_len) {
            let char_len = 1;
            let char_ptr = allocString(1);
            bytes.write_byte(char_ptr, 0, s[i]);
            result.push(char_ptr);
            i = i + 1;
        }
        return result;
    }

    let start = 0;
    while (true) {
        let pos = indexOfFrom(s, sep, start);
        if (pos == -1) {

            let remaining = slice(s, start, s_len);
            result.push(remaining);
            break;
        }

        let part = slice(s, start, pos);
        result.push(part);
        start = pos + sep_len;
    }
    return result;
}

pub fn join(list: List<string>, sep: string): string {
    if (list.size() == 0) {
        return "";
    }
    let sep_len = sep.length;
    let list_len = list.size();

    let total_len = 0;
    let idx = 0;
    while (idx < list_len) {
        let s = list.get(idx);

        if (s != undefined) {
            total_len = total_len + s.length;
        }
        idx = idx + 1;
    }
    total_len = total_len + sep_len * (list_len - 1);

    let ptr = allocString(total_len);
    let offset = 0;
    let i = 0;
    while (i < list_len) {
        let s = list.get(i);
        if (s != undefined) {
            let len_s = s.length;
            let j = 0;
            while (j < len_s) {
                bytes.write_byte(ptr, offset + j, s[j]);
                j = j + 1;
            }
            offset = offset + len_s;
        }
        if (i < list_len - 1) {
            let k = 0;
            while (k < sep_len) {
                bytes.write_byte(ptr, offset + k, sep[k]);
                k = k + 1;
            }
            offset = offset + sep_len;
        }
        i = i + 1;
    }
    return ptr;
}

pub fn slice(s: string, start: int, end: int): string {
    let s_len = s.length;
    let start_clamped = if (start < 0) 0 else if (start > s_len) s_len else start;
    let end_clamped = if (end < start_clamped) start_clamped else if (end > s_len) s_len else end;
    let len = end_clamped - start_clamped;
    if (len <= 0) {
        return "";
    }
    let ptr = allocString(len);
    // Bulk memcpy the slice instead of a per-byte Nova loop. slice is on the hot path for the DB drivers
    // (every result cell), escapeHtml, the static-file cache copy, and response assembly, so this is a
    // broad win. `(s as long) + start` keeps the source address 64-bit (an int add would truncate a
    // >4GB heap address).
    bytes.copy(ptr as long, (s as long) + (start_clamped as long), len);
    return ptr;
}

pub fn trim(s: string): string {
    let len = s.length;
    let start = 0;
    while (start < len) {
        let c = s[start];
        if (c != 32 && c != 9 && c != 10 && c != 13) {
            break;
        }
        start = start + 1;
    }
    let end = len;
    while (end > start) {
        let c = s[end - 1];
        if (c != 32 && c != 9 && c != 10 && c != 13) {
            break;
        }
        end = end - 1;
    }
    return slice(s, start, end);
}

pub fn replace(s: string, old: string, new: string): string {
    let s_len = s.length;
    let old_len = old.length;
    let new_len = new.length;

    if (old_len == 0) {

        let result = bytes.alloc(s_len * (new_len + 1) + new_len);
        let offset = 0;
        let i = 0;
        while (i < s_len) {

            let k = 0;
            while (k < new_len) {
                bytes.write_byte(result, offset + k, new[k]);
                k = k + 1;
            }
            offset = offset + new_len;
            bytes.write_byte(result, offset, s[i]);
            offset = offset + 1;
            i = i + 1;
        }

        let k = 0;
        while (k < new_len) {
            bytes.write_byte(result, offset + k, new[k]);
            k = k + 1;
        }
        offset = offset + new_len;

        return slice(result, 0, offset);
    }

    let count = 0;
    let pos = 0;
    while (true) {
        let idx = indexOfFrom(s, old, pos);
        if (idx == -1) break;
        count = count + 1;
        pos = idx + old_len;
    }

    if (count == 0) {
        return s;
    }

    let result_len = s_len + count * (new_len - old_len);
    let result = allocString(result_len);
    let offset = 0;
    let search_start = 0;

    while (true) {
        let idx = indexOfFrom(s, old, search_start);
        if (idx == -1) {

            let remaining_len = s_len - search_start;
            let k = 0;
            while (k < remaining_len) {
                bytes.write_byte(result, offset + k, s[search_start + k]);
                k = k + 1;
            }
            break;
        }

        let before_len = idx - search_start;
        let k = 0;
        while (k < before_len) {
            bytes.write_byte(result, offset + k, s[search_start + k]);
            k = k + 1;
        }
        offset = offset + before_len;

        let k = 0;
        while (k < new_len) {
            bytes.write_byte(result, offset + k, new[k]);
            k = k + 1;
        }
        offset = offset + new_len;
        search_start = idx + old_len;
    }

    return result;
}

pub fn toLowerCase(s: string): string {
    let len = s.length;
    let ptr = allocString(len);
    let i = 0;
    while (i < len) {
        let c = s[i];
        if (c >= 65 && c <= 90) {
            bytes.write_byte(ptr, i, c + 32);
        } else {
            bytes.write_byte(ptr, i, c);
        }
        i = i + 1;
    }
    return ptr;
}

pub fn toUpperCase(s: string): string {
    let len = s.length;
    let ptr = allocString(len);
    let i = 0;
    while (i < len) {
        let c = s[i];
        if (c >= 97 && c <= 122) {
            bytes.write_byte(ptr, i, c - 32);
        } else {
            bytes.write_byte(ptr, i, c);
        }
        i = i + 1;
    }
    return ptr;
}

pub fn startsWith(s: string, prefix: string): bool {
    let s_len = s.length;
    let p_len = prefix.length;
    if (s_len < p_len) {
        return false;
    }
    let i = 0;
    while (i < p_len) {
        if (s[i] != prefix[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn endsWith(s: string, suffix: string): bool {
    let s_len = s.length;
    let suf_len = suffix.length;
    if (s_len < suf_len) {
        return false;
    }
    let i = 0;
    while (i < suf_len) {
        if (s[s_len - suf_len + i] != suffix[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn contains(s: string, substr: string): bool {
    let s_len = s.length;
    let sub_len = substr.length;
    if (s_len < sub_len) {
        return false;
    }
    if (sub_len == 0) {
        return true;
    }
    let i = 0;
    while (i <= s_len - sub_len) {
        let j = 0;
        let is_match = true;
        while (j < sub_len) {
            if (s[i + j] != substr[j]) {
                is_match = false;
                break;
            }
            j = j + 1;
        }
        if (is_match) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn indexOf(s: string, substr: string): int {
    return indexOfFrom(s, substr, 0);
}

pub fn lastIndexOf(s: string, substr: string): int {
    let s_len = s.length;
    let sub_len = substr.length;
    if (s_len < sub_len) { return -1; }
    if (sub_len == 0) { return s_len; }
    let i = s_len - sub_len;
    while (i >= 0) {
        let j = 0;
        let is_match = true;
        while (j < sub_len) {
            if (s[i + j] != substr[j]) { is_match = false; break; }
            j = j + 1;
        }
        if (is_match) { return i; }
        i = i - 1;
    }
    return -1;
}

fn indexOfFrom(s: string, substr: string, start: int): int {
    let s_len = s.length;
    let sub_len = substr.length;
    if (s_len < sub_len || start >= s_len) {
        return -1;
    }
    if (sub_len == 0) {
        return start;
    }
    let i = start;
    while (i <= s_len - sub_len) {
        let j = 0;
        let is_match = true;
        while (j < sub_len) {
            if (s[i + j] != substr[j]) {
                is_match = false;
                break;
            }
            j = j + 1;
        }
        if (is_match) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

pub fn eql(a: string, b: string): bool {
    if (a == undefined || b == undefined) {
        return a == undefined && b == undefined;
    }
    let len_a = a.length;
    let len_b = b.length;
    if (len_a != len_b) {
        return false;
    }
    let i = 0;
    while (i < len_a) {
        if (a[i] != b[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn compare(a: string, b: string): int {
    let len_a = a.length;
    let len_b = b.length;
    let min_len = len_a;
    if (len_b < len_a) {
        min_len = len_b;
    }
    let i = 0;
    while (i < min_len) {
        let char_a = a[i];
        let char_b = b[i];
        if (char_a < char_b) {
            return -1;
        }
        if (char_a > char_b) {
            return 1;
        }
        i = i + 1;
    }
    if (len_a < len_b) {
        return -1;
    }
    if (len_a > len_b) {
        return 1;
    }
    return 0;
}

pub fn hash(s: string): int {
    let len = s.length;
    let h = 5381;
    let i = 0;
    while (i < len) {
        let c = s[i];
        h = ((h << 5) + h) + c;
        i = i + 1;
    }
    return h;
}

// Parse a signed 64-bit integer. Accepts an optional leading `+`/`-` and then digits; it STOPS at the
// first non-digit (a lenient tail, like C `strtol`), so `"12abc"` is 12 and `"1a2"` is 1, never 12 (the
// old parser silently skipped embedded non-digits). Digits accumulate in NEGATIVE space so the
// most-negative value (i64 MIN) is representable without overflowing a positive magnitude, and each step
// is overflow-checked: on overflow the result CLAMPS to the signed 64-bit bound (MIN for a negative
// input, MAX for a positive one) rather than silently wrapping. An empty or sign-only string is 0.
pub fn parseI64(s: string): long {

    let len = s.length;
    if (len == 0) {
        return 0;
    }
    let LONG_MIN: long = -9223372036854775807 - 1;
    let LONG_MAX: long = 9223372036854775807;

    let i = 0;
    let neg = false;
    if (s[0] == 45) {          // '-'
        neg = true;
        i = 1;
    } else if (s[0] == 43) {   // '+'
        i = 1;
    }

    // `limit` is the most-negative accumulator value permitted for this sign; positive inputs are bounded
    // at -LONG_MAX so the final negate stays in range. `multmin` guards the multiply.
    let limit: long = 0 - LONG_MAX;
    if (neg) {
        limit = LONG_MIN;
    }
    let multmin: long = limit / 10;

    let acc: long = 0;
    let any = false;
    while (i < len) {
        let c = s[i];
        if (c < 48 || c > 57) {
            i = len;               // stop at the first non-digit
        } else {
            let d: long = (c - 48) as long;
            if (acc < multmin) {   // acc * 10 would underflow
                if (neg) { return LONG_MIN; }
                return LONG_MAX;
            }
            acc = acc * 10;
            if (acc < limit + d) { // acc - d would underflow
                if (neg) { return LONG_MIN; }
                return LONG_MAX;
            }
            acc = acc - d;
            any = true;
            i = i + 1;
        }
    }

    if (!any) {
        return 0;
    }
    if (neg) {
        return acc;
    }
    return 0 - acc;
}

pub fn parseFloat(s: string): double {
    let len = s.length;
    let i = 0;
    let neg = false;
    if (len > 0 && s[0] == 45) {
        neg = true;
        i = 1;
    }
    let intPart = 0.0;
    while (i < len && s[i] != 46) {
        if (s[i] >= 48 && s[i] <= 57) {
            intPart = intPart * 10.0 + ((s[i] - 48) as double);
        }
        i = i + 1;
    }
    let frac = 0.0;
    let scale = 1.0;
    if (i < len && s[i] == 46) {
        i = i + 1;
        while (i < len) {
            if (s[i] >= 48 && s[i] <= 57) {
                scale = scale / 10.0;
                frac = frac + ((s[i] - 48) as double) * scale;
            }
            i = i + 1;
        }
    }
    let result = intPart + frac;
    if (neg) {
        result = 0.0 - result;
    }
    return result;
}

// A2 (further-refinement.md, gaps.md E-parse): the failure-surfacing parse family. Unlike parseI64/parseFloat
// (which return 0 on garbage, truncate at the first non-digit, and saturate on overflow -- silent wrong
// values), these return `undefined` on ANY invalid input: empty, a lone sign, a non-digit anywhere, trailing
// garbage, or overflow. Valid input returns the value. This is the sound primitive new code should use;
// parseI64/parseFloat are kept unchanged for the drivers that already depend on their exact behaviour.

pub fn parseLong(s: string): long | undefined {
    let len = s.length;
    if (len == 0) { return undefined; }

    let i = 0;
    let neg = false;
    if (s[0] == 45) {          // '-'
        neg = true;
        i = 1;
    } else if (s[0] == 43) {   // '+'
        i = 1;
    }
    if (i >= len) { return undefined; }   // a sign with no digits

    let LONG_MIN: long = -9223372036854775807 - 1;
    let LONG_MAX: long = 9223372036854775807;
    let limit: long = 0 - LONG_MAX;
    if (neg) { limit = LONG_MIN; }
    let multmin: long = limit / 10;

    // Accumulate on the NEGATIVE side so the most-negative value has a representation (the positive side
    // cannot hold LONG_MIN's magnitude). The final negate lifts a non-negative result back.
    let acc: long = 0;
    while (i < len) {
        let c = s[i];
        if (c < 48 || c > 57) { return undefined; }   // strict: any non-digit is a failure
        let d: long = (c - 48) as long;
        if (acc < multmin) { return undefined; }        // acc * 10 would overflow
        acc = acc * 10;
        if (acc < limit + d) { return undefined; }      // acc - d would overflow
        acc = acc - d;
        i = i + 1;
    }
    if (neg) { return acc; }
    return 0 - acc;
}

pub fn parseInt(s: string): int | undefined {
    let v = parseLong(s);
    if (v == undefined) { return undefined; }
    let INT_MIN: long = -2147483648;
    let INT_MAX: long = 2147483647;
    if (v < INT_MIN || v > INT_MAX) { return undefined; }   // out of 32-bit range
    return v as int;
}

// Grammar: optional sign, an integer part and/or a fractional part (at least one digit overall), and an
// optional `e`/`E` exponent with an optional sign and at least one digit. Anything else (a lone `.`, a
// dangling exponent, trailing text, or `inf`/`nan` text which this reference parser does not accept) returns
// undefined. This fixes the parseFloat exponent bug (`"1e3"` decoded as 13, not 1000) for new callers.
pub fn parseDouble(s: string): double | undefined {
    let len = s.length;
    if (len == 0) { return undefined; }

    let i = 0;
    let neg = false;
    if (s[0] == 45) {          // '-'
        neg = true;
        i = 1;
    } else if (s[0] == 43) {   // '+'
        i = 1;
    }

    let sawDigit = false;
    let intPart = 0.0;
    while (i < len && s[i] >= 48 && s[i] <= 57) {
        intPart = intPart * 10.0 + ((s[i] - 48) as double);
        sawDigit = true;
        i = i + 1;
    }

    let frac = 0.0;
    let scale = 1.0;
    if (i < len && s[i] == 46) {   // '.'
        i = i + 1;
        while (i < len && s[i] >= 48 && s[i] <= 57) {
            scale = scale / 10.0;
            frac = frac + ((s[i] - 48) as double) * scale;
            sawDigit = true;
            i = i + 1;
        }
    }
    if (!sawDigit) { return undefined; }   // no mantissa digits: "", ".", "+", "e5"
    let mant = intPart + frac;

    if (i < len && (s[i] == 101 || s[i] == 69)) {   // 'e' or 'E'
        i = i + 1;
        let expNeg = false;
        if (i < len && s[i] == 45) { expNeg = true; i = i + 1; }
        else if (i < len && s[i] == 43) { i = i + 1; }
        let sawExpDigit = false;
        let exp = 0;
        while (i < len && s[i] >= 48 && s[i] <= 57) {
            exp = exp * 10 + (s[i] - 48);
            sawExpDigit = true;
            i = i + 1;
        }
        if (!sawExpDigit) { return undefined; }   // 'e' with no exponent digits
        let p = 0;
        let factor = 1.0;
        while (p < exp) { factor = factor * 10.0; p = p + 1; }
        if (expNeg) { mant = mant / factor; } else { mant = mant * factor; }
    }

    if (i != len) { return undefined; }   // trailing garbage
    if (neg) { mant = 0.0 - mant; }
    return mant;
}

pub fn delete(self: string): void {
}

@test
fn test_string_helpers(): void {
    if (!startsWith("hello", "he")) { nova_test_fail("startsWith fail"); }
    if (startsWith("hello", "lo")) { nova_test_fail("startsWith negative fail"); }
    if (!endsWith("hello", "lo")) { nova_test_fail("endsWith fail"); }
    if (endsWith("hello", "he")) { nova_test_fail("endsWith negative fail"); }
    if (!contains("hello", "el")) { nova_test_fail("contains fail"); }
    if (contains("hello", "world")) { nova_test_fail("contains negative fail"); }

    if (indexOf("hello", "e") != 1) { nova_test_fail("indexOf fail"); }
    if (indexOf("hello", "z") != -1) { nova_test_fail("indexOf negative fail"); }

    if (!eql("abc", "abc")) { nova_test_fail("eql fail"); }
    if (eql("abc", "def")) { nova_test_fail("eql negative fail"); }

    if (compare("abc", "def") != -1) { nova_test_fail("compare < fail"); }
    if (compare("def", "abc") != 1) { nova_test_fail("compare > fail"); }
    if (compare("abc", "abc") != 0) { nova_test_fail("compare == fail"); }

    if (parseI64("1234") != 1234) { nova_test_fail("parseI64 positive fail"); }
    if (parseI64("-56") != -56) { nova_test_fail("parseI64 negative fail"); }

    // A2 failure-surfacing parse family.
    if ((parseLong("1234") ?? -1) != 1234) { nova_test_fail("parseLong ok fail"); }
    if ((parseLong("-56") ?? 1) != -56) { nova_test_fail("parseLong neg fail"); }
    if (parseLong("") != undefined) { nova_test_fail("parseLong empty should be undefined"); }
    if (parseLong("12x") != undefined) { nova_test_fail("parseLong trailing garbage should be undefined"); }
    if (parseLong("+") != undefined) { nova_test_fail("parseLong lone sign should be undefined"); }
    if (parseLong("99999999999999999999") != undefined) { nova_test_fail("parseLong overflow should be undefined"); }

    if ((parseInt("42") ?? -1) != 42) { nova_test_fail("parseInt ok fail"); }
    if (parseInt("3000000000") != undefined) { nova_test_fail("parseInt out-of-i32-range should be undefined"); }
    if (parseInt("abc") != undefined) { nova_test_fail("parseInt non-numeric should be undefined"); }

    let d1 = (parseDouble("1e3") ?? 0.0) - 1000.0;
    if (d1 > 0.0001 || d1 < -0.0001) { nova_test_fail("parseDouble exponent fail"); }
    let d2 = (parseDouble("2.5") ?? 0.0) - 2.5;
    if (d2 > 0.0001 || d2 < -0.0001) { nova_test_fail("parseDouble frac fail"); }
    let d3 = (parseDouble("-1.5e2") ?? 0.0) + 150.0;
    if (d3 > 0.0001 || d3 < -0.0001) { nova_test_fail("parseDouble neg exp fail"); }
    if (parseDouble("") != undefined) { nova_test_fail("parseDouble empty should be undefined"); }
    if (parseDouble("1.2.3") != undefined) { nova_test_fail("parseDouble double-dot should be undefined"); }
    if (parseDouble("1e") != undefined) { nova_test_fail("parseDouble dangling exp should be undefined"); }
    if (parseDouble("5x") != undefined) { nova_test_fail("parseDouble trailing garbage should be undefined"); }
}
