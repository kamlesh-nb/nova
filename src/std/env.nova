
import assert;
import bytes;
import mem.allocator;
import collections.list;
import os.sys;

// getenv returns a pointer into the process environment (never freed); copy it into a fresh Nova
// string. An unset name gives a null pointer, returned as "".
pub fn get(name: string): string {
    let cp = sys.cstr(name);
    let v = sys.getenv(cp);
    bytes.free(cp);
    if (v == 0) {
        return "";
    }

    let clen = 0;
    while (bytes.read_byte(v, clen) != 0) {
        clen = clen + 1;
    }
    let out = allocator.globalAllocator().alloc(clen);
    let i = 0;
    while (i < clen) {
        bytes.write_byte(out, i, bytes.read_byte(v, i));
        i = i + 1;
    }
    return out as string;
}

// Process arguments stay on the runtime primitives nova_arg_count/nova_arg_at: argv is captured by
// the generated main entry, which no os/sys binding can reach.
pub fn args(): list.List<string> {
    let result: list.List<string> = list.List<string>();
    let n: int = nova_arg_count();
    for (i in 0..n) {
        result.push(nova_arg_at(i));
    }
    return result;
}

pub fn set(name: string, value: string): void {
    let cn = sys.cstr(name);
    let cv = sys.cstr(value);
    sys.setenv(cn, cv, 1);
    bytes.free(cn);
    bytes.free(cv);
}

@test
fn test_env_get_set(): void {
    set("NOVA_TEST_VAR", "hello_world_123");
    let val = get("NOVA_TEST_VAR");
    assert.isTrue(val == "hello_world_123");
    console.log("ENV TEST: NOVA_TEST_VAR = " + val);
}

@test
fn test_env_get_unset(): void {

    let missing = get("NOVA_DEFINITELY_NOT_SET_12345");
    assert.isTrue(missing == "");
    assert.isTrue(missing.length == 0);
    assert.isTrue(("[" + missing + "]") == "[]");
}
