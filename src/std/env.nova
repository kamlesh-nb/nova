// env.nova — Environment variables + process arguments API

import assert;
import collections.list;

/// Returns the variable's value, or "" if it is not set.
pub fn get(name: string): string {
    return nova_getenv(name);
}

/// The program's command-line arguments, `argv[0]` first (the program path), then the user args.
/// Built from the argc/argv the runtime `main` stashed. This is the idiomatic accessor (like Rust's
/// `env::args()` / Go's `os.Args`); a bare `fn main()` cannot receive them directly.
pub fn args(): list.List<string> {
    let result: list.List<string> = list.List<string>();
    let n: int = nova_arg_count();
    for (i in 0..n) {
        result.push(nova_arg_at(i));
    }
    return result;
}

pub fn set(name: string, value: string): void {
    nova_setenv(name, value);
}

@test
fn test_env_get_set(): void {
    set("NOVA_TEST_VAR", "hello_world_123");
    let val = get("NOVA_TEST_VAR");
    assert.isTrue(val == "hello_world_123");
    console.log("ENV TEST: NOVA_TEST_VAR = " + val);
}

@test
fn test_env_get_unset(): void {
    // An unset variable must come back as "" — it used to come back as a null pointer typed as a
    // string, so merely touching it (compare/concat/length) segfaulted.
    let missing = get("NOVA_DEFINITELY_NOT_SET_12345");
    assert.isTrue(missing == "");
    assert.isTrue(missing.length == 0);
    assert.isTrue(("[" + missing + "]") == "[]");
}
