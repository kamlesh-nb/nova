
import bytes;
import string;
import assert;

const SECONDS_PER_MINUTE = 60;
const MINUTES_PER_HOUR = 60;
const HOURS_PER_DAY = 24;
const SECONDS_PER_HOUR = SECONDS_PER_MINUTE * MINUTES_PER_HOUR;
const SECONDS_PER_DAY = SECONDS_PER_HOUR * HOURS_PER_DAY;

const MONTH_DAYS: int[12] = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];

pub struct Duration {
    pub days: int,
    pub hours: int,
    pub minutes: int,
    pub seconds: int,
}

pub fn isLeapYear(year: int): bool {
    if (year % 400 == 0) {
        return true;
    }
    if (year % 100 == 0) {
        return false;
    }
    return (year % 4 == 0);
}

pub fn daysInMonth(year: int, month: int): int {
    if (month < 1 || month > 12) {
        return 0;
    }
    let dim = MONTH_DAYS[month - 1];
    if (month == 2 && isLeapYear(year)) {
        dim = 29;
    }
    return dim;
}

pub fn now(): int {
    return nova_time_now();
}

pub fn nowNs(): long {
    return nova_time_now_ns();
}

pub fn parse(s: string): int | undefined {
    return parseIso(s);
}

pub fn fromIso(s: string): int | undefined {
    return parseIso(s);
}

fn parseIso(s: string): int | undefined {
    let len = s.length;
    if (len < 10) {
        return undefined;
    }

    let year = parseInt(s, 0, 4);
    if (year == undefined) return undefined;
    if (s[4] != 45 && s[4] != 45) {

        if (s[4] != 45) return undefined;
    }
    let month = parseInt(s, 5, 7);
    if (month == undefined) return undefined;
    let day = parseInt(s, 8, 10);
    if (day == undefined) return undefined;

    if (month < 1 || month > 12) return undefined;
    let dim = daysInMonth(year, month);
    if (day < 1 || day > dim) return undefined;

    let hour: int = 0;
    let minute: int = 0;
    let second: int = 0;

    if (len >= 11) {
        let sep = s[10];
        if (sep == 'T' || sep == 32) {
            if (len < 19) {

            } else {
                hour = parseInt(s, 11, 13) ?? 0;
                minute = parseInt(s, 14, 16) ?? 0;
                second = parseInt(s, 17, 19) ?? 0;

                if (hour < 0 || hour > 23) return undefined;
                if (minute < 0 || minute > 59) return undefined;
                if (second < 0 || second > 59) return undefined;
            }
        }

    }

    let timestamp = dateToTimestamp(year, month, day, hour, minute, second);
    return timestamp;
}

fn parseInt(s: string, start: int, end: int): int | undefined {
    if (start < 0 || end > s.length || start >= end) {
        return undefined;
    }
    let res = 0;
    let i = start;
    while (i < end) {
        let c = s[i];
        if (c < 48 || c > 57) {
            return undefined;
        }
        res = res * 10 + (c - 48);
        i = i + 1;
    }
    return res;
}

fn dateToTimestamp(year: int, month: int, day: int, hour: int, minute: int, second: int): int {

    let days = 0;
    let y = 1970;
    while (y < year) {
        days = days + 365 + (if isLeapYear(y) then 1 else 0);
        y = y + 1;
    }
    let m = 1;
    while (m < month) {
        days = days + daysInMonth(year, m);
        m = m + 1;
    }
    days = days + (day - 1);
    return days * SECONDS_PER_DAY + hour * SECONDS_PER_HOUR + minute * SECONDS_PER_MINUTE + second;
}

pub fn format(t: int, fmt: string): string {
    let (year, month, day, hour, minute, second) = timestampToDate(t);

    let result = bytes.alloc(fmt.length * 4 + 1);
    let offset = 0;
    let i = 0;
    while (i < fmt.length) {
        let c = fmt[i];
        if (c == '%') {
            if (i + 1 < fmt.length) {
                let next_c = fmt[i+1];
                if (next_c == 'Y') {
                    offset = offset + writeNumber(result, offset, year, 4);
                    i = i + 2;
                    continue;
                }
                if (next_c == 'm') {
                    offset = offset + writeNumber(result, offset, month, 2);
                    i = i + 2;
                    continue;
                }
                if (next_c == 'd') {
                    offset = offset + writeNumber(result, offset, day, 2);
                    i = i + 2;
                    continue;
                }
                if (next_c == 'H') {
                    offset = offset + writeNumber(result, offset, hour, 2);
                    i = i + 2;
                    continue;
                }
                if (next_c == 'M') {
                    offset = offset + writeNumber(result, offset, minute, 2);
                    i = i + 2;
                    continue;
                }
                if (next_c == 'S') {
                    offset = offset + writeNumber(result, offset, second, 2);
                    i = i + 2;
                    continue;
                }
                if (next_c == '%') {
                    bytes.write_byte(result, offset, 37);
                    offset = offset + 1;
                    i = i + 2;
                    continue;
                }
            }
        }
        if (c == 'Y') {

            if (i + 3 < fmt.length && fmt[i+1] == 'Y' && fmt[i+2] == 'Y' && fmt[i+3] == 'Y') {
                offset = offset + writeNumber(result, offset, year, 4);
                i = i + 4;
                continue;
            }
            if (i + 1 < fmt.length && fmt[i+1] == 'Y') {
                offset = offset + writeNumber(result, offset, year % 100, 2);
                i = i + 2;
                continue;
            }
        }
        if (c == 'M') {

            if (i + 1 < fmt.length && fmt[i+1] == 'M') {
                offset = offset + writeNumber(result, offset, month, 2);
                i = i + 2;
                continue;
            } else {
                offset = offset + writeNumber(result, offset, month, 0);
                i = i + 1;
                continue;
            }
        }
        if (c == 'D') {
            if (i + 1 < fmt.length && fmt[i+1] == 'D') {
                offset = offset + writeNumber(result, offset, day, 2);
                i = i + 2;
                continue;
            } else {
                offset = offset + writeNumber(result, offset, day, 0);
                i = i + 1;
                continue;
            }
        }
        if (c == 'h') {
            if (i + 1 < fmt.length && fmt[i+1] == 'h') {
                offset = offset + writeNumber(result, offset, hour, 2);
                i = i + 2;
                continue;
            } else {
                offset = offset + writeNumber(result, offset, hour, 0);
                i = i + 1;
                continue;
            }
        }
        if (c == 'm') {
            if (i + 1 < fmt.length && fmt[i+1] == 'm') {
                offset = offset + writeNumber(result, offset, minute, 2);
                i = i + 2;
                continue;
            } else {
                offset = offset + writeNumber(result, offset, minute, 0);
                i = i + 1;
                continue;
            }
        }
        if (c == 's') {
            if (i + 1 < fmt.length && fmt[i+1] == 's') {
                offset = offset + writeNumber(result, offset, second, 2);
                i = i + 2;
                continue;
            } else {
                offset = offset + writeNumber(result, offset, second, 0);
                i = i + 1;
                continue;
            }
        }
        if (c == 'T' && i + 2 < fmt.length && fmt[i+1] == 'Z' && fmt[i+2] == 'D') {

            bytes.write_byte(result, offset, 'Z');
            offset = offset + 1;
            i = i + 3;
            continue;
        }

        bytes.write_byte(result, offset, c);
        offset = offset + 1;
        i = i + 1;
    }
    bytes.write_i32(result - 4, 0, offset);
    return result as string;
}

fn writeNumber(ptr: int, offset: int, val: int, min_digits: int): int {

    let temp = val;
    let digits = 0;
    if (temp == 0) {
        digits = 1;
    } else {
        while (temp > 0) {
            digits = digits + 1;
            temp = temp / 10;
        }
    }
    let pad = 0;
    if (digits < min_digits) {
        pad = min_digits - digits;
    }
    let total = digits + pad;
    let i = total - 1;
    temp = val;
    while (i >= 0) {
        if (i < pad) {
            bytes.write_byte(ptr, offset + i, 48);
        } else {
            bytes.write_byte(ptr, offset + i, (temp % 10) + 48);
            temp = temp / 10;
        }
        i = i - 1;
    }
    return total;
}

fn timestampToDate(t: int): (int, int, int, int, int, int) {
    let total_sec = t;
    let second = total_sec % SECONDS_PER_MINUTE;
    let total_min = total_sec / SECONDS_PER_MINUTE;
    let minute = total_min % MINUTES_PER_HOUR;
    let total_hour = total_min / MINUTES_PER_HOUR;
    let hour = total_hour % HOURS_PER_DAY;
    let total_day = total_hour / HOURS_PER_DAY;

    let year = 1970;
    let days = total_day;
    while (true) {
        let days_in_year = 365 + (if isLeapYear(year) then 1 else 0);
        if (days < days_in_year) {
            break;
        }
        days = days - days_in_year;
        year = year + 1;
    }

    let month = 1;
    while (true) {
        let dim = daysInMonth(year, month);
        if (days < dim) {
            break;
        }
        days = days - dim;
        month = month + 1;
    }
    let day = days + 1;

    return (year, month, day, hour, minute, second);
}

pub fn toIso(t: int): string {
    return format(t, "YYYY-MM-DDThh:mm:ssTZD");
}

pub fn addDays(t: int, days: int): int {
    return t + days * SECONDS_PER_DAY;
}

pub fn addHours(t: int, hours: int): int {
    return t + hours * SECONDS_PER_HOUR;
}

pub fn addMinutes(t: int, minutes: int): int {
    return t + minutes * SECONDS_PER_MINUTE;
}

pub fn addSeconds(t: int, seconds: int): int {
    return t + seconds;
}

pub fn dateDiff(t1: int, t2: int): Duration {
    let total_sec = t2 - t1;
    if (total_sec < 0) {
        total_sec = -total_sec;
    }
    let days = total_sec / SECONDS_PER_DAY;
    let rem = total_sec - (days * SECONDS_PER_DAY);
    let hours = rem / SECONDS_PER_HOUR;
    rem = rem - (hours * SECONDS_PER_HOUR);
    let minutes = rem / SECONDS_PER_MINUTE;
    let seconds = rem - (minutes * SECONDS_PER_MINUTE);

    return Duration{
        days: days,
        hours: hours,
        minutes: minutes,
        seconds: seconds,
    };
}

pub fn delete(self: Duration): void {
}

@test
fn test_datetime(): void {
    assert.isTrue(isLeapYear(2020));
    assert.isFalse(isLeapYear(2021));
    assert.isTrue(isLeapYear(2000));
    assert.isFalse(isLeapYear(1900));

    assert.equalInt(31, daysInMonth(2020, 1));
    assert.equalInt(29, daysInMonth(2020, 2));
    assert.equalInt(28, daysInMonth(2021, 2));

    let ts = parse("2024-03-15 12:30:00") ?? 0;
    assert.isTrue(ts > 0);
    let iso = toIso(ts);

    assert.equalInt(1, if (string.startsWith(iso, "2024-03-15")) 1 else 0);
}
