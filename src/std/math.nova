import assert;

pub fn abs(val: int): int {
    if (val < 0) {
        return -val;
    }
    return val;
}

pub fn sqrt(val: int): int {
    if (val < 0) {
        return 0;
    }
    if (val == 0) {
        return 0;
    }
    if (val == 1) {
        return 1;
    }
    let start = 1;
    let end = val;
    let ans = 0;
    while (start <= end) {
        let mid = (start + end) / 2;
        let sq = mid * mid;
        if (sq == val) {
            return mid;
        }
        if (sq < val) {
            start = mid + 1;
            ans = mid;
        } else {
            end = mid - 1;
        }
    }
    return ans;
}

pub fn pow(base: int, exp: int): int {
    let result = 1;
    let i = 0;
    while (i < exp) {
        result = result * base;
        i = i + 1;
    }
    return result;
}

pub fn min(a: int, b: int): int {
    if (a < b) {
        return a;
    }
    return b;
}

pub fn max(a: int, b: int): int {
    if (a > b) {
        return a;
    }
    return b;
}

pub fn clamp(val: int, min_val: int, max_val: int): int {
    if (val < min_val) {
        return min_val;
    }
    if (val > max_val) {
        return max_val;
    }
    return val;
}

pub fn int_hash(val: int): int {
    return val;
}

pub fn pi(): double { return 3.14159265358979323846; }
pub fn e(): double { return 2.71828182845904523536; }

pub fn fabs(x: double): double {
    if (x < 0.0) { return 0.0 - x; }
    return x;
}

pub fn fmin(a: double, b: double): double {
    if (a < b) { return a; }
    return b;
}

pub fn fmax(a: double, b: double): double {
    if (a > b) { return a; }
    return b;
}

pub fn fclamp(x: double, lo: double, hi: double): double {
    if (x < lo) { return lo; }
    if (x > hi) { return hi; }
    return x;
}

pub fn ffloor(x: double): double {
    let t = x as int;
    let tf = t as double;
    if (tf > x) { return (t - 1) as double; }
    return tf;
}

pub fn fceil(x: double): double {
    let t = x as int;
    let tf = t as double;
    if (tf < x) { return (t + 1) as double; }
    return tf;
}

pub fn fround(x: double): double {
    if (x < 0.0) { return fceil(x - 0.5); }
    return ffloor(x + 0.5);
}

pub fn fsqrt(x: double): double {
    // Hardware fsqrt via the llvm.sqrt.f64 intrinsic (was a 30-iteration Newton loop). The <=0 guard
    // preserves the historical contract (0.0 for non-positive input) rather than the intrinsic's NaN.
    if (x <= 0.0) { return 0.0; }
    return nova_f64_sqrt(x);
}

pub fn fpow(base: double, exp: int): double {
    let result = 1.0;
    let i = 0;
    while (i < exp) {
        result = result * base;
        i = i + 1;
    }
    return result;
}

pub fn ln2(): double { return 0.69314718055994530942; }

pub fn fln(x: double): double {
    if (x <= 0.0) { return 0.0; }
    let m = x;
    let k = 0;
    while (m >= 2.0) { m = m / 2.0; k = k + 1; }
    while (m < 1.0) { m = m * 2.0; k = k - 1; }
    let z = (m - 1.0) / (m + 1.0);
    let z2 = z * z;
    let term = z;
    let sum = 0.0;
    let n = 0;
    while (n < 20) {
        sum = sum + term / ((2.0 * (n as double)) + 1.0);
        term = term * z2;
        n = n + 1;
    }
    return (2.0 * sum) + ((k as double) * ln2());
}

pub fn fexp(x: double): double {
    let k = fround(x / ln2());
    let r = x - (k * ln2());
    let term = 1.0;
    let sum = 1.0;
    let n = 1;
    while (n < 18) {
        term = term * r / (n as double);
        sum = sum + term;
        n = n + 1;
    }
    let ki = k as int;
    let scale = 1.0;
    while (ki > 0) { scale = scale * 2.0; ki = ki - 1; }
    while (ki < 0) { scale = scale / 2.0; ki = ki + 1; }
    return sum * scale;
}

pub fn fpowf(base: double, exp: double): double {
    if (base <= 0.0) { return 0.0; }
    return fexp(exp * fln(base));
}

pub fn tau(): double { return 6.28318530717958647692; }
pub fn log10e(): double { return 0.43429448190325182765; }
pub fn log2e(): double { return 1.44269504088896340736; }

pub fn log10(x: double): double { return fln(x) * log10e(); }
pub fn log2(x: double): double { return fln(x) * log2e(); }

// Range-reduce an angle to [-pi, pi] so the Maclaurin series stays accurate for large inputs.
fn wrapAngle(x: double): double {
    let t = x;
    while (t > pi()) { t = t - tau(); }
    while (t < 0.0 - pi()) { t = t + tau(); }
    return t;
}

pub fn sin(x: double): double {
    let r = wrapAngle(x);
    let term = r;
    let sum = r;
    let r2 = r * r;
    let n = 1;
    while (n < 12) {
        // term_{n} = -term_{n-1} * r^2 / ((2n)(2n+1))
        let d = ((2.0 * (n as double)) * ((2.0 * (n as double)) + 1.0));
        term = (0.0 - term) * r2 / d;
        sum = sum + term;
        n = n + 1;
    }
    return sum;
}

pub fn cos(x: double): double {
    let r = wrapAngle(x);
    let term = 1.0;
    let sum = 1.0;
    let r2 = r * r;
    let n = 1;
    while (n < 12) {
        // term_{n} = -term_{n-1} * r^2 / ((2n-1)(2n))
        let d = (((2.0 * (n as double)) - 1.0) * (2.0 * (n as double)));
        term = (0.0 - term) * r2 / d;
        sum = sum + term;
        n = n + 1;
    }
    return sum;
}

pub fn tan(x: double): double {
    let c = cos(x);
    if (fabs(c) < 0.000000000001) { return 0.0; }
    return sin(x) / c;
}

// atan via the identity atan(x) = 2*atan(x/(1+sqrt(1+x^2))) applied twice to shrink |x|,
// then the Maclaurin series (which only converges for |x|<=1).
pub fn atan(x: double): double {
    let neg = x < 0.0;
    let a = fabs(x);
    let reduce = 0;
    while (a > 0.2) {
        a = a / (1.0 + fsqrt(1.0 + (a * a)));
        reduce = reduce + 1;
    }
    let term = a;
    let sum = a;
    let a2 = a * a;
    let n = 1;
    while (n < 16) {
        term = (0.0 - term) * a2;
        sum = sum + term / ((2.0 * (n as double)) + 1.0);
        n = n + 1;
    }
    let result = sum;
    while (reduce > 0) { result = result * 2.0; reduce = reduce - 1; }
    if (neg) { return 0.0 - result; }
    return result;
}

pub fn atan2(y: double, x: double): double {
    if (x > 0.0) { return atan(y / x); }
    if (x < 0.0) {
        if (y >= 0.0) { return atan(y / x) + pi(); }
        return atan(y / x) - pi();
    }
    // x == 0
    if (y > 0.0) { return pi() / 2.0; }
    if (y < 0.0) { return 0.0 - (pi() / 2.0); }
    return 0.0;
}

@test
fn test_trig_log(): void {
    // sin(pi/6) ~= 0.5, cos(pi/3) ~= 0.5
    assert.isTrue(fabs(sin(pi() / 6.0) - 0.5) < 0.0001);
    assert.isTrue(fabs(cos(pi() / 3.0) - 0.5) < 0.0001);
    // sin(0)=0, cos(0)=1
    assert.isTrue(fabs(sin(0.0)) < 0.0001);
    assert.isTrue(fabs(cos(0.0) - 1.0) < 0.0001);
    // tan(pi/4) ~= 1
    assert.isTrue(fabs(tan(pi() / 4.0) - 1.0) < 0.0001);
    // large-angle range reduction: sin(10pi + pi/6) ~= 0.5
    assert.isTrue(fabs(sin((10.0 * pi()) + (pi() / 6.0)) - 0.5) < 0.0005);
    // atan(1) ~= pi/4, atan2(1,1) ~= pi/4
    assert.isTrue(fabs(atan(1.0) - (pi() / 4.0)) < 0.0001);
    assert.isTrue(fabs(atan2(1.0, 1.0) - (pi() / 4.0)) < 0.0001);
    assert.isTrue(fabs(atan2(1.0, 0.0 - 1.0) - (3.0 * pi() / 4.0)) < 0.0005);
    // log10(1000)=3, log2(8)=3
    assert.isTrue(fabs(log10(1000.0) - 3.0) < 0.0005);
    assert.isTrue(fabs(log2(8.0) - 3.0) < 0.0005);
}

@test
fn test_float_math(): void {
    assert.isTrue(fabs(0.0 - 3.5) > 3.4);
    assert.isTrue(fabs(0.0 - 3.5) < 3.6);
    assert.isTrue(ffloor(3.7) > 2.9);
    assert.isTrue(ffloor(3.7) < 3.1);
    assert.isTrue(fceil(3.2) > 3.9);
    assert.isTrue(fceil(3.2) < 4.1);
    assert.isTrue(fround(3.5) > 3.9);
    assert.isTrue(fround(2.4) < 2.6);
    assert.isTrue(fsqrt(16.0) > 3.9);
    assert.isTrue(fsqrt(16.0) < 4.1);
    assert.isTrue(fmin(1.5, 2.5) < 2.0);
    assert.isTrue(fmax(1.5, 2.5) > 2.0);
    assert.isTrue(fpow(2.0, 3) > 7.9);
}

// --- Honest (checked / saturating) integer arithmetic ---------------------------------------------
// Nova's `+`/`-`/`*` on `int` (32-bit) and `long` (64-bit) WRAP on overflow, which is defined
// two's-complement behaviour and is exactly what hashers and bit-mixers below rely on. These helpers
// are the opt-in "be honest about overflow" path: the checked* forms return `undefined` instead of a
// wrapped value, the saturating* forms clamp to the type's bound. Use them when a wrapped result would
// be a silent wrong answer (sizes, counters, money-as-integer, index maths).

pub fn intMax(): int { return 2147483647; }
pub fn intMin(): int { return -2147483647 - 1; }

fn longMax(): long { return 9223372036854775807; }
fn longMin(): long { return -9223372036854775807 - 1; }

// 32-bit checked ops: compute in 64-bit and reject a result outside int's range.
pub fn checkedAddInt(a: int, b: int): int | undefined {
    let r: long = (a as long) + (b as long);
    if (r > (intMax() as long) || r < (intMin() as long)) { return undefined; }
    return r as int;
}

pub fn checkedSubInt(a: int, b: int): int | undefined {
    let r: long = (a as long) - (b as long);
    if (r > (intMax() as long) || r < (intMin() as long)) { return undefined; }
    return r as int;
}

pub fn checkedMulInt(a: int, b: int): int | undefined {
    let r: long = (a as long) * (b as long);
    if (r > (intMax() as long) || r < (intMin() as long)) { return undefined; }
    return r as int;
}

// 32-bit saturating ops: clamp to intMax()/intMin() instead of wrapping.
pub fn satAddInt(a: int, b: int): int {
    let r: long = (a as long) + (b as long);
    if (r > (intMax() as long)) { return intMax(); }
    if (r < (intMin() as long)) { return intMin(); }
    return r as int;
}

pub fn satSubInt(a: int, b: int): int {
    let r: long = (a as long) - (b as long);
    if (r > (intMax() as long)) { return intMax(); }
    if (r < (intMin() as long)) { return intMin(); }
    return r as int;
}

pub fn satMulInt(a: int, b: int): int {
    let r: long = (a as long) * (b as long);
    if (r > (intMax() as long)) { return intMax(); }
    if (r < (intMin() as long)) { return intMin(); }
    return r as int;
}

// 64-bit checked ops: no wider type to fall back on, so detect overflow directly.
pub fn checkedAddLong(a: long, b: long): long | undefined {
    // a + b overflows iff b > 0 and a > MAX - b, or b < 0 and a < MIN - b.
    if (b > 0 && a > longMax() - b) { return undefined; }
    if (b < 0 && a < longMin() - b) { return undefined; }
    return a + b;
}

pub fn checkedSubLong(a: long, b: long): long | undefined {
    if (b < 0 && a > longMax() + b) { return undefined; }
    if (b > 0 && a < longMin() + b) { return undefined; }
    return a - b;
}

pub fn checkedMulLong(a: long, b: long): long | undefined {
    if (a == 0 || b == 0) { return 0; }
    let r: long = a * b;
    // Recover an operand by dividing back; a mismatch (or the MIN/-1 special case) means it overflowed.
    if (a == -1 && b == longMin()) { return undefined; }
    if (b == -1 && a == longMin()) { return undefined; }
    if (r / b != a) { return undefined; }
    return r;
}

@test
fn test_checked_arith(): void {
    // int checked: normal and boundary.
    assert.equalInt(5, checkedAddInt(2, 3) ?? -999);
    assert.equalInt(1, if (checkedAddInt(intMax(), 1) == undefined) 1 else 0);
    assert.equalInt(1, if (checkedSubInt(intMin(), 1) == undefined) 1 else 0);
    assert.equalInt(1, if (checkedMulInt(100000, 100000) == undefined) 1 else 0);
    assert.equalInt(6, checkedMulInt(2, 3) ?? -999);
    // int saturating.
    assert.equalInt(intMax(), satAddInt(intMax(), 100));
    assert.equalInt(intMin(), satSubInt(intMin(), 100));
    assert.equalInt(intMax(), satMulInt(100000, 100000));
    // long checked: normal and boundary.
    assert.isTrue((checkedAddLong(longMax() as long, 0) ?? 0) == longMax());
    assert.equalInt(1, if (checkedAddLong(longMax(), 1) == undefined) 1 else 0);
    assert.equalInt(1, if (checkedSubLong(longMin(), 1) == undefined) 1 else 0);
    assert.equalInt(1, if (checkedMulLong(longMax(), 2) == undefined) 1 else 0);
    assert.isTrue((checkedMulLong(1000000, 1000000) ?? 0) == (1000000000000 as long));
}

@test
fn test_math(): void {
    assert.equalInt(5, abs(-5));
    assert.equalInt(5, abs(5));
    assert.equalInt(3, sqrt(9));
    assert.equalInt(8, pow(2, 3));
    assert.equalInt(3, min(3, 5));
    assert.equalInt(5, max(3, 5));
    assert.equalInt(5, clamp(3, 5, 10));
    assert.equalInt(8, clamp(8, 5, 10));
    assert.equalInt(10, clamp(12, 5, 10));
}
