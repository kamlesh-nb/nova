// text/utf8.nova — UTF-8 codepoint handling (C2). Nova strings are byte buffers that
// hold UTF-8; `.length` and indexing are BY BYTE (like Rust/Go). This module adds the
// codepoint layer: decode/encode codepoints, count them, iterate them, and validate.
// Full Unicode case-mapping / normalization is i18n (C7) and lives elsewhere.
//
// `bytes.read_byte` zero-extends, so every byte here is 0..255. (Nova has no hex
// literals, so the UTF-8 bit masks are written in decimal, with the hex in comments.)

import bytes;
import list;
import string;
import assert;

/// Number of bytes in the UTF-8 sequence that STARTS with lead byte `b0`. An invalid
/// lead (a stray continuation byte or 0xF8..0xFF) is treated as width 1 so iteration
/// always advances; use `isValid` to reject malformed input up front.
fn widthOfLead(b0: int): int {
    if (b0 < 128) { return 1; }   // 0xxxxxxx  ASCII        (< 0x80)
    if (b0 < 192) { return 1; }   // 10xxxxxx  continuation (< 0xC0, invalid as lead)
    if (b0 < 224) { return 2; }   // 110xxxxx               (< 0xE0)
    if (b0 < 240) { return 3; }   // 1110xxxx               (< 0xF0)
    if (b0 < 248) { return 4; }   // 11110xxx               (< 0xF8)
    return 1;                     // 0xF8..0xFF  invalid
}

/// The codepoint encoded at BYTE offset `i`. Assumes valid UTF-8 (validate with
/// `isValid` first if the source is untrusted).
pub fn codepointAt(s: string, i: int): int {
    let b0 = bytes.read_byte(s, i);
    if (b0 < 128) { return b0; }
    if (b0 < 224) {                                     // 2-byte: 110xxxxx 10xxxxxx
        let b1 = bytes.read_byte(s, i + 1);
        return ((b0 & 31) << 6) | (b1 & 63);           // & 0x1F, & 0x3F
    }
    if (b0 < 240) {                                     // 3-byte
        let b1 = bytes.read_byte(s, i + 1);
        let b2 = bytes.read_byte(s, i + 2);
        return ((b0 & 15) << 12) | ((b1 & 63) << 6) | (b2 & 63);
    }
    let b1 = bytes.read_byte(s, i + 1);                 // 4-byte
    let b2 = bytes.read_byte(s, i + 2);
    let b3 = bytes.read_byte(s, i + 3);
    return ((b0 & 7) << 18) | ((b1 & 63) << 12) | ((b2 & 63) << 6) | (b3 & 63);
}

/// Byte width of the codepoint at byte offset `i`.
pub fn widthAt(s: string, i: int): int {
    return widthOfLead(bytes.read_byte(s, i));
}

/// Number of Unicode codepoints (NOT bytes — that is `.length`).
pub fn codepointCount(s: string): int {
    let n = s.length;
    let i = 0;
    let count = 0;
    while (i < n) {
        i = i + widthOfLead(bytes.read_byte(s, i));
        count = count + 1;
    }
    return count;
}

/// Encode a single codepoint as a UTF-8 string. (192=0xC0, 128=0x80, 224=0xE0, 240=0xF0)
pub fn fromCodepoint(cp: int): string {
    if (cp < 128) {
        let p = bytes.alloc(1);
        bytes.write_byte(p, 0, cp);
        return p as string;
    }
    if (cp < 2048) {                                    // < 0x800
        let p = bytes.alloc(2);
        bytes.write_byte(p, 0, 192 | (cp >> 6));
        bytes.write_byte(p, 1, 128 | (cp & 63));
        return p as string;
    }
    if (cp < 65536) {                                   // < 0x10000
        let p = bytes.alloc(3);
        bytes.write_byte(p, 0, 224 | (cp >> 12));
        bytes.write_byte(p, 1, 128 | ((cp >> 6) & 63));
        bytes.write_byte(p, 2, 128 | (cp & 63));
        return p as string;
    }
    let p = bytes.alloc(4);
    bytes.write_byte(p, 0, 240 | (cp >> 18));
    bytes.write_byte(p, 1, 128 | ((cp >> 12) & 63));
    bytes.write_byte(p, 2, 128 | ((cp >> 6) & 63));
    bytes.write_byte(p, 3, 128 | (cp & 63));
    return p as string;
}

/// Split into a list of single-codepoint strings — the CORRECT UTF-8 iteration (unlike
/// a byte split, which would cut multi-byte characters apart).
pub fn chars(s: string): list.List<string> {
    let result = list.List<string>();
    let n = s.length;
    let i = 0;
    while (i < n) {
        let w = widthOfLead(bytes.read_byte(s, i));
        result.push(string.slice(s, i, i + w));
        i = i + w;
    }
    return result;
}

/// Is `s` well-formed UTF-8? Rejects stray/short continuation bytes and truncated
/// sequences. (Does not reject overlong encodings or surrogate codepoints — a stricter
/// check for a later pass.)
pub fn isValid(s: string): bool {
    let n = s.length;
    let i = 0;
    while (i < n) {
        let b0 = bytes.read_byte(s, i);
        let w = 0;
        if (b0 < 128) { w = 1; }
        else if (b0 < 192) { return false; }   // continuation byte as lead
        else if (b0 < 224) { w = 2; }
        else if (b0 < 240) { w = 3; }
        else if (b0 < 248) { w = 4; }
        else { return false; }                  // 0xF8..0xFF
        if (i + w > n) { return false; }         // truncated sequence
        let j = 1;
        while (j < w) {
            let bj = bytes.read_byte(s, i + j);
            if (bj < 128 || bj >= 192) { return false; }  // not 10xxxxxx
            j = j + 1;
        }
        i = i + w;
    }
    return true;
}

@test
fn test_codepoint_count_vs_bytes(): void {
    // "héllo wörld" — 'é' and 'ö' are 2-byte UTF-8. 11 codepoints, 13 bytes.
    let s = "héllo wörld";
    assert.equalInt(codepointCount(s), 11);
    assert.equalInt(s.length, 13);        // byte length
}

@test
fn test_codepoint_at_and_roundtrip(): void {
    let s = "aé€";                        // 'a'=1B, 'é'=2B(U+00E9=233), '€'=3B(U+20AC=8364)
    assert.equalInt(codepointAt(s, 0), 97);       // 'a'
    assert.equalInt(codepointAt(s, 1), 233);      // 'é'
    assert.equalInt(codepointAt(s, 3), 8364);     // '€'
    assert.equalStr(fromCodepoint(97), "a");
    assert.equalStr(fromCodepoint(233), "é");
    assert.equalStr(fromCodepoint(8364), "€");
}

@test
fn test_chars_iteration(): void {
    let cs = chars("aé€");
    assert.equalInt(cs.len, 3);           // 3 codepoints, not 6 bytes
    assert.equalStr(cs.get(0), "a");
    assert.equalStr(cs.get(1), "é");
    assert.equalStr(cs.get(2), "€");
}

@test
fn test_validation(): void {
    assert.isTrue(isValid("héllo"));
    assert.isTrue(isValid(""));
    // A lone continuation byte (0x80=128) is invalid UTF-8.
    let bad = bytes.alloc(1);
    bytes.write_byte(bad, 0, 128);
    assert.isFalse(isValid(bad as string));
    bytes.free(bad);   // bytes.alloc is MANUAL memory — free it
}
