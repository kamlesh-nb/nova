// Metrics + lightweight tracing (T12). A production service exposes counters (monotonic totals) and
// gauges (point-in-time values) and can render them for a scrape endpoint; it also wants per-operation
// timing spans that emit a structured log line on finish. This module provides both over the same
// string-keyed registry, plus a Span that measures elapsed time and logs it.
//
//   let reg = metrics.newRegistry();
//   reg.inc("db_queries_total");
//   reg.setGauge("pool_idle", 4);
//   reg.snapshotProm();   // Prometheus text exposition
//   reg.snapshotJson();   // one JSON object
//
//   let sp = metrics.startSpan(lg, "db.query");
//   ... work ...
//   sp.finish(reg);       // logs {msg:"db.query", elapsed_ns:...} and bumps db.query_ns_total

import string;
import map;
import list;

// Render a signed 64-bit integer as decimal text (stdlib has no int->string, and template literals
// take string operands only).
pub fn numStr(n: long): string {
    if (n == 0) { return "0"; }
    let neg = n < 0;
    let v = if (neg) 0 - n else n;
    let digits = "";
    while (v > 0) {
        let d = (v % 10) as int;
        digits = string.slice("0123456789", d, d + 1) + digits;
        v = v / 10;
    }
    if (neg) { return "-" + digits; }
    return digits;
}

pub struct Registry {
    pub counters: Map<string, long>,
    pub gauges: Map<string, long>,
    pub names: List<string>,     // insertion order for stable snapshots (counters then gauges)

    init() {
        self.counters = Map<string, long>(64, string.hash);
        self.gauges = Map<string, long>(64, string.hash);
        self.names = List<string>();
    }

    fn track(self: Registry, name: string): void {
        // Record first-seen names so snapshots are deterministic (Map iteration order is not).
        let i = 0;
        while (i < self.names.size()) {
            if (string.eql(self.names.get(i) ?? "", name)) { return; }
            i = i + 1;
        }
        self.names.push(name);
    }

    // Counter: monotonic. add(n) / inc().
    pub fn add(self: Registry, name: string, n: long): void {
        let cur = self.counters.get(name) ?? 0;
        self.counters.set(name, cur + n);
        self.track(name);
    }
    pub fn inc(self: Registry, name: string): void { self.add(name, 1); }
    pub fn counter(self: Registry, name: string): long { return self.counters.get(name) ?? 0; }

    // Gauge: set to an absolute value.
    pub fn setGauge(self: Registry, name: string, v: long): void {
        self.gauges.set(name, v);
        self.track(name);
    }
    pub fn gauge(self: Registry, name: string): long { return self.gauges.get(name) ?? 0; }

    // Prometheus text exposition: `# TYPE name kind\nname value` per metric, insertion order.
    pub fn snapshotProm(self: Registry): string {
        let out = "";
        let i = 0;
        while (i < self.names.size()) {
            let name = self.names.get(i) ?? "";
            let c = self.counters.get(name);
            if (c != undefined) {
                out = out + "# TYPE " + name + " counter\n" + name + " " + numStr(c ?? 0) + "\n";
            } else {
                out = out + "# TYPE " + name + " gauge\n" + name + " " + numStr(self.gauges.get(name) ?? 0) + "\n";
            }
            i = i + 1;
        }
        return out;
    }

    // One JSON object: {"name":value,...} across counters and gauges.
    pub fn snapshotJson(self: Registry): string {
        let out = "{";
        let i = 0;
        while (i < self.names.size()) {
            let name = self.names.get(i) ?? "";
            let c = self.counters.get(name);
            let v = if (c != undefined) (c ?? 0) else (self.gauges.get(name) ?? 0);
            if (i > 0) { out = out + ","; }
            out = out + `"${name}":` + numStr(v);
            i = i + 1;
        }
        return out + "}";
    }
}

pub fn newRegistry(): Registry { return Registry(); }

// The timing Span (tracing) lives in the `log` module, since it emits a structured log line on finish
// -- keeping `metrics` free of a `log` dependency so importers that only want counters/gauges (e.g. the
// connection pool) do not drag the logger's import graph in. Use log.startSpan(logger, name).
