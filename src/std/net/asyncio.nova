// asyncio.nova — M3-D-6 non-blocking (offloaded) socket I/O for coroutines.
//
// The blocking recv/accept runs on a dedicated I/O thread pool, so the calling
// coroutine PARKS instead of holding a scheduler thread. Use via `await`:
//   let n = await socketRecvAsync(fd, buf, max);      // bytes read into buf
//   let client = await socketAcceptAsync(serverFd);   // client fd
//
// Called directly (not via `await`) these are stubs returning 0 — the compiler
// lowers the `await` form to the real parking offload.

pub fn socketRecvAsync(fd: int, buf: int, max: int): int {
    return 0;
}

pub fn socketAcceptAsync(fd: int): int {
    return 0;
}

// ---------------------------------------------------------------------------
// Scalable async server (M3-D-7): true non-blocking asio. A pending accept/recv/send
// holds NO thread (registered with kqueue/epoll), so a few scheduler threads serve
// tens of thousands of connections — each connection is a cheap `go` coroutine.
//
//   async fn serve(port: int): int {
//       let srv = serverListen(port);
//       while (true) {
//           let client = await aaccept(srv);   // parks; no thread held
//           spawn handle(client);                  // one coroutine per connection
//       }
//   }
//   async fn handle(client: long): int {
//       let buf = bytes.alloc(4096);
//       let n = await arecv(client, buf, 4096);
//       await asend(client, "HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nhi");
//       aclose(client);
//       return 0;
//   }

// Bind + listen; returns an acceptor handle (0 = failure, e.g. port already in use).
pub fn serverListen(port: int): long {
    return nova_aserver_listen(port);
}
// Awaitable client connect: `await aconnect(host, port)` → a socket handle (0 =
// failure). Resolves + connects without holding a thread. Use arecv/asend/aclose on
// the returned handle. Direct call is a stub.
pub fn aconnect(host: string, port: int): long {
    return 0;
}
// Awaitable: `await aaccept(srv)` → next client socket handle (parks until a
// connection arrives). Direct call is a stub.
pub fn aaccept(server: long): long {
    return 0;
}
// Awaitable: `await arecv(sock, buf, max)` → bytes read (0 = peer closed, -1 = error).
// `buf` is a `long` — a 64-bit address (nova_arecv takes `long long`); an `int` param would truncate
// a computed buffer address like `buf + offset` to 32 bits.
pub fn arecv(sock: long, buf: long, max: int): int {
    return 0;
}
// Awaitable recv WITH a deadline: `await arecvDeadline(sock, buf, max, ms)` → bytes read
// (0 = peer closed, -1 = error, -2 = the `ms`-ms deadline elapsed first). Non-blocking analog of
// SO_RCVTIMEO — races the recv against a timer, cancelling the loser. Direct call is a stub.
pub fn arecvDeadline(sock: long, buf: long, max: int, ms: int): int {
    return 0;
}
// Awaitable: `await asend(sock, data)` → bytes written (-1 = error).
pub fn asend(sock: long, data: string): int {
    return 0;
}
pub fn aclose(sock: long): void {
    nova_aclose(sock);
}

// ---------------------------------------------------------------------------
// AsyncStream (A1 async-first seam): a connected socket over the TRUE-async asio layer.
// Its recv/send are `async fn` — `await`-ing them PARKS the calling coroutine (registered
// with kqueue/epoll, holding NO scheduler thread) instead of blocking on a syscall. This is
// what lets a DB driver's socket I/O stop blocking the scheduler thread: the driver reads via
// `await stream.recvInto(...)`, so tens of thousands of connections share a few threads.
//
//   let s = await asyncConnect("127.0.0.1", 5432);   // parks until connected
//   let n = await s.recvInto(buf, 4096);             // parks until bytes arrive
//   await s.sendStr(frame);                          // parks until written
//   s.close();
// The non-blocking byte-stream seam a DB driver's reader is written against: `await`-ing
// recvInto/sendStr parks the coroutine. Implemented by AsyncStream (plaintext) AND TlsStream
// (encrypted, net/asynctls), so a driver picks plaintext-vs-TLS at connect time WITHOUT
// touching its read/write code — the reader just holds an `AsyncIO`.
pub trait AsyncIO {
    async fn recvInto(self, buf: int, max: int): int;
    async fn sendStr(self, data: string): int;
    fn close(self): void;
    // Bound every subsequent `recvInto` to `ms` milliseconds (an awaited per-recv deadline; a
    // hung server then surfaces a timeout, `recvInto` -> -2, instead of parking forever). `ms<=0`
    // clears it. Returns 0. This is the async-first analog of the old blocking SO_RCVTIMEO seam.
    fn setTimeout(self, ms: int): int;
}

pub struct AsyncStream impl AsyncIO {
    pub sock: long,       // NovaSocket handle (0 = not connected / closed)
    pub timeoutMs: int,   // per-recv deadline in ms (0 = block until data / EOF / error)
    init(sock: long) { self.sock = sock; self.timeoutMs = 0; }

    // Await bytes into `buf` (a raw pointer as int, capacity `max`). Returns bytes read
    // (0 = peer closed, -1 = error, -2 = deadline elapsed when a timeout is set). Parks the
    // coroutine until data arrives (or the deadline fires).
    pub async fn recvInto(self: AsyncStream, buf: int, max: int): int {
        if (self.timeoutMs > 0) { return await arecvDeadline(self.sock, buf, max, self.timeoutMs); }
        return await arecv(self.sock, buf, max);
    }
    pub fn setTimeout(self: AsyncStream, ms: int): int {
        self.timeoutMs = if (ms > 0) ms else 0;
        return 0;
    }
    // Await sending `data` (length-headed, binary-safe). Returns bytes written (-1 = error).
    pub async fn sendStr(self: AsyncStream, data: string): int {
        return await asend(self.sock, data);
    }
    pub fn isOpen(self: AsyncStream): bool { return self.sock != 0; }
    pub fn close(self: AsyncStream): void {
        if (self.sock != 0) { aclose(self.sock); self.sock = 0; }
    }
}

// Awaitable connect → an AsyncStream (sock 0 on failure). Resolves + connects without
// holding a thread.
pub async fn asyncConnect(host: string, port: int): AsyncStream {
    let s = await aconnect(host, port);
    return AsyncStream(s);
}
