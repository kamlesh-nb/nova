// net/eventloop: the completion-based EventLoop — WINDOWS (IOCP) variant, selected when
// platform.os == "windows". Unlike the kqueue/epoll variants (which EMULATE completion over readiness),
// IOCP is NATIVELY completion-based, so this is the backend the completion-shaped EventLoop trait matches
// directly: submit() issues an overlapped WSARecv/WSASend and poll() drains finished operations from the
// completion port with the byte count already filled in. The op record embeds an OVERLAPPED at offset 0,
// so a completion's lpOverlapped IS the op address.
//
// COMPILE-VERIFIED via cross-compilation (this completes the kqueue/epoll/IOCP trilogy at the Nova level).
// RUNTIME on Windows is NOT yet wired and needs, as follow-ons: (a) the C++ runtime to build for Windows
// (nova_run_reactors on Windows threads; core.cpp/io.cpp currently use POSIX fcntl/mkdir); (b) each socket
// associated with the port via CreateIoCompletionPort before I/O (see `associate`); (c) AcceptEx/ConnectEx
// for accept/connect (recv/send are done here); (d) the reactor's int `kq` cannot hold a 64-bit port
// HANDLE, so the port is kept full-width here and the int-kq model is revisited for Windows.

import bytes;
import os.socket;
import os.winsock;
import os.windows;

// Reserved completion keys, posted by the C runtime rather than produced by an I/O completion.
// These MUST match NOVA_WAKE_KEY / NOVA_TIMER_KEY in src/runtime/concurrency.cpp: a real I/O
// completion carries the key its handle was associated with (the fd, see `associate`) and a non-null
// lpOverlapped pointing at the op record, so negative sentinels cannot collide with one.
pub const WAKE_KEY: long = -1;    // cross-reactor wake (PostQueuedCompletionStatus)
pub const TIMER_KEY: long = -2;   // reactor timer fire; lpOverlapped IS the coroutine handle

// Slots in the Poller's association memo (see ensureAssociated). A power of two so the modulo is
// cheap; collisions only cost a redundant, harmless re-association.
const ASSOC_SLOTS: int = 256;

// Op kinds.
pub const OP_RECV: int = 0;
pub const OP_SEND: int = 1;
pub const OP_ACCEPT: int = 2;
pub const OP_CONNECT: int = 3;

// In-flight op record. Prefixed by an OVERLAPPED so the completion's lpOverlapped == op addr.
//   [0..32) OVERLAPPED (zeroed per submit)
//   [32] kind i32   [36] fd i32   [40] buf ptr   [48] len i32   [52] done i32   [56] token ptr
//   [64] result i64   [72] WSABUF { [72] len i32, [80] buf ptr }   [88] flags i32 (lpFlags scratch)
// Accept-only tail, because AcceptEx (unlike accept()) needs both to exist before the call:
//   [96] accepted socket i32   [100] fixed-up i32   [104..168) AcceptEx address output buffer
pub const OP_SIZE: int = 176;
const OP_ACCEPTED_OFF: int = 96;
const OP_ACCEPT_FIXED_OFF: int = 100;
const OP_ACCEPT_ADDR_OFF: int = 104;

pub fn makeOp(op: long, kind: int, fd: int, buf: long, len: int, token: long): void {
    bytes.write_ptr(op, 0, 0);  bytes.write_ptr(op, 8, 0);
    bytes.write_ptr(op, 16, 0); bytes.write_ptr(op, 24, 0);   // zero the OVERLAPPED
    bytes.write_i32(op, 32, kind as long);
    bytes.write_i32(op, 36, fd as long);
    bytes.write_ptr(op, 40, buf);
    bytes.write_i32(op, 48, len as long);
    bytes.write_i32(op, 52, 0);
    bytes.write_ptr(op, 56, token);
    bytes.write_ptr(op, 64, 0);
}
pub fn opKind(op: long): int { return bytes.read_i32(op, 32) as int; }
pub fn opFd(op: long): int { return bytes.read_i32(op, 36) as int; }
pub fn opBuf(op: long): long { return bytes.read_ptr(op, 40); }
pub fn opLen(op: long): int { return bytes.read_i32(op, 48) as int; }
pub fn opDone(op: long): int { return bytes.read_i32(op, 52) as int; }
pub fn opToken(op: long): long { return bytes.read_ptr(op, 56); }
// For most ops this is the completion's byte count. An accept op is different: the useful result is
// the socket AcceptEx was given up front, and Windows requires SO_UPDATE_ACCEPT_CONTEXT before that
// socket behaves like one returned by accept(). Both are handled here, on the first read after the
// completion — the earliest point Nova code runs on EITHER driver, since the C reactor loop resumes
// the coroutine directly and cannot call back into Nova.
pub fn opResult(op: long): int {
    if (opKind(op) == OP_ACCEPT) { return finishAccept(op); }
    return bytes.read_ptr(op, 64) as int;
}

fn finishAccept(op: long): int {
    let a = bytes.read_i32(op, OP_ACCEPTED_OFF) as int;
    if (a <= 0) { return -1; }
    if (bytes.read_i32(op, OP_ACCEPT_FIXED_OFF) != 0) { return a; }
    bytes.write_i32(op, OP_ACCEPT_FIXED_OFF, 1);

    // OVERLAPPED.Internal (offset 0) carries the NTSTATUS; anything but 0 means the accept failed,
    // in which case the pre-created socket has to be reclaimed or it leaks.
    if (bytes.read_ptr(op, 0) != (0 as long)) {
        winsock.closesocket(a as long);
        bytes.write_i32(op, OP_ACCEPTED_OFF, -1);
        return -1;
    }

    let lf = bytes.alloc(8);
    bytes.write_ptr(lf, 0, opFd(op) as long);
    winsock.setsockopt(a as long, winsock.SOL_SOCKET, winsock.SO_UPDATE_ACCEPT_CONTEXT, lf, 8);
    bytes.free(lf);
    socket.setNonBlock(a);
    return a;
}
pub fn setOpResult(op: long, r: int): void { bytes.write_ptr(op, 64, r as long); bytes.write_i32(op, 52, 1); }

// An overlapped call that could not complete inline reports SOCKET_ERROR with WSA_IO_PENDING. That
// is SUCCESS for a proactor — the completion will arrive on the port — so it maps to 0 like an
// inline completion (which is also still posted to the port).
const WSA_IO_PENDING: int = 997;

fn queued(rc: int): int {
    if (rc == 0) { return 0; }
    return if (winsock.WSAGetLastError() == WSA_IO_PENDING) 0 else -1;
}

// Zero the OVERLAPPED and issue the overlapped I/O for an op. accept/connect require AcceptEx /
// ConnectEx (follow-on). The socket must already be associated with the port — see ensureAssociated.
fn issue(op: long): int {
    bytes.write_ptr(op, 0, 0);  bytes.write_ptr(op, 8, 0);
    bytes.write_ptr(op, 16, 0); bytes.write_ptr(op, 24, 0);
    let kind = opKind(op);
    let s = opFd(op) as long;
    winsock.setWsaBuf(op + 72, opLen(op), opBuf(op));
    if (kind == OP_RECV) {
        bytes.write_i32(op, 88, 0);   // lpFlags scratch, must be non-null
        return queued(winsock.WSARecv(s, (op + 72) as ptr, 1, 0 as ptr, (op + 88) as ptr, op as ptr, 0));
    } else if (kind == OP_SEND) {
        return queued(winsock.WSASend(s, (op + 72) as ptr, 1, 0 as ptr, 0, op as ptr, 0));
    }
    if (kind == OP_ACCEPT) {
        // AcceptEx does not create the socket; it fills one you supply. Make it here and remember
        // it, because the completion reports a byte count and NOT the accepted socket the way
        // accept() returns one — opResult() hands this back instead (see finishAccept).
        let a = winsock.socket(winsock.AF_INET, winsock.SOCK_STREAM, winsock.IPPROTO_TCP);
        if (a < (0 as long)) { return -1; }
        bytes.write_i32(op, OP_ACCEPTED_OFF, a as int as long);
        bytes.write_i32(op, OP_ACCEPT_FIXED_OFF, 0);
        return queued(winsock.AcceptEx(s, a, (op + (OP_ACCEPT_ADDR_OFF as long)) as ptr, 0,
                                       winsock.ACCEPTEX_ADDRLEN, winsock.ACCEPTEX_ADDRLEN,
                                       0 as ptr, op as ptr));
    } else if (kind == OP_CONNECT) {
        // The sockaddr travels in the op's buf/len slots (see CONNECT_IS_SUBMITTED); a proactor
        // issues the connect itself rather than awaiting writability on one already started.
        return winsock.nova_wsa_connectex(s, opBuf(op) as ptr, opLen(op), op as ptr);
    }
    return -1;
}

// Associate a socket with a completion port (once, before its first overlapped I/O). Returns the port
// handle (or 0 on failure). POSIX backends provide a no-op equivalent so callers can invoke it uniformly.
pub fn associate(port: long, fd: int): long {
    return windows.CreateIoCompletionPort(fd as long, port, fd as long, 0);
}

// submit free fn (reactorio path). Unlike the Poller method this has no state to memoize in, so the
// association is re-attempted on every submit; a repeat is rejected with ERROR_INVALID_PARAMETER and
// ignored. Hoisting it to socket-registration time is the follow-on that removes the extra syscall.
pub fn submit(kq: int, op: long): int {
    let fd = opFd(op);
    if (fd >= 0) { windows.CreateIoCompletionPort(fd as long, kq as long, fd as long, 0); }
    return issue(op);
}

// Drops the zero-byte arm record. A pending overlapped op is left to complete on its own — the
// socket is about to be closed, which cancels it in the kernel; CancelIoEx would be the explicit form.
pub fn cancelRead(kq: int, fd: int): void { dropArm(fd); }

// --- backend-neutral readiness surface -----------------------------------------------------------
// On IOCP there is only ONE queue: readiness and completion are the same port, so the draining half
// of this surface (waitReady/ev*) is real and shares the completion path below. Only the ARMING half
// has no analogue — "tell me when this fd is readable" is not a thing a proactor offers; work is
// started with an overlapped op instead (see submit/issue). armRead/armWrite therefore stay no-ops,
// so the low-level readiness cases (192/194/195) still need converting to the completion API, while
// the timer (207) and cross-reactor wake (210) paths work here because both arrive as posted
// completions.
// A proactor ISSUES the connect (ConnectEx) as the submitted operation. The readiness backends
// instead start a non-blocking connect() first and then await writability, a prologue that must be
// skipped here: once connect() has been started, ConnectEx on the same socket fails.
pub fn connectIsSubmitted(): bool { return true; }

pub const EVENT_SIZE: int = 32;   // OVERLAPPED_ENTRY, so the reactor's event buffer is sized for GQCSEx

// Readiness over a proactor, via a ZERO-BYTE receive. WSARecv with an empty buffer completes exactly
// when data arrives and consumes none of it, so the completion is the readiness edge and the caller
// then performs a normal read — which is what the readiness API promises. The op record has to
// outlive the call, so one is kept per armed fd in the runtime (see nova_iocp_arm_get).
extern("c") fn nova_iocp_arm_get(fd: int): long;
extern("c") fn nova_iocp_arm_set(fd: int, op: long): void;
extern("c") fn nova_op_alloc(size: long): long;
extern("c") fn nova_op_free(op: long): void;

fn armZeroByte(kq: int, fd: int, token: long, kind: int): int {
    if (fd < 0) { return -1; }
    // The socket must be joined to the port before any overlapped op, exactly as for real I/O.
    windows.CreateIoCompletionPort(fd as long, kq as long, fd as long, 0);

    let op = nova_iocp_arm_get(fd);
    if (op == (0 as long)) {
        op = nova_op_alloc(OP_SIZE as long);
        nova_iocp_arm_set(fd, op);
    }
    makeOp(op, kind, fd, 0, 0, token);   // zero length: readiness only, no transfer
    return issue(op);
}

pub fn armRead(kq: int, fd: int, token: long): int { return armZeroByte(kq, fd, token, OP_RECV); }
pub fn armWrite(kq: int, fd: int, token: long): int { return armZeroByte(kq, fd, token, OP_SEND); }

// Release the arm record when interest is dropped, or the op leaks for the fd's lifetime.
fn dropArm(fd: int): void {
    let op = nova_iocp_arm_get(fd);
    if (op != (0 as long)) {
        nova_iocp_arm_set(fd, 0);
        nova_op_free(op);
    }
}
pub fn cancelWrite(kq: int, fd: int): void { dropArm(fd); }

// Drain up to maxEvents completions into eventBuf. Same call the Poller makes; this is the free-
// function form net/reactor's readiness path uses, which has the port and the buffer but no Poller.
pub fn waitReady(kq: int, eventBuf: long, maxEvents: int, timeoutMs: int): int {
    let removed = bytes.alloc(4);
    bytes.write_i32(removed, 0, 0);
    let ok = windows.GetQueuedCompletionStatusEx(kq as long, eventBuf as ptr, maxEvents, removed, timeoutMs, 0);
    let n = if (ok != 0) (bytes.read_i32(removed, 0) as int) else 0;
    bytes.free(removed);
    return n;
}

// The coroutine to resume for entry i. Mirrors Poller.poll's dispatch: a timer post carries the
// handle in lpOverlapped, a wake carries nothing, and an I/O completion carries the op record whose
// byte count is written back before its token is returned.
pub fn evToken(eventBuf: long, i: int): long {
    let key = windows.entryKey(eventBuf, i);
    let ov = windows.entryOverlapped(eventBuf, i);
    if (key == TIMER_KEY) { return ov; }
    if (key == WAKE_KEY) { return 0 as long; }
    if (ov == (0 as long)) { return 0 as long; }
    setOpResult(ov, windows.entryBytes(eventBuf, i));
    return opToken(ov);
}

// `associate` keys each socket by its fd, so the completion key IS the fd for real I/O.
pub fn evFd(eventBuf: long, i: int): int {
    let key = windows.entryKey(eventBuf, i);
    if (key == TIMER_KEY || key == WAKE_KEY) { return -1; }
    return key as int;
}

// A zero-byte readiness completion transfers nothing, so the count comes from the socket itself
// (kqueue reports it in the event; IOCP does not). FIONREAD is Winsock's spelling.
const FIONREAD: long = 1074030207;   // 0x4004667F
pub fn evBytes(eventBuf: long, i: int): long {
    let n = windows.entryBytes(eventBuf, i) as long;
    if (n > (0 as long)) { return n; }
    let fd = evFd(eventBuf, i);
    if (fd < 0) { return 0 as long; }
    let cnt = bytes.alloc(4);
    bytes.write_i32(cnt, 0, 0);
    let r = winsock.ioctlsocket(fd as long, FIONREAD, cnt);
    let avail = if (r == 0) (bytes.read_i32(cnt, 0) as long) else (0 as long);
    bytes.free(cnt);
    return avail;
}
// A completed zero-byte read on a stream socket is the peer's orderly shutdown, as on POSIX.
pub fn evEof(eventBuf: long, i: int): bool { return windows.entryBytes(eventBuf, i) == 0; }
pub fn evFilterAt(eventBuf: long, i: int): int { return 0; }

pub trait EventLoop {
    fn submit(self, op: long): int;
    fn poll(self, timeoutMs: int): int;
    fn completedToken(self, i: int): long;
    fn ok(self): bool;
    fn destroy(self): void;
}

// IOCP-backed native completion (Windows).
pub struct Poller impl EventLoop {
    pub port: long,          // the completion port HANDLE (full width; does not fit the reactor's int kq)
    pub kq: int,             // truncated port, for the reactor's shared `kq` field (runtime caveat above)
    pub eventBuf: long,      // maxEvents * OVERLAPPED_ENTRY_SIZE, drained by GetQueuedCompletionStatusEx
    pub compBuf: long,       // maxEvents * 8: coroutine tokens to resume
    pub removedBuf: long,    // ULONG out-param for GQCSEx
    pub assocBuf: long,      // ASSOC_SLOTS * 4: which fds are already joined to this port
    pub maxEvents: int,
    pub nComp: int,

    init(maxEvents: int) {
        winsock.startup();
        self.port = windows.CreateIoCompletionPort(windows.INVALID_HANDLE, 0, 0, 0);
        self.kq = self.port as int;
        self.maxEvents = maxEvents;
        self.eventBuf = bytes.alloc(maxEvents * windows.OVERLAPPED_ENTRY_SIZE);
        self.compBuf = bytes.alloc(maxEvents * 8);
        self.removedBuf = bytes.alloc(4);
        self.assocBuf = bytes.alloc(ASSOC_SLOTS * 4);
        let i = 0;
        while (i < ASSOC_SLOTS) { bytes.write_i32(self.assocBuf, i * 4, 0); i = i + 1; }
        self.nComp = 0;
    }

    fn ok(self: Poller): bool { return self.port != (0 as long); }

    // A socket must be joined to the completion port BEFORE its first overlapped op, or the
    // completion is delivered nowhere and the op silently never finishes. Joining is one-time and
    // permanent (a handle cannot be moved between ports), so the fds already done are memoized in a
    // direct-mapped table: a hit costs one load, a miss or a collision costs one redundant
    // CreateIoCompletionPort, which is rejected harmlessly. Bounded, unlike a growing set.
    fn ensureAssociated(self: Poller, fd: int): void {
        if (fd <= 0) { return; }
        // Windows kernel handle values are multiples of 4, so shifting first spreads the slots.
        let slot = ((fd / 4) % ASSOC_SLOTS) * 4;
        if ((bytes.read_i32(self.assocBuf, slot) as int) == fd) { return; }
        windows.CreateIoCompletionPort(fd as long, self.port, fd as long, 0);
        bytes.write_i32(self.assocBuf, slot, fd as long);
    }

    fn submit(self: Poller, op: long): int {
        self.ensureAssociated(opFd(op));
        return issue(op);
    }

    fn poll(self: Poller, timeoutMs: int): int {
        self.nComp = 0;
        bytes.write_i32(self.removedBuf, 0, 0);
        let ok = windows.GetQueuedCompletionStatusEx(self.port, self.eventBuf, self.maxEvents, self.removedBuf, timeoutMs, 0);
        if (ok != 0) {
            let n = bytes.read_i32(self.removedBuf, 0) as int;
            let i = 0;
            while (i < n) {
                let key = windows.entryKey(self.eventBuf, i);
                let ov = windows.entryOverlapped(self.eventBuf, i);
                if (key == TIMER_KEY) {
                    // A reactor timer fire posted by the runtime: lpOverlapped IS the coroutine
                    // handle, not an op record, so it is resumed directly with no result to write.
                    if (ov != (0 as long)) {
                        bytes.write_ptr(self.compBuf, (self.nComp * 8) as long, ov);
                        self.nComp = self.nComp + 1;
                    }
                } else if (key == WAKE_KEY) {
                    // Cross-reactor wake: returning from the poll is the whole point of it.
                } else if (ov != (0 as long)) {
                    setOpResult(ov, windows.entryBytes(self.eventBuf, i));
                    bytes.write_ptr(self.compBuf, (self.nComp * 8) as long, opToken(ov));
                    self.nComp = self.nComp + 1;
                }
                i = i + 1;
            }
        }
        return self.nComp;
    }

    fn completedToken(self: Poller, i: int): long {
        return bytes.read_ptr(self.compBuf, (i * 8) as long);
    }

    fn destroy(self: Poller): void {
        if (self.eventBuf != 0) { bytes.free(self.eventBuf); self.eventBuf = 0; }
        if (self.compBuf != 0) { bytes.free(self.compBuf); self.compBuf = 0; }
        if (self.removedBuf != 0) { bytes.free(self.removedBuf); self.removedBuf = 0; }
        if (self.assocBuf != 0) { bytes.free(self.assocBuf); self.assocBuf = 0; }
        if (self.port != (0 as long)) { windows.CloseHandle(self.port); self.port = 0; }
    }
}
