
import bytes;
import net.tcp.socket;

pub struct TcpClient {
    pub fn connect(host: string, port: int): socket.TcpStream {
        let fd = nova_socket_connect(host, port);
        if (fd < 0) {
            let dummy: socket.TcpStream = undefined;
            return dummy;
        }
        return socket.TcpStream(fd);
    }

    pub fn connectTimeout(host: string, port: int, timeoutMs: int): socket.TcpStream {
        let fd = nova_socket_connect_timeout(host, port, timeoutMs);
        if (fd < 0) {
            let dummy: socket.TcpStream = undefined;
            return dummy;
        }
        return socket.TcpStream(fd);
    }
}
