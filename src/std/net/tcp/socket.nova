// socket.nova — TcpStream: wraps a connected socket file descriptor
import bytes;
import mem.allocator;

pub struct TcpStream {
    pub fd: int,

    init(fd: int) {
        self.fd = fd;
    }

    pub fn write(self: TcpStream, data: string): int {
        return nova_socket_send(self.fd, data);
    }

    // Length-aware binary send. `data` is a raw bytes buffer (e.g. `bytes.alloc(n)`) and
    // `len` is exactly how many bytes to send — unlike `write`, this does NOT stop at the
    // string header's length or at an embedded NUL, so it is safe for binary wire frames
    // (BTreeDB/Postgres/… protocols). Returns bytes sent, or -1 on error.
    pub fn writeBytes(self: TcpStream, data: ptr, len: int): int {
        return nova_socket_send_n(self.fd, data, len);
    }

    pub fn read(self: TcpStream, max_len: int): string {
        let buf = bytes.alloc(max_len);
        let n = nova_socket_recv(self.fd, buf, max_len);
        if (n <= 0) {
            bytes.free(buf);
            return "";
        }
        // ARC-correct string alloc (workstream A): data at ptr, length at [ptr-4].
        let str_ptr = bytes.alloc(n);
        let i = 0;
        while (i < n) {
            bytes.write_byte(str_ptr, i, bytes.read_byte(buf, i));
            i = i + 1;
        }
        bytes.free(buf);
        return str_ptr as string;
    }

    pub fn readAll(self: TcpStream, max_len: int): string {
        let buf = bytes.alloc(max_len);
        let total = 0;
        while (total < max_len) {
            let n = nova_socket_recv(self.fd, buf + total, max_len - total);
            if (n <= 0) break;
            total = total + n;
        }
        if (total == 0) {
            bytes.free(buf);
            return "";
        }
        // ARC-correct string alloc (workstream A): data at ptr, length at [ptr-4].
        let str_ptr = bytes.alloc(total);
        let i = 0;
        while (i < total) {
            bytes.write_byte(str_ptr, i, bytes.read_byte(buf, i));
            i = i + 1;
        }
        bytes.free(buf);
        return str_ptr as string;
    }

    // D6: bound every subsequent recv/send on this socket to `timeoutMs` milliseconds. A
    // stalled `read`/`readAll` then returns "" (recv -> -1/EAGAIN) instead of blocking the
    // client forever on a hung-but-not-closed server. `timeoutMs <= 0` clears the timeout
    // (blocking forever, the previous default). Returns 0 on success, -1 on error.
    pub fn setTimeout(self: TcpStream, timeoutMs: int): int {
        return nova_socket_set_timeout(self.fd, timeoutMs);
    }

    pub fn close(self: TcpStream): void {
        if (self.fd != -1) {
            nova_close(self.fd);
            self.fd = -1;
        }
    }

    pub fn delete(self: TcpStream): void {
        self.close();
    }
}
