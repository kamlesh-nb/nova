// server.nova — TcpListener: binds to a port and accepts connections
import bytes;
import mem.allocator;
import net.tcp.socket;

pub struct TcpListener {
    pub fd: int,

    pub fn bind(port: int): TcpListener {
        let fd = nova_socket_listen(port);
        let listener = bytes.new_with_allocator<TcpListener>(allocator.globalAllocator());
        listener.fd = fd;
        return listener;
    }

    pub fn accept(self: TcpListener): socket.TcpStream {
        let client_fd = nova_socket_accept(self.fd);
        return socket.TcpStream(client_fd);
    }

    pub fn close(self: TcpListener): void {
        if (self.fd != -1) {
            nova_close(self.fd);
            self.fd = -1;
        }
    }

    pub fn delete(self: TcpListener): void {
        self.close();
    }
}
