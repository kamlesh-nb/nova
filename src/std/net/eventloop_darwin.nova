// net/eventloop: the completion-based EventLoop abstraction (step 2 of the reactor cross-platform work,
// see docs and memory nova-reactor-eventloop-iocp). This is the macOS/BSD variant, selected by the
// target-conditional file rule (platform.os == "darwin"); Linux (epoll) and Windows (IOCP) variants land
// in eventloop_linux.nova / eventloop_windows.nova behind the SAME trait.
//
// The interface is COMPLETION-shaped (a proactor): a caller SUBMITS an I/O op describing a buffer, then
// poll() reports COMPLETED ops with the byte count already filled in. On Windows this maps directly onto
// IOCP (overlapped I/O + GetQueuedCompletionStatus). On macOS/Linux the native mechanism is readiness
// (kqueue/epoll), so this backend EMULATES completion: submit() arms readiness, and poll() performs the
// recv/send/accept into the op's buffer when the fd is ready and reports it as a completion. Callers get
// one uniform model, and the reactor-native I/O layer (reactorio) is written once against it.
//
// OWNERSHIP INVARIANT: the op record and its buffer are CALLER-OWNED and MUST outlive the op (from submit
// until it appears in a poll() completion). The coroutine awaiting the op keeps both alive on its
// suspended frame; poll() only writes the result field. Nothing here allocates or frees the op/buffer.

import bytes;
import os.sys;
import os.kqueue;

// macOS/BSD errno for "would block".
pub const EAGAIN: int = 35;

// Op kinds.
pub const OP_RECV: int = 0;
pub const OP_SEND: int = 1;
pub const OP_ACCEPT: int = 2;
pub const OP_CONNECT: int = 3;

// In-flight op record, raw fixed layout (40 bytes, 8-aligned pointer fields). NOT a Nova struct: poll()
// writes `result`/`done` and the awaiting coroutine reads them back, which struct value-copy semantics
// (shallow, pointer-fields-only) would not carry. Same discipline as struct kevent / the TicketCache.
//   [0]  kind   i32
//   [4]  fd     i32
//   [8]  buf    ptr   (caller-owned payload buffer; recv target / send source)
//   [16] len    i32
//   [20] done   i32   (0 = submitted/pending, 1 = completed by poll; lets a read-deadline path tell a
//                      completion from a bare timer wake without a negative sentinel)
//   [24] token  ptr   (coroutine handle to resume; opaque to this layer)
//   [32] result i64   (bytes transferred >= 0, or -1 on error; stored 8-byte so negatives round-trip —
//                      read_i32 ZERO-extends, so a negative in an i32 slot would read back as a large
//                      positive. filled on completion)
pub const OP_SIZE: int = 40;

pub fn makeOp(op: long, kind: int, fd: int, buf: long, len: int, token: long): void {
    bytes.write_i32(op, 0, kind as long);
    bytes.write_i32(op, 4, fd as long);
    bytes.write_ptr(op, 8, buf);
    bytes.write_i32(op, 16, len as long);
    bytes.write_i32(op, 20, 0);
    bytes.write_ptr(op, 24, token);
    bytes.write_ptr(op, 32, 0);
}
pub fn opKind(op: long): int { return bytes.read_i32(op, 0) as int; }
pub fn opFd(op: long): int { return bytes.read_i32(op, 4) as int; }
pub fn opBuf(op: long): long { return bytes.read_ptr(op, 8); }
pub fn opLen(op: long): int { return bytes.read_i32(op, 16) as int; }
pub fn opDone(op: long): int { return bytes.read_i32(op, 20) as int; }
pub fn opToken(op: long): long { return bytes.read_ptr(op, 24); }
pub fn opResult(op: long): int { return bytes.read_ptr(op, 32) as int; }
// Mark the op completed with `r` bytes/status (called by poll on an I/O completion).
pub fn setOpResult(op: long, r: int): void { bytes.write_ptr(op, 32, r as long); bytes.write_i32(op, 20, 1); }

// Arm an op's readiness on a kqueue fd directly, carrying the op address as the udata token. This is the
// submit path reactorio uses: the ReactorStream holds the kq (not the Poller struct), and the struct
// only needs to own the event/completion buffers for poll(). kqueue is the shared state (the kq fd), so a
// bare-kq submit and a struct poll() on the same kq cooperate. Mirrors Poller.submit.
pub fn submit(kq: int, op: long): int {
    let kind = opKind(op);
    let fd = opFd(op);
    if (kind == OP_SEND || kind == OP_CONNECT) {
        return kqueue.registerOne(kq, fd, kqueue.EVFILT_WRITE, kqueue.EV_ADD | kqueue.EV_ONESHOT, op);
    }
    return kqueue.registerOne(kq, fd, kqueue.EVFILT_READ, kqueue.EV_ADD, op);
}

// Cancel a still-armed read interest (used when a read-deadline op times out before completing).
pub fn cancelRead(kq: int, fd: int): void {
    kqueue.registerOne(kq, fd, kqueue.EVFILT_READ, kqueue.EV_DELETE, 0);
}

// --- backend-neutral readiness surface (kept for the low-level readiness cases 192/194/195/210) --------
// The completion API above is the go-forward path; these thin wrappers let net/reactor stay free of any
// direct kqueue/epoll dependency so it compiles on every target. On kqueue they are the raw kevent ops.
pub const EVENT_SIZE: int = 32;   // sizeof(struct kevent)

pub fn armRead(kq: int, fd: int, token: long): int {
    return kqueue.registerOne(kq, fd, kqueue.EVFILT_READ, kqueue.EV_ADD, token);
}
pub fn armWrite(kq: int, fd: int, token: long): int {
    return kqueue.registerOne(kq, fd, kqueue.EVFILT_WRITE, kqueue.EV_ADD | kqueue.EV_ONESHOT, token);
}
pub fn cancelWrite(kq: int, fd: int): void {
    kqueue.registerOne(kq, fd, kqueue.EVFILT_WRITE, kqueue.EV_DELETE, 0);
}
pub fn waitReady(kq: int, eventBuf: long, maxEvents: int, timeoutMs: int): int {
    return kqueue.wait(kq, eventBuf, maxEvents, timeoutMs);
}
pub fn evFd(eventBuf: long, i: int): int { return kqueue.evIdent(eventBuf, i) as int; }
pub fn evToken(eventBuf: long, i: int): long { return kqueue.evUdata(eventBuf, i); }
pub fn evBytes(eventBuf: long, i: int): long { return kqueue.evData(eventBuf, i); }
pub fn evEof(eventBuf: long, i: int): bool { return (kqueue.evFlags(eventBuf, i) & kqueue.EV_EOF) != 0; }
pub fn evFilterAt(eventBuf: long, i: int): int { return kqueue.evFilter(eventBuf, i); }

// The completion-based event loop. Each backend (Poller / EpollLoop / IocpLoop) implements it; the
// reactor is generic over it so the trait is a compile-time seam (monomorphized, no dyn dispatch).
pub trait EventLoop {
    // Register an in-flight op (address of an OP_SIZE record). Returns 0 on success, negative on error.
    fn submit(self, op: long): int;
    // Block up to timeoutMs (negative = forever), complete ready ops (for I/O ops: perform the syscall
    // into the op buffer and fill its result), and return the number of coroutines to resume this batch.
    fn poll(self, timeoutMs: int): int;
    // The coroutine token to resume for the i-th ready item of the last poll(). For an I/O op this is the
    // op's token (the coroutine reads its own op.result); for a timer/user wake it is the woken coroutine.
    fn completedToken(self, i: int): long;
    fn ok(self): bool;
    fn destroy(self): void;
}

// kqueue-backed completion emulation (macOS/BSD).
pub struct Poller impl EventLoop {
    pub kq: int,
    pub eventBuf: long,
    pub compBuf: long,       // maxEvents * 8: coroutine tokens to resume from the last poll
    pub maxEvents: int,
    pub nComp: int,

    init(maxEvents: int) {
        self.kq = kqueue.kqueue();
        self.maxEvents = maxEvents;
        self.eventBuf = bytes.alloc(maxEvents * kqueue.KEVENT_SIZE);
        self.compBuf = bytes.alloc(maxEvents * 8);
        self.nComp = 0;
    }

    fn ok(self: Poller): bool { return self.kq >= 0; }

    // Arm readiness for the op, carrying its address as the kqueue udata token. recv/accept want
    // readability (persistent EV_ADD); send/connect want one-shot writability.
    fn submit(self: Poller, op: long): int {
        let kind = opKind(op);
        let fd = opFd(op);
        if (kind == OP_SEND || kind == OP_CONNECT) {
            return kqueue.registerOne(self.kq, fd, kqueue.EVFILT_WRITE, kqueue.EV_ADD | kqueue.EV_ONESHOT, op);
        }
        return kqueue.registerOne(self.kq, fd, kqueue.EVFILT_READ, kqueue.EV_ADD, op);
    }

    fn poll(self: Poller, timeoutMs: int): int {
        let n = kqueue.wait(self.kq, self.eventBuf, self.maxEvents, timeoutMs);
        self.nComp = 0;
        let i = 0;
        while (i < n) {
            let filter = kqueue.evFilter(self.eventBuf, i);
            let udata = kqueue.evUdata(self.eventBuf, i);
            if (filter != kqueue.EVFILT_READ && filter != kqueue.EVFILT_WRITE) {
                // Not an I/O op: a timer (read-deadline) or user (cross-reactor wake) event. udata is the
                // coroutine to resume directly; it inspects its own op/deadline on resume. No syscall.
                if (udata != (0 as long)) {
                    bytes.write_ptr(self.compBuf, (self.nComp * 8) as long, udata);
                    self.nComp = self.nComp + 1;
                }
            } else if (udata != (0 as long)) {
                let op = udata;
                let kind = opKind(op);
                let fd = opFd(op);
                let buf = opBuf(op);
                let len = opLen(op);
                let complete = true;
                let res = 0;
                if (kind == OP_RECV) {
                    let r = sys.read(fd, buf, len as long);
                    if (r < 0 && sys.errno() == EAGAIN) { complete = false; } else { res = r as int; }
                } else if (kind == OP_SEND) {
                    let w = sys.write(fd, buf, len as long);
                    if (w < 0 && sys.errno() == EAGAIN) {
                        // spurious writability: re-arm one-shot write and wait again
                        kqueue.registerOne(self.kq, fd, kqueue.EVFILT_WRITE, kqueue.EV_ADD | kqueue.EV_ONESHOT, op);
                        complete = false;
                    } else { res = w as int; }
                } else if (kind == OP_ACCEPT) {
                    let c = sys.accept(fd, 0, 0);
                    if (c < 0 && sys.errno() == EAGAIN) { complete = false; } else {
                        if (c >= 0) { sys.setNonBlocking(c); }
                        res = c;
                    }
                } else if (kind == OP_CONNECT) {
                    res = if (sys.soError(fd) == 0) 0 else -1;
                }
                if (complete) {
                    // Stop the fd refiring for a completed persistent (read) interest.
                    if (kind == OP_RECV || kind == OP_ACCEPT) {
                        kqueue.registerOne(self.kq, fd, kqueue.EVFILT_READ, kqueue.EV_DELETE, 0);
                    }
                    setOpResult(op, res);
                    bytes.write_ptr(self.compBuf, (self.nComp * 8) as long, opToken(op));
                    self.nComp = self.nComp + 1;
                }
            }
            i = i + 1;
        }
        return self.nComp;
    }

    fn completedToken(self: Poller, i: int): long {
        return bytes.read_ptr(self.compBuf, (i * 8) as long);
    }

    fn destroy(self: Poller): void {
        if (self.eventBuf != 0) { bytes.free(self.eventBuf); self.eventBuf = 0; }
        if (self.compBuf != 0) { bytes.free(self.compBuf); self.compBuf = 0; }
        if (self.kq >= 0) { sys.close(self.kq); self.kq = -1; }
    }
}
