// wolfSSL-backed async TLS stream (temporary bridge). This is the pre-M11 memory-BIO TlsStream, kept
// ONLY for the MSSQL/TDS driver, whose TLS handshake is tunneled inside TDS PRELOGIN packets and which
// needs TLS 1.2 (SQL Server). The pure-Nova stack (net/asynctls over crypto/tls/13) is 1.3-only today;
// once the TLS 1.2 client memory-BIO lands (M13) the TDS path moves onto it and this module + the
// nova_mtls_* runtime surface + deps/wolfssl are deleted. Do not use this for new code.
import bytes;
import net.asyncio;

fn bufToStr(buf: ptr, n: int): string {
    if (n <= 0) { return ""; }
    let out = bytes.alloc(n);
    let i = 0;
    while (i < n) { bytes.write_byte(out, i, bytes.read_byte(buf, i)); i = i + 1; }
    return out as string;
}

pub struct WolfTlsStream impl AsyncIO {
    pub base: asyncio.AsyncStream,
    pub ctx: ptr,
    pub scratch: ptr,
    pub cap: int,
    pub open: bool,
    pub handshakeOk: bool,

    init(base: asyncio.AsyncStream, ctx: ptr) {
        self.base = base;
        self.ctx = ctx;
        self.cap = 16384;
        self.scratch = bytes.alloc(16384);
        self.open = true;
        self.handshakeOk = false;
    }

    pub async fn flushOut(self: WolfTlsStream): int {
        while (nova_mtls_pending_out(self.ctx) > 0) {
            let n = nova_mtls_pull(self.ctx, self.scratch, self.cap);
            if (n <= 0) { break; }
            let w = await self.base.sendStr(bufToStr(self.scratch, n));
            if (w < 0) { return 0 - 1; }
        }
        return 0;
    }

    pub async fn pumpIn(self: WolfTlsStream): int {
        let n = await self.base.recvInto(self.scratch as long, self.cap);
        if (n <= 0) { nova_mtls_mark_closed(self.ctx); return n; }
        nova_mtls_feed(self.ctx, self.scratch, n);
        return n;
    }

    pub async fn handshake(self: WolfTlsStream): int {
        while (true) {
            let st = nova_mtls_handshake(self.ctx);
            if (await self.flushOut() < 0) { return 0 - 1; }
            if (st == 0) { self.handshakeOk = true; return 0; }
            if (st < 0) { return 0 - 1; }
            let g = await self.pumpIn();
            if (g <= 0) { return 0 - 1; }
        }
        return 0 - 1;
    }

    pub async fn sendStr(self: WolfTlsStream, data: string): int {
        let w = nova_mtls_write(self.ctx, data as ptr, data.length);
        if (w < 0) { return 0 - 1; }
        if (await self.flushOut() < 0) { return 0 - 1; }
        return w;
    }

    pub async fn recvInto(self: WolfTlsStream, buf: long, max: int): int {
        while (true) {
            let n = nova_mtls_read(self.ctx, buf, max);
            if (n > 0) { return n; }
            if (n < 0) { return 0 - 1; }
            if (await self.flushOut() < 0) { return 0 - 1; }
            let g = await self.pumpIn();
            if (g <= 0) { return g; }
        }
        return 0 - 1;
    }

    pub fn ok(self: WolfTlsStream): bool { return self.handshakeOk; }
    pub fn isOpen(self: WolfTlsStream): bool { return self.open; }

    pub fn setTimeout(self: WolfTlsStream, ms: int): int {
        return self.base.setTimeout(ms);
    }

    pub fn close(self: WolfTlsStream): void {
        if (self.open) {
            nova_mtls_free(self.ctx);
            self.base.close();
            self.open = false;
        }
    }
}
