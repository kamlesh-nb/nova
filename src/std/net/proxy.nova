// proxy.nova — L7 HTTP reverse proxy + round-robin backend pool (I1, first slice).
//
// Accepts HTTP on a front port, frames each request (headers + Content-Length / chunked / no-body),
// picks a backend round-robin, forwards the request, frames the backend's response, and streams it
// back. Built entirely on the non-blocking async seam (aaccept / async_read_deadline / asyncConnect),
// so each connection is a cheap coroutine on the io_context — no thread per connection.
//
// This is the SPINE the rest of I1 hangs off: health checks, least-conn/weighted LB, and the PID
// autoscaler (which spawns/kills backends via R1) layer on top of the same Pool + handler.
import net.asyncio;
import string;
import list;
import bytes;

// ---------------------------------------------------------------------------
// Backend pool + load-balancing selection (round-robin / weighted / least-conn / consistent-hash)
// ---------------------------------------------------------------------------

// I1 load-balancing strategies. All lock-free under share-nothing: RoundRobin/Weighted advance a
// PER-REACTOR cursor, LeastConn reads PER-REACTOR in-flight counts, ConsistentHash is pure.
pub enum LbStrategy {
    RoundRobin,
    Weighted,
    LeastConn,
    ConsistentHash,
}

// Non-negative 31-bit hash of a string (string.hash may be negative; mask the sign bit).
fn hashKey(s: string): int {
    return string.hash(s) & 2147483647;
}

// Extract the request PATH from a raw HTTP message ("METHOD PATH HTTP/1.1..."). Used as the
// ConsistentHash key so the same URL routes to the same backend (cache affinity). "/" on any oddity.
fn reqKey(raw: string): string {
    let sp1 = string.indexOf(raw, " ");
    if (sp1 < 0) { return "/"; }
    let rest = string.slice(raw, sp1 + 1, string.len(raw));
    let sp2 = string.indexOf(rest, " ");
    if (sp2 < 0) { return "/"; }
    return string.slice(rest, 0, sp2);
}

pub struct Backend {
    pub host: string,
    pub port: int,
    // HAProxy-style keep-alive reuse, LOCK-FREE via PER-REACTOR idle pools (`idle_conn_srv[tid]`): after a
    // response completes, the backend socket is returned to the CURRENT reactor's list instead of closed,
    // and the next request on that reactor reuses it — no TCP handshake, no DNS resolve, no ephemeral-port
    // churn. `idle.get(tid)` is touched only by reactor `tid` (one coroutine per reactor at a time, and the
    // pop/push has no `await`), so NO lock is needed. Under SHARE-NOTHING (Path A) a coroutine and the
    // socket it owns live entirely on ONE reactor and never migrate, and this pool is keyed by that
    // reactor — so a backend socket is created, used, pooled, and reused ALL on the same single-threaded
    // reactor. That is what makes cross-request reuse SAFE at any reactor count (see below).
    pub idle: List<List<long>>,
    pub weight: int,           // Weighted LB (default 1)
    pub active: List<int>,     // PER-REACTOR in-flight request count (LeastConn), lock-free like `idle`
    pub reuse: bool,
    init(host: string, port: int) {
        self.host = host;
        self.port = port;
        self.weight = 1;
        // P5: reuse is now safe UNCONDITIONALLY. It was gated to a single worker because the old
        // work-stealing model let a coroutine migrate threads, so a pooled socket could be touched from
        // two io_context threads (per-coroutine strands papered over the async ops but reuse across
        // coroutines raced). Share-nothing removes migration: each reactor is single-threaded and the pool
        // is per-reactor, so the pooled socket is only ever touched by its own reactor's one thread.
        self.reuse = true;
        self.idle = List<List<long>>();
        self.active = List<int>();
        let nt = nova_worker_count() as int;
        let i = 0;
        while (i < nt) { self.idle.push(List<long>()); self.active.push(0); i = i + 1; }
    }
    // Per-reactor in-flight counters for LeastConn — touched only by the owning reactor (one coroutine
    // per reactor at a time, no await between read+write), so lock-free like the idle pool.
    pub fn acquireConn(self: Backend): void {
        let t = nova_thread_id() as int;
        self.active.set(t, (self.active.get(t) ?? 0) + 1);
    }
    pub fn releaseConn(self: Backend): void {
        let t = nova_thread_id() as int;
        let v = (self.active.get(t) ?? 0) - 1;
        self.active.set(t, if (v < 0) 0 else v);
    }
    pub fn activeConns(self: Backend): int {
        let t = nova_thread_id() as int;
        return self.active.get(t) ?? 0;
    }
}

// One framed HTTP message + the two facts the pool needs: was it CLEANLY framed (Content-Length or
// chunked → the connection is at a message boundary and reusable) and did it ask to CLOSE.
pub struct HttpMsg {
    pub bytes: string,
    pub framed: bool,     // false = terminated by connection close (read-to-EOF) → not reusable
    pub wantClose: bool,  // a `Connection: close` header is present
    init(bytes: string, framed: bool, wantClose: bool) {
        self.bytes = bytes;
        self.framed = framed;
        self.wantClose = wantClose;
    }
}

pub struct Pool {
    pub backends: List<Backend>,
    pub cursors: List<int>,   // PER-REACTOR round-robin cursor — each reactor's is touched only by itself
    pub strategy: LbStrategy,
    pub wexpanded: List<int>, // Weighted: backend indices repeated by weight (rebuilt on add)
    pub ringHash: List<int>,  // ConsistentHash ring: parallel (hash, backendIdx), UNSORTED (scanned)
    pub ringIdx: List<int>,
    init() {
        self.backends = List<Backend>();
        self.cursors = List<int>();
        self.strategy = LbStrategy.RoundRobin;
        self.wexpanded = List<int>();
        self.ringHash = List<int>();
        self.ringIdx = List<int>();
        let nt = nova_worker_count() as int;
        let i = 0;
        while (i < nt) { self.cursors.push(0); i = i + 1; }
    }

    pub fn setStrategy(self: Pool, s: LbStrategy): void { self.strategy = s; }

    pub fn add(self: Pool, host: string, port: int): void { self.addWeighted(host, port, 1); }

    // Add a backend with a weight (>=1). Rebuilds the Weighted expansion (idx repeated `weight` times) and
    // adds 40 ConsistentHash virtual nodes for even ring spread.
    pub fn addWeighted(self: Pool, host: string, port: int, weight: int): void {
        let b = Backend(host, port);
        b.weight = if (weight > 0) weight else 1;
        let idx = self.backends.size();
        self.backends.push(b);
        let w = 0;
        while (w < b.weight) { self.wexpanded.push(idx); w = w + 1; }
        let v = 0;
        while (v < 40) {
            self.ringHash.push(hashKey(host + ":" + port + "#" + v));
            self.ringIdx.push(idx);
            v = v + 1;
        }
    }

    pub fn size(self: Pool): int { return self.backends.size(); }

    // Select a backend by the active strategy. `key` is used ONLY by ConsistentHash (a stable per-request
    // string — the request path); the others ignore it. Returns a Backend with port 0 when empty (caller
    // answers 502). Lock-free: RR/Weighted advance a PER-REACTOR cursor; LeastConn reads PER-REACTOR active
    // counts; ConsistentHash is pure.
    pub fn select(self: Pool, key: string): Backend {
        let n = self.backends.size();
        if (n == 0) { return Backend("", 0); }
        let t = nova_thread_id() as int;

        switch (self.strategy) {
            case LbStrategy.RoundRobin: {
                // each reactor advances its OWN cursor — even split, no shared counter.
                let c = self.cursors.get(t) ?? 0;
                self.cursors.set(t, c + 1);
                return self.backends.get(c % n) ?? Backend("", 0);
            }
            case LbStrategy.Weighted: {
                let m = self.wexpanded.size();
                let c = self.cursors.get(t) ?? 0;
                self.cursors.set(t, c + 1);
                let idx = if (m == 0) (c % n) else (self.wexpanded.get(c % m) ?? 0);
                return self.backends.get(idx) ?? Backend("", 0);
            }
            case LbStrategy.LeastConn: {
                // Fewest in-flight on THIS reactor; ties → lowest index. Per-reactor least-conn (each
                // reactor balances its own subset) is the correct share-nothing semantics.
                let best = 0;
                let bestA = (self.backends.get(0) ?? Backend("", 0)).activeConns();
                let i = 1;
                while (i < n) {
                    let a = (self.backends.get(i) ?? Backend("", 0)).activeConns();
                    if (a < bestA) { bestA = a; best = i; }
                    i = i + 1;
                }
                return self.backends.get(best) ?? Backend("", 0);
            }
            case LbStrategy.ConsistentHash: {
                // hash(key) → first ring node with hash >= h (wrapping to the global-min node). Stable
                // under add/remove (only ~1/N keys remap). Ring is small, so a linear scan is fine.
                let h = hashKey(key);
                let ring = self.ringHash.size();
                let bestGE = -1; let bestGEH = 0;
                let gmin = -1; let gminH = 0;
                let i = 0;
                while (i < ring) {
                    let rh = self.ringHash.get(i) ?? 0;
                    if (gmin == -1 || rh < gminH) { gmin = i; gminH = rh; }
                    if (rh >= h && (bestGE == -1 || rh < bestGEH)) { bestGE = i; bestGEH = rh; }
                    i = i + 1;
                }
                let pick = if (bestGE != -1) bestGE else gmin;
                let idx = if (pick != -1) (self.ringIdx.get(pick) ?? 0) else 0;
                return self.backends.get(idx) ?? Backend("", 0);
            }
        }
        return self.backends.get(0) ?? Backend("", 0);   // unreachable (switch is exhaustive)
    }

    // Back-compat: round-robin under the default strategy (proxies that never set a strategy).
    pub fn next(self: Pool): Backend { return self.select(""); }
}

// ---------------------------------------------------------------------------
// HTTP message framing — buffers are `long` addresses (int would truncate `buf + off` to 32 bits)
// ---------------------------------------------------------------------------

// Index of the CRLFCRLF that ends the header block, or -1 if not yet present.
fn findHeaderEnd(buf: long, len: int): int {
    let i = 0;
    while (i + 4 <= len) {
        if (bytes.read_byte(buf, i) == 13 && bytes.read_byte(buf, i + 1) == 10
            && bytes.read_byte(buf, i + 2) == 13 && bytes.read_byte(buf, i + 3) == 10) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// Case-insensitive search for `needle` (already lowercase) within [0, limit). Returns its index or -1.
fn findCI(buf: long, limit: int, needle: string): int {
    let nlen = needle.length;
    if (nlen == 0) { return -1; }
    let i = 0;
    while (i + nlen <= limit) {
        let j = 0;
        let matched = true;
        while (j < nlen) {
            let c = bytes.read_byte(buf, i + j);
            if (c >= 65 && c <= 90) { c = c + 32; } // ASCII lower-case
            if (c != needle[j]) { matched = false; break; }
            j = j + 1;
        }
        if (matched) { return i; }
        i = i + 1;
    }
    return -1;
}

// Content-Length value within the header block, or -1 if the header is absent.
fn contentLength(buf: long, hdrEnd: int): int {
    let idx = findCI(buf, hdrEnd, "content-length:");
    if (idx == -1) { return -1; }
    let p = idx + 15; // length of "content-length:"
    while (p < hdrEnd && bytes.read_byte(buf, p) == 32) { p = p + 1; }
    let val = 0;
    let any = false;
    while (p < hdrEnd) {
        let c = bytes.read_byte(buf, p);
        if (c < 48 || c > 57) { break; }
        val = val * 10 + (c - 48);
        any = true;
        p = p + 1;
    }
    if (!any) { return -1; }
    return val;
}

fn isChunked(buf: long, hdrEnd: int): bool {
    if (findCI(buf, hdrEnd, "transfer-encoding:") == -1) { return false; }
    return findCI(buf, hdrEnd, "chunked") != -1;
}

fn findCRLF(buf: long, from: int, len: int): int {
    let p = from;
    while (p + 1 < len) {
        if (bytes.read_byte(buf, p) == 13 && bytes.read_byte(buf, p + 1) == 10) { return p; }
        p = p + 1;
    }
    return -1;
}

fn parseHex(buf: long, from: int, to: int): int {
    let p = from;
    let v = 0;
    while (p < to) {
        let c = bytes.read_byte(buf, p);
        let d = -1;
        if (c >= 48 && c <= 57) { d = c - 48; }
        else if (c >= 97 && c <= 102) { d = c - 87; }
        else if (c >= 65 && c <= 70) { d = c - 55; }
        else { break; }
        v = v * 16 + d;
        p = p + 1;
    }
    return v;
}

// Index just past the final chunk terminator (`0\r\n\r\n`), or -1 if the chunked body is incomplete.
fn chunkedEnd(buf: long, start: int, len: int): int {
    let p = start;
    while (p < len) {
        let lineEnd = findCRLF(buf, p, len);
        if (lineEnd == -1) { return -1; }
        let size = parseHex(buf, p, lineEnd);
        let dataStart = lineEnd + 2;
        if (size == 0) {
            if (dataStart + 2 <= len) { return dataStart + 2; } // trailing CRLF present
            return -1;
        }
        p = dataStart + size + 2; // chunk data + CRLF
    }
    return -1;
}

// Read one full HTTP message from `sock` into a fresh buffer and return its exact bytes as a string
// ("" on error / EOF before the headers complete). `isResponse` picks the no-length fallback: a
// response with neither Content-Length nor chunked framing ends at connection close (read to EOF);
// a request without a body ends at the header block.
async fn readMessage(sock: long, isResponse: bool, tmo: int): HttpMsg {
    let cap = 65536;
    let buf: long = bytes.alloc(cap);
    let len = 0;

    let hdrEnd = findHeaderEnd(buf, len);
    while (hdrEnd == -1) {
        if (len >= cap) { bytes.free(buf); return HttpMsg("", false, true); }
        let n = await asyncio.async_read_deadline(sock, buf + len, cap - len, tmo);
        if (n <= 0) { bytes.free(buf); return HttpMsg("", false, true); }
        len = len + n;
        hdrEnd = findHeaderEnd(buf, len);
    }

    let wantClose = findCI(buf, hdrEnd, "connection: close") != -1;
    let bodyStart = hdrEnd + 4;
    let msgEnd = bodyStart;
    let framed = true;

    if (isChunked(buf, hdrEnd)) {
        let cend = chunkedEnd(buf, bodyStart, len);
        while (cend == -1) {
            if (len >= cap) { framed = false; break; }
            let n = await asyncio.async_read_deadline(sock, buf + len, cap - len, tmo);
            if (n <= 0) { framed = false; break; }
            len = len + n;
            cend = chunkedEnd(buf, bodyStart, len);
        }
        msgEnd = if (cend == -1) len else cend;
    } else {
        let need = contentLength(buf, hdrEnd);
        if (need >= 0) {
            while (len - bodyStart < need) {
                if (len >= cap) { framed = false; break; }
                let n = await asyncio.async_read_deadline(sock, buf + len, cap - len, tmo);
                if (n <= 0) { framed = false; break; }
                len = len + n;
            }
            msgEnd = bodyStart + need;
            if (msgEnd > len) { msgEnd = len; }
        } else if (isResponse) {
            // No Content-Length, not chunked → the response body runs until the backend closes the
            // connection. Read to EOF; the connection is consumed, so it is NOT reusable.
            framed = false;
            while (len < cap) {
                let n = await asyncio.async_read_deadline(sock, buf + len, cap - len, tmo);
                if (n <= 0) { break; }
                len = len + n;
            }
            msgEnd = len;
        } else {
            msgEnd = bodyStart; // request with no body
        }
    }

    let msg = bytes.read_string(buf, msgEnd);
    bytes.free(buf);
    return HttpMsg(msg, framed, wantClose);
}

// ---------------------------------------------------------------------------
// Backend connection pool — acquire (reuse-or-dial) / release (keep-or-close)
// ---------------------------------------------------------------------------

// Take a connection to `b`: reuse a warm idle one if available, else dial fresh. The dial happens
// OUTSIDE the lock (asyncConnect parks the coroutine). Returns a socket handle, or 0 on connect failure.
async fn acquire(b: Backend): (long, bool) {
    // Pop from THIS worker's idle list only (no lock — see Backend.idle). The pop completes before any
    // await, so the coroutine can't migrate mid-critical-section.
    let t = nova_thread_id() as int;
    let lst = b.idle.get(t) ?? List<long>();
    let sock: long = 0;
    let n = lst.size();
    if (n > 0) {
        sock = lst.get(n - 1) ?? 0;
        lst.remove(n - 1);
    }
    if (sock != 0) { return (sock, true); }   // warm reuse — no handshake, no resolve
    let s = await asyncio.asyncConnect(b.host, b.port);
    return (s.sock, false);                    // 0 on failure
}

// Return a connection to the CURRENT worker's idle list when the exchange left it at a clean message
// boundary (reusable), else close it. Bounded per worker so a burst can't grow a list without limit.
// Lock-free: sync (no await), so it runs entirely on one worker touching only that worker's list.
//
// REUSE IS GATED TO A SINGLE WORKER (nova_worker_count() == 1). This runtime binds each socket's async
// I/O to a PER-COROUTINE strand (CoroState.strand), so a pooled socket moving between coroutines/threads
// races under multi-threading (measured: reuse at NOVA_THREADS=8 corrupts; at =1 it is clean). So with
// >1 worker we fall back to connect-per-request (correct); pooling engages single-threaded, where there
// is no strand concurrency. Scale a pooled proxy as N single-threaded workers behind SO_REUSEPORT (the
// nginx model) — or lift this once the runtime can detach/reattach a socket from its coroutine.
fn release(b: Backend, sock: long, reusable: bool): void {
    if (sock == 0) { return; }
    if (!reusable || !b.reuse) { asyncio.aclose(sock); return; }
    let t = nova_thread_id() as int;
    let lst = b.idle.get(t) ?? List<long>();
    if (lst.size() < 256) { lst.push(sock); }
    else { asyncio.aclose(sock); }
}

// ---------------------------------------------------------------------------
// Proxy
// ---------------------------------------------------------------------------

fn errorResponse(code: int, reason: string, body: string): string {
    return `HTTP/1.1 ${code} ${reason}\r\nContent-Length: ${body.length}\r\nConnection: close\r\n\r\n${body}`;
}

// Forward ONE request to backend `b` over a pooled connection, returning the response. Reuses a warm
// idle connection when possible; if a reused connection turns out dead (the backend closed it while
// idle → empty read on first use), retries ONCE on a fresh dial (HAProxy "safe" reuse). Returns "" if
// the backend is unreachable / gives nothing even fresh.
async fn forward(b: Backend, reqBytes: string, reqWantClose: bool, tmo: int): string {
    let (bsock, reused) = await acquire(b);
    if (bsock == 0) { return ""; }

    let _ = await asyncio.async_write(bsock, reqBytes);
    let resp = await readMessage(bsock, true, tmo);

    if (string.eql(resp.bytes, "") && reused) {
        asyncio.aclose(bsock);
        let fresh = await asyncio.asyncConnect(b.host, b.port);
        bsock = fresh.sock;
        if (bsock == 0) { return ""; }
        let _ = await asyncio.async_write(bsock, reqBytes);
        resp = await readMessage(bsock, true, tmo);
    }

    if (string.eql(resp.bytes, "")) {
        release(b, bsock, false);
        return "";
    }
    // Reusable only when BOTH sides stayed keep-alive AND the reply was cleanly framed (at a boundary).
    let reusable = resp.framed && !resp.wantClose && !reqWantClose;
    release(b, bsock, reusable);
    return resp.bytes;
}

// Serve one client connection, keep-alive: read requests until the peer closes or sends
// `Connection: close`. Each request is load-balanced independently (round-robin) and forwarded over a
// pooled backend connection. Runs as its own coroutine (spawned), so a slow exchange never stalls the
// accept loop or the other clients.
async fn handleClient(pool: Pool, clientSock: long, tmo: int): int {
    let alive = true;
    while (alive) {
        let req = await readMessage(clientSock, false, tmo);
        if (string.eql(req.bytes, "")) { alive = false; break; }  // client closed / error

        let b = pool.select(reqKey(req.bytes));   // key used only by ConsistentHash; others ignore it
        if (b.port == 0) {
            let _ = await asyncio.async_write(clientSock, errorResponse(502, "Bad Gateway", "no backends"));
            alive = false;
            break;
        }

        b.acquireConn();                          // LeastConn in-flight accounting (per-reactor, lock-free)
        let resp = await forward(b, req.bytes, req.wantClose, tmo);
        b.releaseConn();
        if (string.eql(resp, "")) {
            let _ = await asyncio.async_write(clientSock, errorResponse(502, "Bad Gateway", "upstream error"));
            alive = false;
            break;
        }
        let _ = await asyncio.async_write(clientSock, resp);
        if (req.wantClose) { alive = false; }
    }
    asyncio.aclose(clientSock);
    return 0;
}

// One reactor's front-end accept loop: bind a SO_REUSEPORT acceptor on THIS reactor, then accept +
// spawn a handler per client. Handlers stay on the accepting reactor, so their backend connections are
// acquired/pooled/reused on the same reactor's per-reactor idle list (safe, lock-free).
async fn proxyAcceptLoop(pool: Pool, port: int, tmo: int): int {
    let srv = asyncio.serverListen(port);
    if (srv == 0) {
        console.log("proxy: failed to bind front port (in use?)");
        return -1;
    }
    while (true) {
        let client = await asyncio.aaccept(srv);
        spawn handleClient(pool, client, tmo);
    }
    return 0;
}

// P5 share-nothing fan-out: one accept loop per reactor (SO_REUSEPORT; the kernel load-balances clients
// across reactors on Linux). Mirrors App.run — reactors 1..N-1 spawned + pinned, reactor 0 inline.
async fn runProxy(pool: Pool, port: int, tmo: int): int {
    let n = asyncio.reactorCount();
    let i = 1;
    while (i < n) {
        asyncio.pinNextCoro(i);
        spawn proxyAcceptLoop(pool, port, tmo);
        i = i + 1;
    }
    console.log("Nova reverse proxy listening (share-nothing)");
    return await proxyAcceptLoop(pool, port, tmo);
}

pub struct Proxy {
    pub pool: Pool,
    pub port: int,
    pub timeoutMs: int,
    init(pool: Pool, port: int) { self.pool = pool; self.port = port; self.timeoutMs = 15000; }

    // Per-upstream I/O deadline (ms); a hung backend then fails the request instead of parking forever.
    pub fn setTimeout(self: Proxy, ms: int): void { self.timeoutMs = if (ms > 0) ms else 0; }

    // Bind the front port and serve forever. holdReactors keeps all reactors alive BEFORE the block-drive
    // so the per-reactor accept fan-out lands on live reactors (share-nothing, like App.run).
    pub fn run(self: Proxy): void {
        asyncio.holdReactors();
        let _ = runProxy(self.pool, self.port, self.timeoutMs);
    }
}
