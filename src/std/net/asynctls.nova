// Async TLS 1.3 stream in pure Nova (M11 stage C): a TlsStream wraps an AsyncStream and pumps the
// pure-Nova TLS 1.3 memory-BIO (net/tlsmembio) over it, implementing the AsyncIO trait so callers (the
// web server, the HTTP client, the DB drivers) speak TLS without knowing the transport. No wolfSSL.
//
// The handshake cryptographically authenticates the peer. Chain-to-trusted-root validation (dates,
// hostname, a CA store) is a separate policy layer (crypto/tls/13/tlsClient.verifyServerChain); the
// `verify` flag is accepted for source compatibility but that policy layer is applied by the caller.
import bytes;
import net.aio;
import net.tlsmembio;
import crypto.tls.truststore;

fn bufToStr(buf: ptr, n: int): string {
    if (n <= 0) { return ""; }
    let out = bytes.alloc(n);
    let i = 0;
    while (i < n) { bytes.write_byte(out, i, bytes.read_byte(buf, i)); i = i + 1; }
    return out as string;
}

pub struct TlsStream impl AsyncIO {
    pub base: aio.AsyncStream,
    pub bio: tlsmembio.TlsBio,
    pub scratch: ptr,
    pub cap: int,
    pub open: bool,
    pub handshakeOk: bool,

    init(base: aio.AsyncStream, bio: tlsmembio.TlsBio) {
        self.base = base;
        self.bio = bio;
        self.cap = 16384;
        self.scratch = bytes.alloc(16384);
        self.open = true;
        self.handshakeOk = false;
    }

    // Flush all pending outbound ciphertext to the socket.
    pub async fn flushOut(self: TlsStream): int {
        while (self.bio.pendingOut() > 0) {
            let n = self.bio.pull(self.scratch, self.cap);
            if (n <= 0) { break; }
            let w = await self.base.sendStr(bufToStr(self.scratch, n));
            if (w < 0) { return 0 - 1; }
        }
        return 0;
    }

    // Pull inbound ciphertext from the socket into the BIO. Returns bytes read (<=0 on EOF/error).
    pub async fn pumpIn(self: TlsStream): int {
        let n = await self.base.recvInto(self.scratch as long, self.cap);
        if (n <= 0) { self.bio.markClosed(); return n; }
        self.bio.feed(self.scratch, n);
        return n;
    }

    pub async fn handshake(self: TlsStream): int {
        while (true) {
            let st = self.bio.step();
            if (await self.flushOut() < 0) { return 0 - 1; }
            if (st == 0) { self.handshakeOk = true; return 0; }
            if (st < 0) { return 0 - 1; }
            let g = await self.pumpIn();
            if (g <= 0) { return 0 - 1; }
        }
        return 0 - 1;
    }

    pub async fn sendStr(self: TlsStream, data: string): int {
        let w = self.bio.writeApp(data as ptr, data.length);
        if (w < 0) { return 0 - 1; }
        if (await self.flushOut() < 0) { return 0 - 1; }
        return w;
    }

    pub async fn recvInto(self: TlsStream, buf: long, max: int): int {
        while (true) {
            let n = self.bio.readApp(buf as ptr, max);
            if (n > 0) { return n; }
            if (n < 0) { return 0 - 1; }
            if (await self.flushOut() < 0) { return 0 - 1; }
            let g = await self.pumpIn();
            if (g <= 0) { return g; }
        }
        return 0 - 1;
    }

    pub fn ok(self: TlsStream): bool { return self.handshakeOk; }
    pub fn isOpen(self: TlsStream): bool { return self.open; }
    // The ALPN protocol negotiated during the handshake ("" if none).
    pub fn selectedAlpn(self: TlsStream): string { return self.bio.selectedAlpn(); }

    pub fn setTimeout(self: TlsStream, ms: int): int {
        return self.base.setTimeout(ms);
    }

    pub fn close(self: TlsStream): void {
        if (self.open) {
            self.bio.closeBio();
            self.base.close();
            self.open = false;
        }
    }
}

pub async fn tlsConnect(host: string, port: int, verify: bool): TlsStream {
    let base = await aio.asyncConnect(host, port);
    let bio: tlsmembio.TlsBio = tlsmembio.newClientBio(host);
    let ts = TlsStream(base, bio);
    let hs = await ts.handshake();
    return ts;
}

// Connect and offer ALPN (comma-separated protocol list, e.g. "h2,http/1.1"); selectedAlpn() reports the
// server's choice after the handshake.
pub async fn tlsConnectAlpn(host: string, port: int, alpn: string): TlsStream {
    let base = await aio.asyncConnect(host, port);
    let bio: tlsmembio.TlsBio = tlsmembio.newClientBioAlpn(host, alpn);
    let ts = TlsStream(base, bio);
    let hs = await ts.handshake();
    return ts;
}

// Connect and enforce CA trust: the server chain must validate against `caPem` (a PEM bundle) for `host`,
// or the handshake fails (ok() is false). Returns the stream; the caller checks ok().
pub async fn tlsConnectVerify(host: string, port: int, caPem: string): TlsStream {
    let base = await aio.asyncConnect(host, port);
    let store = truststore.loadPemBundle(caPem);
    let bio: tlsmembio.TlsBio = tlsmembio.newClientBioVerify(host, store);
    let ts = TlsStream(base, bio);
    let hs = await ts.handshake();
    return ts;
}

// Client-side STARTTLS: upgrade an ALREADY-OPEN socket to TLS in place. The caller has done the
// plaintext protocol negotiation that precedes encryption (e.g. Postgres SSLRequest, MySQL SSLRequest
// packet) on `base`, then hands it here for the TLS 1.3 client handshake. This is the client analog of
// tlsAccept; it does NOT open a new socket (unlike tlsConnect). The handshake authenticates the peer;
// chain-to-CA trust is only enforced by the *Verify variant.
pub async fn tlsClientUpgrade(base: aio.AsyncStream, host: string): TlsStream {
    let bio: tlsmembio.TlsBio = tlsmembio.newClientBio(host);
    let ts = TlsStream(base, bio);
    let hs = await ts.handshake();
    return ts;
}

// STARTTLS with CA trust enforced: the server chain must validate against `caPem` for `host`, else
// ts.ok() is false (the caller must check it and refuse to proceed).
pub async fn tlsClientUpgradeVerify(base: aio.AsyncStream, host: string, caPem: string): TlsStream {
    let store = truststore.loadPemBundle(caPem);
    let bio: tlsmembio.TlsBio = tlsmembio.newClientBioVerify(host, store);
    let ts = TlsStream(base, bio);
    let hs = await ts.handshake();
    return ts;
}

pub async fn tlsAccept(base: aio.AsyncStream, cert: string, key: string): TlsStream {
    let bio: tlsmembio.TlsBio = tlsmembio.newServerBioPem(cert, key);
    let ts = TlsStream(base, bio);
    let hs = await ts.handshake();
    return ts;
}

// Accept and offer ALPN (comma-separated preference list); the server echoes the first protocol the
// client also offered, reported by selectedAlpn().
pub async fn tlsAcceptAlpn(base: aio.AsyncStream, cert: string, key: string, alpn: string): TlsStream {
    let sb = tlsmembio.newServerBioPem(cert, key);
    sb.offerAlpn(alpn);
    let bio: tlsmembio.TlsBio = sb;
    let ts = TlsStream(base, bio);
    let hs = await ts.handshake();
    return ts;
}
