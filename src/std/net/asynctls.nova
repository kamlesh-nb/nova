// Async TLS 1.3 stream in pure Nova (M11 stage C): a TlsStream wraps an AsyncStream and pumps the
// pure-Nova TLS 1.3 memory-BIO (net/tlsmembio) over it, implementing the AsyncIO trait so callers (the
// web server, the HTTP client, the DB drivers) speak TLS without knowing the transport. No wolfSSL.
//
// The handshake cryptographically authenticates the peer. Chain-to-trusted-root validation (dates,
// hostname, a CA store) is a separate policy layer (crypto/tls/13/tlsClient.verifyServerChain); the
// `verify` flag is accepted for source compatibility but that policy layer is applied by the caller.
import bytes;
import net.asyncio;
import net.tlsmembio;

fn bufToStr(buf: ptr, n: int): string {
    if (n <= 0) { return ""; }
    let out = bytes.alloc(n);
    let i = 0;
    while (i < n) { bytes.write_byte(out, i, bytes.read_byte(buf, i)); i = i + 1; }
    return out as string;
}

pub struct TlsStream impl AsyncIO {
    pub base: asyncio.AsyncStream,
    pub bio: tlsmembio.TlsBio,
    pub scratch: ptr,
    pub cap: int,
    pub open: bool,
    pub handshakeOk: bool,

    init(base: asyncio.AsyncStream, bio: tlsmembio.TlsBio) {
        self.base = base;
        self.bio = bio;
        self.cap = 16384;
        self.scratch = bytes.alloc(16384);
        self.open = true;
        self.handshakeOk = false;
    }

    // Flush all pending outbound ciphertext to the socket.
    pub async fn flushOut(self: TlsStream): int {
        while (self.bio.pendingOut() > 0) {
            let n = self.bio.pull(self.scratch, self.cap);
            if (n <= 0) { break; }
            let w = await self.base.sendStr(bufToStr(self.scratch, n));
            if (w < 0) { return 0 - 1; }
        }
        return 0;
    }

    // Pull inbound ciphertext from the socket into the BIO. Returns bytes read (<=0 on EOF/error).
    pub async fn pumpIn(self: TlsStream): int {
        let n = await self.base.recvInto(self.scratch as long, self.cap);
        if (n <= 0) { self.bio.markClosed(); return n; }
        self.bio.feed(self.scratch, n);
        return n;
    }

    pub async fn handshake(self: TlsStream): int {
        while (true) {
            let st = self.bio.step();
            if (await self.flushOut() < 0) { return 0 - 1; }
            if (st == 0) { self.handshakeOk = true; return 0; }
            if (st < 0) { return 0 - 1; }
            let g = await self.pumpIn();
            if (g <= 0) { return 0 - 1; }
        }
        return 0 - 1;
    }

    pub async fn sendStr(self: TlsStream, data: string): int {
        let w = self.bio.writeApp(data as ptr, data.length);
        if (w < 0) { return 0 - 1; }
        if (await self.flushOut() < 0) { return 0 - 1; }
        return w;
    }

    pub async fn recvInto(self: TlsStream, buf: long, max: int): int {
        while (true) {
            let n = self.bio.readApp(buf as ptr, max);
            if (n > 0) { return n; }
            if (n < 0) { return 0 - 1; }
            if (await self.flushOut() < 0) { return 0 - 1; }
            let g = await self.pumpIn();
            if (g <= 0) { return g; }
        }
        return 0 - 1;
    }

    pub fn ok(self: TlsStream): bool { return self.handshakeOk; }
    pub fn isOpen(self: TlsStream): bool { return self.open; }

    pub fn setTimeout(self: TlsStream, ms: int): int {
        return self.base.setTimeout(ms);
    }

    pub fn close(self: TlsStream): void {
        if (self.open) {
            self.bio.closeBio();
            self.base.close();
            self.open = false;
        }
    }
}

pub async fn tlsConnect(host: string, port: int, verify: bool): TlsStream {
    let base = await asyncio.asyncConnect(host, port);
    let bio: tlsmembio.TlsBio = tlsmembio.newClientBio(host);
    let ts = TlsStream(base, bio);
    let hs = await ts.handshake();
    return ts;
}

pub async fn tlsAccept(base: asyncio.AsyncStream, cert: string, key: string): TlsStream {
    let bio: tlsmembio.TlsBio = tlsmembio.newServerBioPem(cert, key);
    let ts = TlsStream(base, bio);
    let hs = await ts.handshake();
    return ts;
}
