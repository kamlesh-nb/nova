// asynctls.nova — non-blocking TLS over the async-first seam (A1).
//
// TlsStream drives a wolfSSL memory-BIO context (all cryptography + X.509 verification stay
// inside the audited library) while doing the REAL socket I/O over an AsyncStream — so every
// `await` PARKS the coroutine (no scheduler thread held) during the TLS record pump. This is
// what gives a DB driver non-blocking TLS: the same `recvInto`/`sendStr` shape as AsyncStream,
// but encrypted, so a reader written against one works against the other.
//
//   let s = await asynctls.tlsConnect("db.example.com", 5432, true);   // verify the cert
//   if (!s.ok()) { /* handshake failed */ }
//   await s.sendStr(frame);
//   let n = await s.recvInto(buf, 4096);
//   s.close();
import bytes;
import net.asyncio;

// Copy `n` bytes of a raw buffer into a fresh Nova string (length-headed, binary-safe).
fn bufToStr(buf: ptr, n: int): string {
    if (n <= 0) { return ""; }
    let out = bytes.alloc(n);
    let i = 0;
    while (i < n) { bytes.write_byte(out, i, bytes.read_byte(buf, i)); i = i + 1; }
    return out as string;
}

pub struct TlsStream impl AsyncIO {
    pub base: asyncio.AsyncStream,   // the underlying async socket
    pub ctx: ptr,                    // MemTlsCtx handle (wolfSSL memory-BIO)
    pub scratch: ptr,                // reusable ciphertext staging buffer
    pub cap: int,
    pub open: bool,
    pub handshakeOk: bool,

    init(base: asyncio.AsyncStream, ctx: ptr) {
        self.base = base;
        self.ctx = ctx;
        self.cap = 16384;
        self.scratch = bytes.alloc(16384);
        self.open = true;
        self.handshakeOk = false;
    }

    // Flush all ciphertext wolfSSL has produced to the socket (parks per send).
    pub async fn flushOut(self: TlsStream): int {
        while (nova_mtls_pending_out(self.ctx) > 0) {
            let n = nova_mtls_pull(self.ctx, self.scratch, self.cap);
            if (n <= 0) { break; }
            let w = await self.base.sendStr(bufToStr(self.scratch, n));
            if (w < 0) { return -1; }
        }
        return 0;
    }

    // Pull ciphertext from the socket and feed it to wolfSSL (parks on recv). <=0 = closed/error.
    pub async fn pumpIn(self: TlsStream): int {
        let n = await self.base.recvInto(self.scratch as int, self.cap);
        if (n <= 0) { nova_mtls_mark_closed(self.ctx); return n; }
        nova_mtls_feed(self.ctx, self.scratch, n);
        return n;
    }

    // Run the TLS handshake to completion, parking on each socket wait. 0 = ok, -1 = failed.
    pub async fn handshake(self: TlsStream): int {
        while (true) {
            let st = nova_mtls_handshake(self.ctx);
            if (await self.flushOut() < 0) { return -1; }
            if (st == 0) { self.handshakeOk = true; return 0; }
            if (st < 0) { return -1; }
            let g = await self.pumpIn();
            if (g <= 0) { return -1; }
        }
        return -1;
    }

    // Encrypt + send `data`; parks until the ciphertext is flushed. Returns bytes accepted or -1.
    pub async fn sendStr(self: TlsStream, data: string): int {
        let w = nova_mtls_write(self.ctx, data as ptr, data.length);
        if (w < 0) { return -1; }
        if (await self.flushOut() < 0) { return -1; }
        return w;
    }

    // Decrypt into `buf` (up to `max`); parks pumping ciphertext until a record is ready.
    // Returns plaintext bytes (>0), 0 = peer closed, -1 = error.
    pub async fn recvInto(self: TlsStream, buf: int, max: int): int {
        while (true) {
            let n = nova_mtls_read(self.ctx, buf, max);
            if (n > 0) { return n; }
            if (n < 0) { return -1; }
            if (await self.flushOut() < 0) { return -1; }
            let g = await self.pumpIn();
            if (g <= 0) { return g; }
        }
        return -1;
    }

    pub fn ok(self: TlsStream): bool { return self.handshakeOk; }
    pub fn isOpen(self: TlsStream): bool { return self.open; }

    // Deadline applies to the underlying ciphertext recv (each TLS record pump awaits base recv).
    pub fn setTimeout(self: TlsStream, ms: int): int {
        return self.base.setTimeout(ms);
    }

    pub fn close(self: TlsStream): void {
        if (self.open) {
            nova_mtls_free(self.ctx);
            self.base.close();
            self.open = false;
        }
    }
}

// Awaitable TLS connect: async-connect the socket, then run the handshake over it (parking
// throughout). `verify` = validate the peer certificate against the system trust store and
// check the hostname (the SECURE default); pass false only for self-signed dev servers.
// Returns a TlsStream — check `.ok()` for handshake success.
pub async fn tlsConnect(host: string, port: int, verify: bool): TlsStream {
    let base = await asyncio.asyncConnect(host, port);
    let ctx = nova_mtls_new(host as ptr, verify ? 1 : 0);
    let ts = TlsStream(base, ctx);
    let hs = await ts.handshake();
    return ts;
}

// Wrap an already-connected AsyncStream in a SERVER-side TLS session (for in-process TLS peers
// and, later, Nova TLS servers). `cert`/`key` are PEM. Returns a TlsStream — check `.ok()`.
pub async fn tlsAccept(base: asyncio.AsyncStream, cert: string, key: string): TlsStream {
    let ctx = nova_mtls_new_server(cert as ptr, cert.length, key as ptr, key.length);
    let ts = TlsStream(base, ctx);
    let hs = await ts.handshake();
    return ts;
}
