
import bytes;
import mem.allocator;
import io.dir;
import io.file;
import assert;

pub struct Watcher {
    pub handle: ptr,

    init(path: string) {
        self.handle = nova_fs_watcher_create(path);
    }

    pub fn nextEvent(self: Watcher): string {
        return nova_fs_watcher_next_event(self.handle);
    }

    pub fn close(self: Watcher): void {
        nova_fs_watcher_close(self.handle);
        self.handle = 0;
    }
}

fn writeFsFile(path: string, content: string): void {
    file.File.writeText(path, content);
}

@test
fn test_fs_watcher(): void {
    let test_dir = "watch_test_dir";
    dir.Dir.create(test_dir, 511);

    let watcher = Watcher(test_dir);

    let d = dir.Dir.open(test_dir);
    let count = d.entries().len;
    d.close();

    writeFsFile(`watch_test_dir/changed_${count}.txt`, "content");

    console.log("[test] Waiting for filesystem event...");
    let event = watcher.nextEvent();
    console.log("[test] Received filesystem event: " + event);

    let contains_changed = false;
    let i = 0;
    let name = "changed_";
    while (i <= event.length - name.length) {
        let is_match = true;
        let j = 0;
        while (j < name.length) {
            if (bytes.read_byte(event, i + j) != bytes.read_byte(name, j)) {
                is_match = false;
            }
            j = j + 1;
        }
        if (is_match) {
            contains_changed = true;
        }
        i = i + 1;
    }

    assert.isTrue(contains_changed);

    watcher.close();
}
