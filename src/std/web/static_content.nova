
import string;
import map;
import list;
import io.file;
import web.mime;
import web.response;
import web.status;

pub struct LruCache {
    pub capacity: int,
    pub store: map.Map<string, string>,
    pub order: list.List<string>,
    pub hits: long,
    pub misses: long,

    init(cap: int) {
        self.capacity = cap;
        self.store = map.Map<string, string>(cap * 2, string.hash);
        self.order = list.List<string>();
        self.hits = 0;
        self.misses = 0;
    }

    fn touch(self: LruCache, key: string): void {
        let n = self.order.size();
        let i = 0;
        while (i < n) {
            let k = self.order.get(i) ?? "";
            if (string.eql(k, key)) {
                self.order.remove(i);
                i = n;
            } else {
                i = i + 1;
            }
        }
        self.order.push(key);
    }

    pub fn get(self: LruCache, key: string): string | undefined {
        if (self.store.has(key)) {
            self.hits = self.hits + 1;
            self.touch(key);
            return self.store.get(key);
        }
        self.misses = self.misses + 1;
        return undefined;
    }

    pub fn put(self: LruCache, key: string, value: string): void {
        if (self.store.has(key)) {
            self.store.set(key, value);
            self.touch(key);
            return;
        }
        if (self.store.size() >= self.capacity) {
            let lru = self.order.get(0) ?? "";
            self.order.remove(0);
            self.store.delete_key(lru);
        }
        self.store.set(key, value);
        self.order.push(key);
    }

    pub fn hitRate(self: LruCache): double {
        let total = self.hits + self.misses;
        if (total == 0) { return 0.0; }
        return (self.hits as double) / (total as double);
    }
}

fn fileExt(path: string): string {
    let dot = string.lastIndexOf(path, ".");
    if (dot == -1) { return ""; }
    return string.slice(path, dot + 1, path.length);
}

pub struct StaticMount {
    pub prefix: string,
    pub dir: string,
    pub cache: LruCache,

    init(prefix: string, dir: string, cacheCap: int) {
        self.prefix = prefix;
        self.dir = dir;
        self.cache = LruCache(cacheCap);
    }

    pub fn serve(self: StaticMount, reqPath: string): response.Response | undefined {
        if (!string.startsWith(reqPath, self.prefix)) {
            return undefined;
        }
        let rel = string.slice(reqPath, self.prefix.length, reqPath.length);
        if (string.indexOf(rel, "..") != -1) {
            return response.Response(Status.Forbidden, "Forbidden");
        }
        if (string.eql(rel, "") || string.eql(rel, "/")) {
            rel = "/index.html";
        }
        let fsPath = self.dir + rel;

        let content = "";
        let cached = self.cache.get(fsPath);
        if (cached == undefined) {
            if (!file.File.exists(fsPath)) {
                return undefined;
            }
            content = file.File.readText(fsPath);
            self.cache.put(fsPath, content);
        } else {
            content = cached ?? "";
        }

        let mimeType = mime.contentType(fileExt(rel));
        let resp = response.Response(Status.Ok, content);
        return resp.setHeader("Content-Type", mimeType);
    }
}
