// Static file serving. A file is read from disk at most ONCE -- the first time it is requested -- then its
// bytes and precomputed Content-Type are held in a Map for the life of the process; every later request for
// that path is answered from the Map with no filesystem access. The Map is unbounded and never evicts, so
// a given asset is never re-read (this is deliberately lazy rather than walking the whole mount tree at
// startup: a mount dir may be large, e.g. contain node_modules, so eagerly reading everything is unsafe).
// All content types work (HTML, CSS, JS, images, fonts): readText is length-prefixed and byte-safe, so
// binary assets are stored verbatim.
import string;
import map;
import list;
import io.file;
import web.mime;
import web.response;
import web.status;

fn fileExt(path: string): string {
    let dot = string.lastIndexOf(path, ".");
    if (dot == -1) { return ""; }
    return string.slice(path, dot + 1, path.length);
}

// One preloaded asset: the raw bytes and the Content-Type computed once from its extension.
pub struct StaticAsset {
    pub content: string,
    pub contentType: string,

    init(content: string, contentType: string) {
        self.content = content;
        self.contentType = contentType;
    }
}

pub struct StaticMount {
    pub prefix: string,
    pub dir: string,
    pub assets: map.Map<string, StaticAsset>,

    init(prefix: string, dir: string, cacheCap: int) {
        self.prefix = prefix;
        self.dir = dir;
        // Keyed by the path RELATIVE to the mount dir (no leading slash), e.g. "index.html",
        // "app.css", "img/logo.png" -- which is what serve() derives from the request path.
        self.assets = map.Map<string, StaticAsset>(256, string.hash);
    }

    pub fn serve(self: StaticMount, reqPath: string): response.Response | undefined {
        if (!string.startsWith(reqPath, self.prefix)) {
            return undefined;
        }
        let rel = string.slice(reqPath, self.prefix.length, reqPath.length);
        if (string.indexOf(rel, "..") != -1) {
            return response.Response(Status.Forbidden, "Forbidden");
        }
        if (string.eql(rel, "") || string.eql(rel, "/")) {
            rel = "index.html";
        }
        // Map keys have no leading slash; the stripped request path may keep one (prefix "/" -> "/app.css").
        if (string.startsWith(rel, "/")) {
            rel = string.slice(rel, 1, rel.length);
        }

        let hit = self.assets.get(rel);
        if (hit != undefined) {
            let asset = hit ?? StaticAsset("", "");
            return response.Response(Status.Ok, asset.content).setHeader("Content-Type", asset.contentType);
        }

        // First time this path is seen: read it from disk once, then cache it forever.
        let sep = if (string.startsWith(rel, "/")) "" else "/";
        let fsPath = self.dir + sep + rel;
        if (!file.File.exists(fsPath)) {
            return undefined;
        }
        let content = file.File.readText(fsPath);
        let contentType = mime.contentType(fileExt(rel));
        self.assets.set(rel, StaticAsset(content, contentType));
        return response.Response(Status.Ok, content).setHeader("Content-Type", contentType);
    }
}
