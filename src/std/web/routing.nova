
import string;
import list;
import map;
import serde.source;
import web.request;
import web.response;
import web.status;
import web.di;

// THE router. One route table, one pattern parser, one matcher -- shared by every routing scenario:
//   - web.app (App) composes a Router for its async, DI-backed mediator dispatch.
//   - a Router used standalone dispatches synchronously, either through the compiler-generated
//     __mediator_dispatch_by_name (typed RequestHandler routes) or through a closure handler
//     (`(Request) -> Response`, the controller style). Both kinds live in the same table and share the
//     same matcher, so pattern + typed-param behaviour never diverges between them.
// Route patterns support typed path parameters: `/api/user/{id:int}` binds `id` from the path and, for
// an `int` parameter, rejects a non-numeric segment (a 400 at the dispatch layer).

pub trait RequestHandler<TReq, TResp> {
    async fn handle(self, req: TReq): TResp;
}

// One pattern segment. `is_param` marks `{name}` / `{name:type}`; `ptype` is the declared type of a
// parameter ("" or "string" for an untyped one, "int" to validate a numeric segment).
pub struct Seg {
    pub is_param: bool,
    pub text: string,
    pub ptype: string,

    init(is_param: bool, text: string, ptype: string) {
        self.is_param = is_param;
        self.text = text;
        self.ptype = ptype;
    }
}

// One route. `isCtrl` selects the dispatch tail: false -> a typed mediator route keyed by `key`;
// true -> a controller route served by `handler`. The unused field carries a harmless default (an
// empty key / a not-found handler) so the record is always fully formed.
pub struct Route {
    pub method: string,
    pub segs: List<Seg>,
    pub key: string,
    pub handler: (request.Request) -> response.Response,
    pub isCtrl: bool,

    init(method: string, segs: List<Seg>, key: string, handler: (request.Request) -> response.Response, isCtrl: bool) {
        self.method = method;
        self.segs = segs;
        self.key = key;
        self.handler = handler;
        self.isCtrl = isCtrl;
    }
}

// The outcome of matching one request against the table. Exactly one of matched / typedBad /
// methodNotAllowed is set on a non-empty table; all three false means no path matched (404).
// `routeIndex` is the matched route's slot (-1 when not matched), so a dispatcher can read its
// handler/key without re-scanning.
pub struct RouteMatch {
    pub matched: bool,
    pub typedBad: bool,
    pub methodNotAllowed: bool,
    pub params: Map<string, string>,
    pub key: string,
    pub routeIndex: int,

    init(matched: bool, typedBad: bool, methodNotAllowed: bool, params: Map<string, string>, key: string, routeIndex: int) {
        self.matched = matched;
        self.typedBad = typedBad;
        self.methodNotAllowed = methodNotAllowed;
        self.params = params;
        self.key = key;
        self.routeIndex = routeIndex;
    }
}

pub fn parsePattern(path: string): List<Seg> {
    let segs = List<Seg>();
    let splits = request.pathSegs(path);
    let pi = 0;
    while (pi < splits.size()) {
        let p = splits.at(pi);
        if (string.startsWith(p, "{") && string.endsWith(p, "}")) {
            let inner = string.slice(p, 1, p.length - 1);
            let colon = string.indexOf(inner, ":");
            if (colon == -1) {
                segs.push(Seg(true, inner, "string"));
            } else {
                let nm = string.slice(inner, 0, colon);
                let ty = string.slice(inner, colon + 1, inner.length);
                segs.push(Seg(true, nm, ty));
            }
        } else {
            segs.push(Seg(false, p, ""));
        }
        pi = pi + 1;
    }
    return segs;
}

pub struct Router {
    pub routes: List<Route>,

    init() {
        self.routes = List<Route>();
    }

    // Typed mediator registration. `app.get<T>(path)` / `router.get<T>(path)` is lowered by codegen to
    // `__addRoute("GET", path, "T")` for any receiver that defines this method (see expressions.zig).
    // The handler slot is unused for a mediator route, so it carries a not-found default.
    pub fn __addRoute(self: Router, method: string, path: string, key: string): void {
        self.routes.push(Route(method, parsePattern(path), key,
            (req: request.Request) => response.Response(Status.NotFound, "Not Found"), false));
    }

    // Controller registration: a closure handler for a (possibly patterned) route. Same table, same
    // matcher as the typed routes -- so a controller route may use `/thing/{id:int}` too.
    pub fn handle(self: Router, method: string, path: string, handler: (request.Request) -> response.Response): void {
        self.routes.push(Route(method, parsePattern(path), "", handler, true));
    }

    // The single matcher. Pure (no dispatch): every caller -- App's async path and the sync route/
    // serve/dispatch below -- resolves a request the same way, so typed-param handling never diverges.
    pub fn resolve(self: Router, method: string, path: string): RouteMatch {
        let segs = request.pathSegs(path);
        let nseg = segs.size();
        let pathMatched = false;
        let r = 0;
        while (r < self.routes.size()) {
            let route = self.routes.at(r);
            if (route.segs.size() == nseg) {
                let params = Map<string, string>(8, string.hash);
                let ok = true;
                let typedBad = false;
                let i = 0;
                while (i < nseg) {
                    let pat = route.segs.at(i);
                    let val = segs.get(i) ?? "";
                    if (pat.is_param) {
                        if (string.eql(pat.ptype, "int") && !request.isAllDigits(val)) {
                            typedBad = true;
                            ok = false;
                        } else {
                            params.set(pat.text, val);
                        }
                    } else if (!string.eql(pat.text, val)) {
                        ok = false;
                    }
                    i = i + 1;
                }
                if (ok) {
                    pathMatched = true;
                    if (string.eql(route.method, method)) {
                        return RouteMatch(true, false, false, params, route.key, r);
                    }
                } else if (typedBad && string.eql(route.method, method)) {
                    return RouteMatch(false, true, false, Map<string, string>(1, string.hash), "", -1);
                }
            }
            r = r + 1;
        }
        if (pathMatched) {
            return RouteMatch(false, false, true, Map<string, string>(1, string.hash), "", -1);
        }
        return RouteMatch(false, false, false, Map<string, string>(1, string.hash), "", -1);
    }

    // Convenience: the matched Route object (or undefined). Same matching as resolve.
    pub fn matchRoute(self: Router, method: string, path: string): Route | undefined {
        let m = self.resolve(method, path);
        if (m.matched) { return self.routes.at(m.routeIndex); }
        return undefined;
    }

    // Synchronous typed dispatch (string result): match, overlay the path params over the body (route
    // params win -- @fromRoute over @fromBody), and run the discovered handler via the generated
    // mediator dispatch. Returns the serialized body, or "400"/"404"/"405" for the non-match outcomes.
    pub fn dispatch(self: Router, method: string, path: string, body: ValueSource): string {
        let m = self.resolve(method, path);
        if (m.matched) {
            let composite = CompositeSource(ParamSource(m.params), body);
            let provider = ServiceCollection().buildServiceProvider();
            let resp = __mediator_dispatch_by_name(m.key, composite, provider);
            return resp.body;
        }
        if (m.typedBad) { return "400"; }
        if (m.methodNotAllowed) { return "405"; }
        return "404";
    }

    // The universal Request -> Response dispatch, serving BOTH tails: a controller route runs its
    // closure handler; a typed route runs the mediator pipeline (path params overlaid on the JSON body)
    // and wraps the result in a 200 JSON response. Non-matches map to 400 / 405 / 404.
    pub fn serve(self: Router, req: request.Request): response.Response {
        let m = self.resolve(req.method, req.path);
        if (m.matched) {
            let route = self.routes.at(m.routeIndex);
            if (route.isCtrl) {
                let h = route.handler;
                return h(req);
            }
            let jsonBody = req.body == "" ? "{}" : req.body;
            let src = source.fromJson(jsonBody);
            let composite = CompositeSource(ParamSource(m.params), src);
            let provider = ServiceCollection().buildServiceProvider();
            return __mediator_dispatch_by_name(m.key, composite, provider);
        }
        if (m.typedBad) {
            return response.Response(Status.BadRequest, "Bad Request: invalid path parameter");
        }
        if (m.methodNotAllowed) {
            return response.Response(Status.MethodNotAllowed, "405");
        }
        return response.Response(Status.NotFound, "404");
    }

    // Alias for the controller-style entry point (reads better next to `handle`).
    pub fn route(self: Router, req: request.Request): response.Response {
        return self.serve(req);
    }
}
