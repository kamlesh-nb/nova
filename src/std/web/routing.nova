
import string;
import list;
import map;
import serde.source;
import web.request;
import web.response;
import web.status;

pub trait RequestHandler<TReq, TResp> {
    fn handle(self, req: TReq): TResp;
}

struct RouteSeg {
    is_param: bool,
    text: string,
    init(is_param: bool, text: string) { self.is_param = is_param; self.text = text; }
}

struct TypedRoute {
    method: string,
    pattern: List<RouteSeg>,
    typeName: string,
    init(method: string, pattern: List<RouteSeg>, typeName: string) {
        self.method = method;
        self.pattern = pattern;
        self.typeName = typeName;
    }
}

struct DispatchResult {
    pub status: int,
    pub body: string,
    init(status: int, body: string) { self.status = status; self.body = body; }
}

// Path splitting lives in web.request (request.pathSegs); routing reuses it rather than keeping its own.

fn parsePattern(path: string): List<RouteSeg> {
    let segs = List<RouteSeg>();
    let splits = request.pathSegs(path);
    let pi = 0;
    while (pi < splits.size()) {
        let p = splits.at(pi);
        if (string.startsWith(p, "{") && string.endsWith(p, "}")) {
            let inner = string.slice(p, 1, p.length - 1);
            let colon = string.indexOf(inner, ":");
            let name = colon == -1 ? inner : string.slice(inner, 0, colon);
            segs.push(RouteSeg(true, name));
        } else {
            segs.push(RouteSeg(false, p));
        }
        pi = pi + 1;
    }
    return segs;
}

pub struct Router {
    routes: List<TypedRoute>,

    init() {
        self.routes = List<TypedRoute>();
    }

    pub fn __addRoute(self: Router, method: string, path: string, typeName: string): void {
        self.routes.push(TypedRoute(method, parsePattern(path), typeName));
    }

    pub fn route(self: Router, method: string, path: string, body: ValueSource): DispatchResult {
        let reqSegs = request.pathSegs(path);
        let pathMatched = false;
        let ri = 0;
        while (ri < self.routes.size()) {
            let route = self.routes.at(ri);
            let segs = route.pattern;
            if (segs.size() == reqSegs.size()) {
                let params = Map<string, string>(4, string.hash);
                let matched = true;
                let i = 0;
                let n = segs.size();
                while (i < n) {
                    let seg = segs.get(i) ?? RouteSeg(false, "");
                    let req = reqSegs.get(i) ?? "";
                    if (seg.is_param) {
                        params.set(seg.text, req);
                    } else {
                        if (!string.eql(seg.text, req)) { matched = false; }
                    }
                    i = i + 1;
                }
                if (matched) {
                    pathMatched = true;
                    if (string.eql(route.method, method)) {
                        let composite = CompositeSource(ParamSource(params), body);
                        return DispatchResult(200, __mediator_dispatch_by_name(route.typeName, composite));
                    }
                }
            }
            ri = ri + 1;
        }
        if (pathMatched) { return DispatchResult(405, "405"); }
        return DispatchResult(404, "404");
    }

    pub fn dispatch(self: Router, method: string, path: string, body: ValueSource): string {
        let r = self.route(method, path, body);
        return r.body;
    }

    pub fn serve(self: Router, req: request.Request): response.Response {
        let raw = req.body;
        let jsonBody = raw == "" ? "{}" : raw;
        let src = source.fromJson(jsonBody);
        let r = self.route(req.method, req.path, src);
        let resp = response.Response(Status.fromCode(r.status), r.body);
        resp.setHeader("Content-Type", "application/json");
        return resp;
    }
}
