
import string;
import list;
import map;
import bytes;
import web.url;

pub struct Request {
    pub method: string,
    pub path: string,
    pub query: Map<string, string>,
    pub headers: Map<string, string>,
    pub cookies: Map<string, string>,
    pub body: string,

    pub fn fromString(raw: string): Request {
        let boundary = string.indexOf(raw, "\r\n\r\n");
        if (boundary == -1) {
            return Request.empty();
        }

        let headers_part = string.slice(raw, 0, boundary);
        let body = string.slice(raw, boundary + 4, raw.length);

        let lines = string.split(headers_part, "\r\n");
        if (lines.size() == 0) {
            return Request.empty();
        }

        let request_line = lines.get(0) ?? "";
        let parts = string.split(request_line, " ");
        let method = parts.get(0) ?? "";
        let full_path = parts.get(1) ?? "";
        let (path, query) = splitPathQuery(full_path);

        let headers = Map<string, string>(8, string.hash);
        let i = 1;
        while (i < lines.size()) {
            let line = lines.get(i) ?? "";
            if (line != "") {
                let (key, value) = parseHeader(line);
                if (key != "") {
                    headers.set(key, value);
                }
            }
            i = i + 1;
        }

        let cookies = Map<string, string>(4, string.hash);
        let cookie_str = findHeaderVal(headers, "Cookie");
        if (cookie_str != "") {
            let pairs = string.split(cookie_str, ";");
            let j = 0;
            while (j < pairs.size()) {
                let pair = pairs.get(j) ?? "";
                let trimmed_pair = trimWhitespace(pair);
                let eq_idx = string.indexOf(trimmed_pair, "=");
                if (eq_idx != -1) {
                    let k = string.slice(trimmed_pair, 0, eq_idx);
                    let v = string.slice(trimmed_pair, eq_idx + 1, trimmed_pair.length);
                    cookies.set(k, v);
                }
                j = j + 1;
            }
        }

        return Request{
            method: method,
            path: path,
            query: query,
            headers: headers,
            cookies: cookies,
            body: body,
        };
    }

    pub fn parse(ptr: int, len: int): Request {
        let raw = bytes.read_string(ptr, len);
        return Request.fromString(raw);
    }

    pub fn empty(): Request {
        return Request{
            method: "",
            path: "",
            query: Map<string, string>(1, string.hash),
            headers: Map<string, string>(1, string.hash),
            cookies: Map<string, string>(1, string.hash),
            body: "",
        };
    }

    pub fn getHeader(self: Request, name: string): string | undefined {
        let lower_name = string.toLowerCase(name);
        let keys = self.headers.keys();
        let keysLen = keys.size();
        let i = 0;
        while (i < keysLen) {
            let key = keys.get(i) ?? "";
            if (string.toLowerCase(key) == lower_name) {
                return self.headers.get(key);
            }
            i = i + 1;
        }
        return undefined;
    }

    pub fn getCookie(self: Request, name: string): string | undefined {
        return self.cookies.get(name);
    }
}

fn splitPathQuery(full_path: string): (string, Map<string, string>) {
    let idx = string.indexOf(full_path, "?");
    if (idx == -1) {
        return (full_path, Map<string, string>(1, string.hash));
    }
    let path = string.slice(full_path, 0, idx);
    let query_str = string.slice(full_path, idx + 1, full_path.length);
    let query = parseQuery(query_str);
    return (path, query);
}

pub fn parseQuery(query_str: string): Map<string, string> {

    let result = Map<string, string>(4, string.hash);
    let pairs = string.split(query_str, "&");
    pairs.forEach((pair) => {
        let parts = string.split(pair, "=");
        let key = url.decode(parts.get(0) ?? "");
        let val = url.decode(parts.get(1) ?? "");
        result.set(key, val);
    });
    return result;
}

fn trimWhitespace(s: string): string {
    let len = s.length;
    let start = 0;
    while (start < len) {
        let c = s[start];
        if (c != 32 && c != 9 && c != 10 && c != 13) {
            break;
        }
        start = start + 1;
    }
    let end = len;
    while (end > start) {
        let c = s[end - 1];
        if (c != 32 && c != 9 && c != 10 && c != 13) {
            break;
        }
        end = end - 1;
    }
    if (start >= end) {
        return "";
    }
    return string.slice(s, start, end);
}

fn parseHeader(line: string): (string, string) {
    let idx = string.indexOf(line, ":");
    if (idx == -1) {
        return ("", "");
    }
    let key = trimWhitespace(string.slice(line, 0, idx));
    let val = trimWhitespace(string.slice(line, idx + 1, line.length));
    return (key, val);
}

fn findHeaderVal(headers: Map<string, string>, name: string): string {
    let lower_name = string.toLowerCase(name);
    let keys = headers.keys();
    let i = 0;
    while (i < keys.size()) {
        let key = keys.get(i) ?? "";
        if (string.toLowerCase(key) == lower_name) {
            return headers.get(key) ?? "";
        }
        i = i + 1;
    }
    return "";
}
