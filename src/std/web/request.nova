
import string;
import list;
import map;
import bytes;
import assert;
import os.sys;
import web.url;

// HTTP/1 request parsing. The hot path uses a memchr (SIMD-backed, os/sys) delimiter scan over the
// raw buffer and slices method/path/headers directly out of it -- no `string.split` (no per-line
// List), no intermediate trim slices. This is the same picohttpparser-style engine that
// web/httpparser exposes zero-copy; Request materialises the handler-facing string fields on top of
// it. Header keys keep their on-the-wire case; getHeader compares case-insensitively without
// allocating (byte-wise), so `req.headers.get("Content-Type")` and `req.getHeader("content-type")`
// both work.

fn idxByte(buf: long, start: int, end: int, b: int): int {
    if (start >= end) { return -1; }
    let p = sys.memchr(buf + (start as long), b, (end - start) as long);
    if (p == 0) { return -1; }
    return (p - buf) as int;
}

// case-insensitive ASCII equality, no allocation.
fn ciEquals(a: string, b: string): bool {
    if (a.length != b.length) { return false; }
    let i = 0;
    while (i < a.length) {
        let ca = a[i];
        let cb = b[i];
        if (ca >= 65 && ca <= 90) { ca = ca + 32; }
        if (cb >= 65 && cb <= 90) { cb = cb + 32; }
        if (ca != cb) { return false; }
        i = i + 1;
    }
    return true;
}

pub struct Request {
    pub method: string,
    pub path: string,
    pub query: Map<string, string>,
    pub headers: Map<string, string>,
    pub cookies: Map<string, string>,
    pub body: string,

    pub fn fromString(raw: string): Request {
        let n = raw.length;
        let buf = raw as long;

        // request line: METHOD SP PATH SP VERSION CRLF
        let sp1 = idxByte(buf, 0, n, 32);
        if (sp1 < 0) { return Request.empty(); }
        let method = string.slice(raw, 0, sp1);

        let sp2 = idxByte(buf, sp1 + 1, n, 32);
        if (sp2 < 0) { return Request.empty(); }
        let full_path = string.slice(raw, sp1 + 1, sp2);
        let (path, query) = splitPathQuery(full_path);

        let eol = idxByte(buf, sp2 + 1, n, 13); // CR ending the request line
        if (eol < 0) { return Request.empty(); }
        let pos = eol + 2;

        let headers = Map<string, string>(8, string.hash);
        let cookie_str = "";

        // header lines until the blank CRLF
        while (pos < n) {
            if (bytes.read_byte(buf, pos) as int == 13) { // blank line -> end of headers
                pos = pos + 2;
                break;
            }
            let line_end = idxByte(buf, pos, n, 13);
            if (line_end < 0) { break; }
            let colon = idxByte(buf, pos, line_end, 58); // ':'
            if (colon >= 0) {
                let key = string.slice(raw, pos, colon);
                let v_off = colon + 1;
                while (v_off < line_end && (bytes.read_byte(buf, v_off) as int == 32)) {
                    v_off = v_off + 1;
                }
                let val = string.slice(raw, v_off, line_end);
                headers.set(key, val);
                if (ciEquals(key, "Cookie")) { cookie_str = val; }
            }
            pos = line_end + 2;
        }

        let body = if (pos <= n) string.slice(raw, pos, n) else "";

        let cookies = Map<string, string>(4, string.hash);
        if (cookie_str != "") {
            let pairs = string.split(cookie_str, ";");
            let j = 0;
            while (j < pairs.size()) {
                let pair = pairs.get(j) ?? "";
                let trimmed_pair = trimWhitespace(pair);
                let eq_idx = string.indexOf(trimmed_pair, "=");
                if (eq_idx != -1) {
                    let k = string.slice(trimmed_pair, 0, eq_idx);
                    let v = string.slice(trimmed_pair, eq_idx + 1, trimmed_pair.length);
                    cookies.set(k, v);
                }
                j = j + 1;
            }
        }

        return Request{
            method: method,
            path: path,
            query: query,
            headers: headers,
            cookies: cookies,
            body: body,
        };
    }

    pub fn parse(ptr: int, len: int): Request {
        let raw = bytes.read_string(ptr, len);
        return Request.fromString(raw);
    }

    pub fn empty(): Request {
        return Request{
            method: "",
            path: "",
            query: Map<string, string>(1, string.hash),
            headers: Map<string, string>(1, string.hash),
            cookies: Map<string, string>(1, string.hash),
            body: "",
        };
    }

    // Case-insensitive header lookup with no per-key allocation (byte-wise compare on original-case
    // keys), replacing the old per-key toLowerCase scan.
    pub fn getHeader(self: Request, name: string): string | undefined {
        let keys = self.headers.keys();
        let keysLen = keys.size();
        let i = 0;
        while (i < keysLen) {
            let key = keys.get(i) ?? "";
            if (ciEquals(key, name)) {
                return self.headers.get(key);
            }
            i = i + 1;
        }
        return undefined;
    }

    pub fn getCookie(self: Request, name: string): string | undefined {
        return self.cookies.get(name);
    }
}

fn splitPathQuery(full_path: string): (string, Map<string, string>) {
    let idx = string.indexOf(full_path, "?");
    if (idx == -1) {
        return (full_path, Map<string, string>(1, string.hash));
    }
    let path = string.slice(full_path, 0, idx);
    let query_str = string.slice(full_path, idx + 1, full_path.length);
    let query = parseQuery(query_str);
    return (path, query);
}

pub fn parseQuery(query_str: string): Map<string, string> {

    let result = Map<string, string>(4, string.hash);
    let pairs = string.split(query_str, "&");
    pairs.forEach((pair) => {
        let parts = string.split(pair, "=");
        let key = url.decode(parts.get(0) ?? "");
        let val = url.decode(parts.get(1) ?? "");
        result.set(key, val);
    });
    return result;
}

fn trimWhitespace(s: string): string {
    let len = s.length;
    let start = 0;
    while (start < len) {
        let c = s[start];
        if (c != 32 && c != 9 && c != 10 && c != 13) {
            break;
        }
        start = start + 1;
    }
    let end = len;
    while (end > start) {
        let c = s[end - 1];
        if (c != 32 && c != 9 && c != 10 && c != 13) {
            break;
        }
        end = end - 1;
    }
    if (start >= end) {
        return "";
    }
    return string.slice(s, start, end);
}

// ── HTTP wire framing ─────────────────────────────────────────────────────────
// Low-level request parsing directly off a raw socket buffer (`buf: long`), used by the server's
// connection reader to frame a request incrementally before the full bytes have arrived: find the
// header terminator, read Content-Length / detect chunked, decode a chunked body, and pull the
// method + path. These complement the string-based Request.fromString for the streaming read path.
// (buf is `long`: pointer math must stay 64-bit, so offsets are added at long width.)

fn lowerByte(b: int): int {
    if (b >= 65 && b <= 90) { return b + 32; }
    return b;
}

pub fn bufFindHeaderEnd(buf: long, start: int, end: int): int {
    let i = start;
    while (i + 4 <= end) {
        if (bytes.read_byte(buf, i) == 13 && bytes.read_byte(buf, i + 1) == 10 &&
            bytes.read_byte(buf, i + 2) == 13 && bytes.read_byte(buf, i + 3) == 10) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

pub fn bufFindCI(buf: long, start: int, end: int, needle: string): int {
    let nlen = needle.length;
    if (nlen == 0) { return start; }
    let i = start;
    while (i + nlen <= end) {
        let j = 0;
        let matched = true;
        while (j < nlen) {
            if (lowerByte(bytes.read_byte(buf, i + j)) != (needle[j] as int)) { matched = false; break; }
            j = j + 1;
        }
        if (matched) { return i; }
        i = i + 1;
    }
    return -1;
}

pub fn bufContentLength(buf: long, start: int, hdrEnd: int): int {
    let idx = bufFindCI(buf, start, hdrEnd, "content-length:");
    if (idx == -1) { return 0; }
    let p = idx + 15;
    while (p < hdrEnd && bytes.read_byte(buf, p) == 32) { p = p + 1; }
    let n = 0;
    while (p < hdrEnd) {
        let c = bytes.read_byte(buf, p);
        if (c < 48 || c > 57) { break; }
        n = n * 10 + (c - 48);
        p = p + 1;
    }
    return n;
}

pub fn bufIsChunked(buf: long, start: int, hdrEnd: int): bool {
    return bufFindCI(buf, start, hdrEnd, "transfer-encoding: chunked") != -1;
}

pub fn bufFindCRLF(buf: long, from: int, len: int): int {
    let p = from;
    while (p + 1 < len) {
        if (bytes.read_byte(buf, p) == 13 && bytes.read_byte(buf, p + 1) == 10) { return p; }
        p = p + 1;
    }
    return -1;
}

pub fn bufParseHex(buf: long, from: int, to: int): int {
    let v = 0;
    let p = from;
    while (p < to) {
        let c = bytes.read_byte(buf, p);
        let d = -1;
        if (c >= 48 && c <= 57) { d = c - 48; }
        else if (c >= 97 && c <= 102) { d = c - 97 + 10; }
        else if (c >= 65 && c <= 70) { d = c - 65 + 10; }
        if (d < 0) { break; }
        v = v * 16 + d;
        p = p + 1;
    }
    return v;
}

pub fn bufChunkedEnd(buf: long, start: int, len: int): int {
    let p = start;
    while (p < len) {
        let lineEnd = bufFindCRLF(buf, p, len);
        if (lineEnd == -1) { return -1; }
        let size = bufParseHex(buf, p, lineEnd);
        let dataStart = lineEnd + 2;
        if (size == 0) {
            if (dataStart + 2 <= len) { return dataStart + 2; }
            return -1;
        }
        let next = dataStart + size + 2;
        if (next > len) { return -1; }
        p = next;
    }
    return -1;
}

pub fn bufDechunk(buf: long, start: int, len: int): string {
    let out = List<string>();
    let p = start;
    while (p < len) {
        let lineEnd = bufFindCRLF(buf, p, len);
        if (lineEnd == -1) { break; }
        let size = bufParseHex(buf, p, lineEnd);
        let dataStart = lineEnd + 2;
        if (size == 0) { break; }
        if (dataStart + size > len) { break; }
        out.push(bytes.read_string(buf + dataStart, size));
        p = dataStart + size + 2;
    }
    return string.join(out, "");
}

pub fn bufMethodPath(buf: long, len: int): (string, string) {
    let sp1 = -1;
    let i = 0;
    while (i < len) {
        if (bytes.read_byte(buf, i) == 32) { sp1 = i; break; }
        i = i + 1;
    }
    if (sp1 == -1) { return ("", ""); }
    let method = bytes.read_string(buf, sp1);
    let ps = sp1 + 1;
    let pe = ps;
    while (pe < len) {
        let c = bytes.read_byte(buf, pe);
        if (c == 32 || c == 63) { break; }
        pe = pe + 1;
    }
    let path = bytes.read_string(buf + ps, pe - ps);
    return (method, path);
}

@test
fn test_chunked_request_decode(): void {
    let s = "4\r\nWiki\r\n5\r\npedia\r\n0\r\n\r\n";
    let n = s.length;
    let buf: long = bytes.alloc(n);
    let i = 0;
    while (i < n) { bytes.write_byte(buf, i, s[i]); i = i + 1; }
    assert.equalInt(bufChunkedEnd(buf, 0, n), n);
    assert.equalStr(bufDechunk(buf, 0, n), "Wikipedia");
    assert.equalInt(bufChunkedEnd(buf, 0, n - 4), -1);
    assert.equalInt(bufParseHex(buf, 0, 1), 4);
    bytes.free(buf);
}
