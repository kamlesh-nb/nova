// server.nova — HttpServer: fiber-per-connection HTTP/1.1 server
import bytes;
import mem.allocator;
import string;
import list;
import map;
import net.tcp.server;
import net.tcp.socket;
import web.request;
import web.response;

pub struct HttpServer {
    pub port: int,
    pub running: bool,
    pub listener: server.TcpListener,

    init() {
        self.port = 0;
        self.running = false;
    }

    pub fn delete(self: HttpServer): void {
        self.stop();
    }

    pub fn stop(self: HttpServer): void {
        if (self.running) {
            self.running = false;
            self.listener.close();
        }
    }

    pub fn listen(self: HttpServer, port: int, handler: (request.Request) -> response.Response): void {
        self.port = port;
        self.running = true;
        self.listener = server.TcpListener.bind(port);
        console.log(`HttpServer listening on port ${port}`);

        while (self.running) {
            console.log("DEBUG listen: waiting for accept...");
            let stream = self.listener.accept();
            console.log(`DEBUG listen: accepted fd=${stream.fd}`);
            if (stream.fd == -1) {
                break;
            }
            // Handle the connection. (Was fiber.spawn — which ran inline, so the server was already
            // serial; real per-connection concurrency needs async `spawn` + async socket I/O, a follow-on.)
            handleConnection(stream, handler);
        }
    }
}

fn handleConnection(stream: socket.TcpStream, handler: (request.Request) -> response.Response): void {
    let raw = stream.read(8192);
    console.log(`DEBUG: handleConnection raw request length: ${raw.length}`);
    console.log("DEBUG: handleConnection raw request:\n" + raw);
    if (raw == "") {
        stream.close();
        return;
    }

    let req = request.Request.fromString(raw);
    let res = handler(req);
    let full_response = Response.serialize(res);
    stream.write(full_response);
    stream.close();
}
