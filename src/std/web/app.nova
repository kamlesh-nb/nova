// app.nova — Minimal-API web framework, MediatR-style, on async sockets.
//
//   let app = App();
//   app.handle<GetUser>(GetUserHandler{});         // register a handler for the GetUser request
//   app.get<GetUser>("/api/user/{id:int}");        // route: GET this path -> GetUser
//   app.run(8080);
//
// Three responsibilities, cleanly separated (SRP):
//   - get<T>/post<T>/... : REGISTRATION only. Record (method, path, type key). No dispatch.
//   - App.dispatch(req)  : the ONE request→Response site. Match route -> mediator.send(key, src).
//   - handler.handle(src): binds the request itself (visible, debuggable) and returns a Response.
//
// AppRoute and handler are linked by the request TYPE, not by a reference — that decoupling is what
// makes this MediatR rather than Express-with-callbacks. The only compiler assist is
// `serde.typeName<T>()`, which yields the type's name so the route key and the handler
// registration agree by type instead of a hand-typed string.
//
// Depends on the trait-dispatch foundation (traits as values) and method monomorphization
// (get<T> is a real generic method) — see conformance/cases/12_traits_dispatch.nova and
// 68_generic_method_mono.nova.

import net.asyncio;
import web.request;
import web.response;
import web.status;
import web.url;
import web.multipart;
import serde.source;
import web.static_content;
import web.di;
import compress.gzip;
import string;
import list;
import map;
import bytes;
import assert;

// The request model + parser is `web/request.nova`'s `Request` (method, path, query/headers/cookies
// as parsed Maps, body, `fromString`/`getHeader`/`getCookie`). This file used to carry its own
// weaker `HttpRequest` + `parseRequest` + `headerValue` — deleted; one request model for the whole
// framework.

// ===========================================================================
// MessageHandler / AppMediator — the MediatR core (IRequestHandler), string-keyed by request type.
// ===========================================================================

/// Handles a request (IRequestHandler<TReq, Response>). The handler receives the raw request
/// `ValueSource` and does its OWN binding — `GetUser{ id: src.getInt("id") }` — so binding is
/// ordinary, VISIBLE, debuggable Nova you can step, log, and validate. No hidden compiler binder,
/// no reflection, no `any` downcast.
pub trait MessageHandler {
    // `handle` is `async fn`: a handler may `await` async work (a DB query, an outbound HTTP call)
    // directly on the request coroutine — it PARKS, it does not block-drive. The whole dispatch chain
    // above it (`AppMediator.send` -> `App.dispatch` -> `App.respondMiss` -> the async `handleConn`
    // accept-loop coroutine) is async too, so the request is awaited end to end with no nested
    // `nova_run_root`. A pure-compute handler with no `await` simply completes at first resume.
    async fn handle(self: MessageHandler, src: ValueSource): response.Response;
}

pub struct AppMediator {
    // Two registration paths, both keyed by the request type name:
    //   * `handlers`  — a pre-built INSTANCE (the simple, zero-dependency case, `app.handle<T>(H{})`).
    //   * `factories` — a `(ServiceProvider) -> MessageHandler` invoked PER REQUEST to build the handler,
    //     resolving its constructor dependencies from the DI container (`app.handleFrom<T>(...)`). A
    //     factory takes precedence over an instance for the same key; running it per request means a
    //     scoped/transient dependency is honored (a fresh handler each time).
    pub handlers: Map<string, MessageHandler>,
    pub factories: Map<string, (ServiceScope) -> MessageHandler>,

    init() {
        self.handlers = Map<string, MessageHandler>(32, string.hash);
        self.factories = Map<string, (ServiceScope) -> MessageHandler>(32, string.hash);
    }

    pub fn register(self: AppMediator, key: string, handler: MessageHandler): void {
        self.handlers.set(key, handler);
    }

    pub fn registerFactory(self: AppMediator, key: string, factory: (ServiceScope) -> MessageHandler): void {
        self.factories.set(key, factory);
    }

    // Resolve the handler for `key` (the request type name) and run it with the raw source. A factory
    // (DI) is preferred: a fresh per-request `ServiceScope` is opened, the handler is BUILT from it
    // (so its scoped dependencies are per-request), and it runs. Else a pre-built instance; else 404.
    // The handler binds and returns the Response — the one request→Response dispatch site.
    pub async fn send(self: AppMediator, key: string, provider: ServiceProvider, src: ValueSource): response.Response {
        let factory = self.factories.get(key);
        if (factory != undefined) {
            let scope = provider.createScope();
            let build = factory ?? ((sc) => { return NoHandler{}; });
            let handler = build(scope);
            return await handler.handle(src);
        }
        let handler = self.handlers.get(key);
        if (handler == undefined) {
            return response.Response(Status.NotFound, "No handler for request: " + key);
        }
        return await handler.handle(src);
    }
}

// The unreachable default for the factory `??` in `send` (a closure default may not capture `self`).
// Never invoked: the factory is present whenever this branch is reached.
struct NoHandler impl MessageHandler {
    async fn handle(self: NoHandler, src: ValueSource): response.Response {
        return response.Response(Status.NotFound, "No handler");
    }
}

// ===========================================================================
// Router — {name:type} pattern segments with match-time coercion.
// ===========================================================================
pub struct Seg {
    pub is_param: bool,
    pub text: string,   // static text, or param name
    pub ptype: string,  // "int" | "string" (params only)

    init(is_param: bool, text: string, ptype: string) {
        self.is_param = is_param;
        self.text = text;
        self.ptype = ptype;
    }
}

pub struct AppRoute {
    pub method: string,
    pub segs: List<Seg>,
    // The mediator key — the request type's name (`serde.typeName<TReq>()`). A AppRoute is PLAIN DATA:
    // it maps method+path to a request type. It holds no handler and no dispatch logic; the handler
    // is resolved from the mediator by this key at request time (`App.dispatch`).
    pub key: string,

    init(method: string, segs: List<Seg>, key: string) {
        self.method = method;
        self.segs = segs;
        self.key = key;
    }
}

fn parsePattern(path: string): List<Seg> {
    let segs = List<Seg>();
    let parts = string.split(path, "/");
    let n = parts.size();
    let i = 0;
    while (i < n) {
        let p = parts.get(i) ?? "";
        if (p != "") {
            if (string.startsWith(p, "{") && string.endsWith(p, "}")) {
                let inner = string.slice(p, 1, p.length - 1);
                let colon = string.indexOf(inner, ":");
                if (colon == -1) {
                    segs.push(Seg(true, inner, "string"));
                } else {
                    let nm = string.slice(inner, 0, colon);
                    let ty = string.slice(inner, colon + 1, inner.length);
                    segs.push(Seg(true, nm, ty));
                }
            } else {
                segs.push(Seg(false, p, ""));
            }
        }
        i = i + 1;
    }
    return segs;
}

fn pathSegs(path: string): List<string> {
    let out = List<string>();
    let parts = string.split(path, "/");
    let n = parts.size();
    let i = 0;
    while (i < n) {
        let p = parts.get(i) ?? "";
        if (p != "") { out.push(p); }
        i = i + 1;
    }
    return out;
}

fn isAllDigits(s: string): bool {
    let n = s.length;
    if (n == 0) { return false; }
    let i = 0;
    while (i < n) {
        let c = s[i];
        if (c < 48 || c > 57) { return false; }
        i = i + 1;
    }
    return true;
}

// ===========================================================================
// Response helpers.
// ===========================================================================
pub fn text(body: string): response.Response {
    let r = response.Response(Status.Ok, body);
    r.setHeader("Content-Type", "text/plain; charset=utf-8");
    return r;
}

pub fn json(body: string): response.Response {
    let r = response.Response(Status.Ok, body);
    r.setHeader("Content-Type", "application/json");
    return r;
}

pub fn html(body: string): response.Response {
    let r = response.Response(Status.Ok, body);
    r.setHeader("Content-Type", "text/html; charset=utf-8");
    return r;
}

// ===========================================================================
// MultiMapSource — a flat string->[values] ValueSource, used for both
// application/x-www-form-urlencoded and multipart/form-data bodies (repeated keys
// become arrays). Files (multipart) are exposed as their raw data string for now.
// ===========================================================================
pub struct MultiMapSource impl ValueSource {
    pub fields: Map<string, List<string>>,

    init(fields: Map<string, List<string>>) { self.fields = fields; }

    pub fn getString(self: MultiMapSource, key: string): string {
        let l = self.fields.get(key);
        if (l == undefined) { return ""; }
        return (l ?? List<string>()).get(0) ?? "";
    }
    pub fn getInt(self: MultiMapSource, key: string): long { return string.parseI64(self.getString(key)); }
    pub fn getBool(self: MultiMapSource, key: string): bool { return string.eql(self.getString(key), "true"); }
    pub fn getFloat(self: MultiMapSource, key: string): double { return string.parseFloat(self.getString(key)); }
    pub fn getDecimal(self: MultiMapSource, key: string): decimal { return decimal.fromString(self.getString(key)); }
    pub fn getChild(self: MultiMapSource, key: string): ValueSource {
        return MultiMapSource(Map<string, List<string>>(2, string.hash));
    }
    pub fn has(self: MultiMapSource, key: string): bool {
        let l = self.fields.get(key);
        if (l == undefined) { return false; }
        return true;
    }
    pub fn arrayLen(self: MultiMapSource, key: string): int {
        let l = self.fields.get(key);
        if (l == undefined) { return 0; }
        return (l ?? List<string>()).size();
    }
    pub fn itemString(self: MultiMapSource, key: string, i: int): string {
        let l = self.fields.get(key);
        if (l == undefined) { return ""; }
        return (l ?? List<string>()).get(i) ?? "";
    }
    pub fn itemInt(self: MultiMapSource, key: string, i: int): long { return string.parseI64(self.itemString(key, i)); }
    pub fn itemDecimal(self: MultiMapSource, key: string, i: int): decimal { return decimal.fromString(self.itemString(key, i)); }
    pub fn itemChild(self: MultiMapSource, key: string, i: int): ValueSource {
        return MultiMapSource(Map<string, List<string>>(2, string.hash));
    }
}

fn mmPush(m: Map<string, List<string>>, key: string, val: string): void {
    let existing = m.get(key);
    if (existing == undefined) {
        let lst = List<string>();
        lst.push(val);
        m.set(key, lst);
    } else {
        (existing ?? List<string>()).push(val);
    }
}

/// application/x-www-form-urlencoded body -> ValueSource.
pub fn formSource(body: string): MultiMapSource {
    let m = Map<string, List<string>>(16, string.hash);
    if (body != "") {
        let pairs = string.split(body, "&");
        let i = 0;
        while (i < pairs.size()) {
            let pair = pairs.get(i) ?? "";
            if (pair != "") {
                let eq = string.indexOf(pair, "=");
                if (eq == -1) {
                    mmPush(m, url.decode(pair), "");
                } else {
                    mmPush(m, url.decode(string.slice(pair, 0, eq)), url.decode(string.slice(pair, eq + 1, pair.length)));
                }
            }
            i = i + 1;
        }
    }
    return MultiMapSource(m);
}

/// multipart/form-data body -> ValueSource (text fields + file data by name).
pub fn multipartSource(contentType: string, body: string): MultiMapSource {
    let m = Map<string, List<string>>(16, string.hash);
    let parts = multipart.parseMultipart(contentType, body);
    let i = 0;
    while (i < parts.size()) {
        let p = parts.get(i) ?? multipart.Part{ name: "", filename: "", contentType: "", data: "" };
        mmPush(m, p.name, p.data);
        i = i + 1;
    }
    return MultiMapSource(m);
}

// ===========================================================================
// App — facade + async serve loop.
// ===========================================================================
pub struct App {
    pub routes: List<AppRoute>,
    pub mediator: AppMediator,
    pub static_mounts: List<static_content.StaticMount>,
    // Response cache: path -> fully-serialized response bytes, for GET paths marked cacheable.
    pub cache: Map<string, string>,
    pub cacheable: Map<string, bool>,
    // The DI container. `App()` starts with an empty provider; `app.useServices(sc)` installs a
    // configured one. Factory-registered handlers (`handleFrom<T>`) resolve their dependencies from it.
    pub provider: ServiceProvider,

    // W6 hardening knobs (per-connection). A read that stalls past `readTimeoutMs` closes the socket
    // (slow-loris protection); a header block over `maxHeaderBytes` → 431, a body over `maxBodyBytes` →
    // 413 — bounded so a peer cannot exhaust memory. Defaults are sane; tune via `configureServer`.
    pub readTimeoutMs: int,
    pub maxHeaderBytes: int,
    pub maxBodyBytes: int,

    init() {
        self.routes = List<AppRoute>();
        self.mediator = AppMediator();
        self.static_mounts = List<static_content.StaticMount>();
        self.cache = Map<string, string>(16, string.hash);
        self.cacheable = Map<string, bool>(16, string.hash);
        self.provider = ServiceCollection().buildServiceProvider();
        self.readTimeoutMs = 30000; // 30s per-read deadline
        self.maxHeaderBytes = 32768; // 32 KB header block
        self.maxBodyBytes = 1048576; // 1 MB body
    }

    /// W6: tune the per-connection hardening limits. `readTimeoutMs<=0` disables the read deadline.
    pub fn configureServer(self: App, readTimeoutMs: int, maxHeaderBytes: int, maxBodyBytes: int): void {
        self.readTimeoutMs = readTimeoutMs;
        self.maxHeaderBytes = maxHeaderBytes;
        self.maxBodyBytes = maxBodyBytes;
    }

    /// Install the DI container. Register services in a `ServiceCollection`, then hand it to the App;
    /// handlers registered with `handleFrom<T>` resolve their constructor dependencies from it.
    ///
    ///     let services = ServiceCollection();
    ///     services.addSingleton("Logger", (sp) => { return ConsoleLogger(); });
    ///     let app = App();
    ///     app.useServices(services);
    ///     app.handleFrom<GetUser>((sp) => { return GetUserHandler(sp.require("Logger") as Logger); });
    pub fn useServices(self: App, sc: ServiceCollection): void {
        self.provider = sc.buildServiceProvider();
    }

    /// Mark a GET path as cacheable: after the first request, its FULLY-SERIALIZED response bytes
    /// are memoized and served directly on subsequent requests — skipping route matching, mediator
    /// dispatch, and serialization. Use ONLY for responses that do not vary by request (static
    /// payloads, precomputed content). Dynamic/per-user responses must NOT be cached this way.
    pub fn enableCache(self: App, path: string): void {
        self.cacheable.set(path, true);
    }

    /// Response-cache lookup for a GET `path` — returns a fresh COPY of the memoized bytes, or
    /// undefined on a miss. The copy keeps ownership trivial (the map keeps its entry; the caller
    /// owns the return). The server's zero-copy loop extracts `path` straight from the receive
    /// buffer, so a HIT never builds the request string or touches Request.fromString.
    pub fn cachedCopy(self: App, path: string): string | undefined {
        let hit = self.cache.get(path);
        if (hit != undefined) {
            let hv = hit ?? "";
            return string.slice(hv, 0, hv.length);
        }
        return undefined;
    }

    /// The MISS path: parse the (already-materialized) request, dispatch, serialize, and — for a
    /// cacheable GET — store a copy for next time. `method`/`path` are passed in (the server already
    /// extracted them from the buffer) so we don't re-derive them.
    pub async fn respondMiss(self: App, raw: string, method: string, path: string): string {
        let req = request.Request.fromString(raw);
        let resp = await self.dispatch(req);

        // W7 content negotiation: if the client advertises `Accept-Encoding: gzip` and the body is
        // worth compressing (≥ 256 bytes and actually shrinks), gzip it and set `Content-Encoding: gzip`.
        // A gzipped response is client-specific, so it is NOT cached (only the plain form is).
        let ae = req.getHeader("accept-encoding") ?? "";
        let didGzip = false;
        if (string.contains(ae, "gzip") && resp.body.length >= 256) {
            let packed = gzip.compress(resp.body);
            if (packed.length > 0 && packed.length < resp.body.length) {
                resp.body = packed;
                resp.headers.set("Content-Encoding", "gzip");
                resp.headers.set("Content-Length", `${packed.length}`);
                didGzip = true;
            }
        }

        let out = resp.serialize();
        if (string.eql(method, "GET") && !didGzip) {
            if (self.cacheable.get(path) != undefined) {
                self.cache.set(path, string.slice(out, 0, out.length));
            }
        }
        return out;
    }

    /// Serve static files under `prefix` from the filesystem `dir`, fronted by an LRU cache
    /// (default 128 entries). GET requests that match no route fall through to these mounts.
    ///
    ///     app.useStatic("/static", "./wwwroot");
    pub fn useStatic(self: App, prefix: string, dir: string): void {
        self.static_mounts.push(static_content.StaticMount(prefix, dir, 128));
    }

    /// Register a handler for the request type `TReq` (MediatR IRequestHandler). The mediator key
    /// is the type name, reified by the compiler via `serde.typeName<TReq>` — the SAME key
    /// `get<TReq>`/`post<TReq>` dispatch to, so registration and routing always agree.
    ///
    ///     app.handle<GetUser>(GetUserHandler{});
    pub fn handle<TReq>(self: App, handler: MessageHandler): void {
        self.mediator.register(serde.typeName<TReq>(), handler);
    }

    /// Register a handler for `TReq` built from the DI container: the factory receives the App's
    /// `ServiceProvider` and constructs the handler, resolving its constructor dependencies. Call
    /// `useServices` first. This is the dependency-injection form of `handle`.
    ///
    ///     app.handleFrom<GetUser>((sp) => {
    ///         return GetUserHandler(sp.require("Db") as Db, sp.require("Logger") as Logger);
    ///     });
    pub fn handleFrom<TReq>(self: App, factory: (ServiceScope) -> MessageHandler): void {
        self.mediator.registerFactory(serde.typeName<TReq>(), factory);
    }


    // Verb methods do ONE thing: register a route (method + path) for the request type `TReq`. No
    // dispatch, no binding, no send — just data. Each is a REAL generic method the compiler
    // monomorphizes per TReq, so `serde.typeName<TReq>()` reifies the type name — the route key that
    // matches the handler registered by `handle<TReq>`. The request→Response flow lives entirely in
    // `dispatch` (below) and the handler.
    pub fn get<TReq>(self: App, path: string): void {
        self.routes.push(AppRoute("GET", parsePattern(path), serde.typeName<TReq>()));
    }
    pub fn post<TReq>(self: App, path: string): void {
        self.routes.push(AppRoute("POST", parsePattern(path), serde.typeName<TReq>()));
    }
    pub fn put<TReq>(self: App, path: string): void {
        self.routes.push(AppRoute("PUT", parsePattern(path), serde.typeName<TReq>()));
    }
    pub fn delete<TReq>(self: App, path: string): void {
        self.routes.push(AppRoute("DELETE", parsePattern(path), serde.typeName<TReq>()));
    }
    pub fn patch<TReq>(self: App, path: string): void {
        self.routes.push(AppRoute("PATCH", parsePattern(path), serde.typeName<TReq>()));
    }

    // Build the ValueSource for a request: JSON/form/multipart body for POST/PUT/PATCH, else the flat
    // route-param source (GET/DELETE).
    fn sourceFor(self: App, req: Request, params: Map<string, string>): ValueSource {
        if (string.eql(req.method, "POST") || string.eql(req.method, "PUT") || string.eql(req.method, "PATCH")) {
            let contentType = req.getHeader("content-type") ?? "";
            let ct = string.toLowerCase(contentType);
            if (string.indexOf(ct, "multipart/form-data") != -1) {
                return multipartSource(contentType, req.body);
            }
            if (string.indexOf(ct, "x-www-form-urlencoded") != -1) {
                return formSource(req.body);
            }
            return source.fromJson(req.body);
        }
        return source.ParamSource(params);
    }

    pub async fn dispatch(self: App, req: Request): response.Response {
        let segs = pathSegs(req.path);
        let nseg = segs.size();
        let nroutes = self.routes.size();
        let path_matched = false;
        let r = 0;
        while (r < nroutes) {
            let route = self.routes.at(r);
            if (route.segs.size() == nseg) {
                let params = Map<string, string>(8, string.hash);
                let ok = true;
                let typed_bad = false;
                let i = 0;
                while (i < nseg) {
                    let pat = route.segs.at(i);
                    let val = segs.get(i) ?? "";
                    if (pat.is_param) {
                        if (string.eql(pat.ptype, "int") && !isAllDigits(val)) {
                            typed_bad = true;
                            ok = false;
                        } else {
                            params.set(pat.text, val);
                        }
                    } else if (!string.eql(pat.text, val)) {
                        ok = false;
                    }
                    i = i + 1;
                }
                if (ok) {
                    path_matched = true;
                    if (string.eql(route.method, req.method)) {
                        // The one request→Response site: build the source, resolve the handler by the
                        // route's type key, run it. `send` is HERE, once — not in the verb methods.
                        let src = self.sourceFor(req, params);
                        return await self.mediator.send(route.key, self.provider, src);
                    }
                } else if (typed_bad && string.eql(route.method, req.method)) {
                    return response.Response(Status.BadRequest, "Bad Request: invalid path parameter");
                }
            }
            r = r + 1;
        }
        if (path_matched) {
            return response.Response(Status.MethodNotAllowed, "Method Not Allowed");
        }
        // No API route matched. For GET, try the static mounts (each serves under its URL
        // prefix from disk + LRU cache); the first that produces a Response wins.
        if (string.eql(req.method, "GET")) {
            let m = 0;
            let nm = self.static_mounts.size();
            while (m < nm) {
                let mount = self.static_mounts.at(m);
                let served = mount.serve(req.path);
                if (served != undefined) {
                    return served ?? response.Response(Status.NotFound, "Not Found");
                }
                m = m + 1;
            }
        }
        return response.Response(Status.NotFound, "Not Found");
    }

    pub fn run(self: App, port: int): void {
        // P4c share-nothing: hold all reactors alive BEFORE the block-drive so the per-reactor accept
        // loops (fanned out inside runServer) land on live reactors. The block-drive then never returns.
        asyncio.holdReactors();
        runServer(self, port);
    }
}

// ---------------------------------------------------------------------------
// Zero-copy framing helpers — operate DIRECTLY on the receive buffer (a raw address `buf`, a `long`
// so pointer arithmetic stays 64-bit; `int` would TRUNCATE the address to 32 bits) via
// bytes.read_byte / bytes.read_string, so the server loop can frame a request and look up the
// response cache WITHOUT copying the request into a Nova string. On a cache hit the only string built
// is the small `path` key; the full request is materialized only on a MISS.
// ---------------------------------------------------------------------------

// ASCII lowercase of one byte (for case-insensitive header-name matching on raw bytes).
fn lowerByte(b: int): int {
    if (b >= 65 && b <= 90) { return b + 32; }
    return b;
}

// Offset of the CRLFCRLF header terminator in buf[start, end), or -1.
fn bufFindHeaderEnd(buf: long, start: int, end: int): int {
    let i = start;
    while (i + 4 <= end) {
        if (bytes.read_byte(buf, i) == 13 && bytes.read_byte(buf, i + 1) == 10 &&
            bytes.read_byte(buf, i + 2) == 13 && bytes.read_byte(buf, i + 3) == 10) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// Case-insensitive search for `needle` (already lowercase) in buf[start, end); returns its offset or -1.
fn bufFindCI(buf: long, start: int, end: int, needle: string): int {
    let nlen = needle.length;
    if (nlen == 0) { return start; }
    let i = start;
    while (i + nlen <= end) {
        let j = 0;
        let matched = true;
        while (j < nlen) {
            if (lowerByte(bytes.read_byte(buf, i + j)) != (needle[j] as int)) { matched = false; break; }
            j = j + 1;
        }
        if (matched) { return i; }
        i = i + 1;
    }
    return -1;
}

// Content-Length value from the header bytes in buf[start, hdrEnd); 0 if absent.
fn bufContentLength(buf: long, start: int, hdrEnd: int): int {
    let idx = bufFindCI(buf, start, hdrEnd, "content-length:");
    if (idx == -1) { return 0; }
    let p = idx + 15;
    while (p < hdrEnd && bytes.read_byte(buf, p) == 32) { p = p + 1; }
    let n = 0;
    while (p < hdrEnd) {
        let c = bytes.read_byte(buf, p);
        if (c < 48 || c > 57) { break; }
        n = n * 10 + (c - 48);
        p = p + 1;
    }
    return n;
}

// W6 chunked-request support (over the zero-copy buffer). A request with `Transfer-Encoding: chunked`
// carries no Content-Length; its body is a series of [hex-size CRLF][size bytes CRLF] frames ending in
// a 0-size chunk (`0\r\n\r\n`). We accumulate until that terminator, then decode the frames into the
// real body bytes for the request pipeline.

fn bufIsChunked(buf: long, start: int, hdrEnd: int): bool {
    return bufFindCI(buf, start, hdrEnd, "transfer-encoding: chunked") != -1;
}

// Index of the next CRLF at/after `from` within [from, len), or -1.
fn bufFindCRLF(buf: long, from: int, len: int): int {
    let p = from;
    while (p + 1 < len) {
        if (bytes.read_byte(buf, p) == 13 && bytes.read_byte(buf, p + 1) == 10) { return p; }
        p = p + 1;
    }
    return -1;
}

// Parse a hex chunk-size from buf[from, to) (stops at ';' extension or any non-hex digit).
fn bufParseHex(buf: long, from: int, to: int): int {
    let v = 0;
    let p = from;
    while (p < to) {
        let c = bytes.read_byte(buf, p);
        let d = -1;
        if (c >= 48 && c <= 57) { d = c - 48; }
        else if (c >= 97 && c <= 102) { d = c - 97 + 10; }
        else if (c >= 65 && c <= 70) { d = c - 65 + 10; }
        if (d < 0) { break; }
        v = v * 16 + d;
        p = p + 1;
    }
    return v;
}

// The index just PAST the terminating 0-size chunk (`0\r\n\r\n`) within buf[start, len), or -1 if the
// chunked body is not yet fully present (need to read more).
fn bufChunkedEnd(buf: long, start: int, len: int): int {
    let p = start;
    while (p < len) {
        let lineEnd = bufFindCRLF(buf, p, len);
        if (lineEnd == -1) { return -1; }
        let size = bufParseHex(buf, p, lineEnd);
        let dataStart = lineEnd + 2;
        if (size == 0) {
            if (dataStart + 2 <= len) { return dataStart + 2; } // past the final CRLF
            return -1;
        }
        let next = dataStart + size + 2;
        if (next > len) { return -1; }
        p = next;
    }
    return -1;
}

// Decode the chunk frames in buf[start, len) into the concatenated body bytes.
fn bufDechunk(buf: long, start: int, len: int): string {
    let out = List<string>();
    let p = start;
    while (p < len) {
        let lineEnd = bufFindCRLF(buf, p, len);
        if (lineEnd == -1) { break; }
        let size = bufParseHex(buf, p, lineEnd);
        let dataStart = lineEnd + 2;
        if (size == 0) { break; }
        if (dataStart + size > len) { break; }
        out.push(bytes.read_string(buf + dataStart, size));
        p = dataStart + size + 2;
    }
    return string.join(out, "");
}

// A minimal fixed HTTP error response (W6: 413/431 caps, or a bad request), always closing.
fn errResponse(code: int, reason: string): string {
    return `HTTP/1.1 ${code} ${reason}\r\nContent-Length: 0\r\nConnection: close\r\n\r\n`;
}

// Extract (method, path) from the request line in buf[0, len) — building only two small strings,
// stripping any query. read_string(buf + off, k) copies `k` bytes from `buf + off` (64-bit add).
fn bufMethodPath(buf: long, len: int): (string, string) {
    let sp1 = -1;
    let i = 0;
    while (i < len) {
        if (bytes.read_byte(buf, i) == 32) { sp1 = i; break; }
        i = i + 1;
    }
    if (sp1 == -1) { return ("", ""); }
    let method = bytes.read_string(buf, sp1);          // [0, sp1)
    let ps = sp1 + 1;
    let pe = ps;
    while (pe < len) {
        let c = bytes.read_byte(buf, pe);
        if (c == 32 || c == 63) { break; }             // space or '?'
        pe = pe + 1;
    }
    let path = bytes.read_string(buf + ps, pe - ps);
    return (method, path);
}

async fn handleConn(app: App, client: long): int {
    let cap = 65536;
    let buf: long = bytes.alloc(cap);        // `long`: pointer arithmetic (buf + off) must stay 64-bit
    // Zero-copy framing: bytes accumulate in `buf` (valid range [0, len)); requests are framed by
    // scanning those bytes, never by building intermediate strings. HTTP/1.1 keep-alive — serve on
    // this socket until the peer closes it or sends `Connection: close`. Leftover bytes past a request
    // (a pipelined next request, or the next request arriving in the same read) are shifted to the
    // front for the next iteration.
    let len = 0;
    let alive = true;
    let tmo = app.readTimeoutMs;
    while (alive) {
        // Accumulate until the full header block is present — bounded by `maxHeaderBytes` (→ 431) and a
        // per-read deadline (a stalled peer is closed, never parked forever — slow-loris protection).
        let hdrEnd = bufFindHeaderEnd(buf, 0, len);
        while (hdrEnd == -1) {
            if (len >= app.maxHeaderBytes || len >= cap) {
                await asyncio.async_write(client, errResponse(431, "Request Header Fields Too Large"));
                alive = false;
                break;
            }
            let hn = await asyncio.async_read_deadline(client, buf + len, cap - len, tmo);
            if (hn <= 0) { alive = false; break; }   // -2 deadline, -1 error, 0 EOF
            len = len + hn;
            hdrEnd = bufFindHeaderEnd(buf, 0, len);
        }
        if (!alive) { break; }

        // Honor `Expect: 100-continue` — acknowledge so the client sends the body.
        if (bufFindCI(buf, 0, hdrEnd, "expect: 100-continue") != -1) {
            await asyncio.async_write(client, "HTTP/1.1 100 Continue\r\n\r\n");
        }

        let bodyStart = hdrEnd + 4;
        let reqEnd = bodyStart;
        let chunkedBody = "";
        let usedChunked = false;

        if (bufIsChunked(buf, 0, hdrEnd)) {
            // Chunked request: read until the 0-size terminator, bounded by `maxBodyBytes` (→ 413),
            // then decode the frames into the real body for the pipeline.
            let cend = bufChunkedEnd(buf, bodyStart, len);
            while (cend == -1) {
                if ((len - bodyStart) >= app.maxBodyBytes) {
                    await asyncio.async_write(client, errResponse(413, "Payload Too Large"));
                    alive = false;
                    break;
                }
                if (len >= cap) { alive = false; break; }
                let bn = await asyncio.async_read_deadline(client, buf + len, cap - len, tmo);
                if (bn <= 0) { alive = false; break; }
                len = len + bn;
                cend = bufChunkedEnd(buf, bodyStart, len);
            }
            if (!alive) { break; }
            chunkedBody = bufDechunk(buf, bodyStart, len);
            reqEnd = cend;
            usedChunked = true;
        } else {
            // Content-Length framing. Reject an over-cap body up front (→ 413).
            let need = bufContentLength(buf, 0, hdrEnd);
            if (need > app.maxBodyBytes) {
                await asyncio.async_write(client, errResponse(413, "Payload Too Large"));
                alive = false;
                break;
            }
            while (len - bodyStart < need) {
                if (len >= cap) { alive = false; break; }
                let bn = await asyncio.async_read_deadline(client, buf + len, cap - len, tmo);
                if (bn <= 0) { alive = false; break; }
                len = len + bn;
            }
            if (!alive) { break; }
            reqEnd = bodyStart + need;
        }
        let wantClose = bufFindCI(buf, 0, hdrEnd, "connection: close") != -1;

        // FAST PATH: (method, path) straight off the buffer; a cacheable GET hit serves a copy of the
        // memoized bytes with NO request string, NO parse, NO dispatch, NO serialize. Only a MISS
        // materializes the request (read_string over the exact request bytes) and runs the pipeline.
        let (method, path) = bufMethodPath(buf, len);
        let out = "";
        let served = false;
        if (string.eql(method, "GET") && !usedChunked) {
            let c = app.cachedCopy(path);
            if (c != undefined) { out = c ?? ""; served = true; }
        }
        if (!served) {
            // A chunked request is re-presented as a plain header block + DECODED body so the pipeline
            // (which parses `raw`) sees the real bytes; a Content-Length request slices the buffer.
            let raw = if (usedChunked)
                bytes.read_string(buf, hdrEnd) + "\r\n\r\n" + chunkedBody
            else
                bytes.read_string(buf, reqEnd);
            out = await app.respondMiss(raw, method, path);
        }
        await asyncio.async_write(client, out);

        // Shift any leftover bytes (a pipelined next request) to the front of the buffer.
        let leftover = len - reqEnd;
        if (leftover > 0) {
            let k = 0;
            while (k < leftover) {
                bytes.write_byte(buf, k, bytes.read_byte(buf, reqEnd + k));
                k = k + 1;
            }
        }
        len = leftover;

        if (wantClose) { alive = false; }
    }
    asyncio.aclose(client);
    bytes.free(buf);
    return 0;
}

// One reactor's accept loop: bind a SO_REUSEPORT acceptor on THIS reactor (the runtime routes the
// acceptor + accepted sockets to the current reactor), then accept + spawn a handler per connection.
// Handlers stay on the accepting reactor → its per-reactor connection pools reuse safely.
async fn acceptLoop(app: App, port: int): int {
    let srv = asyncio.serverListen(port);
    if (srv == 0) {
        console.log("Nova web: failed to bind port (in use?)");
        return -1;
    }
    while (true) {
        let client = await asyncio.aaccept(srv);
        spawn handleConn(app, client);
    }
    return 0;
}

// P4c share-nothing accept fan-out: one accept loop per reactor. ASYNC (so it can `spawn`); reached
// via app.run's block-drive AFTER holdReactors has kept all reactors alive. Reactors 1..N-1 each get a
// spawned accept loop pinned to them; reactor 0 runs its accept loop INLINE (never returns → the whole
// server stays live). The kernel load-balances new connections across the N per-reactor SO_REUSEPORT
// acceptors (nginx model) → real multi-core, no cross-reactor socket sharing.
async fn runServer(app: App, port: int): int {
    let n = asyncio.reactorCount();
    let i = 1;
    while (i < n) {
        asyncio.pinNextCoro(i);        // the next spawn lands on reactor i
        spawn acceptLoop(app, port);
        i = i + 1;
    }
    console.log("Nova web server listening (share-nothing)");
    return await acceptLoop(app, port); // reactor 0's accept loop, inline — never returns
}

// ---- W6 hardening: offline unit tests for the chunked-request codec ----------------------------
@test
fn test_chunked_request_decode(): void {
    // "Wiki" + "pedia" over two chunks, then the 0-size terminator.
    let s = "4\r\nWiki\r\n5\r\npedia\r\n0\r\n\r\n";
    let n = s.length;
    let buf: long = bytes.alloc(n);
    let i = 0;
    while (i < n) { bytes.write_byte(buf, i, s[i]); i = i + 1; }
    assert.equalInt(bufChunkedEnd(buf, 0, n), n);       // complete → past the terminator
    assert.equalStr(bufDechunk(buf, 0, n), "Wikipedia");
    assert.equalInt(bufChunkedEnd(buf, 0, n - 4), -1);  // truncated → not yet complete
    assert.equalInt(bufParseHex(buf, 0, 1), 4);         // hex size line parse
    bytes.free(buf);
}
