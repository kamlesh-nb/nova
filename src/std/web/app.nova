
import net.asyncio;
import net.asynctls;
import net.reactor;
import net.reactorio;
import os.sys;
import io.file;
import web.request;
import web.response;
import web.status;
import serde.source;
import web.static_content;
import web.di;
import web.mediator;
import compress.gzip;
import string;
import list;
import map;
import bytes;
import assert;

// The request-dispatch mediator lives in web.mediator (MessageHandler + the async pipeline). The App
// composes it; it no longer declares its own. `text`/`json`/`html` response helpers also live there,
// and the thin wrappers below delegate to them so `app.text/json/html` keeps working.

pub struct Seg {
    pub is_param: bool,
    pub text: string,
    pub ptype: string,

    init(is_param: bool, text: string, ptype: string) {
        self.is_param = is_param;
        self.text = text;
        self.ptype = ptype;
    }
}

pub struct AppRoute {
    pub method: string,
    pub segs: List<Seg>,

    pub key: string,

    init(method: string, segs: List<Seg>, key: string) {
        self.method = method;
        self.segs = segs;
        self.key = key;
    }
}

fn parsePattern(path: string): List<Seg> {
    let segs = List<Seg>();
    let parts = string.split(path, "/");
    let n = parts.size();
    let i = 0;
    while (i < n) {
        let p = parts.get(i) ?? "";
        if (p != "") {
            if (string.startsWith(p, "{") && string.endsWith(p, "}")) {
                let inner = string.slice(p, 1, p.length - 1);
                let colon = string.indexOf(inner, ":");
                if (colon == -1) {
                    segs.push(Seg(true, inner, "string"));
                } else {
                    let nm = string.slice(inner, 0, colon);
                    let ty = string.slice(inner, colon + 1, inner.length);
                    segs.push(Seg(true, nm, ty));
                }
            } else {
                segs.push(Seg(false, p, ""));
            }
        }
        i = i + 1;
    }
    return segs;
}

// Path parsing (pathSegs / isAllDigits) and request-body parsing (MultiMapSource / formSource /
// multipartSource) now live in web.request -- it is request parsing, not app logic. The App calls them
// qualified as `request.*` below.

// `text`/`json`/`html` response helpers live in web.mediator (their single definition). Because
// web.app imports web.mediator, they remain in scope for any module that imports web.app -- so a bare
// `json(...)` in a handler still resolves, with no duplicate definition to make it ambiguous.

pub struct App {
    pub routes: List<AppRoute>,
    pub mediator: mediator.Mediator,
    pub static_mounts: List<static_content.StaticMount>,

    pub cache: Map<string, string>,
    pub cacheable: Map<string, bool>,

    pub provider: ServiceProvider,

    pub readTimeoutMs: int,
    pub maxHeaderBytes: int,
    pub maxBodyBytes: int,

    pub tlsEnabled: bool,
    pub tlsCert: string,
    pub tlsKey: string,

    // Port for the multi-core reactor server. Carried on the App so the reactor worker closure needs
    // only a single capture (the App); see runReactorMC.
    pub serverPort: int,

    init() {
        self.routes = List<AppRoute>();
        self.mediator = mediator.Mediator();
        self.static_mounts = List<static_content.StaticMount>();
        self.cache = Map<string, string>(16, string.hash);
        self.cacheable = Map<string, bool>(16, string.hash);
        self.provider = ServiceCollection().buildServiceProvider();
        self.readTimeoutMs = 30000;
        self.maxHeaderBytes = 32768;
        self.maxBodyBytes = 1048576;
        self.tlsEnabled = false;
        self.tlsCert = "";
        self.tlsKey = "";
        self.serverPort = 0;
    }

    pub fn useTls(self: App, certPath: string, keyPath: string): void {
        let cert = File.readText(certPath);
        let key = File.readText(keyPath);
        if (cert.length > 0 && key.length > 0) {
            self.tlsCert = cert;
            self.tlsKey = key;
            self.tlsEnabled = true;
        }
    }

    pub fn configureServer(self: App, readTimeoutMs: int, maxHeaderBytes: int, maxBodyBytes: int): void {
        self.readTimeoutMs = readTimeoutMs;
        self.maxHeaderBytes = maxHeaderBytes;
        self.maxBodyBytes = maxBodyBytes;
    }

    pub fn useServices(self: App, sc: ServiceCollection): void {
        self.provider = sc.buildServiceProvider();
    }

    pub fn enableCache(self: App, path: string): void {
        self.cacheable.set(path, true);
    }

    pub fn cachedCopy(self: App, path: string): string | undefined {
        let hit = self.cache.get(path);
        if (hit != undefined) {
            let hv = hit ?? "";
            return string.slice(hv, 0, hv.length);
        }
        return undefined;
    }

    pub async fn respondMiss(self: App, raw: string, method: string, path: string): string {
        let req = request.Request.fromString(raw);
        let resp = await self.dispatch(req);

        let ae = req.getHeader("accept-encoding") ?? "";
        let didGzip = false;
        if (string.contains(ae, "gzip") && resp.body.length >= 256) {
            let packed = gzip.compress(resp.body);
            if (packed.length > 0 && packed.length < resp.body.length) {
                resp.body = packed;
                resp.headers.set("Content-Encoding", "gzip");
                resp.headers.set("Content-Length", `${packed.length}`);
                didGzip = true;
            }
        }

        let out = resp.serialize();
        if (string.eql(method, "GET") && !didGzip) {
            if (self.cacheable.get(path) != undefined) {
                self.cache.set(path, string.slice(out, 0, out.length));
            }
        }
        return out;
    }

    pub fn useStatic(self: App, prefix: string, dir: string): void {
        self.static_mounts.push(static_content.StaticMount(prefix, dir, 128));
    }

    pub fn handle<TReq>(self: App, handler: mediator.MessageHandler): void {
        self.mediator.register(serde.typeName<TReq>(), handler);
    }

    pub fn handleFrom<TReq>(self: App, factory: (ServiceScope) -> mediator.MessageHandler): void {
        self.mediator.registerFactory(serde.typeName<TReq>(), factory);
    }

    pub fn get<TReq>(self: App, path: string): void {
        self.routes.push(AppRoute("GET", parsePattern(path), serde.typeName<TReq>()));
    }
    pub fn post<TReq>(self: App, path: string): void {
        self.routes.push(AppRoute("POST", parsePattern(path), serde.typeName<TReq>()));
    }
    pub fn put<TReq>(self: App, path: string): void {
        self.routes.push(AppRoute("PUT", parsePattern(path), serde.typeName<TReq>()));
    }
    pub fn delete<TReq>(self: App, path: string): void {
        self.routes.push(AppRoute("DELETE", parsePattern(path), serde.typeName<TReq>()));
    }
    pub fn patch<TReq>(self: App, path: string): void {
        self.routes.push(AppRoute("PATCH", parsePattern(path), serde.typeName<TReq>()));
    }

    fn sourceFor(self: App, req: Request, params: Map<string, string>): ValueSource {
        if (string.eql(req.method, "POST") || string.eql(req.method, "PUT") || string.eql(req.method, "PATCH")) {
            let contentType = req.getHeader("content-type") ?? "";
            let ct = string.toLowerCase(contentType);
            if (string.indexOf(ct, "multipart/form-data") != -1) {
                return request.multipartSource(contentType, req.body);
            }
            if (string.indexOf(ct, "x-www-form-urlencoded") != -1) {
                return request.formSource(req.body);
            }
            return source.fromJson(req.body);
        }
        return source.ParamSource(params);
    }

    pub async fn dispatch(self: App, req: Request): response.Response {
        let segs = request.pathSegs(req.path);
        let nseg = segs.size();
        let nroutes = self.routes.size();
        let path_matched = false;
        let r = 0;
        while (r < nroutes) {
            let route = self.routes.at(r);
            if (route.segs.size() == nseg) {
                let params = Map<string, string>(8, string.hash);
                let ok = true;
                let typed_bad = false;
                let i = 0;
                while (i < nseg) {
                    let pat = route.segs.at(i);
                    let val = segs.get(i) ?? "";
                    if (pat.is_param) {
                        if (string.eql(pat.ptype, "int") && !request.isAllDigits(val)) {
                            typed_bad = true;
                            ok = false;
                        } else {
                            params.set(pat.text, val);
                        }
                    } else if (!string.eql(pat.text, val)) {
                        ok = false;
                    }
                    i = i + 1;
                }
                if (ok) {
                    path_matched = true;
                    if (string.eql(route.method, req.method)) {

                        let src = self.sourceFor(req, params);
                        return await self.mediator.send(route.key, self.provider, src);
                    }
                } else if (typed_bad && string.eql(route.method, req.method)) {
                    return response.Response(Status.BadRequest, "Bad Request: invalid path parameter");
                }
            }
            r = r + 1;
        }
        if (path_matched) {
            return response.Response(Status.MethodNotAllowed, "Method Not Allowed");
        }

        if (string.eql(req.method, "GET")) {
            let m = 0;
            let nm = self.static_mounts.size();
            while (m < nm) {
                let mount = self.static_mounts.at(m);
                let served = mount.serve(req.path);
                if (served != undefined) {
                    return served ?? response.Response(Status.NotFound, "Not Found");
                }
                m = m + 1;
            }
        }
        return response.Response(Status.NotFound, "Not Found");
    }

    pub fn run(self: App, port: int): void {
        // The web server runs on the Nova reactor, share-nothing across the available cores, TLS
        // included (serveReactorConn tlsAccepts when useTls is set). No Asio: the previous NOVA_ASIO
        // fallback is retired now that the reactor path carries the whole server (M4).
        let workers = asyncio.reactorCount();
        let n = if (workers < 1) 1 else workers;
        self.runReactorMC(port, n);
    }
}

// HTTP wire framing (bufFindHeaderEnd / bufFindCI / bufContentLength / bufIsChunked / bufChunkedEnd /
// bufDechunk / bufMethodPath) now lives in web.request -- it is request parsing, not app logic. The
// server reader below calls it qualified as `request.*`. Only errResponse (a canned error REPLY, a
// response concern) stays here with the server.
fn errResponse(code: int, reason: string): string {
    return `HTTP/1.1 ${code} ${reason}\r\nContent-Length: 0\r\nConnection: close\r\n\r\n`;
}

async fn handleConn(app: App, io: AsyncIO): int {
    let cap = 65536;
    let buf: long = bytes.alloc(cap);

    let len = 0;
    let alive = true;
    let tmo = app.readTimeoutMs;

    let _ = io.setTimeout(tmo);
    while (alive) {

        let hdrEnd = request.bufFindHeaderEnd(buf, 0, len);
        while (hdrEnd == -1) {
            if (len >= app.maxHeaderBytes || len >= cap) {
                await io.sendStr(errResponse(431, "Request Header Fields Too Large"));
                alive = false;
                break;
            }
            let hn = await io.recvInto(buf + len, cap - len);
            if (hn <= 0) { alive = false; break; }
            len = len + hn;
            hdrEnd = request.bufFindHeaderEnd(buf, 0, len);
        }
        if (!alive) { break; }

        if (request.bufFindCI(buf, 0, hdrEnd, "expect: 100-continue") != -1) {
            await io.sendStr("HTTP/1.1 100 Continue\r\n\r\n");
        }

        let bodyStart = hdrEnd + 4;
        let reqEnd = bodyStart;
        let chunkedBody = "";
        let usedChunked = false;

        if (request.bufIsChunked(buf, 0, hdrEnd)) {

            let cend = request.bufChunkedEnd(buf, bodyStart, len);
            while (cend == -1) {
                if ((len - bodyStart) >= app.maxBodyBytes) {
                    await io.sendStr(errResponse(413, "Payload Too Large"));
                    alive = false;
                    break;
                }
                if (len >= cap) { alive = false; break; }
                let bn = await io.recvInto(buf + len, cap - len);
                if (bn <= 0) { alive = false; break; }
                len = len + bn;
                cend = request.bufChunkedEnd(buf, bodyStart, len);
            }
            if (!alive) { break; }
            chunkedBody = request.bufDechunk(buf, bodyStart, len);
            reqEnd = cend;
            usedChunked = true;
        } else {

            let need = request.bufContentLength(buf, 0, hdrEnd);
            if (need > app.maxBodyBytes) {
                await io.sendStr(errResponse(413, "Payload Too Large"));
                alive = false;
                break;
            }
            while (len - bodyStart < need) {
                if (len >= cap) { alive = false; break; }
                let bn = await io.recvInto(buf + len, cap - len);
                if (bn <= 0) { alive = false; break; }
                len = len + bn;
            }
            if (!alive) { break; }
            reqEnd = bodyStart + need;
        }
        let wantClose = request.bufFindCI(buf, 0, hdrEnd, "connection: close") != -1;

        let (method, path) = request.bufMethodPath(buf, len);
        let out = "";
        let served = false;
        if (string.eql(method, "GET") && !usedChunked) {
            let c = app.cachedCopy(path);
            if (c != undefined) { out = c ?? ""; served = true; }
        }
        if (!served) {

            let raw = if (usedChunked)
                bytes.read_string(buf, hdrEnd) + "\r\n\r\n" + chunkedBody
            else
                bytes.read_string(buf, reqEnd);
            out = await app.respondMiss(raw, method, path);
        }
        await io.sendStr(out);

        let leftover = len - reqEnd;
        if (leftover > 0) {
            let k = 0;
            while (k < leftover) {
                bytes.write_byte(buf, k, bytes.read_byte(buf, reqEnd + k));
                k = k + 1;
            }
        }
        len = leftover;

        if (wantClose) { alive = false; }
    }
    io.close();
    bytes.free(buf);
    return 0;
}


// Handle one connection on the Nova reactor (M2 of the C++ runtime retirement plan): wrap the
// accepted fd in a reactor-native AsyncStream (kq set) and run the same request pipeline as the
// Asio path. Because handleConn takes the AsyncIO trait and AsyncStream is reactor-native when kq>0,
// the whole request (parse, mediator, handler, response, and any await to a reactor-native database
// connection) runs on the reactor with no Asio.
pub async fn serveReactorConn(app: App, fd: int, kq: int): int {
    let s = asyncio.AsyncStream(fd as long);
    s.kq = kq;
    if (app.tlsEnabled) {
        // Inbound TLS on the reactor: the pure-Nova TLS 1.3 memory-BIO (TlsStream over net/tlsmembio) does its socket I/O
        // through the reactor-native AsyncStream, so the handshake and data path run on the reactor,
        // no Asio. TlsStream itself is an AsyncIO, so handleConn is unchanged.
        let tls = await asynctls.tlsAccept(s, app.tlsCert, app.tlsKey);
        if (!tls.ok()) {
            tls.close();
            return -1;
        }
        return await handleConn(app, tls);
    }
    return await handleConn(app, s);
}

// Accept loop as a reactor coroutine (completion model): await one accepted connection at a time and
// spawn a serve coroutine for it. This replaces the old inline "listener readable -> drain backlog"
// branch, so the reactor's poll loop is uniform (every ready item is just a coroutine to resume) and
// maps directly onto IOCP AcceptEx. Loops forever.
async fn reactorAcceptLoop(app: App, lfd: int, kq: int): void {
    while (true) {
        let s = await reactorio.reactorAccept(lfd, kq);
        if (s.isOpen()) {
            coroStart(serveReactorConn(app, s.fdOf(), kq));
        }
    }
}

// One reactor worker thread: its own reactor, its own SO_REUSEPORT listener on the shared port (the
// kernel load-balances connections across the threads), its own coroutines. Share-nothing: the only
// thing crossing threads is the App configuration, which is read-only during serving. Loops forever.
fn reactorWorkerBody(app: App, idx: int): void {
    let lfd = sys.socket(sys.AF_INET, sys.SOCK_STREAM, 0);
    let one = bytes.alloc(4);
    bytes.write_i32(one, 0, 1);
    sys.setsockopt(lfd, sys.SOL_SOCKET(), 4, one, 4);   // SO_REUSEADDR
    sys.setReusePort(lfd);
    bytes.free(one);
    let sa = sys.makeSockaddrIn(app.serverPort, 0);
    if (sys.bind(lfd, sa, 16) != 0) {
        bytes.free(sa);
        return;
    }
    bytes.free(sa);
    sys.listen(lfd, 512);
    sys.setNonBlocking(lfd);

    let r = reactor.Reactor(1024, 16384, 1024);
    reactor.setCurrent(r.kq);
    coroStart(reactorAcceptLoop(app, lfd, r.kq));

    while (true) {
        let n = r.pollComplete(-1);
        reactor.batchBegin();
        let i = 0;
        while (i < n) {
            nova_reactor_resume(r.completedToken(i));
            i = i + 1;
        }
    }
}

// Run the web server share-nothing across `workers` Nova reactor threads (no Asio), one reactor per
// thread with a SO_REUSEPORT listener on `port`. The worker closure carries only the App (a single
// capture; the port rides on the App), because a lambda passed to runReactors resolves just its first
// capture. Blocks until the workers return (they loop forever).
pub fn runReactorMC(self: App, port: int, workers: int): void {
    self.serverPort = port;
    let srv = self;
    reactor.runReactors(workers, (idx) => {
        reactorWorkerBody(srv, idx);
    });
}

// Run the web server on a single Nova reactor (no Asio). Opt-in via runReactor; the default run()
// keeps the Asio path. Each accepted connection becomes a coroutine driven by the reactor.
pub fn runReactor(self: App, port: int): void {
    let lfd = sys.socket(sys.AF_INET, sys.SOCK_STREAM, 0);
    let one = bytes.alloc(4);
    bytes.write_i32(one, 0, 1);
    sys.setsockopt(lfd, sys.SOL_SOCKET(), 4, one, 4);   // SO_REUSEADDR
    bytes.free(one);
    let sa = sys.makeSockaddrIn(port, 0);
    if (sys.bind(lfd, sa, 16) != 0) {
        bytes.free(sa);
        console.log("Nova web: failed to bind port (in use?)");
        return;
    }
    bytes.free(sa);
    sys.listen(lfd, 512);
    sys.setNonBlocking(lfd);

    let r = reactor.Reactor(1024, 16384, 1024);
    reactor.setCurrent(r.kq);
    coroStart(reactorAcceptLoop(self, lfd, r.kq));
    console.log("Nova web server listening (Nova reactor)");

    while (true) {
        let n = r.pollComplete(-1);
        reactor.batchBegin();
        let i = 0;
        while (i < n) {
            nova_reactor_resume(r.completedToken(i));
            i = i + 1;
        }
    }
}

