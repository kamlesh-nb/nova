
import string;
import list;
import map;
import bytes;
import assert;
import os.sys;
import collections.string_builder;
import web.status;
import web.request;
import compress.gzip;

// memchr (SIMD-backed) delimiter scan, shared shape with web/request. Response.parse uses it for the
// client side (parsing responses from external calls); serialize builds into one StringBuilder buffer
// instead of a List<string> + join + concat chain.
fn idxByte(buf: long, start: int, end: int, b: int): int {
    if (start >= end) { return -1; }
    let p = sys.memchr(buf + (start as long), b, (end - start) as long);
    if (p == 0) { return -1; }
    return (p - buf) as int;
}

// case-insensitive ASCII equality, no allocation.
fn ciEquals(a: string, b: string): bool {
    if (a.length != b.length) { return false; }
    let i = 0;
    while (i < a.length) {
        let ca = a[i];
        let cb = b[i];
        if (ca >= 65 && ca <= 90) { ca = ca + 32; }
        if (cb >= 65 && cb <= 90) { cb = cb + 32; }
        if (ca != cb) { return false; }
        i = i + 1;
    }
    return true;
}

pub struct Response {
    pub status: Status,
    pub body: string,
    pub headers: Map<string, string>,
    pub cookies: Map<string, string>,

    init(stat: Status, body: string) {
        self.status = stat;
        self.body = body;
        self.headers = Map<string, string>(16, string.hash);
        self.cookies = Map<string, string>(16, string.hash);
    }

    pub fn ok(body: string): Response {
        return Response(Status.Ok, body);
    }

    pub fn withHeaders(stat: Status, body: string, headers: Map<string, string>): Response {
        let cookies = Map<string, string>(16, string.hash);
        return Response{
            status: stat,
            body: body,
            headers: headers,
            cookies: cookies,
        };
    }

    pub fn setHeader(self: Response, key: string, value: string): Response {
        self.headers.set(key, value);
        return self;
    }

    pub fn setCookie(self: Response, name: string, value: string): Response {
        self.cookies.set(name, value);
        return self;
    }

    pub fn getHeader(self: Response, name: string): string | undefined {
        let keys = self.headers.keys();
        let keysLen = keys.size();
        let i = 0;
        while (i < keysLen) {
            let key = keys.get(i) ?? "";
            if (ciEquals(key, name)) {
                return self.headers.get(key);
            }
            i = i + 1;
        }
        return undefined;
    }

    pub fn serialize(self: Response): string {
        if (self.headers.get("Content-Length") == undefined) {
            self.headers.set("Content-Length", intToStr(self.body.length));
        }

        // one growable buffer, no List/join/concat chain
        let sb = string_builder.StringBuilder();
        sb.append("HTTP/1.1 ");
        sb.append(intToStr(Status.toCode(self.status)));
        sb.append(" ");
        sb.append(Status.reasonPhrase(self.status));
        sb.append("\r\n");
        self.headers.forEach((key, value) => {
            sb.append(key);
            sb.append(": ");
            sb.append(value);
            sb.append("\r\n");
        });
        self.cookies.forEach((key, value) => {
            sb.append("Set-Cookie: ");
            sb.append(key);
            sb.append("=");
            sb.append(value);
            sb.append("; Path=/\r\n");
        });
        sb.append("\r\n");
        sb.append(self.body);
        return sb.toString();
    }

    // Parse a raw HTTP/1 response (client side: external calls). memchr offset scan, no split/join.
    pub fn parse(raw: string): Response {
        let n = raw.length;
        let buf = raw as long;

        let eol = idxByte(buf, 0, n, 13); // CR ending the status line
        if (eol < 0) { return Response(Status.Ok, ""); }

        // status line: HTTP/1.1 CODE REASON
        let sp1 = idxByte(buf, 0, eol, 32);
        let code = 200;
        if (sp1 >= 0) {
            let sp2 = idxByte(buf, sp1 + 1, eol, 32);
            let code_end = if (sp2 >= 0) sp2 else eol;
            code = string.parseI64(string.slice(raw, sp1 + 1, code_end)) as int;
        }
        let stat = Status.fromCode(code);

        let pos = eol + 2;
        let headers = Map<string, string>(16, string.hash);
        while (pos < n) {
            if (bytes.read_byte(buf, pos) as int == 13) { // blank line -> end of headers
                pos = pos + 2;
                break;
            }
            let line_end = idxByte(buf, pos, n, 13);
            if (line_end < 0) { break; }
            let colon = idxByte(buf, pos, line_end, 58);
            if (colon >= 0) {
                let key = string.slice(raw, pos, colon);
                let v_off = colon + 1;
                while (v_off < line_end && (bytes.read_byte(buf, v_off) as int == 32)) {
                    v_off = v_off + 1;
                }
                let val = string.slice(raw, v_off, line_end);
                headers.set(key, val);
            }
            pos = line_end + 2;
        }

        let body = if (pos <= n) string.slice(raw, pos, n) else "";

        // Decode the transfer/content encodings so callers see the actual payload. Chunked framing is
        // decoded with the same engine the server read path uses (request.bufDechunk over the body's
        // bytes); a gzip Content-Encoding is then inflated. A string's bytes are addressable via
        // `body as long`, so no copy into a separate buffer is needed.
        let te = decodedHeader(headers, "transfer-encoding");
        if (string.contains(te, "chunked")) {
            body = request.bufDechunk(body as long, 0, body.length);
        }
        let ce = decodedHeader(headers, "content-encoding");
        if (string.contains(ce, "gzip")) {
            body = gzip.decompress(body);
        }
        return Response.withHeaders(stat, body, headers);
    }
}

// Case-insensitive header lookup returning a lowercased value (or ""), for content-negotiation checks.
fn decodedHeader(headers: Map<string, string>, name: string): string {
    let keys = headers.keys();
    let i = 0;
    while (i < keys.size()) {
        let k = keys.get(i) ?? "";
        if (ciEquals(k, name)) { return string.toLowerCase(headers.get(k) ?? ""); }
        i = i + 1;
    }
    return "";
}

@test
fn test_parse_content_length(): void {
    let raw = "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 5\r\n\r\nhello";
    let r = Response.parse(raw);
    assert.equalInt(Status.toCode(r.status), 200);
    assert.equalStr(r.body, "hello");
    assert.equalStr(r.getHeader("Content-Type") ?? "", "text/plain");
}

@test
fn test_parse_chunked(): void {
    let raw = "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n4\r\nWiki\r\n5\r\npedia\r\n0\r\n\r\n";
    let r = Response.parse(raw);
    assert.equalInt(Status.toCode(r.status), 200);
    assert.equalStr(r.body, "Wikipedia");
}

fn intToStr(val: int): string {
    if (val == 0) return "0";
    let temp = val;
    let digits = 0;
    while (temp > 0) {
        digits = digits + 1;
        temp = temp / 10;
    }

    let str_ptr = bytes.alloc(digits);
    let i = digits - 1;
    temp = val;
    while (i >= 0) {
        bytes.write_byte(str_ptr, i, (temp % 10) + 48);
        temp = temp / 10;
        i = i - 1;
    }
    return str_ptr as string;
}
