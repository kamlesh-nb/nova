
import bytes;
import assert;
import mem.allocator;
import string;
import list;
import map;
import net.tcp.client;
import net.tcp.stream;
import net.tlsmembio;
import crypto.tls.truststore;
import net.url;
import compress.gzip;
import serde.source;
import web.request;
import web.response;
import web.status;

pub struct HttpClient {

    pub fn get(host: string, port: int, path: string): response.Response {
        let headers = Map<string, string>(16, string.hash);
        headers.set("Host", host);
        let req = request.Request{
            method: "GET",
            path: path,
            query: Map<string, string>(16, string.hash),
            headers: headers,
            cookies: Map<string, string>(16, string.hash),
            body: "",
        };
        return HttpClient.send(host, port, req);
    }

    pub fn post(host: string, port: int, path: string, body: string): response.Response {
        let headers = Map<string, string>(16, string.hash);
        headers.set("Host", host);
        headers.set("Content-Length", `${body.length}`);
        let req = request.Request{
            method: "POST",
            path: path,
            query: Map<string, string>(16, string.hash),
            headers: headers,
            cookies: Map<string, string>(16, string.hash),
            body: body,
        };
        return HttpClient.send(host, port, req);
    }

    pub fn send(host: string, port: int, req: request.Request): response.Response {
        let stream = client.TcpClient.connect(host, port);
        if (stream.fd < 0) {
            return response.Response(Status.InternalServerError, "Connection failed");
        }

        let request_line = req.method + " " + req.path + " HTTP/1.1\r\n";

        if (req.headers.get("Host") == undefined) {
            req.headers.set("Host", host);
        }

        req.headers.set("Connection", "close");

        let header_lines = List<string>();
        req.headers.forEach((key, value) => {
            header_lines.push(key + ": " + value);
        });
        let headers_str = string.join(header_lines, "\r\n");

        let full_request = request_line + headers_str + "\r\n\r\n" + req.body;
        stream.write(full_request);

        let raw_response = stream.readAll(65536);
        stream.close();

        return response.Response.parse(raw_response);
    }
}

fn cliBufToStr(buf: ptr, n: int): string {
    if (n <= 0) { return ""; }
    let out = bytes.alloc(n);
    let i = 0;
    while (i < n) { bytes.write_byte(out, i, bytes.read_byte(buf, i)); i = i + 1; }
    return out as string;
}

// A blocking HTTP connection. When `secure`, TLS runs in pure Nova: the ClientBio (net/tlsmembio, TLS
// 1.3) is pumped over the raw socket with nova_socket_send/recv. No wolfSSL. The handshake authenticates
// the peer; chain-to-CA trust is a separate policy layer (verifyServerChain + a trust store).
struct HttpConn {
    pub secure: bool,
    pub fd: int,
    pub bio: tlsmembio.TlsBio,
    pub scratch: ptr,
    pub cap: int,

    fn tlsFlush(self: HttpConn): void {
        while (self.bio.pendingOut() > 0) {
            let n = self.bio.pull(self.scratch, self.cap);
            if (n <= 0) { return; }
            // Ciphertext is binary (may contain NUL): send exactly n bytes from the buffer pointer.
            stream.sendBytes(self.fd, self.scratch, n);
        }
    }

    fn tlsHandshake(self: HttpConn): int {
        while (true) {
            let st = self.bio.step();
            self.tlsFlush();
            if (st == 0) { return 0; }
            if (st < 0) { return 0 - 1; }
            let n = stream.recvBytes(self.fd, self.scratch, self.cap);
            if (n <= 0) { return 0 - 1; }
            self.bio.feed(self.scratch, n);
        }
        return 0 - 1;
    }

    fn writeStr(self: HttpConn, data: string): int {
        if (self.secure) {
            self.bio.writeApp(data as ptr, data.length);
            self.tlsFlush();
            return data.length;
        }
        return stream.sendStr(self.fd, data);
    }

    fn recv(self: HttpConn, max: int): string {
        if (self.secure) {
            let out = bytes.alloc(max);
            while (true) {
                let pl = self.bio.readApp(out, max);
                if (pl > 0) { let s = cliBufToStr(out, pl); bytes.free(out); return s; }
                if (pl < 0) { bytes.free(out); return ""; }
                let n = stream.recvBytes(self.fd, self.scratch, self.cap);
                if (n <= 0) { bytes.free(out); return ""; }
                self.bio.feed(self.scratch, n);
            }
            bytes.free(out);
            return "";
        }
        let buf = bytes.alloc(max);
        let n = stream.recvBytes(self.fd, buf, max);
        if (n <= 0) { bytes.free(buf); return ""; }
        let sp = cliBufToStr(buf, n);
        bytes.free(buf);
        return sp;
    }

    fn close(self: HttpConn): void {
        self.bio.closeBio();
        bytes.free(self.scratch);
        if (self.fd >= 0) { stream.closeFd(self.fd); self.fd = -1; }
    }
}

struct RawResp {
    pub code: int,
    pub headers: Map<string, string>,
    pub body: string,
}

fn parseHex(s: string): int {
    let v = 0;
    let i = 0;
    while (i < s.length) {
        let c = s[i];
        let d = -1;
        if (c >= 48 && c <= 57) { d = c - 48; }
        else if (c >= 97 && c <= 102) { d = c - 97 + 10; }
        else if (c >= 65 && c <= 70) { d = c - 65 + 10; }
        if (d < 0) { break; }
        v = v * 16 + d;
        i = i + 1;
    }
    return v;
}

fn dechunk(s: string): string {
    let out = List<string>();
    let pos = 0;
    while (pos < s.length) {
        let rest = string.slice(s, pos, s.length);
        let nl = string.indexOf(rest, "\r\n");
        if (nl == -1) { break; }
        let sizeLine = string.slice(s, pos, pos + nl);
        let size = parseHex(sizeLine);
        pos = pos + nl + 2;
        if (size == 0) { break; }
        if (pos + size > s.length) { break; }
        out.push(string.slice(s, pos, pos + size));
        pos = pos + size + 2;
    }
    return string.join(out, "");
}

fn frame(raw: string): RawResp {
    let headers = Map<string, string>(16, string.hash);
    let sep = string.indexOf(raw, "\r\n\r\n");
    let headPart = if (sep == -1) raw else string.slice(raw, 0, sep);
    let bodyRaw = if (sep == -1) "" else string.slice(raw, sep + 4, raw.length);

    let lines = string.split(headPart, "\r\n");
    let code = 0;
    if (lines.size() > 0) {
        let statusLine = lines.get(0) ?? "";
        let sp = string.split(statusLine, " ");
        if (sp.size() >= 2) { code = string.parseI64(sp.get(1) ?? "0") as int; }
    }
    let i = 1;
    while (i < lines.size()) {
        let line = lines.get(i) ?? "";
        let idx = string.indexOf(line, ": ");
        if (idx != -1) {
            let key = string.slice(line, 0, idx);
            let val = string.slice(line, idx + 2, line.length);
            headers.set(key, val);
        }
        i = i + 1;
    }

    let chunked = false;
    let hk = headers.keys();
    let hi = 0;
    while (hi < hk.size()) {
        let k = hk.get(hi) ?? "";
        if (string.toLowerCase(k) == "transfer-encoding") {
            if (string.contains(string.toLowerCase(headers.get(k) ?? ""), "chunked")) { chunked = true; }
        }
        hi = hi + 1;
    }
    let dechunked = if (chunked) dechunk(bodyRaw) else bodyRaw;

    let body = dechunked;
    let ci = 0;
    while (ci < hk.size()) {
        let k = hk.get(ci) ?? "";
        if (string.toLowerCase(k) == "content-encoding") {
            if (string.contains(string.toLowerCase(headers.get(k) ?? ""), "gzip")) {
                body = gzip.decompress(dechunked);
            }
        }
        ci = ci + 1;
    }
    return RawResp{ code: code, headers: headers, body: body };
}

pub struct Http {

    pub fn request(method: string, urlStr: string, headers: Map<string, string>, body: string): response.Response {
        return Http.doRequest(method, urlStr, headers, body, 0, 5, "");
    }

    pub fn requestTimeout(method: string, urlStr: string, headers: Map<string, string>, body: string, timeoutMs: int): response.Response {
        return Http.doRequest(method, urlStr, headers, body, timeoutMs, 5, "");
    }

    fn doRequest(method: string, urlStr: string, headers: Map<string, string>, body: string, timeoutMs: int, hopsLeft: int, caPem: string): response.Response {
        let u = url.parse(urlStr);

        let fd = stream.connect(u.host, u.port);
        if (fd < 0) {
            return response.Response(Status.InternalServerError, "connection failed");
        }
        if (timeoutMs > 0) { stream.setTimeout(fd, timeoutMs); }
        // When caPem is provided (and the URL is https), enforce CA trust: the server chain must validate
        // against a root in the bundle for u.host at UTC-now, or the handshake fails. The store is bound to
        // a named local so its backing lists outlive the bio (an inline temporary would be released early).
        let store = truststore.loadPemBundle(caPem);
        let bio: tlsmembio.TlsBio = if (u.secure && caPem.length > 0) tlsmembio.newClientBioVerify(u.host, store) else tlsmembio.newClientBio(u.host);
        let conn = HttpConn{ secure: u.secure, fd: fd, bio: bio, scratch: bytes.alloc(33792), cap: 33792 };
        if (u.secure) {
            if (conn.tlsHandshake() != 0) {
                conn.close();
                return response.Response(Status.InternalServerError, "TLS handshake failed");
            }
        }

        let reqLine = method + " " + u.path + " HTTP/1.1\r\n";
        let hdrs = List<string>();
        hdrs.push("Host: " + u.host);
        hdrs.push("Connection: close");
        hdrs.push("Accept-Encoding: gzip");
        if (body.length > 0) { hdrs.push(`Content-Length: ${body.length}`); }
        let sawUA = false;
        headers.forEach((k, v) => {
            hdrs.push(k + ": " + v);
            if (string.toLowerCase(k) == "user-agent") { sawUA = true; }
        });
        if (!sawUA) { hdrs.push("User-Agent: nova-http/1.0"); }
        let full = reqLine + string.join(hdrs, "\r\n") + "\r\n\r\n" + body;
        conn.writeStr(full);

        let parts = List<string>();
        while (true) {
            let chunk = conn.recv(65536);
            if (chunk.length == 0) { break; }
            parts.push(chunk);
        }
        conn.close();
        let framed = frame(string.join(parts, ""));

        if ((framed.code == 301 || framed.code == 302 || framed.code == 303 || framed.code == 307 || framed.code == 308) && hopsLeft > 0) {
            let loc = "";
            let lk = framed.headers.keys();
            let li = 0;
            while (li < lk.size()) {
                let k = lk.get(li) ?? "";
                if (string.toLowerCase(k) == "location") { loc = framed.headers.get(k) ?? ""; }
                li = li + 1;
            }
            if (loc.length > 0) {
                let nextUrl = Http.resolveLocation(u, loc);
                let keepMethod = framed.code == 307 || framed.code == 308;
                let nextMethod = if (keepMethod) method else "GET";
                let nextBody = if (keepMethod) body else "";
                return Http.doRequest(nextMethod, nextUrl, headers, nextBody, timeoutMs, hopsLeft - 1, caPem);
            }
        }

        return response.Response.withHeaders(Status.fromCode(framed.code), framed.body, framed.headers);
    }

    fn resolveLocation(base: url.Url, loc: string): string {
        if (string.contains(loc, "://")) { return loc; }
        let origin = base.scheme + "://" + base.host + ":" + `${base.port}`;
        if (string.startsWith(loc, "/")) { return origin + loc; }
        return origin + "/" + loc;
    }

    fn emptyHeaders(): Map<string, string> {
        return Map<string, string>(8, string.hash);
    }

    pub fn get(urlStr: string): response.Response {
        return Http.request("GET", urlStr, Http.emptyHeaders(), "");
    }
    pub fn post(urlStr: string, body: string): response.Response {
        return Http.request("POST", urlStr, Http.emptyHeaders(), body);
    }
    pub fn put(urlStr: string, body: string): response.Response {
        return Http.request("PUT", urlStr, Http.emptyHeaders(), body);
    }
    pub fn patch(urlStr: string, body: string): response.Response {
        return Http.request("PATCH", urlStr, Http.emptyHeaders(), body);
    }
    pub fn del(urlStr: string): response.Response {
        return Http.request("DELETE", urlStr, Http.emptyHeaders(), "");
    }
    pub fn head(urlStr: string): response.Response {
        return Http.request("HEAD", urlStr, Http.emptyHeaders(), "");
    }

    // Verified HTTPS: the server certificate chain must validate against a CA in `caPem` (a PEM bundle,
    // e.g. the system trust store, read by the caller) for the URL host at UTC-now, else the request
    // fails. This is the trust check a plain get() does not perform.
    pub fn getVerified(urlStr: string, caPem: string): response.Response {
        return Http.doRequest("GET", urlStr, Http.emptyHeaders(), "", 0, 5, caPem);
    }
    pub fn postVerified(urlStr: string, body: string, caPem: string): response.Response {
        return Http.doRequest("POST", urlStr, Http.emptyHeaders(), body, 0, 5, caPem);
    }
}

@test
fn test_dechunk(): void {

    let raw = "4\r\nWiki\r\n5\r\npedia\r\n0\r\n\r\n";
    assert.equalStr(dechunk(raw), "Wikipedia");
    assert.equalInt(parseHex("1a"), 26);
    assert.equalInt(parseHex("ff;name=x"), 255);
}

@test
fn test_frame_content_length(): void {
    let raw = "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 5\r\n\r\nhello";
    let r = frame(raw);
    assert.equalInt(r.code, 200);
    assert.equalStr(r.body, "hello");
    assert.equalStr(r.headers.get("Content-Type") ?? "", "text/plain");
}

@test
fn test_frame_chunked(): void {
    let raw = "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n4\r\nWiki\r\n5\r\npedia\r\n0\r\n\r\n";
    let r = frame(raw);
    assert.equalInt(r.code, 200);
    assert.equalStr(r.body, "Wikipedia");
}

pub fn getJson<T>(urlStr: string): T {
    let r = Http.get(urlStr);
    let src = source.fromJson(r.body);
    return serde.bind<T>(src);
}

pub fn postJson<T>(urlStr: string, jsonBody: string): T {
    let hdrs = Map<string, string>(4, string.hash);
    hdrs.set("Content-Type", "application/json");
    let r = Http.request("POST", urlStr, hdrs, jsonBody);
    let src = source.fromJson(r.body);
    return serde.bind<T>(src);
}
