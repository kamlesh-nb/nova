// url.nova — Percent-encoding and decoding utilities
import collections.string_builder;
import assert;

const HEX_CHARS = "0123456789ABCDEF";

fn isUnreserved(c: int): bool {
    if (c >= 65 && c <= 90) return true;  // A-Z
    if (c >= 97 && c <= 122) return true; // a-z
    if (c >= 48 && c <= 57) return true;  // 0-9
    if (c == 45 || c == 95 || c == 46 || c == 126) return true; // '-', '_', '.', '~'
    return false;
}

fn hexVal(c: int): int {
    if (c >= 48 && c <= 57) return c - 48; // '0'-'9'
    if (c >= 97 && c <= 102) return c - 97 + 10; // 'a'-'f'
    if (c >= 65 && c <= 70) return c - 65 + 10;  // 'A'-'F'
    return -1;
}

pub fn encode(raw: string): string {
    let sb = string_builder.StringBuilder();
    let len = raw.length;
    let i = 0;
    while (i < len) {
        let c = raw[i];
        if (isUnreserved(c)) {
            sb.appendChar(c);
        } else if (c == 32) { // ' '
            sb.appendChar(43); // '+'
        } else {
            sb.appendChar(37); // '%'
            sb.appendChar(HEX_CHARS[c >> 4]);
            sb.appendChar(HEX_CHARS[c & 15]);
        }
        i = i + 1;
    }
    let res = sb.toString();
    sb.delete();
    return res;
}

pub fn decode(encoded: string): string {
    let sb = string_builder.StringBuilder();
    let len = encoded.length;
    let i = 0;
    while (i < len) {
        let c = encoded[i];
        if (c == 37 && i + 2 < len) { // '%'
            let hi = hexVal(encoded[i + 1]);
            let lo = hexVal(encoded[i + 2]);
            if (hi != -1 && lo != -1) {
                let byte = (hi << 4) | lo;
                sb.appendChar(byte);
                i = i + 3;
                continue;
            }
        }
        if (c == 43) { // '+'
            sb.appendChar(32); // ' '
        } else {
            sb.appendChar(c);
        }
        i = i + 1;
    }
    let res = sb.toString();
    sb.delete();
    return res;
}

@test
fn test_url_encoding(): void {
    let raw = "hello world / test = + &";
    let enc = encode(raw);
    assert.isTrue(enc == "hello+world+%2F+test+%3D+%2B+%26");
    let dec = decode(enc);
    assert.isTrue(dec == raw);
}
