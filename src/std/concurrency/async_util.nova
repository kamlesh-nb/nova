
import list;
import bytes;

// `buf` is a heap ADDRESS, so it must be `long` -- typing it `int` and passing `buf as int` used to
// work only because a narrowing cast was a codegen no-op. Now that `long as int` truncates honestly,
// the address must stay 64-bit end to end (see the "addresses must be long" gotcha).
pub fn whenAny(buf: long, n: int): int { return 0; }

pub async fn selectAny<T>(fs: List<future<T>>): int {
    let n = fs.size();
    if (n <= 0) { return -1; }
    let buf = bytes.alloc(n * 8);
    let i = 0;
    while (i < n) { bytes.write_ptr(buf, i * 8, fs.at(i) as long); i = i + 1; }
    let idx = await whenAny(buf, n);
    bytes.free(buf);
    return idx;
}

pub fn whenAnyDeadline(buf: long, n: int, ms: int): int { return 0; }

pub async fn selectTimeout<T>(fs: List<future<T>>, ms: int): int {
    let n = fs.size();
    if (n <= 0) { return -2; }
    let buf = bytes.alloc(n * 8);
    let i = 0;
    while (i < n) { bytes.write_ptr(buf, i * 8, fs.at(i) as long); i = i + 1; }
    let idx = await whenAnyDeadline(buf, n, ms);
    bytes.free(buf);
    return idx;
}

pub async fn withTimeout<T>(fut: future<T>, ms: int): int {
    let buf = bytes.alloc(8);
    bytes.write_ptr(buf, 0, fut as long);
    let idx = await whenAnyDeadline(buf, 1, ms);
    bytes.free(buf);
    return idx;
}

pub async fn when_all<T>(fs: List<future<T>>): List<T> {
    let out = List<T>();
    let i = 0;
    while (i < fs.size()) {
        out.push(await fs.at(i));
        i = i + 1;
    }
    return out;
}

pub async fn wait_all<T>(fs: List<future<T>>): int {
    let i = 0;
    while (i < fs.size()) {
        let dummy = await fs.at(i);
        i = i + 1;
    }
    return fs.size();
}

pub async fn when_first_n<T>(fs: List<future<T>>, k: int): List<T> {
    let out = List<T>();
    let n = if (k < fs.size()) k else fs.size();
    let i = 0;
    while (i < n) {
        out.push(await fs.at(i));
        i = i + 1;
    }
    return out;
}
