//! Process environment access: reading and writing environment variables, and
//! reading the process's command-line arguments.
//!
//! This module is a thin, allocation-aware wrapper over the C library calls
//! surfaced through `os.sys` (`getenv`/`setenv`). `get` and `set` marshal Kyte
//! `string`s to and from NUL-terminated C strings and free the temporary C
//! buffers they create; `args` reads the arguments the runtime captured at
//! process start via the `kyte_arg_count`/`kyte_arg_at` runtime intrinsics.

import assert;
import bytes;
import mem.allocator;
import collections.list;
import os.sys;

/// Reads the environment variable `name`, returning its value.
///
/// Returns an empty string `""` when the variable is not set, so an unset
/// variable and a variable explicitly set to the empty string are
/// indistinguishable through this call.
pub fn get(name: string): string {
    let cp = sys.cstr(name);
    let v = sys.getenv(cp);
    bytes.free(cp);
    if (v == 0) {
        return "";
    }

    let clen = 0;
    while (bytes.read_byte(v, clen) != 0) {
        clen = clen + 1;
    }
    let out = allocator.globalAllocator().alloc(clen);
    let i = 0;
    while (i < clen) {
        bytes.write_byte(out, i, bytes.read_byte(v, i));
        i = i + 1;
    }
    return out as string;
}

/// Returns the process's command-line arguments as captured at start-up.
pub fn args(): list.List<string> {
    let result: list.List<string> = list.List<string>();
    let n: int = kyte_arg_count();
    for (i in 0..n) {
        result.push(kyte_arg_at(i));
    }
    return result;
}

/// Sets the environment variable `name` to `value` in the current process,
/// overwriting any existing value.
pub fn set(name: string, value: string): void {
    let cn = sys.cstr(name);
    let cv = sys.cstr(value);
    sys.setenv(cn, cv, 1);
    bytes.free(cn);
    bytes.free(cv);
}

@test
fn test_env_get_set(): void {
    set("KYTE_TEST_VAR", "hello_world_123");
    let val = get("KYTE_TEST_VAR");
    assert.isTrue(val == "hello_world_123");
    console.log("ENV TEST: KYTE_TEST_VAR = " + val);
}

@test
fn test_env_get_unset(): void {

    let missing = get("KYTE_DEFINITELY_NOT_SET_12345");
    assert.isTrue(missing == "");
    assert.isTrue(missing.length == 0);
    assert.isTrue(("[" + missing + "]") == "[]");
}
