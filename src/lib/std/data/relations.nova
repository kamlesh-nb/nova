// Relation loading for the db seam: the eager-load ("N+1 avoidance") mechanics for hasMany / belongsTo.
// Given a set of parent keys you build ONE `... WHERE fk IN ($1, ...)` query for all children, run it, then
// group the child rows by their foreign key and attach them to the parents. Values are bound (`$N`), never
// interpolated.
import string;
import list;
import map;
import data.db;

// A hasMany query: all children of the given parents in one round trip.
//   SELECT <cols> FROM <childTable> WHERE <fkCol> IN ($1, $2, ...)
// Returns (sql, params). `cols` empty -> "*".
pub fn hasManyQuery(childTable: string, fkCol: string, cols: list.List<string>, parentKeys: list.List<db.DbValue>): (string, list.List<db.DbValue>) {
    return inClause("SELECT " + colList(cols) + " FROM " + childTable + " WHERE " + fkCol + " IN (", parentKeys);
}

// A belongsTo query: the parents referenced by a set of child foreign-key values.
//   SELECT <cols> FROM <parentTable> WHERE <pkCol> IN ($1, ...)
pub fn belongsToQuery(parentTable: string, pkCol: string, cols: list.List<string>, fkKeys: list.List<db.DbValue>): (string, list.List<db.DbValue>) {
    return inClause("SELECT " + colList(cols) + " FROM " + parentTable + " WHERE " + pkCol + " IN (", fkKeys);
}

fn colList(cols: list.List<string>): string {
    if (cols.size() == 0) { return "*"; }
    let out = "";
    let i = 0;
    while (i < cols.size()) { if (i > 0) { out = out + ", "; } out = out + cols.at(i); i = i + 1; }
    return out;
}

fn inClause(prefix: string, keys: list.List<db.DbValue>): (string, list.List<db.DbValue>) {
    let params = list.List<db.DbValue>();
    let sql = prefix;
    if (keys.size() == 0) {
        return ("SELECT * FROM (SELECT 1) t WHERE 1 = 0", params);   // no parents -> empty result, no params
    }
    let i = 0;
    while (i < keys.size()) {
        if (i > 0) { sql = sql + ", "; }
        sql = sql + "$" + `${i + 1}`;
        params.push(keys.at(i));
        i = i + 1;
    }
    sql = sql + ")";
    return (sql, params);
}

// The 0-based index of a column by name in a result set (-1 if absent).
pub fn columnIndex(rs: db.ResultSet, name: string): int {
    let i = 0;
    while (i < rs.columns.size()) {
        let c = rs.columns.get(i) ?? db.Column("", db.DbType.Null);
        if (string.eql(c.name, name)) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// Group a result set's rows by the TEXT value of column `fkCol` -> Map<fkValue, List<Row>>. This is the
// attach step: after loading all children with `hasManyQuery`, group them so each parent gets its slice.
pub fn groupByColumn(rs: db.ResultSet, fkCol: string): map.Map<string, list.List<db.Row>> {
    let groups = map.Map<string, list.List<db.Row>>(16, string.hash);
    let ci = columnIndex(rs, fkCol);
    if (ci < 0) { return groups; }
    let i = 0;
    while (i < rs.rows.size()) {
        let row = rs.rows.get(i) ?? db.Row();
        let key = row.getText(ci);
        let bucket = groups.get(key) ?? list.List<db.Row>();
        bucket.push(row);
        groups.set(key, bucket);
        i = i + 1;
    }
    return groups;
}

// The child rows belonging to one parent key (empty list if none).
pub fn childrenOf(groups: map.Map<string, list.List<db.Row>>, parentKey: string): list.List<db.Row> {
    return groups.get(parentKey) ?? list.List<db.Row>();
}
