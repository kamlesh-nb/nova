import mem.rawbuffer;

pub struct List<T> {
    pub data: RawBuffer<T>,
    pub len: int,
    pub cap: int,

    init() {
        self.data = rawbuffer.RawBuffer<T>(4);
        self.len = 0;
        self.cap = 4;
    }

    pub fn push(self: List<T>, value: T): void {
        self.data.push(value);
        self.len = self.data.count();
        self.cap = self.data.capacity();
    }

    pub fn get(self: List<T>, index: int): T | undefined {
        if (index < 0 || index >= self.data.count()) {
            return undefined;
        }
        return self.data.at(index);
    }

    pub fn at(self: List<T>, index: int): T {
        if (index < 0 || index >= self.data.count()) {
            nova_panic("List.at: index out of bounds");
        }
        return self.data.at(index);
    }

    pub fn set(self: List<T>, index: int, value: T): void {
        if (index < 0 || index >= self.data.count()) {
            return;
        }
        self.data.set(index, value);
    }

    pub fn insert(self: List<T>, index: int, value: T): void {
        self.data.insertAt(index, value);
        self.len = self.data.count();
        self.cap = self.data.capacity();
    }

    pub fn remove(self: List<T>, index: int): void {
        self.data.removeAt(index);
        self.len = self.data.count();
        self.cap = self.data.capacity();
    }

    pub fn size(self: List<T>): int {
        return self.data.count();
    }

    pub fn forEach(self: List<T>, fn: (T) -> void): void {
        let i = 0;
        while (i < self.data.count()) {
            let val = self.data.at(i);
            fn(val);
            i = i + 1;
        }
    }

    pub fn map<U>(self: List<T>, fn: (T) -> U): List<U> {
        let result = List<U>();
        let i = 0;
        while (i < self.data.count()) {
            let val = self.data.at(i);
            let mapped = fn(val);
            result.push(mapped);
            i = i + 1;
        }
        return result;
    }

    pub fn filter(self: List<T>, pred: (T) -> bool): List<T> {
        let result = List<T>();
        let i = 0;
        while (i < self.data.count()) {
            let val = self.data.at(i);
            if (pred(val)) {
                result.push(val);
            }
            i = i + 1;
        }
        return result;
    }

    pub fn reduce<U>(self: List<T>, acc: U, fn: (U, T) -> U): U {
        let result = acc;
        let i = 0;
        while (i < self.data.count()) {
            let val = self.data.at(i);
            result = fn(result, val);
            i = i + 1;
        }
        return result;
    }

    pub fn reverse(self: List<T>): void {
        let i = 0;
        let j = self.data.count() - 1;
        while (i < j) {
            self.data.swap(i, j);   // ARC-neutral raw swap (a 3-`set` swap would UAF on owned elements)
            i = i + 1;
            j = j - 1;
        }
    }

    pub fn clear(self: List<T>): void {
        self.data.clear();
        self.len = 0;
    }

    pub fn first(self: List<T>): T | undefined {
        if (self.data.count() == 0) {
            return undefined;
        }
        return self.data.at(0);
    }

    pub fn last(self: List<T>): T | undefined {
        if (self.data.count() == 0) {
            return undefined;
        }
        return self.data.at(self.data.count() - 1);
    }

    pub fn pop(self: List<T>): T | undefined {
        let v = self.data.pop();
        self.len = self.data.count();
        self.cap = self.data.capacity();
        return v;
    }

    pub fn findIndex(self: List<T>, pred: (T) -> bool): int {
        let i = 0;
        while (i < self.data.count()) {
            if (pred(self.data.at(i))) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    pub fn any(self: List<T>, pred: (T) -> bool): bool {
        return self.findIndex(pred) != -1;
    }

    pub fn all(self: List<T>, pred: (T) -> bool): bool {
        let i = 0;
        while (i < self.data.count()) {
            if (!pred(self.data.at(i))) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    pub fn indexOf(self: List<T>, value: T): int {
        let i = 0;
        while (i < self.data.count()) {
            if (self.data.at(i) == value) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    pub fn contains(self: List<T>, value: T): bool {
        return self.indexOf(value) != -1;
    }

    // Deep copy: a fresh List with its own RawBuffer holding copies of every element (owned elements are
    // retained by push). Used by the compiler to give value semantics to a value struct that has a List
    // field -- a byte-copy of such a struct would otherwise share this buffer (channel 4). Reuses slice,
    // which is the proven allocate-new-buffer-and-copy path.
    pub fn copy(self: List<T>): List<T> {
        return self.slice(0, self.data.count());
    }

    pub fn slice(self: List<T>, start: int, end: int): List<T> {
        let n = self.data.count();
        let s = if (start < 0) 0 else if (start > n) n else start;
        let e = if (end < 0) 0 else if (end > n) n else end;
        let out = List<T>();
        let i = s;
        while (i < e) {
            out.push(self.data.at(i));
            i = i + 1;
        }
        return out;
    }

    pub fn concat(self: List<T>, other: List<T>): List<T> {
        let out = List<T>();
        let i = 0;
        while (i < self.data.count()) {
            out.push(self.data.at(i));
            i = i + 1;
        }
        let j = 0;
        while (j < other.size()) {
            out.push(other.at(j));
            j = j + 1;
        }
        return out;
    }

    // Sift the element at `root` down a max-heap of size `n` so the subtree rooted there satisfies the heap
    // property. Only SWAPS element handles (no temp buffer, no retain/release), so it is ARC-neutral: it just
    // reorders the same set of owned pointers, which is what keeps heapsort safe where a merge-sort scratch
    // List (whose drop would release aliased elements -> double-free) was not.
    fn heapSiftDown(self: List<T>, root: int, n: int, cmp: (T, T) -> int): void {
        let i = root;
        while (true) {
            let largest = i;
            let left = 2 * i + 1;
            let right = 2 * i + 2;
            if (left < n && cmp(self.data.at(left), self.data.at(largest)) > 0) { largest = left; }
            if (right < n && cmp(self.data.at(right), self.data.at(largest)) > 0) { largest = right; }
            if (largest == i) { return; }
            self.data.swap(i, largest);
            i = largest;
        }
    }

    // O(n log n) in-place heapsort (was insertion sort, O(n^2)). Not stable; the criterion is the complexity.
    pub fn sort(self: List<T>, cmp: (T, T) -> int): void {
        let n = self.data.count();
        if (n < 2) { return; }
        // Build a max-heap bottom-up.
        let start = n / 2 - 1;
        while (start >= 0) { self.heapSiftDown(start, n, cmp); start = start - 1; }
        // Repeatedly move the current max to the end of the unsorted region and re-heapify.
        let end = n - 1;
        while (end > 0) {
            self.data.swap(0, end);
            self.heapSiftDown(0, end, cmp);
            end = end - 1;
        }
    }

    pub fn take(self: List<T>, n: int): List<T> {
        let out = List<T>();
        let count = self.data.count();
        let lim = n;
        if (lim < 0) {
            lim = 0;
        }
        if (lim > count) {
            lim = count;
        }
        let i = 0;
        while (i < lim) {
            out.push(self.data.at(i));
            i = i + 1;
        }
        return out;
    }

    pub fn drop(self: List<T>, n: int): List<T> {
        let out = List<T>();
        let count = self.data.count();
        let start = n;
        if (start < 0) {
            start = 0;
        }
        if (start > count) {
            start = count;
        }
        let i = start;
        while (i < count) {
            out.push(self.data.at(i));
            i = i + 1;
        }
        return out;
    }

    pub fn count(self: List<T>, pred: (T) -> bool): int {
        let c = 0;
        let i = 0;
        while (i < self.data.count()) {
            if (pred(self.data.at(i))) {
                c = c + 1;
            }
            i = i + 1;
        }
        return c;
    }

    pub fn flatMap<U>(self: List<T>, fn: (T) -> List<U>): List<U> {
        let out = List<U>();
        let i = 0;
        while (i < self.data.count()) {
            let sub = fn(self.data.at(i));
            let j = 0;
            while (j < sub.size()) {
                out.push(sub.at(j));
                j = j + 1;
            }
            i = i + 1;
        }
        return out;
    }

    pub fn chunk(self: List<T>, size: int): List<List<T>> {
        let out = List<List<T>>();
        if (size <= 0) {
            return out;
        }
        let count = self.data.count();
        let i = 0;
        while (i < count) {
            let piece = List<T>();
            let j = 0;
            while (j < size && i + j < count) {
                piece.push(self.data.at(i + j));
                j = j + 1;
            }
            out.push(piece);
            i = i + size;
        }
        return out;
    }

    pub fn zip<U>(self: List<T>, other: List<U>): List<(T, U)> {
        let out = List<(T, U)>();
        let n = self.data.count();
        let m = other.size();
        let lim = n;
        if (m < lim) {
            lim = m;
        }
        let i = 0;
        while (i < lim) {
            out.push((self.data.at(i), other.at(i)));
            i = i + 1;
        }
        return out;
    }

    fn heapSiftDownBy(self: List<T>, root: int, n: int, key: (T) -> int): void {
        let i = root;
        while (true) {
            let largest = i;
            let left = 2 * i + 1;
            let right = 2 * i + 2;
            if (left < n && key(self.data.at(left)) > key(self.data.at(largest))) { largest = left; }
            if (right < n && key(self.data.at(right)) > key(self.data.at(largest))) { largest = right; }
            if (largest == i) { return; }
            self.data.swap(i, largest);
            i = largest;
        }
    }

    // O(n log n) in-place heapsort by an int key (was insertion sort, O(n^2)).
    pub fn sortBy(self: List<T>, key: (T) -> int): void {
        let n = self.data.count();
        if (n < 2) { return; }
        let start = n / 2 - 1;
        while (start >= 0) { self.heapSiftDownBy(start, n, key); start = start - 1; }
        let end = n - 1;
        while (end > 0) {
            self.data.swap(0, end);
            self.heapSiftDownBy(0, end, key);
            end = end - 1;
        }
    }
}

@test
fn test_list(): void {
    let list = List<int>();
    if (list.size() != 0) {
        nova_test_fail("list.size != 0");
    }
    list.push(10);
    list.push(20);
    list.push(30);
    if (list.size() != 3) {
        nova_test_fail("list.size != 3");
    }
    if (list.get(0) != 10) {
        nova_test_fail("list[0] != 10");
    }
}
