
import bytes;
import list;
import mem.rawbuffer;
import string;
import assert;

const TOMBSTONE_SIZE: int = 1;
const LOAD_FACTOR_MAX: float = 0.75;

// Per-slot state. Occupancy is tracked EXPLICITLY here rather than inferred from `key == 0`, so that
// a value-type key of 0 (a legal `Map<int, V>` key) is not mistaken for an empty slot. The `slots`
// byte array holds one of these for every bucket; allocZero leaves every slot EMPTY.
const SLOT_EMPTY: int = 0;
const SLOT_TOMBSTONE: int = 1;
const SLOT_OCCUPIED: int = 2;

fn allocZero(size: int): ptr {
    let ptr = bytes.alloc_persistent(size);
    let i = 0;
    while (i < size) {
        bytes.write_byte(ptr, i, 0);
        i = i + 1;
    }
    return ptr;
}

fn nextPowerOfTwo(n: int): int {
    let v = n - 1;
    v = v | (v >> 1);
    v = v | (v >> 2);
    v = v | (v >> 4);
    v = v | (v >> 8);
    v = v | (v >> 16);
    return v + 1;
}

pub class Map<K, V> {
    pub cap: int,
    pub len: int,

    pub keys: rawbuffer.RawBuffer<K>,
    pub vals: rawbuffer.RawBuffer<V>,
    pub slots: ptr,
    pub hashFn: (K) -> int,

    init(initialCap: int, hashFn: (K) -> int) {
        let cap = if (initialCap <= 0) 8 else nextPowerOfTwo(initialCap);
        let ps = bytes.ptr_size();
        self.cap = cap;
        self.len = 0;
        self.keys = rawbuffer.RawBuffer<K>(cap);
        self.keys.fill(cap);
        self.vals = rawbuffer.RawBuffer<V>(cap);
        self.vals.fill(cap);
        self.slots = allocZero(cap);
        self.hashFn = hashFn;
    }

    fn keysEqual(self: Map<K, V>, a: K, b: K): bool {
        if (self.hashFn == string.hash) {
            return string.eql(a, b);
        }
        return a == b;
    }

    pub fn set(self: Map<K, V>, key: K, value: V): void {
        if ((self.len + 1) * 4 > self.cap * 3) {
            self.resize();
        }

        let ps = bytes.ptr_size();
        let hash = (self.hashFn)(key);
        let idx = hash & (self.cap - 1);
        let startIdx = idx;
        let firstTombstone = -1;

        while (true) {
            let state = bytes.read_byte(self.slots, idx);
            if (state == SLOT_EMPTY) {
                let insertIdx = if (firstTombstone != -1) firstTombstone else idx;
                self.keys.set(insertIdx, key);
                self.vals.set(insertIdx, value);
                bytes.write_byte(self.slots, insertIdx, SLOT_OCCUPIED);
                self.len = self.len + 1;
                return;
            } else if (state == SLOT_TOMBSTONE) {
                if (firstTombstone == -1) {
                    firstTombstone = idx;
                }
            } else {
                let curKey = self.keys.at(idx);
                if (self.keysEqual(curKey, key)) {
                    self.vals.set(idx, value);
                    return;
                }
            }
            idx = (idx + 1) & (self.cap - 1);
            if (idx == startIdx) {

                if (firstTombstone != -1) {
                    self.keys.set(firstTombstone, key);
                    self.vals.set(firstTombstone, value);
                    bytes.write_byte(self.slots, firstTombstone, SLOT_OCCUPIED);
                    self.len = self.len + 1;
                    return;
                }
                self.resize();
                self.set(key, value);
                return;
            }
        }
    }

    pub fn get(self: Map<K, V>, key: K): V | undefined {
        if (self.len == 0) {
            return undefined;
        }
        let ps = bytes.ptr_size();
        let hash = (self.hashFn)(key);
        let idx = hash & (self.cap - 1);
        let startIdx = idx;

        while (true) {
            let state = bytes.read_byte(self.slots, idx);
            if (state == SLOT_EMPTY) {
                return undefined;
            }
            if (state == SLOT_OCCUPIED) {
                let curKey = self.keys.at(idx);
                if (self.keysEqual(curKey, key)) {
                    return self.vals.at(idx);
                }
            }
            idx = (idx + 1) & (self.cap - 1);
            if (idx == startIdx) {
                return undefined;
            }
        }
    }

    pub fn at(self: Map<K, V>, key: K): V {
        if (self.len != 0) {
            let hash = (self.hashFn)(key);
            let idx = hash & (self.cap - 1);
            let startIdx = idx;
            while (true) {
                let state = bytes.read_byte(self.slots, idx);
                if (state == SLOT_EMPTY) {
                    break;
                }
                if (state == SLOT_OCCUPIED) {
                    let curKey = self.keys.at(idx);
                    if (self.keysEqual(curKey, key)) {
                        return self.vals.at(idx);
                    }
                }
                idx = (idx + 1) & (self.cap - 1);
                if (idx == startIdx) {
                    break;
                }
            }
        }
        nova_panic("Map.at: key not found");
        return self.vals.at(0);
    }

    pub fn delete_key(self: Map<K, V>, key: K): bool {
        if (self.len == 0) {
            return false;
        }
        let ps = bytes.ptr_size();
        let hash = (self.hashFn)(key);
        let idx = hash & (self.cap - 1);
        let startIdx = idx;

        while (true) {
            let state = bytes.read_byte(self.slots, idx);
            if (state == SLOT_EMPTY) {
                return false;
            }
            if (state == SLOT_OCCUPIED) {
                let curKey = self.keys.at(idx);
                if (self.keysEqual(curKey, key)) {
                    self.keys.set(idx, 0);
                    self.vals.set(idx, 0);
                    bytes.write_byte(self.slots, idx, SLOT_TOMBSTONE);
                    self.len = self.len - 1;
                    return true;
                }
            }
            idx = (idx + 1) & (self.cap - 1);
            if (idx == startIdx) {
                return false;
            }
        }
    }

    pub fn has(self: Map<K, V>, key: K): bool {
        let val = self.get(key);
        return val != undefined;
    }

    pub fn size(self: Map<K, V>): int {
        return self.len;
    }

    pub fn forEach(self: Map<K, V>, fn: (K, V) => void): void {
        let ps = bytes.ptr_size();
        let i = 0;
        while (i < self.cap) {
            let state = bytes.read_byte(self.slots, i);
            if (state == SLOT_OCCUPIED) {
                let key = self.keys.at(i);
                let val = self.vals.at(i);
                fn(key, val);
            }
            i = i + 1;
        }
    }

    pub fn keys(self: Map<K, V>): list.List<K> {
        let result = list.List<K>();
        self.forEach((k, v) => result.push(k));
        return result;
    }

    pub fn values(self: Map<K, V>): list.List<V> {
        let result = list.List<V>();
        self.forEach((k, v) => result.push(v));
        return result;
    }

    fn resize(self: Map<K, V>): void {
        let ps = bytes.ptr_size();
        let oldCap = self.cap;
        let oldKeys = self.keys;
        let oldVals = self.vals;
        let oldSlots = self.slots;
        let oldHashFn = self.hashFn;

        let newCap = oldCap * 2;
        let newKeys = rawbuffer.RawBuffer<K>(newCap);
        newKeys.fill(newCap);
        let newVals = rawbuffer.RawBuffer<V>(newCap);
        newVals.fill(newCap);
        let newSlots = allocZero(newCap);

        let i = 0;
        while (i < oldCap) {
            let state = bytes.read_byte(oldSlots, i);
            if (state == SLOT_OCCUPIED) {
                let key = oldKeys.at(i);
                let val = oldVals.at(i);
                let hash = (oldHashFn)(key);
                let idx = hash & (newCap - 1);
                // The new table has no tombstones yet, so probe for the first EMPTY slot.
                while (true) {
                    let ns = bytes.read_byte(newSlots, idx);
                    if (ns == SLOT_EMPTY) {
                        newKeys.set(idx, key);
                        newVals.set(idx, val);
                        bytes.write_byte(newSlots, idx, SLOT_OCCUPIED);
                        break;
                    }
                    idx = (idx + 1) & (newCap - 1);
                }
            }
            i = i + 1;
        }

        if (oldSlots != 0) bytes.free(oldSlots);

        self.cap = newCap;
        self.keys = newKeys;
        self.vals = newVals;
        self.slots = newSlots;
    }

    fn delete(self: Map<K, V>): void {
        if (self.slots != 0) {
            bytes.free(self.slots);
            self.slots = 0;
        }
    }

    // The value for `key`, or `fallback` if absent.
    pub fn getOrDefault(self: Map<K, V>, key: K, fallback: V): V {
        let v = self.get(key);
        if (v == undefined) { return fallback; }
        return v;
    }

    // Copy every entry of `other` into this map, overwriting on key collision. `other` is unchanged.
    // A keys-loop (not other.forEach) so the copy body does not need a closure that captures `self`.
    // `at` returns the value UNBOXED (V, not the boxed `V | undefined` that `get` returns), which the keys
    // loop can use safely because it only visits keys that exist.
    pub fn merge(self: Map<K, V>, other: Map<K, V>): void {
        let ks = other.keys();
        let i = 0;
        while (i < ks.size()) {
            let k = ks.at(i);
            self.set(k, other.at(k));
            i = i + 1;
        }
    }

    // All key/value pairs as a list of tuples (iteration order matches keys/values).
    pub fn entries(self: Map<K, V>): list.List<(K, V)> {
        let result = list.List<(K, V)>();
        let ks = self.keys();
        let i = 0;
        while (i < ks.size()) {
            let k = ks.at(i);
            result.push((k, self.at(k)));
            i = i + 1;
        }
        return result;
    }

    // Remove every entry, via the ARC-correct delete_key over a snapshot of the keys (no buffer reassign).
    pub fn clear(self: Map<K, V>): void {
        let ks = self.keys();
        let i = 0;
        while (i < ks.size()) { self.delete_key(ks.at(i)); i = i + 1; }
    }
}

@test
fn test_map(): void {
    let map = Map<string, int>(16, string.hash);
    assert.equalInt(0, map.size());

    map.set("alice", 100);
    map.set("bob", 200);
    assert.equalInt(2, map.size());

    assert.equalInt(100, map.get("alice") ?? 0);
    assert.equalInt(200, map.get("bob") ?? 0);
    assert.isTrue(map.has("alice"));
    assert.isFalse(map.has("charlie"));

    map.delete_key("alice");
    assert.equalInt(1, map.size());
    assert.isFalse(map.has("alice"));
}
