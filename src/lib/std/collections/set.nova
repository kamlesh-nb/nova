
import map;
import bytes;
import list;
import assert;

pub class Set<T> {
    pub map: map.Map<T, bool>,

    init(initialCap: int, hashFn: (T) -> int) {
        self.map = map.Map<T, bool>(initialCap, hashFn);
    }

    pub fn add(self: Set<T>, elem: T): void {
        self.map.set(elem, true);
    }

    pub fn has(self: Set<T>, elem: T): bool {
        return self.map.get(elem) != undefined;
    }

    pub fn remove(self: Set<T>, elem: T): void {
        self.map.delete_key(elem);
    }

    pub fn size(self: Set<T>): int {
        return self.map.size();
    }

    pub fn forEach(self: Set<T>, fn: (T) => void): void {
        let keys = self.map.keys();
        let keysLen = keys.size();
        let i = 0;
        while (i < keysLen) {
            fn(keys.get(i));
            i = i + 1;
        }
    }

    pub fn toList(self: Set<T>): list.List<T> {
        return self.map.keys();
    }

    // Set algebra. Each returns a NEW set (inputs unmodified) built with this set's hash function, so the
    // result is usable exactly like the operands.
    pub fn unionWith(self: Set<T>, other: Set<T>): Set<T> {
        let out = Set<T>(self.size() + other.size() + 1, self.map.hashFn);
        let a = self.map.keys();
        let i = 0;
        while (i < a.size()) { out.add(a.at(i)); i = i + 1; }
        let b = other.toList();
        let j = 0;
        while (j < b.size()) { out.add(b.at(j)); j = j + 1; }
        return out;
    }

    // Elements present in BOTH sets.
    pub fn intersection(self: Set<T>, other: Set<T>): Set<T> {
        let out = Set<T>(self.size() + 1, self.map.hashFn);
        let a = self.map.keys();
        let i = 0;
        while (i < a.size()) {
            let e = a.at(i);
            if (other.has(e)) { out.add(e); }
            i = i + 1;
        }
        return out;
    }

    // Elements in this set that are NOT in other.
    pub fn difference(self: Set<T>, other: Set<T>): Set<T> {
        let out = Set<T>(self.size() + 1, self.map.hashFn);
        let a = self.map.keys();
        let i = 0;
        while (i < a.size()) {
            let e = a.at(i);
            if (!other.has(e)) { out.add(e); }
            i = i + 1;
        }
        return out;
    }

    pub fn delete(self: Set<T>): void {
        self.map.delete();
    }
}

pub fn i32Hash(val: int): int {
    return val;
}

@test
fn test_set(): void {
    let set = Set<int>(16, i32Hash);
    assert.equalInt(0, set.size());

    set.add(10);
    set.add(20);
    set.add(10);
    assert.equalInt(2, set.size());

    assert.isTrue(set.has(10));
    assert.isTrue(set.has(20));
    assert.isFalse(set.has(30));

    set.remove(10);
    assert.equalInt(1, set.size());
    assert.isFalse(set.has(10));
}
