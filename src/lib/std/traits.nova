import assert;

pub trait Executable {
    fn run(self: Executable): void;
}

pub fn execute(exe: Executable): void {
    exe.run();
}

struct TestRunner {
    pub val: int,
    init() {
        self.val = 0;
    }
    pub fn run(self: TestRunner): void {
        self.val = 42;
    }
}

@test
fn test_traits_execution(): void {
    let runner = TestRunner();
    execute(runner);
    assert.equalInt(42, runner.val);
}
