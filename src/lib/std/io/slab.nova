
import bytes;

pub class SlabPool {
    pub base: long,
    pub stride: int,
    pub blockSize: int,
    pub count: int,
    pub freeHead: long,
    pub freeCount: int,

    init(blockSize: int, count: int) {
        let aligned = (blockSize + 7) / 8 * 8;
        self.blockSize = blockSize;
        self.stride = 8 + aligned;
        self.count = count;
        self.base = bytes.alloc(count * self.stride);
        self.freeCount = count;

        let i = 0;
        while (i < count - 1) {
            let blk = self.base + (i * self.stride) as long;
            bytes.write_ptr(blk, 0, self.base + ((i + 1) * self.stride) as long);
            i = i + 1;
        }
        bytes.write_ptr(self.base + ((count - 1) * self.stride) as long, 0, 0);
        self.freeHead = self.base;
    }

    pub fn acquire(self: SlabPool): long {
        if (self.freeHead == 0) {
            return 0;
        }
        let blk = self.freeHead;
        self.freeHead = bytes.read_ptr(blk, 0);
        bytes.write_i32(blk, 0, 1);
        self.freeCount = self.freeCount - 1;
        return blk + 8;
    }

    pub fn retain(self: SlabPool, payload: long): void {
        let blk = payload - 8;
        bytes.write_i32(blk, 0, (bytes.read_i32(blk, 0) as int + 1) as long);
    }

    pub fn release(self: SlabPool, payload: long): void {
        let blk = payload - 8;
        let rc = (bytes.read_i32(blk, 0) as int) - 1;
        bytes.write_i32(blk, 0, rc as long);
        if (rc <= 0) {
            bytes.write_ptr(blk, 0, self.freeHead);
            self.freeHead = blk;
            self.freeCount = self.freeCount + 1;
        }
    }

    pub fn refcount(self: SlabPool, payload: long): int {
        return bytes.read_i32(payload - 8, 0) as int;
    }

    pub fn available(self: SlabPool): int {
        return self.freeCount;
    }

    pub fn destroy(self: SlabPool): void {
        if (self.base != 0) {
            bytes.free(self.base);
            self.base = 0;
        }
    }
}
