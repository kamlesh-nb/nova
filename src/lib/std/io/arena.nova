import bytes;
import list;

pub class Arena {
    blocks: list.List<long>,
    sizes: list.List<int>,
    cur: int,
    used: int,
    total: int,
    freed: bool,

    init(cap: int) {
        let c = if (cap <= 0) 4096 else cap;
        self.blocks = list.List<long>();
        self.sizes = list.List<int>();
        self.blocks.push(bytes.alloc(c));
        self.sizes.push(c);
        self.cur = 0;
        self.used = 0;
        self.total = 0;
        self.freed = false;
    }

    fn addBlock(self: Arena, need: int): void {
        let last = self.sizes.at(self.sizes.size() - 1);
        let grown = last * 2;
        let cap = if (grown < need) need else grown;
        self.blocks.push(bytes.alloc(cap));
        self.sizes.push(cap);
        self.cur = self.cur + 1;
        self.used = 0;
    }

    pub fn alloc(self: Arena, n: int): long {
        let aligned = (n + 7) / 8 * 8;
        let cap = self.sizes.at(self.cur);
        if (self.used + aligned > cap) {
            self.addBlock(aligned);
        }
        let base = self.blocks.at(self.cur);
        let addr = base + (self.used as long);
        self.used = self.used + aligned;
        self.total = self.total + aligned;
        return addr;
    }

    pub fn reset(self: Arena): void {
        while (self.blocks.size() > 1) {
            bytes.free(self.blocks.at(self.blocks.size() - 1));
            let _ = self.blocks.pop();
            let _ = self.sizes.pop();
        }
        self.cur = 0;
        self.used = 0;
        self.total = 0;
    }

    pub fn allocated(self: Arena): int { return self.total; }

    pub fn blockCount(self: Arena): int { return self.blocks.size(); }

    pub fn delete(self: Arena): void {
        if (self.freed) { return; }
        self.freed = true;
        let i = 0;
        while (i < self.blocks.size()) {
            bytes.free(self.blocks.at(i));
            i = i + 1;
        }
    }

    pub fn destroy(self: Arena): void { self.delete(); }

    pub fn remaining(self: Arena): int { return self.sizes.at(self.cur) - self.used; }
}
