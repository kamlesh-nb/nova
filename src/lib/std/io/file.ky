//! Buffered, file-descriptor-backed file I/O.
//!
//! `File` is a thin wrapper over the raw POSIX descriptor exposed by `os.sys`
//! (open/read/write/lseek/close), giving Kyte code a small, direct API for
//! reading and writing files on disk. It offers both partial operations
//! (`read`/`write`, which may transfer fewer bytes than requested) and
//! "complete" ones (`readAll`/`writeAll`, which loop until the whole buffer
//! is transferred or the underlying syscall stalls), plus convenience
//! static methods (`readText`/`writeText`/`appendText`) for whole-file text
//! access without managing a `File` instance at all.
//!
//! This module does no buffering of its own beyond what the OS provides:
//! every `read`/`write` call is a direct syscall. It sits alongside the rest
//! of `std.io` as the primary way Kyte programs touch the filesystem.

import bytes;
import mem.allocator;
import string;
import os.sys;

/// A handle to an open file, wrapping a raw OS file descriptor.
pub struct File {
    /// The underlying OS file descriptor, or a negative value once the file
    /// has failed to open or has been closed.
    pub fd: int,
    /// The path the file was opened with.
    pub path: string,
    /// Allocator used to heap-allocate this `File` instance itself.
    pub allocator: allocator.Allocator,

    /// Opens `path` with the given mode string (`"r"`, `"w"`, `"a"`, `"r+"`,
    /// `"w+"`, `"a+"`; unrecognised modes fall back to read-only) and
    /// returns a heap-allocated `File`. Check `.fd >= 0` to confirm success.
    pub fn open(path: string, mode: string): File {
        let f = bytes.new_with_allocator<File>(allocator.globalAllocator());
        f.allocator = allocator.globalAllocator();
        f.path = path;
        f.fd = openFd(path, mode);
        return f;
    }

    /// Reads up to `size` bytes into `buf`. Returns the number of bytes
    /// actually read (may be less than `size`), or -1 if the file is not
    /// open.
    pub fn read(self: File, buf: ptr, size: int): int {
        if (self.fd < 0) { return -1; }
        return sys.read(self.fd, buf, size as long) as int;
    }

    /// Reads repeatedly until `buf` is filled with `size` bytes or a read
    /// returns zero or fewer bytes (EOF or error). Returns the total number
    /// of bytes actually read, which may be less than `size` at EOF.
    pub fn readAll(self: File, buf: ptr, size: int): int {
        if (self.fd < 0) { return -1; }
        let base = buf as long;
        let total = 0;
        while (total < size) {
            let n = sys.read(self.fd, base + (total as long), (size - total) as long) as int;
            if (n <= 0) { break; }
            total = total + n;
        }
        return total;
    }

    /// Writes up to `size` bytes from `buf`. Returns the number of bytes
    /// actually written (may be less than `size`), or -1 if the file is not
    /// open.
    pub fn write(self: File, buf: ptr, size: int): int {
        if (self.fd < 0) { return -1; }
        return sys.write(self.fd, buf, size as long) as int;
    }

    /// Writes repeatedly until all `size` bytes of `buf` are written or a
    /// write returns zero or fewer bytes. Returns the total number of bytes
    /// actually written.
    pub fn writeAll(self: File, buf: ptr, size: int): int {
        if (self.fd < 0) { return -1; }
        let base = buf as long;
        let total = 0;
        while (total < size) {
            let n = sys.write(self.fd, base + (total as long), (size - total) as long) as int;
            if (n <= 0) { break; }
            total = total + n;
        }
        return total;
    }

    /// Writes the full contents of string `s` in one syscall. Returns the
    /// number of bytes written, or -1 if the file is not open.
    pub fn writeString(self: File, s: string): int {
        if (self.fd < 0) { return -1; }
        return sys.write(self.fd, s, s.length as long) as int;
    }

    /// Repositions the file offset to `offset`, interpreted relative to
    /// `whence` (`sys.SEEK_SET`, `sys.SEEK_CUR`, or `sys.SEEK_END`).
    pub fn seek(self: File, offset: long, whence: int): int {
        if (self.fd < 0) { return -1; }
        return sys.lseek(self.fd, offset, whence) as int;
    }

    /// Returns the current file offset, or -1 if the file is not open.
    pub fn tell(self: File): long {
        if (self.fd < 0) { return -1; }
        return sys.lseek(self.fd, 0, sys.SEEK_CUR);
    }

    /// Reports whether the current offset is at or beyond the end of the
    /// file. Implemented by seeking to the end and back, so it leaves the
    /// offset unchanged. Returns true (treated as EOF) if the file is not
    /// open.
    pub fn eof(self: File): bool {
        if (self.fd < 0) { return true; }
        let cur = sys.lseek(self.fd, 0, sys.SEEK_CUR);
        let end = sys.lseek(self.fd, 0, sys.SEEK_END);
        sys.lseek(self.fd, cur, sys.SEEK_SET);
        return cur >= end;
    }

    /// No-op: there is no userspace buffer to flush, since every read/write
    /// call is a direct syscall. Always returns 0.
    pub fn flush(self: File): int {
        return 0;
    }

    /// Forces the OS to flush the file's buffered data and metadata to disk.
    pub fn fsync(self: File): int {
        if (self.fd < 0) { return -1; }
        return sys.fsync(self.fd);
    }

    /// Closes the underlying descriptor, if open, and marks the file closed
    /// by setting `fd` to -1. Safe to call more than once.
    pub fn close(self: File): void {
        if (self.fd >= 0) {
            sys.close(self.fd);
        }
        self.fd = -1;
    }

    /// Reports whether `path` exists on disk.
    pub fn exists(path: string): bool {
        return sys.pathExists(path);
    }

    /// Reads the entire contents of `path` into a freshly allocated string.
    /// Returns an empty string if the file cannot be opened, is empty, or
    /// its size cannot be determined; this makes an empty file
    /// indistinguishable from a read failure.
    pub fn readText(path: string): string {
        let fd = openFd(path, "r");
        if (fd < 0) {
            return "";
        }

        let size = sys.lseek(fd, 0, sys.SEEK_END) as int;
        sys.lseek(fd, 0, sys.SEEK_SET);
        if (size <= 0) {
            sys.close(fd);
            return "";
        }

        let data_ptr = allocator.globalAllocator().alloc(size + 1);
        bytes.write_i32(data_ptr - 4, 0, size);
        let base = data_ptr as long;
        let total = 0;
        while (total < size) {
            let n = sys.read(fd, base + (total as long), (size - total) as long) as int;
            if (n <= 0) { break; }
            total = total + n;
        }
        bytes.write_byte(data_ptr, total, 0);
        sys.close(fd);
        return data_ptr as string;
    }

    /// Writes `content` to `path`, creating the file if needed and
    /// truncating any existing contents. Fails silently (returns without
    /// error) if the file cannot be opened; use `writeTextOk` to detect
    /// failure.
    pub fn writeText(path: string, content: string): void {
        let fd = openFd(path, "w");
        if (fd < 0) {
            return;
        }
        sys.write(fd, content, content.length as long);
        sys.close(fd);
    }

    /// Like `writeText`, but returns true only if the file opened
    /// successfully and every byte of `content` was written.
    pub fn writeTextOk(path: string, content: string): bool {
        let fd = openFd(path, "w");
        if (fd < 0) { return false; }
        let n = sys.write(fd, content, content.length as long);
        sys.close(fd);
        return n == (content.length as long);
    }

    /// Removes (unlinks) the file at `path`. Returns the underlying `unlink`
    /// result: `0` on success, non-zero on failure (for example, no such file).
    /// This unlinks a FILE; use `Dir.remove` for an (empty) directory.
    pub fn remove(path: string): int {
        let cp = sys.cstr(path);
        let r = sys.unlink(cp);
        bytes.free(cp);
        return r;
    }

    /// Appends `content` to `path`, creating the file if it does not exist.
    /// Fails silently if the file cannot be opened.
    pub fn appendText(path: string, content: string): void {
        let fd = openFd(path, "a");
        if (fd < 0) {
            return;
        }
        sys.write(fd, content, content.length as long);
        sys.close(fd);
    }
}

// Translates a mode string into POSIX open() flags and opens the file, returning its descriptor (or a negative value on failure).
fn openFd(path: string, mode: string): int {
    let flags = sys.O_RDONLY;
    if (mode == "r") {
        flags = sys.O_RDONLY;
    } else if (mode == "w") {
        flags = sys.O_WRONLY | sys.O_CREAT() | sys.O_TRUNC();
    } else if (mode == "a") {
        flags = sys.O_WRONLY | sys.O_CREAT() | sys.O_APPEND();
    } else if (mode == "r+") {
        flags = sys.O_RDWR;
    } else if (mode == "w+") {
        flags = sys.O_RDWR | sys.O_CREAT() | sys.O_TRUNC();
    } else if (mode == "a+") {
        flags = sys.O_RDWR | sys.O_CREAT() | sys.O_APPEND();
    }
    let cp = sys.cstr(path);
    let fd = sys.kyte_open(cp, flags, 420);
    bytes.free(cp);
    return fd;
}
