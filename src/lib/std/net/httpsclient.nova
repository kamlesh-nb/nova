import bytes;
import string;
import list;
import map;
import net.asynctls;
import net.url;
import compress.gzip;
import web.response;
import web.status;

pub struct HttpsResp {
    pub code: int,
    pub headers: Map<string, string>,
    pub body: string,
}

fn bufToStr(buf: ptr, n: int): string {
    if (n <= 0) { return ""; }
    let out = bytes.alloc(n);
    let i = 0;
    while (i < n) { bytes.write_byte(out, i, bytes.read_byte(buf, i)); i = i + 1; }
    return out as string;
}

fn parseHex(s: string): int {
    let v = 0;
    let i = 0;
    while (i < s.length) {
        let c = s[i];
        let d = 0 - 1;
        if (c >= 48 && c <= 57) { d = c - 48; }
        else if (c >= 97 && c <= 102) { d = c - 97 + 10; }
        else if (c >= 65 && c <= 70) { d = c - 65 + 10; }
        if (d < 0) { break; }
        v = v * 16 + d;
        i = i + 1;
    }
    return v;
}

fn dechunk(s: string): string {
    let out = List<string>();
    let pos = 0;
    while (pos < s.length) {
        let rest = string.slice(s, pos, s.length);
        let nl = string.indexOf(rest, "\r\n");
        if (nl == 0 - 1) { break; }
        let sizeLine = string.slice(s, pos, pos + nl);
        let size = parseHex(sizeLine);
        pos = pos + nl + 2;
        if (size == 0) { break; }
        if (pos + size > s.length) { break; }
        out.push(string.slice(s, pos, pos + size));
        pos = pos + size + 2;
    }
    return string.join(out, "");
}

fn frameResp(raw: string): HttpsResp {
    let r = response.Response.parse(raw);
    let code = Status.toCode(r.status);
    let te = string.toLowerCase(r.getHeader("transfer-encoding") ?? "");
    let ce = string.toLowerCase(r.getHeader("content-encoding") ?? "");
    let chunked = string.contains(te, "chunked");
    let gz = string.contains(ce, "gzip");
    let dechunked = if (chunked) dechunk(r.body) else r.body;
    let body = if (gz) gzip.decompress(dechunked) else dechunked;
    return HttpsResp{ code: code, headers: r.headers, body: body };
}

async fn getOver(ts: asynctls.TlsStream, u: url.Url): HttpsResp {
    if (!ts.ok()) { ts.close(); return HttpsResp{ code: 0, headers: Map<string, string>(4, string.hash), body: "" }; }
    let req = "GET " + u.path + " HTTP/1.1\r\nHost: " + u.host + "\r\nConnection: close\r\nAccept-Encoding: gzip\r\nUser-Agent: nova-https/1.0\r\n\r\n";
    if (await ts.sendStr(req) < 0) { ts.close(); return HttpsResp{ code: 0, headers: Map<string, string>(4, string.hash), body: "" }; }
    let parts = List<string>();
    let buf = bytes.alloc(65536);
    while (true) {
        let n = await ts.recvInto(buf as long, 65536);
        if (n <= 0) { break; }
        parts.push(bufToStr(buf, n));
    }
    ts.close();
    return frameResp(string.join(parts, ""));
}

pub async fn getVerified(urlStr: string, caPem: string): HttpsResp {
    let u = url.parse(urlStr);
    let ts = await asynctls.tlsConnectVerify(u.host, u.port, caPem);
    return await getOver(ts, u);
}

pub async fn get(urlStr: string): HttpsResp {
    let u = url.parse(urlStr);
    let ts = await asynctls.tlsConnectAlpn(u.host, u.port, "http/1.1");
    return await getOver(ts, u);
}
