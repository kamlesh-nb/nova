//! TCP stream and socket helpers built on top of `os.socket`.
//!
//! This file gives Kyte code two ways to talk TCP: the `TcpStream` class,
//! an owning wrapper around a socket file descriptor with read/write/close
//! methods, and a set of bare, class-free functions (`connect`, `listenAny`,
//! `acceptOne`, `sendBytes`, `recvBytes`, and so on) for callers who already
//! manage the raw `fd` themselves, such as the reactor-driven async I/O path.
//! All blocking behaviour, timeouts, and the underlying syscalls live in
//! `os.socket`; this module only shapes that into stream-style reads and
//! writes and does buffer management for the copying read paths.

import bytes;
import os.socket;


/// An owning TCP connection: wraps a socket file descriptor and closes it on `delete`.
///
/// `TcpStream` is a blocking stream. Once `close` runs (explicitly or via the
/// destructor), `fd` is set to -1 and further use of the stream is a no-op or
/// will fail at the OS level.
pub class TcpStream {
    /// The underlying socket file descriptor, or -1 once closed.
    pub fd: int,

    init(fd: int) {
        self.fd = fd;
    }

    /// Writes the full contents of `data` to the socket, blocking until it is all sent.
    /// Returns the number of bytes sent, or a negative value on error.
    pub fn write(self: TcpStream, data: string): int {
        return socket.sendAll(self.fd, data as long, data.length);
    }

    /// Writes `len` bytes starting at `data` to the socket, blocking until it is all sent.
    pub fn writeBytes(self: TcpStream, data: ptr, len: int): int {
        return socket.sendAll(self.fd, data as long, len);
    }

    /// Reads at most `max_len` bytes from the socket in a single receive call.
    ///
    /// Returns the bytes actually read as a fresh owned string, which may be
    /// shorter than `max_len`. Returns an empty string if the peer closed the
    /// connection or the receive failed (`n <= 0`).
    pub fn read(self: TcpStream, max_len: int): string {
        let buf = bytes.alloc(max_len);
        let n = socket.recvOnce(self.fd, buf, max_len);
        if (n <= 0) {
            bytes.free(buf);
            return "";
        }
        let str_ptr = bytes.alloc(n);
        let i = 0;
        while (i < n) {
            bytes.write_byte(str_ptr, i, bytes.read_byte(buf, i));
            i = i + 1;
        }
        bytes.free(buf);
        return str_ptr as string;
    }

    /// Reads repeatedly until either `max_len` bytes have been received or the
    /// peer stops sending (a receive returns `<= 0`), whichever comes first.
    /// Returns everything read so far as an owned string, empty if nothing arrived.
    pub fn readAll(self: TcpStream, max_len: int): string {
        let buf = bytes.alloc(max_len);
        let total = 0;
        while (total < max_len) {
            let n = socket.recvOnce(self.fd, buf + total, max_len - total);
            if (n <= 0) break;
            total = total + n;
        }
        if (total == 0) {
            bytes.free(buf);
            return "";
        }
        let str_ptr = bytes.alloc(total);
        let i = 0;
        while (i < total) {
            bytes.write_byte(str_ptr, i, bytes.read_byte(buf, i));
            i = i + 1;
        }
        bytes.free(buf);
        return str_ptr as string;
    }

    /// Sets the socket's send/receive timeout in milliseconds.
    pub fn setTimeout(self: TcpStream, timeoutMs: int): int {
        return socket.setTimeout(self.fd, timeoutMs);
    }

    /// Closes the underlying socket, if not already closed. Safe to call more than once.
    pub fn close(self: TcpStream): void {
        if (self.fd != -1) {
            socket.close(self.fd);
            self.fd = -1;
        }
    }

    /// Destructor: closes the socket when the stream goes out of scope.
    pub fn delete(self: TcpStream): void {
        self.close();
    }
}

/// Closes a raw socket file descriptor directly, without going through `TcpStream`.
pub fn closeFd(fd: int): int {
    return socket.close(fd);
}

/// Opens a blocking TCP connection to `host:port` and returns the new socket file descriptor.
pub fn connect(host: string, port: int): int { return socket.connectBlocking(host, port); }
/// Sets the send/receive timeout in milliseconds on a raw socket file descriptor.
pub fn setTimeout(fd: int, ms: int): int { return socket.setTimeout(fd, ms); }
/// Opens a listening TCP socket bound to `port` on any local interface.
pub fn listenAny(port: int): int { return socket.listenAny(port); }
/// Blocks until one incoming connection arrives on the listening socket `fd`, returning the accepted socket's file descriptor.
pub fn acceptOne(fd: int): int { return socket.acceptOne(fd); }
/// Sends the full contents of a string over a raw socket file descriptor, blocking until complete.
pub fn sendStr(fd: int, data: string): int { return socket.sendAll(fd, data as long, data.length); }
/// Sends `len` bytes starting at `data` over a raw socket file descriptor, blocking until complete.
pub fn sendBytes(fd: int, data: ptr, len: int): int { return socket.sendAll(fd, data as long, len); }
/// Reads at most `max` bytes from a raw socket file descriptor into `buf` in a single receive call.
pub fn recvBytes(fd: int, buf: ptr, max: int): int { return socket.recvOnce(fd, buf as long, max); }
