
import bytes;
import os.socket;

// The blocking TCP stream over os/socket (M14.2: was the C nova_socket_* layer). `socket.*` here is the
// os.socket module; net/tcp/{client,server} and web/client go through the facade fns below so they never
// import os.socket directly (its qualifier would collide with this module's `socket` qualifier).

pub class TcpStream {
    pub fd: int,

    init(fd: int) {
        self.fd = fd;
    }

    pub fn write(self: TcpStream, data: string): int {
        return socket.sendAll(self.fd, data as long, data.length);
    }

    pub fn writeBytes(self: TcpStream, data: ptr, len: int): int {
        return socket.sendAll(self.fd, data as long, len);
    }

    pub fn read(self: TcpStream, max_len: int): string {
        let buf = bytes.alloc(max_len);
        let n = socket.recvOnce(self.fd, buf, max_len);
        if (n <= 0) {
            bytes.free(buf);
            return "";
        }
        let str_ptr = bytes.alloc(n);
        let i = 0;
        while (i < n) {
            bytes.write_byte(str_ptr, i, bytes.read_byte(buf, i));
            i = i + 1;
        }
        bytes.free(buf);
        return str_ptr as string;
    }

    pub fn readAll(self: TcpStream, max_len: int): string {
        let buf = bytes.alloc(max_len);
        let total = 0;
        while (total < max_len) {
            let n = socket.recvOnce(self.fd, buf + total, max_len - total);
            if (n <= 0) break;
            total = total + n;
        }
        if (total == 0) {
            bytes.free(buf);
            return "";
        }
        let str_ptr = bytes.alloc(total);
        let i = 0;
        while (i < total) {
            bytes.write_byte(str_ptr, i, bytes.read_byte(buf, i));
            i = i + 1;
        }
        bytes.free(buf);
        return str_ptr as string;
    }

    pub fn setTimeout(self: TcpStream, timeoutMs: int): int {
        return socket.setTimeout(self.fd, timeoutMs);
    }

    pub fn close(self: TcpStream): void {
        if (self.fd != -1) {
            socket.close(self.fd);
            self.fd = -1;
        }
    }

    pub fn delete(self: TcpStream): void {
        self.close();
    }
}

pub fn closeFd(fd: int): int {
    return socket.close(fd);
}

// --- facade over os.socket so net/tcp/{client,server} + web/client don't import os.socket directly -----
pub fn connect(host: string, port: int): int { return socket.connectBlocking(host, port); }
pub fn setTimeout(fd: int, ms: int): int { return socket.setTimeout(fd, ms); }
pub fn listenAny(port: int): int { return socket.listenAny(port); }
pub fn acceptOne(fd: int): int { return socket.acceptOne(fd); }
pub fn sendStr(fd: int, data: string): int { return socket.sendAll(fd, data as long, data.length); }
pub fn sendBytes(fd: int, data: ptr, len: int): int { return socket.sendAll(fd, data as long, len); }
pub fn recvBytes(fd: int, buf: ptr, max: int): int { return socket.recvOnce(fd, buf as long, max); }
