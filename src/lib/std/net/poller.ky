//! Reactor: the per-thread async I/O driver that wraps `net.eventloop.Poller`.
//!
//! A `Reactor` bundles a readiness poller (kqueue/epoll/io_uring/IOCP, chosen by
//! `net.eventloop`), a fixed pool of I/O buffers (`io.slab.SlabPool`), and the
//! bookkeeping a coroutine scheduler needs to arm reads and writes, wait for
//! completions, and read back readiness results (fd, token, byte count, EOF)
//! per event slot. It is the Kyte-side half of the C++ runtime's async engine:
//! the free functions here (`runReactors`, `setCurrent`, `post`, `drainWake`,
//! ...) call straight through to `kyte_reactor_*` runtime intrinsics for
//! spinning up worker reactors, cross-reactor wake-ups, and batch coroutine
//! resumption. Application code normally reaches this through the higher-level
//! socket/HTTP layers rather than driving a `Reactor` directly.

import bytes;
import io.slab;
import net.eventloop;

/// Starts `n` reactor threads, each running `worker` with its own reactor
/// index (0..n-1) bound as the "current" reactor for that thread.
pub fn runReactors(n: int, worker: (int) -> void): void {
    kyte_run_reactors(n, worker);
}

/// Binds `kq` as the calling thread's current reactor handle, so runtime
/// helpers that need "the reactor for this thread" can find it without it
/// being passed explicitly.
pub fn setCurrent(kq: int): void { kyte_reactor_set_current(kq as long); }
/// Returns the current thread's reactor handle set by `setCurrent`.
pub fn currentKq(): int { return kyte_reactor_current() as int; }

/// Marks the start of a coroutine-resumption batch, so stale wake-ups for
/// frames reaped earlier in the batch are not mistakenly redelivered.
pub fn batchBegin(): void { kyte_reactor_batch_begin(); }

/// Registers reactor `self` as the wake target for cross-reactor channel
/// slot `idx`, so a `post` from another thread on that slot reaches it.
pub fn registerWake(self: Reactor, idx: int): void { kyte_reactor_wake_register(idx as long, self.kq as long); }
/// Posts a coroutine `handle` to the wake channel `idx`, waking whichever
/// reactor is registered on it (used for cross-thread handoff).
pub fn post(idx: int, handle: long): void { kyte_reactor_post(idx as long, handle); }
/// Drains and returns one pending handle from wake channel `idx`, or a
/// sentinel if the channel is currently empty.
pub fn drainWake(idx: int): long { return kyte_reactor_drain_one(idx as long); }
/// Returns the raw event filter (kqueue-style) recorded for ready slot `i`.
pub fn readyFilter(self: Reactor, i: int): int { return eventloop.evFilterAt(self.loop.eventBuf, i); }
/// Returns the platform's user-event filter constant, used to recognise
/// synthetic wake events among the events a poll returns.
pub fn evfiltUser(): int { return kyte_evfilt_user() as int; }

/// A single-threaded async I/O driver: a readiness poller plus a pooled
/// buffer allocator, owned by one thread and driven by its coroutine
/// scheduler.
pub struct Reactor {
    /// The underlying platform poller (kqueue/epoll/io_uring/IOCP).
    pub loop: eventloop.Poller,
    /// The poller's native handle (kqueue fd, epoll fd, and so on); `-1`
    /// once `destroy` has run.
    pub kq: int,
    /// Capacity of the poller's ready-event buffer, set at construction.
    pub maxEvents: int,
    /// Pool of fixed-size I/O buffers handed out via `getBuffer`/`putBuffer`.
    pub pool: slab.SlabPool,

    init(maxEvents: int, blockSize: int, blockCount: int) {
        self.loop = eventloop.Poller(maxEvents);
        self.kq = self.loop.kq;
        self.maxEvents = maxEvents;
        self.pool = slab.SlabPool(blockSize, blockCount);
    }

    /// Returns whether the underlying poller was created successfully.
    pub fn ok(self: Reactor): bool { return self.kq >= 0; }

    /// Submits a completion-style operation `op` (io_uring/IOCP) to the loop.
    pub fn submitOp(self: Reactor, op: long): int { return self.loop.submit(op); }
    /// Waits up to `timeoutMs` for submitted operations to complete.
    pub fn pollComplete(self: Reactor, timeoutMs: int): int { return self.loop.poll(timeoutMs); }
    /// Returns the completion token recorded for completed operation `i`.
    pub fn completedToken(self: Reactor, i: int): long { return self.loop.completedToken(i); }

    /// Arms `fd` for read readiness, tagging the event with `token`.
    pub fn addRead(self: Reactor, fd: int, token: long): int { return eventloop.armRead(self.kq, fd, token); }
    /// Cancels a pending read interest on `fd`.
    pub fn delRead(self: Reactor, fd: int): int { eventloop.cancelRead(self.kq, fd); return 0; }
    /// Arms `fd` for write readiness, tagging the event with `token`.
    pub fn addWrite(self: Reactor, fd: int, token: long): int { return eventloop.armWrite(self.kq, fd, token); }
    /// Cancels a pending write interest on `fd`.
    pub fn delWrite(self: Reactor, fd: int): int { eventloop.cancelWrite(self.kq, fd); return 0; }
    /// Waits up to `timeoutMs` for readiness events, filling the loop's
    /// event buffer; returns the number of ready events (up to `maxEvents`).
    pub fn poll(self: Reactor, timeoutMs: int): int {
        return eventloop.waitReady(self.kq, self.loop.eventBuf, self.maxEvents, timeoutMs);
    }
    /// Returns the file descriptor for ready slot `i`.
    pub fn readyFd(self: Reactor, i: int): int { return eventloop.evFd(self.loop.eventBuf, i); }
    /// Returns the token that was passed to `addRead`/`addWrite` for the
    /// operation now ready at slot `i`.
    pub fn readyToken(self: Reactor, i: int): long { return eventloop.evToken(self.loop.eventBuf, i); }
    /// Returns the byte count reported for ready slot `i` (falls back to
    /// `FIONREAD` on proactor backends where the completion carries none).
    pub fn readyBytes(self: Reactor, i: int): long { return eventloop.evBytes(self.loop.eventBuf, i); }
    /// Returns whether ready slot `i` represents an end-of-file condition.
    pub fn readyEof(self: Reactor, i: int): bool { return eventloop.evEof(self.loop.eventBuf, i); }

    /// Acquires a buffer from the reactor's slab pool; returns its address.
    pub fn getBuffer(self: Reactor): long { return self.pool.acquire(); }
    /// Returns a buffer previously obtained from `getBuffer` to the pool.
    pub fn putBuffer(self: Reactor, buf: long): void { self.pool.release(buf); }

    /// Tears down the buffer pool and the underlying poller, and marks
    /// `kq` as closed (`-1`). The reactor must not be used afterwards.
    pub fn destroy(self: Reactor): void {
        self.pool.destroy();
        self.loop.destroy();
        self.kq = -1;
    }
}
