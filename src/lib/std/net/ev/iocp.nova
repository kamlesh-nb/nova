//! Windows IOCP backend for the Nova reactor (`net/ev`).
//!
//! IOCP is a completion (proactor) model, unlike kqueue/epoll's readiness
//! model: the caller hands the kernel an operation (a read, a write, an
//! accept) rather than asking to be told when an fd is ready, and the kernel
//! delivers a completion packet once the operation has actually finished.
//! This file implements the same `submit`/`poll`/`completedToken` surface the
//! other `net/ev/*` backends expose (see `EventLoop` and `Poller`), so the
//! rest of the reactor can stay backend-agnostic.
//!
//! Operation state lives in a fixed-size, hand-laid-out byte buffer (`op`,
//! size `OP_SIZE`) that doubles as the Win32 `OVERLAPPED` structure at offset
//! 0: the kernel writes into it directly, so its field offsets are not
//! incidental, they mirror the ABI. Readiness-style waiting (`armRead`/
//! `armWrite`) is emulated on top of the completion model with a zero-byte
//! receive/send: the completion fires exactly when data (or buffer space)
//! becomes available, without consuming it, mirroring the trick used by the
//! io_uring backend.
//!
//! Because IOCP owns the operation record until it completes or is
//! cancelled, this module must never free an `op` while it is still
//! outstanding with the kernel: `abandonOp` marks the record and lets the
//! eventual completion (or `dropArm`'s `CancelIoEx`) release it. See the
//! "proactor" note in `lang/CLAUDE.md` for the failure mode this avoids.

import bytes;
import os.socket;
import os.windows.winsock;
import os.windows.win32;

/// Sentinel completion key posted to wake `poll`/`waitReady` for an
/// out-of-band reason (e.g. shutdown), carrying no real operation.
pub const WAKE_KEY: long = -1;
/// Sentinel completion key used to deliver a fired deadline timer; its
/// overlapped slot carries the timer's token rather than an `op` pointer.
pub const TIMER_KEY: long = -2;

/// Operation kind: a pending or completed receive.
pub const OP_RECV: int = 0;
/// Operation kind: a pending or completed send.
pub const OP_SEND: int = 1;
/// Operation kind: a pending or completed `AcceptEx`.
pub const OP_ACCEPT: int = 2;
/// Operation kind: a pending or completed `ConnectEx`.
pub const OP_CONNECT: int = 3;
/// Operation kind: receive of a passed file descriptor (handle passing).
pub const OP_RECVFD: int = 6;

/// Byte size of one operation record, including the leading `OVERLAPPED`
/// region, the WSABUF at offset 72, and per-kind bookkeeping fields.
pub const OP_SIZE: int = 176;
const OP_ACCEPTED_OFF: int = 96;
const OP_ACCEPT_FIXED_OFF: int = 100;
const OP_ACCEPT_ADDR_OFF: int = 104;

/// Zeroes the embedded `OVERLAPPED` header and fills in the fields common to
/// every operation kind: kind, fd, buffer pointer/length, and the caller
/// token returned later via `opToken`.
pub fn makeOp(op: long, kind: int, fd: int, buf: long, len: int, token: long): void {
    bytes.write_ptr(op, 0, 0);  bytes.write_ptr(op, 8, 0);
    bytes.write_ptr(op, 16, 0); bytes.write_ptr(op, 24, 0);
    bytes.write_i32(op, 32, kind as long);
    bytes.write_i32(op, 36, fd as long);
    bytes.write_ptr(op, 40, buf);
    bytes.write_i32(op, 48, len as long);
    bytes.write_i32(op, 52, 0);
    bytes.write_ptr(op, 56, token);
    bytes.write_ptr(op, 64, 0);
}
/// Reads back the operation kind (`OP_RECV`, `OP_SEND`, ...) stored by `makeOp`.
pub fn opKind(op: long): int { return bytes.read_i32(op, 32) as int; }
/// Reads back the socket/handle the operation was issued against.
pub fn opFd(op: long): int { return bytes.read_i32(op, 36) as int; }
/// Reads back the data buffer pointer associated with the operation.
pub fn opBuf(op: long): long { return bytes.read_ptr(op, 40); }
/// Reads back the requested buffer length in bytes.
pub fn opLen(op: long): int { return bytes.read_i32(op, 48) as int; }
/// Completion state: 0 while in flight, 1 once completed, or `OP_ABANDONED`.
pub fn opDone(op: long): int { return bytes.read_i32(op, 52) as int; }
/// Reads back the caller-supplied token used to correlate the completion.
pub fn opToken(op: long): long { return bytes.read_ptr(op, 56); }
/// Result of a completed operation: byte count for recv/send, or the new
/// socket handle for an accept (via `finishAccept`, which also fixes up the
/// accepted socket's inherited state on first read).
pub fn opResult(op: long): int {
    if (opKind(op) == OP_ACCEPT) { return finishAccept(op); }
    return bytes.read_ptr(op, 64) as int;
}

// Finalises a completed AcceptEx: on first call, applies SO_UPDATE_ACCEPT_CONTEXT
// so the accepted socket inherits listening-socket options, and switches it to
// non-blocking mode. Returns -1 if the accept failed or was already consumed.
fn finishAccept(op: long): int {
    let a = bytes.read_i32(op, OP_ACCEPTED_OFF) as int;
    if (a <= 0) { return -1; }
    if (bytes.read_i32(op, OP_ACCEPT_FIXED_OFF) != 0) { return a; }
    bytes.write_i32(op, OP_ACCEPT_FIXED_OFF, 1);

    if (bytes.read_ptr(op, 0) != (0 as long)) {
        winsock.closesocket(a as long);
        bytes.write_i32(op, OP_ACCEPTED_OFF, -1);
        return -1;
    }

    let lf = bytes.alloc(8);
    bytes.write_ptr(lf, 0, opFd(op) as long);
    winsock.setsockopt(a as long, winsock.SOL_SOCKET, winsock.SO_UPDATE_ACCEPT_CONTEXT, lf, 8);
    bytes.free(lf);
    socket.setNonBlock(a);
    return a;
}
/// Stores a synthesised result on `op` and marks it completed, used when a
/// completion arrives via `GetQueuedCompletionStatusEx` rather than through
/// `opResult`'s own accept-specific path.
pub fn setOpResult(op: long, r: int): void { bytes.write_ptr(op, 64, r as long); bytes.write_i32(op, 52, 1); }

const WSA_IO_PENDING: int = 997;

// Normalises a Winsock call's return code: 0 means either it completed
// synchronously or it is correctly queued (WSA_IO_PENDING); anything else is
// a real failure.
fn queued(rc: int): int {
    if (rc == 0) { return 0; }
    return if (winsock.WSAGetLastError() == WSA_IO_PENDING) 0 else -1;
}

// Dispatches `op` to the matching Win32 async call (WSARecv/WSASend/AcceptEx/
// ConnectEx) after resetting its OVERLAPPED header. This is the point where an
// operation record actually becomes "owned by the kernel" until completion.
fn issue(op: long): int {
    nova_io_stat_issued();
    bytes.write_ptr(op, 0, 0);  bytes.write_ptr(op, 8, 0);
    bytes.write_ptr(op, 16, 0); bytes.write_ptr(op, 24, 0);
    let kind = opKind(op);
    let s = opFd(op) as long;
    winsock.setWsaBuf(op + 72, opLen(op), opBuf(op));
    if (kind == OP_RECV) {
        bytes.write_i32(op, 88, 0);
        return queued(winsock.WSARecv(s, (op + 72) as ptr, 1, 0 as ptr, (op + 88) as ptr, op as ptr, 0));
    } else if (kind == OP_SEND) {
        return queued(winsock.WSASend(s, (op + 72) as ptr, 1, 0 as ptr, 0, op as ptr, 0));
    }
    if (kind == OP_ACCEPT) {
        let a = winsock.socket(winsock.AF_INET, winsock.SOCK_STREAM, winsock.IPPROTO_TCP);
        if (a < (0 as long)) { return -1; }
        bytes.write_i32(op, OP_ACCEPTED_OFF, a as int as long);
        bytes.write_i32(op, OP_ACCEPT_FIXED_OFF, 0);
        return queued(winsock.AcceptEx(s, a, (op + (OP_ACCEPT_ADDR_OFF as long)) as ptr, 0,
                                       winsock.ACCEPTEX_ADDRLEN, winsock.ACCEPTEX_ADDRLEN,
                                       0 as ptr, op as ptr));
    } else if (kind == OP_CONNECT) {
        return winsock.nova_wsa_connectex(s, opBuf(op) as ptr, opLen(op), op as ptr);
    }
    return -1;
}

/// Registers `fd` with the IOCP completion port `port`, a required one-time
/// step before the socket's first overlapped operation, or completions are
/// delivered nowhere.
pub fn associate(port: long, fd: int): long {
    return win32.CreateIoCompletionPort(fd as long, port, fd as long, 0);
}

/// Associates the operation's fd with the completion port `kq` if not
/// already associated, then issues the operation.
pub fn submit(kq: int, op: long): int {
    let fd = opFd(op);
    if (fd >= 0 && nova_iocp_mark_associated(fd) != 0) {
        win32.CreateIoCompletionPort(fd as long, kq as long, fd as long, 0);
    }
    return issue(op);
}

/// Cancels any armed zero-byte readiness read on `fd` and clears its
/// association bookkeeping.
pub fn cancelRead(kq: int, fd: int): void {
    dropArm(fd);
    nova_iocp_clear_associated(fd);
}

/// `opDone` value meaning the caller gave up on the operation while it was
/// still outstanding with the kernel: the record must not be freed until the
/// eventual completion for it lands, and drain must free it then rather than
/// deliver a token.
pub const OP_ABANDONED: int = 2;

/// Marks `op` as abandoned and issues `CancelIoEx`, telling the drain loop to
/// free the record on arrival instead of surfacing a completion token.
/// Returns false only when `op` is null. Always returns true otherwise:
/// on IOCP the CALLER does not own the record after this call, the eventual
/// completion does.
pub fn abandonOp(kq: int, op: long): bool {
    if (op == (0 as long)) { return false; }
    bytes.write_i32(op, 52, OP_ABANDONED as long);
    bytes.write_ptr(op, 56, 0);
    let fd = opFd(op);
    if (fd >= 0) { win32.CancelIoEx(fd as long, op as ptr); }
    return true;
}

/// Always true on IOCP: `ConnectEx` is issued synchronously by `issue`, so a
/// connect is always already submitted by the time this would be checked.
pub fn connectIsSubmitted(): bool { return true; }

/// Byte size of one entry in an event/`OVERLAPPED_ENTRY` batch buffer.
pub const EVENT_SIZE: int = 32;

extern("c") fn nova_iocp_mark_associated(fd: int): int;
extern("c") fn nova_iocp_clear_associated(fd: int): void;
extern("c") fn nova_io_stat_issued(): void;
extern("c") fn nova_io_stat_completed(): void;
extern("c") fn nova_io_watchdog_start(): void;
extern("c") fn nova_reactor_arm_get(fd: int): long;
extern("c") fn nova_reactor_arm_set(fd: int, op: long): void;
extern("c") fn nova_op_alloc(size: long): long;
extern("c") fn nova_op_free(op: long): void;

const OP_ARMED_OFF: int = 92;
fn opArmed(op: long): int { return bytes.read_i32(op, OP_ARMED_OFF) as int; }
fn setArmed(op: long, v: int): void { bytes.write_i32(op, OP_ARMED_OFF, v as long); }

// Arms (or refreshes the token on) a zero-byte recv/send used to emulate
// readiness on IOCP: reuses the per-fd pooled op record if one already
// exists and is armed, otherwise allocates one and issues it.
fn armZeroByte(kq: int, fd: int, token: long, kind: int): int {
    if (fd < 0) { return -1; }
    if (nova_iocp_mark_associated(fd) != 0) {
        win32.CreateIoCompletionPort(fd as long, kq as long, fd as long, 0);
    }

    let op = nova_reactor_arm_get(fd);
    if (op == (0 as long)) {
        op = nova_op_alloc(OP_SIZE as long);
        nova_reactor_arm_set(fd, op);
        makeOp(op, kind, fd, 0, 0, token);
        setArmed(op, 1);
        return issue(op);
    }
    if (opArmed(op) != 0) {
        bytes.write_ptr(op, 56, token);
        return 0;
    }
    makeOp(op, kind, fd, 0, 0, token);
    setArmed(op, 1);
    return issue(op);
}

/// Arms a zero-byte receive on `fd` so its completion signals "readable",
/// emulating readiness-style waiting on the completion-based IOCP model.
pub fn armRead(kq: int, fd: int, token: long): int { return armZeroByte(kq, fd, token, OP_RECV); }
/// Arms a zero-byte send on `fd` so its completion signals "writable".
pub fn armWrite(kq: int, fd: int, token: long): int { return armZeroByte(kq, fd, token, OP_SEND); }

// Disarms the pooled zero-byte op for `fd`, if any, and cancels it with the
// kernel; the record itself is left in the per-fd arm map for reuse, not freed.
fn dropArm(fd: int): void {
    let op = nova_reactor_arm_get(fd);
    if (op == (0 as long)) { return; }
    if (opArmed(op) != 0) {
        setArmed(op, 0);
        if (fd >= 0) { win32.CancelIoEx(fd as long, op as ptr); }
    }
}
/// Cancels any armed zero-byte readiness write on `fd`.
pub fn cancelWrite(kq: int, fd: int): void { dropArm(fd); }

/// Blocks on the completion port `kq` for up to `timeoutMs` and fills
/// `eventBuf` (an `OVERLAPPED_ENTRY` array of capacity `maxEvents`) with
/// however many completions arrived. Returns the count, or 0 on timeout.
pub fn waitReady(kq: int, eventBuf: long, maxEvents: int, timeoutMs: int): int {
    let removed = bytes.alloc(4);
    bytes.write_i32(removed, 0, 0);
    let ok = win32.GetQueuedCompletionStatusEx(kq as long, eventBuf as ptr, maxEvents, removed, timeoutMs, 0);
    let n = if (ok != 0) (bytes.read_i32(removed, 0) as int) else 0;
    bytes.free(removed);
    return n;
}

/// Extracts the caller token for completion entry `i` in `eventBuf`: the
/// timer's own token for a fired deadline, zero for a wake or a null
/// overlapped, or the token stored on the completed `op` otherwise. Also
/// stashes the transferred byte count onto the op via `setOpResult` as a
/// side effect, so `opResult` reflects it afterwards.
pub fn evToken(eventBuf: long, i: int): long {
    let key = win32.entryKey(eventBuf, i);
    let ov = win32.entryOverlapped(eventBuf, i);
    if (key == TIMER_KEY) { return ov; }
    if (key == WAKE_KEY) { return 0 as long; }
    if (ov == (0 as long)) { return 0 as long; }
    setOpResult(ov, win32.entryBytes(eventBuf, i));
    return opToken(ov);
}

/// Extracts the socket/handle for completion entry `i`, or -1 for a timer or
/// wake entry (the completion key IS the fd for real I/O completions, since
/// `associate` passes `fd` as the completion key).
pub fn evFd(eventBuf: long, i: int): int {
    let key = win32.entryKey(eventBuf, i);
    if (key == TIMER_KEY || key == WAKE_KEY) { return -1; }
    return key as int;
}

const FIONREAD: long = 1074030207;
/// Bytes available to read for completion entry `i`. Prefers the byte count
/// IOCP reported directly; falls back to an `ioctlsocket(FIONREAD)` probe
/// when that is 0, which happens for a zero-byte readiness completion
/// (`armRead`) that has no transfer count of its own to report.
pub fn evBytes(eventBuf: long, i: int): long {
    let n = win32.entryBytes(eventBuf, i) as long;
    if (n > (0 as long)) { return n; }
    let fd = evFd(eventBuf, i);
    if (fd < 0) { return 0 as long; }
    let cnt = bytes.alloc(4);
    bytes.write_i32(cnt, 0, 0);
    let r = winsock.ioctlsocket(fd as long, FIONREAD, cnt);
    let avail = if (r == 0) (bytes.read_i32(cnt, 0) as long) else (0 as long);
    bytes.free(cnt);
    return avail;
}
/// True when a completed read transferred zero bytes, the usual signal for
/// an orderly peer close.
pub fn evEof(eventBuf: long, i: int): bool { return win32.entryBytes(eventBuf, i) == 0; }
/// No-op on IOCP: readiness/completion "filter" distinctions (read vs
/// write) do not apply the way they do on kqueue/epoll, so this always
/// returns 0. Kept so callers can stay backend-agnostic.
pub fn evFilterAt(eventBuf: long, i: int): int { return 0; }

/// The backend-agnostic reactor surface every `net/ev/*` poller implements,
/// letting the rest of the runtime submit operations and drain completions
/// without knowing whether it is talking to kqueue, epoll, io_uring, or IOCP.
pub trait EventLoop {
    fn submit(self, op: long): int;
    fn poll(self, timeoutMs: int): int;
    fn completedToken(self, i: int): long;
    fn ok(self): bool;
    fn destroy(self): void;
}

/// IOCP-backed `EventLoop`: owns the completion port handle plus the
/// scratch buffers used to receive and translate a batch of completions.
pub class Poller impl EventLoop {
    /// The Win32 `HANDLE` of the IOCP completion port.
    pub port: long,
    /// `port` truncated to `int`, used where the generic reactor API
    /// expects a small integer "kqueue-style" descriptor.
    pub kq: int,
    /// Raw `OVERLAPPED_ENTRY` array filled by `GetQueuedCompletionStatusEx`.
    pub eventBuf: long,
    /// Tokens extracted from the last `poll`, ready for `completedToken`.
    pub compBuf: long,
    /// Scratch 4-byte buffer receiving the removed-entry count from
    /// `GetQueuedCompletionStatusEx`.
    pub removedBuf: long,
    /// Capacity, in entries, of `eventBuf`/`compBuf`.
    pub maxEvents: int,
    /// Number of valid entries in `compBuf` after the last `poll`.
    pub nComp: int,

    /// Creates the completion port, starts the I/O watchdog, and allocates
    /// the per-poll scratch buffers sized for `maxEvents` completions.
    init(maxEvents: int) {
        winsock.startup();
        self.port = win32.CreateIoCompletionPort(win32.INVALID_HANDLE, 0, 0, 0);
        self.kq = self.port as int;
        self.maxEvents = maxEvents;
        nova_io_watchdog_start();
        self.eventBuf = bytes.alloc(maxEvents * win32.OVERLAPPED_ENTRY_SIZE);
        self.compBuf = bytes.alloc(maxEvents * 8);
        self.removedBuf = bytes.alloc(4);
        self.nComp = 0;
    }

    /// True if the completion port was created successfully.
    fn ok(self: Poller): bool { return self.port != (0 as long); }

    // Associates fd with this poller's port on first use only, tracked via
    // nova_iocp_mark_associated so repeated submits skip the syscall.
    fn ensureAssociated(self: Poller, fd: int): void {
        if (fd <= 0) { return; }
        if (nova_iocp_mark_associated(fd) != 0) {
            win32.CreateIoCompletionPort(fd as long, self.port, fd as long, 0);
        }
    }

    /// Associates the operation's fd with this poller if needed, then issues it.
    fn submit(self: Poller, op: long): int {
        self.ensureAssociated(opFd(op));
        return issue(op);
    }

    /// Waits up to `timeoutMs` for completions and translates each into a
    /// token in `compBuf`: a fired timer's own token, a completed op's
    /// caller token (freeing the record immediately if it was abandoned),
    /// or nothing for a wake entry. Returns the number of tokens produced.
    fn poll(self: Poller, timeoutMs: int): int {
        self.nComp = 0;
        bytes.write_i32(self.removedBuf, 0, 0);
        let ok = win32.GetQueuedCompletionStatusEx(self.port, self.eventBuf, self.maxEvents, self.removedBuf, timeoutMs, 0);
        if (ok != 0) {
            let n = bytes.read_i32(self.removedBuf, 0) as int;
            let i = 0;
            while (i < n) {
                let key = win32.entryKey(self.eventBuf, i);
                let ov = win32.entryOverlapped(self.eventBuf, i);
                if (key == TIMER_KEY) {
                    if (ov != (0 as long)) {
                        bytes.write_ptr(self.compBuf, (self.nComp * 8) as long, ov);
                        self.nComp = self.nComp + 1;
                    }
                } else if (key == WAKE_KEY) {
                } else if (ov != (0 as long)) {
                    nova_io_stat_completed();
                    if (opDone(ov) == OP_ABANDONED) {
                        nova_op_free(ov);
                    } else {
                        setArmed(ov, 0);
                        setOpResult(ov, win32.entryBytes(self.eventBuf, i));
                        bytes.write_ptr(self.compBuf, (self.nComp * 8) as long, opToken(ov));
                        self.nComp = self.nComp + 1;
                    }
                }
                i = i + 1;
            }
        }
        return self.nComp;
    }

    /// Returns the `i`-th token produced by the last `poll` call.
    fn completedToken(self: Poller, i: int): long {
        return bytes.read_ptr(self.compBuf, (i * 8) as long);
    }

    /// Frees the scratch buffers and closes the completion port. Safe to
    /// call more than once; each field is zeroed after release.
    fn destroy(self: Poller): void {
        if (self.eventBuf != 0) { bytes.free(self.eventBuf); self.eventBuf = 0; }
        if (self.compBuf != 0) { bytes.free(self.compBuf); self.compBuf = 0; }
        if (self.removedBuf != 0) { bytes.free(self.removedBuf); self.removedBuf = 0; }
        if (self.port != (0 as long)) { win32.CloseHandle(self.port); self.port = 0; }
    }
}
