//! Linux reactor backend: epoll (readiness) plus an optional io_uring (completion) path.
//!
//! This module is the Linux half of the reactor abstraction that `net/ev` exposes to the rest of
//! the standard library. It defines the fixed-layout "op" record that carries a pending I/O request
//! (kind, fd, buffer, length, token, result) between the coroutine that issued it and the poller
//! that completes it, plus two ways of driving that record to completion: classic `epoll_wait`
//! readiness notification, or io_uring submission queue entries when the runtime has selected the
//! completion-based backend (`usingUring()`). Callers generally use the free functions
//! (`submit`, `armRead`/`armWrite`, `waitReady`, `evFd`/`evToken`/`evEof`) or the `Poller` class,
//! which wraps an epoll or io_uring instance behind the shared `EventLoop` trait so the rest of the
//! runtime does not need to know which backend is active.
//!
//! On io_uring, readiness is emulated with one-shot `POLL_ADD` submissions tracked per fd
//! (`nova_reactor_arm_*`), because a completion engine has no "tell me when readable" primitive of
//! its own. Abandoned operations are never freed directly here: the kernel still holds a reference
//! to the op record until the operation completes or is cancelled, so `abandonOp` marks the record
//! and lets the drain path free it once the completion lands (see the io_uring notes in
//! `lang/CLAUDE.md` for the full rationale).

import bytes;
import os.socket;
import os.linux.epoll;

/// Op kind: a pending non-blocking `recv`.
pub const OP_RECV: int = 0;
/// Op kind: a pending non-blocking `send`.
pub const OP_SEND: int = 1;
/// Op kind: a pending non-blocking `accept`.
pub const OP_ACCEPT: int = 2;
/// Op kind: a pending non-blocking `connect` (readiness signalled via writability).
pub const OP_CONNECT: int = 3;
/// Op kind: a readiness-only wait for POLLIN (used to emulate readiness on io_uring).
pub const OP_POLL_IN: int = 4;
/// Op kind: a readiness-only wait for POLLOUT (used to emulate readiness on io_uring).
pub const OP_POLL_OUT: int = 5;
/// Op kind: a pending fd-passing `recvmsg` (SCM_RIGHTS).
pub const OP_RECVFD: int = 6;

const POLLIN_BIT: int = 1;
const POLLOUT_BIT: int = 4;
const POLLERR_BIT: int = 8;
const POLLHUP_BIT: int = 16;
const POLLRDHUP_BIT: int = 8192;

/// Size in bytes of one op record, as laid out by `makeOp` (kind, fd, buf ptr, len, done flag,
/// token ptr, result ptr).
pub const OP_SIZE: int = 40;

/// Initialises an op record at `op` (a buffer of at least `OP_SIZE` bytes) with the given kind,
/// file descriptor, buffer address, length, and caller token. Clears the done flag and result slot.
pub fn makeOp(op: long, kind: int, fd: int, buf: long, len: int, token: long): void {
    bytes.write_i32(op, 0, kind as long);
    bytes.write_i32(op, 4, fd as long);
    bytes.write_ptr(op, 8, buf);
    bytes.write_i32(op, 16, len as long);
    bytes.write_i32(op, 20, 0);
    bytes.write_ptr(op, 24, token);
    bytes.write_ptr(op, 32, 0);
}
/// Reads the op kind (one of the `OP_*` constants) from an op record.
pub fn opKind(op: long): int { return bytes.read_i32(op, 0) as int; }
/// Reads the file descriptor an op record targets.
pub fn opFd(op: long): int { return bytes.read_i32(op, 4) as int; }
/// Reads the buffer address an op record reads into or writes from.
pub fn opBuf(op: long): long { return bytes.read_ptr(op, 8); }
/// Reads the requested buffer length for an op record.
pub fn opLen(op: long): int { return bytes.read_i32(op, 16) as int; }
/// Reads the done/status flag: 0 while pending, 1 once `setOpResult` has run, or `OP_ABANDONED`
/// if the caller gave up on the op while the kernel still held it.
pub fn opDone(op: long): int { return bytes.read_i32(op, 20) as int; }
/// Reads the caller-supplied token that identifies which coroutine/waiter owns this op.
pub fn opToken(op: long): long { return bytes.read_ptr(op, 24); }
/// Reads the completed op's result (bytes transferred, accepted fd, or a negative error code).
pub fn opResult(op: long): int { return bytes.read_ptr(op, 32) as int; }
/// Stores the completion result into an op record and marks it done.
pub fn setOpResult(op: long, r: int): void { bytes.write_ptr(op, 32, r as long); bytes.write_i32(op, 20, 1); }

// Chooses the epoll interest mask for an op kind: EPOLLOUT for send/connect, EPOLLIN otherwise, both one-shot.
fn eventsFor(kind: int): int {
    if (kind == OP_SEND || kind == OP_CONNECT) { return epoll.EPOLLOUT | epoll.EPOLLONESHOT; }
    return epoll.EPOLLIN | epoll.EPOLLONESHOT;
}

extern("c") fn nova_epoll_mark_registered(fd: int): int;
extern("c") fn nova_epoll_clear_registered(fd: int): void;

// Registers or re-arms a fd's epoll interest: ADD on first use, MOD thereafter (avoids a redundant
// ADD/DEL pair per keep-alive request; see the persistent-registration note in lang/CLAUDE.md).
fn arm(kq: int, fd: int, events: int, data: long): int {
    if (nova_epoll_mark_registered(fd) != 0) { return epoll.ctlAdd(kq, fd, events, data); }
    return epoll.ctlMod(kq, fd, events, data);
}

/// Submits an op for the given epoll instance `kq`. On io_uring, stages (and, if the submission
/// queue is full, flushes) an SQE instead; on epoll, arms the fd for the interest matching the
/// op's kind. Returns 0 on success, -1 on failure.
pub fn submit(kq: int, op: long): int {
    let ring = if (usingUring()) nova_uring_current() else (0 as long);
    if (ring != (0 as long)) {
        if (uringPrep(ring, op) != 0) { return -1; }
        return if (nova_uring_submit_and_wait(ring, 0) >= 0) 0 else -1;
    }
    return arm(kq, opFd(op), eventsFor(opKind(op)), op);
}

/// Done-flag value marking an op record that the caller has given up on while the kernel may still
/// hold a reference to it; the drain path frees it once the completion actually arrives.
pub const OP_ABANDONED: int = 2;

/// Gives up on a pending op without freeing it out from under the kernel. Returns `true` when the
/// caller must NOT free `op` yet (io_uring: the record is marked `OP_ABANDONED` and cancellation is
/// requested; the drain path frees it on completion). Returns `false` on epoll, where deregistering
/// the interest is enough and the caller may free the record immediately.
pub fn abandonOp(kq: int, op: long): bool {
    if (op == (0 as long)) { return false; }
    if (!usingUring()) {
        cancelRead(kq, opFd(op));
        return false;
    }
    bytes.write_i32(op, 20, OP_ABANDONED as long);
    bytes.write_ptr(op, 24, 0);
    let ring = nova_uring_current();
    if (ring != (0 as long)) {
        nova_uring_prep(ring, nova_uring_op_async_cancel(), -1, op, 0, 0, 0);
    }
    return true;
}

/// Cancels a pending read/poll interest on `fd` and clears its registration state.
pub fn cancelRead(kq: int, fd: int): void {
    if (usingUring()) { dropArm(fd); return; }
    epoll.ctlDel(kq, fd);
    nova_epoll_clear_registered(fd);
}

/// True when a `connect` op is submitted to the kernel as part of `submit` itself (io_uring); false
/// when it is only armed for a later writability notification (epoll).
pub fn connectIsSubmitted(): bool { return usingUring(); }

/// Size in bytes of one entry in the io_uring completion event buffer (user_data + result word).
pub const EVENT_SIZE: int = 12;

extern("c") fn nova_reactor_arm_get(fd: int): long;
extern("c") fn nova_reactor_arm_set(fd: int, op: long): void;
extern("c") fn nova_reactor_rearm_push(op: long): void;
extern("c") fn nova_reactor_rearm_pop(): long;
extern("c") fn nova_op_alloc(size: long): long;
extern("c") fn nova_op_free(op: long): void;

// Reads whether a poll-emulation op record currently has an outstanding SQE (io_uring only).
fn opArmed(op: long): int { return bytes.read_i32(op, 20) as int; }
fn setArmed(op: long, v: int): void { bytes.write_i32(op, 20, v as long); }

// Arms (or re-arms) io_uring poll-emulated readiness for `fd`: reuses the per-fd op record if one
// already exists, and only submits a fresh SQE if the previous one is not still outstanding.
fn armPoll(fd: int, token: long, kind: int): int {
    if (fd < 0) { return -1; }
    let op = nova_reactor_arm_get(fd);
    if (op == (0 as long)) {
        op = nova_op_alloc(OP_SIZE as long);
        nova_reactor_arm_set(fd, op);
        makeOp(op, kind, fd, 0, 0, token);
        setArmed(op, 1);
        return stageUring(nova_uring_current(), op);
    }
    let wasArmed = opArmed(op);
    makeOp(op, kind, fd, 0, 0, token);
    setArmed(op, 1);
    if (wasArmed != 0) { return 0; }
    return stageUring(nova_uring_current(), op);
}

// Cancels the outstanding io_uring poll-emulation SQE for `fd` and EVICTS the record from the per-fd
// arm map, handing ownership to the drain.
//
// The eviction is the point. `cancelRead` means "I am done with this descriptor" -- every caller
// closes it immediately afterwards -- and the arm map is keyed by FILE DESCRIPTOR NUMBER, which the
// kernel recycles aggressively (always the lowest free one). Leaving the record mapped meant the next
// accepted or handed-off socket, which reliably gets the SAME number back, inherited the previous
// connection's arm record and re-armed it instead of arming itself. That is precisely the hazard the
// IOCP path documents for `g_iocp_associated` ("the memo must be cleared the moment a socket closes")
// and that epoll clears via `nova_epoll_clear_registered`; io_uring was the one backend with no
// equivalent. Observed on the fd-handoff worker, where every request came back as fd 5.
//
// The record itself is NOT freed here: the kernel still holds it as the POLL_ADD's user_data until
// the cancellation lands. It is marked OP_ABANDONED, and `uringWaitReady` frees it when that poll
// completes with -ECANCELED. Note the POLL_REMOVE is deliberately submitted with user_data 0 rather
// than `op`, so exactly ONE completion carries the record and there is no double free.
fn dropArm(fd: int): void {
    let op = nova_reactor_arm_get(fd);
    if (op == (0 as long)) { return; }
    let ring = nova_uring_current();
    let wasArmed = opArmed(op);
    nova_reactor_arm_set(fd, 0);
    if (wasArmed != 0 && ring != (0 as long)) {
        bytes.write_i32(op, 20, OP_ABANDONED as long);
        nova_uring_prep(ring, nova_uring_op_poll_remove(), -1, op, 0, 0, 0);
        return;
    }
    // Never submitted (or no ring to cancel against): nothing in the kernel refers to it, so the
    // record is ours to release right now.
    setArmed(op, 0);
    nova_op_free(op);
}

/// Arms readiness notification for readability on `fd`, tagged with `token`. On epoll this is a
/// plain `EPOLL_CTL_ADD`; on io_uring it emulates readiness with a poll-add SQE.
pub fn armRead(kq: int, fd: int, token: long): int {
    if (usingUring()) { return armPoll(fd, token, OP_POLL_IN); }
    return epoll.ctlAdd(kq, fd, epoll.EPOLLIN, token);
}
/// Arms readiness notification for writability on `fd`, tagged with `token`, one-shot on epoll.
pub fn armWrite(kq: int, fd: int, token: long): int {
    if (usingUring()) { return armPoll(fd, token, OP_POLL_OUT); }
    return epoll.ctlAdd(kq, fd, epoll.EPOLLOUT | epoll.EPOLLONESHOT, token);
}
/// Cancels a previously armed write-readiness notification on `fd`.
pub fn cancelWrite(kq: int, fd: int): void {
    if (usingUring()) { dropArm(fd); return; }
    epoll.ctlDel(kq, fd);
}

const URING_EV_DATA_OFF: int = 0;
const URING_EV_RES_OFF: int = 8;

// Checks whether `raw` (a user_data word) was already written into this batch's event buffer, so a
// completion is not reported twice within the same drain.
fn slotSeen(eventBuf: long, written: int, raw: long): bool {
    let j = 0;
    while (j < written) {
        if (bytes.read_ptr(eventBuf + ((j * EVENT_SIZE) as long), URING_EV_DATA_OFF) == raw) {
            return true;
        }
        j = j + 1;
    }
    return false;
}

// io_uring implementation of waitReady: flushes any pending re-arms, submits and waits for at least
// one completion OR for `timeoutMs`, then drains the completion queue into eventBuf. Filters out
// poll-emulation completions that were re-armed rather than surfaced (a POLLIN wait with none of the
// interesting bits set gets pushed back onto the pending queue instead of being reported).
//
// `timeoutMs` used to be dropped here, which quietly turned every `poll(ms)` into an unbounded wait
// on this backend -- correct-looking whenever traffic happened to arrive, and a permanent hang on an
// idle descriptor. A negative value still means "wait indefinitely", matching epoll_wait.
fn uringWaitReady(eventBuf: long, maxEvents: int, timeoutMs: int): int {
    let ring = nova_uring_current();
    if (ring == (0 as long)) { return 0; }
    let pending = nova_reactor_rearm_pop();
    while (pending != (0 as long)) {
        if (opArmed(pending) == 0) {
            if (stageUring(ring, pending) == 0) {
                setArmed(pending, 1);
            } else {
                nova_reactor_rearm_push(pending);
                pending = 0;
                continue;
            }
        }
        pending = nova_reactor_rearm_pop();
    }
    nova_uring_submit_and_wait_ms(ring, 1, timeoutMs as long);
    let ready = nova_uring_cq_ready(ring);
    let ud = bytes.alloc(8);
    let res = bytes.alloc(4);
    let consumed = 0;
    let written = 0;
    while (consumed < ready && written < maxEvents) {
        let i = consumed;
        nova_uring_peek(ring, i, ud, res);
        let slot = eventBuf + ((written * EVENT_SIZE) as long);
        let raw = bytes.read_ptr(ud, 0);
        if (raw == WAKE_DATA) { nova_uring_wake_drain(); }
        // The bounded-wait timeout SQE staged by nova_uring_submit_and_wait_ms. It is bookkeeping,
        // not an event anyone asked for, so consume it without reporting; carries -ETIME on expiry.
        if (raw == nova_uring_wait_timeout_data()) {
            consumed = consumed + 1;
            continue;
        }
        let drop = false;
        // A zero user_data belongs to no operation the caller can act on -- it is what `dropArm`
        // submits its POLL_REMOVE with. Reporting it wrote a slot whose data word was 0, so the
        // caller read back readyFd == -1, tried to read from it, and got EBADF. `pollUring` already
        // guards this with its `tok == 0` check; this path did not, and the bogus event surfaced as
        // a "readable" descriptor that could not be read. Consume it and move on.
        if (raw == (0 as long)) {
            consumed = consumed + 1;
            continue;
        }
        if (isOpRecordWord(raw)) {
            let r = bytes.read_i32(res, 0) as int;
            // An abandoned record's fd is gone (see `dropArm`). This completion is the cancellation
            // landing, and it is the LAST reference the kernel holds, so free it here. It must never
            // be re-armed: that would arm whatever socket has since inherited the descriptor number.
            if (opDone(raw) == OP_ABANDONED) {
                nova_op_free(raw);
                consumed = consumed + 1;
                continue;
            }
            if (opKind(raw) == OP_POLL_IN || opKind(raw) == OP_POLL_OUT) {
                setArmed(raw, 0);
                if (r >= 0 && opKind(raw) == OP_POLL_IN
                    && (r & (POLLIN_BIT | POLLHUP_BIT | POLLERR_BIT | POLLRDHUP_BIT)) == 0) {
                    nova_reactor_rearm_push(raw);
                    drop = true;
                }
                if (r >= 0 && !drop) {
                    if (opKind(raw) == OP_POLL_IN) { nova_reactor_rearm_push(raw); }
                } else {
                    drop = true;
                }
            }
        }
        if (drop) {
            consumed = consumed + 1;
            continue;
        }
        if (!slotSeen(eventBuf, written, raw)) {
            bytes.write_ptr(slot, URING_EV_DATA_OFF, raw);
            bytes.write_i32(slot, URING_EV_RES_OFF, bytes.read_i32(res, 0));
            written = written + 1;
        }
        consumed = consumed + 1;
    }
    bytes.free(ud);
    bytes.free(res);
    if (consumed > 0) { nova_uring_advance(ring, consumed); }
    return written;
}

/// Blocks (up to `timeoutMs`, or indefinitely under io_uring's own wait-for-one semantics) until at
/// least one event is ready, writes up to `maxEvents` entries into `eventBuf`, and returns the count
/// written. Dispatches to `epoll_wait` or the io_uring drain depending on the active backend.
pub fn waitReady(kq: int, eventBuf: long, maxEvents: int, timeoutMs: int): int {
    if (usingUring()) { return uringWaitReady(eventBuf, maxEvents, timeoutMs); }
    return epoll.epoll_wait(kq, eventBuf, maxEvents, timeoutMs);
}

// Reads the raw user_data/epoll-data word for event slot `i`, backend-appropriate.
fn evRaw(eventBuf: long, i: int): long {
    if (usingUring()) {
        return bytes.read_ptr(eventBuf + ((i * epoll.EPOLL_EVENT_SIZE()) as long), URING_EV_DATA_OFF);
    }
    return epoll.evData(eventBuf, i);
}

// True when a raw event word `d` is itself an op record pointer (its token maps back to itself),
// as opposed to a plain token value or the reserved wake sentinel.
fn isOpRecordWord(d: long): bool {
    return d != (0 as long) && d != WAKE_DATA && nova_reactor_event_token(d) == d;
}

/// Returns the file descriptor associated with event slot `i`, or -1 on io_uring when the slot is
/// not an op record (e.g. a plain wake or token-only completion).
pub fn evFd(eventBuf: long, i: int): int {
    let d = evRaw(eventBuf, i);
    if (usingUring()) { return if (isOpRecordWord(d)) opFd(d) else -1; }
    return d as int;
}

/// Resolves a raw epoll/io_uring data word to the caller token it represents (identity for plain
/// tokens, or the token stored inside an op record when the word is an op pointer).
pub extern("c") fn nova_reactor_event_token(data: long): long;

/// Returns which reactor backend is active for this process (see `BACKEND_URING`).
pub extern("c") fn nova_reactor_backend(): int;
/// Creates an io_uring instance with the given submission queue depth. Returns 0 on failure.
pub extern("c") fn nova_uring_create(entries: int): long;
/// Tears down an io_uring instance created by `nova_uring_create`.
pub extern("c") fn nova_uring_destroy(ring: long): void;
/// Sets the thread-local "current" io_uring instance that free functions like `submit` target.
pub extern("c") fn nova_uring_set_current(ring: long): void;
/// Returns the thread-local "current" io_uring instance, or 0 if none is set.
pub extern("c") fn nova_uring_current(): long;
/// Returns the raw file descriptor backing an io_uring instance.
pub extern("c") fn nova_uring_fd(ring: long): int;
/// Prepares (stages, without submitting) one submission queue entry. Returns 0 on success.
pub extern("c") fn nova_uring_prep(ring: long, op: int, fd: int, addr: long, len: int, off: long, userData: long): int;
/// Submits all staged SQEs and waits for at least `waitNr` completions.
pub extern("c") fn nova_uring_submit_and_wait(ring: long, waitNr: int): int;
/// Submit, then wait for a completion or for `ms` milliseconds; `ms < 0` waits indefinitely.
pub extern("c") fn nova_uring_submit_and_wait_ms(ring: long, waitNr: int, ms: long): int;
/// The reserved user_data carried by the bounded-wait timeout SQE, so the drain can drop it.
pub extern("c") fn nova_uring_wait_timeout_data(): long;
/// Returns how many completions are currently ready on the completion queue.
pub extern("c") fn nova_uring_cq_ready(ring: long): int;
/// Reads the user_data and result of completion queue entry `i` without consuming it.
pub extern("c") fn nova_uring_peek(ring: long, i: int, userData: ptr, res: ptr): int;
/// Marks the first `n` completion queue entries as consumed.
pub extern("c") fn nova_uring_advance(ring: long, n: int): void;
/// Drains the cross-reactor wake eventfd after a wake completion fires.
pub extern("c") fn nova_uring_wake_drain(): void;
/// io_uring opcode constant for `IORING_OP_RECV`.
pub extern("c") fn nova_uring_op_recv(): int;
/// io_uring opcode constant for `IORING_OP_SEND`.
pub extern("c") fn nova_uring_op_send(): int;
/// io_uring opcode constant for `IORING_OP_ACCEPT`.
pub extern("c") fn nova_uring_op_accept(): int;
/// io_uring opcode constant for `IORING_OP_CONNECT`.
pub extern("c") fn nova_uring_op_connect(): int;
/// io_uring opcode constant for `IORING_OP_POLL_ADD`.
pub extern("c") fn nova_uring_op_poll_add(): int;
/// io_uring opcode constant for `IORING_OP_POLL_REMOVE`.
pub extern("c") fn nova_uring_op_poll_remove(): int;
/// io_uring opcode constant for `IORING_OP_ASYNC_CANCEL`.
pub extern("c") fn nova_uring_op_async_cancel(): int;
/// io_uring poll-add flag requesting multishot (repeating) notification.
pub extern("c") fn nova_uring_poll_add_multi(): int;
/// Completion queue entry flag indicating more completions will follow for a multishot request.
pub extern("c") fn nova_uring_cqe_f_more(): int;
/// Reads the flags word of completion queue entry `i` without consuming it.
pub extern("c") fn nova_uring_peek_flags(ring: long, i: int): int;

/// `nova_reactor_backend()` value meaning io_uring is the active backend (readiness-based epoll is
/// the implicit alternative).
pub const BACKEND_URING: int = 1;
/// True when the process is using the io_uring (completion) backend rather than epoll (readiness).
pub fn usingUring(): bool { return nova_reactor_backend() == BACKEND_URING; }

// Stages an op's SQE; if the submission queue is full, flushes the batch and retries once.
fn stageUring(ring: long, op: long): int {
    if (uringPrep(ring, op) == 0) { return 0; }
    if (nova_uring_submit_and_wait(ring, 0) < 0) { return -1; }
    return uringPrep(ring, op);
}

// Translates an op record's kind into the matching io_uring SQE, using the op pointer itself as
// user_data so the completion can be traced back to it.
fn uringPrep(ring: long, op: long): int {
    let kind = opKind(op);
    let fd = opFd(op);
    if (kind == OP_RECV) {
        return nova_uring_prep(ring, nova_uring_op_recv(), fd, opBuf(op), opLen(op), 0, op);
    } else if (kind == OP_SEND) {
        return nova_uring_prep(ring, nova_uring_op_send(), fd, opBuf(op), opLen(op), 0, op);
    } else if (kind == OP_ACCEPT) {
        return nova_uring_prep(ring, nova_uring_op_accept(), fd, 0, 0, 0, op);
    } else if (kind == OP_CONNECT) {
        return nova_uring_prep(ring, nova_uring_op_connect(), fd, opBuf(op), 0, opLen(op) as long, op);
    } else if (kind == OP_POLL_IN) {
        return nova_uring_prep(ring, nova_uring_op_poll_add(), fd, 0, 0, POLLIN_BIT as long, op);
    } else if (kind == OP_POLL_OUT) {
        return nova_uring_prep(ring, nova_uring_op_poll_add(), fd, 0, 0, POLLOUT_BIT as long, op);
    }
    return -1;
}
/// Returns the caller token for event slot `i`: resolved via `nova_reactor_event_token` for plain
/// tokens, or read out of the op record itself when the raw word is an op pointer under io_uring.
pub fn evToken(eventBuf: long, i: int): long {
    let d = evRaw(eventBuf, i);
    let tok = nova_reactor_event_token(d);
    if (usingUring() && d == tok && d != (0 as long)) { return opToken(d); }
    return tok;
}
// Wraps FIONREAD, used to size a read after a zero-byte readiness completion reports no count.
extern("c") fn nova_fionread(fd: int): long;
/// Returns the number of bytes currently available to read on the fd behind event slot `i`, via
/// `FIONREAD`. Needed on io_uring, where a readiness completion carries no byte count of its own.
pub fn evBytes(eventBuf: long, i: int): long {
    return nova_fionread(evFd(eventBuf, i));
}
/// True when event slot `i` indicates the peer closed or the connection errored (HUP/RDHUP/ERR on
/// epoll, or a negative/HUP-equivalent result on io_uring).
pub fn evEof(eventBuf: long, i: int): bool {
    if (usingUring()) {
        let res = bytes.read_i32(eventBuf + ((i * EVENT_SIZE) as long), URING_EV_RES_OFF) as int;
        if (res < 0) { return true; }
        return (res & (POLLHUP_BIT | POLLRDHUP_BIT | POLLERR_BIT)) != 0;
    }
    return (epoll.evEvents(eventBuf, i) & (epoll.EPOLLHUP | epoll.EPOLLRDHUP)) != 0;
}
// Reserved user_data value used by the cross-reactor wake eventfd.
const WAKE_DATA: long = -1;
// Synthetic filter value returned by evFilterAt for a user-initiated wake, not a real epoll event mask.
const USER_FILTER: int = -2;
/// Returns the epoll event mask for slot `i` (or `USER_FILTER` for a cross-reactor wake, or 0 on
/// io_uring where there is no equivalent mask).
pub fn evFilterAt(eventBuf: long, i: int): int {
    if (evRaw(eventBuf, i) == WAKE_DATA) { return USER_FILTER; }
    if (usingUring()) { return 0; }
    return epoll.evEvents(eventBuf, i);
}

/// Backend-agnostic reactor interface: submit an op, poll for completions, and read back the
/// tokens that completed in the last poll. `Poller` is the only implementation in this module.
pub trait EventLoop {
    /// Submits an op for later completion. Returns 0 on success, -1 on failure.
    fn submit(self, op: long): int;
    /// Polls for completions (blocking up to `timeoutMs` on epoll), returning the completed count.
    fn poll(self, timeoutMs: int): int;
    /// Returns the token of the `i`-th completion from the most recent `poll` call.
    fn completedToken(self, i: int): long;
    /// True when the underlying epoll/io_uring instance was created successfully.
    fn ok(self): bool;
    /// Releases the poller's buffers and closes its epoll fd or destroys its io_uring instance.
    fn destroy(self): void;
}

/// Reactor driving either epoll (readiness) or io_uring (completion), chosen once at construction
/// via `usingUring()`. Owns the kernel instance, the raw event buffer the kernel writes into, and a
/// separate `compBuf` of resolved caller tokens that `completedToken` reads from after each `poll`.
pub class Poller impl EventLoop {
    /// The epoll instance fd, or (when io_uring is active) the io_uring instance's own fd.
    pub kq: int,
    /// The io_uring instance handle, or 0 when running on epoll.
    pub ring: long,
    /// Raw kernel event buffer: epoll events, or io_uring completion queue entries.
    pub eventBuf: long,
    /// Resolved caller tokens for the completions produced by the most recent `poll` call.
    pub compBuf: long,
    /// Scratch buffer for reading one io_uring completion's user_data (io_uring only).
    pub udBuf: long,
    /// Scratch buffer for reading one io_uring completion's result (io_uring only).
    pub resBuf: long,
    /// Capacity, in events, of `eventBuf` and `compBuf`.
    pub maxEvents: int,
    /// Number of completions produced by the most recent `poll` call.
    pub nComp: int,

    /// Creates a poller sized for up to `maxEvents` events per `poll` call, selecting epoll or
    /// io_uring per `usingUring()` and allocating the buffers each backend needs.
    init(maxEvents: int) {
        self.maxEvents = maxEvents;
        self.compBuf = bytes.alloc(maxEvents * 8);
        self.nComp = 0;
        self.ring = 0;
        if (usingUring()) {
            self.ring = nova_uring_create(maxEvents * 2);
            nova_uring_set_current(self.ring);
            self.kq = nova_uring_fd(self.ring);
            self.eventBuf = bytes.alloc(maxEvents * EVENT_SIZE);
            self.udBuf = bytes.alloc(8);
            self.resBuf = bytes.alloc(4);
        } else {
            self.kq = epoll.epoll_create1(0);
            self.eventBuf = bytes.alloc(maxEvents * epoll.EPOLL_EVENT_SIZE());
            self.udBuf = 0;
            self.resBuf = 0;
        }
    }

    /// True when the epoll fd (or io_uring instance) was created successfully.
    fn ok(self: Poller): bool {
        if (self.ring != (0 as long)) { return true; }
        return self.kq >= 0;
    }

    /// Submits an op via io_uring staging or epoll arming, depending on the active backend.
    fn submit(self: Poller, op: long): int {
        if (self.ring != (0 as long)) { return stageUring(self.ring, op); }
        return arm(self.kq, opFd(op), eventsFor(opKind(op)), op);
    }

    /// Waits up to `timeoutMs` for epoll events, then drives each ready op to completion in place
    /// (issuing the actual `recv`/`send`/`accept`/`connect` syscall for it) before recording its
    /// token in `compBuf`. On io_uring, delegates to `pollUring` instead. Returns `nComp`.
    fn poll(self: Poller, timeoutMs: int): int {
        if (self.ring != (0 as long)) { return self.pollUring(timeoutMs); }
        let n = epoll.epoll_wait(self.kq, self.eventBuf, self.maxEvents, timeoutMs);
        self.nComp = 0;
        let i = 0;
        while (i < n) {
            let raw = epoll.evData(self.eventBuf, i);
            let tok = nova_reactor_event_token(raw);
            if (raw != tok || tok == (0 as long)) {
                if (tok != (0 as long)) {
                    bytes.write_ptr(self.compBuf, (self.nComp * 8) as long, tok);
                    self.nComp = self.nComp + 1;
                }
                i = i + 1;
                continue;
            }
            let op = raw;
            if (op != (0 as long)) {
                let kind = opKind(op);
                let fd = opFd(op);
                let buf = opBuf(op);
                let len = opLen(op);
                let complete = true;
                let res = 0;
                if (kind == OP_RECV) {
                    let r = socket.recvSock(fd, buf, len);
                    if (r < 0 && socket.wouldBlock()) { complete = false; } else { res = r as int; }
                } else if (kind == OP_RECVFD) {
                    bytes.write_i32(buf, 4, -1);
                    let rn = socket.recvFdRaw(fd, buf, 4, buf + 4);
                    if (rn < 0 && socket.wouldBlock()) { complete = false; }
                    else if (rn <= 0) { res = -1; }
                    else { res = bytes.read_i32(buf, 4) as int; }
                } else if (kind == OP_SEND) {
                    let w = socket.sendSock(fd, buf, len);
                    if (w < 0 && socket.wouldBlock()) {
                        let ev = bytes.alloc(epoll.EPOLL_EVENT_SIZE());
                        epoll.setEvent(ev, 0, epoll.EPOLLOUT | epoll.EPOLLONESHOT, op);
                        epoll.epoll_ctl(self.kq, epoll.EPOLL_CTL_MOD, fd, ev);
                        bytes.free(ev);
                        complete = false;
                    } else { res = w as int; }
                } else if (kind == OP_ACCEPT) {
                    let c = socket.acceptSock(fd, 0, 0);
                    if (c < 0 && socket.wouldBlock()) { complete = false; } else {
                        if (c >= 0) { socket.setNonBlock(c); }
                        res = c;
                    }
                } else if (kind == OP_CONNECT) {
                    res = if (socket.sockError(fd) == 0) 0 else -1;
                }
                if (complete) {
                    setOpResult(op, res);
                    bytes.write_ptr(self.compBuf, (self.nComp * 8) as long, opToken(op));
                    self.nComp = self.nComp + 1;
                }
            }
            i = i + 1;
        }
        return self.nComp;
    }

    /// io_uring backend for `poll`: submits and waits for at least one completion, then drains the
    /// completion queue into `compBuf`, freeing any `OP_ABANDONED` record it encounters instead of
    /// reporting it. Returns `nComp`.
    fn pollUring(self: Poller, timeoutMs: int): int {
        self.nComp = 0;
        // Bounded, like the epoll branch this stands in for. Waiting untimed here is what hung the
        // completion-driven cases (201/202/203) under NOVA_REACTOR=uring: a connect or accept that
        // never completes has no other way back out, so `poll(timeoutMs)` never returned and the
        // caller's own deadline logic never got to run.
        nova_uring_submit_and_wait_ms(self.ring, 1, timeoutMs as long);
        let ready = nova_uring_cq_ready(self.ring);
        let i = 0;
        while (i < ready && self.nComp < self.maxEvents) {
            nova_uring_peek(self.ring, i, self.udBuf, self.resBuf);
            let ud = bytes.read_ptr(self.udBuf, 0);
            let res = bytes.read_i32(self.resBuf, 0) as int;
            // Reserved words first: neither is an op-record pointer, and the branches below would
            // dereference them as one.
            if (ud == nova_uring_wait_timeout_data() || ud == WAKE_DATA) {
                if (ud == WAKE_DATA) { nova_uring_wake_drain(); }
                i = i + 1;
                continue;
            }
            let tok = nova_reactor_event_token(ud);
            if (ud != tok || tok == (0 as long)) {
                if (tok != (0 as long)) {
                    bytes.write_ptr(self.compBuf, (self.nComp * 8) as long, tok);
                    self.nComp = self.nComp + 1;
                }
            } else if (ud != (0 as long)) {
                if (opDone(ud) == OP_ABANDONED) {
                    nova_op_free(ud);
                } else {
                    setOpResult(ud, if (res < 0) -1 else res);
                    bytes.write_ptr(self.compBuf, (self.nComp * 8) as long, opToken(ud));
                    self.nComp = self.nComp + 1;
                }
            }
            i = i + 1;
        }
        if (i > 0) { nova_uring_advance(self.ring, i); }
        return self.nComp;
    }

    /// Returns the token of the `i`-th completion recorded by the most recent `poll` call.
    fn completedToken(self: Poller, i: int): long {
        return bytes.read_ptr(self.compBuf, (i * 8) as long);
    }

    /// Frees all buffers, tears down the io_uring instance (if any) and unsets it as current, and
    /// closes the epoll fd. Safe to call more than once; each field is reset after freeing.
    fn destroy(self: Poller): void {
        if (self.eventBuf != 0) { bytes.free(self.eventBuf); self.eventBuf = 0; }
        if (self.compBuf != 0) { bytes.free(self.compBuf); self.compBuf = 0; }
        if (self.udBuf != 0) { bytes.free(self.udBuf); self.udBuf = 0; }
        if (self.resBuf != 0) { bytes.free(self.resBuf); self.resBuf = 0; }
        if (self.ring != (0 as long)) {
            nova_uring_set_current(0);
            nova_uring_destroy(self.ring);
            self.ring = 0;
        }
        if (self.kq >= 0) { socket.close(self.kq); self.kq = -1; }
    }
}
