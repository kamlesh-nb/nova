//! Async TLS 1.3 record layer, layered over the reactor and the pure-Nova
//! `crypto.tls.13` handshake state machines (`tlsClient`, `tlsServer`).
//!
//! This module owns the wire-level plumbing that the handshake state machines
//! do not: buffered, non-blocking record reads off an `eventedio.ReactorStream`
//! (`TlsIO`), assembling and sending the TLS record framing for the ClientHello,
//! ServerHello, ChangeCipherSpec and Finished flights, and the steady-state
//! application-data `read`/`write` path that encrypts/decrypts through the
//! negotiated session. `crypto.tls.13.tlsClient`/`tlsServer` handle the
//! cryptographic handshake logic; this file drives them over a real socket
//! inside Nova's `async`/`await` coroutine model, so a full handshake or
//! read/write suspends the coroutine instead of blocking the reactor thread.

import bytes;
import net.eventedio;
import crypto.tls.13.tlsClient;
import crypto.tls.13.tlsServer;
import crypto.ecc.p256;
import crypto.random;

// Adds a byte offset to a raw pointer via a 64-bit intermediate, so the
// address cannot truncate on buffers above 4 GB.
fn at(b: ptr, off: int): ptr { return (b as long + off) as ptr; }

// Buffered, non-blocking TLS record I/O state for one connection: a fixed
// read buffer (`rbuf`) with a [rlo, rhi) window of unconsumed bytes, refilled
// from the reactor as needed.
struct TlsIO {
    pub fd: int, pub kq: int,
    pub rbuf: ptr, pub rcap: int, pub rlo: int, pub rhi: int,
}

/// Creates a `TlsIO` for file descriptor `fd` registered with reactor `kq`,
/// allocating a 33792-byte (33 KB) read buffer sized to hold one full TLS record.
pub fn newIO(fd: int, kq: int): TlsIO {
    return TlsIO { fd: fd, kq: kq, rbuf: bytes.alloc(33792), rcap: 33792, rlo: 0, rhi: 0 };
}

// Reads more bytes from the socket into `rbuf`, compacting the unconsumed
// window to the front first if the buffer has run out of trailing space.
// Returns the number of bytes read, or -1 on a closed/errored connection.
async fn fill(self: TlsIO): int {
    if (self.rlo > 0 && self.rhi == self.rcap) {
        let m = self.rhi - self.rlo;
        let i = 0;
        while (i < m) { bytes.write_byte(self.rbuf, i, bytes.read_byte(self.rbuf, self.rlo + i)); i = i + 1; }
        self.rlo = 0;
        self.rhi = m;
    }
    let rs = eventedio.ReactorStream(self.fd, self.kq);
    let n = await rs.recvInto((self.rbuf as long) + (self.rhi as long), self.rcap - self.rhi);
    if (n <= 0) { return -1; }
    self.rhi = self.rhi + n;
    return n;
}

// Fills the read buffer via repeated `fill` calls until at least `need` bytes
// are available in the unconsumed window. Returns -1 if the connection closes first.
async fn ensure(self: TlsIO, need: int): int {
    while (self.rhi - self.rlo < need) {
        if (await self.fill() < 0) { return -1; }
    }
    return 0;
}

// Reads one full TLS record (5-byte header plus payload) into `out`, waiting
// on the reactor as needed. Returns the total record length (header included),
// or -1 on a connection error.
async fn readRecord(self: TlsIO, out: ptr): int {
    if (await self.ensure(5) < 0) { return -1; }
    let len = (bytes.read_byte(self.rbuf, self.rlo + 3) << 8) | bytes.read_byte(self.rbuf, self.rlo + 4);
    if (await self.ensure(5 + len) < 0) { return -1; }
    let i = 0;
    while (i < 5 + len) { bytes.write_byte(out, i, bytes.read_byte(self.rbuf, self.rlo + i)); i = i + 1; }
    self.rlo = self.rlo + 5 + len;
    return 5 + len;
}

// Sends all `n` bytes of `buf` on the connection's stream, suspending until
// the reactor confirms delivery. Returns the byte count sent, or a negative value on failure.
async fn sendAll(self: TlsIO, buf: ptr, n: int): int {
    let rs = eventedio.ReactorStream(self.fd, self.kq);
    return await rs.sendBuf(buf as long, n);
}

// Fills `buf` with `n` cryptographically random bytes, masked to a byte range.
fn fillRandom(buf: ptr, n: int): void {
    let s = random.randomBytes(n);
    let i = 0;
    while (i < n) { bytes.write_byte(buf, i, s[i] & 0xff); i = i + 1; }
}

/// Runs the client side of a full TLS 1.3 handshake over `io`: builds and
/// sends the ClientHello (with fresh random and session-id bytes and the
/// ephemeral P-256 key share), sends a compatibility ChangeCipherSpec, reads
/// and processes the ServerHello, feeds subsequent handshake records to `cl`
/// until it signals completion, then sends the client Finished record.
///
/// Rejects a HelloRetryRequest or a downgrade sentinel outright. Returns 0 on
/// a completed handshake, -1 on any I/O error or protocol rejection.
pub async fn handshake(io: TlsIO, cl: tlsClient.TlsClient, ephPub: ptr, host: string): int {
    let rnd = bytes.alloc(32); fillRandom(rnd, 32);
    let sid = bytes.alloc(32); fillRandom(sid, 32);
    let ch = bytes.alloc(1024);
    let ephPubP = bytes.alloc(65); p256.derivePublic(ephPubP, cl.ephP256);
    let chLen = tlsClient.buildClientHello(rnd, sid, ephPub, ephPubP, host, "", ch);
    bytes.free(ephPubP);
    cl.addClientHello(ch, chLen);

    let rec = bytes.alloc(chLen + 5);
    bytes.write_byte(rec, 0, 0x16); bytes.write_byte(rec, 1, 0x03); bytes.write_byte(rec, 2, 0x01);
    bytes.write_byte(rec, 3, (chLen >> 8) & 0xff); bytes.write_byte(rec, 4, chLen & 0xff);
    let i = 0;
    while (i < chLen) { bytes.write_byte(rec, 5 + i, bytes.read_byte(ch, i)); i = i + 1; }
    if (await io.sendAll(rec, chLen + 5) < 0) { return -1; }

    let ccs = bytes.alloc(6);
    bytes.write_byte(ccs, 0, 0x14); bytes.write_byte(ccs, 1, 0x03); bytes.write_byte(ccs, 2, 0x03);
    bytes.write_byte(ccs, 3, 0x00); bytes.write_byte(ccs, 4, 0x01); bytes.write_byte(ccs, 5, 0x01);
    if (await io.sendAll(ccs, 6) < 0) { return -1; }

    let buf = bytes.alloc(33792);
    let n = await io.readRecord(buf);
    if (n < 0 || bytes.read_byte(buf, 0) != 0x16) { return -1; }
    if (tlsClient.isHelloRetryRequest(at(buf, 5)) || tlsClient.hasDowngradeSentinel(at(buf, 5))) { return -1; }
    cl.processServerHello(at(buf, 5), n - 5);

    let ok = 0;
    while (ok == 0) {
        let m = await io.readRecord(buf);
        if (m < 0) { return -1; }
        let r = cl.feedHandshake(buf, m);
        if (r == 0 - 1) { return -1; }
        if (r == 1) { ok = 1; }
    }

    let vd = bytes.alloc(32);
    cl.clientFinished(vd);
    let fin = bytes.alloc(128);
    let finLen = cl.clientFinishedRecord(vd, fin);
    if (await io.sendAll(fin, finLen) < 0) { return -1; }
    return 0;
}

/// Runs the server side of a full TLS 1.3 handshake over `io`: reads the
/// ClientHello, builds and sends the ServerHello using `serverRandom`, sends
/// a compatibility ChangeCipherSpec followed by the rest of the server flight
/// (certificate, verify, Finished, etc. via `srv.buildFlight`), then reads
/// and skips any client ChangeCipherSpec records before verifying the client
/// Finished.
///
/// Returns 0 on a completed handshake, -1 on any I/O error or a Finished
/// verification failure.
pub async fn serveHandshake(io: TlsIO, srv: tlsServer.TlsServer, serverRandom: ptr): int {
    let buf = bytes.alloc(33792);
    let n = await io.readRecord(buf);
    if (n < 0 || bytes.read_byte(buf, 0) != 0x16) { return -1; }
    srv.processClientHello(at(buf, 5), n - 5);

    let sh = bytes.alloc(1024);
    let shLen = srv.buildServerHello(serverRandom, sh);
    let rec = bytes.alloc(shLen + 5);
    bytes.write_byte(rec, 0, 0x16); bytes.write_byte(rec, 1, 0x03); bytes.write_byte(rec, 2, 0x03);
    bytes.write_byte(rec, 3, (shLen >> 8) & 0xff); bytes.write_byte(rec, 4, shLen & 0xff);
    let i = 0;
    while (i < shLen) { bytes.write_byte(rec, 5 + i, bytes.read_byte(sh, i)); i = i + 1; }
    if (await io.sendAll(rec, shLen + 5) < 0) { return -1; }

    let ccs = bytes.alloc(6);
    bytes.write_byte(ccs, 0, 0x14); bytes.write_byte(ccs, 1, 0x03); bytes.write_byte(ccs, 2, 0x03);
    bytes.write_byte(ccs, 3, 0x00); bytes.write_byte(ccs, 4, 0x01); bytes.write_byte(ccs, 5, 0x01);
    if (await io.sendAll(ccs, 6) < 0) { return -1; }

    let flight = bytes.alloc(8192);
    let fLen = srv.buildFlight(flight);
    if (await io.sendAll(flight, fLen) < 0) { return -1; }

    let m = await io.readRecord(buf);
    while (m > 0 && bytes.read_byte(buf, 0) == 0x14) { m = await io.readRecord(buf); }
    if (m < 0 || !srv.processClientFinished(buf, m)) { return -1; }
    return 0;
}

/// Encrypts `n` bytes of `data` as TLS 1.3 application data through `srv`'s
/// session keys and sends the resulting record on `io`. Returns the number of
/// bytes sent, or a negative value on failure.
pub async fn serverWrite(io: TlsIO, srv: tlsServer.TlsServer, data: ptr, n: int): int {
    let out = bytes.alloc(n + 64);
    let m = srv.encryptApp(data, n, out);
    let r = await io.sendAll(out, m);
    bytes.free(out);
    return r;
}

/// Reads and decrypts the next application-data record from `io` into `out`
/// using `srv`'s session keys, transparently looping past any non-application
/// (e.g. post-handshake) records until real data arrives.
///
/// Returns the decrypted payload length (excluding the trailing TLS inner
/// content-type byte), or -1 on a connection error.
pub async fn serverRead(io: TlsIO, srv: tlsServer.TlsServer, out: ptr): int {
    let rec = bytes.alloc(33792);
    while (true) {
        let m = await io.readRecord(rec);
        if (m < 0) { bytes.free(rec); return -1; }
        let inner = srv.decryptApp(rec, m, out);
        if (inner > 0 && bytes.read_byte(out, inner - 1) == 0x17) { bytes.free(rec); return inner - 1; }
    }
    bytes.free(rec);
    return -1;
}

/// Encrypts `n` bytes of `data` as TLS 1.3 application data through `cl`'s
/// session keys and sends the resulting record on `io`. Returns the number of
/// bytes sent, or a negative value on failure.
pub async fn write(io: TlsIO, cl: tlsClient.TlsClient, data: ptr, n: int): int {
    let out = bytes.alloc(n + 64);
    let m = cl.encryptApp(data, n, out);
    let r = await io.sendAll(out, m);
    bytes.free(out);
    return r;
}

/// Reads and decrypts the next application-data record from `io` into `out`
/// using `cl`'s session keys, transparently looping past any non-application
/// (e.g. post-handshake) records until real data arrives.
///
/// Returns the decrypted payload length (excluding the trailing TLS inner
/// content-type byte), or -1 on a connection error.
pub async fn read(io: TlsIO, cl: tlsClient.TlsClient, out: ptr): int {
    let rec = bytes.alloc(33792);
    while (true) {
        let m = await io.readRecord(rec);
        if (m < 0) { bytes.free(rec); return -1; }
        let inner = cl.decryptApp(rec, m, out);
        if (inner > 0) {
            let itype = bytes.read_byte(out, inner - 1);
            if (itype == 0x17) { bytes.free(rec); return inner - 1; }
        }
    }
    bytes.free(rec);
    return -1;
}
