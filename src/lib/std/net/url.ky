//! A small, dependency-free URL parser for absolute HTTP(S) URLs.
//!
//! This module splits a raw URL string into its component parts: scheme,
//! host, port, path (including any query string), and query. It is a
//! pragmatic parser aimed at the shapes that show up in server-side code
//! (client requests, configuration, redirects), not a full RFC 3986
//! implementation: there is no percent-decoding, no userinfo, no fragment
//! handling, and no validation of illegal characters. IPv6 host literals in
//! bracket notation (`[::1]`) are supported.

import string;
import assert;

/// The parsed components of a URL, as produced by `parse`.
pub struct Url {
    /// The scheme in lower case, for example `"http"` or `"https"`. Defaults
    /// to `"http"` when the input has no `"://"` separator.
    pub scheme: string,
    /// The hostname or IP literal, without brackets for IPv6 addresses and
    /// without the port.
    pub host: string,
    /// The port number. Defaults to 443 for `https`, 80 for anything else,
    /// unless the input explicitly specifies one.
    pub port: int,
    /// The path, including the leading `?` and query string if present.
    /// Defaults to `"/"` when the input has no path segment.
    pub path: string,
    /// The query string with the leading `?` stripped, or `""` if there is
    /// no query.
    pub query: string,
    /// True when the scheme is `"https"`.
    pub secure: bool,
}

/// Parses a raw URL string into its `Url` components.
///
/// Recognises an optional `scheme://` prefix, an optional `host:port` (or
/// bracketed IPv6 `[host]:port`), and everything after the first `/` as the
/// path. Malformed or partial input degrades gracefully rather than
/// erroring: a bare host such as `"example.com"` parses to scheme `"http"`,
/// port 80, and path `"/"`.
pub fn parse(raw: string): Url {
    let s = raw;
    let scheme = "http";

    let schemeIdx = string.indexOf(s, "://");
    if (schemeIdx != -1) {
        scheme = string.toLowerCase(string.slice(s, 0, schemeIdx));
        s = string.slice(s, schemeIdx + 3, s.length);
    }
    let secure = scheme == "https";

    let hostport = s;
    let path = "/";
    let pathIdx = string.indexOf(s, "/");
    if (pathIdx != -1) {
        hostport = string.slice(s, 0, pathIdx);
        path = string.slice(s, pathIdx, s.length);
    }

    let host = hostport;
    let port = if (secure) 443 else 80;
    if (hostport.length > 0 && hostport[0] == 91) {
        let close = string.indexOf(hostport, "]");
        if (close != -1) {
            host = string.slice(hostport, 1, close);
            let rest = string.slice(hostport, close + 1, hostport.length);
            if (rest.length > 0 && rest[0] == 58) {
                port = string.parseI64(string.slice(rest, 1, rest.length)) as int;
            }
        }
    } else {
        let colonIdx = string.indexOf(hostport, ":");
        if (colonIdx != -1) {
            host = string.slice(hostport, 0, colonIdx);
            port = string.parseI64(string.slice(hostport, colonIdx + 1, hostport.length)) as int;
        }
    }

    let query = "";
    let qIdx = string.indexOf(path, "?");
    if (qIdx != -1) {
        query = string.slice(path, qIdx + 1, path.length);
    }

    return Url{
        scheme: scheme,
        host: host,
        port: port,
        path: path,
        query: query,
        secure: secure,
    };
}

@test
fn test_url_parse(): void {
    let a = parse("https://api.example.com/v1/users?limit=10");
    assert.equalStr(a.scheme, "https");
    assert.equalStr(a.host, "api.example.com");
    assert.equalInt(a.port, 443);
    assert.equalStr(a.path, "/v1/users?limit=10");
    assert.equalStr(a.query, "limit=10");
    assert.isTrue(a.secure);

    let b = parse("http://localhost:8080/health");
    assert.equalStr(b.scheme, "http");
    assert.equalStr(b.host, "localhost");
    assert.equalInt(b.port, 8080);
    assert.equalStr(b.path, "/health");
    assert.isFalse(b.secure);

    let c = parse("example.com");
    assert.equalStr(c.host, "example.com");
    assert.equalInt(c.port, 80);
    assert.equalStr(c.path, "/");
}

@test
fn test_url_parse_ipv6(): void {
    let a = parse("http://[::1]:8080/health");
    assert.equalStr(a.host, "::1");
    assert.equalInt(a.port, 8080);
    assert.equalStr(a.path, "/health");
    let b = parse("https://[2001:db8::1]/");
    assert.equalStr(b.host, "2001:db8::1");
    assert.equalInt(b.port, 443);
    let c = parse("http://[fe80::1ff:fe23:4567:890a]:9000/api");
    assert.equalStr(c.host, "fe80::1ff:fe23:4567:890a");
    assert.equalInt(c.port, 9000);
    let d = parse("http://localhost:5432/db");
    assert.equalStr(d.host, "localhost");
    assert.equalInt(d.port, 5432);
}
