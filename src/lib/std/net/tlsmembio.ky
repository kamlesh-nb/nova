//! Memory-BIO driven TLS 1.3 state machines for `ClientBio` and `ServerBio`.
//!
//! A `MemBuf` is a pair of growable byte queues (`feed`/`nextRecord` on the
//! input side, `appendOut`/`pull` on the output side) that stand in for the
//! usual socket-backed BIO in OpenSSL-style TLS stacks: nothing in this file
//! performs I/O. The caller owns the transport, feeds received bytes in with
//! `feed`, calls `step` to advance the handshake, and pulls bytes to send out
//! with `pull`. This keeps the TLS 1.3 protocol logic (`crypto.tls.13.*`)
//! completely decoupled from sockets, so the same state machine drives a real
//! reactor connection, a test harness, or any other transport.
//!
//! `ClientBio` and `ServerBio` both implement the `TlsBio` trait and wrap a
//! `tlsClient.TlsClient` / `tlsServer.TlsServer` handshake engine around a
//! `MemBuf`, adding session resumption (PSK tickets via `TicketCache`),
//! 0-RTT early data, key updates, and application data framing. The file also
//! carries small PEM/DER helpers (`pemBody`, `ecKeyScalar`) used to load
//! certificates and EC private keys when constructing a `ServerBio` from PEM
//! text rather than raw DER.

import bytes;
import crypto.tls.13.tlsClient;
import crypto.tls.13.tlsServer;
import crypto.tls.13.tls;
import crypto.ecc.x25519;
import crypto.ecc.p256;
import crypto.ecc.p384;
import crypto.random;
import crypto.base64;
import crypto.tls.truststore;
import list;

// Pointer arithmetic helper: offsets `b` by `off` bytes via a `long` cast so the address is not truncated.
fn at(b: ptr, off: int): ptr { return (b as long + off) as ptr; }

// Fills `buf` with `n` cryptographically random bytes, used for nonces, random fields, and ephemeral key material.
fn fillRandom(buf: ptr, n: int): void {
    let s = random.randomBytes(n);
    let i = 0;
    while (i < n) { bytes.write_byte(buf, i, s[i] & 0xff); i = i + 1; }
}

/// A pair of growable byte queues that stand in for a socket in a TLS memory-BIO.
///
/// The input side (`ibuf`/`ilo`/`ihi`) is a byte queue fed by `feed` and drained
/// record-by-record by `nextRecord`; the output side (`obuf`/`olen`) accumulates
/// bytes written by `appendOut`/`appendRecord` and is drained by `pull`. Both
/// sides grow (doubling capacity) as needed and are never shrunk until `freeBuffers`.
pub struct MemBuf {
    /// Input queue backing buffer.
    /// Input queue capacity in bytes.
    /// Read cursor into `ibuf` (bytes before this offset are already consumed).
    /// Write cursor into `ibuf` (end of buffered, unconsumed input).
    pub ibuf: ptr, pub icap: int, pub ilo: int, pub ihi: int,
    /// Output queue backing buffer.
    /// Output queue capacity in bytes.
    /// Number of valid bytes currently queued in `obuf`.
    pub obuf: ptr, pub ocap: int, pub olen: int,
    /// Set once the peer has signalled (or is treated as having signalled) a closed connection.
    pub closed: bool,

    /// Appends `n` bytes of raw input to the input queue, compacting and growing `ibuf` as needed.
    pub fn feed(self: MemBuf, data: ptr, n: int): void {
        if (self.ilo > 0) {
            let m = self.ihi - self.ilo;
            let i = 0;
            while (i < m) { bytes.write_byte(self.ibuf, i, bytes.read_byte(self.ibuf, self.ilo + i)); i = i + 1; }
            self.ilo = 0;
            self.ihi = m;
        }
        if (self.ihi + n > self.icap) {
            let ncap = self.icap * 2;
            while (self.ihi + n > ncap) { ncap = ncap * 2; }
            let nb = bytes.alloc(ncap);
            let i = 0;
            while (i < self.ihi) { bytes.write_byte(nb, i, bytes.read_byte(self.ibuf, i)); i = i + 1; }
            bytes.free(self.ibuf);
            self.ibuf = nb;
            self.icap = ncap;
        }
        let j = 0;
        while (j < n) { bytes.write_byte(self.ibuf, self.ihi + j, bytes.read_byte(data, j)); j = j + 1; }
        self.ihi = self.ihi + n;
    }

    /// Pops one complete TLS record from the input queue into `out` and returns its total length
    /// (5-byte header plus body), or 0 if a full record is not yet buffered.
    pub fn nextRecord(self: MemBuf, out: ptr): int {
        if (self.ihi - self.ilo < 5) { return 0; }
        let len = (bytes.read_byte(self.ibuf, self.ilo + 3) << 8) | bytes.read_byte(self.ibuf, self.ilo + 4);
        if (self.ihi - self.ilo < 5 + len) { return 0; }
        let i = 0;
        while (i < 5 + len) { bytes.write_byte(out, i, bytes.read_byte(self.ibuf, self.ilo + i)); i = i + 1; }
        self.ilo = self.ilo + 5 + len;
        return 5 + len;
    }

    /// Appends `n` raw bytes to the output queue, growing `obuf` as needed.
    pub fn appendOut(self: MemBuf, src: ptr, n: int): void {
        if (self.olen + n > self.ocap) {
            let ncap = self.ocap * 2;
            while (self.olen + n > ncap) { ncap = ncap * 2; }
            let nb = bytes.alloc(ncap);
            let i = 0;
            while (i < self.olen) { bytes.write_byte(nb, i, bytes.read_byte(self.obuf, i)); i = i + 1; }
            bytes.free(self.obuf);
            self.obuf = nb;
            self.ocap = ncap;
        }
        let j = 0;
        while (j < n) { bytes.write_byte(self.obuf, self.olen + j, bytes.read_byte(src, j)); j = j + 1; }
        self.olen = self.olen + n;
    }

    /// Wraps `body` in a TLS record header (content type `ctype`, version `vMaj.vMin`) and queues it for output.
    pub fn appendRecord(self: MemBuf, ctype: int, vMaj: int, vMin: int, body: ptr, bodyLen: int): void {
        let rec = bytes.alloc(bodyLen + 5);
        bytes.write_byte(rec, 0, ctype);
        bytes.write_byte(rec, 1, vMaj);
        bytes.write_byte(rec, 2, vMin);
        bytes.write_byte(rec, 3, (bodyLen >> 8) & 0xff);
        bytes.write_byte(rec, 4, bodyLen & 0xff);
        let i = 0;
        while (i < bodyLen) { bytes.write_byte(rec, 5 + i, bytes.read_byte(body, i)); i = i + 1; }
        self.appendOut(rec, bodyLen + 5);
        bytes.free(rec);
    }

    /// Copies up to `max` queued output bytes into `buf`, shifts the remainder down, and returns the count copied.
    pub fn pull(self: MemBuf, buf: ptr, max: int): int {
        let take = self.olen;
        if (take > max) { take = max; }
        let i = 0;
        while (i < take) { bytes.write_byte(buf, i, bytes.read_byte(self.obuf, i)); i = i + 1; }
        let rem = self.olen - take;
        i = 0;
        while (i < rem) { bytes.write_byte(self.obuf, i, bytes.read_byte(self.obuf, take + i)); i = i + 1; }
        self.olen = rem;
        return take;
    }

    /// Frees the `ibuf` and `obuf` heap allocations. Must be called once the `MemBuf` is no longer needed.
    pub fn freeBuffers(self: MemBuf): void {
        bytes.free(self.ibuf);
        bytes.free(self.obuf);
    }
}

/// Creates an empty `MemBuf` with 4096-byte input and output queues.
pub fn newMemBuf(): MemBuf {
    return MemBuf { ibuf: bytes.alloc(4096), icap: 4096, ilo: 0, ihi: 0,
                    obuf: bytes.alloc(4096), ocap: 4096, olen: 0, closed: false };
}

/// Common transport-agnostic surface shared by `ClientBio` and `ServerBio`.
///
/// A caller drives a TLS connection purely through this trait: push received
/// wire bytes with `feed`, advance the handshake with `step`, exchange
/// application data with `writeApp`/`readApp`, and drain bytes to send with
/// `pull`. Nothing in the trait touches a socket.
pub trait TlsBio {
    /// Queues raw bytes received from the peer for processing by `step`/`readApp`.
    fn feed(self, data: ptr, n: int): void;
    /// Marks the connection as closed, so a subsequent `readApp` with no data returns an error rather than 0.
    fn markClosed(self): void;
    /// Number of bytes currently queued and ready to be sent to the peer.
    fn pendingOut(self): int;
    /// Drains up to `max` pending output bytes into `buf`.
    fn pull(self, buf: ptr, max: int): int;
    /// Advances the handshake state machine as far as buffered input allows.
    /// Returns 0 when the handshake completes, 1 when more input is needed, or -1 on protocol failure.
    fn step(self): int;
    /// Encrypts and queues `n` bytes of application data for output. Returns the number of bytes accepted.
    fn writeApp(self, data: ptr, n: int): int;
    /// Decrypts and copies up to `max` bytes of application data into `buf`.
    /// Returns the byte count, 0 if none is available yet, or -1 on close/alert.
    fn readApp(self, buf: ptr, max: int): int;
    /// Releases all resources owned by the BIO (buffers, handshake state).
    fn closeBio(self): void;
    /// Returns the ALPN protocol negotiated during the handshake, or an empty string if none was.
    fn selectedAlpn(self): string;
}


/// Client-side TLS 1.3 connection driven over a `MemBuf`, implementing `TlsBio`.
///
/// Constructed via `newClientBio` (fresh handshake) or `newClientBioResume`
/// (PSK/ticket resumption, optionally with 0-RTT early data). `step` runs the
/// ClientHello / HelloRetryRequest / ServerHello / Finished exchange; once
/// `step` returns 0 the connection is ready for `writeApp`/`readApp`.
pub struct ClientBio impl TlsBio {
    /// Underlying record queue.
    pub buf: MemBuf,
    /// TLS 1.3 client handshake and record-protection engine.
    pub cl: tlsClient.TlsClient,
    /// Handshake state: 1 = awaiting ServerHello, 2 = processing the server flight, 3 = established, negative = failed.
    pub state: int,
    /// Scratch buffer used to hold one decoded record, and its capacity.
    pub scratch: ptr, pub scap: int,
    /// Scratch buffer used to hold one decrypted plaintext record.
    pub plain: ptr,
    /// Whether server certificate verification is enforced (see `newClientBioVerify`), the SNI/expected hostname, and the trust store used for verification.
    pub verify: bool, pub host: string, pub store: truststore.TrustStore,
    /// Client random, session id, and ephemeral key-share material (X25519, P-256, P-384) generated for the handshake, plus the offered ALPN protocol.
    pub rnd: ptr, pub sid: ptr, pub ephPub: ptr, pub ephPubP: ptr, pub ephPubP384: ptr, pub alpn: string,
    /// Set once a HelloRetryRequest has been processed, to reject a second one.
    pub hrrDone: bool,

    pub fn feed(self: ClientBio, data: ptr, n: int): void { self.buf.feed(data, n); }
    pub fn markClosed(self: ClientBio): void { self.buf.closed = true; }
    pub fn pendingOut(self: ClientBio): int { return self.buf.olen; }
    pub fn pull(self: ClientBio, buf: ptr, max: int): int { return self.buf.pull(buf, max); }

    /// Drives the client handshake forward using whatever records are buffered in `self.buf`.
    /// Handles HelloRetryRequest by re-sending a second ClientHello, verifies the server
    /// certificate when `verify` is set, and sends the client Finished flight once done.
    /// Returns 0 on completion, 1 if more input is needed, or -1 on a protocol failure (and sets `state` negative).
    pub fn step(self: ClientBio): int {
        if (self.state == 3) { return 0; }
        if (self.state < 0) { return 0 - 1; }
        while (true) {
            let m = self.buf.nextRecord(self.scratch);
            if (m == 0) { return 1; }
            let ctype = bytes.read_byte(self.scratch, 0);
            if (ctype == 0x14) { continue; }
            if (self.state == 1) {
                if (ctype != 0x16) { self.state = 0 - 1; return 0 - 1; }
                let sh = at(self.scratch, 5);
                if (tlsClient.hasDowngradeSentinel(sh)) { self.state = 0 - 1; return 0 - 1; }
                if (tlsClient.isHelloRetryRequest(sh)) {
                    if (self.hrrDone) { self.state = 0 - 1; return 0 - 1; }
                    self.hrrDone = true;
                    let group = self.cl.processHelloRetryRequest(sh, m - 5);
                    let mask = 3;
                    if (group == 0x0017) { mask = 2; }
                    else if (group == 0x001d) { mask = 1; }
                    else if (group == 0x0018) { mask = 4; }
                    else if (group != 0) { self.state = 0 - 1; return 0 - 1; }
                    let ch2 = bytes.alloc(1024);
                    let noPsk = bytes.alloc(1);
                    let ch2Len = tlsClient.buildClientHelloEx(self.rnd, self.sid, self.ephPub, self.ephPubP, self.ephPubP384,
                        self.host, self.alpn, mask, self.cl.hrrCookiePtr(), self.cl.hrrCookieSize(), noPsk, 0, 0, 0, 0, ch2);
                    bytes.free(noPsk);
                    self.cl.addClientHello(ch2, ch2Len);
                    self.buf.appendRecord(0x16, 0x03, 0x03, ch2, ch2Len);
                    bytes.free(ch2);
                    continue;
                }
                self.cl.processServerHello(sh, m - 5);
                self.state = 2;
            } else if (self.state == 2) {
                let r = self.cl.feedHandshake(self.scratch, m);
                if (r == 0 - 1) { self.state = 0 - 1; return 0 - 1; }
                if (r == 1) {
                    if (self.verify) {
                        let noCrl = bytes.alloc(1);
                        if (!self.store.trustsNotRevoked(self.cl.certListPtr(), self.cl.certListSize(), self.host,
                                                         truststore.nowUtc(), self.cl.ocspStaplePtr(), self.cl.ocspStapleSize(), noCrl, 0)) {
                            bytes.free(noCrl);
                            self.state = 0 - 1; return 0 - 1;
                        }
                        bytes.free(noCrl);
                    }
                    self.cl.deriveAppSecrets();
                    if (self.cl.earlyWasAccepted()) {
                        let eoed = bytes.alloc(64);
                        let en = self.cl.endOfEarlyDataRecord(eoed);
                        self.buf.appendOut(eoed, en);
                        bytes.free(eoed);
                    }
                    if (self.cl.wasCertRequested()) {
                        let cf = bytes.alloc(4096);
                        let cfLen = self.cl.buildClientCertFlightRecord(cf);
                        self.buf.appendOut(cf, cfLen);
                        bytes.free(cf);
                    }
                    let vd = bytes.alloc(48);
                    self.cl.clientFinished(vd);
                    let fin = bytes.alloc(128);
                    let finLen = self.cl.clientFinishedRecord(vd, fin);
                    self.buf.appendOut(fin, finLen);
                    bytes.free(vd); bytes.free(fin);
                    self.state = 3;
                    return 0;
                }
            }
        }
        return 1;
    }

    /// Sets a client certificate and private key to present if the server requests client authentication.
    pub fn configureClientCert(self: ClientBio, certDer: ptr, certLen: int, key: ptr): void {
        self.cl.setClientCert(certDer, certLen, key);
    }

    /// Pointer to the raw OCSP staple presented by the server, if any.
    pub fn stapledOcspPtr(self: ClientBio): ptr { return self.cl.ocspStaplePtr(); }
    /// Size in bytes of the stapled OCSP response.
    pub fn stapledOcspSize(self: ClientBio): int { return self.cl.ocspStapleSize(); }
    /// Pointer to the peer's raw DER certificate list as received in the handshake.
    pub fn peerCertListPtr(self: ClientBio): ptr { return self.cl.certListPtr(); }
    /// Size in bytes of the peer's certificate list.
    pub fn peerCertListSize(self: ClientBio): int { return self.cl.certListSize(); }

    /// Encrypts `n` bytes of application data, chunking to the negotiated record size limit, and queues it for output.
    pub fn writeApp(self: ClientBio, data: ptr, n: int): int {
        let cap = self.cl.sendLimit - 1;
        let off = 0;
        while (off < n) {
            let chunk = n - off;
            if (chunk > cap) { chunk = cap; }
            let out = bytes.alloc(chunk + 64);
            let m = self.cl.encryptApp((data as long + off) as ptr, chunk, out);
            self.buf.appendOut(out, m);
            bytes.free(out);
            off = off + chunk;
        }
        return n;
    }

    /// Decrypts buffered records into `buf`, transparently handling post-handshake key updates
    /// (0x18) and new session tickets (0x04). Returns the decrypted byte count, 0 if none is
    /// available yet, or -1 once a close_notify alert or a closed connection is seen.
    pub fn readApp(self: ClientBio, buf: ptr, max: int): int {
        while (true) {
            let m = self.buf.nextRecord(self.scratch);
            if (m == 0) { if (self.buf.closed) { return 0 - 1; } return 0; }
            let inner = self.cl.decryptApp(self.scratch, m, self.plain);
            if (inner > 0) {
                let itype = bytes.read_byte(self.plain, inner - 1);
                if (itype == 0x17) {
                    let take = inner - 1;
                    if (take > max) { take = max; }
                    let i = 0;
                    while (i < take) { bytes.write_byte(buf, i, bytes.read_byte(self.plain, i)); i = i + 1; }
                    return take;
                } else if (itype == 0x15) {
                    self.buf.closed = true;
                    return 0 - 1;
                } else if (itype == 0x16) {
                    let plen = inner - 1;
                    let p = 0;
                    while (p + 4 <= plen) {
                        let mtype = bytes.read_byte(self.plain, p);
                        let mlen = (bytes.read_byte(self.plain, p + 1) << 16)
                                 | (bytes.read_byte(self.plain, p + 2) << 8) | bytes.read_byte(self.plain, p + 3);
                        if (mtype == 0x18) {
                            let req = bytes.read_byte(self.plain, p + 4);
                            self.cl.updateServerKey();
                            if (req == 1) {
                                let ku = bytes.alloc(64);
                                let n = self.cl.keyUpdateRecord(0, ku);
                                self.buf.appendOut(ku, n);
                                bytes.free(ku);
                                self.cl.updateClientKey();
                            }
                        } else if (mtype == 0x04) {
                            self.cl.parseNewSessionTicket(self.plain, p);
                        }
                        p = p + 4 + mlen;
                    }
                }
            }
        }
        return 0;
    }

    /// Queues an encrypted close_notify alert for output, once the handshake has completed.
    pub fn closeNotify(self: ClientBio): void {
        if (self.state == 3) {
            let out = bytes.alloc(64);
            let n = self.cl.encryptAlert(1, 0, out);
            self.buf.appendOut(out, n);
            bytes.free(out);
        }
    }

    pub fn selectedAlpn(self: ClientBio): string { return self.cl.selectedAlpn(); }
    /// Negotiated cipher suite family (e.g. AES-GCM vs ChaCha20), as encoded by `tlsClient`.
    pub fn negotiatedKind(self: ClientBio): int { return self.cl.kind; }
    /// Negotiated cipher suite identifier.
    pub fn negotiatedSuite(self: ClientBio): int { return self.cl.suite; }

    /// Whether the server issued a session ticket usable for a future resumed connection.
    pub fn hasTicket(self: ClientBio): bool { return self.cl.hasTicket(); }
    /// Pointer to the raw session ticket bytes to persist for resumption.
    pub fn ticketPtr(self: ClientBio): ptr { return self.cl.ticketPtr(); }
    /// Size in bytes of the session ticket.
    pub fn ticketSize(self: ClientBio): int { return self.cl.ticketSize(); }
    /// Pointer to the derived resumption PSK associated with the ticket.
    pub fn ticketPskPtr(self: ClientBio): ptr { return self.cl.ticketPskPtr(); }
    /// Server-advertised ticket age, to pass back into `newClientBioResume` on the next connection.
    pub fn ticketAge(self: ClientBio): long { return self.cl.ticketAge(); }
    /// Hash algorithm the ticket's PSK binder was computed with.
    pub fn ticketHashKind(self: ClientBio): int { return self.cl.ticketHashKind(); }
    /// Whether the server accepted the offered PSK (i.e. this connection is a resumption).
    pub fn resumed(self: ClientBio): bool { return self.cl.pskWasAccepted(); }
    /// Whether 0-RTT early data sent with the ClientHello was accepted by the server.
    pub fn earlyAccepted(self: ClientBio): bool { return self.cl.earlyWasAccepted(); }

    /// Queues a KeyUpdate message, rotating the client's write key. `request` set to 1 also asks the peer to update its own key.
    pub fn requestKeyUpdate(self: ClientBio, request: int): void {
        if (self.state == 3) {
            let ku = bytes.alloc(64);
            let n = self.cl.keyUpdateRecord(request, ku);
            self.buf.appendOut(ku, n);
            bytes.free(ku);
            self.cl.updateClientKey();
        }
    }

    /// Frees the `MemBuf` and all scratch/key-material allocations owned by this client connection.
    pub fn closeBio(self: ClientBio): void {
        self.buf.freeBuffers();
        bytes.free(self.scratch);
        bytes.free(self.plain);
        bytes.free(self.rnd);
        bytes.free(self.sid);
        bytes.free(self.ephPub);
        bytes.free(self.ephPubP);
        bytes.free(self.ephPubP384);
    }
}

/// Starts a fresh (non-resumed) TLS 1.3 client handshake for `host`, with no ALPN offered and no certificate verification.
pub fn newClientBio(host: string): ClientBio {
    return newClientBioAlpn(host, "");
}

/// Like `newClientBio`, offering `alpn` as the single ALPN protocol.
pub fn newClientBioAlpn(host: string, alpn: string): ClientBio {
    return newClientBioGroups(host, alpn, 3);
}

/// Like `newClientBioAlpn`, restricting the offered key-share groups via `groupMask`
/// (bit 1 = X25519, bit 2 = P-256, bit 4 = P-384). Generates fresh ephemeral keys,
/// builds and queues the initial ClientHello plus a compatibility ChangeCipherSpec.
pub fn newClientBioGroups(host: string, alpn: string, groupMask: int): ClientBio {
    let priv = bytes.alloc(32); fillRandom(priv, 32);
    let base = bytes.alloc(32); bytes.write_byte(base, 0, 9);
    let ephPub = bytes.alloc(32); x25519.scalarMult(ephPub, priv, base);
    let privP = bytes.alloc(32); fillRandom(privP, 32);
    let ephPubP = bytes.alloc(65); p256.derivePublic(ephPubP, privP);
    let privP384 = bytes.alloc(48); fillRandom(privP384, 48);
    let ephPubP384 = bytes.alloc(97); p384.derivePublic(ephPubP384, privP384);
    let cl = tlsClient.newClient(priv, privP, privP384);

    let mb = newMemBuf();
    let rnd = bytes.alloc(32); fillRandom(rnd, 32);
    let sid = bytes.alloc(32); fillRandom(sid, 32);
    let ch = bytes.alloc(1024);
    let emptyCookie = bytes.alloc(1);
    let chLen = tlsClient.buildClientHelloEx(rnd, sid, ephPub, ephPubP, ephPubP384, host, alpn, groupMask, emptyCookie, 0, emptyCookie, 0, 0, 0, 0, ch);
    bytes.free(emptyCookie);
    cl.addClientHello(ch, chLen);
    mb.appendRecord(0x16, 0x03, 0x01, ch, chLen);
    let ccs = bytes.alloc(1); bytes.write_byte(ccs, 0, 1);
    mb.appendRecord(0x14, 0x03, 0x03, ccs, 1);

    bytes.free(base); bytes.free(ch); bytes.free(ccs);
    return ClientBio { buf: mb, cl: cl, state: 1, scratch: bytes.alloc(33792), scap: 33792, plain: bytes.alloc(33792),
                       verify: false, host: host, store: truststore.TrustStore { ders: List<long>(), lens: List<int>() },
                       rnd: rnd, sid: sid, ephPub: ephPub, ephPubP: ephPubP, ephPubP384: ephPubP384, alpn: alpn, hrrDone: false };
}

/// Starts a resumed TLS 1.3 client handshake using a previously-issued PSK/ticket
/// (see `ticketPtr`/`ticketPskPtr`/`ticketAge` on a prior `ClientBio`), with no early data sent.
pub fn newClientBioResume(host: string, alpn: string, psk: ptr, pskLen: int, kind: int,
                          ticket: ptr, ticketLen: int, ageAdd: long): ClientBio {
    let empty = bytes.alloc(1);
    let b = newClientBioResumeEx(host, alpn, psk, pskLen, kind, ticket, ticketLen, ageAdd, empty, 0);
    bytes.free(empty);
    return b;
}

/// Like `newClientBioResume`, additionally sending `earlyData` as 0-RTT application data
/// with the ClientHello. Whether it was accepted is reported later via `earlyAccepted`.
pub fn newClientBioResumeEarly(host: string, alpn: string, psk: ptr, pskLen: int, kind: int,
                               ticket: ptr, ticketLen: int, ageAdd: long, earlyData: ptr, earlyLen: int): ClientBio {
    return newClientBioResumeEx(host, alpn, psk, pskLen, kind, ticket, ticketLen, ageAdd, earlyData, earlyLen);
}

/// Shared implementation behind `newClientBioResume`/`newClientBioResumeEarly`: builds a
/// PSK-binding ClientHello (with an optional 0-RTT early-data extension and encrypted payload)
/// and queues it along with the compatibility ChangeCipherSpec.
pub fn newClientBioResumeEx(host: string, alpn: string, psk: ptr, pskLen: int, kind: int,
                            ticket: ptr, ticketLen: int, ageAdd: long, earlyData: ptr, earlyLen: int): ClientBio {
    let priv = bytes.alloc(32); fillRandom(priv, 32);
    let base = bytes.alloc(32); bytes.write_byte(base, 0, 9);
    let ephPub = bytes.alloc(32); x25519.scalarMult(ephPub, priv, base);
    let privP = bytes.alloc(32); fillRandom(privP, 32);
    let ephPubP = bytes.alloc(65); p256.derivePublic(ephPubP, privP);
    let privP384 = bytes.alloc(48); fillRandom(privP384, 48);
    let ephPubP384 = bytes.alloc(97); p384.derivePublic(ephPubP384, privP384);
    let cl = tlsClient.newClientResume(priv, privP, privP384, psk, pskLen, kind, ticket, ticketLen, ageAdd);

    let mb = newMemBuf();
    let rnd = bytes.alloc(32); fillRandom(rnd, 32);
    let sid = bytes.alloc(32); fillRandom(sid, 32);
    let ch = bytes.alloc(2048);
    let emptyCookie = bytes.alloc(1);
    let obfAge = ageAdd & 0xffffffff;
    let ed = 0; if (earlyLen > 0) { ed = 1; }
    let chLen = tlsClient.buildClientHelloEx(rnd, sid, ephPub, ephPubP, ephPubP384, host, alpn, 3, emptyCookie, 0,
        ticket, ticketLen, obfAge, pskLen, ed, ch);
    cl.fillResumptionBinder(ch, chLen);
    cl.addClientHello(ch, chLen);
    mb.appendRecord(0x16, 0x03, 0x01, ch, chLen);
    let ccs = bytes.alloc(1); bytes.write_byte(ccs, 0, 1);
    mb.appendRecord(0x14, 0x03, 0x03, ccs, 1);
    if (earlyLen > 0) {
        cl.deriveEarlyKeys();
        let er = bytes.alloc(earlyLen + 64);
        let en = cl.encryptEarly(earlyData, earlyLen, er);
        mb.appendOut(er, en);
        bytes.free(er);
    }

    bytes.free(base); bytes.free(ch); bytes.free(ccs); bytes.free(emptyCookie);
    return ClientBio { buf: mb, cl: cl, state: 1, scratch: bytes.alloc(33792), scap: 33792, plain: bytes.alloc(33792),
                       verify: false, host: host, store: truststore.TrustStore { ders: List<long>(), lens: List<int>() },
                       rnd: rnd, sid: sid, ephPub: ephPub, ephPubP: ephPubP, ephPubP384: ephPubP384, alpn: alpn, hrrDone: false };
}

/// Like `newClientBio`, but enables server certificate verification against `store` for `host`.
pub fn newClientBioVerify(host: string, store: truststore.TrustStore): ClientBio {
    let b = newClientBio(host);
    b.verify = true;
    b.store = store;
    return b;
}


/// Single-entry server-side session ticket store: holds at most one issued ticket id and its PSK.
pub struct TicketCache { /// Fixed-size backing buffer holding the cached ticket id, length, PSK and kind flags.
    pub store: ptr }
/// Allocates an empty `TicketCache` with no ticket cached yet.
pub fn newTicketCache(): TicketCache {
    let s = bytes.alloc(1088);
    bytes.write_byte(s, 0, 0);
    return TicketCache { store: s };
}
// Records a newly-issued ticket id and its resumption PSK, overwriting any previous entry (single-slot cache).
fn cachePut(c: TicketCache, id: ptr, idLen: int, psk: ptr, pskLen: int, kind: int): void {
    let s = c.store;
    bytes.write_byte(s, 0, 1);
    bytes.write_byte(s, 1, (idLen >> 8) & 0xff); bytes.write_byte(s, 2, idLen & 0xff);
    bytes.write_byte(s, 3, pskLen); bytes.write_byte(s, 4, kind);
    let i = 0;
    while (i < idLen) { bytes.write_byte(s, 8 + i, bytes.read_byte(id, i)); i = i + 1; }
    i = 0;
    while (i < pskLen) { bytes.write_byte(s, 1032 + i, bytes.read_byte(psk, i)); i = i + 1; }
}
// Checks whether the cache holds a valid entry whose ticket id matches `id`.
fn cacheEq(c: TicketCache, id: ptr, idLen: int): bool {
    let s = c.store;
    if (bytes.read_byte(s, 0) != 1) { return false; }
    let cLen = (bytes.read_byte(s, 1) << 8) | bytes.read_byte(s, 2);
    if (cLen != idLen) { return false; }
    let i = 0;
    while (i < idLen) { if (bytes.read_byte(s, 8 + i) != bytes.read_byte(id, i)) { return false; } i = i + 1; }
    return true;
}
fn cachePskLen(c: TicketCache): int { return bytes.read_byte(c.store, 3); }
fn cacheKind(c: TicketCache): int { return bytes.read_byte(c.store, 4); }
fn cachePskPtr(c: TicketCache): ptr { return (c.store as long + 1032) as ptr; }

/// Server-side TLS 1.3 connection driven over a `MemBuf`, implementing `TlsBio`.
///
/// Constructed via `newServerBio` (raw DER cert/key) or `newServerBioPem` (PEM text).
/// `step` processes the client's ClientHello (including optional early data and PSK
/// resumption via `cache`), sends the ServerHello/certificate/Finished flight, and
/// processes the client's Finished plus a NewSessionTicket for future resumption.
pub struct ServerBio impl TlsBio {
    /// Underlying record queue.
    pub buf: MemBuf,
    /// TLS 1.3 server handshake and record-protection engine.
    pub srv: tlsServer.TlsServer,
    /// Server random, generated fresh for this connection.
    pub sr: ptr,
    /// Handshake state: 0 = awaiting ClientHello, 1 = awaiting client Finished (and possibly early data), 2 = established, negative = failed.
    pub state: int,
    /// Scratch buffer used to hold one decoded record, and its capacity.
    pub scratch: ptr, pub scap: int,
    /// Scratch buffer used to hold one decrypted plaintext record.
    pub plain: ptr,
    /// Certificate DER and private key buffers, and whether this `ServerBio` owns (and must free) them.
    pub certOwned: ptr, pub keyOwned: ptr, pub owns: bool,
    /// Session ticket cache consulted for PSK resumption; see `useTicketCache`.
    pub cache: TicketCache,
    /// Whether 0-RTT early data is accepted; see `acceptEarlyData`.
    pub allowEarly: bool,
    /// Buffer accumulating decrypted 0-RTT early application data, its length so far, how much of it `readApp` has consumed, and whether EndOfEarlyData has been seen.
    pub earlyData: ptr, pub earlyDataLen: int, pub earlyRead: int, pub earlyDone: bool,

    pub fn feed(self: ServerBio, data: ptr, n: int): void { self.buf.feed(data, n); }
    pub fn markClosed(self: ServerBio): void { self.buf.closed = true; }
    /// Sets the list of ALPN protocols the server is willing to negotiate.
    pub fn offerAlpn(self: ServerBio, alpn: string): void { self.srv.alpnOffer = alpn; }
    pub fn selectedAlpn(self: ServerBio): string { return self.srv.alpnSel; }
    /// Enables or disables requesting a client certificate during the handshake.
    pub fn requestClientCert(self: ServerBio, on: bool): void { self.srv.setRequestClientCert(on); }
    /// Restricts the server to offering only the given cipher suite.
    pub fn restrictSuite(self: ServerBio, suite: int): void { self.srv.setRestrictSuite(suite); }
    /// Negotiated cipher suite family, as encoded by `tlsServer`.
    pub fn negotiatedKind(self: ServerBio): int { return self.srv.kind; }
    /// Negotiated cipher suite identifier.
    pub fn negotiatedSuite(self: ServerBio): int { return self.srv.suite; }
    /// Sets the OCSP response to staple into the server's Certificate message.
    pub fn setStapledOcsp(self: ServerBio, der: ptr, len: int): void { self.srv.setStapleOcsp(der, len); }
    /// Whether client certificate authentication succeeded (when requested).
    pub fn clientAuthOk(self: ServerBio): bool { return self.srv.clientAuthOk(); }
    /// Whether the client presented a certificate at all.
    pub fn clientPresentedCert(self: ServerBio): bool { return self.srv.clientPresentedCert(); }
    /// Sets the maximum plaintext record size the server is willing to receive.
    pub fn setRecordSizeLimit(self: ServerBio, limit: int): void { self.srv.recvLimit = limit; }
    /// Installs the `TicketCache` this connection consults for PSK resumption and populates on completion.
    pub fn useTicketCache(self: ServerBio, c: TicketCache): void { self.cache = c; }
    /// Enables or disables accepting 0-RTT early data offered by a resuming client.
    pub fn acceptEarlyData(self: ServerBio, on: bool): void { self.allowEarly = on; }
    /// Whether this connection resumed from a PSK/ticket rather than a full handshake.
    pub fn resumed(self: ServerBio): bool { return self.srv.pskAccepted; }
    /// Whether 0-RTT early data offered by the client was accepted.
    pub fn earlyAccepted(self: ServerBio): bool { return self.srv.earlyAccepted; }
    pub fn pendingOut(self: ServerBio): int { return self.buf.olen; }
    pub fn pull(self: ServerBio, buf: ptr, max: int): int { return self.buf.pull(buf, max); }

    /// Drives the server handshake forward using whatever records are buffered in `self.buf`.
    /// Validates any offered PSK against `cache`, sends the ServerHello/certificate/Finished
    /// flight, processes early data and the client's Finished, and issues a fresh NewSessionTicket.
    /// Returns 0 on completion, 1 while more input is expected, or -1 on a protocol failure.
    pub fn step(self: ServerBio): int {
        if (self.state == 2) { return 0; }
        if (self.state < 0) { return 0 - 1; }
        while (true) {
            let m = self.buf.nextRecord(self.scratch);
            if (m == 0) { return 1; }
            let ctype = bytes.read_byte(self.scratch, 0);
            if (ctype == 0x14) { continue; }
            if (self.state == 0) {
                if (ctype != 0x16) { self.state = 0 - 1; return 0 - 1; }
                self.srv.processClientHello(at(self.scratch, 5), m - 5);
                if (self.srv.pskIdLen > 0 && cacheEq(self.cache, self.srv.pskId, self.srv.pskIdLen)) {
                    let pl = cachePskLen(self.cache);
                    let i = 0;
                    while (i < pl) { bytes.write_byte(self.srv.psk, i, bytes.read_byte(cachePskPtr(self.cache), i)); i = i + 1; }
                    self.srv.pskLen = pl;
                    if (self.srv.verifyPskBinder()) {
                        if (self.allowEarly && self.srv.earlyOffered) { self.srv.deriveEarlyKeysServer(); }
                    }
                }
                let sh = bytes.alloc(1024);
                let shLen = self.srv.buildServerHello(self.sr, sh);
                self.buf.appendRecord(0x16, 0x03, 0x03, sh, shLen);
                let ccs = bytes.alloc(1); bytes.write_byte(ccs, 0, 1);
                self.buf.appendRecord(0x14, 0x03, 0x03, ccs, 1);
                let flight = bytes.alloc(8192);
                let fLen = self.srv.buildFlight(flight);
                self.buf.appendOut(flight, fLen);
                bytes.free(sh); bytes.free(ccs); bytes.free(flight);
                self.state = 1;
                return 1;
            } else if (self.state == 1) {
                if (self.srv.earlyAccepted && !self.earlyDone) {
                    let inner = self.srv.decryptEarly(self.scratch, m, self.plain);
                    if (inner < 0) { self.state = 0 - 1; return 0 - 1; }
                    let itype = bytes.read_byte(self.plain, inner - 1);
                    if (itype == 0x17) {
                        let dl = inner - 1;
                        let j = 0;
                        while (j < dl) { bytes.write_byte(self.earlyData, self.earlyDataLen + j, bytes.read_byte(self.plain, j)); j = j + 1; }
                        self.earlyDataLen = self.earlyDataLen + dl;
                        continue;
                    } else if (itype == 0x16 && bytes.read_byte(self.plain, 0) == 0x05) {
                        self.srv.addEndOfEarlyData();
                        self.earlyDone = true;
                        continue;
                    }
                    self.state = 0 - 1; return 0 - 1;
                }
                if (self.srv.requestClientCert && !self.srv.clientCertProcessed) {
                    if (!self.srv.processClientCertFlight(self.scratch, m)) { self.state = 0 - 1; return 0 - 1; }
                    continue;
                }
                if (!self.srv.processClientFinished(self.scratch, m)) { self.state = 0 - 1; return 0 - 1; }
                let hl = 32; if (self.srv.kind == 1) { hl = 48; }
                let tid = bytes.alloc(32); fillRandom(tid, 32);
                let nonce = bytes.alloc(8); fillRandom(nonce, 8);
                let ab = bytes.alloc(4); fillRandom(ab, 4);
                let ageAdd: long = ((bytes.read_byte(ab, 0) as long) << 24) | ((bytes.read_byte(ab, 1) as long) << 16)
                                 | ((bytes.read_byte(ab, 2) as long) << 8) | (bytes.read_byte(ab, 3) as long);
                let npsk = bytes.alloc(48);
                tls.deriveResumptionPsk(self.srv.kind, self.srv.resMaster, nonce, 8, npsk);
                cachePut(self.cache, tid, 32, npsk, hl, self.srv.kind);
                let nst = bytes.alloc(256);
                let nn = self.srv.newSessionTicketRecord(tid, 32, nonce, 8, ageAdd, self.allowEarly, nst);
                self.buf.appendOut(nst, nn);
                bytes.free(tid); bytes.free(nonce); bytes.free(ab); bytes.free(npsk); bytes.free(nst);
                self.state = 2;
                return 0;
            }
        }
        return 1;
    }

    /// Encrypts `n` bytes of application data, chunking to the negotiated record size limit, and queues it for output.
    pub fn writeApp(self: ServerBio, data: ptr, n: int): int {
        let cap = self.srv.sendLimit - 1;
        let off = 0;
        while (off < n) {
            let chunk = n - off;
            if (chunk > cap) { chunk = cap; }
            let out = bytes.alloc(chunk + 64);
            let m = self.srv.encryptApp((data as long + off) as ptr, chunk, out);
            self.buf.appendOut(out, m);
            bytes.free(out);
            off = off + chunk;
        }
        return n;
    }

    /// Returns any buffered 0-RTT early data first, then decrypts application records into `buf`.
    /// Returns the byte count, 0 if none is available yet, or -1 once a close_notify alert or a
    /// closed connection is seen.
    pub fn readApp(self: ServerBio, buf: ptr, max: int): int {
        if (self.earlyRead < self.earlyDataLen) {
            let take = self.earlyDataLen - self.earlyRead;
            if (take > max) { take = max; }
            let i = 0;
            while (i < take) { bytes.write_byte(buf, i, bytes.read_byte(self.earlyData, self.earlyRead + i)); i = i + 1; }
            self.earlyRead = self.earlyRead + take;
            return take;
        }
        while (true) {
            let m = self.buf.nextRecord(self.scratch);
            if (m == 0) { if (self.buf.closed) { return 0 - 1; } return 0; }
            let inner = self.srv.decryptApp(self.scratch, m, self.plain);
            if (inner > 0) {
                let itype = bytes.read_byte(self.plain, inner - 1);
                if (itype == 0x17) {
                    let take = inner - 1;
                    if (take > max) { take = max; }
                    let i = 0;
                    while (i < take) { bytes.write_byte(buf, i, bytes.read_byte(self.plain, i)); i = i + 1; }
                    return take;
                } else if (itype == 0x15) {
                    self.buf.closed = true;
                    return 0 - 1;
                }
            }
        }
        return 0;
    }

    /// Frees the `MemBuf`, scratch buffers, and the certificate/key buffers if this `ServerBio` owns them.
    pub fn closeBio(self: ServerBio): void {
        self.buf.freeBuffers();
        bytes.free(self.sr);
        bytes.free(self.scratch);
        bytes.free(self.plain);
        if (self.owns) { bytes.free(self.certOwned); bytes.free(self.keyOwned); }
    }
}

/// Creates a `ServerBio` from a raw DER certificate and matching private key, ready to receive a ClientHello.
/// The caller retains ownership of `certDer`/`signKey`; they are not freed by `closeBio`.
pub fn newServerBio(certDer: ptr, certLen: int, signKey: ptr): ServerBio {
    let ephPriv = bytes.alloc(32); fillRandom(ephPriv, 32);
    let ephPrivP = bytes.alloc(32); fillRandom(ephPrivP, 32);
    let ephPrivP384 = bytes.alloc(48); fillRandom(ephPrivP384, 48);
    let srv = tlsServer.newServer(certDer, certLen, signKey, ephPriv, ephPrivP, ephPrivP384);
    let sr = bytes.alloc(32); fillRandom(sr, 32);
    return ServerBio { buf: newMemBuf(), srv: srv, sr: sr, state: 0, scratch: bytes.alloc(33792),
                       scap: 33792, plain: bytes.alloc(33792), certOwned: certDer, keyOwned: signKey, owns: false, cache: newTicketCache(), allowEarly: false, earlyData: bytes.alloc(16384), earlyDataLen: 0, earlyRead: 0, earlyDone: false };
}


// One decoded DER tag-length-value: `tag` byte, `start`/`len` of the value, and `next` offset following it.
struct MbTlv { pub tag: int, pub start: int, pub len: int, pub next: int }

// Decodes one DER TLV at `pos`, supporting both short-form and multi-byte long-form lengths.
fn readTlv(buf: ptr, pos: int): MbTlv {
    let tag = bytes.read_byte(buf, pos);
    let p = pos + 1;
    let b = bytes.read_byte(buf, p);
    p = p + 1;
    let len = 0;
    if (b < 0x80) { len = b; }
    else {
        let nb = b & 0x7f;
        let i = 0;
        while (i < nb) { len = (len << 8) | bytes.read_byte(buf, p); p = p + 1; i = i + 1; }
    }
    return MbTlv { tag: tag, start: p, len: len, next: p + len };
}


// Naive substring search for `needle` in `hay` starting at `from`; returns -1 if not found.
fn indexOf(hay: string, needle: string, from: int): int {
    let n = hay.length; let m = needle.length;
    let i = from;
    while (i + m <= n) {
        let j = 0;
        while (j < m && hay[i + j] == needle[j]) { j = j + 1; }
        if (j == m) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

/// Extracts and base64-decodes the body of a PEM block delimited by `begin`/`end` markers, stripping whitespace.
/// Returns an empty string if the markers are not found in `pem`.
pub fn pemBody(pem: string, begin: string, end: string): string {
    let bs = indexOf(pem, begin, 0);
    if (bs < 0) { return ""; }
    let bodyStart = bs + begin.length;
    let es = indexOf(pem, end, bodyStart);
    if (es < 0) { return ""; }
    let clean = bytes.alloc(es - bodyStart);
    let n = 0;
    let i = bodyStart;
    while (i < es) {
        let c = pem[i];
        if (c != 10 && c != 13 && c != 32 && c != 9) { bytes.write_byte(clean, n, c); n = n + 1; }
        i = i + 1;
    }
    let b64 = bytes.alloc(n);
    let j = 0;
    while (j < n) { bytes.write_byte(b64, j, bytes.read_byte(clean, j)); j = j + 1; }
    bytes.free(clean);
    let der = base64.decode(b64 as string);
    bytes.free(b64);
    return der;
}

// Copies a DER INTEGER's value into a fixed 32-byte big-endian buffer, left-padding with zeros
// or dropping a leading sign/padding byte so the result is always exactly 32 bytes.
fn copyScalar32(derp: ptr, start: int, len: int): ptr {
    let out = bytes.alloc(32);
    let i = 0;
    while (i < 32) { bytes.write_byte(out, i, 0); i = i + 1; }
    let take = len; let src = start;
    if (take > 32) { src = start + (take - 32); take = 32; }
    let pad = 32 - take;
    i = 0;
    while (i < take) { bytes.write_byte(out, pad + i, bytes.read_byte(derp, src + i)); i = i + 1; }
    return out;
}

/// Parses a PEM-encoded EC private key (either SEC1 "EC PRIVATE KEY" or PKCS#8 "PRIVATE KEY" format)
/// and returns its 32-byte scalar value, decoding just enough DER structure to reach it.
/// Returns 32 zero bytes if neither PEM form is present.
pub fn ecKeyScalar(keyPem: string): ptr {
    let der = pemBody(keyPem, "-----BEGIN EC PRIVATE KEY-----", "-----END EC PRIVATE KEY-----");
    let pkcs8 = false;
    if (der.length < 8) { der = pemBody(keyPem, "-----BEGIN PRIVATE KEY-----", "-----END PRIVATE KEY-----"); pkcs8 = true; }
    if (der.length < 8) { return bytes.alloc(32); }
    let dp = der as ptr;
    let seq = readTlv(dp, 0);
    let ver = readTlv(dp, seq.start);
    if (pkcs8) {
        let alg = readTlv(dp, ver.next);
        let oct = readTlv(dp, alg.next);
        let inner = readTlv(dp, oct.start);
        let iver = readTlv(dp, inner.start);
        let priv = readTlv(dp, iver.next);
        return copyScalar32(dp, priv.start, priv.len);
    }
    let priv = readTlv(dp, ver.next);
    return copyScalar32(dp, priv.start, priv.len);
}

/// Creates a `ServerBio` from PEM-encoded certificate and EC private key text, decoding both to DER
/// first. Unlike `newServerBio`, the resulting cert/key buffers are owned and freed by `closeBio`.
pub fn newServerBioPem(certPem: string, keyPem: string): ServerBio {
    let certDer = pemBody(certPem, "-----BEGIN CERTIFICATE-----", "-----END CERTIFICATE-----");
    let certLen = certDer.length;
    let cbuf = bytes.alloc(certLen);
    let i = 0;
    while (i < certLen) { bytes.write_byte(cbuf, i, bytes.read_byte(certDer as ptr, i)); i = i + 1; }
    let scalar = ecKeyScalar(keyPem);
    let ephPriv = bytes.alloc(32); fillRandom(ephPriv, 32);
    let ephPrivP = bytes.alloc(32); fillRandom(ephPrivP, 32);
    let ephPrivP384 = bytes.alloc(48); fillRandom(ephPrivP384, 48);
    let srv = tlsServer.newServer(cbuf, certLen, scalar, ephPriv, ephPrivP, ephPrivP384);
    let sr = bytes.alloc(32); fillRandom(sr, 32);
    return ServerBio { buf: newMemBuf(), srv: srv, sr: sr, state: 0, scratch: bytes.alloc(33792),
                       scap: 33792, plain: bytes.alloc(33792), certOwned: cbuf, keyOwned: scalar, owns: true, cache: newTicketCache(), allowEarly: false, earlyData: bytes.alloc(16384), earlyDataLen: 0, earlyRead: 0, earlyDone: false };
}
