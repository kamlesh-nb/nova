//! A minimal async HTTPS client (GET only) built on top of `net.asynctls`.
//!
//! This file provides the request/response plumbing over an already-TLS'd
//! socket: it sends a bare HTTP/1.1 GET request, reads the raw response off
//! the wire, and hands it to `web.response.Response.parse` for header and
//! status parsing. It then undoes whatever the server did to the body on its
//! own: `Transfer-Encoding: chunked` framing is unwrapped by `dechunk`, and
//! `Content-Encoding: gzip` payloads are inflated via `compress.gzip`. The
//! result is the plain, decoded body a caller wants, not the wire bytes.
//!
//! Two entry points are exposed: `get`, which trusts the platform's usual
//! ALPN-negotiated TLS handshake, and `getVerified`, which pins the
//! connection to a caller-supplied CA certificate. Both parse the target URL
//! with `net.url`, open a `net.asynctls.TlsStream`, and drive the request
//! over it with `getOver`.

import bytes;
import string;
import list;
import map;
import net.asynctls;
import net.url;
import compress.gzip;
import web.response;
import web.status;

/// A parsed and decoded HTTPS response: status code, headers, and body.
///
/// `body` has already had chunked transfer-encoding removed and gzip
/// content-encoding decompressed, so it is the plain payload the server
/// intended, not the raw bytes off the wire.
pub struct HttpsResp {
    pub code: int,
    pub headers: Map<string, string>,
    pub body: string,
}

// Copies n bytes out of a raw buffer into an owned string.
fn bufToStr(buf: ptr, n: int): string {
    if (n <= 0) { return ""; }
    let out = bytes.alloc(n);
    let i = 0;
    while (i < n) { bytes.write_byte(out, i, bytes.read_byte(buf, i)); i = i + 1; }
    return out as string;
}

// Parses a leading run of hex digits into an int, stopping at the first non-hex character.
fn parseHex(s: string): int {
    let v = 0;
    let i = 0;
    while (i < s.length) {
        let c = s[i];
        let d = 0 - 1;
        if (c >= 48 && c <= 57) { d = c - 48; }
        else if (c >= 97 && c <= 102) { d = c - 97 + 10; }
        else if (c >= 65 && c <= 70) { d = c - 65 + 10; }
        if (d < 0) { break; }
        v = v * 16 + d;
        i = i + 1;
    }
    return v;
}

// Unwraps HTTP/1.1 chunked transfer-encoding: reads each "<hex-size>\r\n<data>\r\n" chunk
// and concatenates the data, stopping at the terminating zero-size chunk or on malformed framing.
fn dechunk(s: string): string {
    let out = List<string>();
    let pos = 0;
    while (pos < s.length) {
        let rest = string.slice(s, pos, s.length);
        let nl = string.indexOf(rest, "\r\n");
        if (nl == 0 - 1) { break; }
        let sizeLine = string.slice(s, pos, pos + nl);
        let size = parseHex(sizeLine);
        pos = pos + nl + 2;
        if (size == 0) { break; }
        if (pos + size > s.length) { break; }
        out.push(string.slice(s, pos, pos + size));
        pos = pos + size + 2;
    }
    return string.join(out, "");
}

// Parses a raw HTTP/1.1 response, then applies chunked-decoding and gzip-decompression
// to the body as indicated by the Transfer-Encoding and Content-Encoding headers.
fn frameResp(raw: string): HttpsResp {
    let r = response.Response.parse(raw);
    let code = Status.toCode(r.status);
    let te = string.toLowerCase(r.getHeader("transfer-encoding") ?? "");
    let ce = string.toLowerCase(r.getHeader("content-encoding") ?? "");
    let chunked = string.contains(te, "chunked");
    let gz = string.contains(ce, "gzip");
    let dechunked = if (chunked) dechunk(r.body) else r.body;
    let body = if (gz) gzip.decompress(dechunked) else dechunked;
    return HttpsResp{ code: code, headers: r.headers, body: body };
}

// Sends a "Connection: close" GET request over an established TLS stream, reads until
// the connection closes, then frames and decodes the response. Returns a zero-code
// HttpsResp with an empty body if the stream was already unhealthy or the send failed.
async fn getOver(ts: asynctls.TlsStream, u: url.Url): HttpsResp {
    if (!ts.ok()) { ts.close(); return HttpsResp{ code: 0, headers: Map<string, string>(4, string.hash), body: "" }; }
    let req = "GET " + u.path + " HTTP/1.1\r\nHost: " + u.host + "\r\nConnection: close\r\nAccept-Encoding: gzip\r\nUser-Agent: kyte-https/1.0\r\n\r\n";
    if (await ts.sendStr(req) < 0) { ts.close(); return HttpsResp{ code: 0, headers: Map<string, string>(4, string.hash), body: "" }; }
    let parts = List<string>();
    let buf = bytes.alloc(65536);
    while (true) {
        let n = await ts.recvInto(buf as long, 65536);
        if (n <= 0) { break; }
        parts.push(bufToStr(buf, n));
    }
    ts.close();
    return frameResp(string.join(parts, ""));
}

/// Performs an HTTPS GET, verifying the server certificate against `caPem`.
///
/// Use this when the server's certificate is not signed by a system-trusted
/// CA (for example an internal or self-signed CA) and the caller has the CA
/// certificate in hand to pin against.
pub async fn getVerified(urlStr: string, caPem: string): HttpsResp {
    let u = url.parse(urlStr);
    let ts = await asynctls.tlsConnectVerify(u.host, u.port, caPem);
    return await getOver(ts, u);
}

/// Performs an HTTPS GET against `urlStr`, negotiating TLS via ALPN for HTTP/1.1.
///
/// Relies on the platform's normal certificate trust chain; use `getVerified`
/// instead when the server presents a certificate that is not publicly
/// trusted.
pub async fn get(urlStr: string): HttpsResp {
    let u = url.parse(urlStr);
    let ts = await asynctls.tlsConnectAlpn(u.host, u.port, "http/1.1");
    return await getOver(ts, u);
}
