//! Coroutine-friendly, evented TCP I/O built on top of `net.eventloop`.
//!
//! This module is the layer application code actually calls: `ReactorStream`
//! wraps a connected socket file descriptor and gives it `async` recv/send
//! methods that suspend the current coroutine instead of blocking the thread
//! whenever the socket would otherwise return `EAGAIN`. Connect and accept
//! helpers (`reactorConnect`, `reactorAccept`, and their deadline variants)
//! build a `ReactorStream` the same way, submitting an op to the reactor and
//! resuming only once the kernel event backing it (kqueue, epoll, IOCP, or
//! io_uring, chosen by `net.eventloop`) reports completion.
//!
//! Every blocking-shaped operation here follows the same pattern: allocate an
//! op record with `nova_op_alloc`, describe it with `eventloop.makeOp`, submit
//! it to the reactor queue (`kq`), suspend with `coroSuspend()`, and free the
//! record with `nova_op_free` once `eventloop.opResult` reports the outcome.
//! Deadline variants additionally arm a reactor timer around the suspend so a
//! stalled peer cannot block a coroutine forever; on timeout the op is handed
//! to `eventloop.abandonOp` rather than freed outright, because the backend
//! may still own it (see the proactor note in the project `CLAUDE.md`).

import bytes;
import os.socket;
import os.backend;
import net.eventloop;

extern("c") fn nova_op_alloc(size: long): long;
extern("c") fn nova_op_free(op: long): void;

/// Returns the platform's "would block" errno value (`EAGAIN`/`EWOULDBLOCK`).
pub fn EAGAIN(): int { return backend.ERR_AGAIN; }
/// Returns the platform's "operation in progress" errno value, used to detect
/// a non-blocking `connect()` that has not completed yet.
pub fn EINPROGRESS(): int { return backend.ERR_INPROGRESS; }

/// Parses a dotted-decimal IPv4 address string into its 32-bit network-order
/// value, packed into a `long`. Does no validation: malformed input produces
/// an unspecified result rather than an error.
pub fn parseIPv4(s: string): long {
    let result = 0 as long;
    let cur = 0;
    let shift = 0;
    let i = 0;
    while (i < s.length) {
        let c = s[i];
        if (c == 46) {
            result = result | ((cur as long) << shift);
            shift = shift + 8;
            cur = 0;
        } else {
            cur = cur * 10 + (c - 48);
        }
        i = i + 1;
    }
    result = result | ((cur as long) << shift);
    return result;
}

// True if every character is a digit or a dot, i.e. the string looks like a
// literal IPv4 address rather than a hostname needing DNS resolution.
fn isNumericIPv4(s: string): bool {
    if (s.length == 0) { return false; }
    let i = 0;
    while (i < s.length) {
        let c = s[i];
        if (!((c >= 48 && c <= 57) || c == 46)) { return false; }
        i = i + 1;
    }
    return true;
}

/// Resolves a hostname (or numeric IPv4 literal) to its first IPv4 address,
/// packed into a `long` the same way `parseIPv4` does.
/// Returns `-1` if the string is numeric-only but unparsable, if
/// `getAddrInfo` fails, or if no `AF_INET` entry appears in the results.
/// This is a blocking DNS lookup: it does not suspend the coroutine or route
/// through the reactor.
pub fn resolveHost4(host: string): long {
    if (isNumericIPv4(host)) { return parseIPv4(host); }

    let n = host.length;
    let node = bytes.alloc(n + 1);
    let i = 0;
    while (i < n) { bytes.write_byte(node, i, host[i]); i = i + 1; }
    bytes.write_byte(node, n, 0);

    let res = bytes.alloc(8);
    bytes.write_ptr(res, 0, 0);
    let rc = socket.getAddrInfo(node, 0, 0, res);
    bytes.free(node);
    if (rc != 0) { bytes.free(res); return -1 as long; }

    let head = bytes.read_ptr(res, 0);
    let ai = head;
    let addr = -1 as long;
    while (ai != 0 && addr == (-1 as long)) {
        let fam = bytes.read_i32(ai, 4) as int;
        if (fam == socket.AF_INET) {
            let sa = bytes.read_ptr(ai, backend.ADDRINFO_ADDR_OFFSET);
            if (sa == 0) { ai = bytes.read_ptr(ai, 40); }
            else { addr = bytes.read_i32(sa, 4) as long; }
        } else {
            ai = bytes.read_ptr(ai, 40);
        }
    }
    if (head != 0) { socket.freeAddrInfo(head); }
    bytes.free(res);
    return addr;
}

/// A connected, non-blocking socket paired with the reactor queue it is
/// registered on. Every I/O method is `async`: it suspends the calling
/// coroutine when the socket is not immediately ready, instead of blocking
/// the OS thread, and resumes when the reactor reports the operation done.
/// A `fd` of `-1` marks a stream that failed to connect/accept or has been
/// closed; check with `isOpen()` before use.
pub class ReactorStream {
    /// The underlying socket file descriptor, or `-1` if not open.
    pub fd: int,
    /// The reactor queue handle this stream's operations are submitted to.
    pub kq: int,

    init(fd: int, kq: int) {
        self.fd = fd;
        self.kq = kq;
    }

    /// Reads up to `max` bytes into `buf` (a raw address). Returns the number
    /// of bytes read, `0` on peer shutdown (EOF), or `-1` on error.
    /// Tries a non-blocking read first; only suspends the coroutine if the
    /// socket would block.
    pub async fn recvInto(self: ReactorStream, buf: long, max: int): int {
        let r0 = socket.recvSock(self.fd, buf, max);
        if (r0 > 0) { return r0 as int; }
        if (r0 == 0) { return 0; }
        if (!socket.wouldBlock()) { return -1; }
        let op = nova_op_alloc(eventloop.OP_SIZE as long);
        eventloop.makeOp(op, eventloop.OP_RECV, self.fd, buf, max, currentCoro());
        if (eventloop.submit(self.kq, op) != 0) { nova_op_free(op); return -1; }
        coroSuspend();
        while (eventloop.opDone(op) != 1) { coroSuspend(); }
        let r = eventloop.opResult(op);
        nova_op_free(op);
        return r;
    }

    /// Same as `recvInto`, but aborts and returns `-2` if no data arrives
    /// within `timeoutMs` milliseconds. `timeoutMs <= 0` disables the
    /// deadline and simply delegates to `recvInto`.
    pub async fn recvIntoDeadline(self: ReactorStream, buf: long, max: int, timeoutMs: int): int {
        if (timeoutMs <= 0) { return await self.recvInto(buf, max); }
        let op = nova_op_alloc(eventloop.OP_SIZE as long);
        eventloop.makeOp(op, eventloop.OP_RECV, self.fd, buf, max, currentCoro());
        if (eventloop.submit(self.kq, op) != 0) { nova_op_free(op); return -1; }
        nova_reactor_set_timer(currentCoro(), timeoutMs as long);
        coroSuspend();
        nova_reactor_cancel_timer(currentCoro());
        if (eventloop.opDone(op) == 1) {
            let r = eventloop.opResult(op);
            nova_op_free(op);
            return r;
        }
        if (!eventloop.abandonOp(self.kq, op)) { nova_op_free(op); }
        return -2;
    }

    /// Writes exactly `len` bytes from `buf` (a raw address), looping until
    /// the whole buffer is sent. Returns the number of bytes written (equal
    /// to `len` on success, or fewer if the peer closed mid-write), or `-1`
    /// on error. Suspends the coroutine whenever the socket would block.
    pub async fn sendBuf(self: ReactorStream, buf: long, len: int): int {
        let sent = 0;
        while (sent < len) {
            let w = socket.sendSock(self.fd, buf + (sent as long), len - sent);
            if (w > 0) { sent = sent + (w as int); }
            else if (w == 0) { break; }
            else if (socket.wouldBlock()) { break; }
            else { return -1; }
        }
        while (sent < len) {
            let op = nova_op_alloc(eventloop.OP_SIZE as long);
            eventloop.makeOp(op, eventloop.OP_SEND, self.fd, buf + (sent as long), len - sent, currentCoro());
            if (eventloop.submit(self.kq, op) != 0) { nova_op_free(op); return -1; }
            coroSuspend();
            while (eventloop.opDone(op) != 1) { coroSuspend(); }
            let w = eventloop.opResult(op);
            nova_op_free(op);
            if (w > 0) { sent = sent + w; } else { return -1; }
        }
        return sent;
    }

    /// Convenience wrapper over `sendBuf` for an owned string's bytes.
    /// Returns `0` immediately for an empty string.
    pub async fn sendStr(self: ReactorStream, data: string): int {
        let len = data.length;
        if (len == 0) { return 0; }
        return await self.sendBuf(data as long, len);
    }

    /// Returns the raw file descriptor backing this stream.
    pub fn fdOf(self: ReactorStream): int { return self.fd; }
    /// True if the stream has a valid, not-yet-closed file descriptor.
    pub fn isOpen(self: ReactorStream): bool { return self.fd >= 0; }

    /// Cancels any pending read registration, closes the socket, and marks
    /// the stream closed (`fd = -1`). Safe to call on an already-closed
    /// stream (a no-op in that case).
    pub fn close(self: ReactorStream): void {
        if (self.fd >= 0) {
            eventloop.cancelRead(self.kq, self.fd);
            socket.close(self.fd);
            self.fd = -1;
        }
    }
}

/// Receives a file descriptor passed over a Unix domain control socket
/// (`ctrlFd`) via `SCM_RIGHTS`-style descriptor passing, suspending the
/// coroutine until one arrives. Returns the received descriptor, or `-1` on
/// submit failure.
pub async fn recvFdOp(ctrlFd: int, kq: int): int {
    let scratch: long = bytes.alloc(8);
    let op = nova_op_alloc(eventloop.OP_SIZE as long);
    eventloop.makeOp(op, eventloop.OP_RECVFD, ctrlFd, scratch, 8, currentCoro());
    if (eventloop.submit(kq, op) != 0) { nova_op_free(op); bytes.free(scratch); return -1; }
    coroSuspend();
    while (eventloop.opDone(op) != 1) { coroSuspend(); }
    let r = eventloop.opResult(op);
    nova_op_free(op);
    bytes.free(scratch);
    return r;
}

/// Resolves `host` and opens a non-blocking TCP connection to `host:port`,
/// suspending the coroutine while the connect is in flight. Returns a
/// `ReactorStream` wrapping the new socket, or one with `fd == -1` if
/// resolution, socket creation, or the connect itself fails.
pub async fn reactorConnect(host: string, port: int, kq: int): ReactorStream {
    let addr = resolveHost4(host);
    if (addr == (-1 as long)) { return ReactorStream(-1, kq); }
    let fd = socket.newTcp();
    if (fd < 0) { return ReactorStream(-1, kq); }
    socket.setNonBlock(fd);
    let sa = socket.makeSockaddrIn(port, addr);

    if (eventloop.connectIsSubmitted()) {
        let cop = nova_op_alloc(eventloop.OP_SIZE as long);
        eventloop.makeOp(cop, eventloop.OP_CONNECT, fd, sa, 16, currentCoro());
        if (eventloop.submit(kq, cop) != 0) {
            nova_op_free(cop); bytes.free(sa); socket.close(fd);
            return ReactorStream(-1, kq);
        }
        coroSuspend();
        let cres = eventloop.opResult(cop);
        nova_op_free(cop);
        bytes.free(sa);
        if (cres < 0) { socket.close(fd); return ReactorStream(-1, kq); }
        return ReactorStream(fd, kq);
    }

    let r = socket.connectSock(fd, sa, 16);
    bytes.free(sa);
    if (r != 0) {
        if (!socket.connectInProgress()) { socket.close(fd); return ReactorStream(-1, kq); }
        let op = nova_op_alloc(eventloop.OP_SIZE as long);
        eventloop.makeOp(op, eventloop.OP_CONNECT, fd, 0, 0, currentCoro());
        if (eventloop.submit(kq, op) != 0) { nova_op_free(op); return ReactorStream(-1, kq); }
        coroSuspend();
        let res = eventloop.opResult(op);
        nova_op_free(op);
        if (res != 0) { socket.close(fd); return ReactorStream(-1, kq); }
    }
    return ReactorStream(fd, kq);
}

/// Same as `reactorConnect`, but abandons the connect attempt (closing the
/// socket) and returns a `ReactorStream` with `fd == -1` if it has not
/// completed within `timeoutMs` milliseconds. `timeoutMs <= 0` disables the
/// deadline and delegates to `reactorConnect`.
pub async fn reactorConnectDeadline(host: string, port: int, kq: int, timeoutMs: int): ReactorStream {
    if (timeoutMs <= 0) { return await reactorConnect(host, port, kq); }
    let addr = resolveHost4(host);
    if (addr == (-1 as long)) { return ReactorStream(-1, kq); }
    let fd = socket.newTcp();
    if (fd < 0) { return ReactorStream(-1, kq); }
    socket.setNonBlock(fd);
    let sa = socket.makeSockaddrIn(port, addr);

    if (eventloop.connectIsSubmitted()) {
        let cop = nova_op_alloc(eventloop.OP_SIZE as long);
        eventloop.makeOp(cop, eventloop.OP_CONNECT, fd, sa, 16, currentCoro());
        if (eventloop.submit(kq, cop) != 0) {
            nova_op_free(cop); bytes.free(sa); socket.close(fd);
            return ReactorStream(-1, kq);
        }
        nova_reactor_set_timer(currentCoro(), timeoutMs as long);
        coroSuspend();
        nova_reactor_cancel_timer(currentCoro());
        bytes.free(sa);
        if (eventloop.opDone(cop) == 1) {
            let cres = eventloop.opResult(cop);
            nova_op_free(cop);
            if (cres < 0) { socket.close(fd); return ReactorStream(-1, kq); }
            return ReactorStream(fd, kq);
        }
        if (!eventloop.abandonOp(kq, cop)) { nova_op_free(cop); }
        socket.close(fd);
        return ReactorStream(-1, kq);
    }

    let r = socket.connectSock(fd, sa, 16);
    bytes.free(sa);
    if (r == 0) { return ReactorStream(fd, kq); }
    if (!socket.connectInProgress()) { socket.close(fd); return ReactorStream(-1, kq); }
    let op = nova_op_alloc(eventloop.OP_SIZE as long);
    eventloop.makeOp(op, eventloop.OP_CONNECT, fd, 0, 0, currentCoro());
    if (eventloop.submit(kq, op) != 0) { nova_op_free(op); socket.close(fd); return ReactorStream(-1, kq); }
    nova_reactor_set_timer(currentCoro(), timeoutMs as long);
    coroSuspend();
    nova_reactor_cancel_timer(currentCoro());
    if (eventloop.opDone(op) == 1) {
        let res = eventloop.opResult(op);
        nova_op_free(op);
        if (res != 0) { socket.close(fd); return ReactorStream(-1, kq); }
        return ReactorStream(fd, kq);
    }
    if (!eventloop.abandonOp(kq, op)) { nova_op_free(op); }
    socket.close(fd);
    return ReactorStream(-1, kq);
}

/// Accepts a single incoming connection on `listenFd`, suspending the
/// coroutine until one arrives. Disables Nagle's algorithm (`TCP_NODELAY`)
/// on the accepted socket. Returns a `ReactorStream` with `fd == -1` if the
/// submit fails or `accept` itself errors.
pub async fn reactorAccept(listenFd: int, kq: int): ReactorStream {
    let op = nova_op_alloc(eventloop.OP_SIZE as long);
    eventloop.makeOp(op, eventloop.OP_ACCEPT, listenFd, 0, 0, currentCoro());
    if (eventloop.submit(kq, op) != 0) { nova_op_free(op); return ReactorStream(-1, kq); }
    coroSuspend();
    let c = eventloop.opResult(op);
    nova_op_free(op);
    if (c >= 0) { let _ = socket.setTcpNoDelay(c); }
    return ReactorStream(c, kq);
}

/// Suspends the current coroutine for `ms` milliseconds via the reactor's
/// timer, yielding the thread to other coroutines instead of blocking it.
/// `ms <= 0` returns immediately without suspending.
pub async fn delayMs(ms: int): void {
    if (ms <= 0) { return; }
    nova_reactor_set_timer(currentCoro(), ms as long);
    coroSuspend();
    nova_reactor_cancel_timer(currentCoro());
}
