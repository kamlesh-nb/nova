import bytes;

extern("c") fn nova_bytes_copy(dst: long, src: long, len: long): void;
extern("c") fn nova_mem_set(dst: long, byteVal: long, len: long): void;
extern("c") fn nova_mem_cmp(a: long, b: long, len: long): long;
extern("c") fn nova_mem_find(p: long, byteVal: long, len: long): long;

pub fn copy(dst: long, src: long, len: long): void { nova_bytes_copy(dst, src, len); }

pub fn move(dst: long, src: long, len: long): void { nova_bytes_copy(dst, src, len); }

pub fn set(dst: long, byteVal: int, len: long): void { nova_mem_set(dst, byteVal as long, len); }

pub fn zero(dst: long, len: long): void { nova_mem_set(dst, 0 as long, len); }

pub fn compare(a: long, b: long, len: long): int { return nova_mem_cmp(a, b, len) as int; }

pub fn equal(a: long, b: long, len: long): bool { return nova_mem_cmp(a, b, len) == (0 as long); }

pub fn find(p: long, byteVal: int, len: long): long { return nova_mem_find(p, byteVal as long, len); }

pub fn dealloc<T>(obj: T): void {
    bytes.free(obj);
}
