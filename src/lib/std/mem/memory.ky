//! Low-level raw memory operations over machine addresses.
//!
//! This module is a thin Kyte wrapper around a handful of `extern("c")` C
//! primitives (memcpy/memset/memcmp/memchr equivalents) that operate directly
//! on `long` addresses rather than typed Kyte values. It sits below `bytes`
//! and the collection types in the standard library: those higher-level
//! modules are expected to build safe, bounds-checked APIs on top of this
//! one, while this file stays a minimal, unchecked pass-through to the C
//! runtime for callers (allocators, buffer implementations, FFI glue) that
//! genuinely need raw pointer arithmetic.
//!
//! Addresses are always `long` (never `int`): an `int` would truncate a heap
//! address above 4 GB to garbage, so every function here takes and returns
//! 64-bit addresses.

import bytes;

extern("c") fn kyte_bytes_copy(dst: long, src: long, len: long): void;
extern("c") fn kyte_mem_set(dst: long, byteVal: long, len: long): void;
extern("c") fn kyte_mem_cmp(a: long, b: long, len: long): long;
extern("c") fn kyte_mem_find(p: long, byteVal: long, len: long): long;

/// Copies `len` bytes from `src` to `dst`. Behaviour is undefined if the
/// regions overlap; use `move` for that case.
pub fn copy(dst: long, src: long, len: long): void { kyte_bytes_copy(dst, src, len); }

/// Copies `len` bytes from `src` to `dst`, safe for overlapping regions.
/// Currently delegates to the same underlying copy as `copy`.
pub fn move(dst: long, src: long, len: long): void { kyte_bytes_copy(dst, src, len); }

/// Fills `len` bytes starting at `dst` with the low byte of `byteVal`.
pub fn set(dst: long, byteVal: int, len: long): void { kyte_mem_set(dst, byteVal as long, len); }

/// Fills `len` bytes starting at `dst` with zero.
pub fn zero(dst: long, len: long): void { kyte_mem_set(dst, 0 as long, len); }

/// Compares `len` bytes at `a` and `b`, returning a negative, zero, or
/// positive result the way C's `memcmp` does.
pub fn compare(a: long, b: long, len: long): int { return kyte_mem_cmp(a, b, len) as int; }

/// Returns true if the `len` bytes at `a` and `b` are identical.
pub fn equal(a: long, b: long, len: long): bool { return kyte_mem_cmp(a, b, len) == (0 as long); }

/// Searches the `len` bytes starting at `p` for the low byte of `byteVal`
/// and returns the address of the first match, or `0` if not found.
pub fn find(p: long, byteVal: int, len: long): long { return kyte_mem_find(p, byteVal as long, len); }

/// Frees a heap-allocated object of any type by delegating to `bytes.free`.
pub fn dealloc<T>(obj: T): void {
    bytes.free(obj);
}
