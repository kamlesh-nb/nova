import os.socket;

pub class Fd {
    raw: int,
    closed: bool,

    init(raw: int) {
        self.raw = raw;
        self.closed = false;
    }

    pub fn get(self: Fd): int { return self.raw; }

    pub fn isClosed(self: Fd): bool { return self.closed; }

    pub fn close(self: Fd): int {
        if (self.closed) { return 0; }
        self.closed = true;
        return socket.close(self.raw);
    }

    pub fn delete(self: Fd): void {
        if (!self.closed) {
            self.closed = true;
            let _ = socket.close(self.raw);
        }
    }
}
