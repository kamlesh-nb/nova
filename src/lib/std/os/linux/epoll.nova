//! Raw Linux `epoll(7)` bindings and readiness-event buffer helpers.
//!
//! This module is the Linux backend for Nova's reactor: it declares the
//! `extern("c")` syscalls (`epoll_create1`, `epoll_ctl`, `epoll_wait`) plus
//! `eventfd`/`timerfd_create`/`timerfd_settime`, which the reactor uses for
//! cross-thread wakeups and timer deadlines respectively. It also encodes the
//! `struct epoll_event` layout by hand (there is no C struct marshalling in
//! Nova), so callers read and write raw event buffers through `setEvent`,
//! `evEvents`, and `evData` rather than a typed struct.
//!
//! Selected on Linux by the target-conditional file rule alongside
//! `os/windows`'s IOCP bindings and `os/darwin`'s kqueue bindings: callers in
//! the shared reactor code go through `net/ev/epoll`, which wraps these raw
//! bindings, not this module directly.

import bytes;
import platform;
import string;

/// Creates a new epoll instance. Returns the epoll file descriptor, or -1 on error (see `errno`).
pub extern("c") fn epoll_create1(flags: int): int;
/// Adds, modifies, or removes a watched file descriptor's interest set on an epoll instance.
///
/// `op` is one of `EPOLL_CTL_ADD`/`EPOLL_CTL_MOD`/`EPOLL_CTL_DEL`; `event` must point at an
/// `EPOLL_EVENT_SIZE`-byte buffer built with `setEvent` (ignored for `EPOLL_CTL_DEL`).
pub extern("c") fn epoll_ctl(epfd: int, op: int, fd: int, event: ptr): int;
/// Blocks until at least one watched descriptor is ready, `timeout` milliseconds elapse, or a
/// signal interrupts the call. `events` must point at a buffer sized for `maxevents` entries of
/// `EPOLL_EVENT_SIZE` bytes each; returns the number of ready entries written, or -1 on error.
pub extern("c") fn epoll_wait(epfd: int, events: ptr, maxevents: int, timeout: int): int;
/// Creates a kernel-backed event counter file descriptor, used here for cross-thread reactor wakeups.
pub extern("c") fn eventfd(initval: int, flags: int): int;
/// Creates a timer file descriptor that becomes readable when it expires, so timers can be polled via epoll.
pub extern("c") fn timerfd_create(clockid: int, flags: int): int;
/// Arms or disarms a timerfd's expiration. `newValue`/`oldValue` point at `struct itimerspec` buffers.
pub extern("c") fn timerfd_settime(fd: int, flags: int, newValue: ptr, oldValue: ptr): int;

/// Size in bytes of one `struct epoll_event` entry, and the byte offset of its `data` union. These are
/// ARCH-DEPENDENT on Linux: x86_64 marks the struct `__attribute__((packed))`, giving 12 bytes with
/// `data` at offset 4; every other arch (aarch64 included) leaves it naturally aligned -- 16 bytes with
/// 4 bytes of padding after the `events` mask, so `data` is at offset 8. Reading the completion `data`
/// word (a coroutine token) at the wrong stride/offset yields a garbage pointer and a SIGSEGV in the
/// reactor's resume path -- which is exactly what crashed the live-forwarding path on arm64 Linux.
pub fn EPOLL_EVENT_SIZE(): int { if (string.eql(platform.arch, "aarch64")) { return 16; } return 12; }
pub fn EPOLL_DATA_OFF(): int { if (string.eql(platform.arch, "aarch64")) { return 8; } return 4; }

/// `epoll_ctl` operation: register a new file descriptor.
pub const EPOLL_CTL_ADD: int = 1;
/// `epoll_ctl` operation: deregister a file descriptor.
pub const EPOLL_CTL_DEL: int = 2;
/// `epoll_ctl` operation: change the watched events for an already-registered file descriptor.
pub const EPOLL_CTL_MOD: int = 3;

/// Ready to read.
pub const EPOLLIN: int = 1;
/// Ready to write.
pub const EPOLLOUT: int = 4;
/// An error condition occurred on the descriptor.
pub const EPOLLERR: int = 8;
/// The descriptor's peer hung up (or was shut down).
pub const EPOLLHUP: int = 16;
/// The peer closed its write half (half-open shutdown detection).
pub const EPOLLRDHUP: int = 8192;
/// After delivering one event, disables the descriptor until it is explicitly re-armed with `EPOLL_CTL_MOD`.
pub const EPOLLONESHOT: int = 1073741824;
/// Requests edge-triggered rather than level-triggered notification.
///
/// Spelled as the SIGNED 32-bit bit pattern of `0x80000000`, not as `2147483648`.
/// The kernel's `events` mask is a `uint32_t`, but Nova's `int` is 32-bit SIGNED,
/// so the top bit cannot be written as a positive literal: `2147483648` does not
/// fit, and the compiler carries such a constant at 64 bits instead of truncating
/// it. `EPOLLIN | EPOLLET` then folded to `2147483649`, while reading the same
/// mask back out of an event buffer correctly sign-extended to `-2147483647` —
/// the two disagreed even though both describe `0x80000001`. Written this way the
/// constant, the fold, and the round trip all agree, and `setEvent`'s
/// `write_i32` still puts `0x80000000` on the wire. Conformance 189.
pub const EPOLLET: int = -2147483648;

/// `epoll_create1` flag: set the close-on-exec flag on the returned epoll descriptor.
pub const EPOLL_CLOEXEC: int = 524288;
/// `eventfd` flag: make the returned descriptor non-blocking.
pub const EFD_NONBLOCK: int = 2048;
/// `eventfd` flag: set close-on-exec on the returned descriptor.
pub const EFD_CLOEXEC: int = 524288;
/// `timerfd_create` flag: make the returned descriptor non-blocking.
pub const TFD_NONBLOCK: int = 2048;
/// Clock ID for `timerfd_create`: a monotonic clock unaffected by system time changes.
pub const CLOCK_MONOTONIC: int = 1;

/// Writes one `struct epoll_event` entry at index `i` into `buf`: the `events` mask and the opaque
/// `data` word (typically a pointer or an fd-derived tag) used to identify the descriptor on return.
pub fn setEvent(buf: ptr, i: int, events: int, data: long): void {
    let base = (i * EPOLL_EVENT_SIZE()) as long;
    bytes.write_i32(buf, base, events as long);
    bytes.write_ptr(buf, base + (EPOLL_DATA_OFF() as long), data);
}
/// Reads back the `events` mask of the entry at index `i` in an `epoll_wait` results buffer.
pub fn evEvents(buf: ptr, i: int): int { return bytes.read_i32(buf, (i * EPOLL_EVENT_SIZE()) as long) as int; }
/// Reads back the opaque `data` word of the entry at index `i` in an `epoll_wait` results buffer.
pub fn evData(buf: ptr, i: int): long { return bytes.read_ptr(buf, (i * EPOLL_EVENT_SIZE() + EPOLL_DATA_OFF()) as long); }

/// Registers `fd` on `epfd` watching `events`, tagged with `data`. Allocates and frees a scratch
/// event buffer internally. Returns 0 on success, -1 on error.
pub fn ctlAdd(epfd: int, fd: int, events: int, data: long): int {
    let ev = bytes.alloc(EPOLL_EVENT_SIZE());
    setEvent(ev, 0, events, data);
    let r = epoll_ctl(epfd, EPOLL_CTL_ADD, fd, ev);
    bytes.free(ev);
    return r;
}
/// Updates the watched `events`/`data` for an already-registered `fd` on `epfd`. Returns 0 on
/// success, -1 on error (e.g. if `fd` was never added).
pub fn ctlMod(epfd: int, fd: int, events: int, data: long): int {
    let ev = bytes.alloc(EPOLL_EVENT_SIZE());
    setEvent(ev, 0, events, data);
    let r = epoll_ctl(epfd, EPOLL_CTL_MOD, fd, ev);
    bytes.free(ev);
    return r;
}

/// Deregisters `fd` from `epfd`. Returns 0 on success, -1 on error.
pub fn ctlDel(epfd: int, fd: int): int {
    return epoll_ctl(epfd, EPOLL_CTL_DEL, fd, 0);
}
