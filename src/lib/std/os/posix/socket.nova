
//! POSIX socket wrapper for macOS/Linux (BSD sockets over the raw syscalls in
//! `os.sys`). Provides the address-family/socket-type constants, the thin
//! `sys.*` passthroughs (socket/bind/listen/accept/connect/read/write), and
//! the higher-level helpers built on top: blocking IPv4/IPv6 connect, a
//! listen-and-bind-any TCP helper, timeouts, reliable `sendAll`, Unix domain
//! sockets, and file-descriptor passing over `SCM_RIGHTS` (`sendFd`/`recvFd`).
//!
//! Numeric socket-option and errno values differ between Linux and Darwin
//! (BSD), so most of the small private helpers here branch on `platform.isLinux`
//! to pick the right constant rather than relying on libc headers. This module
//! sits underneath the OS-independent `os.socket` seam and the async reactor,
//! which layer non-blocking I/O and readiness polling on top of these raw
//! blocking primitives.

import os.sys;
import platform;
import bytes;

/// Address family value for IPv4 (`AF_INET`), same numeric value on both
/// Linux and Darwin.
pub const AF_INET: int = 2;
/// Socket type for a reliable, connection-oriented stream (`SOCK_STREAM`).
pub const SOCK_STREAM: int = 1;

/// errno value for EAGAIN/EWOULDBLOCK: 11 on Linux, 35 on Darwin.
fn eagain(): int { return if (platform.isLinux) 11 else 35; }
/// setsockopt/getsockopt level for socket-layer options (SOL_SOCKET).
fn solSocket(): int { return if (platform.isLinux) 1 else 65535; }
/// getsockopt option name for the pending socket error (SO_ERROR).
fn soErrorOpt(): int { return if (platform.isLinux) 4 else 4103; }
/// setsockopt option name for SO_REUSEPORT.
fn soReusePort(): int { return if (platform.isLinux) 15 else 512; }
// SO_REUSEADDR happens to share the same numeric value on both platforms.
const SO_REUSEADDR: int = 4;

/// Creates a new blocking IPv4 TCP socket. Returns the file descriptor, or a
/// negative value on failure (see `sys.errno()`).
pub fn newTcp(): int { return sys.socket(AF_INET, SOCK_STREAM, 0); }
/// Creates a new IPv4 UDP (datagram) socket.
pub fn newUdp(): int { return sys.socket(AF_INET, sys.SOCK_DGRAM, 0); }
/// Closes a file descriptor (socket or otherwise).
pub fn close(fd: int): int { return sys.close(fd); }
/// Binds a socket to the address in `addr` (a raw `sockaddr` buffer of
/// `addrlen` bytes), typically built by `makeSockaddrIn`/`makeSockaddrIn6`/`makeSockaddrUn`.
pub fn bindSock(fd: int, addr: ptr, addrlen: int): int { return sys.bind(fd, addr, addrlen); }
/// Marks a bound socket as listening, with `backlog` pending connections queued.
pub fn listenSock(fd: int, backlog: int): int { return sys.listen(fd, backlog); }
/// Accepts one pending connection. Pass `addr`/`addrlen` as `0` to discard the
/// peer address, as `acceptOne` does.
pub fn acceptSock(fd: int, addr: ptr, addrlen: ptr): int { return sys.accept(fd, addr, addrlen); }
/// Connects a socket to the address in `addr`. Blocks until the connection
/// completes or fails (use a non-blocking socket plus `connectInProgress` for
/// async connects).
pub fn connectSock(fd: int, addr: ptr, addrlen: int): int { return sys.connect(fd, addr, addrlen); }

/// Reads up to `len` bytes from `fd` into `buf`. Returns the byte count read,
/// `0` on EOF, or a negative value on error.
pub fn recvSock(fd: int, buf: long, len: int): long { return sys.read(fd, buf, len as long); }
/// Writes up to `len` bytes from `buf` to `fd`. May write fewer bytes than
/// requested; use `sendAll` when a full write is required.
pub fn sendSock(fd: int, buf: long, len: int): long { return sys.write(fd, buf, len as long); }

/// Puts a socket into non-blocking mode (O_NONBLOCK).
pub fn setNonBlock(fd: int): int { return sys.setNonBlocking(fd); }

/// Sets SO_REUSEADDR so a listening socket can rebind a port still in
/// TIME_WAIT (needed for fast server restarts).
pub fn setReuseAddr(fd: int): int {
    let one = bytes.alloc(4);
    bytes.write_i32(one, 0, 1);
    let r = sys.setsockopt(fd, solSocket(), SO_REUSEADDR, one, 4);
    bytes.free(one);
    return r;
}
/// Sets SO_REUSEPORT so multiple sockets/processes can bind the same port
/// (used for multi-worker listeners sharing one port).
pub fn setReusePort(fd: int): int {
    let one = bytes.alloc(4);
    bytes.write_i32(one, 0, 1);
    let r = sys.setsockopt(fd, solSocket(), soReusePort(), one, 4);
    bytes.free(one);
    return r;
}

/// Sets TCP_NODELAY, disabling Nagle's algorithm so small writes are sent
/// immediately instead of being coalesced.
pub fn setTcpNoDelay(fd: int): int {
    let one = bytes.alloc(4);
    bytes.write_i32(one, 0, 1);
    let r = sys.setsockopt(fd, 6, 1, one, 4);
    bytes.free(one);
    return r;
}

/// Reads and clears the pending SO_ERROR on a socket (e.g. to discover why a
/// non-blocking connect failed). Returns the errno value, or `-1` if the
/// getsockopt call itself failed.
pub fn sockError(fd: int): int {
    let val = bytes.alloc(4);
    let len = bytes.alloc(4);
    bytes.write_i32(val, 0, 0);
    bytes.write_i32(len, 0, 4);
    let r = sys.getsockopt(fd, solSocket(), soErrorOpt(), val, len);
    let e = if (r == 0) (bytes.read_i32(val, 0) as int) else -1;
    bytes.free(val);
    bytes.free(len);
    return e;
}

/// True when the most recent failing syscall on the current thread set
/// EAGAIN/EWOULDBLOCK, meaning a non-blocking read/write/accept has no data
/// ready right now rather than having genuinely failed.
pub fn wouldBlock(): bool { return sys.errno() == eagain(); }

/// errno value for EINPROGRESS: set when a non-blocking connect is still in
/// flight (115 on Linux, 36 on Darwin).
fn einprogress(): int { return if (platform.isLinux) 115 else 36; }
/// True when the most recent failing `connectSock` is still completing
/// asynchronously (non-blocking connect), rather than having failed outright.
pub fn connectInProgress(): bool { return sys.errno() == einprogress(); }

/// Builds a `sockaddr_in` (IPv4) struct for `port` and a big-endian address
/// `addrBE`. Caller owns and must `bytes.free` the returned buffer.
pub fn makeSockaddrIn(port: int, addrBE: long): ptr { return sys.makeSockaddrIn(port, addrBE); }
/// Returns the local port a socket is actually bound to (useful after
/// binding to port `0` to let the OS pick one).
pub fn boundPort(fd: int): int { return sys.boundPort(fd); }

/// Thin wrapper over `getaddrinfo(3)`: resolves `node`/`service` per `hints`
/// into the `addrinfo` linked list written to `res`. Returns `0` on success.
pub fn getAddrInfo(node: ptr, service: ptr, hints: ptr, res: ptr): int { return sys.getaddrinfo(node, service, hints, res); }
/// Frees an `addrinfo` list previously returned via `getAddrInfo`.
pub fn freeAddrInfo(res: ptr): void { sys.freeaddrinfo(res); }


/// setsockopt option name for SO_RCVTIMEO.
fn soRcvTimeo(): int { return if (platform.isLinux) 20 else 4102; }
/// setsockopt option name for SO_SNDTIMEO.
fn soSndTimeo(): int { return if (platform.isLinux) 21 else 4101; }
/// Byte offset of `ai_addr` within `struct addrinfo`: differs because
/// Linux and Darwin lay out the struct's fields differently.
fn aiAddrOffset(): int { return if (platform.isLinux) 24 else 32; }

/// True if `s` looks like a dotted-decimal IPv4 literal (digits and dots
/// only); does not validate octet ranges.
fn isNumericIPv4(s: string): bool {
    if (s.length == 0) { return false; }
    let i = 0;
    while (i < s.length) {
        let c = s[i];
        if (!((c >= 48 && c <= 57) || c == 46)) { return false; }
        i = i + 1;
    }
    return true;
}
/// Parses a dotted-decimal IPv4 literal into its 32-bit big-endian
/// representation (network byte order), matching what `sockaddr_in` expects.
fn parseIPv4BE(s: string): long {
    let result = 0 as long;
    let cur = 0;
    let shift = 0;
    let i = 0;
    while (i < s.length) {
        let c = s[i];
        if (c == 46) { result = result | ((cur as long) << shift); shift = shift + 8; cur = 0; }
        else { cur = cur * 10 + (c - 48); }
        i = i + 1;
    }
    result = result | ((cur as long) << shift);
    return result;
}

/// Resolves `host` to a big-endian IPv4 address. If `host` is already a
/// dotted-decimal literal it is parsed directly; otherwise it is looked up
/// via DNS (`getAddrInfo`), taking the first `AF_INET` result. Returns `-1`
/// if resolution fails or no IPv4 address is found.
pub fn resolveHost4(host: string): long {
    if (isNumericIPv4(host)) { return parseIPv4BE(host); }
    let n = host.length;
    let node = bytes.alloc(n + 1);
    let i = 0;
    while (i < n) { bytes.write_byte(node, i, host[i]); i = i + 1; }
    bytes.write_byte(node, n, 0);
    let res = bytes.alloc(8);
    bytes.write_ptr(res, 0, 0);
    let rc = getAddrInfo(node, 0, 0, res);
    bytes.free(node);
    if (rc != 0) { bytes.free(res); return -1 as long; }
    let head = bytes.read_ptr(res, 0);
    let ai = head;
    let addr = -1 as long;
    let off = aiAddrOffset();
    while (ai != 0 && addr == (-1 as long)) {
        let fam = bytes.read_i32(ai, 4) as int;
        if (fam == AF_INET) {
            let sa = bytes.read_ptr(ai, off);
            addr = bytes.read_i32(sa, 4) as long;
        } else {
            ai = bytes.read_ptr(ai, 40);
        }
    }
    if (head != 0) { freeAddrInfo(head); }
    bytes.free(res);
    return addr;
}

/// Resolves `host`, opens a new blocking IPv4 TCP socket, and connects it to
/// `host:port`. Returns the connected file descriptor, or `-1` on any
/// failure (resolution, socket creation, or connect).
pub fn connectBlocking(host: string, port: int): int {
    let addr = resolveHost4(host);
    if (addr == (-1 as long)) { return -1; }
    let fd = newTcp();
    if (fd < 0) { return -1; }
    let sa = makeSockaddrIn(port, addr);
    let r = connectSock(fd, sa, 16);
    bytes.free(sa);
    if (r != 0) { close(fd); return -1; }
    return fd;
}

/// Address family value for IPv6 (AF_INET6): 10 on Linux, 30 on Darwin.
fn afInet6(): int { return if (platform.isLinux) 10 else 30; }
/// Creates a new blocking IPv6 TCP socket.
pub fn newTcp6(): int { return sys.socket(afInet6(), SOCK_STREAM, 0); }

/// Builds a `sockaddr_in6` struct for `port` and a 16-byte raw address
/// buffer `addr16`. Caller owns and must `bytes.free` the returned buffer.
pub fn makeSockaddrIn6(port: int, addr16: ptr): ptr {
    let sa = bytes.alloc(28);
    let i = 0;
    while (i < 28) { bytes.write_byte(sa, i, 0); i = i + 1; }
    let fam = afInet6();
    if (platform.isLinux) {
        bytes.write_byte(sa, 0, fam & 0xff); bytes.write_byte(sa, 1, (fam >> 8) & 0xff);
    } else {
        bytes.write_byte(sa, 0, 28); bytes.write_byte(sa, 1, fam & 0xff);
    }
    bytes.write_byte(sa, 2, (port >> 8) & 0xff); bytes.write_byte(sa, 3, port & 0xff);
    let j = 0;
    while (j < 16) { bytes.write_byte(sa, 8 + j, bytes.read_byte(addr16, j)); j = j + 1; }
    return sa;
}

/// Opens a new blocking IPv6 TCP socket and connects it to the raw address
/// `addr16` (16 bytes) and `port`. Returns the connected file descriptor,
/// or `-1` on failure.
pub fn connectBlocking6(addr16: ptr, port: int): int {
    let fd = newTcp6();
    if (fd < 0) { return -1; }
    let sa = makeSockaddrIn6(port, addr16);
    let r = connectSock(fd, sa, 28);
    bytes.free(sa);
    if (r != 0) { close(fd); return -1; }
    return fd;
}

/// Sets both SO_RCVTIMEO and SO_SNDTIMEO on `fd` to `ms` milliseconds. Pass
/// `ms <= 0` to clear the timeout (block indefinitely). Returns `0` only if
/// both options were set successfully.
pub fn setTimeout(fd: int, ms: int): int {
    let tv = bytes.alloc(16);
    bytes.write_ptr(tv, 0, (if (ms > 0) (ms / 1000) else 0) as long);
    bytes.write_ptr(tv, 8, (if (ms > 0) ((ms % 1000) * 1000) else 0) as long);
    let r1 = sys.setsockopt(fd, solSocket(), soRcvTimeo(), tv, 16);
    let r2 = sys.setsockopt(fd, solSocket(), soSndTimeo(), tv, 16);
    bytes.free(tv);
    return if (r1 == 0 && r2 == 0) 0 else -1;
}

/// Writes the full `len` bytes from `buf` to `fd`, looping over `sendSock`
/// until everything is sent. Returns the total bytes sent, or `-1` if the
/// connection failed before any bytes went out (partial progress is still
/// reported as a positive count on failure).
pub fn sendAll(fd: int, buf: long, len: int): int {
    let total = 0;
    while (total < len) {
        let n = sendSock(fd, buf + (total as long), len - total);
        if (n <= 0) { return if (total > 0) total else -1; }
        total = total + (n as int);
    }
    return total;
}
/// Reads up to `max` bytes from `fd` in a single call. Returns the byte
/// count read (`0` means EOF), or `-1` on error.
pub fn recvOnce(fd: int, buf: long, max: int): int {
    let n = recvSock(fd, buf, max);
    return if (n < 0) -1 else (n as int);
}

/// Creates a blocking IPv4 TCP socket, sets SO_REUSEADDR, binds it to
/// `0.0.0.0:port`, and starts listening with a backlog of 128. Returns the
/// listening file descriptor, or `-1` if any step fails.
pub fn listenAny(port: int): int {
    let fd = newTcp();
    if (fd < 0) { return -1; }
    setReuseAddr(fd);
    let sa = makeSockaddrIn(port, 0);
    let br = bindSock(fd, sa, 16);
    bytes.free(sa);
    if (br != 0 || listenSock(fd, 128) != 0) { close(fd); return -1; }
    return fd;
}
/// Accepts one pending connection on a listening socket, discarding the
/// peer address. Returns the accepted file descriptor, or a negative value
/// on error.
pub fn acceptOne(fd: int): int { return acceptSock(fd, 0, 0); }

/// Address family value for Unix domain sockets (AF_UNIX/AF_LOCAL).
pub const AF_UNIX: int = 1;

/// Creates a new blocking Unix domain stream socket.
pub fn newUnix(): int { return sys.socket(AF_UNIX, SOCK_STREAM, 0); }

/// Size in bytes of `struct sockaddr_un` on this platform (110 on Linux,
/// 106 on Darwin), used to size the buffer built by `makeSockaddrUn`.
pub fn sockaddrUnLen(): int { return if (platform.isLinux) 110 else 106; }
/// Builds a `sockaddr_un` struct for the filesystem `path`. Caller owns
/// and must `bytes.free` the returned buffer. Does not NUL-terminate or
/// bounds-check `path` against the platform's path-length limit.
pub fn makeSockaddrUn(path: string): ptr {
    let sz = sockaddrUnLen();
    let sa = bytes.alloc(sz);
    let i = 0;
    while (i < sz) { bytes.write_byte(sa, i, 0); i = i + 1; }
    if (platform.isLinux) {
        bytes.write_byte(sa, 0, AF_UNIX & 0xff);
        bytes.write_byte(sa, 1, (AF_UNIX >> 8) & 0xff);
    } else {
        bytes.write_byte(sa, 0, sz);
        bytes.write_byte(sa, 1, AF_UNIX);
    }
    let n = path.length;
    let j = 0;
    while (j < n) { bytes.write_byte(sa, 2 + j, path[j]); j = j + 1; }
    return sa;
}

/// Creates a connected pair of Unix domain stream sockets (`socketpair`),
/// writing the two file descriptors into the 8-byte buffer `sv`. Returns
/// `0` on success.
pub fn unixPair(sv: ptr): int { return sys.socketpair(AF_UNIX, SOCK_STREAM, 0, sv); }

/// Sends `fd` to the peer on Unix domain socket `sock` via `SCM_RIGHTS`
/// ancillary data, along with a small `payload` string carried in the
/// regular message body. Returns the number of payload bytes sent, or a
/// negative value on failure.
pub fn sendFd(sock: int, fd: int, payload: string): long {
    let n = payload.length;
    let buf = bytes.alloc(if (n > 0) n else 1);
    let i = 0;
    while (i < n) { bytes.write_byte(buf, i, payload[i]); i = i + 1; }
    let r = sys.nova_send_fd(sock, buf, n as long, fd);
    bytes.free(buf);
    return r;
}

/// Result of receiving a passed file descriptor plus its accompanying
/// payload over `recvFd`.
pub struct HandoffResult {
    /// The received file descriptor, or `-1` if none was passed.
    pub fd: int,
    /// The payload bytes received alongside the descriptor, as a string.
    pub payload: string,
    /// Number of payload bytes actually received (may be `0` or negative
    /// on error, matching the raw `recvmsg` result).
    pub n: int,
}

/// Low-level `recvmsg`/`SCM_RIGHTS` receive: reads up to `cap` payload bytes
/// into `buf` and writes the received file descriptor into the 4-byte
/// buffer `outFd`. Prefer `recvFd`, which wraps this with buffer management.
pub fn recvFdRaw(fd: int, buf: long, cap: int, outFd: long): long {
    return sys.nova_recv_fd(fd, buf, cap as long, outFd);
}

/// Receives a file descriptor and its accompanying payload (up to `cap`
/// bytes) from Unix domain socket `sock`, the counterpart to `sendFd`.
pub fn recvFd(sock: int, cap: int): HandoffResult {
    let buf = bytes.alloc(if (cap > 0) cap else 1);
    let outFd = bytes.alloc(4);
    bytes.write_i32(outFd, 0, -1);
    let n = sys.nova_recv_fd(sock, buf, cap as long, outFd);
    let fd = bytes.read_i32(outFd, 0) as int;
    let payload = "";
    if (n > 0) { payload = bytes.read_string(buf, n as int); }
    bytes.free(outFd);
    bytes.free(buf);
    return HandoffResult { fd: fd, payload: payload, n: n as int };
}
