//! POSIX system-call bindings for the native (macOS/Linux) target.
//!
//! This file is the low-level FFI seam between Nova and the host operating
//! system: raw `extern("c")` declarations for sockets, files, directories,
//! memory mapping, and process environment, plus a thin layer of Nova helper
//! functions that wrap the awkward parts (C string conversion, struct field
//! layout via `bytes`, byte-order conversion) so higher levels of the standard
//! library do not have to poke at raw pointers directly.
//!
//! It is selected by the target-conditional file rule for POSIX hosts; the
//! Windows target has its own `os/windows/sys` with equivalent but
//! differently-shaped bindings (different `O_CREAT`/`O_TRUNC` values, no
//! `dirent.h`, and so on), so callers should generally go through the
//! OS-neutral wrappers in `os` rather than importing this module directly.

import bytes;
import os.backend;

/// Reads the calling thread's C `errno` value, as last set by a failed libc call.
pub extern("c") fn nova_ffi_errno(): int;
/// Overwrites the calling thread's C `errno`, mainly used to clear it before a call whose failure mode is ambiguous otherwise.
pub extern("c") fn nova_ffi_set_errno(v: int): void;
/// Sets `O_NONBLOCK` on `fd` via `fcntl`; returns the underlying `fcntl` result (negative on failure).
pub extern("c") fn nova_set_nonblock(fd: int): int;

/// Creates a new socket. Returns the file descriptor, or a negative value on failure (check `errno()`).
pub extern("c") fn socket(domain: int, type_: int, protocol: int): int;
/// Creates a connected pair of sockets (used for local loopback, e.g. `AF_UNIX`); writes the two descriptors into `sv`, which must point at 8 bytes.
pub extern("c") fn socketpair(domain: int, type_: int, protocol: int, sv: ptr): int;
/// Binds a socket to a local address described by the raw `sockaddr` bytes at `addr`.
pub extern("c") fn bind(fd: int, addr: ptr, addrlen: int): int;
/// Marks a bound socket as passive, ready to accept incoming connections up to `backlog` pending.
pub extern("c") fn listen(fd: int, backlog: int): int;
/// Accepts a pending connection; returns the new connection's file descriptor, or a negative value if none is ready (non-blocking sockets) or on error.
pub extern("c") fn accept(fd: int, addr: ptr, addrlen: ptr): int;
/// Initiates (or, for non-blocking sockets, begins) a connection to the address at `addr`.
pub extern("c") fn connect(fd: int, addr: ptr, addrlen: int): int;
/// Sets a socket option, e.g. `SO_REUSEPORT`, from the raw bytes at `optval`.
pub extern("c") fn setsockopt(fd: int, level: int, optname: int, optval: ptr, optlen: int): int;
/// Reads a socket option into the buffer at `optval`; `optlen` is both input capacity and output length.
pub extern("c") fn getsockopt(fd: int, level: int, optname: int, optval: ptr, optlen: ptr): int;
/// Writes the socket's locally bound address into the buffer at `addr`.
pub extern("c") fn getsockname(fd: int, addr: ptr, addrlen: ptr): int;
/// Resolves a hostname/service pair into a linked list of `addrinfo` results at `res`. The result must be freed with `freeaddrinfo`.
pub extern("c") fn getaddrinfo(node: ptr, service: ptr, hints: ptr, res: ptr): int;
/// Releases the linked list returned by `getaddrinfo`.
pub extern("c") fn freeaddrinfo(res: ptr): void;
/// Performs a raw `fcntl` file-control operation on `fd`.
pub extern("c") fn fcntl(fd: int, cmd: int, arg: int): int;
/// Reads up to `count` bytes from `fd` into `buf`. Returns the number of bytes read, 0 at end of file, or a negative value on error.
pub extern("c") fn read(fd: int, buf: ptr, count: long): long;
/// Writes up to `count` bytes from `buf` to `fd`. Returns the number of bytes written, which may be less than `count`.
pub extern("c") fn write(fd: int, buf: ptr, count: long): long;
/// Closes a file descriptor.
pub extern("c") fn close(fd: int): int;

/// Sends `data` over a Unix-domain socket along with an ancillary file descriptor `fd` (SCM_RIGHTS passing).
pub extern("c") fn nova_send_fd(sock: int, data: ptr, len: long, fd: int): long;
/// Receives a message and, if present, an ancillary file descriptor from a Unix-domain socket, writing the descriptor to `out_fd`.
pub extern("c") fn nova_recv_fd(sock: int, buf: ptr, cap: long, out_fd: ptr): long;

/// Blocks the calling thread for `ms` milliseconds.
pub extern("c") fn nova_sleep_ms(ms: long): void;

/// Reads an environment variable by C string name; returns a null pointer if it is not set.
pub extern("c") fn getenv(name: ptr): ptr;
/// Sets an environment variable; `overwrite` non-zero replaces an existing value, zero leaves it untouched.
pub extern("c") fn setenv(name: ptr, value: ptr, overwrite: int): int;

/// Opens (and optionally creates) a file, returning its file descriptor.
pub extern("c") fn nova_open(path: ptr, flags: int, mode: int): int;
/// Repositions the file offset of `fd` per `whence` (`SEEK_SET`/`SEEK_CUR`/`SEEK_END`); returns the resulting offset.
pub extern("c") fn lseek(fd: int, offset: long, whence: int): long;
/// Flushes `fd`'s in-kernel buffers to durable storage.
pub extern("c") fn fsync(fd: int): int;
/// Creates a directory with the given permission bits.
pub extern("c") fn mkdir(path: ptr, mode: int): int;
/// Removes an empty directory.
pub extern("c") fn rmdir(path: ptr): int;
/// Removes a file (or symlink).
pub extern("c") fn unlink(path: ptr): int;
/// Renames (or moves) a file or directory.
pub extern("c") fn rename(from: ptr, to: ptr): int;
/// Checks the calling process's access to `path` per the `amode` bitmask (e.g. `F_OK`).
pub extern("c") fn access(path: ptr, amode: int): int;
/// Fills `buf` with the `stat` structure for `path`, following symlinks.
pub extern("c") fn stat(path: ptr, buf: ptr): int;
/// Like `stat`, but does not follow a symlink at `path`; reports on the link itself.
pub extern("c") fn lstat(path: ptr, buf: ptr): int;
/// Writes the current working directory's absolute path into `buf` (capacity `size`); returns `buf`, or a null pointer if it does not fit.
pub extern("c") fn getcwd(buf: ptr, size: long): ptr;
/// Changes the calling process's current working directory.
pub extern("c") fn chdir(path: ptr): int;
/// Opens a directory stream for iteration with `readdir`.
pub extern("c") fn opendir(path: ptr): ptr;
/// Reads the next directory entry from an open stream; returns a null pointer at the end.
pub extern("c") fn readdir(dir: ptr): ptr;
/// Closes a directory stream opened with `opendir`.
pub extern("c") fn closedir(dir: ptr): int;

/// Maps `length` bytes of memory (or a file region, when `fd` is not `-1`). On failure returns `MAP_FAILED` (address `-1`); prefer the `mapAnon` wrapper, which checks this for you.
pub extern("c") fn mmap(addr: ptr, length: long, prot: int, flags: int, fd: int, offset: long): ptr;
/// Unmaps a region previously returned by `mmap`.
pub extern("c") fn munmap(addr: ptr, length: long): int;


/// `mmap`/`mprotect` protection flag: pages may be read.
pub const PROT_READ: int = 1;
/// `mmap`/`mprotect` protection flag: pages may be written.
pub const PROT_WRITE: int = 2;
/// `mmap` flag: changes are private to this process (copy-on-write), not shared with other mappers.
pub const MAP_PRIVATE: int = 2;
/// `mmap` flag for an anonymous mapping (not backed by a file). Value is platform-dependent, so it is resolved through `os.backend` rather than hardcoded.
pub fn MAP_ANON(): int { return backend.MMAP_ANON; }

/// Open a file for reading only.
pub const O_RDONLY: int = 0;
/// Open a file for writing only.
pub const O_WRONLY: int = 1;
/// Open a file for both reading and writing.
pub const O_RDWR: int = 2;
/// Create the file if it does not exist. Value is platform-dependent; resolved through `os.backend`.
pub fn O_CREAT(): int { return backend.OPEN_CREAT; }
/// Truncate an existing file to zero length on open. Value is platform-dependent; resolved through `os.backend`.
pub fn O_TRUNC(): int { return backend.OPEN_TRUNC; }
/// Position the file offset at the end of file before each write. Value is platform-dependent; resolved through `os.backend`.
pub fn O_APPEND(): int { return backend.OPEN_APPEND; }
/// `lseek` whence value: offset is relative to the start of the file.
pub const SEEK_SET: int = 0;
/// `lseek` whence value: offset is relative to the current position.
pub const SEEK_CUR: int = 1;
/// `lseek` whence value: offset is relative to the end of the file.
pub const SEEK_END: int = 2;
/// `access` mode: test only for the path's existence.
pub const F_OK: int = 0;

/// Bitmask that isolates the file-type bits of a `stat` mode value.
pub const S_IFMT: int = 61440;
/// `stat` mode file-type bit for a directory.
pub const S_IFDIR: int = 16384;
/// `stat` mode file-type bit for a regular file.
pub const S_IFREG: int = 32768;
/// `stat` mode file-type bit for a symbolic link.
pub const S_IFLNK: int = 40960;

/// Byte offset of the `st_mode` field within the raw `stat` struct, which differs across platforms and is resolved through `os.backend`.
pub fn STAT_MODE_OFF(): int { return backend.STAT_MODE_OFFSET; }
/// Byte offset of the file-name field within the raw `dirent` struct, which differs across platforms and is resolved through `os.backend`.
pub fn DIRENT_NAME_OFF(): int { return backend.DIRENT_NAME_OFFSET; }

/// Copies a Nova `string` into a freshly allocated, null-terminated C string.
///
/// The caller owns the returned buffer and must free it with `bytes.free`.
pub fn cstr(s: string): ptr {
    let n = s.length;
    let b = bytes.alloc(n + 1);
    let i = 0;
    while (i < n) { bytes.write_byte(b, i, s[i]); i = i + 1; }
    bytes.write_byte(b, n, 0);
    return b;
}

/// Reports whether a filesystem path exists (via `access(F_OK)`).
pub fn pathExists(path: string): bool {
    let cp = cstr(path);
    let r = access(cp, F_OK);
    bytes.free(cp);
    return r == 0;
}

/// Reads the raw `st_mode` field for `path` via `stat`. Returns `-1` if the path cannot be stat'd.
pub fn pathStatMode(path: string): int {
    let cp = cstr(path);
    let buf = bytes.alloc(160);
    let r = stat(cp, buf);
    let m = if (r == 0) (bytes.read_u16(buf, STAT_MODE_OFF()) as int) else -1;
    bytes.free(cp);
    bytes.free(buf);
    return m;
}

/// Reports whether `path` exists and is a directory. Returns `false` if the path cannot be stat'd.
pub fn pathIsDir(path: string): bool {
    let m = pathStatMode(path);
    if (m < 0) { return false; }
    return (m & S_IFMT) == S_IFDIR;
}

/// Scans the first `n` bytes at `s` for byte value `c`; returns a pointer to the first match, or a null pointer.
pub extern("c") fn memchr(s: ptr, c: int, n: long): ptr;
/// Byte-compares the first `n` bytes at `a` and `b`; returns 0 for equal, negative/positive per the first differing byte.
pub extern("c") fn memcmp(a: ptr, b: ptr, n: long): int;
/// Copies `n` bytes from `src` to `dst`. The regions must not overlap; use `memmove` when they might.
pub extern("c") fn memcpy(dst: ptr, src: ptr, n: long): ptr;
/// Copies `n` bytes from `src` to `dst`, correctly handling overlapping regions.
pub extern("c") fn memmove(dst: ptr, src: ptr, n: long): ptr;

/// Address family for IPv4 sockets.
pub const AF_INET: int = 2;
/// Socket type for connection-oriented, reliable byte streams (TCP).
pub const SOCK_STREAM: int = 1;
/// Socket type for connectionless datagrams (UDP).
pub const SOCK_DGRAM: int = 2;
/// `setsockopt`/`getsockopt` level for socket-layer options. Value is platform-dependent; resolved through `os.backend`.
pub fn SOL_SOCKET(): int { return backend.SOCKOPT_LEVEL; }
/// `fcntl` flag that puts a file descriptor into non-blocking mode. Value is platform-dependent; resolved through `os.backend`.
pub fn O_NONBLOCK(): int { return backend.OPEN_NONBLOCK; }
/// `fcntl` command: get the file status flags.
pub const F_GETFL: int = 3;
/// `fcntl` command: set the file status flags.
pub const F_SETFL: int = 4;

/// Address family for Unix-domain (local) sockets.
pub const AF_UNIX: int = 1;

/// `getsockopt` option name for the pending socket error. Value is platform-dependent; resolved through `os.backend`.
pub fn SO_ERROR(): int { return backend.SOCKOPT_ERROR; }

/// `setsockopt` option name to allow multiple sockets to bind the same port (load balancing across processes). Value is platform-dependent; resolved through `os.backend`.
pub fn SO_REUSEPORT(): int { return backend.SOCKOPT_REUSEPORT; }

/// Reads the calling thread's current C `errno`.
pub fn errno(): int { return nova_ffi_errno(); }
/// Resets the calling thread's C `errno` to 0.
pub fn clearErrno(): void { nova_ffi_set_errno(0); }

/// Reads and clears a socket's pending error via `SO_ERROR`. Returns `-1` if `getsockopt` itself fails.
pub fn soError(fd: int): int {
    let val = bytes.alloc(4);
    let len = bytes.alloc(4);
    bytes.write_i32(val, 0, 0);
    bytes.write_i32(len, 0, 4);
    let r = getsockopt(fd, SOL_SOCKET(), SO_ERROR(), val, len);
    let e = if (r == 0) (bytes.read_i32(val, 0) as int) else -1;
    bytes.free(val);
    bytes.free(len);
    return e;
}

/// Creates a new socket with the default protocol for `domain`/`type_`. Thin wrapper over `socket`.
pub fn newSocket(domain: int, type_: int): int { return socket(domain, type_, 0); }

/// Creates a connected pair of sockets and returns their descriptors as a tuple. Returns `(-1, -1)` on failure.
pub fn newSocketPair(domain: int, type_: int): (int, int) {
    let sv = bytes.alloc(8);
    let r = socketpair(domain, type_, 0, sv);
    if (r != 0) {
        bytes.free(sv);
        return (-1, -1);
    }
    let a = bytes.read_i32(sv, 0) as int;
    let b = bytes.read_i32(sv, 4) as int;
    bytes.free(sv);
    return (a, b);
}

/// Puts `fd` into non-blocking mode. Thin wrapper over `nova_set_nonblock`.
pub fn setNonBlocking(fd: int): int {
    return nova_set_nonblock(fd);
}

/// Enables `SO_REUSEPORT` on a socket so multiple sockets/processes can bind the same address.
pub fn setReusePort(fd: int): int {
    let one = bytes.alloc(4);
    bytes.write_i32(one, 0, 1);
    let r = setsockopt(fd, SOL_SOCKET(), SO_REUSEPORT(), one, 4);
    bytes.free(one);
    return r;
}

/// Allocates `length` bytes of anonymous, private, read-write memory via `mmap`. Returns a null pointer on failure instead of `MAP_FAILED`.
pub fn mapAnon(length: long): ptr {
    let p = mmap(0, length, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON(), -1, 0);
    let pl = p as long;
    if (pl == -1 || pl == 0) {
        return 0;
    }
    return p;
}

/// Unmaps a region previously returned by `mapAnon`. Thin wrapper over `munmap`.
pub fn unmap(addr: ptr, length: long): int {
    return munmap(addr, length);
}

/// Builds a raw IPv4 `sockaddr_in` structure (16 bytes, zero-padded) for the given port and address.
///
/// `port` is in host byte order (converted internally via `htons`); `addrBE` must
/// already be a 32-bit IPv4 address in network byte order. The caller owns the
/// returned buffer and must free it with `bytes.free`.
pub fn makeSockaddrIn(port: int, addrBE: long): ptr {
    let sa = bytes.alloc(16);
    let i = 0;
    while (i < 16) { bytes.write_byte(sa, i, 0); i = i + 1; }
    bytes.write_u16(sa, 0, AF_INET as long);
    bytes.write_u16(sa, 2, htons(port) as long);
    bytes.write_i32(sa, 4, addrBE);
    return sa;
}

/// Reads back the local port a socket is bound to (useful after binding to port 0 for an ephemeral port). Returns `-1` on failure.
pub fn boundPort(fd: int): int {
    let sa = bytes.alloc(16);
    let len = bytes.alloc(4);
    bytes.write_i32(len, 0, 16);
    let r = getsockname(fd, sa, len);
    let p = if (r == 0) (htons(bytes.read_u16(sa, 2) as int)) else -1;
    bytes.free(sa);
    bytes.free(len);
    return p;
}

/// Converts a 16-bit value from host byte order to network (big-endian) byte order. Symmetric, so it also serves as `ntohs`.
pub fn htons(x: int): int {
    let lo = x & 255;
    let hi = (x >> 8) & 255;
    return (lo << 8) | hi;
}
