
import bytes;
import os.windows.fs;
import os.windows.winsock;

pub extern("c") fn nova_ffi_errno(): int;
pub extern("c") fn nova_ffi_set_errno(v: int): void;
pub extern("c") fn nova_sleep_ms(ms: long): void;
pub extern("c") fn nova_set_nonblock(fd: int): int;

pub fn socket(domain: int, type_: int, protocol: int): int {
    winsock.startup();
    return winsock.socket(domain, type_, protocol) as int;
}
pub fn getaddrinfo(node: ptr, service: ptr, hints: ptr, res: ptr): int {
    winsock.startup();
    return winsock.getaddrinfo(node, service, hints, res);
}

pub extern("c") fn bind(fd: int, addr: ptr, addrlen: int): int;
pub extern("c") fn listen(fd: int, backlog: int): int;
pub extern("c") fn accept(fd: int, addr: ptr, addrlen: ptr): int;
pub extern("c") fn connect(fd: int, addr: ptr, addrlen: int): int;
pub extern("c") fn setsockopt(fd: int, level: int, optname: int, optval: ptr, optlen: int): int;
pub extern("c") fn getsockopt(fd: int, level: int, optname: int, optval: ptr, optlen: ptr): int;
pub extern("c") fn getsockname(fd: int, addr: ptr, addrlen: ptr): int;
pub extern("c") fn freeaddrinfo(res: ptr): void;

pub extern("c") fn getenv(name: ptr): ptr;

pub extern("c") fn memchr(s: ptr, c: int, n: long): ptr;
pub extern("c") fn memcmp(a: ptr, b: ptr, n: long): int;
pub extern("c") fn memcpy(dst: ptr, src: ptr, n: long): ptr;
pub extern("c") fn memmove(dst: ptr, src: ptr, n: long): ptr;

pub const PROT_READ: int = 1;
pub const PROT_WRITE: int = 2;
pub const MAP_PRIVATE: int = 2;
pub fn MAP_ANON(): int { return 0; }

pub const O_RDONLY: int = 0;
pub const O_WRONLY: int = 1;
pub const O_RDWR: int = 2;
pub fn O_CREAT(): int { return 256; }
pub fn O_TRUNC(): int { return 512; }
pub fn O_APPEND(): int { return 8; }
pub const SEEK_SET: int = 0;
pub const SEEK_CUR: int = 1;
pub const SEEK_END: int = 2;
pub const F_OK: int = 0;

pub const S_IFMT: int = 61440;
pub const S_IFDIR: int = 16384;
pub const S_IFREG: int = 32768;
pub const S_IFLNK: int = 40960;

fn STAT_MODE_OFF(): int { return 4; }
pub fn DIRENT_NAME_OFF(): int { return 21; }

pub const AF_INET: int = 2;
pub const SOCK_STREAM: int = 1;
pub const SOCK_DGRAM: int = 2;
pub fn SOL_SOCKET(): int { return 65535; }
pub fn O_NONBLOCK(): int { return 0; }
pub const F_GETFL: int = 3;
pub const F_SETFL: int = 4;
pub const AF_UNIX: int = 1;
pub const INADDR_LOOPBACK_BE: long = 16777343;
pub fn SO_ERROR(): int { return 4103; }
pub fn SO_REUSEPORT(): int { return 4; }

const ENOENT: int = 2;
const EIO: int = 5;
const EBADF: int = 9;
const EACCES: int = 13;
const EEXIST: int = 17;
const ENOTEMPTY: int = 41;

const ERROR_FILE_NOT_FOUND: int = 2;
const ERROR_PATH_NOT_FOUND: int = 3;
const ERROR_ACCESS_DENIED: int = 5;
const ERROR_INVALID_HANDLE: int = 6;
const ERROR_FILE_EXISTS: int = 80;
const ERROR_DIR_NOT_EMPTY: int = 145;
const ERROR_ALREADY_EXISTS: int = 183;

fn failWith(e: int): int {
    nova_ffi_set_errno(e);
    return -1;
}

fn fail(): int {
    let w = fs.GetLastError();
    if (w == ERROR_FILE_NOT_FOUND || w == ERROR_PATH_NOT_FOUND) { return failWith(ENOENT); }
    if (w == ERROR_ACCESS_DENIED) { return failWith(EACCES); }
    if (w == ERROR_INVALID_HANDLE) { return failWith(EBADF); }
    if (w == ERROR_FILE_EXISTS || w == ERROR_ALREADY_EXISTS) { return failWith(EEXIST); }
    if (w == ERROR_DIR_NOT_EMPTY) { return failWith(ENOTEMPTY); }
    return failWith(EIO);
}

pub fn cstr(s: string): ptr {
    let n = s.length;
    let b = bytes.alloc(n + 1);
    let i = 0;
    while (i < n) { bytes.write_byte(b, i, s[i]); i = i + 1; }
    bytes.write_byte(b, n, 0);
    return b;
}

fn accessFor(flags: int): int {
    if ((flags & O_APPEND()) != 0) {
        let a = fs.FILE_APPEND_DATA;
        return if ((flags & O_RDWR) != 0) (a | fs.GENERIC_READ) else a;
    }
    if ((flags & O_RDWR) != 0) { return fs.GENERIC_READ | fs.GENERIC_WRITE; }
    if ((flags & O_WRONLY) != 0) { return fs.GENERIC_WRITE; }
    return fs.GENERIC_READ;
}

fn dispositionFor(flags: int): int {
    let creat = (flags & O_CREAT()) != 0;
    let trunc = (flags & O_TRUNC()) != 0;
    if (creat && trunc) { return fs.CREATE_ALWAYS; }
    if (creat) { return fs.OPEN_ALWAYS; }
    if (trunc) { return fs.TRUNCATE_EXISTING; }
    return fs.OPEN_EXISTING;
}

pub fn nova_open(path: ptr, flags: int, mode: int): int {
    let w = fs.widen(path);
    if (w == (0 as ptr)) { return -1; }
    let share = fs.FILE_SHARE_READ | fs.FILE_SHARE_WRITE | fs.FILE_SHARE_DELETE;
    let h = fs.CreateFileW(w, accessFor(flags), share, 0 as ptr,
                              dispositionFor(flags), fs.FILE_ATTRIBUTE_NORMAL, 0 as long);
    bytes.free(w);
    if (h == fs.INVALID_HANDLE) { return fail(); }
    return h as int;
}

pub fn read(fd: int, buf: ptr, count: long): long {
    let got = bytes.alloc(4);
    bytes.write_i32(got, 0, 0);
    let ok = fs.ReadFile(fd as long, buf, count as int, got, 0 as ptr);
    let n = bytes.read_i32(got, 0) as int;
    bytes.free(got);
    if (ok != 0) { return n as long; }
    let r = winsock.recv(fd as long, buf, count as int, 0);
    return if (r >= 0) (r as long) else (-1 as long);
}

pub fn write(fd: int, buf: ptr, count: long): long {
    let wrote = bytes.alloc(4);
    bytes.write_i32(wrote, 0, 0);
    let ok = fs.WriteFile(fd as long, buf, count as int, wrote, 0 as ptr);
    let n = bytes.read_i32(wrote, 0) as int;
    bytes.free(wrote);
    if (ok != 0) { return n as long; }
    let r = winsock.send(fd as long, buf, count as int, 0);
    return if (r >= 0) (r as long) else (-1 as long);
}

pub fn close(fd: int): int {
    if (fd < 0) { return failWith(EBADF); }
    if (winsock.closesocket(fd as long) == 0) { return 0; }
    if (fs.CloseHandle(fd as long) != 0) { return 0; }
    return fail();
}

pub fn lseek(fd: int, offset: long, whence: int): long {
    let out = bytes.alloc(8);
    bytes.write_ptr(out, 0, 0);
    let ok = fs.SetFilePointerEx(fd as long, offset, out, whence);
    let pos = bytes.read_ptr(out, 0);
    bytes.free(out);
    return if (ok != 0) (pos as long) else (-1 as long);
}

pub fn fsync(fd: int): int {
    return if (fs.FlushFileBuffers(fd as long) != 0) 0 else fail();
}

fn attrsOf(path: ptr): int {
    let w = fs.widen(path);
    if (w == (0 as ptr)) { return fs.INVALID_FILE_ATTRIBUTES; }
    let a = fs.GetFileAttributesW(w);
    bytes.free(w);
    return a;
}

pub fn mkdir(path: ptr, mode: int): int {
    let w = fs.widen(path);
    if (w == (0 as ptr)) { return -1; }
    let r = fs.CreateDirectoryW(w, 0 as ptr);
    bytes.free(w);
    return if (r != 0) 0 else fail();
}

pub fn rmdir(path: ptr): int {
    let w = fs.widen(path);
    if (w == (0 as ptr)) { return -1; }
    let r = fs.RemoveDirectoryW(w);
    bytes.free(w);
    return if (r != 0) 0 else fail();
}

pub fn unlink(path: ptr): int {
    let w = fs.widen(path);
    if (w == (0 as ptr)) { return -1; }
    let r = fs.DeleteFileW(w);
    bytes.free(w);
    return if (r != 0) 0 else fail();
}

pub fn rename(from: ptr, to: ptr): int {
    let a = fs.widen(from);
    if (a == (0 as ptr)) { return -1; }
    let b = fs.widen(to);
    if (b == (0 as ptr)) { bytes.free(a); return -1; }
    let r = fs.MoveFileExW(a, b, fs.MOVEFILE_REPLACE_EXISTING);
    bytes.free(a);
    bytes.free(b);
    return if (r != 0) 0 else fail();
}

pub fn access(path: ptr, amode: int): int {
    return if (attrsOf(path) != fs.INVALID_FILE_ATTRIBUTES) 0 else failWith(ENOENT);
}

pub fn stat(path: ptr, buf: ptr): int {
    let a = attrsOf(path);
    if (a == fs.INVALID_FILE_ATTRIBUTES) { return failWith(ENOENT); }
    let isDir = (a & fs.FILE_ATTRIBUTE_DIRECTORY) != 0;
    let isLink = (a & fs.FILE_ATTRIBUTE_REPARSE_POINT) != 0;
    let mode = if (isDir) S_IFDIR else S_IFREG;
    bytes.write_u16(buf, STAT_MODE_OFF(), mode as long);
    return 0;
}

pub fn lstat(path: ptr, buf: ptr): int {
    let a = attrsOf(path);
    if (a == fs.INVALID_FILE_ATTRIBUTES) { return failWith(ENOENT); }
    let mode = if ((a & fs.FILE_ATTRIBUTE_REPARSE_POINT) != 0) S_IFLNK
               else if ((a & fs.FILE_ATTRIBUTE_DIRECTORY) != 0) S_IFDIR
               else S_IFREG;
    bytes.write_u16(buf, STAT_MODE_OFF(), mode as long);
    return 0;
}

pub fn getcwd(buf: ptr, size: long): ptr {
    let cap = (size as int) / 2;
    let w = bytes.alloc(cap * 2);
    let n = fs.GetCurrentDirectoryW(cap, w);
    if (n <= 0 || n > cap) { bytes.free(w); return 0 as ptr; }
    let written = fs.narrowInto(w, buf, size as int);
    bytes.free(w);
    return if (written > 0) buf else (0 as ptr);
}

pub fn chdir(path: ptr): int {
    let w = fs.widen(path);
    if (w == (0 as ptr)) { return -1; }
    let r = fs.SetCurrentDirectoryW(w);
    bytes.free(w);
    return if (r != 0) 0 else fail();
}

const DIR_FIND_OFF: int = 0;
const DIR_PENDING_OFF: int = 8;
const DIR_DATA_OFF: int = 16;
const DIR_ENT_OFF: int = 608;
const DIR_NAME_CAP: int = 1024;
const DIR_RECORD_SIZE: int = 608 + 21 + 1024;

pub fn opendir(path: ptr): ptr {
    let n = 0;
    while (bytes.read_byte(path, n) != 0) { n = n + 1; }
    let pat = bytes.alloc(n + 3);
    let i = 0;
    while (i < n) { bytes.write_byte(pat, i, bytes.read_byte(path, i)); i = i + 1; }
    let p = n;
    if (p > 0) {
        let last = bytes.read_byte(pat, p - 1);
        if (last != 47 && last != 92) { bytes.write_byte(pat, p, 92); p = p + 1; }
    }
    bytes.write_byte(pat, p, 42);
    bytes.write_byte(pat, p + 1, 0);

    let w = fs.widen(pat);
    bytes.free(pat);
    if (w == (0 as ptr)) { return 0 as ptr; }

    let d = bytes.alloc(DIR_RECORD_SIZE);
    let h = fs.FindFirstFileW(w, (d as long) + (DIR_DATA_OFF as long));
    bytes.free(w);
    if (h == fs.INVALID_HANDLE) { bytes.free(d); return 0 as ptr; }
    bytes.write_ptr(d, DIR_FIND_OFF, h);
    bytes.write_i32(d, DIR_PENDING_OFF, 1);
    return d;
}

pub fn readdir(dir: ptr): ptr {
    if (dir == (0 as ptr)) { return 0 as ptr; }
    let h = bytes.read_ptr(dir, DIR_FIND_OFF);
    if (h == fs.INVALID_HANDLE) { return 0 as ptr; }

    if (bytes.read_i32(dir, DIR_PENDING_OFF) == 0) {
        if (fs.FindNextFileW(h, (dir as long) + (DIR_DATA_OFF as long)) == 0) { return 0 as ptr; }
    }
    bytes.write_i32(dir, DIR_PENDING_OFF, 0);

    let ent = (dir as long) + (DIR_ENT_OFF as long);
    let name = (ent + (DIRENT_NAME_OFF() as long)) as ptr;
    let src = ((dir as long) + (DIR_DATA_OFF as long) + (fs.FIND_DATA_NAME_OFF as long)) as ptr;
    if (fs.narrowInto(src, name, DIR_NAME_CAP) == 0) { bytes.write_byte(name, 0, 0); }
    return ent as ptr;
}

pub fn closedir(dir: ptr): int {
    if (dir == (0 as ptr)) { return -1; }
    let h = bytes.read_ptr(dir, DIR_FIND_OFF);
    if (h != fs.INVALID_HANDLE) { fs.FindClose(h); }
    bytes.free(dir);
    return 0;
}

pub fn setenv(name: ptr, value: ptr, overwrite: int): int {
    if (overwrite == 0) {
        let cur = getenv(name);
        if (cur != (0 as ptr)) { return 0; }
    }
    return if (fs._putenv_s(name, value) == 0) 0 else -1;
}

pub fn socketpair(domain: int, type_: int, protocol: int, sv: ptr): int {
    winsock.startup();
    let listener = socket(AF_INET, type_, 0);
    if (listener < 0) { return -1; }
    let sa = makeSockaddrIn(0, INADDR_LOOPBACK_BE);
    let len = bytes.alloc(4);
    bytes.write_i32(len, 0, 16);
    let bound = bind(listener, sa, 16) == 0
             && getsockname(listener, sa, len) == 0
             && listen(listener, 1) == 0;
    bytes.free(len);
    if (!bound) { bytes.free(sa); close_socket(listener); return -1; }

    let client = socket(AF_INET, type_, 0);
    if (client < 0) { bytes.free(sa); close_socket(listener); return -1; }
    let connected = connect(client, sa, 16) == 0;
    bytes.free(sa);
    if (!connected) { close_socket(listener); close_socket(client); return -1; }

    let server = accept(listener, 0 as ptr, 0 as ptr);
    close_socket(listener);
    if (server < 0) { close_socket(client); return -1; }
    bytes.write_i32(sv, 0, client as long);
    bytes.write_i32(sv, 4, server as long);
    return 0;
}

fn close_socket(fd: int): int { return winsock.closesocket(fd as long); }

pub fn fcntl(fd: int, cmd: int, arg: int): int { return -1; }

pub fn pathExists(path: string): bool {
    let cp = cstr(path);
    let r = access(cp, F_OK);
    bytes.free(cp);
    return r == 0;
}

pub fn pathStatMode(path: string): int {
    let cp = cstr(path);
    let buf = bytes.alloc(160);
    let r = stat(cp, buf);
    let m = if (r == 0) (bytes.read_u16(buf, STAT_MODE_OFF()) as int) else -1;
    bytes.free(cp);
    bytes.free(buf);
    return m;
}

pub fn pathIsDir(path: string): bool {
    let m = pathStatMode(path);
    if (m < 0) { return false; }
    return (m & S_IFMT) == S_IFDIR;
}

pub fn errno(): int { return nova_ffi_errno(); }
pub fn clearErrno(): void { nova_ffi_set_errno(0); }

pub fn soError(fd: int): int {
    let val = bytes.alloc(4);
    let len = bytes.alloc(4);
    bytes.write_i32(val, 0, 0);
    bytes.write_i32(len, 0, 4);
    let r = getsockopt(fd, SOL_SOCKET(), SO_ERROR(), val, len);
    let e = if (r == 0) (bytes.read_i32(val, 0) as int) else -1;
    bytes.free(val);
    bytes.free(len);
    return e;
}

pub fn newSocket(domain: int, type_: int): int {
    winsock.startup();
    return socket(domain, type_, 0);
}

pub fn newSocketPair(domain: int, type_: int): (int, int) {
    let sv = bytes.alloc(8);
    let r = socketpair(domain, type_, 0, sv);
    if (r != 0) {
        bytes.free(sv);
        return (-1, -1);
    }
    let a = bytes.read_i32(sv, 0) as int;
    let b = bytes.read_i32(sv, 4) as int;
    bytes.free(sv);
    return (a, b);
}

pub fn setNonBlocking(fd: int): int { return nova_set_nonblock(fd); }

pub fn setReusePort(fd: int): int {
    let one = bytes.alloc(4);
    bytes.write_i32(one, 0, 1);
    let r = setsockopt(fd, SOL_SOCKET(), SO_REUSEPORT(), one, 4);
    bytes.free(one);
    return r;
}

pub fn mmap(addr: ptr, length: long, prot: int, flags: int, fd: int, offset: long): ptr {
    if (length <= (0 as long)) { return -1 as ptr; }
    let p = fs.VirtualAlloc(0 as ptr, length, fs.MEM_COMMIT | fs.MEM_RESERVE, fs.PAGE_READWRITE);
    return if (p == (0 as ptr)) (-1 as ptr) else p;
}

pub fn munmap(addr: ptr, length: long): int {
    return if (fs.VirtualFree(addr, 0 as long, fs.MEM_RELEASE) != 0) 0 else -1;
}

pub fn mapAnon(length: long): ptr {
    let p = mmap(0 as ptr, length, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON(), -1, 0);
    let pl = p as long;
    if (pl == -1 || pl == 0) { return 0 as ptr; }
    return p;
}

pub fn unmap(addr: ptr, length: long): int { return munmap(addr, length); }

pub fn makeSockaddrIn(port: int, addrBE: long): ptr {
    let sa = bytes.alloc(16);
    let i = 0;
    while (i < 16) { bytes.write_byte(sa, i, 0); i = i + 1; }
    bytes.write_u16(sa, 0, AF_INET as long);
    bytes.write_u16(sa, 2, htons(port) as long);
    bytes.write_i32(sa, 4, addrBE);
    return sa;
}

pub fn boundPort(fd: int): int {
    let sa = bytes.alloc(16);
    let len = bytes.alloc(4);
    bytes.write_i32(len, 0, 16);
    let r = getsockname(fd, sa, len);
    let p = if (r == 0) (htons(bytes.read_u16(sa, 2) as int)) else -1;
    bytes.free(sa);
    bytes.free(len);
    return p;
}

pub fn htons(x: int): int {
    let lo = x & 255;
    let hi = (x >> 8) & 255;
    return (lo << 8) | hi;
}
