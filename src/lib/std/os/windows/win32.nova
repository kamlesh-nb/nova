//! Raw Win32 FFI bindings for the I/O Completion Port (IOCP) reactor backend.
//!
//! This module is the Windows analogue of `os/windows/winsock` and the kqueue/epoll
//! bindings used on macOS and Linux: it declares the `extern("c")` entry points and raw
//! struct layouts (`OVERLAPPED`, `OVERLAPPED_ENTRY`) that Nova's async reactor drives
//! directly, with no C++ shim in between. The target-conditional file rule swaps this
//! module in only when compiling for `windows`, so callers in the shared reactor code
//! stay unchanged across backends.
//!
//! IOCP is a completion (proactor) model rather than a readiness model: callers hand it
//! an operation and are told when it finishes, rather than being told when an fd is
//! ready. The helper functions below read fields out of the raw `OVERLAPPED_ENTRY` and
//! `OVERLAPPED` byte layouts returned by `GetQueuedCompletionStatusEx`, since Nova has no
//! native binding for those Win32 structs.

import bytes;

/// Sentinel returned by Win32 APIs (e.g. `CreateFile`) in place of a valid handle.
pub const INVALID_HANDLE: long = -1;
/// Pass to a timeout parameter to block with no timeout.
pub const INFINITE: int = -1;

/// Returns the calling thread's last-error code, as set by the most recent failed Win32 call.
pub extern("c") fn GetLastError(): int;
/// Closes an open handle (file, socket, or IOCP handle).
pub extern("c") fn CloseHandle(h: long): int;

/// Creates a new I/O completion port, or associates a file/socket handle with an existing one.
/// Pass `INVALID_HANDLE` for `fileHandle` and `0` for `existingPort` to create a fresh port.
pub extern("c") fn CreateIoCompletionPort(fileHandle: long, existingPort: long, completionKey: long, concurrentThreads: int): long;
/// Blocks for a single completion event on `port`, or returns failure after `timeoutMs`.
pub extern("c") fn GetQueuedCompletionStatus(port: long, lpBytes: ptr, lpKey: ptr, lpOverlapped: ptr, timeoutMs: int): int;
/// Blocks for up to `count` completion events at once, writing them into `entries` (an array
/// of `OVERLAPPED_ENTRY` records) and the actual count into `removed`. This is the batched
/// drain path the reactor uses instead of repeated single-event calls.
pub extern("c") fn GetQueuedCompletionStatusEx(port: long, entries: ptr, count: int, removed: ptr, timeoutMs: int, alertable: int): int;
/// Manually queues a synthetic completion event onto `port`, used to wake a reactor thread
/// that is blocked in `GetQueuedCompletionStatus(Ex)` with no real I/O pending.
pub extern("c") fn PostQueuedCompletionStatus(port: long, nBytes: int, completionKey: long, lpOverlapped: ptr): int;
/// Cancels a pending overlapped operation on `fileHandle`. The kernel still owns the
/// `OVERLAPPED` record until the cancellation completion is delivered; it must not be freed
/// before then (see the reactor's abandonOp contract).
pub extern("c") fn CancelIoEx(fileHandle: long, lpOverlapped: ptr): int;

/// Size in bytes of a Win32 `OVERLAPPED_ENTRY` struct, used to index into a raw entries buffer.
pub const OVERLAPPED_ENTRY_SIZE: int = 32;
/// Reads the completion key (the value passed as `completionKey` at association time) of entry `i`.
pub fn entryKey(buf: ptr, i: int): long { return bytes.read_ptr(buf, (i * OVERLAPPED_ENTRY_SIZE) as long); }
/// Reads the `OVERLAPPED` pointer of entry `i`, identifying which pending operation completed.
pub fn entryOverlapped(buf: ptr, i: int): long { return bytes.read_ptr(buf, (i * OVERLAPPED_ENTRY_SIZE + 8) as long); }
/// Reads the number of bytes transferred for entry `i`'s completed operation.
pub fn entryBytes(buf: ptr, i: int): int { return bytes.read_i32(buf, (i * OVERLAPPED_ENTRY_SIZE + 24) as long) as int; }

/// Size in bytes of a Win32 `OVERLAPPED` struct, the per-operation record IOCP requires for
/// every asynchronous call.
pub const OVERLAPPED_SIZE: int = 32;
