
extern("webview") fn webview_create(debug: int, window: ptr): ptr;
extern("webview") fn webview_destroy(w: ptr): void;
extern("webview") fn webview_run(w: ptr): void;
extern("webview") fn webview_terminate(w: ptr): void;
extern("webview") fn webview_set_title(w: ptr, title: string): void;
extern("webview") fn webview_set_size(w: ptr, width: int, height: int, hints: int): void;
extern("webview") fn webview_navigate(w: ptr, url: string): void;
extern("webview") fn webview_set_html(w: ptr, html: string): void;
extern("webview") fn webview_init(w: ptr, js: string): void;
extern("webview") fn webview_eval(w: ptr, js: string): void;
extern("webview") fn webview_unbind(w: ptr, name: string): void;

extern("webview") fn nova_webview_bind(w: ptr, name: string, handler: (string) -> string): void;
extern("webview") fn nova_webview_dispatch(w: ptr, task: () -> void): void;

pub const HINT_NONE: int = 0;
pub const HINT_MIN: int = 1;
pub const HINT_MAX: int = 2;
pub const HINT_FIXED: int = 3;

pub struct Webview {
    pub handle: ptr,

    init(debug: bool) {
        let dbg = 0;
        if (debug) { dbg = 1; }
        self.handle = webview_create(dbg, 0);
    }

    pub fn setTitle(self: Webview, title: string): void {
        webview_set_title(self.handle, title);
    }

    pub fn setSize(self: Webview, width: int, height: int, hints: int): void {
        webview_set_size(self.handle, width, height, hints);
    }

    pub fn navigate(self: Webview, url: string): void {
        webview_navigate(self.handle, url);
    }

    pub fn setHtml(self: Webview, html: string): void {
        webview_set_html(self.handle, html);
    }

    pub fn initScript(self: Webview, js: string): void {
        webview_init(self.handle, js);
    }

    pub fn eval(self: Webview, js: string): void {
        webview_eval(self.handle, js);
    }

    pub fn bind(self: Webview, name: string, handler: (string) -> string): void {
        nova_webview_bind(self.handle, name, handler);
    }

    pub fn unbind(self: Webview, name: string): void {
        webview_unbind(self.handle, name);
    }

    pub fn dispatch(self: Webview, task: () -> void): void {
        nova_webview_dispatch(self.handle, task);
    }

    pub fn run(self: Webview): void {
        webview_run(self.handle);
    }

    pub fn terminate(self: Webview): void {
        webview_terminate(self.handle);
    }

    pub fn delete(self: Webview): void {
        if (self.handle != 0) {
            webview_destroy(self.handle);
            self.handle = 0;
        }
    }
}
