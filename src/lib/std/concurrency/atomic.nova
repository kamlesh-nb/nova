
import bytes;

import assert;

pub struct Atomic<T> {
    pub ptr: ptr,

    init(initial: T) {

    }

    pub fn load(self: Atomic<T>): T {
        return undefined;
    }

    pub fn store(self: Atomic<T>, val: T): void {
    }

    pub fn compareAndSwap(self: Atomic<T>, expected: T, desired: T): bool {
        return false;
    }

    pub fn add(self: Atomic<T>, delta: T): T {
        return undefined;
    }

    pub fn sub(self: Atomic<T>, delta: T): T {
        return undefined;
    }

    pub fn delete(self: Atomic<T>): void {
        if (self.ptr != 0) {
            bytes.free(self.ptr);
            self.ptr = 0;
        }
    }
}

@test
fn test_atomic_i32(): void {
    let counter = Atomic<int>(10);

    assert.equalInt(counter.load(), 10);

    counter.store(20);
    assert.equalInt(counter.load(), 20);

    let old = counter.add(5);
    assert.equalInt(old, 20);
    assert.equalInt(counter.load(), 25);

    let old2 = counter.sub(3);
    assert.equalInt(old2, 25);
    assert.equalInt(counter.load(), 22);

    let cas_success = counter.compareAndSwap(22, 30);
    assert.isTrue(cas_success);
    assert.equalInt(counter.load(), 30);

    let cas_fail = counter.compareAndSwap(22, 40);
    assert.isFalse(cas_fail);
    assert.equalInt(counter.load(), 30);
}

@test
fn test_atomic_i64(): void {
    let counter = Atomic<long>(100);

    if (counter.load() != 100) {
        assert.fail("load fail for long");
    }

    counter.store(200);
    if (counter.load() != 200) {
        assert.fail("store/load fail for long");
    }

    let old = counter.add(50);
    if (old != 200) {
        assert.fail("add fail for long");
    }
    if (counter.load() != 250) {
        assert.fail("load post-add fail for long");
    }

    let cas_success = counter.compareAndSwap(250, 300);
    assert.isTrue(cas_success);
    if (counter.load() != 300) {
        assert.fail("cas fail for long");
    }
}

@test
fn test_atomic_bool(): void {
    let flag = Atomic<bool>(false);

    assert.isFalse(flag.load());

    flag.store(true);
    assert.isTrue(flag.load());

    let cas_success = flag.compareAndSwap(true, false);
    assert.isTrue(cas_success);
    assert.isFalse(flag.load());
}
