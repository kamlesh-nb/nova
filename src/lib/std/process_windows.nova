
import list;
import bytes;
import assert;
import os.sys;
import os.windows.fs;
import os.windows.proc;

const CTX_SIZE: int = 40;
const CTX_PROC_OFF: int = 0;
const CTX_STDIN_OFF: int = 8;
const CTX_STDOUT_OFF: int = 16;
const CTX_PID_OFF: int = 24;
const CTX_EXIT_OFF: int = 28;
const CTX_EXITED_OFF: int = 32;

fn quoteArg(a: string): string {
    let needs = a.length == 0;
    let quotes = 0;
    let i = 0;
    while (i < a.length) {
        let c = a[i];
        if (c == 32 || c == 9 || c == 34) { needs = true; }
        if (c == 34) { quotes = quotes + 1; }
        i = i + 1;
    }
    if (!needs) { return a; }

    let buf = bytes.alloc(a.length + quotes + 2);
    let j = 0;
    bytes.write_byte(buf, j, 34); j = j + 1;
    i = 0;
    while (i < a.length) {
        let c = a[i];
        if (c == 34) { bytes.write_byte(buf, j, 92); j = j + 1; }
        bytes.write_byte(buf, j, c); j = j + 1;
        i = i + 1;
    }
    bytes.write_byte(buf, j, 34);
    return buf as string;
}

fn buildCommandLine(cmd: string, args: list.List<string>): string {
    let line = quoteArg(cmd);
    let i = 0;
    while (i < args.size()) {
        line = line + " " + quoteArg(args.get(i));
        i = i + 1;
    }
    return line;
}

fn inheritableSa(): ptr {
    let sa = bytes.alloc(proc.SECURITY_ATTRIBUTES_SIZE);
    let i = 0;
    while (i < proc.SECURITY_ATTRIBUTES_SIZE) { bytes.write_byte(sa, i, 0); i = i + 1; }
    bytes.write_i32(sa, proc.SA_LENGTH_OFF, proc.SECURITY_ATTRIBUTES_SIZE as long);
    bytes.write_i32(sa, proc.SA_INHERIT_OFF, 1);
    return sa;
}

pub struct Process {
    pub ctx: ptr,

    pub fn spawn(cmd: string, args: list.List<string>): Process {
        let sa = inheritableSa();

        let outRead = bytes.alloc(8);
        let outWrite = bytes.alloc(8);
        let inRead = bytes.alloc(8);
        let inWrite = bytes.alloc(8);
        let madeOut = proc.CreatePipe(outRead, outWrite, sa, 0);
        let madeIn = proc.CreatePipe(inRead, inWrite, sa, 0);
        bytes.free(sa);
        if (madeOut == 0 || madeIn == 0) {
            bytes.free(outRead); bytes.free(outWrite); bytes.free(inRead); bytes.free(inWrite);
            return Process{ ctx: 0 as ptr };
        }

        let hOutRead = bytes.read_ptr(outRead, 0);
        let hOutWrite = bytes.read_ptr(outWrite, 0);
        let hInRead = bytes.read_ptr(inRead, 0);
        let hInWrite = bytes.read_ptr(inWrite, 0);
        bytes.free(outRead); bytes.free(outWrite); bytes.free(inRead); bytes.free(inWrite);

        proc.SetHandleInformation(hOutRead, proc.HANDLE_FLAG_INHERIT, 0);
        proc.SetHandleInformation(hInWrite, proc.HANDLE_FLAG_INHERIT, 0);

        let si = bytes.alloc(proc.STARTUPINFO_SIZE);
        let i = 0;
        while (i < proc.STARTUPINFO_SIZE) { bytes.write_byte(si, i, 0); i = i + 1; }
        bytes.write_i32(si, proc.SI_CB_OFF, proc.STARTUPINFO_SIZE as long);
        bytes.write_i32(si, proc.SI_FLAGS_OFF, proc.STARTF_USESTDHANDLES as long);
        bytes.write_ptr(si, proc.SI_STDIN_OFF, hInRead);
        bytes.write_ptr(si, proc.SI_STDOUT_OFF, hOutWrite);
        bytes.write_ptr(si, proc.SI_STDERR_OFF, hOutWrite);

        let pi = bytes.alloc(proc.PROCESS_INFORMATION_SIZE);
        i = 0;
        while (i < proc.PROCESS_INFORMATION_SIZE) { bytes.write_byte(pi, i, 0); i = i + 1; }

        let cline = sys.cstr(buildCommandLine(cmd, args));
        let wline = fs.widen(cline);
        bytes.free(cline);
        if (wline == (0 as ptr)) {
            bytes.free(si); bytes.free(pi);
            fs.CloseHandle(hOutRead); fs.CloseHandle(hOutWrite);
            fs.CloseHandle(hInRead); fs.CloseHandle(hInWrite);
            return Process{ ctx: 0 as ptr };
        }

        let ok = proc.CreateProcessW(0 as ptr, wline, 0 as ptr, 0 as ptr, 1,
                                        proc.CREATE_NO_WINDOW, 0 as ptr, 0 as ptr, si, pi);
        bytes.free(wline);
        bytes.free(si);

        fs.CloseHandle(hInRead);
        fs.CloseHandle(hOutWrite);

        if (ok == 0) {
            bytes.free(pi);
            fs.CloseHandle(hOutRead);
            fs.CloseHandle(hInWrite);
            return Process{ ctx: 0 as ptr };
        }

        let hProc = bytes.read_ptr(pi, proc.PI_PROCESS_OFF);
        let hThread = bytes.read_ptr(pi, proc.PI_THREAD_OFF);
        let pid = bytes.read_i32(pi, proc.PI_PID_OFF) as int;
        bytes.free(pi);
        fs.CloseHandle(hThread);

        let ctx = bytes.alloc(CTX_SIZE);
        bytes.write_ptr(ctx, CTX_PROC_OFF, hProc);
        bytes.write_ptr(ctx, CTX_STDIN_OFF, hInWrite);
        bytes.write_ptr(ctx, CTX_STDOUT_OFF, hOutRead);
        bytes.write_i32(ctx, CTX_PID_OFF, pid as long);
        bytes.write_i32(ctx, CTX_EXIT_OFF, 0);
        bytes.write_i32(ctx, CTX_EXITED_OFF, 0);
        return Process{ ctx: ctx };
    }

    pub fn spawnIsolated(cmd: string, args: list.List<string>, nsFlags: int, rootfs: string,
                         hostname: string, dropCaps: int, noNewPrivs: int, seccomp: int): Process {
        return Process{ ctx: 0 as ptr };
    }

    pub fn write(self: Process, data: string): int {
        if (self.ctx == 0) { return -1; }
        let h = bytes.read_ptr(self.ctx, CTX_STDIN_OFF);
        let wrote = bytes.alloc(4);
        bytes.write_i32(wrote, 0, 0);
        let ok = fs.WriteFile(h, data as ptr, data.length, wrote, 0 as ptr);
        let n = bytes.read_i32(wrote, 0) as int;
        bytes.free(wrote);
        return if (ok != 0) n else -1;
    }

    pub fn read(self: Process, max_len: int): string {
        if (self.ctx == 0) { return ""; }
        let h = bytes.read_ptr(self.ctx, CTX_STDOUT_OFF);
        let buf = bytes.alloc(max_len);
        let got = bytes.alloc(4);
        bytes.write_i32(got, 0, 0);
        let ok = fs.ReadFile(h, buf, max_len, got, 0 as ptr);
        let n = bytes.read_i32(got, 0) as int;
        bytes.free(got);
        if (ok == 0 || n <= 0) {
            bytes.free(buf);
            return "";
        }

        let str_ptr = bytes.alloc(n);
        let i = 0;
        while (i < n) {
            bytes.write_byte(str_ptr, i, bytes.read_byte(buf, i));
            i = i + 1;
        }
        bytes.free(buf);
        return str_ptr as string;
    }

    pub fn wait(self: Process): int {
        if (self.ctx == 0) { return -1; }
        if (bytes.read_i32(self.ctx, CTX_EXITED_OFF) != 0) {
            return bytes.read_i32(self.ctx, CTX_EXIT_OFF) as int;
        }
        let h = bytes.read_ptr(self.ctx, CTX_PROC_OFF);
        self.closeStdin();
        proc.WaitForSingleObject(h, proc.INFINITE);
        return self.reap();
    }

    pub fn tryWait(self: Process): int {
        if (self.ctx == 0) { return -1; }
        if (bytes.read_i32(self.ctx, CTX_EXITED_OFF) != 0) {
            return bytes.read_i32(self.ctx, CTX_EXIT_OFF) as int;
        }
        let h = bytes.read_ptr(self.ctx, CTX_PROC_OFF);
        if (proc.WaitForSingleObject(h, 0) == proc.WAIT_TIMEOUT) { return -2; }
        return self.reap();
    }

    fn reap(self: Process): int {
        let h = bytes.read_ptr(self.ctx, CTX_PROC_OFF);
        let code = bytes.alloc(4);
        bytes.write_i32(code, 0, 0);
        let ok = proc.GetExitCodeProcess(h, code);
        let c = bytes.read_i32(code, 0) as int;
        bytes.free(code);
        if (ok == 0) { return -1; }
        bytes.write_i32(self.ctx, CTX_EXIT_OFF, c as long);
        bytes.write_i32(self.ctx, CTX_EXITED_OFF, 1);
        return c;
    }

    fn closeStdin(self: Process): void {
        let h = bytes.read_ptr(self.ctx, CTX_STDIN_OFF);
        if (h != (0 as long)) {
            fs.CloseHandle(h);
            bytes.write_ptr(self.ctx, CTX_STDIN_OFF, 0);
        }
    }

    pub fn isRunning(self: Process): bool {
        return self.tryWait() == -2;
    }

    pub fn pid(self: Process): long {
        if (self.ctx == 0) { return 0 as long; }
        return bytes.read_i32(self.ctx, CTX_PID_OFF) as long;
    }

    pub fn kill(self: Process, sig: int): int {
        if (self.ctx == 0) { return -1; }
        let h = bytes.read_ptr(self.ctx, CTX_PROC_OFF);
        return if (proc.TerminateProcess(h, 128 + sig) != 0) 0 else -1;
    }

    pub fn terminate(self: Process): int { return self.kill(15); }
    pub fn forceKill(self: Process): int { return self.kill(9); }

    pub fn close(self: Process): void {
        if (self.ctx != 0) {
            self.closeStdin();
            let out = bytes.read_ptr(self.ctx, CTX_STDOUT_OFF);
            if (out != (0 as long)) { fs.CloseHandle(out); }
            let h = bytes.read_ptr(self.ctx, CTX_PROC_OFF);
            if (h != (0 as long)) { fs.CloseHandle(h); }
            bytes.free(self.ctx);
            self.ctx = 0;
        }
    }

    pub fn delete(self: Process): void {
        self.close();
    }
}

@test
fn test_process_spawn(): void {
    let args = list.List<string>();
    args.push("/c");
    args.push("echo hello from child process");

    let p = Process.spawn("cmd.exe", args);
    let output = p.read(1024);

    let n = output.length;
    while (n > 0) {
        let c = output[n - 1];
        if (c != 10 && c != 13) { break; }
        n = n - 1;
    }
    let trimmed = bytes.alloc(n);
    let i = 0;
    while (i < n) { bytes.write_byte(trimmed, i, output[i]); i = i + 1; }

    assert.isTrue((trimmed as string) == "hello from child process");
    assert.equalInt(p.wait(), 0);
    p.close();
}
