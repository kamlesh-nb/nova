//! Random number generation: an OS-backed CSPRNG and a seedable PCG PRNG.
//!
//! This file draws a firm line between two very different jobs, because using
//! the wrong one is a security bug rather than a style choice.
//!
//!   1. Cryptographically secure randomness for anything that must be
//!      unguessable: session tokens, salts, nonces, key material. These come
//!      from the operating system's CSPRNG via [`osRandom`], which wraps the
//!      `kyte_getrandom` runtime intrinsic (getrandom(2) on Linux, arc4random on
//!      the BSDs and macOS, BCryptGenRandom on Windows). The public entry points
//!      are [`randomHex`], [`randomBytes`], and [`randomInt`].
//!
//!   2. Fast, seedable, REPRODUCIBLE pseudo-randomness for simulations, tests,
//!      shuffling, sampling, and anything that benefits from a deterministic
//!      stream you can replay from a seed. This is the [`Prng`] struct, a PCG
//!      generator (O'Neill's permuted congruential generator, the XSH-RR 32-bit
//!      output variant over a 64-bit LCG state). It is NOT secure: given a
//!      handful of outputs an attacker can recover the state, so it must never
//!      stand in for the CSPRNG above.
//!
//! Why keep both here. Most programs need both kinds at different points, and
//! putting them side by side makes the choice explicit at the call site. The
//! CSPRNG path allocates a scratch buffer, fills it from the OS, and frees it,
//! so it is correct but not free; the PCG path is a couple of integer multiplies
//! with no syscall, so it is the right tool for a tight loop that does not need
//! secrecy.
//!
//! Design notes and invariants. The PCG generator holds its state as a `ulong`
//! and advances with a fixed 64-bit LCG multiplier; every output is a permuted
//! 32-bit value, so [`Prng.next`] returns a `long` in the range 0 to 2^32 - 1.
//! The stream is fully determined by the (seed, sequence) pair passed to
//! [`newPrngSeq`], which is what makes replay possible and what the reference
//! test vectors pin down. All the modulo-into-a-bound helpers ([`randomInt`],
//! [`Prng.nextInt`]) use a plain remainder, so they carry a small modulo bias
//! when the bound does not divide the generator's range evenly; that is
//! acceptable for the non-cryptographic uses these serve and is called out here
//! so nobody reaches for [`randomInt`] expecting a uniform cryptographic draw.

import bytes;
import assert;

/// Lowercase hexadecimal digit table, indexed 0 to 15, used by [`randomHex`] to
/// map each nibble of a random byte to its ASCII hex character.
const HEXD: string = "0123456789abcdef";

/// Fills the first `n` bytes at `buf` with cryptographically secure random data
/// from the operating system.
///
/// This is the single seam onto the OS CSPRNG: it calls the `kyte_getrandom`
/// runtime intrinsic (getrandom / arc4random / BCryptGenRandom depending on the
/// platform), which blocks only until the system entropy pool is initialised and
/// then never fails for the small sizes used here. The caller owns `buf` and
/// must have allocated at least `n` bytes; `n` is widened to `long` for the
/// intrinsic. Returns `n` unchanged, purely as a convenience for callers that
/// want to chain the count.
fn osRandom(buf: ptr, n: int): int {
    kyte_getrandom(buf, n as long);
    return n;
}

/// Returns `nBytes` of secure random data encoded as a lowercase hex `string`,
/// so the result has `nBytes * 2` characters.
///
/// This is the convenient form for tokens and identifiers that need to be safe
/// to print, log, and pass through text protocols. It allocates a raw buffer,
/// fills it from [`osRandom`], expands each byte into two hex digits via
/// [`HEXD`] (high nibble first), frees the raw buffer, and hands back the hex
/// string. For raw bytes without the hex expansion use [`randomBytes`].
pub fn randomHex(nBytes: int): string {
    let raw = bytes.alloc(nBytes);
    osRandom(raw, nBytes);
    let out = bytes.alloc(nBytes * 2);
    let i = 0;
    while (i < nBytes) {
        let b = bytes.read_byte(raw, i);
        bytes.write_byte(out, i * 2, bytes.read_byte(HEXD, (b >> 4) & 15));
        bytes.write_byte(out, i * 2 + 1, bytes.read_byte(HEXD, b & 15));
        i = i + 1;
    }
    bytes.free(raw);
    return out as string;
}

/// Returns `nBytes` of secure random data as a raw `string` of exactly that
/// length.
///
/// The bytes are unencoded and may contain any value including NUL, so treat the
/// result as an opaque byte buffer rather than printable text: use [`randomHex`]
/// when the value has to survive a text channel. The buffer is allocated here,
/// filled from [`osRandom`], and returned directly (reinterpreted as `string`)
/// so ownership passes to the caller.
pub fn randomBytes(nBytes: int): string {
    let raw = bytes.alloc(nBytes);
    osRandom(raw, nBytes);
    return raw as string;
}

/// Returns a secure random integer in the half-open range `0` to `bound - 1`.
///
/// Returns `0` for any `bound <= 0`, so the result is always non-negative and
/// callers do not have to guard the empty-range case. Four random bytes are
/// drawn from [`osRandom`] and assembled big-endian into a 64-bit draw; the top
/// bit can make the assembled value negative, so it is folded to its absolute
/// value before the remainder is taken. Note the plain `draw % bound` carries a
/// small modulo bias unless `bound` divides 2^32 evenly, which is fine for the
/// sizing and selection uses this serves but is not a uniform cryptographic
/// draw. For the seedable, reproducible equivalent see [`Prng.nextInt`].
pub fn randomInt(bound: int): int {
    if (bound <= 0) { return 0; }
    let b = bytes.alloc(4);
    osRandom(b, 4);
    let draw: long = ((bytes.read_byte(b, 0) as long) << 24)
        | ((bytes.read_byte(b, 1) as long) << 16)
        | ((bytes.read_byte(b, 2) as long) << 8)
        | (bytes.read_byte(b, 3) as long);
    bytes.free(b);
    if (draw < 0) { draw = 0 - draw; }
    return (draw % (bound as long)) as int;
}

/// Rotates the low 32 bits of `v` right by `r` positions and returns the result
/// masked to 32 bits.
///
/// This is the output-permutation step of PCG's XSH-RR variant: a data-dependent
/// rotation whose amount comes from the high bits of the generator state, which
/// is what breaks up the linear structure of the underlying LCG. The rotate
/// count is reduced modulo 32 (`r & 31`); a count of zero would otherwise shift
/// by the full width, which is undefined, so that case returns `v` masked
/// directly. Used only by [`Prng.next`].
fn rotr32(v: ulong, r: ulong): ulong {
    let rr: ulong = r & 31;
    if (rr == 0) { return v & 4294967295; }
    return ((v >> rr) | (v << (32 - rr))) & 4294967295;
}

/// A seedable, reproducible pseudo-random generator (PCG, XSH-RR 32-bit output).
///
/// The generator is a 64-bit linear congruential state whose output is permuted
/// down to a well-distributed 32-bit value on each step. It is fast and its
/// stream is fully determined by the seed and sequence it was created with, so
/// the same inputs always replay the same sequence: ideal for tests, sampling,
/// and simulations. It is deliberately NOT cryptographically secure, since the
/// state can be recovered from a few outputs, so never use it where randomness
/// must be unguessable; reach for [`randomBytes`] / [`randomInt`] there instead.
/// Construct one with [`newPrng`] or [`newPrngSeq`] rather than building the
/// struct by hand, since the fields need a specific seeding ritual.
pub struct Prng {
    /// The 64-bit LCG state, advanced on every call to [`Prng.next`]. This is
    /// the value that must stay secret for the stream to be unpredictable, which
    /// is exactly why this generator is not suitable for security.
    pub state: ulong,
    /// The per-stream increment (odd by construction). Two generators with the
    /// same seed but different `inc` produce distinct, non-overlapping streams,
    /// which is how [`newPrngSeq`] separates sequences.
    pub inc: ulong,

    /// Advances the generator one step and returns the next output as a `long` in
    /// the range 0 to 2^32 - 1.
    ///
    /// The LCG state is stepped first (`state = state * mult + inc`), then the
    /// PREVIOUS state is permuted for output: an xorshift folds the high bits
    /// down, and [`rotr32`] applies a rotation whose amount is taken from the top
    /// bits of that previous state. Returning the permutation of the old state
    /// rather than the new one is standard PCG and is what the reference vectors
    /// expect. The result is always non-negative because it is a 32-bit value
    /// widened into a 64-bit `long`.
    pub fn next(self: Prng): long {
        let mult: ulong = 6364136223846793005;
        let old: ulong = self.state;
        self.state = old * mult + self.inc;
        let xorshifted: ulong = (((old >> 18) ^ old) >> 27) & 4294967295;
        let rot: ulong = old >> 59;
        return rotr32(xorshifted, rot) as long;
    }

    /// Returns the next reproducible integer in the half-open range `0` to
    /// `bound - 1`.
    ///
    /// Returns `0` when `bound <= 0`, mirroring [`randomInt`], so an empty range
    /// never needs a guard at the call site. Because [`Prng.next`] is
    /// non-negative the remainder is taken directly. As with [`randomInt`] this
    /// is a plain modulo, so it carries a small bias when `bound` does not divide
    /// the generator's range evenly; that is acceptable for the non-secure uses
    /// this generator is for.
    pub fn nextInt(self: Prng, bound: int): int {
        if (bound <= 0) { return 0; }
        return (self.next() % (bound as long)) as int;
    }

    /// Returns the next reproducible floating-point value in the half-open range
    /// `[0.0, 1.0)`.
    ///
    /// The 32-bit output of [`Prng.next`] is divided by 2^32 (4294967296.0), so
    /// the largest possible result is just under 1.0 and the value never reaches
    /// exactly 1.0. The resolution is therefore 32 bits, which is ample for the
    /// sampling and simulation work this generator serves.
    pub fn nextFloat(self: Prng): double {
        return (self.next() as double) / 4294967296.0;
    }
}

/// Creates a [`Prng`] seeded from `seed` on the independent stream selected by
/// `seq`.
///
/// The `seq` argument chooses one of 2^63 distinct, non-overlapping output
/// streams: it is shifted left by one and OR'd with 1 to form the odd increment
/// [`Prng.inc`], so two generators with the same `seed` but different `seq`
/// never produce correlated sequences. The state is then initialised with the
/// canonical PCG seeding ritual (step, add the seed, step again) so that even
/// closely related seeds diverge immediately. The exact (seed, seq) to output
/// mapping is fixed and is what `test_prng_reference_vectors` pins down. For a
/// single default stream use [`newPrng`].
pub fn newPrngSeq(seed: long, seq: long): Prng {
    let mult: ulong = 6364136223846793005;
    let p = Prng{ state: 0, inc: 0 };
    p.inc = (((seq as ulong)) << 1) | 1;

    p.state = p.state * mult + p.inc;
    p.state = p.state + (seed as ulong);
    p.state = p.state * mult + p.inc;
    return p;
}

/// Creates a [`Prng`] seeded from `seed` on the default stream (sequence 1).
///
/// This is the common case: one deterministic sequence per seed. It delegates to
/// [`newPrngSeq`] with a fixed sequence of 1; reach for [`newPrngSeq`] directly
/// only when you need several independent streams that share no correlation.
pub fn newPrng(seed: long): Prng {
    return newPrngSeq(seed, 1);
}

/// Verifies the PCG stream against known-good outputs so the generator stays
/// bit-for-bit stable.
///
/// Seeds `(42, 54)` and asserts the first five outputs match the published PCG
/// reference vectors. This is a change-detector: if a refactor of [`Prng.next`],
/// [`rotr32`], or [`newPrngSeq`] alters the stream, these fixed numbers catch it,
/// which matters because reproducibility is the whole point of a seedable PRNG.
@test
fn test_prng_reference_vectors(): void {

    let p = newPrngSeq(42, 54);
    assert.equalInt((p.next() == 2707161783) as int, 1);
    assert.equalInt((p.next() == 2068313097) as int, 1);
    assert.equalInt((p.next() == 3122475824) as int, 1);
    assert.equalInt((p.next() == 2211639955) as int, 1);
    assert.equalInt((p.next() == 3215226955) as int, 1);
}

/// Checks that equal seeds replay identical streams and different seeds diverge.
///
/// Two generators seeded with `12345` are stepped 20 times and must agree on
/// every draw, confirming determinism; a third seeded with `99999` must differ
/// from a fresh `12345` generator, confirming the seed actually selects the
/// stream. Together these guard the reproducibility contract of [`newPrng`].
@test
fn test_prng_is_deterministic(): void {

    let a = newPrng(12345);
    let b = newPrng(12345);
    let c = newPrng(99999);
    let same = true;
    let differ = false;
    let i = 0;
    while (i < 20) {
        if (a.next() != b.next()) { same = false; }
        i = i + 1;
    }
    let a2 = newPrng(12345);
    if (a2.next() != c.next()) { differ = true; }
    assert.equalInt(same as int, 1);
    assert.equalInt(differ as int, 1);
}

/// Confirms [`Prng.nextInt`] never escapes its half-open range.
///
/// Draws 1000 values with bound 10 and asserts every one lands in `0` to `9`,
/// guarding the boundedness invariant callers rely on for indexing and
/// selection.
@test
fn test_prng_bounds(): void {
    let p = newPrng(7);
    let i = 0;
    let ok = true;
    while (i < 1000) {
        let v = p.nextInt(10);
        if (v < 0 || v >= 10) { ok = false; }
        i = i + 1;
    }
    assert.equalInt(ok as int, 1);
}

/// Smoke-tests the OS-backed CSPRNG entry points for shape and liveness.
///
/// Checks that [`randomHex`] returns the expected length (twice the byte count)
/// and does not repeat across two calls, that [`randomBytes`] returns exactly
/// the requested length, and that [`randomInt`] stays within its bound. This is
/// a liveness and contract check, not a statistical test of randomness quality:
/// it confirms the OS seam is wired and returns well-formed output.
@test
fn test_csprng_liveness(): void {

    let a = randomHex(16);
    let b = randomHex(16);
    assert.equalInt(a.length, 32);
    assert.isTrue(a != b);

    let x = randomBytes(16);
    assert.equalInt(x.length, 16);

    let r = randomInt(100);
    assert.isTrue(r >= 0);
    assert.isTrue(r < 100);
}
