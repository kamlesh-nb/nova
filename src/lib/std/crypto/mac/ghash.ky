//! GHASH: the keyed universal hash at the heart of AES-GCM.
//!
//! GHASH is not a general-purpose hash. It is the authentication half of
//! Galois/Counter Mode (GCM): given a 128-bit hash subkey `H` (which GCM derives
//! by encrypting an all-zero block), it folds a message down to a single 128-bit
//! value by repeatedly doing `Y = (Y ^ block) * H` in the binary field
//! GF(2^128). The GCM tag is then this accumulator combined with an encrypted
//! counter block, done by the caller. Everything in this file is that inner
//! multiply-and-accumulate; it knows nothing about AES, nonces, or the AAD/
//! ciphertext framing, which the GCM layer above supplies.
//!
//! The field is GF(2^128) with the GCM reduction polynomial
//! `x^128 + x^7 + x^2 + x + 1`, and the bit ordering is the "reflected" one the
//! spec mandates: bit 0 of the field element is the most significant bit of
//! byte 0. That reflection is why `[`mulX`]` shifts the 16 bytes to the RIGHT to
//! multiply by `x`, and why the reduction constant appears as `0xe1` (the top
//! byte of the reversed polynomial) folded into byte 0.
//!
//! Design decision: correctness by a small bitwise core, speed by a 4-bit
//! table. A naive GHASH multiplies bit by bit (128 shift-and-add steps per
//! block), which `[`gmult`]` does and which is used only ONCE, at construction,
//! to precompute tables. The hot path `[`Ghash.gmultY`]` instead uses Shoup's
//! method: a 16-entry table of `H` multiplied by each 4-bit nibble value
//! (shifted into the high nibble), plus a 16-entry reduction table `rem`, so a
//! full 128-bit multiply becomes 32 nibble steps of table lookup, XOR, and a
//! 4-bit shift. This is the classic time/space trade that GCM implementations
//! make. It is NOT constant-time and makes no side-channel claims: the table
//! index depends on the accumulator bytes, so this is unsafe against a
//! cache-timing adversary and is intended for the software fallback path only.
//!
//! Memory model: every 128-bit value is a 16-byte heap buffer addressed by a raw
//! `ptr`, read and written through `bytes.read_byte` / `bytes.write_byte` so the
//! byte offsets are computed at 64-bit width (a bare `ptr + off` in Kyte would
//! truncate to 32 bits). The four buffers a `[`Ghash`]` owns (`h`, `y`, `table`,
//! `rem`) are allocated in `[`Ghash.create`]` and must be released with
//! `[`Ghash.delete`]`, since these are not ARC-managed strings.

import bytes;
import mem.allocator;

/// Size in bytes of a GHASH block and of the field element it operates on.
///
/// GHASH is defined only over 128-bit (16-byte) blocks. `[`Ghash.update`]`
/// zero-pads any trailing partial block up to this length before folding it in,
/// matching the GCM spec's treatment of the final AAD or ciphertext fragment.
pub const GHASH_BLOCK_LEN: int = 16;

/// Multiplies the 16-byte field element `v` by `x` in GF(2^128), in place.
///
/// In the reflected GCM bit order, multiplying by `x` is a one-bit shift of the
/// whole 128-bit value towards the more-significant end, which in this byte
/// layout is a shift to the RIGHT. The loop walks bytes 0..15, shifting each
/// right by one and carrying the displaced low bit into the top of the next
/// byte. When the bit shifted OUT of the far end (the least significant bit of
/// byte 15) was set, the result overflowed the field and must be reduced: the
/// mask `(0 - lsb) & 0xe1` is `0xe1` when that bit was 1 and `0x00` otherwise,
/// and it is XORed into byte 0 to fold in the reduction polynomial. `0xe1` is
/// the top byte of the GCM polynomial written in reflected form.
///
/// This is the primitive building block: `[`gmult`]` calls it 128 times per
/// multiply, and `[`Ghash.create`]` calls it four times to build a nibble worth
/// of shift when precomputing the `rem` table.
fn mulX(v: ptr): void {
    let lsb = bytes.read_byte(v, 15) & 1;
    let carryIn = 0;
    let k = 0;
    while (k < 16) {
        let cur = bytes.read_byte(v, k);
        let carryOut = (cur & 1) << 7;
        bytes.write_byte(v, k, (cur >> 1) | carryIn);
        carryIn = carryOut;
        k = k + 1;
    }
    let borrow = (0 - lsb) & 0xe1;
    bytes.write_byte(v, 0, bytes.read_byte(v, 0) ^ borrow);
}

/// Bitwise GF(2^128) multiply: sets `x = x * h` in place, using no tables.
///
/// This is the reference multiply, correct but slow (128 iterations of
/// shift-and-conditionally-add). For each of the 128 bits of `h`, from the most
/// significant downwards, it conditionally adds the running value `v` into the
/// accumulator `z` when that bit is set, then multiplies `v` by `x` via
/// `[`mulX`]`. The addition is masked rather than branched: `mask` is `0xff`
/// when the current `h` bit is 1 and `0x00` otherwise, so `v & mask` is either
/// `v` or zero. `x` is copied into the scratch `v` at the start because it is
/// destroyed as it is repeatedly multiplied by `x`.
///
/// It exists ONLY to seed the precomputed tables in `[`Ghash.create`]`; the
/// steady-state hashing never calls it and instead uses the far faster
/// table-driven `[`Ghash.gmultY`]`. Both scratch buffers `z` and `v` are freed
/// before returning.
fn gmult(x: ptr, h: ptr): void {
    let z = bytes.alloc(16);
    let v = bytes.alloc(16);
    let i = 0;
    while (i < 16) {
        bytes.write_byte(z, i, 0);
        bytes.write_byte(v, i, bytes.read_byte(x, i));
        i = i + 1;
    }
    i = 0;
    while (i < 16) {
        let yb = bytes.read_byte(h, i);
        let j = 0;
        while (j < 8) {
            let mask = (0 - ((yb >> 7) & 1)) & 0xff;
            let k = 0;
            while (k < 16) {
                bytes.write_byte(z, k, bytes.read_byte(z, k) ^ (bytes.read_byte(v, k) & mask));
                k = k + 1;
            }
            mulX(v);
            yb = (yb << 1) & 0xff;
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    while (i < 16) { bytes.write_byte(x, i, bytes.read_byte(z, i)); i = i + 1; }
    bytes.free(z);
    bytes.free(v);
}

/// Shifts the 16-byte value `acc` right by 4 bits (one nibble), in place.
///
/// This is a plain big-integer nibble shift, NOT a field operation: no reduction
/// is applied, and any nibble shifted off the low end is simply lost. It is the
/// per-step shift of the 4-bit table method in `[`Ghash.gmultY`]`, which reads
/// off the low nibble (and separately handles the reduction via the `rem` table)
/// BEFORE calling this. The loop moves from byte 15 down to byte 1, pulling the
/// low nibble of the preceding byte into the high nibble of the current one;
/// byte 0 then just shifts right with zero fill.
fn rawShr4(acc: ptr): void {
    let k = 15;
    while (k >= 1) {
        let hi = bytes.read_byte(acc, k - 1);
        bytes.write_byte(acc, k, ((bytes.read_byte(acc, k) >> 4) | ((hi << 4) & 0xf0)) & 0xff);
        k = k - 1;
    }
    bytes.write_byte(acc, 0, bytes.read_byte(acc, 0) >> 4);
}

/// XORs a 16-byte block from `src` at offset `soff` into `dst` at offset `doff`.
///
/// Addition in GF(2^128) is bitwise XOR, so this is how a table entry (`table`
/// or `rem`, both laid out as 16 consecutive bytes per index) is added into the
/// accumulator in `[`Ghash.gmultY`]`. The offsets let a single flat buffer hold
/// many 16-byte entries: passing `index * 16` selects entry `index`. No bounds
/// checking is done; the caller must keep both `[doff, doff+16)` and
/// `[soff, soff+16)` inside their buffers.
fn xorBlockAt(dst: ptr, doff: int, src: ptr, soff: int): void {
    let k = 0;
    while (k < 16) {
        bytes.write_byte(dst, doff + k, bytes.read_byte(dst, doff + k) ^ bytes.read_byte(src, soff + k));
        k = k + 1;
    }
}

/// A GHASH accumulator bound to one hash subkey `H`, with precomputed tables.
///
/// Create one with `[`Ghash.create`]` from the 16-byte subkey, feed message
/// bytes with `[`Ghash.update`]` (or whole blocks with `[`Ghash.block`]`), read
/// the 128-bit result out with `[`Ghash.final`]`, and free it with
/// `[`Ghash.delete`]`. Call `[`Ghash.reset`]` to hash a fresh message under the
/// same subkey without rebuilding the tables. All four fields are raw heap
/// buffers, so a `Ghash` is NOT ARC-managed and leaks unless `delete` is called.
///
/// The subkey never changes after construction, so `table` and `rem` are built
/// once and reused for every block; only `y` mutates as data is folded in.
pub struct Ghash {
    /// The 16-byte hash subkey `H` (GCM's `E(K, 0^128)`), kept so the tables can
    /// be described by it. Not consulted on the hot path once the tables exist.
    pub h: ptr,
    /// The 16-byte running accumulator `Y`. Starts at zero, becomes
    /// `(Y ^ block) * H` per block, and holds the finished GHASH value that
    /// `[`Ghash.final`]` copies out.
    pub y: ptr,
    /// Shoup's 4-bit product table: 16 entries of 16 bytes each (256 bytes),
    /// where entry `i` is `H` multiplied by the field element whose high nibble
    /// is `i`. Indexed by nibble in `[`Ghash.gmultY`]` to add a partial product
    /// without a bitwise multiply.
    pub table: ptr,
    /// The 4-bit reduction table: 16 entries of 16 bytes each, where entry `i`
    /// carries the polynomial correction for the nibble `i` that the preceding
    /// `[`rawShr4`]` shifted off the low end. Added back in during
    /// `[`Ghash.gmultY`]` to keep the running value inside the field.
    pub rem: ptr,

    /// Builds a `Ghash` for the 16-byte hash subkey at `hkey`, precomputing both
    /// lookup tables.
    ///
    /// Allocates the four buffers, copies `hkey` into `h`, and zeroes the
    /// accumulator `y`. It then fills `table` so that entry `i` is
    /// `(i << 4) * H`, computed with the slow bitwise `[`gmult`]` (this is the
    /// only place that reference multiply is used). Finally it fills `rem` so
    /// that entry `i` is the reduction contribution of nibble `i`, obtained by
    /// placing `i` in the low byte and applying `[`mulX`]` four times, i.e. one
    /// nibble's worth of shift-with-reduction. The returned value owns heap
    /// memory and must be released with `[`Ghash.delete`]`.
    pub fn create(hkey: ptr): Ghash {
        let g = bytes.new_with_allocator<Ghash>(allocator.globalAllocator());
        g.h = bytes.alloc(16);
        g.y = bytes.alloc(16);
        g.table = bytes.alloc(16 * 16);
        g.rem = bytes.alloc(16 * 16);
        let i = 0;
        while (i < 16) {
            bytes.write_byte(g.h, i, bytes.read_byte(hkey, i));
            bytes.write_byte(g.y, i, 0);
            i = i + 1;
        }
        i = 0;
        while (i < 16) {
            let tmp = bytes.alloc(16);
            let k = 0;
            while (k < 16) { bytes.write_byte(tmp, k, 0); k = k + 1; }
            bytes.write_byte(tmp, 0, (i << 4) & 0xff);
            gmult(tmp, g.h);
            k = 0;
            while (k < 16) { bytes.write_byte(g.table, i * 16 + k, bytes.read_byte(tmp, k)); k = k + 1; }
            bytes.free(tmp);
            i = i + 1;
        }
        i = 0;
        while (i < 16) {
            let tmp = bytes.alloc(16);
            let k = 0;
            while (k < 16) { bytes.write_byte(tmp, k, 0); k = k + 1; }
            bytes.write_byte(tmp, 15, i);
            mulX(tmp); mulX(tmp); mulX(tmp); mulX(tmp);
            k = 0;
            while (k < 16) { bytes.write_byte(g.rem, i * 16 + k, bytes.read_byte(tmp, k)); k = k + 1; }
            bytes.free(tmp);
            i = i + 1;
        }
        return g;
    }

    /// Zeroes the accumulator so a new message can be hashed under the same
    /// subkey.
    ///
    /// Only `y` is touched; `h`, `table`, and `rem` are unchanged, so this avoids
    /// rebuilding the tables. Use it to reuse one `Ghash` across several GCM
    /// operations that share the same key.
    pub fn reset(self: Ghash): void {
        let i = 0;
        while (i < 16) { bytes.write_byte(self.y, i, 0); i = i + 1; }
    }

    /// The hot-path multiply: sets `y = y * H` using the precomputed tables.
    ///
    /// This is Shoup's 4-bit table method. It processes the 16 bytes of `y` from
    /// the last to the first, and each byte as two nibbles, so 32 nibble steps in
    /// all. Each step captures the low nibble of the accumulator `acc` (which
    /// will be shifted off), does a `[`rawShr4`]` nibble shift, then adds back
    /// two table contributions with `[`xorBlockAt`]`: the `rem` entry for the
    /// nibble that was shifted out (the reduction correction) and the `table`
    /// entry for the current message nibble (its partial product against `H`).
    /// Doing the high and low nibble of each byte in turn walks all 128 bits of
    /// `y` without a single per-bit multiply. The result is written back over
    /// `y`, and the scratch `acc` is freed.
    ///
    /// Because the table indices are derived from `y` and the accumulator bytes,
    /// this is data-dependent and therefore NOT constant-time.
    fn gmultY(self: Ghash): void {
        let acc = bytes.alloc(16);
        let k = 0;
        while (k < 16) { bytes.write_byte(acc, k, 0); k = k + 1; }
        let idx = 15;
        while (idx >= 0) {
            let b = bytes.read_byte(self.y, idx);
            let r1 = bytes.read_byte(acc, 15) & 0xf;
            rawShr4(acc);
            xorBlockAt(acc, 0, self.rem, r1 * 16);
            xorBlockAt(acc, 0, self.table, (b & 0xf) * 16);
            let r2 = bytes.read_byte(acc, 15) & 0xf;
            rawShr4(acc);
            xorBlockAt(acc, 0, self.rem, r2 * 16);
            xorBlockAt(acc, 0, self.table, (b >> 4) * 16);
            idx = idx - 1;
        }
        k = 0;
        while (k < 16) { bytes.write_byte(self.y, k, bytes.read_byte(acc, k)); k = k + 1; }
        bytes.free(acc);
    }

    /// Folds one 16-byte block, read from `b` at offset `off`, into the
    /// accumulator.
    ///
    /// This is the core GHASH recurrence `Y = (Y ^ block) * H`: XOR the block
    /// into `y` byte by byte, then multiply by `H` via `[`Ghash.gmultY`]`. The
    /// block must be a full 16 bytes; `[`Ghash.update`]` is the entry point that
    /// splits and zero-pads arbitrary-length input before calling this.
    pub fn block(self: Ghash, b: ptr, off: int): void {
        let i = 0;
        while (i < 16) {
            bytes.write_byte(self.y, i, bytes.read_byte(self.y, i) ^ bytes.read_byte(b, off + i));
            i = i + 1;
        }
        self.gmultY();
    }

    /// Folds `len` bytes at `data` into the accumulator, in 16-byte blocks.
    ///
    /// Full blocks are handed straight to `[`Ghash.block`]`. A trailing partial
    /// block (when `len` is not a multiple of 16) is copied into a zeroed 16-byte
    /// scratch buffer and folded in, which is exactly the zero-padding GCM
    /// prescribes for the final AAD or ciphertext fragment. Note this pads each
    /// `update` call's tail independently: it is meant to be called once per
    /// logically distinct region, not as a byte stream you can resume mid-block.
    pub fn update(self: Ghash, data: ptr, len: int): void {
        let i = 0;
        while (len - i >= 16) {
            self.block(data, i);
            i = i + 16;
        }
        let rem = len - i;
        if (rem > 0) {
            let tmp = bytes.alloc(16);
            let k = 0;
            while (k < 16) {
                bytes.write_byte(tmp, k, if (k < rem) bytes.read_byte(data, i + k) else 0);
                k = k + 1;
            }
            self.block(tmp, 0);
            bytes.free(tmp);
        }
    }

    /// Copies the current 16-byte accumulator into `out`.
    ///
    /// This reads the GHASH result without modifying state, so it is a plain copy
    /// rather than the length-block finalisation some MAC APIs perform: the GCM
    /// layer above is responsible for appending the AAD/ciphertext length block
    /// (via `update`) and for combining this value with the encrypted counter
    /// block to form the tag. `out` must have room for 16 bytes.
    pub fn final(self: Ghash, out: ptr): void {
        let i = 0;
        while (i < 16) { bytes.write_byte(out, i, bytes.read_byte(self.y, i)); i = i + 1; }
    }

    /// Frees the four heap buffers and nulls their fields.
    ///
    /// A `Ghash` owns raw allocations that ARC does not track, so this must be
    /// called to avoid leaking. Each pointer is checked against 0 and set back to
    /// 0 after freeing, which makes the call idempotent and guards against a
    /// double free if `delete` is invoked twice.
    pub fn delete(self: Ghash): void {
        if (self.h != 0) { bytes.free(self.h); self.h = 0; }
        if (self.y != 0) { bytes.free(self.y); self.y = 0; }
        if (self.table != 0) { bytes.free(self.table); self.table = 0; }
        if (self.rem != 0) { bytes.free(self.rem); self.rem = 0; }
    }
}
