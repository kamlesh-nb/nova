//! Poly1305 one-time message authentication code (RFC 8439).
//!
//! Poly1305 takes a 32-byte one-time key and a message of any length, and
//! produces a 16-byte authentication tag. It is a polynomial evaluation MAC:
//! the message is split into 16-byte blocks, each block is read as a little
//! endian integer with a high bit appended, and the accumulator is updated as
//! `h = (h + block) * r mod (2^130 - 5)`. After the last block the low 128 bits
//! of `h` are added to a per-message pad `s` and the result is the tag. The key
//! is the pair `(r, s)`: the first 16 bytes are `r` (with a fixed clamp applied)
//! and the second 16 bytes are `s`.
//!
//! WHY it exists here: Poly1305 is the authenticator half of the
//! ChaCha20-Poly1305 AEAD used by Kyte's self-hosted TLS 1.3 stack, and it also
//! backs the standalone MAC surface in the crypto library. The runtime retired
//! wolfSSL, so all crypto is pure Kyte with an optional hand-written assembly
//! fast path, and this file is where the Poly1305 primitive lives.
//!
//! DESIGN: the accumulator `h` and the key `r` are held as five 26-bit limbs
//! packed into `ulong` fields (`h0..h4`, `r0..r4`). Five 26-bit limbs cover the
//! 130 bits of the field with room to spare, so the schoolbook multiply in
//! [`Poly1305.absorb`] can accumulate partial products in 64-bit words without
//! overflowing before the carry-propagation step folds them back down. The
//! `s1..s4` fields hold `r1..r4` pre-multiplied by 5, which is the standard
//! trick for reducing mod `2^130 - 5`: a limb that spills past bit 130 is worth
//! 5 units in the bottom limb, so multiplying the wrapped terms by 5 and adding
//! them back performs the reduction with plain multiplies.
//!
//! INVARIANTS the caller must uphold: the key buffer is exactly
//! [`POLY1305_KEY_LEN`] (32) bytes, the output buffer is exactly
//! [`POLY1305_TAG_LEN`] (16) bytes, and each [`Poly1305`] instance authenticates
//! ONE message only. Poly1305 is a one-time MAC: reusing the same `(r, s)` key
//! across two messages leaks `r` and breaks security, so the key must be fresh
//! per message (in the AEAD this is the ChaCha20 keystream block for counter 0).
//! Every [`Poly1305.create`] must be paired with a [`Poly1305.delete`] to free
//! the two heap buffers it allocates.
//!
//! FAST PATH: when [`kyte_has_asm_crypto`] reports a supported CPU, the state is
//! carried in a 26-bit-free 44-bit-limb layout inside the `hw` scratch buffer and
//! the block loop runs in assembly ([`kyte_poly1305_blocks`] /
//! [`kyte_poly1305_finish`]). The pure-Kyte limb path is the fallback and the
//! reference for correctness. The two paths are never mixed within one instance;
//! `useHw` records which one this instance chose at creation time.

import bytes;
import mem.allocator;

/// Runtime probe for a CPU with the hand-written assembly crypto kernels.
///
/// Returns 1 when the assembly Poly1305 block and finish routines are available
/// and safe to call on this machine, 0 otherwise. [`Poly1305.create`] calls this
/// once and latches the answer into `useHw`, so the choice of code path is fixed
/// for the lifetime of the instance.
extern("c") fn kyte_has_asm_crypto(): int;
/// Assembly fast path: absorb `nblocks` whole 16-byte blocks into the state.
///
/// Consumes `nblocks * 16` bytes starting at `data` and folds them into the
/// 44-bit-limb accumulator held in the `hw` scratch buffer. Only called when
/// `useHw == 1`. The caller must pass complete blocks; a trailing partial block
/// is handled by [`kyte_poly1305_finish`] instead.
extern("c") fn kyte_poly1305_blocks(state: ptr, data: ptr, nblocks: int): void;
/// Assembly fast path: absorb the final partial block, add the pad, and emit the tag.
///
/// `tail` points at the leftover `taillen` bytes (0..15) that did not fill a
/// whole block, `padLo`/`padHi` carry the 128-bit pad `s` as two 64-bit halves,
/// and the 16-byte tag is written to `out`. This finishes the assembly path and
/// mirrors the tail-padding plus final addition that [`Poly1305.final`] performs
/// by hand in the pure-Kyte path.
extern("c") fn kyte_poly1305_finish(state: ptr, tail: ptr, taillen: int, out: ptr, padLo: ulong, padHi: ulong): void;

/// Mask that keeps the low 26 bits, i.e. the width of one limb in the packed
/// five-limb representation of a field element.
const M26: ulong = 0x3ffffff;
/// The `2^128` high bit appended to each full 16-byte message block.
///
/// Each block is read as a 128-bit little endian integer and then bit 128 is
/// set before it enters the accumulator, which is Poly1305's way of encoding the
/// block length so that blocks of different content never collide. Bit 128 lands
/// in the fifth limb `h4` at bit `128 - 4*26 = 24`, hence the value `0x1000000`.
/// The final short block sets this bit explicitly at the pad byte instead (see
/// [`Poly1305.final`]), so it passes `0` here.
const HIBIT: ulong = 0x1000000;

/// Length in bytes of a Poly1305 key: 16 bytes of `r` followed by 16 bytes of `s`.
pub const POLY1305_KEY_LEN: int = 32;
/// Length in bytes of a Poly1305 authentication tag.
pub const POLY1305_TAG_LEN: int = 16;

/// Writes a 64-bit word `w` little endian at byte offset `off` in `buf`.
///
/// Used only to lay out the 44-bit-limb state that the assembly kernels read
/// from the `hw` scratch buffer, so it emits full 8-byte words. Compare
/// [`putLe`], which writes the 32-bit words of the final tag.
fn putU64(buf: ptr, off: int, w: ulong): void {
    let i = 0;
    while (i < 8) { bytes.write_byte(buf, off + i, ((w >> (i * 8)) & 0xff) as int); i = i + 1; }
}

/// Reads four bytes at offset `off` in `buf` as a 32-bit little endian word.
///
/// Poly1305 is defined entirely over little endian integers, so both the key
/// and the message are decoded through this helper. The result is widened to
/// `ulong` so callers can shift and OR adjacent words together to reassemble the
/// 26-bit or 44-bit limbs without a narrowing intermediate.
fn leWord(buf: ptr, off: int): ulong {
    return (bytes.read_byte(buf, off) as ulong)
        | ((bytes.read_byte(buf, off + 1) as ulong) << 8)
        | ((bytes.read_byte(buf, off + 2) as ulong) << 16)
        | ((bytes.read_byte(buf, off + 3) as ulong) << 24);
}

/// Writes the low 32 bits of `w` little endian at offset `off` in `buf`.
///
/// Used by [`Poly1305.final`] to serialise the four 32-bit words of the tag.
/// Only the bottom 32 bits are emitted; callers pass words already masked to
/// `0xffffffff`.
fn putLe(buf: ptr, off: int, w: ulong): void {
    bytes.write_byte(buf, off, (w & 0xff) as int);
    bytes.write_byte(buf, off + 1, ((w >> 8) & 0xff) as int);
    bytes.write_byte(buf, off + 2, ((w >> 16) & 0xff) as int);
    bytes.write_byte(buf, off + 3, ((w >> 24) & 0xff) as int);
}

/// A running Poly1305 computation over one message.
///
/// Holds the clamped key `r` and its pre-multiplied `s`-form, the polynomial
/// accumulator `h`, the pad, and a 16-byte staging buffer for a partial trailing
/// block. Build one with [`Poly1305.create`], feed message bytes with
/// [`Poly1305.update`] (any number of calls, any sizes), read the tag with
/// [`Poly1305.final`], then release the heap buffers with [`Poly1305.delete`].
/// The instance is single-use: it authenticates exactly one message and must not
/// be reset and reused, because the key is a one-time key.
pub struct Poly1305 {
    /// The clamped key `r` as five 26-bit limbs, low limb first. Set once in
    /// [`Poly1305.create`] and never mutated thereafter.
    pub r0: ulong, pub r1: ulong, pub r2: ulong, pub r3: ulong, pub r4: ulong,
    /// The upper `r` limbs each pre-multiplied by 5. These feed the mod
    /// `2^130 - 5` reduction inside [`Poly1305.absorb`]: a term that wraps past
    /// bit 130 is folded back into the low limbs as `5 *` its value.
    pub s1: ulong, pub s2: ulong, pub s3: ulong, pub s4: ulong,
    /// The polynomial accumulator `h` as five 26-bit limbs, starting at zero and
    /// updated per block. After the final carry chain in [`Poly1305.final`] its
    /// low 128 bits become the pre-pad tag.
    pub h0: ulong, pub h1: ulong, pub h2: ulong, pub h3: ulong, pub h4: ulong,
    /// The per-message pad `s` (second half of the key) as four 32-bit little
    /// endian words. Added to the reduced accumulator at the very end to produce
    /// the tag.
    pub pad0: ulong, pub pad1: ulong, pub pad2: ulong, pub pad3: ulong,
    /// A 16-byte heap buffer that stages a not-yet-complete block across
    /// [`Poly1305.update`] calls. Its valid prefix length is `bufLen`.
    pub buf: ptr,
    /// Number of bytes currently held in `buf`, in the range 0..15. When it
    /// reaches 16 the block is absorbed and this resets to 0.
    pub bufLen: int,
    /// Scratch buffer for the assembly path's 44-bit-limb state, or 0 when the
    /// pure-Kyte path is in use. Allocated (64 bytes) only when `useHw == 1`.
    pub hw: ptr,
    /// 1 when this instance runs the assembly fast path, 0 for the pure-Kyte
    /// limb path. Latched at creation from [`kyte_has_asm_crypto`] and fixed for
    /// the instance's lifetime; the two paths are never interleaved.
    pub useHw: int,

    /// Initialises a fresh Poly1305 state from a 32-byte key buffer.
    ///
    /// Decodes and clamps `r` from the first 16 bytes into the 26-bit limbs
    /// (`r0..r4`), the clamp masks (`0x3ffffff`, `0x3ffff03`, ...) are the
    /// canonical Poly1305 clamp that clears the bits the specification requires,
    /// then derives the `s1..s4` reduction constants. The pad `s` is read from
    /// the second 16 bytes, `h` is zeroed, and the staging buffer is allocated.
    /// When [`kyte_has_asm_crypto`] returns 1 it additionally lays out the key in
    /// the 44-bit-limb form the assembly kernels expect (with the `r1`/`r2`
    /// halves pre-multiplied by 20 for that path's reduction) into a 64-byte `hw`
    /// buffer and sets `useHw`. The returned value owns two heap buffers, so it
    /// must be released with [`Poly1305.delete`]. `key` must point at exactly
    /// [`POLY1305_KEY_LEN`] readable bytes.
    pub fn create(key: ptr): Poly1305 {
        let p = bytes.new_with_allocator<Poly1305>(allocator.globalAllocator());
        let t0 = leWord(key, 0);
        let t1 = leWord(key, 4);
        let t2 = leWord(key, 8);
        let t3 = leWord(key, 12);
        p.r0 = t0 & 0x3ffffff;
        p.r1 = ((t0 >> 26) | (t1 << 6)) & 0x3ffff03;
        p.r2 = ((t1 >> 20) | (t2 << 12)) & 0x3ffc0ff;
        p.r3 = ((t2 >> 14) | (t3 << 18)) & 0x3f03fff;
        p.r4 = (t3 >> 8) & 0x00fffff;
        p.s1 = p.r1 * 5;
        p.s2 = p.r2 * 5;
        p.s3 = p.r3 * 5;
        p.s4 = p.r4 * 5;
        p.h0 = 0; p.h1 = 0; p.h2 = 0; p.h3 = 0; p.h4 = 0;
        p.pad0 = leWord(key, 16);
        p.pad1 = leWord(key, 20);
        p.pad2 = leWord(key, 24);
        p.pad3 = leWord(key, 28);
        p.buf = bytes.alloc(16);
        p.bufLen = 0;
        p.hw = 0;
        p.useHw = 0;
        if (kyte_has_asm_crypto() == 1) {
            let k0 = leWord(key, 0) | (leWord(key, 4) << 32);
            let k1 = leWord(key, 8) | (leWord(key, 12) << 32);
            let hr0 = k0 & 0xffc0fffffff;
            let hr1 = ((k0 >> 44) | (k1 << 20)) & 0xfffffc0ffff;
            let hr2 = (k1 >> 24) & 0x00ffffffc0f;
            p.hw = bytes.alloc(64);
            putU64(p.hw, 0, hr0);
            putU64(p.hw, 8, hr1);
            putU64(p.hw, 16, hr2);
            putU64(p.hw, 24, hr1 * 20);
            putU64(p.hw, 32, hr2 * 20);
            putU64(p.hw, 40, 0);
            putU64(p.hw, 48, 0);
            putU64(p.hw, 56, 0);
            p.useHw = 1;
        }
        return p;
    }

    /// Absorbs one 16-byte block at offset `off` in `m` into the accumulator (pure-Kyte path).
    ///
    /// Computes `h = (h + block) * r mod (2^130 - 5)` for a single block. The
    /// block is decoded into 26-bit limbs and added to `h`, `hibit` supplies the
    /// high `2^128` bit ([`HIBIT`] for a full block, 0 when [`Poly1305.final`]
    /// pads a short tail that carries its own length byte), the schoolbook
    /// multiply `d0..d4` mixes each `h` limb against `r` and the pre-multiplied
    /// `s` limbs (the `s` terms are the wrapped high products folded back for the
    /// mod `2^130 - 5` reduction), and a carry chain repacks the result into
    /// five 26-bit limbs. This is the only path that reduces `h` per block; the
    /// assembly kernels do the equivalent in the `hw` state. Only called when
    /// `useHw == 0`.
    fn absorb(self: Poly1305, m: ptr, off: int, hibit: ulong): void {
        let t0 = leWord(m, off);
        let t1 = leWord(m, off + 4);
        let t2 = leWord(m, off + 8);
        let t3 = leWord(m, off + 12);
        let h0 = self.h0 + (t0 & M26);
        let h1 = self.h1 + (((t0 >> 26) | (t1 << 6)) & M26);
        let h2 = self.h2 + (((t1 >> 20) | (t2 << 12)) & M26);
        let h3 = self.h3 + (((t2 >> 14) | (t3 << 18)) & M26);
        let h4 = self.h4 + ((t3 >> 8) | hibit);

        let d0 = h0 * self.r0 + h1 * self.s4 + h2 * self.s3 + h3 * self.s2 + h4 * self.s1;
        let d1 = h0 * self.r1 + h1 * self.r0 + h2 * self.s4 + h3 * self.s3 + h4 * self.s2;
        let d2 = h0 * self.r2 + h1 * self.r1 + h2 * self.r0 + h3 * self.s4 + h4 * self.s3;
        let d3 = h0 * self.r3 + h1 * self.r2 + h2 * self.r1 + h3 * self.r0 + h4 * self.s4;
        let d4 = h0 * self.r4 + h1 * self.r3 + h2 * self.r2 + h3 * self.r1 + h4 * self.r0;

        let c = d0 >> 26; let nh0 = d0 & M26;
        d1 = d1 + c; c = d1 >> 26; let nh1 = d1 & M26;
        d2 = d2 + c; c = d2 >> 26; let nh2 = d2 & M26;
        d3 = d3 + c; c = d3 >> 26; let nh3 = d3 & M26;
        d4 = d4 + c; c = d4 >> 26; let nh4 = d4 & M26;
        let fh0 = nh0 + c * 5;
        c = fh0 >> 26; fh0 = fh0 & M26;
        let fh1 = nh1 + c;

        self.h0 = fh0;
        self.h1 = fh1;
        self.h2 = nh2;
        self.h3 = nh3;
        self.h4 = nh4;
    }

    /// Feeds `len` bytes at `data` into the running MAC.
    ///
    /// May be called any number of times with any chunk sizes; the result
    /// depends only on the concatenation of all the bytes fed, not on how they
    /// were split across calls. First it tops up any partial block left in `buf`
    /// from a previous call and absorbs it once full, then it absorbs whole
    /// 16-byte blocks straight from `data` (in a single batched
    /// [`kyte_poly1305_blocks`] call on the assembly path, or block by block via
    /// [`Poly1305.absorb`] otherwise), and finally it stashes the trailing 0..15
    /// bytes back into `buf` for next time. The trailing remainder is completed
    /// and padded by [`Poly1305.final`]. `data` must point at `len` readable
    /// bytes.
    pub fn update(self: Poly1305, data: ptr, len: int): void {
        let i = 0;
        if (self.bufLen > 0) {
            while (i < len && self.bufLen < 16) {
                bytes.write_byte(self.buf, self.bufLen, bytes.read_byte(data, i));
                self.bufLen = self.bufLen + 1;
                i = i + 1;
            }
            if (self.bufLen == 16) {
                if (self.useHw == 1) { kyte_poly1305_blocks(self.hw, self.buf, 1); }
                else { self.absorb(self.buf, 0, HIBIT); }
                self.bufLen = 0;
            }
        }
        if (self.useHw == 1) {
            let nb = (len - i) / 16;
            if (nb > 0) {
                kyte_poly1305_blocks(self.hw, (data as long + i) as ptr, nb);
                i = i + nb * 16;
            }
        } else {
            while (len - i >= 16) {
                self.absorb(data, i, HIBIT);
                i = i + 16;
            }
        }
        while (i < len) {
            bytes.write_byte(self.buf, self.bufLen, bytes.read_byte(data, i));
            self.bufLen = self.bufLen + 1;
            i = i + 1;
        }
    }

    /// Finishes the MAC and writes the 16-byte tag to `out`.
    ///
    /// Absorbs any trailing partial block held in `buf`: a `1` byte is appended
    /// right after the data (the length marker for a short block), the rest is
    /// zero-filled, and it is absorbed with `hibit = 0` since the marker byte
    /// already stands in for the high bit. Then `h` is fully carry-reduced, a
    /// constant-time conditional subtraction of the prime brings it into the
    /// range `[0, 2^130 - 5)` (the `mask`/`notMask` select avoids a
    /// data-dependent branch, so the reduction does not leak timing), the low 128
    /// bits are added to the pad `s` with carry propagation, and the four result
    /// words are serialised little endian via [`putLe`]. On the assembly path it
    /// delegates the tail, pad, and serialisation to [`kyte_poly1305_finish`].
    /// After this call the accumulator state is spent; do not call
    /// [`Poly1305.update`] again. `out` must point at [`POLY1305_TAG_LEN`]
    /// writable bytes.
    pub fn final(self: Poly1305, out: ptr): void {
        if (self.useHw == 1) {
            let padLo = self.pad0 | (self.pad1 << 32);
            let padHi = self.pad2 | (self.pad3 << 32);
            kyte_poly1305_finish(self.hw, self.buf, self.bufLen, out, padLo, padHi);
            self.bufLen = 0;
            return;
        }
        if (self.bufLen > 0) {
            bytes.write_byte(self.buf, self.bufLen, 1);
            let j = self.bufLen + 1;
            while (j < 16) { bytes.write_byte(self.buf, j, 0); j = j + 1; }
            self.absorb(self.buf, 0, 0);
            self.bufLen = 0;
        }

        let h0 = self.h0; let h1 = self.h1; let h2 = self.h2; let h3 = self.h3; let h4 = self.h4;
        let c = h1 >> 26; h1 = h1 & M26; h2 = h2 + c;
        c = h2 >> 26; h2 = h2 & M26; h3 = h3 + c;
        c = h3 >> 26; h3 = h3 & M26; h4 = h4 + c;
        c = h4 >> 26; h4 = h4 & M26; h0 = h0 + c * 5;
        c = h0 >> 26; h0 = h0 & M26; h1 = h1 + c;

        let g0 = h0 + 5; c = g0 >> 26; g0 = g0 & M26;
        let g1 = h1 + c; c = g1 >> 26; g1 = g1 & M26;
        let g2 = h2 + c; c = g2 >> 26; g2 = g2 & M26;
        let g3 = h3 + c; c = g3 >> 26; g3 = g3 & M26;
        let g4 = h4 + c;
        let useG = (g4 >> 26) & 1;
        let mask = 0 - useG;
        let notMask = mask ^ 0xffffffffffffffff;
        g4 = g4 & M26;
        h0 = (h0 & notMask) | (g0 & mask);
        h1 = (h1 & notMask) | (g1 & mask);
        h2 = (h2 & notMask) | (g2 & mask);
        h3 = (h3 & notMask) | (g3 & mask);
        h4 = (h4 & notMask) | (g4 & mask);

        let f0 = (h0 | (h1 << 26)) & 0xffffffff;
        let f1 = ((h1 >> 6) | (h2 << 20)) & 0xffffffff;
        let f2 = ((h2 >> 12) | (h3 << 14)) & 0xffffffff;
        let f3 = ((h3 >> 18) | (h4 << 8)) & 0xffffffff;

        let a0 = f0 + self.pad0; let cc = a0 >> 32; a0 = a0 & 0xffffffff;
        let a1 = f1 + self.pad1 + cc; cc = a1 >> 32; a1 = a1 & 0xffffffff;
        let a2 = f2 + self.pad2 + cc; cc = a2 >> 32; a2 = a2 & 0xffffffff;
        let a3 = f3 + self.pad3 + cc; a3 = a3 & 0xffffffff;

        putLe(out, 0, a0);
        putLe(out, 4, a1);
        putLe(out, 8, a2);
        putLe(out, 12, a3);
    }

    /// Frees the heap buffers this instance owns and null-guards against a double free.
    ///
    /// Releases the staging buffer `buf` and, on the assembly path, the `hw`
    /// scratch buffer, setting each pointer to 0 so a second call is a no-op.
    /// Every [`Poly1305.create`] must be matched with exactly one
    /// [`Poly1305.delete`]. It does NOT zero the secret key material in `r`/`s`;
    /// those live in the value struct's own storage, not on the heap.
    pub fn delete(self: Poly1305): void {
        if (self.buf != 0) {
            bytes.free(self.buf);
            self.buf = 0;
        }
        if (self.hw != 0) {
            bytes.free(self.hw);
            self.hw = 0;
        }
    }
}

/// One-shot Poly1305: authenticate a whole message under `key`, writing the tag to `out`.
///
/// Convenience wrapper that creates a [`Poly1305`], feeds the entire message in
/// a single [`Poly1305.update`], finalises, and deletes the state, so the caller
/// never touches the incremental API. Use this when the whole message is already
/// in one buffer. `key` is 32 bytes ([`POLY1305_KEY_LEN`]), `msg` is `msgLen`
/// bytes, and `out` receives 16 bytes ([`POLY1305_TAG_LEN`]). As with any
/// Poly1305 use, `key` must be a fresh one-time key for this message.
pub fn authInto(key: ptr, msg: ptr, msgLen: int, out: ptr): void {
    let p = Poly1305.create(key);
    p.update(msg, msgLen);
    p.final(out);
    p.delete();
}
