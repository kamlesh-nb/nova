import bytes;
import crypto.cipher.aes;

pub const AES_CTR_BLOCK_LEN: int = 16;

fn incFull(ctr: ptr): void {
    let i = 15;
    let carry = 1;
    while (i >= 0) {
        let v = bytes.read_byte(ctr, i) + carry;
        bytes.write_byte(ctr, i, v & 0xff);
        carry = v >> 8;
        i = i - 1;
    }
}

pub fn crypt(key: ptr, keyLen: int, counter: ptr, dataIn: ptr, len: int, out: ptr): void {
    let ctx = aes.Aes.create(key, keyLen);
    let ctr = bytes.alloc(16);
    let i = 0;
    while (i < 16) { bytes.write_byte(ctr, i, bytes.read_byte(counter, i)); i = i + 1; }
    let ks = bytes.alloc(16);
    let done = 0;
    while (done < len) {
        ctx.encryptBlock(ctr, ks);
        let n = if (len - done < 16) (len - done) else 16;
        let k = 0;
        while (k < n) {
            bytes.write_byte(out, done + k, bytes.read_byte(dataIn, done + k) ^ bytes.read_byte(ks, k));
            k = k + 1;
        }
        incFull(ctr);
        done = done + n;
    }
    ctx.delete();
    bytes.free(ctr);
    bytes.free(ks);
}
