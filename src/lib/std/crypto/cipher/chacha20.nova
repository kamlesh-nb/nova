import bytes;

extern("c") fn nova_has_asm_crypto(): int;
extern("c") fn nova_chacha20_xor(key: ptr, counter: int, nonce: ptr, dataIn: ptr, len: int, out: ptr): void;

const MASK32: ulong = 0xffffffff;

pub const CHACHA_KEY_LEN: int = 32;
pub const CHACHA_NONCE_LEN: int = 12;
pub const CHACHA_BLOCK_LEN: int = 64;

fn rotl(x: ulong, n: int): ulong {
    return ((x << n) | (x >> (32 - n))) & MASK32;
}

fn leWord(buf: ptr, off: int): ulong {
    return (bytes.read_byte(buf, off) as ulong)
        | ((bytes.read_byte(buf, off + 1) as ulong) << 8)
        | ((bytes.read_byte(buf, off + 2) as ulong) << 16)
        | ((bytes.read_byte(buf, off + 3) as ulong) << 24);
}

fn putLe(buf: ptr, off: int, w: ulong): void {
    bytes.write_byte(buf, off, (w & 0xff) as int);
    bytes.write_byte(buf, off + 1, ((w >> 8) & 0xff) as int);
    bytes.write_byte(buf, off + 2, ((w >> 16) & 0xff) as int);
    bytes.write_byte(buf, off + 3, ((w >> 24) & 0xff) as int);
}

fn qr(s: ptr, a: int, b: int, c: int, d: int): void {
    let wa = leWord(s, a * 4);
    let wb = leWord(s, b * 4);
    let wc = leWord(s, c * 4);
    let wd = leWord(s, d * 4);
    wa = (wa + wb) & MASK32; wd = rotl(wd ^ wa, 16);
    wc = (wc + wd) & MASK32; wb = rotl(wb ^ wc, 12);
    wa = (wa + wb) & MASK32; wd = rotl(wd ^ wa, 8);
    wc = (wc + wd) & MASK32; wb = rotl(wb ^ wc, 7);
    putLe(s, a * 4, wa);
    putLe(s, b * 4, wb);
    putLe(s, c * 4, wc);
    putLe(s, d * 4, wd);
}

pub fn keystreamBlock(key: ptr, counter: ulong, nonce: ptr, out: ptr): void {
    let j0: ulong = 0x61707865; let j1: ulong = 0x3320646e; let j2: ulong = 0x79622d32; let j3: ulong = 0x6b206574;
    let j4 = leWord(key, 0);    let j5 = leWord(key, 4);    let j6 = leWord(key, 8);    let j7 = leWord(key, 12);
    let j8 = leWord(key, 16);   let j9 = leWord(key, 20);   let j10 = leWord(key, 24);  let j11 = leWord(key, 28);
    let j12: ulong = counter & MASK32;
    let j13 = leWord(nonce, 0); let j14 = leWord(nonce, 4); let j15 = leWord(nonce, 8);

    let x0 = j0;   let x1 = j1;   let x2 = j2;   let x3 = j3;
    let x4 = j4;   let x5 = j5;   let x6 = j6;   let x7 = j7;
    let x8 = j8;   let x9 = j9;   let x10 = j10; let x11 = j11;
    let x12 = j12; let x13 = j13; let x14 = j14; let x15 = j15;

    let r = 0;
    while (r < 10) {
        x0 = (x0 + x4) & MASK32;   x12 = rotl(x12 ^ x0, 16);
        x8 = (x8 + x12) & MASK32;  x4 = rotl(x4 ^ x8, 12);
        x0 = (x0 + x4) & MASK32;   x12 = rotl(x12 ^ x0, 8);
        x8 = (x8 + x12) & MASK32;  x4 = rotl(x4 ^ x8, 7);

        x1 = (x1 + x5) & MASK32;   x13 = rotl(x13 ^ x1, 16);
        x9 = (x9 + x13) & MASK32;  x5 = rotl(x5 ^ x9, 12);
        x1 = (x1 + x5) & MASK32;   x13 = rotl(x13 ^ x1, 8);
        x9 = (x9 + x13) & MASK32;  x5 = rotl(x5 ^ x9, 7);

        x2 = (x2 + x6) & MASK32;   x14 = rotl(x14 ^ x2, 16);
        x10 = (x10 + x14) & MASK32; x6 = rotl(x6 ^ x10, 12);
        x2 = (x2 + x6) & MASK32;   x14 = rotl(x14 ^ x2, 8);
        x10 = (x10 + x14) & MASK32; x6 = rotl(x6 ^ x10, 7);

        x3 = (x3 + x7) & MASK32;   x15 = rotl(x15 ^ x3, 16);
        x11 = (x11 + x15) & MASK32; x7 = rotl(x7 ^ x11, 12);
        x3 = (x3 + x7) & MASK32;   x15 = rotl(x15 ^ x3, 8);
        x11 = (x11 + x15) & MASK32; x7 = rotl(x7 ^ x11, 7);

        x0 = (x0 + x5) & MASK32;   x15 = rotl(x15 ^ x0, 16);
        x10 = (x10 + x15) & MASK32; x5 = rotl(x5 ^ x10, 12);
        x0 = (x0 + x5) & MASK32;   x15 = rotl(x15 ^ x0, 8);
        x10 = (x10 + x15) & MASK32; x5 = rotl(x5 ^ x10, 7);

        x1 = (x1 + x6) & MASK32;   x12 = rotl(x12 ^ x1, 16);
        x11 = (x11 + x12) & MASK32; x6 = rotl(x6 ^ x11, 12);
        x1 = (x1 + x6) & MASK32;   x12 = rotl(x12 ^ x1, 8);
        x11 = (x11 + x12) & MASK32; x6 = rotl(x6 ^ x11, 7);

        x2 = (x2 + x7) & MASK32;   x13 = rotl(x13 ^ x2, 16);
        x8 = (x8 + x13) & MASK32;  x7 = rotl(x7 ^ x8, 12);
        x2 = (x2 + x7) & MASK32;   x13 = rotl(x13 ^ x2, 8);
        x8 = (x8 + x13) & MASK32;  x7 = rotl(x7 ^ x8, 7);

        x3 = (x3 + x4) & MASK32;   x14 = rotl(x14 ^ x3, 16);
        x9 = (x9 + x14) & MASK32;  x4 = rotl(x4 ^ x9, 12);
        x3 = (x3 + x4) & MASK32;   x14 = rotl(x14 ^ x3, 8);
        x9 = (x9 + x14) & MASK32;  x4 = rotl(x4 ^ x9, 7);

        r = r + 1;
    }

    putLe(out, 0,  (x0 + j0) & MASK32);   putLe(out, 4,  (x1 + j1) & MASK32);
    putLe(out, 8,  (x2 + j2) & MASK32);   putLe(out, 12, (x3 + j3) & MASK32);
    putLe(out, 16, (x4 + j4) & MASK32);   putLe(out, 20, (x5 + j5) & MASK32);
    putLe(out, 24, (x6 + j6) & MASK32);   putLe(out, 28, (x7 + j7) & MASK32);
    putLe(out, 32, (x8 + j8) & MASK32);   putLe(out, 36, (x9 + j9) & MASK32);
    putLe(out, 40, (x10 + j10) & MASK32); putLe(out, 44, (x11 + j11) & MASK32);
    putLe(out, 48, (x12 + j12) & MASK32); putLe(out, 52, (x13 + j13) & MASK32);
    putLe(out, 56, (x14 + j14) & MASK32); putLe(out, 60, (x15 + j15) & MASK32);
}

pub fn applyKeystream(key: ptr, counter0: ulong, nonce: ptr, dataIn: ptr, len: int, out: ptr): void {
    let done = 0;
    let ctr = counter0;
    if (nova_has_asm_crypto() == 1) {
        let fused = len - (len % 256);
        if (fused > 0) {
            nova_chacha20_xor(key, counter0 as int, nonce, dataIn, fused, out);
            done = fused;
            ctr = counter0 + (fused / 64) as ulong;
        }
    }
    let ks = bytes.alloc(64);
    while (done < len) {
        keystreamBlock(key, ctr, nonce, ks);
        let n = if (len - done < 64) (len - done) else 64;
        let i = 0;
        while (i < n) {
            bytes.write_byte(out, done + i, bytes.read_byte(dataIn, done + i) ^ bytes.read_byte(ks, i));
            i = i + 1;
        }
        done = done + n;
        ctr = ctr + 1;
    }
    bytes.free(ks);
}
