//! Online Certificate Status Protocol (OCSP), the RFC 6960 client and a tiny responder.
//!
//! OCSP is how a TLS client asks "is this certificate revoked right now?" without
//! downloading a whole CRL. The client builds an `OCSPRequest` naming a certificate
//! (by the hash of its issuer's name and key, plus the certificate serial number),
//! sends it to the issuer's OCSP responder, and gets back a signed `OCSPResponse`
//! that says good, revoked, or unknown. This file implements both ends of that:
//! [`buildOcspRequest`] mints the request, [`parseOcspResponse`] parses the reply,
//! and [`verifyOcspSignatureEc`] checks the responder actually signed it.
//!
//! Everything here works directly on raw DER bytes through `ptr` and the `bytes`
//! intrinsics, never on owned Nova `string`s. That is deliberate: OCSP messages
//! arrive as a slice of a network buffer, and re-parsing or re-encoding ASN.1 is a
//! byte-offset game. So the parser records OFFSETS into the caller's buffer (for
//! example [`OcspResult.serialOff`] and [`OcspResult.tbsStart`]) rather than copying
//! the fields out. The caller must keep the backing DER buffer alive for as long as
//! it uses those offsets, and must pass the SAME buffer back to helpers like
//! [`serialMatches`] and [`verifyOcspSignatureEc`] that read through them.
//!
//! DER decoding is done with the shared TLV reader from [`crypto.x509`]
//! (`x509.readTlv`), which returns a tag plus the offsets of the value and of the
//! next sibling. The encoding side is hand-rolled here: [`wlen`], [`wrap`] and
//! [`cat`] are a small bottom-up DER writer, where each structure is built into its
//! own scratch buffer and then wrapped by its parent. That inside-out order is why
//! the build functions allocate a ladder of temporary buffers with hand-picked
//! sizes; the sizes are worst-case upper bounds for the fixed OCSP shapes, not
//! computed lengths.
//!
//! Signatures are ECDSA over the P-256 curve only (see [`SIG_ECDSA_SHA256`]). The
//! signature carried in the response is itself a DER `SEQUENCE { INTEGER r, INTEGER
//! s }`, so verification first decodes that into two fixed 32-byte big-endian
//! scalars ([`decodeSig`] / [`intTo`]) before handing them to `p256.ecdsaVerify`.
//! The [`buildTestResponse`] path is the mirror image: it signs a hand-built
//! BasicOCSPResponse and re-encodes r and s back into the minimal DER integer form
//! ([`encodeSig`] / [`encInt`]). That responder side exists so the client parser and
//! verifier can be exercised end to end in tests without a live OCSP server; it is
//! not a production responder.
//!
//! This module fits under `std/crypto` alongside the X.509 parser it borrows the TLV
//! reader from, the SHA-256/SHA-1 hashes, and the P-256 ECC primitives. It is part
//! of the TLS certificate-validation path, giving revocation checking on top of the
//! chain and hostname checks that live elsewhere in the crypto tree.

import bytes;
import crypto.x509;
import crypto.hash.sha256;
import crypto.hash.sha1;
import crypto.ecc.p256;

/// OCSP response status `successful` (RFC 6960): the responder produced a real
/// answer, so the certificate-status body is present and worth parsing.
pub const STATUS_SUCCESSFUL: int = 0;
/// Certificate status `good`: the certificate is not revoked as of this response.
///
/// Maps the CertStatus `[0]` context tag (`0x80`) seen by [`parseOcspResponse`].
pub const CERT_GOOD: int = 0;
/// Certificate status `revoked`: the issuer has revoked this certificate.
///
/// Maps the CertStatus `[1]` context tag (`0xa1`) seen by [`parseOcspResponse`].
pub const CERT_REVOKED: int = 1;
/// Certificate status `unknown`: the responder does not know about this
/// certificate (for example, it was never issued by this CA).
///
/// Maps the CertStatus `[2]` context tag (`0x82`) seen by [`parseOcspResponse`].
pub const CERT_UNKNOWN: int = 2;
/// Sentinel used before or instead of a real certificate status, meaning the
/// response could not be parsed into a good/revoked/unknown answer.
///
/// [`OcspResult`] starts at this value, and [`parseOcspResponse`] leaves it here
/// when the CertStatus tag is none of the three recognised context tags. It is
/// distinct from all real statuses so an unparseable response is never mistaken
/// for `good`.
pub const CERT_ERROR: int = 0 - 1;
/// Signature algorithm `ecdsa-with-SHA256`, the only algorithm this module can
/// verify or produce. See [`verifyOcspSignatureEc`] and [`isEcdsaSha256`].
pub const SIG_ECDSA_SHA256: int = 0;
/// Sentinel signature algorithm: the response is signed with something other than
/// ECDSA-with-SHA256, so [`verifyOcspSignatureEc`] must refuse it.
pub const SIG_UNKNOWN: int = 0 - 1;

/// The decoded outcome of one OCSP response, expressed as OFFSETS into the caller's
/// DER buffer rather than copied-out fields.
///
/// [`parseOcspResponse`] fills this in without allocating: `serialOff`/`serialLen`,
/// `tbsStart`/`tbsLen` and `sigOff`/`sigLen` all point back into the original `der`
/// buffer, so that buffer must stay alive and be passed back to [`serialMatches`]
/// and [`verifyOcspSignatureEc`]. Check [`OcspResult.ok`] before trusting any other
/// field; a value straight from [`init`] (or from a parse that bailed out early) has
/// `ok == false` and error sentinels in the status fields.
pub struct OcspResult {
    /// The top-level OCSPResponseStatus byte (0 is `successful`, see
    /// [`STATUS_SUCCESSFUL`]). Only when this is 0 is a certificate-status body
    /// present; a non-zero value means the responder returned an error and there
    /// is nothing further to read.
    pub responseStatus: int,
    /// The per-certificate status: one of [`CERT_GOOD`], [`CERT_REVOKED`],
    /// [`CERT_UNKNOWN`], or [`CERT_ERROR`] when the tag was unrecognised.
    pub certStatus: int,
    /// Offset and length, within the caller's DER buffer, of the certificate serial
    /// number bytes from the CertID. Compared against a known serial by
    /// [`serialMatches`] to confirm the response is about the right certificate.
    pub serialOff: int, pub serialLen: int,
    /// Offset and length, within the caller's DER buffer, of the signed
    /// ResponseData (tbsResponseData). These are the exact bytes hashed during
    /// signature verification, so the span must be the DER-with-header, not just the
    /// inner value. See [`verifyOcspSignatureEc`].
    pub tbsStart: int, pub tbsLen: int,
    /// The signature algorithm ([`SIG_ECDSA_SHA256`] or [`SIG_UNKNOWN`]), and the
    /// offset and length of the raw signature bytes (the BIT STRING contents minus
    /// the leading unused-bits octet). Consumed by [`verifyOcspSignatureEc`].
    pub sigAlg: int, pub sigOff: int, pub sigLen: int,
    /// True only when parsing reached a coherent end: either a responder error
    /// status, or a fully walked successful response. When false, every other field
    /// is meaningless and callers must treat the response as unusable.
    pub ok: bool,

    /// Constructs a not-yet-parsed result: `ok = false`, status fields set to their
    /// error sentinels, and all offsets zeroed, so a failed or skipped parse can
    /// never be read as a valid `good` answer.
    init() {
        self.responseStatus = 0 - 1; self.certStatus = CERT_ERROR;
        self.serialOff = 0; self.serialLen = 0; self.tbsStart = 0; self.tbsLen = 0;
        self.sigAlg = SIG_UNKNOWN; self.sigOff = 0; self.sigLen = 0; self.ok = false;
    }
    /// True only when the response parsed cleanly, the responder status was
    /// `successful`, and the certificate status is [`CERT_GOOD`]. This is the one
    /// predicate a caller should gate acceptance on: it fails closed, so a
    /// half-parsed or error response never reads as good. Note that it does NOT
    /// verify the signature; call [`verifyOcspSignatureEc`] separately.
    pub fn isGood(self: OcspResult): bool { return self.ok && self.responseStatus == 0 && self.certStatus == CERT_GOOD; }
    /// True only when the response parsed cleanly, the responder status was
    /// `successful`, and the certificate status is [`CERT_REVOKED`]. Like
    /// [`OcspResult.isGood`] this checks status only, not the signature.
    pub fn isRevoked(self: OcspResult): bool { return self.ok && self.responseStatus == 0 && self.certStatus == CERT_REVOKED; }
}

/// Reports whether the AlgorithmIdentifier at `algSeqStart` names
/// ecdsa-with-SHA256 (OID 1.2.840.10045.4.3.2).
///
/// It reads the outer SEQUENCE, then the OID inside it, and checks the OID is
/// exactly 8 bytes with the four distinguishing bytes at the known positions
/// (`2a`, then `04 03 02` at offsets 5, 6, 7). It matches on those signature bytes
/// rather than the full encoding, which is enough to tell this one algorithm apart.
/// Returns false for any other OID or a wrong length, so an unrecognised algorithm
/// leaves [`OcspResult.sigAlg`] as [`SIG_UNKNOWN`].
fn isEcdsaSha256(buf: ptr, algSeqStart: int): bool {
    let seq = x509.readTlv(buf, algSeqStart);
    let oid = x509.readTlv(buf, seq.start);
    if (oid.len != 8) { return false; }
    return bytes.read_byte(buf, oid.start) == 0x2a && bytes.read_byte(buf, oid.start + 5) == 0x04
        && bytes.read_byte(buf, oid.start + 6) == 0x03 && bytes.read_byte(buf, oid.start + 7) == 0x02;
}

/// Parses a DER-encoded OCSPResponse into an [`OcspResult`] of offsets into `der`.
///
/// It walks the RFC 6960 structure top down using `x509.readTlv`: the outer
/// SEQUENCE, the enumerated responseStatus, and (only when that is `successful`)
/// the `[0]` responseBytes wrapping a BasicOCSPResponse. From the BasicOCSPResponse
/// it records the exact tbsResponseData span for later signature checking, notes
/// whether the signature algorithm is ECDSA-with-SHA256, and captures the signature
/// bytes (dropping the BIT STRING's leading unused-bits octet, hence `+1`/`-1`).
///
/// It then descends into the single-response CertID to capture the certificate
/// serial offset, and reads the CertStatus context tag to set [`OcspResult.certStatus`]
/// (`[0]` good, `[1]` revoked, `[2]` unknown, else [`CERT_ERROR`]). Only the FIRST
/// SingleResponse is read.
///
/// On any structural surprise (a wrong top-level or responseStatus tag, or a missing
/// `[0]` context tag) it returns early with `ok == false`; the caller must check
/// [`OcspResult.ok`]. A responder error status (non-zero responseStatus) returns with
/// `ok == true` but no certificate body, which the [`OcspResult.isGood`] /
/// [`OcspResult.isRevoked`] predicates reject because they require responseStatus 0.
/// `len` is accepted for interface symmetry; bounds come from the DER length fields
/// themselves, so a malformed length can read past the intended message.
pub fn parseOcspResponse(der: ptr, len: int): OcspResult {
    let r = OcspResult();
    let top = x509.readTlv(der, 0);
    if (top.tag != 0x30) { return r; }
    let rs = x509.readTlv(der, top.start);
    if (rs.tag != 0x0a) { return r; }
    r.responseStatus = bytes.read_byte(der, rs.start);
    if (r.responseStatus != 0) { r.ok = true; return r; }

    let rbCtx = x509.readTlv(der, rs.next);
    if (rbCtx.tag != 0xa0) { return r; }
    let rbSeq = x509.readTlv(der, rbCtx.start);
    let rtype = x509.readTlv(der, rbSeq.start);
    let respOct = x509.readTlv(der, rtype.next);
    let basic = x509.readTlv(der, respOct.start);
    let tbs = x509.readTlv(der, basic.start);
    r.tbsStart = basic.start;
    r.tbsLen = tbs.next - basic.start;
    let sigAlgStart = tbs.next;
    if (isEcdsaSha256(der, sigAlgStart)) { r.sigAlg = SIG_ECDSA_SHA256; }
    let sigAlgTlv = x509.readTlv(der, sigAlgStart);
    let sigBit = x509.readTlv(der, sigAlgTlv.next);
    r.sigOff = sigBit.start + 1;
    r.sigLen = sigBit.len - 1;

    let t = tbs.start;
    let first = x509.readTlv(der, t);
    if (first.tag == 0xa0) { t = first.next; first = x509.readTlv(der, t); }
    t = first.next;
    let produced = x509.readTlv(der, t);
    t = produced.next;
    let responses = x509.readTlv(der, t);
    let sr = x509.readTlv(der, responses.start);
    let certId = x509.readTlv(der, sr.start);
    let c = certId.start;
    let ha = x509.readTlv(der, c); c = ha.next;
    let inh = x509.readTlv(der, c); c = inh.next;
    let ikh = x509.readTlv(der, c); c = ikh.next;
    let serial = x509.readTlv(der, c);
    r.serialOff = serial.start; r.serialLen = serial.len;
    let status = x509.readTlv(der, certId.next);
    if (status.tag == 0x80) { r.certStatus = CERT_GOOD; }
    else if (status.tag == 0xa1) { r.certStatus = CERT_REVOKED; }
    else if (status.tag == 0x82) { r.certStatus = CERT_UNKNOWN; }
    else { r.certStatus = CERT_ERROR; }
    r.ok = true;
    return r;
}

/// Reports whether the serial number captured in `res` equals the `serialLen` bytes
/// at `serial`.
///
/// This is the check that a response actually concerns the certificate the caller
/// asked about, defending against a responder (or attacker) returning a `good`
/// answer for the wrong serial. It reads the serial straight out of the original
/// `der` buffer at [`OcspResult.serialOff`], so `der` must be the same buffer that
/// was parsed. Returns false immediately if the result is not `ok` or the lengths
/// differ, then compares byte by byte.
pub fn serialMatches(der: ptr, res: OcspResult, serial: ptr, serialLen: int): bool {
    if (!res.ok || res.serialLen != serialLen) { return false; }
    let i = 0;
    while (i < serialLen) { if (bytes.read_byte(der, res.serialOff + i) != bytes.read_byte(serial, i)) { return false; } i = i + 1; }
    return true;
}

/// Verifies the ECDSA-P256 signature on a parsed OCSP response against a responder
/// public key.
///
/// This is what makes the status trustworthy: without it, [`OcspResult.certStatus`]
/// is just unauthenticated bytes. It hashes the exact tbsResponseData span (SHA-256
/// over `der[tbsStart .. tbsStart+tbsLen]`), decodes the DER `SEQUENCE { r, s }`
/// signature at [`OcspResult.sigOff`] into two 32-byte scalars via [`decodeSig`],
/// and calls `p256.ecdsaVerify`. `responderPub65` is the uncompressed P-256 point
/// (65 bytes, `0x04` prefix).
///
/// Refuses (returns false) unless the result is `ok` and the algorithm is
/// [`SIG_ECDSA_SHA256`], so an unknown-algorithm response can never pass. The three
/// scratch buffers (digest, r, s) are freed before returning on every path.
pub fn verifyOcspSignatureEc(der: ptr, res: OcspResult, responderPub65: ptr): bool {
    if (!res.ok || res.sigAlg != SIG_ECDSA_SHA256) { return false; }
    let digest = bytes.alloc(32);
    sha256.hashInto((der as long + res.tbsStart) as ptr, res.tbsLen, digest);
    let sigPtr = (der as long + res.sigOff) as ptr;
    let r = bytes.alloc(32); let s = bytes.alloc(32);
    decodeSig(sigPtr, r, s);
    let ok = p256.ecdsaVerify(digest, responderPub65, r, s);
    bytes.free(digest); bytes.free(r); bytes.free(s);
    return ok;
}

/// Decodes a DER ECDSA signature `SEQUENCE { INTEGER r, INTEGER s }` into two
/// fixed 32-byte big-endian scalars.
///
/// The offsets are computed for the single-byte-length case: the outer SEQUENCE
/// header is 2 bytes and the first INTEGER header is 2 more, so `r`'s value starts
/// at offset 4 (`rTag`) with its length at offset 3; `s` follows immediately after
/// `r`'s value. This assumes short-form (under 128 byte) lengths, which always holds
/// for a P-256 signature. Each integer is normalised to 32 bytes by [`intTo`], which
/// strips leading zero padding and left-pads with zeros.
fn decodeSig(sig: ptr, rOut: ptr, sOut: ptr): void {
    let rTag = 2 + 2;
    let rLen = bytes.read_byte(sig, 3);
    let sValHdr = rTag + rLen;
    let sTag = sValHdr + 2;
    let sLen = bytes.read_byte(sig, sValHdr + 1);
    intTo(sig, rTag, rLen, rOut);
    intTo(sig, sTag, sLen, sOut);
}
/// Copies a big-endian integer of `len` bytes at `buf+start` into a fixed 32-byte,
/// zero-padded, big-endian field at `out`.
///
/// DER INTEGERs are minimally encoded and may carry a leading `0x00` byte to keep
/// the value positive, and may be shorter than 32 bytes. This first skips leading
/// zero bytes, then zeroes the whole 32-byte output and writes the remaining `l`
/// bytes right-aligned (`pad = 32 - l`). The result is the fixed-width form
/// `p256.ecdsaVerify` expects for r and s.
fn intTo(buf: ptr, start: int, len: int, out: ptr): void {
    let s = start; let l = len;
    while (l > 0 && bytes.read_byte(buf, s) == 0) { s = s + 1; l = l - 1; }
    let i = 0;
    while (i < 32) { bytes.write_byte(out, i, 0); i = i + 1; }
    let pad = 32 - l;
    i = 0;
    while (i < l) { bytes.write_byte(out, pad + i, bytes.read_byte(buf, s + i)); i = i + 1; }
}

/// Writes a DER length field for `n` at `out+off` and returns how many bytes it
/// took (1, 2, or 3).
///
/// Implements DER definite-length encoding: values under 128 fit in one byte
/// (short form); larger values use the long form, `0x81` then one byte for values
/// under 256, or `0x82` then a two-byte big-endian length. The OCSP structures
/// built here never exceed a two-byte length, so no wider form is handled.
fn wlen(out: ptr, off: int, n: int): int {
    if (n < 0x80) { bytes.write_byte(out, off, n); return 1; }
    if (n < 0x100) { bytes.write_byte(out, off, 0x81); bytes.write_byte(out, off + 1, n); return 2; }
    bytes.write_byte(out, off, 0x82); bytes.write_byte(out, off + 1, (n >> 8) & 0xff); bytes.write_byte(out, off + 2, n & 0xff);
    return 3;
}
/// Wraps `childLen` bytes from `child` in a DER TLV with the given `tag`, writing
/// `tag` then the length then the copied value at `out+off`, and returns the total
/// bytes written.
///
/// This is the core building block of the bottom-up DER writer: a structure is
/// first assembled in its own scratch buffer, then `wrap` prepends its tag and
/// length. The returned total is `1 + lengthBytes + childLen`, which the caller uses
/// to place the next sibling. See also [`cat`] for concatenating already-wrapped
/// siblings.
fn wrap(out: ptr, off: int, tag: int, child: ptr, childLen: int): int {
    bytes.write_byte(out, off, tag);
    let ln = wlen(out, off + 1, childLen);
    let p = off + 1 + ln;
    let i = 0;
    while (i < childLen) { bytes.write_byte(out, p + i, bytes.read_byte(child, i)); i = i + 1; }
    return 1 + ln + childLen;
}
/// Appends `n` bytes from `src` to `out+off` and returns `n`.
///
/// The counterpart to [`wrap`]: where `wrap` adds a tag and length around one child,
/// `cat` lays already-encoded siblings side by side inside a parent's body buffer.
/// Callers accumulate the returned counts to track the running write position.
fn cat(out: ptr, off: int, src: ptr, n: int): int {
    let i = 0;
    while (i < n) { bytes.write_byte(out, off + i, bytes.read_byte(src, i)); i = i + 1; }
    return n;
}

/// Builds a DER OCSPRequest for a single certificate into `out`, returning its
/// length in bytes.
///
/// The certificate is identified the OCSP way, by the SHA-1 hash of the issuer's
/// distinguished name (`nameHash20`) and of the issuer's public key
/// (`keyHash20`), each 20 bytes, plus the certificate `serial` number. The request
/// carries the SHA-1 AlgorithmIdentifier (OID 1.3.14.3.2.26) because CertID hashes
/// are defined over SHA-1, and nests CertID inside Request inside requestList inside
/// TBSRequest inside the outer OCSPRequest SEQUENCE.
///
/// It is assembled bottom up with [`wrap`] and [`cat`], each level built into its own
/// scratch buffer whose size is a fixed worst-case bound for these shapes. `out` must
/// have room for the finished request (a couple of hundred bytes is ample for one
/// CertID). The scratch buffers are intentionally not freed here; they are small,
/// short-lived allocations.
pub fn buildOcspRequest(nameHash20: ptr, keyHash20: ptr, serial: ptr, serialLen: int, out: ptr): int {
    let alg = bytes.alloc(16);
    let algInner = bytes.alloc(11);
    let ai = 0;
    bytes.write_byte(algInner, ai, 0x06); bytes.write_byte(algInner, ai + 1, 0x05);
    bytes.write_byte(algInner, ai + 2, 0x2b); bytes.write_byte(algInner, ai + 3, 0x0e); bytes.write_byte(algInner, ai + 4, 0x03);
    bytes.write_byte(algInner, ai + 5, 0x02); bytes.write_byte(algInner, ai + 6, 0x1a); ai = ai + 7;
    bytes.write_byte(algInner, ai, 0x05); bytes.write_byte(algInner, ai + 1, 0x00); ai = ai + 2;
    let algLen = wrap(alg, 0, 0x30, algInner, ai);

    let cid = bytes.alloc(128);
    let cp = 0;
    cp = cp + cat(cid, cp, alg, algLen);
    let onh = bytes.alloc(24); let onhLen = wrap(onh, 0, 0x04, nameHash20, 20); cp = cp + cat(cid, cp, onh, onhLen);
    let okh = bytes.alloc(24); let okhLen = wrap(okh, 0, 0x04, keyHash20, 20); cp = cp + cat(cid, cp, okh, okhLen);
    let ser = bytes.alloc(serialLen + 4); let serLen = wrap(ser, 0, 0x02, serial, serialLen); cp = cp + cat(cid, cp, ser, serLen);
    let certId = bytes.alloc(160); let certIdLen = wrap(certId, 0, 0x30, cid, cp);

    let req = bytes.alloc(180); let reqLen = wrap(req, 0, 0x30, certId, certIdLen);
    let reqList = bytes.alloc(200); let reqListLen = wrap(reqList, 0, 0x30, req, reqLen);
    let tbs = bytes.alloc(220); let tbsLen = wrap(tbs, 0, 0x30, reqList, reqListLen);
    let total = wrap(out, 0, 0x30, tbs, tbsLen);
    return total;
}

/// Builds a fully signed DER OCSPResponse into `out` for testing, returning its
/// length in bytes.
///
/// This is the responder side, present so the client parser and verifier can be
/// exercised without a live OCSP server; it is NOT a production responder. It hand
/// assembles a BasicOCSPResponse: a ResponseData naming the responder by key hash
/// (`keyHash20`), carrying one SingleResponse for `serial` whose CertStatus is
/// either `[0]` good or a `[1]` revoked wrapping the revocation time, then signs the
/// SHA-256 of that ResponseData with the P-256 private key `key32` and re-encodes
/// r and s into a DER signature via [`encodeSig`]. `time15` is a 15-byte
/// GeneralizedTime used for the thisUpdate, producedAt and revocation fields.
///
/// The issuer name/key hashes inside the test CertID are filler bytes (`0xAB`), so a
/// response from here matches on serial via [`serialMatches`] and verifies via
/// [`verifyOcspSignatureEc`], but is not a real chain. `certStatus` selects the
/// good/revoked branch. As with [`buildOcspRequest`], every level is built into a
/// worst-case-sized scratch buffer and wrapped bottom up.
pub fn buildTestResponse(serial: ptr, serialLen: int, certStatus: int, key32: ptr, keyHash20: ptr, time15: ptr, out: ptr): int {
    let filler = bytes.alloc(20);
    let fi = 0; while (fi < 20) { bytes.write_byte(filler, fi, 0xAB); fi = fi + 1; }
    let cidReq = bytes.alloc(200);
    let cidLen = certIdDer(filler, filler, serial, serialLen, cidReq);

    let cs = bytes.alloc(32); let csLen = 0;
    if (certStatus == CERT_REVOKED) {
        let rt = bytes.alloc(20); let rtLen = wrap(rt, 0, 0x18, time15, 15);
        csLen = wrap(cs, 0, 0xa1, rt, rtLen);
    } else {
        bytes.write_byte(cs, 0, 0x80); bytes.write_byte(cs, 1, 0x00); csLen = 2;
    }
    let tu = bytes.alloc(20); let tuLen = wrap(tu, 0, 0x18, time15, 15);

    let srBody = bytes.alloc(300); let sp = 0;
    sp = sp + cat(srBody, sp, cidReq, cidLen);
    sp = sp + cat(srBody, sp, cs, csLen);
    sp = sp + cat(srBody, sp, tu, tuLen);
    let sr = bytes.alloc(320); let srLen = wrap(sr, 0, 0x30, srBody, sp);
    let responses = bytes.alloc(340); let respLen = wrap(responses, 0, 0x30, sr, srLen);

    let kh = bytes.alloc(24); let khLen = wrap(kh, 0, 0x04, keyHash20, 20);
    let rid = bytes.alloc(28); let ridLen = wrap(rid, 0, 0xa2, kh, khLen);
    let pa = bytes.alloc(20); let paLen = wrap(pa, 0, 0x18, time15, 15);

    let tbsBody = bytes.alloc(420); let tp = 0;
    tp = tp + cat(tbsBody, tp, rid, ridLen);
    tp = tp + cat(tbsBody, tp, pa, paLen);
    tp = tp + cat(tbsBody, tp, responses, respLen);
    let tbs = bytes.alloc(460); let tbsLen = wrap(tbs, 0, 0x30, tbsBody, tp);

    let digest = bytes.alloc(32); sha256.hashInto(tbs, tbsLen, digest);
    let r = bytes.alloc(32); let s = bytes.alloc(32); p256.ecdsaSign(digest, key32, r, s);
    let sigVal = bytes.alloc(80); let sigValLen = encodeSig(r, s, sigVal);
    let bitBody = bytes.alloc(84); bytes.write_byte(bitBody, 0, 0x00); let bb = 1 + cat(bitBody, 1, sigVal, sigValLen);
    let sigBit = bytes.alloc(88); let sigBitLen = wrap(sigBit, 0, 0x03, bitBody, bb);

    let sigAlg = bytes.alloc(12);
    bytes.write_byte(sigAlg, 0, 0x30); bytes.write_byte(sigAlg, 1, 0x0a);
    bytes.write_byte(sigAlg, 2, 0x06); bytes.write_byte(sigAlg, 3, 0x08);
    bytes.write_byte(sigAlg, 4, 0x2a); bytes.write_byte(sigAlg, 5, 0x86); bytes.write_byte(sigAlg, 6, 0x48);
    bytes.write_byte(sigAlg, 7, 0xce); bytes.write_byte(sigAlg, 8, 0x3d); bytes.write_byte(sigAlg, 9, 0x04);
    bytes.write_byte(sigAlg, 10, 0x03); bytes.write_byte(sigAlg, 11, 0x02);

    let basicBody = bytes.alloc(600); let bp = 0;
    bp = bp + cat(basicBody, bp, tbs, tbsLen);
    bp = bp + cat(basicBody, bp, sigAlg, 12);
    bp = bp + cat(basicBody, bp, sigBit, sigBitLen);
    let basic = bytes.alloc(640); let basicLen = wrap(basic, 0, 0x30, basicBody, bp);

    let oid = bytes.alloc(11);
    bytes.write_byte(oid, 0, 0x06); bytes.write_byte(oid, 1, 0x09);
    bytes.write_byte(oid, 2, 0x2b); bytes.write_byte(oid, 3, 0x06); bytes.write_byte(oid, 4, 0x01);
    bytes.write_byte(oid, 5, 0x05); bytes.write_byte(oid, 6, 0x05); bytes.write_byte(oid, 7, 0x07);
    bytes.write_byte(oid, 8, 0x30); bytes.write_byte(oid, 9, 0x01); bytes.write_byte(oid, 10, 0x01);
    let oct = bytes.alloc(660); let octLen = wrap(oct, 0, 0x04, basic, basicLen);
    let rbBody = bytes.alloc(680); let rp = 0;
    rp = rp + cat(rbBody, rp, oid, 11);
    rp = rp + cat(rbBody, rp, oct, octLen);
    let rbSeq = bytes.alloc(700); let rbSeqLen = wrap(rbSeq, 0, 0x30, rbBody, rp);
    let rbCtx = bytes.alloc(720); let rbCtxLen = wrap(rbCtx, 0, 0xa0, rbSeq, rbSeqLen);

    let outBody = bytes.alloc(740); let op = 0;
    bytes.write_byte(outBody, op, 0x0a); bytes.write_byte(outBody, op + 1, 0x01); bytes.write_byte(outBody, op + 2, 0x00); op = op + 3;
    op = op + cat(outBody, op, rbCtx, rbCtxLen);
    return wrap(out, 0, 0x30, outBody, op);
}

/// Encodes an OCSP CertID SEQUENCE into `out` and returns its length.
///
/// The CertID is `{ hashAlgorithm, issuerNameHash, issuerKeyHash, serialNumber }`.
/// This writes the SHA-1 AlgorithmIdentifier (OID 1.3.14.3.2.26 with a NULL
/// parameters) followed by the two 20-byte hashes as OCTET STRINGs and the serial as
/// an INTEGER, then wraps the lot in a `0x30` SEQUENCE. It is the shared encoder used
/// by the test responder; the request side inlines the same shape in
/// [`buildOcspRequest`].
fn certIdDer(nameHash20: ptr, keyHash20: ptr, serial: ptr, serialLen: int, out: ptr): int {
    let algInner = bytes.alloc(11);
    bytes.write_byte(algInner, 0, 0x06); bytes.write_byte(algInner, 1, 0x05);
    bytes.write_byte(algInner, 2, 0x2b); bytes.write_byte(algInner, 3, 0x0e); bytes.write_byte(algInner, 4, 0x03);
    bytes.write_byte(algInner, 5, 0x02); bytes.write_byte(algInner, 6, 0x1a);
    bytes.write_byte(algInner, 7, 0x05); bytes.write_byte(algInner, 8, 0x00);
    let alg = bytes.alloc(16); let algLen = wrap(alg, 0, 0x30, algInner, 9);
    let body = bytes.alloc(128); let p = 0;
    p = p + cat(body, p, alg, algLen);
    let onh = bytes.alloc(24); let onhLen = wrap(onh, 0, 0x04, nameHash20, 20); p = p + cat(body, p, onh, onhLen);
    let okh = bytes.alloc(24); let okhLen = wrap(okh, 0, 0x04, keyHash20, 20); p = p + cat(body, p, okh, okhLen);
    let ser = bytes.alloc(serialLen + 4); let serLen = wrap(ser, 0, 0x02, serial, serialLen); p = p + cat(body, p, ser, serLen);
    return wrap(out, 0, 0x30, body, p);
}

/// Encodes two 32-byte scalars `r` and `s` as a DER ECDSA signature
/// `SEQUENCE { INTEGER r, INTEGER s }` into `out`, returning its length.
///
/// It writes the two INTEGERs first (starting at offset 2 to leave room for the
/// SEQUENCE header), each minimally encoded by [`encInt`], then back-fills the outer
/// `0x30` tag and the total length. This is the inverse of [`decodeSig`]. It assumes
/// the combined body fits a single-byte length, which always holds for P-256.
fn encodeSig(r: ptr, s: ptr, out: ptr): int {
    let rlen = encInt(r, out, 2);
    let slen = encInt(s, out, 2 + rlen);
    let total = rlen + slen;
    bytes.write_byte(out, 0, 0x30); bytes.write_byte(out, 1, total);
    return 2 + total;
}
/// Encodes one 32-byte big-endian scalar at `src` as a minimal DER INTEGER at
/// `out+off`, returning the total bytes written.
///
/// DER requires minimal-length integers, so it first skips leading zero bytes
/// (keeping at least one byte). It then adds a single `0x00` pad byte when the top
/// bit of the first significant byte is set, because a DER INTEGER is signed and the
/// pad keeps the value positive. The header (`0x02` tag plus one length byte) is
/// written, then the optional pad, then the significant bytes. This is the inverse
/// of [`intTo`].
fn encInt(src: ptr, out: ptr, off: int): int {
    let s = 0;
    while (s < 31 && bytes.read_byte(src, s) == 0) { s = s + 1; }
    let pad = 0;
    if ((bytes.read_byte(src, s) & 0x80) != 0) { pad = 1; }
    let vlen = 32 - s + pad;
    bytes.write_byte(out, off, 0x02); bytes.write_byte(out, off + 1, vlen);
    let p = off + 2;
    if (pad == 1) { bytes.write_byte(out, p, 0); p = p + 1; }
    let i = s;
    while (i < 32) { bytes.write_byte(out, p, bytes.read_byte(src, i)); p = p + 1; i = i + 1; }
    return p - off;
}
