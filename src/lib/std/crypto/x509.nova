import bytes;
import crypto.ecc.p256;
import crypto.rsa;
import crypto.hash.sha256;
import crypto.hash.sha512;

const SIG_ECDSA_SHA256: int = 0;
const SIG_ECDSA_SHA384: int = 1;
const SIG_ECDSA_SHA512: int = 2;
const SIG_RSA_SHA256: int = 3;
const SIG_RSA_SHA384: int = 4;
const SIG_RSA_SHA512: int = 5;
const SIG_RSA_PSS: int = 6;
const SIG_UNKNOWN: int = -1;

const KEY_RSA: int = 0;
const KEY_EC_P256: int = 1;
const KEY_UNKNOWN: int = -1;

fn ptrAt(buf: ptr, off: int): ptr { return (buf as long + off) as ptr; }

pub struct Tlv {
    pub tag: int,
    pub start: int,
    pub len: int,
    pub next: int,
}

pub fn readTlv(buf: ptr, pos: int): Tlv {
    let tag = bytes.read_byte(buf, pos);
    let p = pos + 1;
    let b = bytes.read_byte(buf, p);
    p = p + 1;
    let len = 0;
    if (b < 0x80) {
        len = b;
    } else {
        let nb = b & 0x7f;
        let i = 0;
        while (i < nb) { len = (len << 8) | bytes.read_byte(buf, p); p = p + 1; i = i + 1; }
    }
    return Tlv { tag: tag, start: p, len: len, next: p + len };
}

fn hexNibble(c: int): int {
    if (c >= 48 && c <= 57) { return c - 48; }
    return c - 87;
}
fn oidEq(buf: ptr, start: int, len: int, hex: string): bool {
    if (hex.length != len * 2) { return false; }
    let i = 0;
    while (i < len) {
        let want = hexNibble(hex[i * 2]) * 16 + hexNibble(hex[i * 2 + 1]);
        if (bytes.read_byte(buf, start + i) != want) { return false; }
        i = i + 1;
    }
    return true;
}

fn decodeSigOid(buf: ptr, start: int, len: int): int {
    if (oidEq(buf, start, len, "2a8648ce3d040302")) { return SIG_ECDSA_SHA256; }
    if (oidEq(buf, start, len, "2a8648ce3d040303")) { return SIG_ECDSA_SHA384; }
    if (oidEq(buf, start, len, "2a8648ce3d040304")) { return SIG_ECDSA_SHA512; }
    if (oidEq(buf, start, len, "2a864886f70d01010b")) { return SIG_RSA_SHA256; }
    if (oidEq(buf, start, len, "2a864886f70d01010c")) { return SIG_RSA_SHA384; }
    if (oidEq(buf, start, len, "2a864886f70d01010d")) { return SIG_RSA_SHA512; }
    if (oidEq(buf, start, len, "2a864886f70d01010a")) { return SIG_RSA_PSS; }
    return SIG_UNKNOWN;
}

struct Cert {
    pub buf: ptr,
    pub ok: bool,
    pub serialStart: int, pub serialLen: int,
    pub tbsStart: int, pub tbsLen: int,
    pub sigAlg: int,
    pub sigStart: int, pub sigLen: int,
    pub keyType: int,
    pub rsaNStart: int, pub rsaNLen: int,
    pub rsaEStart: int, pub rsaELen: int,
    pub ecStart: int, pub ecLen: int,
    pub subjectStart: int, pub subjectLen: int,
    pub issuerStart: int, pub issuerLen: int,
    pub nbStart: int, pub nbLen: int, pub nbTag: int,
    pub naStart: int, pub naLen: int, pub naTag: int,
    pub isCa: bool,
    pub sanStart: int, pub sanLen: int,
}

pub fn parseCert(buf: ptr, len: int): Cert {
    let bad = Cert { buf: buf, ok: false, serialStart: 0, serialLen: 0,
        tbsStart: 0, tbsLen: 0, sigAlg: SIG_UNKNOWN, sigStart: 0, sigLen: 0,
        keyType: KEY_UNKNOWN, rsaNStart: 0, rsaNLen: 0, rsaEStart: 0, rsaELen: 0,
        ecStart: 0, ecLen: 0, subjectStart: 0, subjectLen: 0, issuerStart: 0, issuerLen: 0,
        nbStart: 0, nbLen: 0, nbTag: 0, naStart: 0, naLen: 0, naTag: 0, isCa: false, sanStart: 0, sanLen: 0 };

    let cert = readTlv(buf, 0);
    if (cert.tag != 0x30) { return bad; }
    let tbs = readTlv(buf, cert.start);
    if (tbs.tag != 0x30) { return bad; }
    let tbsStart = cert.start;
    let tbsLen = tbs.next - cert.start;

    let q = tbs.start;
    let f = readTlv(buf, q);
    if (f.tag == 0xa0) { q = f.next; }
    let serial = readTlv(buf, q); q = serial.next;
    let serialStart = serial.start; let serialLen = serial.len;
    let innerSig = readTlv(buf, q); q = innerSig.next;
    let issuer = readTlv(buf, q);
    let issuerStart = q; let issuerLen = issuer.next - q; q = issuer.next;
    let validity = readTlv(buf, q);
    let nb = readTlv(buf, validity.start);
    let na = readTlv(buf, nb.next);
    q = validity.next;
    let subject = readTlv(buf, q);
    let subjectStart = q; let subjectLen = subject.next - q; q = subject.next;
    let spki = readTlv(buf, q);

    let algSeq = readTlv(buf, spki.start);
    let algOid = readTlv(buf, algSeq.start);
    let spkBit = readTlv(buf, algSeq.next);

    let keyType = KEY_UNKNOWN;
    let rsaNStart = 0; let rsaNLen = 0; let rsaEStart = 0; let rsaELen = 0;
    let ecStart = 0; let ecLen = 0;
    if (oidEq(buf, algOid.start, algOid.len, "2a8648ce3d0201")) {
        keyType = KEY_EC_P256;
        ecStart = spkBit.start + 1;
        ecLen = spkBit.len - 1;
    } else if (oidEq(buf, algOid.start, algOid.len, "2a864886f70d010101")) {
        keyType = KEY_RSA;
        let rsaSeq = readTlv(buf, spkBit.start + 1);
        let modInt = readTlv(buf, rsaSeq.start);
        let ms = modInt.start; let ml = modInt.len;
        if (bytes.read_byte(buf, ms) == 0) { ms = ms + 1; ml = ml - 1; }
        rsaNStart = ms; rsaNLen = ml;
        let expInt = readTlv(buf, modInt.next);
        rsaEStart = expInt.start; rsaELen = expInt.len;
    }

    let isCa = false;
    let sanStart = 0; let sanLen = 0;
    q = spki.next;
    if (q < tbs.next) {
        let ex = readTlv(buf, q);
        if (ex.tag == 0xa3) {
            let extSeq = readTlv(buf, ex.start);
            let ep = extSeq.start;
            let extEnd = extSeq.start + extSeq.len;
            while (ep < extEnd) {
                let one = readTlv(buf, ep);
                let oid = readTlv(buf, one.start);
                let vpos = oid.next;
                let maybe = readTlv(buf, vpos);
                if (maybe.tag == 0x01) { vpos = maybe.next; }
                let val = readTlv(buf, vpos);
                if (oidEq(buf, oid.start, oid.len, "551d13")) {
                    let bcSeq = readTlv(buf, val.start);
                    if (bcSeq.len > 0) {
                        let caFlag = readTlv(buf, bcSeq.start);
                        if (caFlag.tag == 0x01 && bytes.read_byte(buf, caFlag.start) != 0) { isCa = true; }
                    }
                } else if (oidEq(buf, oid.start, oid.len, "551d11")) {
                    let san = readTlv(buf, val.start);
                    sanStart = san.start; sanLen = san.len;
                }
                ep = one.next;
            }
        }
    }

    let sigAlgSeq = readTlv(buf, tbs.next);
    let sigOid = readTlv(buf, sigAlgSeq.start);
    let sigAlg = decodeSigOid(buf, sigOid.start, sigOid.len);
    let sigVal = readTlv(buf, sigAlgSeq.next);
    let sigStart = sigVal.start + 1;
    let sigLen = sigVal.len - 1;

    return Cert { buf: buf, ok: true, serialStart: serialStart, serialLen: serialLen,
        tbsStart: tbsStart, tbsLen: tbsLen, sigAlg: sigAlg, sigStart: sigStart, sigLen: sigLen,
        keyType: keyType, rsaNStart: rsaNStart, rsaNLen: rsaNLen, rsaEStart: rsaEStart, rsaELen: rsaELen,
        ecStart: ecStart, ecLen: ecLen, subjectStart: subjectStart, subjectLen: subjectLen,
        issuerStart: issuerStart, issuerLen: issuerLen,
        nbStart: nb.start, nbLen: nb.len, nbTag: nb.tag, naStart: na.start, naLen: na.len, naTag: na.tag,
        isCa: isCa, sanStart: sanStart, sanLen: sanLen };
}

fn hashIdOf(sigAlg: int): int {
    if (sigAlg == SIG_ECDSA_SHA384 || sigAlg == SIG_RSA_SHA384) { return 1; }
    if (sigAlg == SIG_ECDSA_SHA512 || sigAlg == SIG_RSA_SHA512) { return 2; }
    return 0;
}
fn hLenOf(hid: int): int {
    if (hid == 1) { return 48; }
    if (hid == 2) { return 64; }
    return 32;
}
fn doHash(hid: int, data: ptr, len: int, out: ptr): void {
    if (hid == 0) { sha256.hashInto(data, len, out); return; }
    if (hid == 1) { sha512.hash384Into(data, len, out); return; }
    sha512.hashInto(data, len, out);
}

fn derIntTo(buf: ptr, start: int, len: int, out: ptr, outLen: int): void {
    let s = start; let l = len;
    while (l > 0 && bytes.read_byte(buf, s) == 0) { s = s + 1; l = l - 1; }
    let i = 0;
    while (i < outLen) { bytes.write_byte(out, i, 0); i = i + 1; }
    let pad = outLen - l;
    i = 0;
    while (i < l) { bytes.write_byte(out, pad + i, bytes.read_byte(buf, s + i)); i = i + 1; }
}

pub fn verifySignedBy(child: Cert, issuer: Cert): bool {
    if (!child.ok || !issuer.ok || child.sigAlg == SIG_UNKNOWN) { return false; }
    let hid = hashIdOf(child.sigAlg);
    let hl = hLenOf(hid);
    let digest = bytes.alloc(hl);
    doHash(hid, ptrAt(child.buf, child.tbsStart), child.tbsLen, digest);

    let ok = false;
    if (child.sigAlg <= SIG_ECDSA_SHA512) {
        if (issuer.keyType == KEY_EC_P256) {
            let seq = readTlv(child.buf, child.sigStart);
            let rInt = readTlv(child.buf, seq.start);
            let sInt = readTlv(child.buf, rInt.next);
            let r = bytes.alloc(32); let s = bytes.alloc(32);
            derIntTo(child.buf, rInt.start, rInt.len, r, 32);
            derIntTo(child.buf, sInt.start, sInt.len, s, 32);
            let e = bytes.alloc(32);
            let i = 0;
            while (i < 32) {
                if (i < hl) { bytes.write_byte(e, i, bytes.read_byte(digest, i)); }
                else { bytes.write_byte(e, i, 0); }
                i = i + 1;
            }
            ok = p256.ecdsaVerify(e, ptrAt(issuer.buf, issuer.ecStart), r, s);
            bytes.free(r); bytes.free(s); bytes.free(e);
        }
    } else if (child.sigAlg <= SIG_RSA_SHA512) {
        if (issuer.keyType == KEY_RSA) {
            ok = rsa.verifyPkcs1(hid, digest, ptrAt(child.buf, child.sigStart), child.sigLen,
                ptrAt(issuer.buf, issuer.rsaNStart), issuer.rsaNLen,
                ptrAt(issuer.buf, issuer.rsaEStart), issuer.rsaELen);
        }
    } else {
        if (issuer.keyType == KEY_RSA) {
            ok = rsa.verifyPss(hid, digest, ptrAt(child.buf, child.sigStart), child.sigLen,
                ptrAt(issuer.buf, issuer.rsaNStart), issuer.rsaNLen,
                ptrAt(issuer.buf, issuer.rsaEStart), issuer.rsaELen);
        }
    }
    bytes.free(digest);
    return ok;
}

pub fn nameMatches(child: Cert, issuer: Cert): bool {
    if (child.issuerLen != issuer.subjectLen) { return false; }
    let i = 0;
    while (i < child.issuerLen) {
        if (bytes.read_byte(child.buf, child.issuerStart + i)
            != bytes.read_byte(issuer.buf, issuer.subjectStart + i)) { return false; }
        i = i + 1;
    }
    return true;
}


fn digit2(buf: ptr, p: int): long {
    return ((bytes.read_byte(buf, p) - 48) * 10 + (bytes.read_byte(buf, p + 1) - 48)) as long;
}

fn timeToNum(buf: ptr, start: int, tag: int): long {
    let yyyy: long = 0;
    let off = start;
    if (tag == 0x18) {
        yyyy = digit2(buf, start) * 100 + digit2(buf, start + 2);
        off = start + 4;
    } else {
        let yy = digit2(buf, start);
        if (yy >= 50) { yyyy = 1900 + yy; } else { yyyy = 2000 + yy; }
        off = start + 2;
    }
    let mo = digit2(buf, off);
    let da = digit2(buf, off + 2);
    let hh = digit2(buf, off + 4);
    let mi = digit2(buf, off + 6);
    let ss = digit2(buf, off + 8);
    return ((((yyyy * 100 + mo) * 100 + da) * 100 + hh) * 100 + mi) * 100 + ss;
}

pub fn checkValidity(cert: Cert, now: long): bool {
    let nb = timeToNum(cert.buf, cert.nbStart, cert.nbTag);
    let na = timeToNum(cert.buf, cert.naStart, cert.naTag);
    return nb <= now && now <= na;
}

pub fn isCA(cert: Cert): bool { return cert.isCa; }

fn lower(c: int): int { if (c >= 65 && c <= 90) { return c + 32; } return c; }

fn ciEqual(buf: ptr, bstart: int, blen: int, host: string, hstart: int, hlen: int): bool {
    if (blen != hlen) { return false; }
    let i = 0;
    while (i < blen) {
        if (lower(bytes.read_byte(buf, bstart + i)) != lower(host[hstart + i])) { return false; }
        i = i + 1;
    }
    return true;
}

fn dnsMatch(buf: ptr, start: int, len: int, host: string): bool {
    if (len >= 2 && bytes.read_byte(buf, start) == 42 && bytes.read_byte(buf, start + 1) == 46) {
        let hi = 0;
        while (hi < host.length && host[hi] != 46) { hi = hi + 1; }
        if (hi <= 0 || hi >= host.length) { return false; }
        return ciEqual(buf, start + 2, len - 2, host, hi + 1, host.length - (hi + 1));
    }
    return ciEqual(buf, start, len, host, 0, host.length);
}

pub fn matchHostname(cert: Cert, host: string): bool {
    let p = cert.sanStart;
    let end = cert.sanStart + cert.sanLen;
    while (p < end) {
        let gn = readTlv(cert.buf, p);
        if (gn.tag == 0x82) {
            if (dnsMatch(cert.buf, gn.start, gn.len, host)) { return true; }
        }
        p = gn.next;
    }
    return false;
}

pub fn verifyLink(child: Cert, issuer: Cert, now: long): bool {
    return child.ok && issuer.ok && issuer.isCa
        && nameMatches(child, issuer)
        && checkValidity(child, now) && checkValidity(issuer, now)
        && verifySignedBy(child, issuer);
}

pub fn verifyChain2(leaf: Cert, root: Cert, host: string, now: long): bool {
    return verifyLink(leaf, root, now)
        && verifySignedBy(root, root)
        && matchHostname(leaf, host);
}

pub fn verifyChain3(leaf: Cert, inter: Cert, root: Cert, host: string, now: long): bool {
    return verifyLink(leaf, inter, now)
        && verifyLink(inter, root, now)
        && verifySignedBy(root, root)
        && matchHostname(leaf, host);
}

fn rd3(buf: ptr, p: int): int {
    return (bytes.read_byte(buf, p) << 16) | (bytes.read_byte(buf, p + 1) << 8) | bytes.read_byte(buf, p + 2);
}

pub fn verifyCertList(list: ptr, listLen: int, rootDer: ptr, rootLen: int, host: string, now: long): bool {
    if (listLen < 3) { return false; }
    let c0len = rd3(list, 0);
    let leaf = parseCert((list as long + 3) as ptr, c0len);
    let p = 3 + c0len;
    let ext0 = (bytes.read_byte(list, p) << 8) | bytes.read_byte(list, p + 1);
    p = p + 2 + ext0;
    let root = parseCert(rootDer, rootLen);
    if (p + 3 > listLen) {
        return verifyChain2(leaf, root, host, now);
    }
    let c1len = rd3(list, p);
    let inter = parseCert((list as long + (p + 3) as long) as ptr, c1len);
    return verifyChain3(leaf, inter, root, host, now);
}

pub fn verifyCertList12(list: ptr, listLen: int, rootDer: ptr, rootLen: int, host: string, now: long): bool {
    if (listLen < 3) { return false; }
    let c0len = rd3(list, 0);
    let leaf = parseCert((list as long + 3) as ptr, c0len);
    let p = 3 + c0len;
    let root = parseCert(rootDer, rootLen);
    if (p + 3 > listLen) {
        return verifyChain2(leaf, root, host, now);
    }
    let c1len = rd3(list, p);
    let inter = parseCert((list as long + (p + 3) as long) as ptr, c1len);
    return verifyChain3(leaf, inter, root, host, now);
}

pub fn isEcKey(cert: Cert): bool { return cert.keyType == KEY_EC_P256; }

pub fn leafCert(list: ptr, listLen: int): Cert {
    if (listLen < 3) { return parseCert(list, 0); }
    let c0len = rd3(list, 0);
    return parseCert((list as long + 3) as ptr, c0len);
}
pub fn interCert13(list: ptr, listLen: int): Cert {
    if (listLen < 3) { return parseCert(list, 0); }
    let c0len = rd3(list, 0);
    let p = 3 + c0len;
    let ext0 = (bytes.read_byte(list, p) << 8) | bytes.read_byte(list, p + 1);
    p = p + 2 + ext0;
    if (p + 3 > listLen) { return parseCert(list, 0); }
    let c1len = rd3(list, p);
    return parseCert((list as long + (p + 3) as long) as ptr, c1len);
}
pub fn interCert12(list: ptr, listLen: int): Cert {
    if (listLen < 3) { return parseCert(list, 0); }
    let c0len = rd3(list, 0);
    let p = 3 + c0len;
    if (p + 3 > listLen) { return parseCert(list, 0); }
    let c1len = rd3(list, p);
    return parseCert((list as long + (p + 3) as long) as ptr, c1len);
}
