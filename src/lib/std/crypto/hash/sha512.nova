// SHA-512 and SHA-384 (FIPS 180-4) implemented in Nova, no external library (M9 phase A). SHA-384 is
// SHA-512 with a different initial value and a 48-byte truncated output. Words are `ulong` (u64), which
// wraps at 2^64 on add and shifts logically on `>>`, so no masking is needed. SHA-384 backs the TLS 1.3
// SHA-384 cipher suites and their transcript hash.
//
// Reference: Zig std.crypto sha2. Verified against NIST known-answer vectors (conformance case 216).
import bytes;
import mem.allocator;

// Integrated-assembly fast path (src/runtime/nova_crypto_arm64.S): on an aarch64 host with FEAT_SHA512 the
// block compression uses the ARMv8.2 SHA-512 instructions (SHA512H/H2/SU0/SU1), far above the software round
// loop. The 8-word state `h` (big-endian) is passed straight through; the asm byteswaps it. Plain extern, no
// FFI. Byte-identical to the software path (KAT 216 + differential fuzz).
extern("c") fn nova_has_asm_crypto(): int;
extern("c") fn nova_sha512_blocks(state: ptr, data: ptr, blocks: int): void;

// Round constants: first 64 bits of the fractional parts of the cube roots of the first 80 primes.
const K512: ulong[80] = [
    0x428a2f98d728ae22, 0x7137449123ef65cd, 0xb5c0fbcfec4d3b2f, 0xe9b5dba58189dbbc,
    0x3956c25bf348b538, 0x59f111f1b605d019, 0x923f82a4af194f9b, 0xab1c5ed5da6d8118,
    0xd807aa98a3030242, 0x12835b0145706fbe, 0x243185be4ee4b28c, 0x550c7dc3d5ffb4e2,
    0x72be5d74f27b896f, 0x80deb1fe3b1696b1, 0x9bdc06a725c71235, 0xc19bf174cf692694,
    0xe49b69c19ef14ad2, 0xefbe4786384f25e3, 0x0fc19dc68b8cd5b5, 0x240ca1cc77ac9c65,
    0x2de92c6f592b0275, 0x4a7484aa6ea6e483, 0x5cb0a9dcbd41fbd4, 0x76f988da831153b5,
    0x983e5152ee66dfab, 0xa831c66d2db43210, 0xb00327c898fb213f, 0xbf597fc7beef0ee4,
    0xc6e00bf33da88fc2, 0xd5a79147930aa725, 0x06ca6351e003826f, 0x142929670a0e6e70,
    0x27b70a8546d22ffc, 0x2e1b21385c26c926, 0x4d2c6dfc5ac42aed, 0x53380d139d95b3df,
    0x650a73548baf63de, 0x766a0abb3c77b2a8, 0x81c2c92e47edaee6, 0x92722c851482353b,
    0xa2bfe8a14cf10364, 0xa81a664bbc423001, 0xc24b8b70d0f89791, 0xc76c51a30654be30,
    0xd192e819d6ef5218, 0xd69906245565a910, 0xf40e35855771202a, 0x106aa07032bbd1b8,
    0x19a4c116b8d2d0c8, 0x1e376c085141ab53, 0x2748774cdf8eeb99, 0x34b0bcb5e19b48a8,
    0x391c0cb3c5c95a63, 0x4ed8aa4ae3418acb, 0x5b9cca4f7763e373, 0x682e6ff3d6b2b8a3,
    0x748f82ee5defb2fc, 0x78a5636f43172f60, 0x84c87814a1f0ab72, 0x8cc702081a6439ec,
    0x90befffa23631e28, 0xa4506cebde82bde9, 0xbef9a3f7b2c67915, 0xc67178f2e372532b,
    0xca273eceea26619c, 0xd186b8c721c0c207, 0xeada7dd6cde0eb1e, 0xf57d4f7fee6ed178,
    0x06f067aa72176fba, 0x0a637dc5a2c898a6, 0x113f9804bef90dae, 0x1b710b35131c471b,
    0x28db77f523047d84, 0x32caab7b40c72493, 0x3c9ebe0a15c9bebc, 0x431d67c49c100d4c,
    0x4cc5d4becb3e42b6, 0x597f299cfc657e2a, 0x5fcb6fab3ad6faec, 0x6c44198c4a475817,
];

const IV512: ulong[8] = [
    0x6a09e667f3bcc908, 0xbb67ae8584caa73b, 0x3c6ef372fe94f82b, 0xa54ff53a5f1d36f1,
    0x510e527fade682d1, 0x9b05688c2b3e6c1f, 0x1f83d9abfb41bd6b, 0x5be0cd19137e2179,
];

const IV384: ulong[8] = [
    0xcbbb9d5dc1059ed8, 0x629a292a367cd507, 0x9159015a3070dd17, 0x152fecd8f70e5939,
    0x67332667ffc00b31, 0x8eb44a8768581511, 0xdb0c2e0d64f98fa7, 0x47b5481dbefa4fa4,
];

pub const SHA512_DIGEST_LEN: int = 64;
pub const SHA384_DIGEST_LEN: int = 48;
pub const SHA512_BLOCK_LEN: int = 128;

fn rotr(x: ulong, n: int): ulong {
    return (x >> n) | (x << (64 - n));
}

// Read 8 big-endian bytes at buf+off as a 64-bit word.
fn beWord(buf: ptr, off: int): ulong {
    let v: ulong = 0;
    let i = 0;
    while (i < 8) {
        v = (v << 8) | (bytes.read_byte(buf, off + i) as ulong);
        i = i + 1;
    }
    return v;
}

// Write a 64-bit word big-endian to out+off.
fn putWord(out: ptr, off: int, w: ulong): void {
    let i = 0;
    while (i < 8) {
        bytes.write_byte(out, off + i, ((w >> ((7 - i) * 8)) & 0xff) as int);
        i = i + 1;
    }
}

// Incremental SHA-512 / SHA-384. The `is384` flag only picks the initial value and the output length;
// the compression function is identical.
pub struct Sha512 {
    pub h: ptr,        // 8 words, 64 bytes
    pub block: ptr,    // 128-byte pending block
    pub blockLen: int,
    pub total: long,
    pub is384: bool,

    pub fn create(is384: bool): Sha512 {
        let s = bytes.new_with_allocator<Sha512>(allocator.globalAllocator());
        s.h = bytes.alloc(8 * 8);
        s.block = bytes.alloc(SHA512_BLOCK_LEN);
        s.is384 = is384;
        s.reset();
        return s;
    }

    pub fn reset(self: Sha512): void {
        let i = 0;
        while (i < 8) {
            putWord(self.h, i * 8, if (self.is384) IV384[i] else IV512[i]);
            i = i + 1;
        }
        self.blockLen = 0;
        self.total = 0;
    }

    fn compress(self: Sha512, buf: ptr, off: int): void {
        let w = bytes.alloc(80 * 8);
        let t = 0;
        while (t < 16) {
            putWord(w, t * 8, beWord(buf, off + t * 8));
            t = t + 1;
        }
        while (t < 80) {
            let w15 = beWord(w, (t - 15) * 8);
            let w2 = beWord(w, (t - 2) * 8);
            let s0 = rotr(w15, 1) ^ rotr(w15, 8) ^ (w15 >> 7);
            let s1 = rotr(w2, 19) ^ rotr(w2, 61) ^ (w2 >> 6);
            let val = beWord(w, (t - 16) * 8) + s0 + beWord(w, (t - 7) * 8) + s1;
            putWord(w, t * 8, val);
            t = t + 1;
        }

        let a = beWord(self.h, 0);
        let b = beWord(self.h, 8);
        let c = beWord(self.h, 16);
        let d = beWord(self.h, 24);
        let e = beWord(self.h, 32);
        let f = beWord(self.h, 40);
        let g = beWord(self.h, 48);
        let hh = beWord(self.h, 56);

        t = 0;
        while (t < 80) {
            let bigS1 = rotr(e, 14) ^ rotr(e, 18) ^ rotr(e, 41);
            let ch = (e & f) ^ ((~e) & g);
            let temp1 = hh + bigS1 + ch + K512[t] + beWord(w, t * 8);
            let bigS0 = rotr(a, 28) ^ rotr(a, 34) ^ rotr(a, 39);
            let maj = (a & b) ^ (a & c) ^ (b & c);
            let temp2 = bigS0 + maj;
            hh = g;
            g = f;
            f = e;
            e = d + temp1;
            d = c;
            c = b;
            b = a;
            a = temp1 + temp2;
            t = t + 1;
        }

        putWord(self.h, 0, beWord(self.h, 0) + a);
        putWord(self.h, 8, beWord(self.h, 8) + b);
        putWord(self.h, 16, beWord(self.h, 16) + c);
        putWord(self.h, 24, beWord(self.h, 24) + d);
        putWord(self.h, 32, beWord(self.h, 32) + e);
        putWord(self.h, 40, beWord(self.h, 40) + f);
        putWord(self.h, 48, beWord(self.h, 48) + g);
        putWord(self.h, 56, beWord(self.h, 56) + hh);
        bytes.free(w);
    }

    pub fn update(self: Sha512, data: ptr, len: int): void {
        self.total = self.total + (len as long);
        let i = 0;
        if (self.blockLen > 0) {
            while (i < len && self.blockLen < SHA512_BLOCK_LEN) {
                bytes.write_byte(self.block, self.blockLen, bytes.read_byte(data, i));
                self.blockLen = self.blockLen + 1;
                i = i + 1;
            }
            if (self.blockLen == SHA512_BLOCK_LEN) {
                self.compress(self.block, 0);
                self.blockLen = 0;
            }
        }
        let nb = (len - i) / SHA512_BLOCK_LEN;
        if (nb > 0 && nova_has_asm_crypto() == 1) {
            nova_sha512_blocks(self.h, (data as long + i) as ptr, nb);
            i = i + nb * SHA512_BLOCK_LEN;
        }
        while (len - i >= SHA512_BLOCK_LEN) {
            self.compress(data, i);
            i = i + SHA512_BLOCK_LEN;
        }
        while (i < len) {
            bytes.write_byte(self.block, self.blockLen, bytes.read_byte(data, i));
            self.blockLen = self.blockLen + 1;
            i = i + 1;
        }
    }

    // Write the digest (64 bytes for SHA-512, 48 for SHA-384) to out.
    pub fn final(self: Sha512, out: ptr): void {
        let bitLen = self.total * 8;
        let pad = bytes.alloc(SHA512_BLOCK_LEN * 2);
        let n = 0;
        bytes.write_byte(pad, n, 0x80);
        n = n + 1;
        // Pad so (blockLen + n + 16) is a multiple of 128; the length field is 128 bits.
        while (((self.blockLen + n + 16) % SHA512_BLOCK_LEN) != 0) {
            bytes.write_byte(pad, n, 0);
            n = n + 1;
        }
        // High 64 bits of the length are zero for any message we handle; low 64 bits big-endian.
        let j = 0;
        while (j < 8) {
            bytes.write_byte(pad, n + j, 0);
            j = j + 1;
        }
        j = 0;
        while (j < 8) {
            bytes.write_byte(pad, n + 8 + j, ((bitLen >> ((7 - j) * 8)) & 0xff) as int);
            j = j + 1;
        }
        n = n + 16;
        self.update(pad, n);

        let words = if (self.is384) 6 else 8;
        let i = 0;
        while (i < words) {
            putWord(out, i * 8, beWord(self.h, i * 8));
            i = i + 1;
        }
        bytes.free(pad);
    }

    pub fn delete(self: Sha512): void {
        if (self.h != 0) {
            bytes.free(self.h);
            self.h = 0;
        }
        if (self.block != 0) {
            bytes.free(self.block);
            self.block = 0;
        }
    }
}

// One-shot SHA-512 of len bytes at data, writing 64 bytes to out.
pub fn hashInto(data: ptr, len: int, out: ptr): void {
    let s = Sha512.create(false);
    s.update(data, len);
    s.final(out);
    s.delete();
}

// One-shot SHA-384 of len bytes at data, writing 48 bytes to out.
pub fn hash384Into(data: ptr, len: int, out: ptr): void {
    let s = Sha512.create(true);
    s.update(data, len);
    s.final(out);
    s.delete();
}
