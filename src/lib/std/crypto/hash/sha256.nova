//! SHA-256 (FIPS 180-4) message digest.
//!
//! This file is the pure-Nova reference implementation of SHA-256: the
//! 256-bit member of the SHA-2 family. It exposes an incremental,
//! streaming API ([`Sha256`]) plus a one-shot convenience wrapper
//! ([`hashInto`]). It is the hash Nova reaches for by default in the rest of
//! the crypto stack: HMAC-SHA256, PBKDF2, SCRAM authentication in the DB
//! drivers, and the TLS 1.3 transcript hash all layer on top of it.
//!
//! WHY a hand-written block loop instead of just calling into C. SHA-256 is
//! specified on 32-bit machine words with modular arithmetic, but Nova's `int`
//! is a signed 32-bit type whose overflow and shift behaviour would not match
//! the spec once the sign bit is involved. So every word here is carried in a
//! 64-bit `long` and masked back to 32 bits after each operation with
//! [`MASK32`]. That masking is not decorative: it is what keeps the additions,
//! rotations and shifts congruent to the unsigned 32-bit arithmetic the
//! standard mandates. Skipping a mask silently lets high bits leak into the
//! next step and corrupts the digest.
//!
//! Design and layout decisions worth knowing:
//!
//!   1. State lives in RAW BYTE BUFFERS, not in a `long[8]` field. The eight
//!      working hash words are held big-endian inside a heap block ([`Sha256.h`])
//!      and read back through [`beWord`] whenever they are needed. Keeping the
//!      canonical form as bytes means the assembly fast path and the final
//!      digest output see exactly the same memory layout with no conversion.
//!   2. There is an OPTIONAL assembly fast path. When the runtime reports
//!      hardware SHA support via [`nova_has_asm_crypto`], full 64-byte blocks are
//!      compressed in bulk by [`nova_sha256_blocks`], and only the leftover tail
//!      goes through the pure-Nova [`Sha256.compress`]. Both paths update the
//!      same `h` buffer, so they are byte-for-byte interchangeable.
//!   3. [`Sha256`] is a heap object with an explicit [`Sha256.delete`]. It owns
//!      two allocations (`h` and `block`) that must be freed by the caller; it is
//!      not a value struct and does not clean itself up.
//!
//! The digest is 32 bytes ([`SHA256_DIGEST_LEN`]) and the compression block is
//! 64 bytes ([`SHA256_BLOCK_LEN`]). Callers hand in raw pointers and lengths,
//! so this module does no allocation on behalf of the input and never assumes
//! the input is a Nova `string`.

import bytes;
import mem.allocator;

/// Runtime probe: returns 1 when the host CPU exposes a hardware SHA-256
/// acceleration path that [`nova_sha256_blocks`] can use, 0 otherwise.
///
/// Implemented in the C++ runtime. [`Sha256.update`] calls this once per bulk
/// run so it can route whole blocks through the assembly compressor when the
/// hardware supports it, and fall back to the pure-Nova loop when it does not.
extern("c") fn nova_has_asm_crypto(): int;
/// Compresses `blocks` consecutive 64-byte message blocks starting at `data`
/// into the running state at `state`, using the CPU's hardware SHA extensions.
///
/// This is the assembly fast path. `state` points at the same eight-word,
/// big-endian buffer that [`Sha256.h`] holds, and it is updated in place, so
/// after the call the state is identical to what [`Sha256.compress`] would have
/// produced for the same input. Only ever invoked when [`nova_has_asm_crypto`]
/// returned 1.
extern("c") fn nova_sha256_blocks(state: ptr, data: ptr, blocks: int): void;

/// Low 32-bit mask (`0xffffffff`) used to fold every arithmetic result back
/// into an unsigned 32-bit word.
///
/// Words are carried in 64-bit `long`s because Nova's `int` is signed 32-bit
/// and would not reproduce the modular, unsigned semantics SHA-256 requires.
/// After every add, rotate or shift, `& MASK32` discards the high 32 bits so
/// the value stays congruent to the standard's 32-bit arithmetic.
const MASK32: long = 0xffffffff;

/// The 64 SHA-256 round constants, one per compression round.
///
/// Each is the first 32 bits of the fractional part of the cube root of the
/// first 64 prime numbers, as fixed by FIPS 180-4. [`Sha256.compress`] adds
/// `K256[t]` into the working word at round `t`; these values are what tie the
/// algorithm to the standard and must not be altered.
const K256: long[64] = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
];

/// The eight initial hash words (the SHA-256 initialisation vector).
///
/// Each is the first 32 bits of the fractional part of the square root of the
/// first eight primes, as fixed by FIPS 180-4. [`Sha256.reset`] writes these
/// into the state buffer big-endian to start (or restart) a digest.
const IV256: long[8] = [
    0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,
];

/// Length in bytes of a SHA-256 digest (32 bytes, 256 bits).
///
/// The `out` buffer passed to [`Sha256.final`] and [`hashInto`] must have room
/// for exactly this many bytes.
pub const SHA256_DIGEST_LEN: int = 32;
/// Length in bytes of one SHA-256 compression block (64 bytes, 512 bits).
///
/// Input is buffered up to this size in [`Sha256.block`] before a block is
/// compressed, and the padding scheme in [`Sha256.final`] is defined relative
/// to it.
pub const SHA256_BLOCK_LEN: int = 64;

/// Rotates the low 32 bits of `x` right by `n` bit positions.
///
/// A right rotation is a right shift where the bits that fall off the bottom
/// re-enter at the top, so `(x >> n) | (x << (32 - n))`. The trailing
/// `& MASK32` is essential: the left half can push bits above bit 31 and they
/// must be dropped to keep the result a clean 32-bit word. This is the `ROTR`
/// primitive the SHA-256 sigma functions are built from.
fn rotr(x: long, n: int): long {
    return ((x >> n) | (x << (32 - n))) & MASK32;
}

/// Reads four bytes at `buf + off` as a big-endian (most significant byte
/// first) 32-bit word.
///
/// SHA-256 defines its message schedule and state in big-endian order, so this
/// is the canonical way words are pulled out of the byte buffers ([`Sha256.h`],
/// the message schedule, and the raw input). The result is masked to 32 bits so
/// callers can feed it straight into the modular arithmetic. Paired with
/// [`putWord`], which writes the same layout back.
fn beWord(buf: ptr, off: int): long {
    return (((bytes.read_byte(buf, off) as long) << 24)
        | ((bytes.read_byte(buf, off + 1) as long) << 16)
        | ((bytes.read_byte(buf, off + 2) as long) << 8)
        | (bytes.read_byte(buf, off + 3) as long)) & MASK32;
}

/// Writes the low 32 bits of `w` to `out + off` as four big-endian bytes.
///
/// The inverse of [`beWord`]. Used to store schedule words, updated state words,
/// and the final digest, always in the big-endian order SHA-256 mandates. Only
/// the low 32 bits are emitted; any high bits in `w` are ignored.
fn putWord(out: ptr, off: int, w: long): void {
    bytes.write_byte(out, off, ((w >> 24) & 0xff) as int);
    bytes.write_byte(out, off + 1, ((w >> 16) & 0xff) as int);
    bytes.write_byte(out, off + 2, ((w >> 8) & 0xff) as int);
    bytes.write_byte(out, off + 3, (w & 0xff) as int);
}

/// Incremental SHA-256 hasher: feed it bytes with [`Sha256.update`] as many
/// times as you like, then read the 32-byte digest with [`Sha256.final`].
///
/// This is a HEAP object, not a value struct. It owns two allocations ([`h`]
/// and [`block`]) and does not free itself, so every instance from
/// [`Sha256.create`] must be released with [`Sha256.delete`] once done. Calling
/// [`Sha256.reset`] lets a single instance be reused for a fresh message
/// without reallocating.
///
/// The object is single-threaded and stateful: do not share one instance across
/// concurrent updates.
pub struct Sha256 {
    /// The eight running hash words, stored big-endian in a 32-byte heap block.
    ///
    /// This is the canonical digest state. It is read and written through
    /// [`beWord`] / [`putWord`], and the assembly path [`nova_sha256_blocks`]
    /// updates the very same bytes, so the two compression paths stay
    /// interchangeable.
    pub h: ptr,
    /// A 64-byte staging buffer holding a partial compression block: input
    /// bytes that have arrived but do not yet complete a full
    /// [`SHA256_BLOCK_LEN`] block.
    pub block: ptr,
    /// Number of valid bytes currently buffered in [`block`] (0 to 63).
    ///
    /// Once this reaches [`SHA256_BLOCK_LEN`] the block is compressed and the
    /// counter resets to 0. [`Sha256.final`] uses it to place the padding.
    pub blockLen: int,
    /// Running total of message bytes fed in so far, across all
    /// [`Sha256.update`] calls.
    ///
    /// Held as a `long` so long messages do not overflow, and multiplied by 8
    /// in [`Sha256.final`] to form the 64-bit bit-length that SHA-256 appends as
    /// the last eight padding bytes.
    pub total: long,

    /// Allocates a fresh hasher, initialises its state to [`IV256`], and returns
    /// it ready to receive input.
    ///
    /// Allocates the [`h`] (32 byte) and [`block`] (64 byte) buffers from the
    /// global allocator. The returned object owns those allocations and MUST be
    /// freed with [`Sha256.delete`]; there is no automatic cleanup.
    pub fn create(): Sha256 {
        let s = bytes.new_with_allocator<Sha256>(allocator.globalAllocator());
        s.h = bytes.alloc(8 * 4);
        s.block = bytes.alloc(SHA256_BLOCK_LEN);
        s.reset();
        return s;
    }

    /// Reinitialises the hasher to hash a new message from scratch.
    ///
    /// Writes the [`IV256`] initialisation vector back into [`h`] and clears
    /// [`blockLen`] and [`total`]. Called by [`Sha256.create`], and callable
    /// directly to reuse an existing instance without freeing and reallocating.
    pub fn reset(self: Sha256): void {
        let i = 0;
        while (i < 8) {
            putWord(self.h, i * 4, IV256[i]);
            i = i + 1;
        }
        self.blockLen = 0;
        self.total = 0;
    }

    /// Compresses one 64-byte block at `buf + off` into the running state [`h`].
    ///
    /// This is the pure-Nova core of SHA-256, one full round of the FIPS 180-4
    /// compression function. It first builds the 64-word message schedule `w`:
    /// the first 16 words are the block read big-endian, and the remaining 48
    /// are derived with the small-sigma mixing functions. It then runs the 64
    /// rounds over the eight working variables `a` through `hh` using the
    /// big-sigma, `ch` and `maj` functions plus the round constant [`K256`],
    /// and finally adds the working variables back into [`h`]. Every
    /// intermediate is masked with [`MASK32`] to stay 32-bit.
    ///
    /// The schedule buffer `w` is heap-allocated and freed before return, so
    /// this leaves no allocation behind. It is used for the tail of a message
    /// and whenever the hardware fast path is unavailable; see [`Sha256.update`].
    fn compress(self: Sha256, buf: ptr, off: int): void {
        let w = bytes.alloc(64 * 4);
        let t = 0;
        while (t < 16) {
            putWord(w, t * 4, beWord(buf, off + t * 4));
            t = t + 1;
        }
        while (t < 64) {
            let w15 = beWord(w, (t - 15) * 4);
            let w2 = beWord(w, (t - 2) * 4);
            let s0 = (rotr(w15, 7) ^ rotr(w15, 18) ^ (w15 >> 3)) & MASK32;
            let s1 = (rotr(w2, 17) ^ rotr(w2, 19) ^ (w2 >> 10)) & MASK32;
            let w16 = beWord(w, (t - 16) * 4);
            let w7 = beWord(w, (t - 7) * 4);
            putWord(w, t * 4, (w16 + s0 + w7 + s1) & MASK32);
            t = t + 1;
        }

        let a = beWord(self.h, 0);
        let b = beWord(self.h, 4);
        let c = beWord(self.h, 8);
        let d = beWord(self.h, 12);
        let e = beWord(self.h, 16);
        let f = beWord(self.h, 20);
        let g = beWord(self.h, 24);
        let hh = beWord(self.h, 28);

        t = 0;
        while (t < 64) {
            let bigS1 = (rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)) & MASK32;
            let ch = ((e & f) ^ ((~e) & g)) & MASK32;
            let temp1 = (hh + bigS1 + ch + K256[t] + beWord(w, t * 4)) & MASK32;
            let bigS0 = (rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)) & MASK32;
            let maj = ((a & b) ^ (a & c) ^ (b & c)) & MASK32;
            let temp2 = (bigS0 + maj) & MASK32;
            hh = g;
            g = f;
            f = e;
            e = (d + temp1) & MASK32;
            d = c;
            c = b;
            b = a;
            a = (temp1 + temp2) & MASK32;
            t = t + 1;
        }

        putWord(self.h, 0, (beWord(self.h, 0) + a) & MASK32);
        putWord(self.h, 4, (beWord(self.h, 4) + b) & MASK32);
        putWord(self.h, 8, (beWord(self.h, 8) + c) & MASK32);
        putWord(self.h, 12, (beWord(self.h, 12) + d) & MASK32);
        putWord(self.h, 16, (beWord(self.h, 16) + e) & MASK32);
        putWord(self.h, 20, (beWord(self.h, 20) + f) & MASK32);
        putWord(self.h, 24, (beWord(self.h, 24) + g) & MASK32);
        putWord(self.h, 28, (beWord(self.h, 28) + hh) & MASK32);
        bytes.free(w);
    }

    /// Feeds `len` bytes at `data` into the digest, buffering and compressing
    /// full blocks as they accumulate.
    ///
    /// May be called any number of times to hash a message in pieces; the
    /// result is identical to hashing the concatenation in one call. The logic
    /// runs in three phases: first it tops up any partially filled [`block`]
    /// from a previous call and compresses it if it fills; then it compresses
    /// the run of whole 64-byte blocks directly out of `data`, using the
    /// assembly path [`nova_sha256_blocks`] in bulk when [`nova_has_asm_crypto`]
    /// reports hardware support and the pure-Nova [`Sha256.compress`] otherwise;
    /// finally it stashes any leftover tail bytes back into [`block`] for the
    /// next call. [`total`] is advanced by `len` up front so the eventual bit
    /// length is correct.
    pub fn update(self: Sha256, data: ptr, len: int): void {
        self.total = self.total + (len as long);
        let i = 0;
        if (self.blockLen > 0) {
            while (i < len && self.blockLen < SHA256_BLOCK_LEN) {
                bytes.write_byte(self.block, self.blockLen, bytes.read_byte(data, i));
                self.blockLen = self.blockLen + 1;
                i = i + 1;
            }
            if (self.blockLen == SHA256_BLOCK_LEN) {
                // Route the completed block through the hardware SHA-2 path too, not
                // just the bulk run below. This is the block that finalises a small
                // message (e.g. every HMAC inner/outer close in PBKDF2), so leaving
                // it on the pure-Nova compressor kept ~half of all compressions in
                // software and dominated PBKDF2 cost.
                if (nova_has_asm_crypto() == 1) {
                    nova_sha256_blocks(self.h, self.block, 1);
                } else {
                    self.compress(self.block, 0);
                }
                self.blockLen = 0;
            }
        }
        let nb = (len - i) / SHA256_BLOCK_LEN;
        if (nb > 0 && nova_has_asm_crypto() == 1) {
            nova_sha256_blocks(self.h, (data as long + i) as ptr, nb);
            i = i + nb * SHA256_BLOCK_LEN;
        }
        while (len - i >= SHA256_BLOCK_LEN) {
            self.compress(data, i);
            i = i + SHA256_BLOCK_LEN;
        }
        while (i < len) {
            bytes.write_byte(self.block, self.blockLen, bytes.read_byte(data, i));
            self.blockLen = self.blockLen + 1;
            i = i + 1;
        }
    }

    /// Applies the SHA-256 padding, compresses the final block, and writes the
    /// 32-byte digest to `out`.
    ///
    /// `out` must point at [`SHA256_DIGEST_LEN`] writable bytes. Padding follows
    /// the standard: a single `0x80` byte, then enough zero bytes so that after
    /// appending the 8-byte big-endian message bit length the total is a
    /// multiple of [`SHA256_BLOCK_LEN`]. The padding is built in a scratch
    /// buffer and pushed through [`Sha256.update`], which compresses the closing
    /// block or blocks, then the eight state words are read from [`h`] with
    /// [`beWord`] and written big-endian into `out`.
    ///
    /// This method MUTATES the hasher (it consumes the padding), so the digest
    /// can be read only once. To hash another message, call [`Sha256.reset`]
    /// first. It does not free the object; that is [`Sha256.delete`].
    pub fn final(self: Sha256, out: ptr): void {
        let bitLen = self.total * 8;
        let pad = bytes.alloc(SHA256_BLOCK_LEN * 2);
        let n = 0;
        bytes.write_byte(pad, n, 0x80);
        n = n + 1;
        while (((self.blockLen + n + 8) % SHA256_BLOCK_LEN) != 0) {
            bytes.write_byte(pad, n, 0);
            n = n + 1;
        }
        let j = 0;
        while (j < 8) {
            bytes.write_byte(pad, n + j, ((bitLen >> ((7 - j) * 8)) & 0xff) as int);
            j = j + 1;
        }
        n = n + 8;
        self.update(pad, n);
        let i = 0;
        while (i < 8) {
            putWord(out, i * 4, beWord(self.h, i * 4));
            i = i + 1;
        }
        bytes.free(pad);
    }

    /// Frees the two heap buffers this hasher owns and nulls their pointers.
    ///
    /// Must be called exactly once when the hasher is no longer needed, since
    /// [`Sha256`] does not clean itself up. The null checks and reassignment to
    /// 0 make a second call a safe no-op, guarding against a double free.
    pub fn delete(self: Sha256): void {
        if (self.h != 0) {
            bytes.free(self.h);
            self.h = 0;
        }
        if (self.block != 0) {
            bytes.free(self.block);
            self.block = 0;
        }
    }
}

/// One-shot SHA-256: hashes `len` bytes at `data` and writes the 32-byte
/// digest to `out`.
///
/// A convenience wrapper over the full lifecycle for the common case where the
/// whole message is available at once. It creates a [`Sha256`], updates it with
/// the input, finalises into `out`, and deletes the hasher, so the caller has
/// nothing to free. `out` must have room for [`SHA256_DIGEST_LEN`] bytes.
pub fn hashInto(data: ptr, len: int, out: ptr): void {
    let s = Sha256.create();
    s.update(data, len);
    s.final(out);
    s.delete();
}
