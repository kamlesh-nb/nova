//! SHA-512 and SHA-384 message digests (FIPS 180-4).
//!
//! This file is a from-scratch, pure-Kyte implementation of the SHA-2 family
//! members that operate on 64-bit words: SHA-512 (64-byte digest) and its
//! truncated sibling SHA-384 (48-byte digest). Both share the identical block
//! compression function and differ only in the initial hash value and in how
//! much of the final state is emitted, so a single [`Sha512`] struct handles
//! both, selected by the `is384` flag at construction.
//!
//! The algorithm processes the message in 128-byte ([`SHA512_BLOCK_LEN`])
//! blocks. Each block is expanded into an 80-entry message schedule of 64-bit
//! words, then mixed into the eight working variables through 80 rounds using
//! the round constants [`K512`]. The design here is deliberately plain and
//! byte-oriented: the running hash state and the partial block are kept as raw
//! big-endian byte buffers rather than arrays of `ulong`, so the load/store
//! helpers [`beWord`] and [`putWord`] convert on every access. That keeps the
//! serialisation of the final digest trivial (the state is already in the wire
//! byte order) at the cost of some byte shuffling per round.
//!
//! There are two compression paths. When the runtime reports a hardware or
//! hand-written assembly implementation via `kyte_has_asm_crypto`, whole runs of
//! full blocks are handed to `kyte_sha512_blocks` in one call for speed. The
//! pure-Kyte [`Sha512.compress`] is always present as the correct fallback and
//! handles the leading partial block, the trailing partial block, and every
//! block when no assembly is available. Both paths update the same state buffer,
//! so the choice is invisible to callers.
//!
//! The public surface is the incremental [`Sha512`] object (create, update,
//! final, delete) plus two one-shot convenience wrappers, [`hashInto`] for
//! SHA-512 and [`hash384Into`] for SHA-384, that own the whole lifecycle and
//! write straight into a caller-supplied output buffer. This module sits under
//! `std/crypto/hash` alongside the other digest primitives and is consumed by
//! higher-level constructions such as HMAC and the TLS/PRF machinery, which need
//! a streaming hash they can feed in pieces.

import bytes;
import mem.allocator;

/// Runtime probe: returns 1 when an optimised (assembly or hardware) SHA-512
/// block function is available, 0 otherwise.
///
/// Used by [`Sha512.update`] to decide whether a run of full blocks can be
/// offloaded to [`kyte_sha512_blocks`]. The result must be treated as fixed for
/// the process; it never changes between calls.
extern("c") fn kyte_has_asm_crypto(): int;
/// Optimised native compression over one or more whole 128-byte blocks.
///
/// `state` points at the eight 64-bit hash words in big-endian byte order (the
/// same [`Sha512.h`] buffer the pure path uses), `data` at the first input byte,
/// and `blocks` is the count of complete [`SHA512_BLOCK_LEN`] blocks to absorb.
/// It updates `state` in place and must produce byte-for-byte the same result as
/// [`Sha512.compress`] applied block by block. Only invoked after
/// [`kyte_has_asm_crypto`] returns 1.
extern("c") fn kyte_sha512_blocks(state: ptr, data: ptr, blocks: int): void;

/// The 80 SHA-512 round constants, one per compression round.
///
/// These are the first 64 bits of the fractional parts of the cube roots of the
/// first 80 prime numbers, as fixed by FIPS 180-4. Each value `K512[t]` is added
/// into the `temp1` term of round `t` in [`Sha512.compress`]. The table is the
/// same for SHA-384 and SHA-512; only the initial state differs between them.
const K512: ulong[80] = [
    0x428a2f98d728ae22, 0x7137449123ef65cd, 0xb5c0fbcfec4d3b2f, 0xe9b5dba58189dbbc,
    0x3956c25bf348b538, 0x59f111f1b605d019, 0x923f82a4af194f9b, 0xab1c5ed5da6d8118,
    0xd807aa98a3030242, 0x12835b0145706fbe, 0x243185be4ee4b28c, 0x550c7dc3d5ffb4e2,
    0x72be5d74f27b896f, 0x80deb1fe3b1696b1, 0x9bdc06a725c71235, 0xc19bf174cf692694,
    0xe49b69c19ef14ad2, 0xefbe4786384f25e3, 0x0fc19dc68b8cd5b5, 0x240ca1cc77ac9c65,
    0x2de92c6f592b0275, 0x4a7484aa6ea6e483, 0x5cb0a9dcbd41fbd4, 0x76f988da831153b5,
    0x983e5152ee66dfab, 0xa831c66d2db43210, 0xb00327c898fb213f, 0xbf597fc7beef0ee4,
    0xc6e00bf33da88fc2, 0xd5a79147930aa725, 0x06ca6351e003826f, 0x142929670a0e6e70,
    0x27b70a8546d22ffc, 0x2e1b21385c26c926, 0x4d2c6dfc5ac42aed, 0x53380d139d95b3df,
    0x650a73548baf63de, 0x766a0abb3c77b2a8, 0x81c2c92e47edaee6, 0x92722c851482353b,
    0xa2bfe8a14cf10364, 0xa81a664bbc423001, 0xc24b8b70d0f89791, 0xc76c51a30654be30,
    0xd192e819d6ef5218, 0xd69906245565a910, 0xf40e35855771202a, 0x106aa07032bbd1b8,
    0x19a4c116b8d2d0c8, 0x1e376c085141ab53, 0x2748774cdf8eeb99, 0x34b0bcb5e19b48a8,
    0x391c0cb3c5c95a63, 0x4ed8aa4ae3418acb, 0x5b9cca4f7763e373, 0x682e6ff3d6b2b8a3,
    0x748f82ee5defb2fc, 0x78a5636f43172f60, 0x84c87814a1f0ab72, 0x8cc702081a6439ec,
    0x90befffa23631e28, 0xa4506cebde82bde9, 0xbef9a3f7b2c67915, 0xc67178f2e372532b,
    0xca273eceea26619c, 0xd186b8c721c0c207, 0xeada7dd6cde0eb1e, 0xf57d4f7fee6ed178,
    0x06f067aa72176fba, 0x0a637dc5a2c898a6, 0x113f9804bef90dae, 0x1b710b35131c471b,
    0x28db77f523047d84, 0x32caab7b40c72493, 0x3c9ebe0a15c9bebc, 0x431d67c49c100d4c,
    0x4cc5d4becb3e42b6, 0x597f299cfc657e2a, 0x5fcb6fab3ad6faec, 0x6c44198c4a475817,
];

/// The eight initial hash words for SHA-512.
///
/// These are the first 64 bits of the fractional parts of the square roots of
/// the first eight primes, per FIPS 180-4. [`Sha512.reset`] loads them into the
/// state when `is384` is false. SHA-384 uses [`IV384`] instead, which is what
/// makes the two functions produce different digests from the same rounds.
const IV512: ulong[8] = [
    0x6a09e667f3bcc908, 0xbb67ae8584caa73b, 0x3c6ef372fe94f82b, 0xa54ff53a5f1d36f1,
    0x510e527fade682d1, 0x9b05688c2b3e6c1f, 0x1f83d9abfb41bd6b, 0x5be0cd19137e2179,
];

/// The eight initial hash words for SHA-384.
///
/// SHA-384 is not merely a truncation of SHA-512: it runs the identical rounds
/// but starts from this distinct initial state (the 9th to 16th primes' square
/// root fractions per FIPS 180-4), then emits only the first six words. Loaded
/// by [`Sha512.reset`] when `is384` is true.
const IV384: ulong[8] = [
    0xcbbb9d5dc1059ed8, 0x629a292a367cd507, 0x9159015a3070dd17, 0x152fecd8f70e5939,
    0x67332667ffc00b31, 0x8eb44a8768581511, 0xdb0c2e0d64f98fa7, 0x47b5481dbefa4fa4,
];

/// Size in bytes of a full SHA-512 digest (512 bits = 64 bytes).
///
/// The output buffer passed to [`Sha512.final`] or [`hashInto`] for a SHA-512
/// hash must be at least this large.
pub const SHA512_DIGEST_LEN: int = 64;
/// Size in bytes of a SHA-384 digest (384 bits = 48 bytes).
///
/// SHA-384 emits only the first six of the eight 64-bit state words, giving 48
/// bytes. The output buffer for [`hash384Into`] must be at least this large.
pub const SHA384_DIGEST_LEN: int = 48;
/// Size in bytes of one SHA-512 compression block (1024 bits = 128 bytes).
///
/// Both SHA-512 and SHA-384 process the message in blocks of this size. It also
/// bounds the internal partial-block buffer [`Sha512.block`] and drives the
/// padding arithmetic in [`Sha512.final`].
pub const SHA512_BLOCK_LEN: int = 128;

/// Rotates a 64-bit word right by `n` bits (a circular shift, bits wrap around).
///
/// This is the ROTR primitive of FIPS 180-4, distinct from a plain right shift
/// because no bits are lost. Callers use `0 < n < 64`. Implemented as the
/// combination of a right shift and a left shift by the complement width, which
/// is why `n` must stay in that open range: `n == 0` or `n == 64` would shift a
/// 64-bit value by 64 and is not used here.
fn rotr(x: ulong, n: int): ulong {
    return (x >> n) | (x << (64 - n));
}

/// Reads eight bytes at `buf + off` as one big-endian 64-bit word.
///
/// The hash state and message schedule are stored as raw big-endian bytes, so
/// this is the load half of that representation: byte `off` is the most
/// significant. Paired with [`putWord`]. The caller must ensure eight valid
/// bytes exist starting at `off`; no bounds checking is performed.
fn beWord(buf: ptr, off: int): ulong {
    let v: ulong = 0;
    let i = 0;
    while (i < 8) {
        v = (v << 8) | (bytes.read_byte(buf, off + i) as ulong);
        i = i + 1;
    }
    return v;
}

/// Writes the 64-bit word `w` at `out + off` in big-endian byte order.
///
/// The store half matching [`beWord`]: the most significant byte of `w` lands at
/// `off`, the least at `off + 7`. Used to write both intermediate schedule and
/// state words and the final digest bytes, so the emitted digest is already in
/// the standard wire order. The caller must ensure eight writable bytes exist at
/// `off`; no bounds checking is performed.
fn putWord(out: ptr, off: int, w: ulong): void {
    let i = 0;
    while (i < 8) {
        bytes.write_byte(out, off + i, ((w >> ((7 - i) * 8)) & 0xff) as int);
        i = i + 1;
    }
}

/// An incremental SHA-512 or SHA-384 hasher.
///
/// Feed the message in any number of pieces with [`Sha512.update`], then call
/// [`Sha512.final`] once to obtain the digest. Because the struct holds two
/// heap allocations ([`Sha512.h`] and [`Sha512.block`]), the caller MUST call
/// [`Sha512.delete`] when finished to avoid leaking them. The same instance can
/// be reused for a fresh message by calling [`Sha512.reset`].
///
/// The variant (SHA-512 vs SHA-384) is fixed at construction via
/// [`Sha512.create`] and stored in [`Sha512.is384`]; there is no way to switch
/// an existing instance between the two.
pub struct Sha512 {
    /// The eight 64-bit hash state words, stored as 64 raw big-endian bytes.
    ///
    /// Kept as a byte buffer rather than a `ulong[8]` so the same layout serves
    /// both the pure-Kyte rounds (via [`beWord`] / [`putWord`]) and the native
    /// [`kyte_sha512_blocks`] fast path, and so [`Sha512.final`] can copy the
    /// digest out without a byte-order conversion.
    pub h: ptr,
    /// A 128-byte buffer holding the current partial (not yet compressed) block.
    ///
    /// Bytes accumulate here until a full [`SHA512_BLOCK_LEN`] block is present,
    /// at which point it is compressed and [`blockLen`] is reset. Sized exactly
    /// one block.
    pub block: ptr,
    /// Number of valid bytes currently buffered in [`block`] (0 to 127).
    ///
    /// Reaching [`SHA512_BLOCK_LEN`] triggers a compression and resets this to 0.
    pub blockLen: int,
    /// Total number of message bytes absorbed so far across all [`Sha512.update`]
    /// calls.
    ///
    /// Multiplied by eight in [`Sha512.final`] to form the 128-bit length field
    /// appended during padding. A `long` (64-bit) counter, so it tracks the byte
    /// length rather than the bit length to avoid overflow on large inputs.
    pub total: long,
    /// True for SHA-384, false for SHA-512.
    ///
    /// Selects [`IV384`] over [`IV512`] in [`Sha512.reset`] and limits
    /// [`Sha512.final`] to emitting six state words instead of eight.
    pub is384: bool,

    /// Allocates and initialises a hasher for SHA-512 (`is384 == false`) or
    /// SHA-384 (`is384 == true`).
    ///
    /// Allocates the [`h`] and [`block`] buffers from the global allocator and
    /// loads the appropriate initial state via [`Sha512.reset`]. The returned
    /// object owns those allocations; pair every `create` with a
    /// [`Sha512.delete`].
    pub fn create(is384: bool): Sha512 {
        let s = bytes.new_with_allocator<Sha512>(allocator.globalAllocator());
        s.h = bytes.alloc(8 * 8);
        s.block = bytes.alloc(SHA512_BLOCK_LEN);
        s.is384 = is384;
        s.reset();
        return s;
    }

    /// Restores the initial state so the instance can hash a new message.
    ///
    /// Loads the eight initial words ([`IV384`] or [`IV512`] according to
    /// [`is384`]) into [`h`] and clears the partial-block length and byte
    /// counter. Called once by [`Sha512.create`], and safe to call again between
    /// messages to reuse the same allocations.
    pub fn reset(self: Sha512): void {
        let i = 0;
        while (i < 8) {
            putWord(self.h, i * 8, if (self.is384) IV384[i] else IV512[i]);
            i = i + 1;
        }
        self.blockLen = 0;
        self.total = 0;
    }

    /// Absorbs one 128-byte block at `buf + off` into the hash state [`h`].
    ///
    /// This is the pure-Kyte core of SHA-512: the round function that FIPS 180-4
    /// specifies. It first builds the 80-word message schedule (the first 16
    /// words copied big-endian from the input, the remaining 64 derived by the
    /// sigma-0 / sigma-1 recurrence), then runs 80 rounds over the eight working
    /// variables `a` to `hh` using the [`K512`] constants, and finally adds the
    /// working variables back into the running state (the Davies-Meyer feed
    /// forward).
    ///
    /// The schedule is a temporary 640-byte heap allocation that is freed before
    /// return, so the function does not leak. `off` lets a caller compress a
    /// block sitting in the middle of a larger input buffer without copying it
    /// out first. Correctness note: this must match [`kyte_sha512_blocks`]
    /// exactly, since the two paths update the same [`h`] interchangeably.
    fn compress(self: Sha512, buf: ptr, off: int): void {
        let w = bytes.alloc(80 * 8);
        let t = 0;
        while (t < 16) {
            putWord(w, t * 8, beWord(buf, off + t * 8));
            t = t + 1;
        }
        while (t < 80) {
            let w15 = beWord(w, (t - 15) * 8);
            let w2 = beWord(w, (t - 2) * 8);
            let s0 = rotr(w15, 1) ^ rotr(w15, 8) ^ (w15 >> 7);
            let s1 = rotr(w2, 19) ^ rotr(w2, 61) ^ (w2 >> 6);
            let val = beWord(w, (t - 16) * 8) + s0 + beWord(w, (t - 7) * 8) + s1;
            putWord(w, t * 8, val);
            t = t + 1;
        }

        let a = beWord(self.h, 0);
        let b = beWord(self.h, 8);
        let c = beWord(self.h, 16);
        let d = beWord(self.h, 24);
        let e = beWord(self.h, 32);
        let f = beWord(self.h, 40);
        let g = beWord(self.h, 48);
        let hh = beWord(self.h, 56);

        t = 0;
        while (t < 80) {
            let bigS1 = rotr(e, 14) ^ rotr(e, 18) ^ rotr(e, 41);
            let ch = (e & f) ^ ((~e) & g);
            let temp1 = hh + bigS1 + ch + K512[t] + beWord(w, t * 8);
            let bigS0 = rotr(a, 28) ^ rotr(a, 34) ^ rotr(a, 39);
            let maj = (a & b) ^ (a & c) ^ (b & c);
            let temp2 = bigS0 + maj;
            hh = g;
            g = f;
            f = e;
            e = d + temp1;
            d = c;
            c = b;
            b = a;
            a = temp1 + temp2;
            t = t + 1;
        }

        putWord(self.h, 0, beWord(self.h, 0) + a);
        putWord(self.h, 8, beWord(self.h, 8) + b);
        putWord(self.h, 16, beWord(self.h, 16) + c);
        putWord(self.h, 24, beWord(self.h, 24) + d);
        putWord(self.h, 32, beWord(self.h, 32) + e);
        putWord(self.h, 40, beWord(self.h, 40) + f);
        putWord(self.h, 48, beWord(self.h, 48) + g);
        putWord(self.h, 56, beWord(self.h, 56) + hh);
        bytes.free(w);
    }

    /// Absorbs `len` bytes of message starting at `data`.
    ///
    /// May be called any number of times before [`Sha512.final`]; the digest is
    /// of the concatenation of every chunk. The logic proceeds in three stages:
    /// first it tops up any partially filled [`block`] from a previous call and
    /// compresses it once full; then it consumes the bulk of the remaining full
    /// blocks in place, preferring the native [`kyte_sha512_blocks`] over a run
    /// of complete blocks when [`kyte_has_asm_crypto`] reports one is available,
    /// otherwise calling [`Sha512.compress`] per block; finally it copies any
    /// trailing sub-block remainder into [`block`] to await the next call or the
    /// final padding.
    ///
    /// [`total`] is advanced by `len` up front so the eventual length encoding is
    /// correct regardless of how the input was split. `data` need not be aligned
    /// and is never modified.
    pub fn update(self: Sha512, data: ptr, len: int): void {
        self.total = self.total + (len as long);
        let i = 0;
        if (self.blockLen > 0) {
            while (i < len && self.blockLen < SHA512_BLOCK_LEN) {
                bytes.write_byte(self.block, self.blockLen, bytes.read_byte(data, i));
                self.blockLen = self.blockLen + 1;
                i = i + 1;
            }
            if (self.blockLen == SHA512_BLOCK_LEN) {
                self.compress(self.block, 0);
                self.blockLen = 0;
            }
        }
        let nb = (len - i) / SHA512_BLOCK_LEN;
        if (nb > 0 && kyte_has_asm_crypto() == 1) {
            kyte_sha512_blocks(self.h, (data as long + i) as ptr, nb);
            i = i + nb * SHA512_BLOCK_LEN;
        }
        while (len - i >= SHA512_BLOCK_LEN) {
            self.compress(data, i);
            i = i + SHA512_BLOCK_LEN;
        }
        while (i < len) {
            bytes.write_byte(self.block, self.blockLen, bytes.read_byte(data, i));
            self.blockLen = self.blockLen + 1;
            i = i + 1;
        }
    }

    /// Applies the padding, absorbs the length, and writes the digest to `out`.
    ///
    /// Performs the SHA-2 finalisation: append a single `0x80` byte, then enough
    /// zero bytes so that after a further 16 bytes the total is a multiple of
    /// [`SHA512_BLOCK_LEN`], then the message length as a 128-bit big-endian
    /// count of bits. The top 64 bits of that length are always written as zero
    /// here, since [`total`] is a 64-bit byte count and cannot overflow into
    /// them for any practical input. The padding is fed back through
    /// [`Sha512.update`] so it goes through the normal block machinery.
    ///
    /// It then emits the state: eight words (64 bytes) for SHA-512, or only the
    /// first six words (48 bytes) for SHA-384. `out` must have room for
    /// [`SHA512_DIGEST_LEN`] or [`SHA384_DIGEST_LEN`] bytes respectively. The
    /// scratch padding buffer is freed before return. This method does not reset
    /// the instance, so calling it twice would hash the already-padded state;
    /// call [`Sha512.reset`] first to reuse the object.
    pub fn final(self: Sha512, out: ptr): void {
        let bitLen = self.total * 8;
        let pad = bytes.alloc(SHA512_BLOCK_LEN * 2);
        let n = 0;
        bytes.write_byte(pad, n, 0x80);
        n = n + 1;
        while (((self.blockLen + n + 16) % SHA512_BLOCK_LEN) != 0) {
            bytes.write_byte(pad, n, 0);
            n = n + 1;
        }
        let j = 0;
        while (j < 8) {
            bytes.write_byte(pad, n + j, 0);
            j = j + 1;
        }
        j = 0;
        while (j < 8) {
            bytes.write_byte(pad, n + 8 + j, ((bitLen >> ((7 - j) * 8)) & 0xff) as int);
            j = j + 1;
        }
        n = n + 16;
        self.update(pad, n);

        let words = if (self.is384) 6 else 8;
        let i = 0;
        while (i < words) {
            putWord(out, i * 8, beWord(self.h, i * 8));
            i = i + 1;
        }
        bytes.free(pad);
    }

    /// Frees the two heap buffers this hasher owns.
    ///
    /// Releases [`h`] and [`block`] and nulls the pointers, so a second
    /// [`Sha512.delete`] is a safe no-op (the `!= 0` guards make it idempotent).
    /// Must be called exactly once per [`Sha512.create`] to avoid a leak; after
    /// it the instance must not be used again.
    pub fn delete(self: Sha512): void {
        if (self.h != 0) {
            bytes.free(self.h);
            self.h = 0;
        }
        if (self.block != 0) {
            bytes.free(self.block);
            self.block = 0;
        }
    }
}

/// One-shot SHA-512: hashes `len` bytes at `data` and writes 64 bytes to `out`.
///
/// A convenience wrapper that creates a SHA-512 [`Sha512`], feeds the whole
/// input in a single [`Sha512.update`], finalises, and deletes the instance, so
/// the caller never manages the object's lifetime. `out` must have room for
/// [`SHA512_DIGEST_LEN`] bytes. Use the incremental [`Sha512`] API directly when
/// the message arrives in pieces.
pub fn hashInto(data: ptr, len: int, out: ptr): void {
    let s = Sha512.create(false);
    s.update(data, len);
    s.final(out);
    s.delete();
}

/// One-shot SHA-384: hashes `len` bytes at `data` and writes 48 bytes to `out`.
///
/// The SHA-384 counterpart to [`hashInto`]: it constructs the hasher with
/// `is384 == true`, so it starts from [`IV384`] and emits only 48 bytes. `out`
/// must have room for [`SHA384_DIGEST_LEN`] bytes. Owns the full lifecycle of
/// the temporary [`Sha512`] instance.
pub fn hash384Into(data: ptr, len: int, out: ptr): void {
    let s = Sha512.create(true);
    s.update(data, len);
    s.final(out);
    s.delete();
}
