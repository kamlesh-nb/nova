import bytes;
import crypto.cipher.chacha20;
import crypto.mac.poly1305;

pub const KEY_LEN: int = 32;
pub const NONCE_LEN: int = 12;
pub const TAG_LEN: int = 16;

fn putLen64(buf: ptr, off: int, v: int): void {
    let vl = v as long;
    let i = 0;
    while (i < 8) {
        bytes.write_byte(buf, off + i, ((vl >> (i * 8)) & 0xff) as int);
        i = i + 1;
    }
}

fn poly1305KeyGen(key: ptr, nonce: ptr, otk: ptr): void {
    let block = bytes.alloc(64);
    chacha20.keystreamBlock(key, 0, nonce, block);
    let i = 0;
    while (i < 32) { bytes.write_byte(otk, i, bytes.read_byte(block, i)); i = i + 1; }
    bytes.free(block);
}

fn computeTag(otk: ptr, aad: ptr, aadLen: int, ct: ptr, ctLen: int, tag: ptr): void {
    let p = poly1305.Poly1305.create(otk);
    let zeros = bytes.alloc(16);
    let i = 0;
    while (i < 16) { bytes.write_byte(zeros, i, 0); i = i + 1; }

    p.update(aad, aadLen);
    let apad = (16 - (aadLen % 16)) % 16;
    if (apad > 0) { p.update(zeros, apad); }
    p.update(ct, ctLen);
    let cpad = (16 - (ctLen % 16)) % 16;
    if (cpad > 0) { p.update(zeros, cpad); }

    let lens = bytes.alloc(16);
    putLen64(lens, 0, aadLen);
    putLen64(lens, 8, ctLen);
    p.update(lens, 16);
    p.final(tag);
    p.delete();
    bytes.free(zeros);
    bytes.free(lens);
}

pub fn seal(key: ptr, nonce: ptr, aad: ptr, aadLen: int, pt: ptr, ptLen: int, ctOut: ptr, tagOut: ptr): void {
    let otk = bytes.alloc(32);
    poly1305KeyGen(key, nonce, otk);
    chacha20.applyKeystream(key, 1, nonce, pt, ptLen, ctOut);
    computeTag(otk, aad, aadLen, ctOut, ptLen, tagOut);
    bytes.free(otk);
}

pub fn open(key: ptr, nonce: ptr, aad: ptr, aadLen: int, ct: ptr, ctLen: int, tag: ptr, ptOut: ptr): bool {
    let otk = bytes.alloc(32);
    poly1305KeyGen(key, nonce, otk);
    let expTag = bytes.alloc(16);
    computeTag(otk, aad, aadLen, ct, ctLen, expTag);

    let diff = 0;
    let i = 0;
    while (i < 16) {
        diff = diff | (bytes.read_byte(expTag, i) ^ bytes.read_byte(tag, i));
        i = i + 1;
    }
    let ok = diff == 0;
    if (ok) {
        chacha20.applyKeystream(key, 1, nonce, ct, ctLen, ptOut);
    }
    bytes.free(otk);
    bytes.free(expTag);
    return ok;
}
