//! RSA public-key operations: signature verification and OAEP encryption.
//!
//! This file is Kyte's pure-Kyte RSA implementation. It has no dependency on
//! wolfSSL or any C library: the modular arithmetic, the padding schemes, and
//! the DER/PEM key parsing are all written here on top of the raw `bytes`
//! primitives. It exists because the self-hosted runtime retired wolfSSL, so
//! everything the TLS and JOSE paths need from RSA has to live in Kyte.
//!
//! Scope is deliberately narrow. Only the PUBLIC-key direction is here: verify a
//! signature (PKCS#1 v1.5 in [`verifyPkcs1`], PSS in [`verifyPss`]) and encrypt
//! with RSAES-OAEP ([`oaepEncryptSha1`]). There is no private-key operation, so
//! no signing and no decryption, because the callers (certificate-chain
//! verification and key transport) only ever hold the peer's public key.
//!
//! ## Big-number model
//!
//! A big integer is a flat little-endian array of 32-bit limbs, but each limb is
//! STORED in a 64-bit machine word (8 bytes per limb). The top 32 bits are
//! scratch carry space: an add or a schoolbook multiply of two 32-bit values
//! produces up to ~64 bits, and keeping the accumulator in the high half of the
//! word lets the code propagate the carry with a plain shift rather than a
//! separate wide type. `k` throughout is the LIMB COUNT, so a 2048-bit modulus is
//! `k == 64`. The helpers [`getw`] and [`setw`] read and write one limb at limb
//! index `i` (byte offset `i * 8`); everything else is layered on those two.
//!
//! ## Montgomery arithmetic
//!
//! Modular exponentiation is the hot operation, and a naive modular reduction per
//! multiply is expensive, so the exponentiation in [`bnModExp`] runs entirely in
//! the Montgomery domain. [`bnMontMul`] is a CIOS (Coarsely Integrated Operand
//! Scanning) Montgomery multiply, [`bnN0inv`] computes the per-modulus constant
//! `-N^-1 mod 2^32` it needs, and [`bnToMont`] / [`bnFromMont`] move values in and
//! out of the domain. [`bnCondSubN`] is the constant-shape conditional subtraction
//! that both the multiply and the modular add use to bring a result back below the
//! modulus without a data-dependent branch.
//!
//! ## Padding and encoding
//!
//! [`mgf1`] is the MGF1 mask generator shared by PSS and OAEP. [`doHash`],
//! [`hLen`], and [`digestInfoHex`] abstract over the hash choice (a small integer
//! id: 0 = SHA-256, 1 = SHA-384, 3 = SHA-1, anything else = SHA-512) so the
//! padding code does not name a concrete hash. Public keys arrive as PEM
//! (`-----BEGIN PUBLIC KEY-----`) and are walked as DER with [`readTlv`] and
//! [`pemToDer`] to pull out the modulus `N` and the public exponent `e`.
//!
//! Comparisons that gate on secret-independent-but-attacker-controlled data (the
//! recovered padding) use [`memEq`], a constant-time-shaped byte compare, so
//! verification does not leak where the first mismatch is.

import bytes;
import crypto.hash.sha256;
import crypto.hash.sha512;
import crypto.hash.sha1;
import crypto.base64;
import crypto.random;

/// Low 32 bits set: masks a 64-bit word back down to a single 32-bit limb after
/// an add or multiply has spilled a carry into the high half.
const MASK32: ulong = 0xffffffff;
/// The value zero as a `ulong`, kept as a named constant so the limb code reads
/// in terms of big-number quantities rather than bare literals.
const U0: ulong = 0;
/// The value one as a `ulong`, used for the least-significant limb of "one" and
/// for masking single carry bits.
const U1: ulong = 1;
/// The value two as a `ulong`, used by the Newton iteration in [`bnN0inv`].
const TWO: ulong = 2;

/// Reads limb `i` of big number `f` (the 32-bit value stored in the low half of
/// the 8-byte word at offset `i * 8`).
fn getw(f: ptr, i: int): ulong { return (bytes.read_ptr(f, i * 8) as long) as ulong; }
/// Writes `v` as limb `i` of big number `f`, storing the full 64-bit word so the
/// caller may park a carry in the high half for the next limb to pick up.
fn setw(f: ptr, i: int, v: ulong): void { bytes.write_ptr(f, i * 8, (v as long) as ptr); }

/// Copies the first `k` limbs of `a` into `out`. The buffers must not overlap.
fn bnCopy(out: ptr, a: ptr, k: int): void {
    let i = 0;
    while (i < k) { setw(out, i, getw(a, i)); i = i + 1; }
}

/// Loads a big-endian byte string into the little-endian limb array `out`.
///
/// Reads `k * 4` bytes from `buf` starting at `off` and packs them into `k`
/// limbs, reversing byte order so the most significant input byte lands in the
/// top limb. This is how a modulus or a signature integer, both of which arrive
/// on the wire as big-endian octet strings, become the internal representation.
fn bnFromBE(out: ptr, buf: ptr, off: int, k: int): void {
    let i = 0;
    while (i < k) {
        let base = off + (k - 1 - i) * 4;
        let w = ((bytes.read_byte(buf, base) as ulong) << 24)
              | ((bytes.read_byte(buf, base + 1) as ulong) << 16)
              | ((bytes.read_byte(buf, base + 2) as ulong) << 8)
              | (bytes.read_byte(buf, base + 3) as ulong);
        setw(out, i, w);
        i = i + 1;
    }
}

/// Serialises the little-endian limb array `a` back into big-endian bytes.
///
/// The inverse of [`bnFromBE`]: writes `k * 4` bytes into `buf` at `off`, most
/// significant limb first. Used to render the recovered encoded message so the
/// padding checks can inspect it byte by byte.
fn bnToBE(buf: ptr, off: int, a: ptr, k: int): void {
    let i = 0;
    while (i < k) {
        let base = off + (k - 1 - i) * 4;
        let w = getw(a, i);
        bytes.write_byte(buf, base, ((w >> 24) & 0xff) as int);
        bytes.write_byte(buf, base + 1, ((w >> 16) & 0xff) as int);
        bytes.write_byte(buf, base + 2, ((w >> 8) & 0xff) as int);
        bytes.write_byte(buf, base + 3, (w & 0xff) as int);
        i = i + 1;
    }
}

/// Computes the Montgomery constant `-N^-1 mod 2^32` for modulus `N`.
///
/// This is the per-modulus value the CIOS multiply in [`bnMontMul`] needs to zero
/// out the low limb at each reduction step. It first finds `N^-1 mod 2^32` by a
/// Newton-Hensel doubling iteration (`inv = inv * (2 - n0 * inv)`, which doubles
/// the number of correct low bits each round, so 40 iterations more than covers
/// 32 bits), then negates modulo `2^32`. Only the least-significant limb of `N`
/// participates, since the inverse is taken modulo `2^32`.
fn bnN0inv(N: ptr): ulong {
    let n0 = getw(N, 0);
    let inv: ulong = 1;
    let i = 0;
    while (i < 40) { inv = (inv * (TWO - n0 * inv)) & MASK32; i = i + 1; }
    return (U0 - inv) & MASK32;
}

/// Returns whether `a < b`, comparing `k`-limb big numbers.
///
/// Implemented by computing `a - b` limb by limb and reporting whether the final
/// borrow is set, which is exactly the condition `a < b`. The subtraction result
/// itself is discarded; only the borrow out of the top limb is examined. Used to
/// reject a signature whose integer value is not strictly less than the modulus,
/// as RSA requires.
fn bnLt(a: ptr, b: ptr, k: int): bool {
    let borrow: ulong = 0;
    let j = 0;
    while (j < k) {
        let x = getw(a, j) - getw(b, j) - borrow;
        borrow = (x >> 32) & U1;
        j = j + 1;
    }
    return borrow == U1;
}

/// Conditionally subtracts modulus `N` from the `(k + 1)`-limb value `t`,
/// writing the reduced `k`-limb result to `out`.
///
/// This is the final reduction shared by [`bnMontMul`] and [`bnAddModN`]. The
/// input `t` may be up to one limb wider than the modulus, so a straight
/// subtraction can either be needed or not. Rather than branch on that (which
/// would leak timing on the value), it always computes `d = t - N`, then derives
/// a mask from whether the subtraction borrowed past limb `k`: if it did not
/// borrow then `t >= N` and `d` is selected, otherwise `t` is kept. The select is
/// a bitwise blend, so the work done is the same either way. `out` and `t` may
/// alias.
fn bnCondSubN(out: ptr, t: ptr, N: ptr, k: int): void {
    let d = bytes.alloc(k * 8);
    let borrow: ulong = 0;
    let j = 0;
    while (j < k) {
        let x = getw(t, j) - getw(N, j) - borrow;
        setw(d, j, x & MASK32);
        borrow = (x >> 32) & U1;
        j = j + 1;
    }
    let xk = getw(t, k) - borrow;
    borrow = (xk >> 32) & U1;
    let mask = U0 - (borrow ^ U1);
    j = 0;
    while (j < k) {
        setw(out, j, (getw(d, j) & mask) | (getw(t, j) & (~mask)));
        j = j + 1;
    }
    bytes.free(d);
}

/// Computes `out = (a + b) mod N` for `k`-limb operands already reduced below `N`.
///
/// Adds into a `(k + 1)`-limb temporary so the top carry is captured, then feeds
/// that to [`bnCondSubN`] for the single conditional reduction that a sum of two
/// sub-modulus values can ever need. This is the modular doubling primitive that
/// [`bnToMont`] iterates to shift a value into the Montgomery domain.
fn bnAddModN(out: ptr, a: ptr, b: ptr, N: ptr, k: int): void {
    let t = bytes.alloc((k + 1) * 8);
    let carry: ulong = 0;
    let j = 0;
    while (j < k) {
        let s = getw(a, j) + getw(b, j) + carry;
        setw(t, j, s & MASK32);
        carry = s >> 32;
        j = j + 1;
    }
    setw(t, k, carry);
    bnCondSubN(out, t, N, k);
    bytes.free(t);
}

/// Montgomery multiply: `out = a * b * R^-1 mod N`, where `R = 2^(32k)`.
///
/// This is the arithmetic core of the exponentiation. It uses the CIOS variant,
/// which interleaves the schoolbook multiply and the Montgomery reduction one
/// outer limb at a time. For each limb `b[i]` of the multiplier it first adds the
/// partial product `a * b[i]` into the running accumulator `t`, then computes the
/// reduction quotient `m = t[0] * n0inv mod 2^32` and adds `m * N`, which is
/// chosen precisely so that the low limb of `t` becomes zero and the accumulator
/// can be shifted down by one limb (the `setw(t, j - 1, ...)` writes are that
/// shift). After all `k` outer steps, `t` holds the Montgomery product possibly
/// one `N` too large, so [`bnCondSubN`] finishes it. `n0inv` is the constant from
/// [`bnN0inv`] for this `N`. Operands must be in the Montgomery domain; the result
/// is too.
fn bnMontMul(out: ptr, a: ptr, b: ptr, N: ptr, k: int, n0inv: ulong): void {
    let t = bytes.alloc((k + 2) * 8);
    let j = 0;
    while (j < k + 2) { setw(t, j, U0); j = j + 1; }
    let i = 0;
    while (i < k) {
        let bi = getw(b, i);
        let carry: ulong = 0;
        j = 0;
        while (j < k) {
            let s = getw(t, j) + getw(a, j) * bi + carry;
            setw(t, j, s & MASK32);
            carry = s >> 32;
            j = j + 1;
        }
        let sk = getw(t, k) + carry;
        setw(t, k, sk & MASK32);
        setw(t, k + 1, sk >> 32);
        let m = (getw(t, 0) * n0inv) & MASK32;
        let c2 = (getw(t, 0) + m * getw(N, 0)) >> 32;
        j = 1;
        while (j < k) {
            let s = getw(t, j) + m * getw(N, j) + c2;
            setw(t, j - 1, s & MASK32);
            c2 = s >> 32;
            j = j + 1;
        }
        let sk2 = getw(t, k) + c2;
        setw(t, k - 1, sk2 & MASK32);
        setw(t, k, getw(t, k + 1) + (sk2 >> 32));
        i = i + 1;
    }
    bnCondSubN(out, t, N, k);
    bytes.free(t);
}

/// Sets `out` to the integer one: limb 0 is `1`, the other `k - 1` limbs zero.
fn bnSetOne(out: ptr, k: int): void {
    let j = 0;
    while (j < k) { setw(out, j, U0); j = j + 1; }
    setw(out, 0, U1);
}

/// Converts `a` into the Montgomery domain: `out = a * R mod N`.
///
/// Computes `a * 2^(32k) mod N` the cheap way, by starting from `a` and doubling
/// modulo `N` exactly `32 * k` times (each [`bnAddModN`] of the value with itself
/// multiplies by two). This avoids needing a precomputed `R^2 mod N` at the cost
/// of `32k` modular additions, which is acceptable because it happens only once
/// per exponentiation for the base and once for the accumulator. `out` and `a`
/// may alias.
fn bnToMont(out: ptr, a: ptr, N: ptr, k: int): void {
    bnCopy(out, a, k);
    let i = 0;
    let bits = 32 * k;
    while (i < bits) { bnAddModN(out, out, out, N, k); i = i + 1; }
}

/// Converts `x` out of the Montgomery domain: `out = x * R^-1 mod N`.
///
/// A Montgomery multiply by the integer one strips exactly one factor of `R`, so
/// `MontMul(x, 1)` yields the ordinary residue. This is the last step of
/// [`bnModExp`], turning the Montgomery-domain result back into a plain integer.
fn bnFromMont(out: ptr, x: ptr, N: ptr, k: int, n0inv: ulong): void {
    let one = bytes.alloc(k * 8);
    bnSetOne(one, k);
    bnMontMul(out, x, one, N, k, n0inv);
    bytes.free(one);
}

/// Modular exponentiation: `out = base^e mod N`, the RSA public-key operation.
///
/// Standard left-to-right square-and-multiply, but performed entirely in the
/// Montgomery domain to make each multiply cheap. The base is moved into the
/// domain once with [`bnToMont`], and the accumulator `r` starts at the
/// Montgomery representation of one (`bnSetOne` then `bnToMont`). The exponent `e`
/// is a big-endian byte string of length `eLen`, scanned most significant bit
/// first; every bit squares `r`, and a set bit also multiplies in the base. The
/// result is brought back with [`bnFromMont`].
///
/// This is NOT constant time in the exponent: the multiply is skipped on a zero
/// bit. That is acceptable here because `e` is the PUBLIC exponent, not a secret.
fn bnModExp(out: ptr, base: ptr, N: ptr, k: int, n0inv: ulong, e: ptr, eLen: int): void {
    let baseM = bytes.alloc(k * 8); bnToMont(baseM, base, N, k);
    let r = bytes.alloc(k * 8); bnSetOne(r, k); bnToMont(r, r, N, k);
    let bi = 0;
    while (bi < eLen) {
        let bt = bytes.read_byte(e, bi);
        let bit = 7;
        while (bit >= 0) {
            bnMontMul(r, r, r, N, k, n0inv);
            if (((bt >> bit) & 1) == 1) { bnMontMul(r, r, baseM, N, k, n0inv); }
            bit = bit - 1;
        }
        bi = bi + 1;
    }
    bnFromMont(out, r, N, k, n0inv);
    bytes.free(baseM); bytes.free(r);
}

/// Returns the bit length of `a`: the position of its most significant set bit
/// plus one, or 0 if `a` is zero.
///
/// Scans limbs from the top down for the first non-zero one, then finds the
/// highest set bit within it. PSS needs this because the encoding length depends
/// on the exact modulus bit length (`emBits = modBits - 1`), not just the byte
/// length, so a modulus whose top byte has leading zero bits is handled
/// correctly. See [`verifyPss`].
fn bnBitLen(a: ptr, k: int): int {
    let i = k - 1;
    while (i >= 0) {
        let w = getw(a, i);
        if (w != U0) {
            let b = 31;
            while (b >= 0) {
                if (((w >> b) & U1) == U1) { return i * 32 + b + 1; }
                b = b - 1;
            }
        }
        i = i - 1;
    }
    return 0;
}

/// Applies the raw RSA public-key transform `sig^e mod N` and writes the result
/// as big-endian bytes to `emOut`; returns 1 on success, 0 on rejection.
///
/// This is the shared primitive under every verify and encrypt path. It loads the
/// signature (or padded message) integer from big-endian bytes, rejects it if it
/// is not strictly less than the modulus (a required RSA check, done with
/// [`bnLt`]), exponentiates with [`bnModExp`], and serialises the encoded message
/// back out. `N` is already in limb form; `emOut` receives `k * 4` bytes. A
/// rejection returns 0 without touching `emOut` beyond what was already there.
fn rsaPublicOp(emOut: ptr, sig: ptr, N: ptr, k: int, e: ptr, eLen: int): int {
    let s = bytes.alloc(k * 8); bnFromBE(s, sig, 0, k);
    if (!bnLt(s, N, k)) { bytes.free(s); return 0; }
    let m = bytes.alloc(k * 8);
    bnModExp(m, s, N, k, bnN0inv(N), e, eLen);
    bnToBE(emOut, 0, m, k);
    bytes.free(s); bytes.free(m);
    return 1;
}


/// Returns the digest length in bytes for a hash id.
///
/// The id encoding is shared across this file: 0 is SHA-256 (32), 1 is SHA-384
/// (48), 3 is SHA-1 (20), and any other value falls through to SHA-512 (64). See
/// [`doHash`] and [`digestInfoHex`], which use the same encoding.
fn hLen(id: int): int {
    if (id == 0) { return 32; }
    if (id == 1) { return 48; }
    if (id == 3) { return 20; }
    return 64;
}
/// Hashes `len` bytes at `data` into `out`, dispatching on the hash id.
///
/// Uses the same id encoding as [`hLen`]. `out` must have room for the digest
/// length that id implies. This is the single indirection point that lets the
/// padding code (MGF1, PSS, OAEP) stay agnostic about which SHA variant is in
/// use.
fn doHash(id: int, data: ptr, len: int, out: ptr): void {
    if (id == 0) { sha256.hashInto(data, len, out); return; }
    if (id == 1) { sha512.hash384Into(data, len, out); return; }
    if (id == 3) { sha1.hashInto(data, len, out); return; }
    sha512.hashInto(data, len, out);
}

/// Converts one hex ASCII character to its 0..15 nibble value.
///
/// Handles `'0'`-`'9'` (subtract 48), lowercase `'a'`-`'f'` (subtract 87), and
/// otherwise assumes uppercase `'A'`-`'F'` (subtract 55). It does not validate
/// the input; callers pass the fixed, known-good hex constants from
/// [`digestInfoHex`], so no malformed byte ever reaches it.
fn nib(c: int): int {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    return c - 55;
}
/// Decodes the hex `string` `hex` and writes the resulting bytes into `buf` at
/// `off`; returns the number of bytes written (`hex.length / 2`).
///
/// Used to lay the fixed DigestInfo prefix from [`digestInfoHex`] into the
/// expected PKCS#1 v1.5 encoded message in [`verifyPkcs1`].
fn writeHex(buf: ptr, off: int, hex: string): int {
    let n = hex.length / 2;
    let i = 0;
    while (i < n) {
        bytes.write_byte(buf, off + i, nib(hex[i * 2]) * 16 + nib(hex[i * 2 + 1]));
        i = i + 1;
    }
    return n;
}
/// Returns the DER-encoded DigestInfo prefix (as a hex `string`) for a hash id.
///
/// PKCS#1 v1.5 signatures wrap the hash in a fixed ASN.1 DigestInfo structure
/// that names the hash algorithm and then carries the digest. These are the
/// canonical byte sequences for that structure with an empty digest slot, one per
/// hash. Ids follow the same encoding as [`hLen`]: 0 selects the SHA-256 prefix,
/// 1 the SHA-384 prefix, and anything else (in practice SHA-512) the last. The
/// caller appends the actual digest bytes after this prefix. See [`verifyPkcs1`].
fn digestInfoHex(id: int): string {
    if (id == 0) { return "3031300d060960864801650304020105000420"; }
    if (id == 1) { return "3041300d060960864801650304020205000430"; }
    return "3051300d060960864801650304020305000440";
}

/// Compares `n` bytes of `a` (from `aoff`) with `n` bytes of `b` (from `boff`)
/// for equality, in constant-shape time.
///
/// It ORs the XOR of every byte pair into an accumulator and checks that against
/// zero at the end, so it inspects all `n` bytes regardless of where a mismatch
/// occurs and never short-circuits. This keeps signature verification from
/// leaking, through timing, how much of the reconstructed padding matched.
fn memEq(a: ptr, aoff: int, b: ptr, boff: int, n: int): bool {
    let i = 0;
    let diff = 0;
    while (i < n) {
        diff = diff | (bytes.read_byte(a, aoff + i) ^ bytes.read_byte(b, boff + i));
        i = i + 1;
    }
    return diff == 0;
}


/// Verifies an RSASSA-PKCS1-v1.5 signature over a precomputed message hash.
///
/// `msgHash` is the already-computed digest of the signed message (its length
/// implied by `hashId`, using the encoding from [`hLen`]). `sig` is the raw
/// signature of `sigLen` bytes, `N`/`nLen` the modulus as big-endian bytes, and
/// `e`/`eLen` the public exponent as big-endian bytes. Returns true only if the
/// signature is valid.
///
/// The method reconstructs the expected EMSA-PKCS1-v1.5 encoding
/// (`00 01 FF..FF 00 || DigestInfo || hash`) and compares it against the value
/// recovered from the signature by [`rsaPublicOp`]. Rather than parse the
/// recovered block, it builds what a correct block must be and does one
/// constant-shape [`memEq`], which sidesteps the classic Bleichenbacher-style
/// parsing pitfalls. It rejects up front if `sigLen != nLen`, and treats a
/// padding string shorter than the mandated 8 bytes as invalid. All scratch
/// buffers are freed on every return path. See [`verifyPss`] for the PSS scheme.
pub fn verifyPkcs1(hashId: int, msgHash: ptr, sig: ptr, sigLen: int, N: ptr, nLen: int, e: ptr, eLen: int): bool {
    let k = nLen / 4;
    if (sigLen != nLen) { return false; }
    let hl = hLen(hashId);
    let Nl = bytes.alloc(k * 8); bnFromBE(Nl, N, 0, k);
    let em = bytes.alloc(nLen);
    let ok = rsaPublicOp(em, sig, Nl, k, e, eLen);
    if (ok == 0) { bytes.free(Nl); bytes.free(em); return false; }

    let psLen = nLen - 3 - 19 - hl;
    let good = psLen >= 8;
    let expected = bytes.alloc(nLen);
    bytes.write_byte(expected, 0, 0);
    bytes.write_byte(expected, 1, 1);
    let i = 0;
    while (i < psLen) { bytes.write_byte(expected, 2 + i, 0xff); i = i + 1; }
    bytes.write_byte(expected, 2 + psLen, 0);
    let dp = writeHex(expected, 3 + psLen, digestInfoHex(hashId));
    let j = 0;
    while (j < hl) { bytes.write_byte(expected, 3 + psLen + dp + j, bytes.read_byte(msgHash, j)); j = j + 1; }

    let matched = good && memEq(em, 0, expected, 0, nLen);
    bytes.free(Nl); bytes.free(em); bytes.free(expected);
    return matched;
}

/// MGF1 mask generation function (PKCS#1): expands `seed` into `outLen` mask
/// bytes at `out`, using the hash selected by `hashId`.
///
/// Produces the output by hashing `seed || counter` for a 4-byte big-endian
/// counter that increments from zero, concatenating the digests until enough
/// bytes are made, and truncating the last block. This is the deterministic
/// stream that both PSS ([`verifyPss`]) and OAEP ([`oaepEncryptSha1`]) use to mask
/// their data blocks and seeds. Note the loop advances `produced` by the full
/// digest length even on the final short block, which still terminates correctly
/// because only `take` bytes are written.
fn mgf1(hashId: int, seed: ptr, seedLen: int, out: ptr, outLen: int): void {
    let hl = hLen(hashId);
    let buf = bytes.alloc(seedLen + 4);
    let dg = bytes.alloc(hl);
    let i = 0;
    while (i < seedLen) { bytes.write_byte(buf, i, bytes.read_byte(seed, i)); i = i + 1; }
    let counter = 0;
    let produced = 0;
    while (produced < outLen) {
        bytes.write_byte(buf, seedLen, (counter >> 24) & 0xff);
        bytes.write_byte(buf, seedLen + 1, (counter >> 16) & 0xff);
        bytes.write_byte(buf, seedLen + 2, (counter >> 8) & 0xff);
        bytes.write_byte(buf, seedLen + 3, counter & 0xff);
        doHash(hashId, buf, seedLen + 4, dg);
        let take = hl;
        if (produced + take > outLen) { take = outLen - produced; }
        let j = 0;
        while (j < take) { bytes.write_byte(out, produced + j, bytes.read_byte(dg, j)); j = j + 1; }
        produced = produced + hl;
        counter = counter + 1;
    }
    bytes.free(buf); bytes.free(dg);
}

/// Verifies an RSASSA-PSS signature over a precomputed message hash.
///
/// Parameters mirror [`verifyPkcs1`]: `msgHash` is the message digest, `sig` the
/// signature, `N`/`nLen` the modulus, `e`/`eLen` the exponent. The salt length is
/// assumed EQUAL to the hash length (`sLen == hLen`), the common configuration;
/// it is not read from the encoding.
///
/// After recovering the encoded message with [`rsaPublicOp`], it follows
/// EMSA-PSS-VERIFY: it checks the trailing `0xbc` byte and the leading-zero bits
/// dictated by the exact modulus bit length (via [`bnBitLen`], since `emBits =
/// modBits - 1`), unmasks the data block with an [`mgf1`] mask keyed on the
/// embedded hash `H`, clears the top masked bits, checks the `00..00 01` padding
/// delimiter, then recomputes `H' = Hash(0x00 x8 || msgHash || salt)` and
/// compares it to `H` with the constant-shape [`memEq`]. Every failed sub-check
/// sets a `bad` flag that is folded into the final result rather than returning
/// early, so the checks run to completion. Rejects immediately if `sigLen != nLen`.
/// All scratch buffers are freed before returning.
pub fn verifyPss(hashId: int, msgHash: ptr, sig: ptr, sigLen: int, N: ptr, nLen: int, e: ptr, eLen: int): bool {
    let k = nLen / 4;
    if (sigLen != nLen) { return false; }
    let hl = hLen(hashId);
    let Nl = bytes.alloc(k * 8); bnFromBE(Nl, N, 0, k);
    let em = bytes.alloc(nLen);
    let ok = rsaPublicOp(em, sig, Nl, k, e, eLen);
    if (ok == 0) { bytes.free(Nl); bytes.free(em); return false; }

    let modBits = bnBitLen(Nl, k);
    let emBits = modBits - 1;
    let emLen = (emBits + 7) / 8;
    let off = nLen - emLen;
    let dbLen = emLen - hl - 1;
    let topBits = 8 * emLen - emBits;

    let bad = false;
    let li = 0;
    while (li < off) { if (bytes.read_byte(em, li) != 0) { bad = true; } li = li + 1; }
    if (bytes.read_byte(em, off + emLen - 1) != 0xbc) { bad = true; }
    let topZeroMask = (0xff << (8 - topBits)) & 0xff;
    if ((bytes.read_byte(em, off) & topZeroMask) != 0) { bad = true; }

    let hOff = off + dbLen;
    let H = bytes.alloc(hl);
    let i = 0;
    while (i < hl) { bytes.write_byte(H, i, bytes.read_byte(em, hOff + i)); i = i + 1; }

    let dbMask = bytes.alloc(dbLen);
    mgf1(hashId, H, hl, dbMask, dbLen);
    let db = bytes.alloc(dbLen);
    i = 0;
    while (i < dbLen) {
        bytes.write_byte(db, i, bytes.read_byte(em, off + i) ^ bytes.read_byte(dbMask, i));
        i = i + 1;
    }
    bytes.write_byte(db, 0, bytes.read_byte(db, 0) & (0xff >> topBits));

    let psEnd = dbLen - hl - 1;
    let pi = 0;
    while (pi < psEnd) { if (bytes.read_byte(db, pi) != 0) { bad = true; } pi = pi + 1; }
    if (bytes.read_byte(db, psEnd) != 1) { bad = true; }

    let mpLen = 8 + hl + hl;
    let mp = bytes.alloc(mpLen);
    i = 0;
    while (i < 8) { bytes.write_byte(mp, i, 0); i = i + 1; }
    i = 0;
    while (i < hl) { bytes.write_byte(mp, 8 + i, bytes.read_byte(msgHash, i)); i = i + 1; }
    i = 0;
    while (i < hl) { bytes.write_byte(mp, 8 + hl + i, bytes.read_byte(db, psEnd + 1 + i)); i = i + 1; }
    let hp = bytes.alloc(hl);
    doHash(hashId, mp, mpLen, hp);
    let matched = (!bad) && memEq(hp, 0, H, 0, hl);

    bytes.free(Nl); bytes.free(em); bytes.free(H); bytes.free(dbMask);
    bytes.free(db); bytes.free(mp); bytes.free(hp);
    return matched;
}


/// One parsed DER tag-length-value header.
///
/// Returned by [`readTlv`] to describe a single ASN.1 element without copying its
/// contents. The fields together let the caller both read the value and step to
/// the following element.
struct DerTlv {
    /// The ASN.1 tag byte, for example `0x30` for SEQUENCE, `0x02` for INTEGER,
    /// `0x03` for BIT STRING.
    pub tag: int,
    /// Byte offset (into the DER buffer) of the first content byte, just past the
    /// tag and length header.
    pub start: int,
    /// Length in bytes of the content.
    pub len: int,
    /// Byte offset of the next element, that is `start + len`.
    pub next: int
}

/// Parses the DER tag-length-value header at offset `pos` in `buf`.
///
/// Handles both short-form length (a single byte below `0x80`) and long-form
/// length (high bit set, low 7 bits giving the number of subsequent length
/// bytes, read big-endian). Returns a [`DerTlv`] locating the content and the
/// next element. This is a minimal reader: it assumes well-formed input and does
/// no bounds checking, which is why every caller in [`oaepEncryptSha1`] also
/// checks the tag it expects before trusting the fields.
fn readTlv(buf: ptr, pos: int): DerTlv {
    let tag = bytes.read_byte(buf, pos);
    let p = pos + 1;
    let b = bytes.read_byte(buf, p);
    p = p + 1;
    let len = 0;
    if (b < 0x80) {
        len = b;
    } else {
        let nb = b & 0x7f;
        let i = 0;
        while (i < nb) { len = (len << 8) | bytes.read_byte(buf, p); p = p + 1; i = i + 1; }
    }
    return DerTlv { tag: tag, start: p, len: len, next: p + len };
}

/// Returns the first index at or after `from` where `needle` occurs in `hay`, or
/// `-1` if it does not.
///
/// A plain O(n*m) substring scan over `string`s, sufficient for finding the short
/// fixed PEM boundary markers in [`pemToDer`]. Kyte strings index as bytes here,
/// so the comparison is byte-wise.
fn indexOf(hay: string, needle: string, from: int): int {
    let n = hay.length;
    let m = needle.length;
    let i = from;
    while (i + m <= n) {
        let j = 0;
        while (j < m && hay[i + j] == needle[j]) { j = j + 1; }
        if (j == m) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

/// Decodes a PEM-wrapped SubjectPublicKeyInfo into its raw DER bytes.
///
/// Locates the `-----BEGIN PUBLIC KEY-----` / `-----END PUBLIC KEY-----`
/// boundaries with [`indexOf`], strips whitespace (newline, carriage return,
/// space, tab) from the base64 body, and Base64-decodes it. Returns the DER as a
/// `string` of bytes, or `""` if either boundary is missing. Only the SPKI
/// `PUBLIC KEY` label is recognised; a PKCS#1 `RSA PUBLIC KEY` block would not
/// match. The intermediate scratch buffers are freed before returning.
fn pemToDer(pem: string): string {
    let begin = "-----BEGIN PUBLIC KEY-----";
    let end = "-----END PUBLIC KEY-----";
    let bs = indexOf(pem, begin, 0);
    if (bs < 0) { return ""; }
    let bodyStart = bs + begin.length;
    let es = indexOf(pem, end, bodyStart);
    if (es < 0) { return ""; }
    let clean = bytes.alloc(es - bodyStart);
    let n = 0;
    let i = bodyStart;
    while (i < es) {
        let c = pem[i];
        if (c != 10 && c != 13 && c != 32 && c != 9) { bytes.write_byte(clean, n, c); n = n + 1; }
        i = i + 1;
    }
    let b64 = bytes.alloc(n);
    let j = 0;
    while (j < n) { bytes.write_byte(b64, j, bytes.read_byte(clean, j)); j = j + 1; }
    bytes.free(clean);
    let s = base64.decode(b64 as string);
    bytes.free(b64);
    return s;
}

/// Encrypts `dataLen` bytes of `data` under the RSA public key in PEM `pem`, using
/// RSAES-OAEP with SHA-1 and MGF1-SHA-1; returns the ciphertext bytes, or `""` on
/// any failure.
///
/// The full flow: decode the PEM to DER via [`pemToDer`], walk the SPKI structure
/// with [`readTlv`] (SEQUENCE, algorithm SEQUENCE, BIT STRING, then the inner
/// RSAPublicKey SEQUENCE) to extract the modulus `N` and exponent `e`, strip any
/// ASN.1 leading zero byte from `N`, then build the OAEP encoded message. The
/// data block is `lHash || PS(00..00) || 01 || data` where `lHash` is the SHA-1 of
/// the empty label; it is masked with an [`mgf1`] mask driven by a random seed
/// from [`random.randomBytes`], and the seed is in turn masked by an MGF1 mask
/// driven by the masked data block. The assembled `00 || maskedSeed || maskedDB`
/// is then raised to `e mod N` by [`rsaPublicOp`].
///
/// Returns `""` if the DER is too short, any expected tag is wrong, the modulus
/// byte length is not a multiple of four (the limb code needs whole limbs), or
/// the message is too long for the key (`dataLen > k - 2*hLen - 2`). Every
/// intermediate buffer is freed on all paths. SHA-1 is fixed here because this
/// path targets peers that mandate OAEP-SHA-1; the label is always empty.
pub fn oaepEncryptSha1(pem: string, data: string, dataLen: int): string {
    let der = pemToDer(pem);
    if (der.length < 8) { return ""; }
    let derp = der as ptr;

    let outer = readTlv(derp, 0);
    if (outer.tag != 0x30) { return ""; }
    let alg = readTlv(derp, outer.start);
    let bitstr = readTlv(derp, alg.next);
    if (bitstr.tag != 0x03) { return ""; }
    let inner = readTlv(derp, bitstr.start + 1);
    if (inner.tag != 0x30) { return ""; }
    let nInt = readTlv(derp, inner.start);
    if (nInt.tag != 0x02) { return ""; }
    let ns = nInt.start; let nl = nInt.len;
    if (bytes.read_byte(derp, ns) == 0) { ns = ns + 1; nl = nl - 1; }
    let eInt = readTlv(derp, nInt.next);
    if (eInt.tag != 0x02) { return ""; }

    let k = nl;
    if ((k & 3) != 0) { return ""; }
    let hl = 20;
    if (dataLen > k - 2 * hl - 2) { return ""; }

    let nBytes = bytes.alloc(k);
    let ci = 0;
    while (ci < k) { bytes.write_byte(nBytes, ci, bytes.read_byte(derp, ns + ci)); ci = ci + 1; }
    let eBytes = bytes.alloc(eInt.len);
    ci = 0;
    while (ci < eInt.len) { bytes.write_byte(eBytes, ci, bytes.read_byte(derp, eInt.start + ci)); ci = ci + 1; }

    let dbLen = k - hl - 1;
    let db = bytes.alloc(dbLen);
    let dummy = bytes.alloc(1);
    doHash(3, dummy, 0, db);
    bytes.free(dummy);
    let psLen = dbLen - hl - 1 - dataLen;
    let p = hl;
    let z = 0;
    while (z < psLen) { bytes.write_byte(db, p, 0); p = p + 1; z = z + 1; }
    bytes.write_byte(db, p, 1); p = p + 1;
    z = 0;
    while (z < dataLen) { bytes.write_byte(db, p, bytes.read_byte(data as ptr, z)); p = p + 1; z = z + 1; }

    let seed = bytes.alloc(hl);
    let rnd = random.randomBytes(hl);
    z = 0;
    while (z < hl) { bytes.write_byte(seed, z, bytes.read_byte(rnd as ptr, z)); z = z + 1; }

    let dbMask = bytes.alloc(dbLen);
    mgf1(3, seed, hl, dbMask, dbLen);
    let maskedDb = bytes.alloc(dbLen);
    z = 0;
    while (z < dbLen) { bytes.write_byte(maskedDb, z, bytes.read_byte(db, z) ^ bytes.read_byte(dbMask, z)); z = z + 1; }

    let seedMask = bytes.alloc(hl);
    mgf1(3, maskedDb, dbLen, seedMask, hl);
    let maskedSeed = bytes.alloc(hl);
    z = 0;
    while (z < hl) { bytes.write_byte(maskedSeed, z, bytes.read_byte(seed, z) ^ bytes.read_byte(seedMask, z)); z = z + 1; }

    let em = bytes.alloc(k);
    bytes.write_byte(em, 0, 0);
    z = 0;
    while (z < hl) { bytes.write_byte(em, 1 + z, bytes.read_byte(maskedSeed, z)); z = z + 1; }
    z = 0;
    while (z < dbLen) { bytes.write_byte(em, 1 + hl + z, bytes.read_byte(maskedDb, z)); z = z + 1; }

    let kw = k / 4;
    let Nl = bytes.alloc(kw * 8); bnFromBE(Nl, nBytes, 0, kw);
    let ct = bytes.alloc(k);
    let ok = rsaPublicOp(ct, em, Nl, kw, eBytes, eInt.len);

    bytes.free(nBytes); bytes.free(eBytes); bytes.free(db); bytes.free(seed);
    bytes.free(dbMask); bytes.free(maskedDb); bytes.free(seedMask); bytes.free(maskedSeed);
    bytes.free(em); bytes.free(Nl);

    if (ok == 0) { bytes.free(ct); return ""; }
    return ct as string;
}
