//! TLS 1.2 client handshake and record layer (`TlsClient12`).
//!
//! This file is the pure-Kyte state machine for the client half of a TLS 1.2
//! connection. It builds the handshake messages a client sends (ClientHello,
//! ClientKeyExchange, and optionally Certificate + CertificateVerify), parses
//! the ones the server sends (ServerHello, Certificate, ServerKeyExchange),
//! derives the session keys, and then seals and opens application records under
//! AES-GCM. It does NOT do any I/O: a caller elsewhere in the runtime owns the
//! socket, reads and writes raw record bytes, and drives this object through the
//! handshake one message at a time. Keeping the crypto and framing here, free of
//! sockets, is deliberate: it mirrors the wolfSSL memory-BIO arrangement the
//! runtime uses, where Kyte pumps bytes and the crypto core never touches the
//! network.
//!
//! Scope is intentionally narrow. Only the modern ECDHE cipher suites with
//! AES-GCM are supported (see the `CS_*` constants), because those are the only
//! ones a current server needs to be offered. Static-RSA key transport,
//! CBC-mode suites, and compression are all omitted by design, since they are
//! either insecure or obsolete. Key exchange is always ephemeral, over either
//! X25519 or NIST P-256 (secp256r1), and server authentication is verified with
//! RSA PKCS#1 v1.5 or ECDSA/P-256 depending on the certificate's key type.
//!
//! Memory model. This module works almost entirely in raw `ptr` buffers rather
//! than owned Kyte values, because it sits directly on the wire format and every
//! field is a fixed run of bytes at a known offset. The buffers are allocated
//! with [`bytes.alloc`] and freed with [`bytes.free`]; the long-lived ones hang
//! off the [`TlsClient12`] struct and are seeded in [`newClient12`] so that the
//! `free`-then-`alloc` replace pattern (used when a real value arrives) always
//! has something valid to free. Short-lived scratch buffers inside a method are
//! freed before it returns. Because these are raw addresses, they are declared
//! `ptr`/`long`, never `int`: a 64-bit heap address truncated to 32 bits would
//! become a garbage pointer.
//!
//! Transcript hashing. TLS binds the Finished message to a running hash of every
//! handshake message exchanged. That transcript is accumulated in the `tr`
//! buffer via [`TlsClient12.addTr`], which every process/build method calls, and
//! hashed on demand by [`TlsClient12.trHash`] using the suite's PRF hash
//! (SHA-256, or SHA-384 for the AES-256 suites). The same transcript feeds the
//! extended master secret when the server offers it (RFC 7627), the Finished
//! verify_data, and the CertificateVerify signature.
//!
//! This is the TLS 1.2 sibling of the TLS 1.3 client under `crypto/tls/13`. It
//! exists because real servers, and especially older ones, still negotiate down
//! to 1.2, so a client that only spoke 1.3 could not connect to them.

import bytes;
import crypto.tls.12.prf;
import crypto.hash.sha256;
import crypto.hash.sha512;
import crypto.mac.hmac;
import crypto.aead.aesgcm;
import crypto.ecc.p256;
import crypto.ecc.x25519;
import crypto.rsa;
import crypto.x509;
import crypto.random;
import assert;

/// Cipher suite ECDHE-RSA with AES-128-GCM and SHA-256 (IANA `0xC02F`).
///
/// The RSA here is only for the server's signature over the key exchange; the
/// key agreement is still ephemeral ECDHE. AES-128 pairs with the SHA-256 PRF,
/// which [`TlsClient12.applySuite`] selects.
const CS_ECDHE_RSA_AES128_GCM: int = 0xc02f;
/// Cipher suite ECDHE-RSA with AES-256-GCM and SHA-384 (IANA `0xC030`).
///
/// Same RSA-signed ECDHE as [`CS_ECDHE_RSA_AES128_GCM`], but the larger key
/// switches the PRF hash to SHA-384 in [`TlsClient12.applySuite`].
const CS_ECDHE_RSA_AES256_GCM: int = 0xc030;
/// Cipher suite ECDHE-ECDSA with AES-128-GCM and SHA-256 (IANA `0xC02B`).
///
/// The server authenticates with an ECDSA/P-256 certificate rather than RSA,
/// which flips `isEcdsa` in [`TlsClient12.applySuite`] and routes signature
/// verification through P-256 in [`TlsClient12.processServerKeyExchange`].
const CS_ECDHE_ECDSA_AES128_GCM: int = 0xc02b;
/// Cipher suite ECDHE-ECDSA with AES-256-GCM and SHA-384 (IANA `0xC02C`).
///
/// The ECDSA counterpart of [`CS_ECDHE_RSA_AES256_GCM`]: SHA-384 PRF plus an
/// ECDSA-signed key exchange.
const CS_ECDHE_ECDSA_AES256_GCM: int = 0xc02c;

/// Named-group identifier for NIST P-256 / secp256r1 (IANA `23`).
///
/// Used both as a `supported_groups` entry in [`buildClientHello`] and to decide
/// which curve [`TlsClient12.buildClientKeyExchange`] uses when the server picks
/// this group in its ServerKeyExchange.
const GRP_SECP256R1: int = 23;
/// Named-group identifier for X25519 (IANA `29`).
///
/// The client's preferred group: it is offered first in [`buildClientHello`],
/// and when the server selects it [`TlsClient12.buildClientKeyExchange`] does the
/// Montgomery-curve scalar multiplication instead of P-256 ECDH.
const GRP_X25519: int = 29;

/// Returns a `ptr` pointing `off` bytes into buffer `b`.
///
/// The addition is done at `long` width before the cast back to `ptr`, so it is
/// safe for the full 64-bit address range; a plain `int` add would truncate.
/// Used to hand a sub-slice of a wire buffer to a parser without copying.
fn at(b: ptr, off: int): ptr { return (b as long + off) as ptr; }
/// Reads a big-endian 16-bit unsigned integer at offset `o` in buffer `b`.
///
/// The wire format is network byte order throughout TLS, so the high byte comes
/// first. The counterpart writer is [`writeU16`].
fn rd16(b: ptr, o: int): int { return (bytes.read_byte(b, o) << 8) | bytes.read_byte(b, o + 1); }
/// Reads a big-endian 24-bit unsigned integer at offset `o` in buffer `b`.
///
/// TLS uses 24-bit lengths for handshake message bodies and certificate lists,
/// which is why this three-byte reader exists alongside [`rd16`].
fn rd24(b: ptr, o: int): int { return (bytes.read_byte(b, o) << 16) | (bytes.read_byte(b, o + 1) << 8) | bytes.read_byte(b, o + 2); }

/// The full state of one TLS 1.2 client handshake and its established session.
///
/// A single instance carries a connection from ClientHello all the way through
/// to sealing and opening application records. It is created by [`newClient12`],
/// which allocates every buffer field, and then driven message by message by an
/// I/O owner elsewhere. The struct is used by reference (its methods mutate
/// `self`'s buffers in place), not copied around. There is no explicit destructor
/// here, so the owning code is responsible for freeing the buffers at end of
/// session.
pub struct TlsClient12 {
    /// The 32-byte client random, chosen before ClientHello and fed into the PRF
    /// seed. Also the first half of the ServerKeyExchange signed blob.
    pub clientRandom: ptr, /// The 32-byte server random, copied out of ServerHello by [`TlsClient12.processServerHello`].
    pub serverRandom: ptr,
    /// The negotiated cipher suite, one of the `CS_*` constants, set from ServerHello.
    pub suite: int, /// PRF hash selector: `0` for SHA-256, `1` for SHA-384. Derived from `suite` by [`TlsClient12.applySuite`].
    pub prfHash: int, /// AES key length in bytes (16 or 32), also derived from `suite`.
    pub keyLen: int, /// True when the negotiated suite authenticates the server with ECDSA rather than RSA.
    pub isEcdsa: bool,
    /// The named group the server selected for ECDHE, either [`GRP_X25519`] or [`GRP_SECP256R1`].
    pub group: int,
    /// The client's ephemeral private key for this handshake (32 bytes for both curves).
    pub ephPriv: ptr, /// The client's ephemeral public key (32 bytes for X25519, 65 for uncompressed P-256).
    pub ephPub: ptr, /// Byte length of `ephPub`.
    pub ephPubLen: int,
    /// The server's ephemeral public key, copied out of ServerKeyExchange.
    pub serverEph: ptr, /// Byte length of `serverEph`.
    pub serverEphLen: int,
    /// True when the server agreed to the extended master secret extension (RFC 7627). Changes how the master secret is derived; see [`TlsClient12.buildClientKeyExchange`].
    pub ems: bool,

    /// Server certificate public-key type: `0` for RSA, non-zero for EC. Set by [`TlsClient12.processCertificate`] from the parsed certificate.
    pub keyType: int,
    /// RSA modulus bytes of the server key, populated only when `keyType == 0`.
    pub rsaN: ptr, /// Length of `rsaN`.
    pub rsaNLen: int, /// RSA public exponent bytes of the server key.
    pub rsaE: ptr, /// Length of `rsaE`.
    pub rsaELen: int,
    /// The server's EC public point (65 bytes, uncompressed), populated for an EC certificate.
    pub ecPub: ptr,
    /// Raw copy of the server's certificate list bytes, kept so the caller can validate the chain.
    pub certList: ptr, /// Length of `certList`.
    pub certListLen: int,

    /// The 48-byte master secret, filled by the PRF once the pre-master secret is known.
    pub master: ptr,
    /// Client write key (application traffic key the client encrypts with).
    pub cWriteKey: ptr, /// Server write key (the key the client decrypts server traffic with).
    pub sWriteKey: ptr,
    /// Lazily created AES-GCM context for the client write key. `undefined` until the first [`TlsClient12.sealRecord`].
    pub cGcm: aesgcm.GcmContext | undefined, /// Lazily created AES-GCM context for the server write key. `undefined` until the first [`TlsClient12.openRecord`].
    pub sGcm: aesgcm.GcmContext | undefined,
    /// The 4-byte client fixed IV (implicit nonce prefix) from the key block.
    pub cIV: ptr, /// The 4-byte server fixed IV from the key block.
    pub sIV: ptr,
    /// Client record sequence number, the GCM explicit-nonce counter, incremented per sealed record.
    pub cSeq: ulong, /// Server record sequence number, incremented per opened record.
    pub sSeq: ulong,

    /// Growable transcript buffer: every handshake message appended in order for the Finished/EMS/CertVerify hash.
    pub tr: ptr, /// Bytes currently used in `tr`.
    pub trLen: int, /// Allocated capacity of `tr`; [`TlsClient12.addTr`] doubles it when full.
    pub trCap: int,

    /// True if the server sent a CertificateRequest (the caller must then send a client Certificate).
    pub certRequested: bool, /// True once a client certificate and key have been installed via [`setClientCert12`].
    pub haveClientCert: bool,
    /// The client certificate in DER form, sent in the client Certificate message.
    pub clientCertDer: ptr, /// Length of `clientCertDer`.
    pub clientCertLen: int,
    /// The 32-byte client private key used to sign CertificateVerify.
    pub clientKey: ptr,

    /// Appends `n` bytes of a handshake message to the transcript buffer, growing it if needed.
    ///
    /// Every process/build method funnels its message through here so the running
    /// transcript stays complete and in order. When the incoming bytes would
    /// overflow `trCap`, the buffer is reallocated to twice the required size, the
    /// existing bytes are copied across, and the old allocation is freed. This is
    /// the only place `tr` grows.
    pub fn addTr(self: TlsClient12, msg: ptr, n: int): void {
        if (self.trLen + n > self.trCap) {
            let nc = (self.trLen + n) * 2;
            let nb = bytes.alloc(nc);
            let i = 0;
            while (i < self.trLen) { bytes.write_byte(nb, i, bytes.read_byte(self.tr, i)); i = i + 1; }
            bytes.free(self.tr); self.tr = nb; self.trCap = nc;
        }
        let i = 0;
        while (i < n) { bytes.write_byte(self.tr, self.trLen + i, bytes.read_byte(msg, i)); i = i + 1; }
        self.trLen = self.trLen + n;
    }

    /// Hashes the whole transcript so far into `out` using the suite's PRF hash.
    ///
    /// SHA-384 for the AES-256 suites (`prfHash == 1`), SHA-256 otherwise. The
    /// caller must size `out` to match: 48 bytes for SHA-384, 32 for SHA-256, as
    /// reported by [`TlsClient12.prfHashLen`]. Used for the Finished verify_data,
    /// the extended master secret, and CertificateVerify.
    pub fn trHash(self: TlsClient12, out: ptr): void {
        if (self.prfHash == 1) { sha512.hash384Into(self.tr, self.trLen, out); return; }
        sha256.hashInto(self.tr, self.trLen, out);
    }
    /// Returns the digest length in bytes of the suite's PRF hash: 48 for SHA-384, else 32.
    ///
    /// A small helper so callers can size the buffer they pass to
    /// [`TlsClient12.trHash`] without duplicating the `prfHash` test.
    fn prfHashLen(self: TlsClient12): int { if (self.prfHash == 1) { return 48; } return 32; }

    /// Parses the server's ServerHello: extracts the server random, chosen suite, and extensions.
    ///
    /// Walks the message past the 2-byte version and 32-byte random, skips the
    /// echoed session id (length-prefixed), reads the negotiated cipher suite (and
    /// applies it via [`TlsClient12.applySuite`]), skips the one-byte compression
    /// method, then scans the extension block looking only for extension type 23,
    /// extended master secret, which sets `ems`. The message is added to the
    /// transcript first. Offsets are trusted to be well formed, this being a
    /// client that has just offered these exact fields.
    pub fn processServerHello(self: TlsClient12, msg: ptr, n: int): void {
        self.addTr(msg, n);
        let p = 4 + 2;
        let i = 0;
        while (i < 32) { bytes.write_byte(self.serverRandom, i, bytes.read_byte(msg, p + i)); i = i + 1; }
        p = p + 32;
        let sidLen = bytes.read_byte(msg, p); p = p + 1 + sidLen;
        self.suite = rd16(msg, p); p = p + 2;
        p = p + 1;
        self.applySuite();
        if (p + 2 <= n) {
            let extLen = rd16(msg, p); p = p + 2;
            let end = p + extLen;
            while (p + 4 <= end) {
                let etype = rd16(msg, p);
                let elen = rd16(msg, p + 2);
                if (etype == 23) { self.ems = true; }
                p = p + 4 + elen;
            }
        }
    }

    /// Derives the PRF hash, AES key length, and RSA-vs-ECDSA flag from the negotiated `suite`.
    ///
    /// The AES-256 suites use the SHA-384 PRF and a 32-byte key; everything else
    /// uses SHA-256 and 16 bytes. `isEcdsa` is set for the two ECDSA suites so the
    /// signature check in [`TlsClient12.processServerKeyExchange`] picks the right
    /// algorithm. Called from [`TlsClient12.processServerHello`] once the suite is known.
    fn applySuite(self: TlsClient12): void {
        if (self.suite == CS_ECDHE_RSA_AES256_GCM || self.suite == CS_ECDHE_ECDSA_AES256_GCM) {
            self.prfHash = 1; self.keyLen = 32;
        } else {
            self.prfHash = 0; self.keyLen = 16;
        }
        self.isEcdsa = (self.suite == CS_ECDHE_ECDSA_AES128_GCM || self.suite == CS_ECDHE_ECDSA_AES256_GCM);
    }

    /// Parses the server Certificate message and extracts the leaf's public key.
    ///
    /// The message holds a 3-byte total list length followed by entries, each a
    /// 3-byte length then DER. This copies the whole list into `certList` (so the
    /// caller can validate the chain), then parses only the FIRST (leaf)
    /// certificate via [`x509.parseCert`]. From it, either the RSA modulus and
    /// exponent (`keyType == 0`) or the 65-byte EC public point are copied into the
    /// struct; those keys later verify the ServerKeyExchange signature. Any
    /// previous `certList` is freed before the new one is allocated. The message is
    /// added to the transcript first.
    pub fn processCertificate(self: TlsClient12, msg: ptr, n: int): void {
        self.addTr(msg, n);
        let certsLen = rd24(msg, 4);
        bytes.free(self.certList);
        self.certList = bytes.alloc(certsLen);
        let cli = 0;
        while (cli < certsLen) { bytes.write_byte(self.certList, cli, bytes.read_byte(msg, 7 + cli)); cli = cli + 1; }
        self.certListLen = certsLen;
        let certLen = rd24(msg, 7);
        let certOff = 10;
        let cert = x509.parseCert(at(msg, certOff), certLen);
        self.keyType = cert.keyType;
        if (cert.keyType == 0) {
            self.rsaNLen = cert.rsaNLen; self.rsaN = bytes.alloc(cert.rsaNLen);
            let i = 0;
            while (i < cert.rsaNLen) { bytes.write_byte(self.rsaN, i, bytes.read_byte(msg, certOff + cert.rsaNStart + i)); i = i + 1; }
            self.rsaELen = cert.rsaELen; self.rsaE = bytes.alloc(cert.rsaELen);
            i = 0;
            while (i < cert.rsaELen) { bytes.write_byte(self.rsaE, i, bytes.read_byte(msg, certOff + cert.rsaEStart + i)); i = i + 1; }
        } else {
            self.ecPub = bytes.alloc(65);
            let i = 0;
            while (i < 65) { bytes.write_byte(self.ecPub, i, bytes.read_byte(msg, certOff + cert.ecStart + i)); i = i + 1; }
        }
    }

    /// Returns the raw pointer to the stored server certificate list bytes.
    ///
    /// Exposed so the caller can run its own chain validation against the bytes
    /// captured by [`TlsClient12.processCertificate`]; pair with [`TlsClient12.certListSize`].
    pub fn certListPtr(self: TlsClient12): ptr { return self.certList; }
    /// Returns the byte length of the stored certificate list. Companion to [`TlsClient12.certListPtr`].
    pub fn certListSize(self: TlsClient12): int { return self.certListLen; }

    /// Parses ServerKeyExchange, saves the server's ephemeral key, and VERIFIES its signature.
    ///
    /// Reads the ECDHE server params (curve type, named group, and the ephemeral
    /// public key, which is stored in `serverEph`), then reconstructs the exact
    /// blob the server signed: client random, server random, and the raw ECDHE
    /// params, concatenated in that order. It hashes that blob with the hash named
    /// by the signature's `sigHash` byte (SHA-256/384/512) and checks the signature
    /// with RSA PKCS#1 v1.5 ([`rsa.verifyPkcs1`]) or ECDSA/P-256
    /// ([`p256.ecdsaVerify`]) according to `sigAlg`. Returns true only if the
    /// signature verifies. A false return means the server failed authentication
    /// and the handshake MUST be aborted. All scratch buffers are freed before
    /// return. The message is added to the transcript first.
    pub fn processServerKeyExchange(self: TlsClient12, msg: ptr, n: int): bool {
        self.addTr(msg, n);
        let p = 4;
        let curveType = bytes.read_byte(msg, p); p = p + 1;
        self.group = rd16(msg, p); p = p + 2;
        let pubLen = bytes.read_byte(msg, p);
        let paramsStart = 4;
        let paramsLen = 1 + 2 + 1 + pubLen;
        self.serverEphLen = pubLen; self.serverEph = bytes.alloc(pubLen);
        let i = 0;
        while (i < pubLen) { bytes.write_byte(self.serverEph, i, bytes.read_byte(msg, p + 1 + i)); i = i + 1; }
        p = p + 1 + pubLen;

        let sigHash = bytes.read_byte(msg, p);
        let sigAlg = bytes.read_byte(msg, p + 1);
        let sigLen = rd16(msg, p + 2);
        let sigOff = p + 4;

        let signed = bytes.alloc(64 + paramsLen);
        i = 0;
        while (i < 32) { bytes.write_byte(signed, i, bytes.read_byte(self.clientRandom, i)); i = i + 1; }
        i = 0;
        while (i < 32) { bytes.write_byte(signed, 32 + i, bytes.read_byte(self.serverRandom, i)); i = i + 1; }
        i = 0;
        while (i < paramsLen) { bytes.write_byte(signed, 64 + i, bytes.read_byte(msg, paramsStart + i)); i = i + 1; }

        let hl = 32; let hid = 0;
        if (sigHash == 5) { hl = 48; hid = 1; } else if (sigHash == 6) { hl = 64; hid = 2; }
        let h = bytes.alloc(hl);
        if (sigHash == 5) { sha512.hash384Into(signed, 64 + paramsLen, h); }
        else if (sigHash == 6) { sha512.hashInto(signed, 64 + paramsLen, h); }
        else { sha256.hashInto(signed, 64 + paramsLen, h); }

        let ok = false;
        if (sigAlg == 1) {
            ok = rsa.verifyPkcs1(hid, h, at(msg, sigOff), sigLen, self.rsaN, self.rsaNLen, self.rsaE, self.rsaELen);
        } else {
            let r = bytes.alloc(32); let s = bytes.alloc(32);
            parseEcdsaSig(at(msg, sigOff), sigLen, r, s);
            let h32 = bytes.alloc(32);
            i = 0;
            while (i < 32) { bytes.write_byte(h32, i, bytes.read_byte(h, i)); i = i + 1; }
            ok = p256.ecdsaVerify(h32, self.ecPub, r, s);
            bytes.free(r); bytes.free(s); bytes.free(h32);
        }
        bytes.free(signed); bytes.free(h);
        return ok;
    }

    /// Builds the ClientKeyExchange message and derives all session keys from the shared secret.
    ///
    /// Generates the client's ephemeral key pair on the negotiated curve (X25519
    /// or P-256), does the ECDH agreement against `serverEph` to get the 32-byte
    /// pre-master secret, and serialises the handshake message (type `0x10`, a
    /// one-byte public-key length, then the public key) into `out`. It then derives
    /// the keys: for a normal handshake [`TlsClient12.deriveKeys`] runs the PRF
    /// immediately, but with extended master secret the message must first be added
    /// to the transcript (which this does via [`TlsClient12.addTr`]) so
    /// [`TlsClient12.deriveMasterEms`] can hash it in, after which
    /// [`TlsClient12.deriveKeyBlock`] splits out the traffic keys. Returns the total
    /// message length written. The pre-master buffer is freed before return.
    pub fn buildClientKeyExchange(self: TlsClient12, out: ptr): int {
        let pms = bytes.alloc(32);
        if (self.group == GRP_X25519) {
            self.ephPriv = bytes.alloc(32); fillRandom(self.ephPriv, 32);
            let base = bytes.alloc(32); bytes.write_byte(base, 0, 9);
            self.ephPub = bytes.alloc(32); x25519.scalarMult(self.ephPub, self.ephPriv, base);
            self.ephPubLen = 32;
            x25519.scalarMult(pms, self.ephPriv, self.serverEph);
            bytes.free(base);
        } else {
            self.ephPriv = bytes.alloc(32); fillRandom(self.ephPriv, 32);
            self.ephPub = bytes.alloc(65); p256.derivePublic(self.ephPub, self.ephPriv);
            self.ephPubLen = 65;
            p256.ecdh(pms, self.ephPriv, self.serverEph);
        }

        let bodyLen = 1 + self.ephPubLen;
        bytes.write_byte(out, 0, 0x10);
        bytes.write_byte(out, 1, (bodyLen >> 16) & 0xff); bytes.write_byte(out, 2, (bodyLen >> 8) & 0xff); bytes.write_byte(out, 3, bodyLen & 0xff);
        bytes.write_byte(out, 4, self.ephPubLen);
        let i = 0;
        while (i < self.ephPubLen) { bytes.write_byte(out, 5 + i, bytes.read_byte(self.ephPub, i)); i = i + 1; }
        let ckeLen = 5 + self.ephPubLen;

        self.deriveKeys(pms);
        self.addTr(out, ckeLen);
        if (self.ems) { self.deriveMasterEms(pms); self.deriveKeyBlock(); }
        bytes.free(pms);
        return ckeLen;
    }

    /// Derives the master secret from the pre-master secret for a NON-EMS handshake.
    ///
    /// This is the classic TLS 1.2 derivation: the PRF over the pre-master secret
    /// with the label "master secret" and a seed of client random followed by
    /// server random, producing the 48-byte master secret, then
    /// [`TlsClient12.deriveKeyBlock`] for the traffic keys. It is a no-op when `ems`
    /// is set, because the extended master secret path
    /// ([`TlsClient12.deriveMasterEms`]) is used instead. The seed and label
    /// scratch buffers are freed before return.
    fn deriveKeys(self: TlsClient12, pms: ptr): void {
        if (!self.ems) {
            let seed = bytes.alloc(64);
            let i = 0;
            while (i < 32) { bytes.write_byte(seed, i, bytes.read_byte(self.clientRandom, i)); i = i + 1; }
            i = 0;
            while (i < 32) { bytes.write_byte(seed, 32 + i, bytes.read_byte(self.serverRandom, i)); i = i + 1; }
            let label = labelBuf("master secret");
            prf.prf(self.prfHash, pms, 32, label, 13, seed, 64, self.master, 48);
            bytes.free(seed); bytes.free(label);
            self.deriveKeyBlock();
        }
    }

    /// Derives the EXTENDED master secret (RFC 7627) from the pre-master secret.
    ///
    /// Instead of the client and server randoms, the seed is the hash of the
    /// handshake transcript up to and including ClientKeyExchange (via
    /// [`TlsClient12.trHash`]), with the label "extended master secret". Binding the
    /// master secret to the full transcript closes the triple-handshake class of
    /// attacks. Used only when the server agreed to `ems`. The transcript-hash and
    /// label buffers are freed before return.
    fn deriveMasterEms(self: TlsClient12, pms: ptr): void {
        let sh = bytes.alloc(self.prfHashLen());
        self.trHash(sh);
        let label = labelBuf("extended master secret");
        prf.prf(self.prfHash, pms, 32, label, 22, sh, self.prfHashLen(), self.master, 48);
        bytes.free(sh); bytes.free(label);
    }

    /// Expands the master secret into the client/server write keys and fixed IVs.
    ///
    /// Runs the PRF with the label "key expansion" and a seed of server random
    /// followed by client random (note the reversed order versus the master-secret
    /// seed, which the RFC mandates), producing a key block of `keyLen*2 + 8` bytes.
    /// It is sliced into the client write key, the server write key, the 4-byte
    /// client fixed IV, and the 4-byte server fixed IV, in that order. There are no
    /// MAC keys because AES-GCM is AEAD. Called from both derivation paths once the
    /// master secret exists. Scratch buffers are freed before return.
    fn deriveKeyBlock(self: TlsClient12): void {
        let seed = bytes.alloc(64);
        let i = 0;
        while (i < 32) { bytes.write_byte(seed, i, bytes.read_byte(self.serverRandom, i)); i = i + 1; }
        i = 0;
        while (i < 32) { bytes.write_byte(seed, 32 + i, bytes.read_byte(self.clientRandom, i)); i = i + 1; }
        let need = self.keyLen * 2 + 8;
        let kb = bytes.alloc(need);
        let label = labelBuf("key expansion");
        prf.prf(self.prfHash, self.master, 48, label, 13, seed, 64, kb, need);
        self.cWriteKey = bytes.alloc(self.keyLen); self.sWriteKey = bytes.alloc(self.keyLen);
        self.cIV = bytes.alloc(4); self.sIV = bytes.alloc(4);
        i = 0;
        while (i < self.keyLen) { bytes.write_byte(self.cWriteKey, i, bytes.read_byte(kb, i)); i = i + 1; }
        i = 0;
        while (i < self.keyLen) { bytes.write_byte(self.sWriteKey, i, bytes.read_byte(kb, self.keyLen + i)); i = i + 1; }
        i = 0;
        while (i < 4) { bytes.write_byte(self.cIV, i, bytes.read_byte(kb, self.keyLen * 2 + i)); i = i + 1; }
        i = 0;
        while (i < 4) { bytes.write_byte(self.sIV, i, bytes.read_byte(kb, self.keyLen * 2 + 4 + i)); i = i + 1; }
        bytes.free(seed); bytes.free(kb); bytes.free(label);
    }

    /// Computes the 12-byte client Finished verify_data into `out12`.
    ///
    /// The PRF over the master secret with the label "client finished" and the seed
    /// being the transcript hash at this point. This value goes in the client's
    /// Finished message and proves the client saw the same handshake. Call it after
    /// the transcript includes everything up to (but not including) the client
    /// Finished. Companion to [`TlsClient12.serverVerifyData`].
    pub fn clientVerifyData(self: TlsClient12, out12: ptr): void {
        let h = bytes.alloc(self.prfHashLen());
        self.trHash(h);
        let label = labelBuf("client finished");
        prf.prf(self.prfHash, self.master, 48, label, 15, h, self.prfHashLen(), out12, 12);
        bytes.free(h); bytes.free(label);
    }

    /// Computes the EXPECTED 12-byte server Finished verify_data into `out12`.
    ///
    /// Same PRF construction as [`TlsClient12.clientVerifyData`] but with the label
    /// "server finished". The caller compares this against the verify_data in the
    /// server's Finished message; a mismatch means the handshake was tampered with
    /// and must be aborted. The transcript at call time must include the client
    /// Finished, since the server's is computed over it.
    pub fn serverVerifyData(self: TlsClient12, out12: ptr): void {
        let h = bytes.alloc(self.prfHashLen());
        self.trHash(h);
        let label = labelBuf("server finished");
        prf.prf(self.prfHash, self.master, 48, label, 15, h, self.prfHashLen(), out12, 12);
        bytes.free(h); bytes.free(label);
    }

    /// Encrypts one outgoing record under AES-128/256-GCM, returning the ciphertext length.
    ///
    /// Builds the 12-byte GCM nonce as the 4-byte client fixed IV followed by the
    /// 8-byte record sequence number, writes that explicit 8-byte nonce as the first
    /// bytes of `out` (the TLS 1.2 GCM record layout), constructs the 13-byte
    /// additional authenticated data (sequence number, content type, version
    /// `0x0303`, and plaintext length), then seals plaintext `pt` into `out` after
    /// the explicit nonce and appends the 16-byte tag. The GCM context is created
    /// lazily on first use and cached in `cGcm`. `cSeq` is incremented so the next
    /// record gets a fresh nonce; reusing a GCM nonce would be catastrophic, which
    /// is why the counter is per-record. Returns `8 + ptLen + 16`, the total record
    /// fragment length. Scratch buffers are freed before return. Inverse of
    /// [`TlsClient12.openRecord`].
    pub fn sealRecord(self: TlsClient12, ctype: int, pt: ptr, ptLen: int, out: ptr): int {
        let nonce = bytes.alloc(12);
        let i = 0;
        while (i < 4) { bytes.write_byte(nonce, i, bytes.read_byte(self.cIV, i)); i = i + 1; }
        writeU64(nonce, 4, self.cSeq);
        i = 0;
        while (i < 8) { bytes.write_byte(out, i, bytes.read_byte(nonce, 4 + i)); i = i + 1; }
        let aad = bytes.alloc(13);
        writeU64(aad, 0, self.cSeq);
        bytes.write_byte(aad, 8, ctype); bytes.write_byte(aad, 9, 0x03); bytes.write_byte(aad, 10, 0x03);
        bytes.write_byte(aad, 11, (ptLen >> 8) & 0xff); bytes.write_byte(aad, 12, ptLen & 0xff);
        let tag = bytes.alloc(16);
        if (self.cGcm == undefined) { self.cGcm = aesgcm.GcmContext.create(self.cWriteKey, self.keyLen); }
        let cg = self.cGcm;
        if (cg != undefined) { cg.seal(nonce, 12, aad, 13, pt, ptLen, at(out, 8), tag); }
        i = 0;
        while (i < 16) { bytes.write_byte(out, 8 + ptLen + i, bytes.read_byte(tag, i)); i = i + 1; }
        self.cSeq = self.cSeq + 1;
        bytes.free(nonce); bytes.free(aad); bytes.free(tag);
        return 8 + ptLen + 16;
    }

    /// Decrypts and authenticates one incoming record, returning the plaintext length or `-1`.
    ///
    /// The mirror of [`TlsClient12.sealRecord`] for server traffic. The record
    /// fragment `frag` is the 8-byte explicit nonce, then the ciphertext, then the
    /// 16-byte tag; the ciphertext length is `fragLen - 8 - 16`. The nonce is the
    /// 4-byte server fixed IV plus the explicit 8 bytes from the fragment, and the
    /// AAD uses the server sequence number and the recovered ciphertext length. GCM
    /// open both decrypts into `out` and checks the tag. `sSeq` is incremented
    /// regardless of outcome. Returns the plaintext length on success, or `0 - 1`
    /// (that is, `-1`) if the fragment is too short or the tag fails to verify; a
    /// negative return means the record is forged or corrupt and must be rejected.
    /// Scratch buffers are freed before return.
    pub fn openRecord(self: TlsClient12, ctype: int, frag: ptr, fragLen: int, out: ptr): int {
        let ctLen = fragLen - 8 - 16;
        if (ctLen < 0) { return 0 - 1; }
        let nonce = bytes.alloc(12);
        let i = 0;
        while (i < 4) { bytes.write_byte(nonce, i, bytes.read_byte(self.sIV, i)); i = i + 1; }
        i = 0;
        while (i < 8) { bytes.write_byte(nonce, 4 + i, bytes.read_byte(frag, i)); i = i + 1; }
        let aad = bytes.alloc(13);
        writeU64(aad, 0, self.sSeq);
        bytes.write_byte(aad, 8, ctype); bytes.write_byte(aad, 9, 0x03); bytes.write_byte(aad, 10, 0x03);
        bytes.write_byte(aad, 11, (ctLen >> 8) & 0xff); bytes.write_byte(aad, 12, ctLen & 0xff);
        let tag = bytes.alloc(16);
        i = 0;
        while (i < 16) { bytes.write_byte(tag, i, bytes.read_byte(frag, 8 + ctLen + i)); i = i + 1; }
        if (self.sGcm == undefined) { self.sGcm = aesgcm.GcmContext.create(self.sWriteKey, self.keyLen); }
        let sg = self.sGcm;
        let ok = false;
        if (sg != undefined) { ok = sg.open(nonce, 12, aad, 13, at(frag, 8), ctLen, tag, out); }
        self.sSeq = self.sSeq + 1;
        bytes.free(nonce); bytes.free(aad); bytes.free(tag);
        if (!ok) { return 0 - 1; }
        return ctLen;
    }
}

/// Writes the 64-bit value `v` big-endian at offset `o` in buffer `b`.
///
/// Used for both the GCM record sequence number in the nonce and its copy in the
/// AAD. The shift `(7 - i) * 8` places the most significant byte first, matching
/// network byte order.
fn writeU64(b: ptr, o: int, v: ulong): void {
    let i = 0;
    while (i < 8) { bytes.write_byte(b, o + i, ((v >> (((7 - i) * 8) as ulong)) & 0xff) as int); i = i + 1; }
}

/// Fills `buf` with `n` cryptographically random bytes from [`random.randomBytes`].
///
/// The source returns a Kyte byte value; this copies it out into the raw `ptr`
/// buffer the handshake code works in, masking each to a byte. Used to seed the
/// ephemeral private keys in [`TlsClient12.buildClientKeyExchange`].
fn fillRandom(buf: ptr, n: int): void {
    let s = random.randomBytes(n);
    let i = 0;
    while (i < n) { bytes.write_byte(buf, i, s[i] & 0xff); i = i + 1; }
}

/// Copies the bytes of string `s` into a freshly allocated raw buffer.
///
/// The PRF labels ("master secret", "key expansion", and so on) are Kyte string
/// literals, but the PRF works over raw `ptr` buffers, so each call site turns
/// its label into a buffer with this helper. The caller owns the result and must
/// [`bytes.free`] it, which each derivation method does.
fn labelBuf(s: string): ptr {
    let b = bytes.alloc(s.length);
    let i = 0;
    while (i < s.length) { bytes.write_byte(b, i, s[i]); i = i + 1; }
    return b;
}

/// Extracts the two 32-byte integers r and s from a DER-encoded ECDSA signature.
///
/// An ECDSA signature on the wire is `SEQUENCE { INTEGER r, INTEGER s }`. This
/// steps over the SEQUENCE header (handling the long-form length byte when the
/// high bit is set), then reads each INTEGER's length and copies its value into a
/// fixed 32-byte, left-padded output via [`copyIntTo32`]. Feeding r and s into
/// [`p256.ecdsaVerify`], which wants fixed-width scalars, is why the raw DER is
/// unpacked here. Used by [`TlsClient12.processServerKeyExchange`] for ECDSA suites.
fn parseEcdsaSig(sig: ptr, sigLen: int, rOut: ptr, sOut: ptr): void {
    let p = 2;
    if (bytes.read_byte(sig, 1) >= 0x80) { p = 2 + (bytes.read_byte(sig, 1) & 0x7f); }
    let rLen = bytes.read_byte(sig, p + 1);
    let rStart = p + 2;
    copyIntTo32(sig, rStart, rLen, rOut);
    let sPos = rStart + rLen;
    let sLen = bytes.read_byte(sig, sPos + 1);
    let sStart = sPos + 2;
    copyIntTo32(sig, sStart, sLen, sOut);
}
/// Copies a variable-length big-endian integer into a fixed 32-byte, right-aligned buffer.
///
/// DER integers are minimal-length and may carry a leading zero byte (added to
/// keep them positive) or be shorter than 32 bytes. This normalises them: `out`
/// is zeroed, and if the value is longer than 32 bytes the leading bytes are
/// dropped (`src` advanced past them), otherwise it is left-padded with zeros so
/// the least significant byte lands at the end. That fixed layout is what the
/// P-256 primitives expect. Helper for [`parseEcdsaSig`].
fn copyIntTo32(buf: ptr, start: int, len: int, out: ptr): void {
    let i = 0;
    while (i < 32) { bytes.write_byte(out, i, 0); i = i + 1; }
    let take = len; let src = start;
    if (take > 32) { src = start + (take - 32); take = 32; }
    let pad = 32 - take;
    i = 0;
    while (i < take) { bytes.write_byte(out, pad + i, bytes.read_byte(buf, src + i)); i = i + 1; }
}

/// Serialises a ClientHello into `out` and returns its total length.
///
/// This is a free function, not a method, because it runs before a
/// [`TlsClient12`] even needs to hold session state: the caller only supplies the
/// 32-byte client random and the SNI host name. The message advertises TLS 1.2
/// (version `0x0303`), the four supported ECDHE-GCM suites (in the same order
/// [`applySuite`] understands), a single null compression method, and the
/// extensions a modern client needs: server_name (SNI) carrying `host`,
/// supported_groups (X25519 then secp256r1), ec_point_formats (uncompressed),
/// signature_algorithms (the ECDSA and RSA schemes over SHA-256/384/512),
/// extended_master_secret, and renegotiation_info (empty). The 24-bit handshake
/// body length and the extensions-block length are back-patched once their spans
/// are known. Offsets are written directly into `out`, which the caller sizes
/// generously.
pub fn buildClientHello(clientRandom: ptr, host: string, out: ptr): int {
    let p = 0;
    let body = 4;
    bytes.write_byte(out, body, 0x03); bytes.write_byte(out, body + 1, 0x03);
    let q = body + 2;
    let i = 0;
    while (i < 32) { bytes.write_byte(out, q + i, bytes.read_byte(clientRandom, i)); i = i + 1; }
    q = q + 32;
    bytes.write_byte(out, q, 0); q = q + 1;
    bytes.write_byte(out, q, 0); bytes.write_byte(out, q + 1, 8); q = q + 2;
    writeU16(out, q, CS_ECDHE_ECDSA_AES256_GCM); q = q + 2;
    writeU16(out, q, CS_ECDHE_RSA_AES256_GCM); q = q + 2;
    writeU16(out, q, CS_ECDHE_ECDSA_AES128_GCM); q = q + 2;
    writeU16(out, q, CS_ECDHE_RSA_AES128_GCM); q = q + 2;
    bytes.write_byte(out, q, 1); bytes.write_byte(out, q + 1, 0); q = q + 2;

    let extLenPos = q; q = q + 2;
    writeU16(out, q, 0); q = q + 2;
    let snLen = host.length;
    writeU16(out, q, snLen + 5); q = q + 2;
    writeU16(out, q, snLen + 3); q = q + 2;
    bytes.write_byte(out, q, 0); q = q + 1;
    writeU16(out, q, snLen); q = q + 2;
    i = 0;
    while (i < snLen) { bytes.write_byte(out, q + i, host[i]); i = i + 1; }
    q = q + snLen;
    writeU16(out, q, 10); q = q + 2;
    writeU16(out, q, 6); q = q + 2;
    writeU16(out, q, 4); q = q + 2;
    writeU16(out, q, GRP_X25519); q = q + 2;
    writeU16(out, q, GRP_SECP256R1); q = q + 2;
    writeU16(out, q, 11); q = q + 2;
    writeU16(out, q, 2); q = q + 2;
    bytes.write_byte(out, q, 1); bytes.write_byte(out, q + 1, 0); q = q + 2;
    writeU16(out, q, 13); q = q + 2;
    writeU16(out, q, 14); q = q + 2;
    writeU16(out, q, 12); q = q + 2;
    writeU16(out, q, 0x0403); q = q + 2;
    writeU16(out, q, 0x0503); q = q + 2;
    writeU16(out, q, 0x0603); q = q + 2;
    writeU16(out, q, 0x0401); q = q + 2;
    writeU16(out, q, 0x0501); q = q + 2;
    writeU16(out, q, 0x0601); q = q + 2;
    writeU16(out, q, 23); q = q + 2; writeU16(out, q, 0); q = q + 2;
    writeU16(out, q, 0xff01); q = q + 2; writeU16(out, q, 1); q = q + 2; bytes.write_byte(out, q, 0); q = q + 1;

    let extLen = q - (extLenPos + 2);
    writeU16(out, extLenPos, extLen);

    let bodyLen = q - body;
    bytes.write_byte(out, 0, 0x01);
    bytes.write_byte(out, 1, (bodyLen >> 16) & 0xff); bytes.write_byte(out, 2, (bodyLen >> 8) & 0xff); bytes.write_byte(out, 3, bodyLen & 0xff);
    return q;
}

/// Writes the 16-bit value `v` big-endian at offset `o` in buffer `b`. The writer counterpart to [`rd16`].
fn writeU16(b: ptr, o: int, v: int): void { bytes.write_byte(b, o, (v >> 8) & 0xff); bytes.write_byte(b, o + 1, v & 0xff); }

/// Creates a fresh [`TlsClient12`] with every buffer field allocated and counters zeroed.
///
/// This is the only constructor. It allocates the fixed-size buffers (the two
/// 32-byte randoms, the 48-byte master secret, the 4-byte IVs, the 65-byte EC
/// public slot, an 8 KB transcript buffer) and gives the variable ones a 1-byte
/// placeholder so the `free`-then-`alloc` replace pattern used when real data
/// arrives always has a valid allocation to free. The GCM contexts start
/// `undefined` and are built lazily on first seal/open. Defaults reflect the
/// SHA-256 / AES-128 suite until [`TlsClient12.applySuite`] overrides them. The
/// caller is responsible for freeing all of these buffers at end of session.
pub fn newClient12(): TlsClient12 {
    return TlsClient12 {
        clientRandom: bytes.alloc(32), serverRandom: bytes.alloc(32),
        suite: 0, prfHash: 0, keyLen: 16, isEcdsa: false, group: 0,
        ephPriv: bytes.alloc(1), ephPub: bytes.alloc(1), ephPubLen: 0, serverEph: bytes.alloc(1), serverEphLen: 0,
        ems: false, keyType: -1, rsaN: bytes.alloc(1), rsaNLen: 0, rsaE: bytes.alloc(1), rsaELen: 0, ecPub: bytes.alloc(65),
        certList: bytes.alloc(1), certListLen: 0,
        master: bytes.alloc(48), cWriteKey: bytes.alloc(1), sWriteKey: bytes.alloc(1),
        cGcm: undefined, sGcm: undefined,
        cIV: bytes.alloc(4), sIV: bytes.alloc(4), cSeq: 0, sSeq: 0,
        tr: bytes.alloc(8192), trLen: 0, trCap: 8192,
        certRequested: false, haveClientCert: false, clientCertDer: bytes.alloc(1), clientCertLen: 0, clientKey: bytes.alloc(32),
    };
}

/// Installs the client certificate and its private key for mutual-TLS authentication.
///
/// Copies the DER certificate into `clientCertDer` and the 32-byte private key
/// into `clientKey`, and flags `haveClientCert`. Call this before the handshake if
/// the client may need to present a certificate; when the server sends a
/// CertificateRequest, the caller then emits the certificate with
/// [`buildClientCertificate12`] and proves possession with [`buildCertVerify12`].
/// A `certLen` of 0 still allocates a 1-byte buffer so later frees are safe.
pub fn setClientCert12(self: TlsClient12, certDer: ptr, certLen: int, key: ptr): void {
    self.clientCertDer = bytes.alloc(if (certLen > 0) certLen else 1);
    let j = 0;
    while (j < certLen) { bytes.write_byte(self.clientCertDer, j, bytes.read_byte(certDer, j)); j = j + 1; }
    self.clientCertLen = certLen;
    let i = 0;
    while (i < 32) { bytes.write_byte(self.clientKey, i, bytes.read_byte(key, i)); i = i + 1; }
    self.haveClientCert = true;
}

/// Serialises a client Certificate message into `out` and returns its length.
///
/// Writes the handshake header (type `0x0b`, 3-byte body length), then the 3-byte
/// certificate-list length, then, if a certificate is present, its 3-byte length
/// followed by the DER bytes. With `certLen == 0` it emits an empty list, which is
/// the correct way for a client to decline when it has no suitable certificate.
/// The signature over the handshake, when a certificate IS sent, is produced
/// separately by [`buildCertVerify12`].
pub fn buildClientCertificate12(certDer: ptr, certLen: int, out: ptr): int {
    let listLen = if (certLen > 0) 3 + certLen else 0;
    let bodyLen = 3 + listLen;
    bytes.write_byte(out, 0, 0x0b);
    bytes.write_byte(out, 1, (bodyLen >> 16) & 0xff); bytes.write_byte(out, 2, (bodyLen >> 8) & 0xff); bytes.write_byte(out, 3, bodyLen & 0xff);
    bytes.write_byte(out, 4, (listLen >> 16) & 0xff); bytes.write_byte(out, 5, (listLen >> 8) & 0xff); bytes.write_byte(out, 6, listLen & 0xff);
    let p = 7;
    if (certLen > 0) {
        bytes.write_byte(out, p, (certLen >> 16) & 0xff); bytes.write_byte(out, p + 1, (certLen >> 8) & 0xff); bytes.write_byte(out, p + 2, certLen & 0xff);
        p = p + 3;
        let i = 0;
        while (i < certLen) { bytes.write_byte(out, p + i, bytes.read_byte(certDer, i)); i = i + 1; }
        p = p + certLen;
    }
    return p;
}

/// Builds the CertificateVerify message, signing the handshake transcript with the client key.
///
/// Proves the client owns the private key for the certificate it just sent. It
/// hashes the transcript so far with SHA-256, signs that digest with ECDSA/P-256
/// ([`p256.ecdsaSign`]), DER-encodes the (r, s) pair via [`derEncodeSig12`], and
/// frames it as a CertificateVerify (type `0x0f`) advertising signature algorithm
/// `0x0403` (ecdsa_secp256r1_sha256). This path is ECDSA-only, matching the P-256
/// client keys installed by [`setClientCert12`]. Returns the message length.
/// Scratch buffers are freed before return.
pub fn buildCertVerify12(self: TlsClient12, key: ptr, out: ptr): int {
    let digest = bytes.alloc(32);
    sha256.hashInto(self.tr, self.trLen, digest);
    let r = bytes.alloc(32); let s = bytes.alloc(32);
    p256.ecdsaSign(digest, key, r, s);
    let sigDer = bytes.alloc(80);
    let sigLen = derEncodeSig12(r, s, sigDer);
    let bodyLen = 2 + 2 + sigLen;
    bytes.write_byte(out, 0, 0x0f);
    bytes.write_byte(out, 1, (bodyLen >> 16) & 0xff); bytes.write_byte(out, 2, (bodyLen >> 8) & 0xff); bytes.write_byte(out, 3, bodyLen & 0xff);
    bytes.write_byte(out, 4, 0x04); bytes.write_byte(out, 5, 0x03);
    bytes.write_byte(out, 6, (sigLen >> 8) & 0xff); bytes.write_byte(out, 7, sigLen & 0xff);
    let i = 0;
    while (i < sigLen) { bytes.write_byte(out, 8 + i, bytes.read_byte(sigDer, i)); i = i + 1; }
    bytes.free(digest); bytes.free(r); bytes.free(s); bytes.free(sigDer);
    return 8 + sigLen;
}

/// DER-encodes an ECDSA (r, s) pair as `SEQUENCE { INTEGER r, INTEGER s }` into `out`.
///
/// Encodes each 32-byte scalar as a DER INTEGER with [`derEncInt12`], then writes
/// the outer SEQUENCE tag `0x30` and total length. This is the inverse of
/// [`parseEcdsaSig`], and the length fits in one byte because two P-256 integers
/// never exceed 127 bytes together. Returns the total encoded length.
fn derEncodeSig12(r: ptr, s: ptr, out: ptr): int {
    let rlen = derEncInt12(r, out, 2);
    let slen = derEncInt12(s, out, 2 + rlen);
    let total = rlen + slen;
    bytes.write_byte(out, 0, 0x30); bytes.write_byte(out, 1, total);
    return 2 + total;
}
/// DER-encodes one 32-byte big-endian scalar as an INTEGER at offset `off` in `out`.
///
/// Two DER rules are handled: leading zero bytes are stripped so the encoding is
/// minimal, but if the first significant byte has its high bit set a single `0x00`
/// pad is prepended so the value is not read as negative. Writes the `0x02` tag,
/// the length, the optional pad, and the value bytes. Returns the number of bytes
/// written (tag, length, and content). Helper for [`derEncodeSig12`].
fn derEncInt12(src: ptr, out: ptr, off: int): int {
    let s = 0;
    while (s < 31 && bytes.read_byte(src, s) == 0) { s = s + 1; }
    let pad = 0;
    if ((bytes.read_byte(src, s) & 0x80) != 0) { pad = 1; }
    let vlen = 32 - s + pad;
    bytes.write_byte(out, off, 0x02); bytes.write_byte(out, off + 1, vlen);
    let p = off + 2;
    if (pad == 1) { bytes.write_byte(out, p, 0); p = p + 1; }
    let i = s;
    while (i < 32) { bytes.write_byte(out, p, bytes.read_byte(src, i)); p = p + 1; i = i + 1; }
    return p - off;
}

/// Round-trips a record through [`TlsClient12.sealRecord`] and [`TlsClient12.openRecord`].
///
/// Sets up two clients with matching keys and IVs (one sealing with its client
/// key, the other opening with the same bytes as its server key), seals a known
/// plaintext, opens it, and asserts the recovered length and every byte match.
/// This exercises the GCM nonce construction, AAD layout, and tag handling end to
/// end without any network I/O.
@test
fn test_gcm_record_roundtrip(): void {
    let c = newClient12();
    c.keyLen = 16;
    let k = 0;
    while (k < 16) { bytes.write_byte(c.cWriteKey, k, k); bytes.write_byte(c.sWriteKey, k, k); k = k + 1; }
    k = 0;
    while (k < 4) { bytes.write_byte(c.cIV, k, 0x10 + k); bytes.write_byte(c.sIV, k, 0x10 + k); k = k + 1; }
    let pt = labelBuf("hello record layer");
    let rec = bytes.alloc(64);
    let m = c.sealRecord(0x17, pt, 18, rec);
    let d = newClient12();
    d.keyLen = 16;
    k = 0;
    while (k < 16) { bytes.write_byte(d.sWriteKey, k, k); k = k + 1; }
    k = 0;
    while (k < 4) { bytes.write_byte(d.sIV, k, 0x10 + k); k = k + 1; }
    let out = bytes.alloc(64);
    let pl = d.openRecord(0x17, rec, m, out);
    assert.equalInt(pl, 18);
    let i = 0;
    while (i < 18) { assert.equalInt(bytes.read_byte(out, i), bytes.read_byte(pt, i)); i = i + 1; }
}
