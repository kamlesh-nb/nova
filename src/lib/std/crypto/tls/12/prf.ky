//! The TLS 1.2 pseudo-random function (PRF), as specified in RFC 5246 §5.
//!
//! TLS 1.2 needs a single, agreed way to stretch a short shared secret plus
//! some context into an arbitrary number of key bytes. This is used everywhere
//! secret bytes are derived during a handshake: expanding the master secret
//! from the pre-master secret, deriving the key block (client/server MAC keys,
//! encryption keys, IVs), and computing the Finished message verify_data. All
//! of those are the same function called with a different `label` and `seed`.
//!
//! The PRF is built from the HMAC-based data expansion `P_hash` defined in
//! RFC 5246 §5:
//!
//!     P_hash(secret, seed) = HMAC(secret, A(1) + seed)
//!                          + HMAC(secret, A(2) + seed)
//!                          + HMAC(secret, A(3) + seed) + ...
//!
//! where `+` is concatenation and the `A` values are chained by feeding each
//! HMAC output back in as the next message:
//!
//!     A(0) = seed
//!     A(i) = HMAC(secret, A(i - 1))
//!
//! The full PRF is `PRF(secret, label, seed) = P_hash(secret, label + seed)`,
//! so the label is simply prepended to the seed before expansion. Output is
//! produced one hash block at a time until the requested length is reached, and
//! the final block is truncated. Unlike TLS 1.0/1.1, TLS 1.2 does not split the
//! secret across two hashes; the whole PRF runs on one hash, chosen by the
//! negotiated cipher suite (this file supports the two the suites we implement
//! use: SHA-256 and SHA-384).
//!
//! This module works entirely in terms of raw byte buffers (`ptr` plus length)
//! rather than owned Kyte `string`s, because it sits on the crypto hot path and
//! feeds directly into the handshake state machine. It owns no long-lived
//! state: every scratch buffer it allocates is freed before [`prf`] returns.
//! It leans on the HMAC primitives in `crypto.mac.hmac` for the underlying
//! keyed hashing and does no hashing of its own.

import bytes;
import crypto.mac.hmac;
import assert;

/// Output length in bytes of the hash selected by `hashId`.
///
/// `hashId == 1` selects SHA-384, whose digest is 48 bytes; every other value
/// (in practice `0`) selects SHA-256, whose digest is 32 bytes. This is the
/// size of one `P_hash` block, so it also fixes how many bytes each HMAC call
/// in [`prf`] contributes and the length of the chained `A` value.
fn hLen(hashId: int): int { if (hashId == 1) { return 48; } return 32; }

/// Computes `HMAC(key, msg)` with the hash selected by `hashId`, writing the
/// digest into `out`.
///
/// This is the single dispatch point that maps `hashId` onto a concrete HMAC
/// routine, so the rest of [`prf`] never has to branch on the hash again. The
/// caller must ensure `out` has room for [`hLen`] bytes (48 for SHA-384, 32
/// otherwise), since the underlying HMAC writes a full digest.
fn hmacInto(hashId: int, key: ptr, keyLen: int, msg: ptr, msgLen: int, out: ptr): void {
    if (hashId == 1) { hmac.hmacSha384(key, keyLen, msg, msgLen, out); return; }
    hmac.hmacSha256(key, keyLen, msg, msgLen, out);
}

/// Expands `secret` into `outLen` pseudo-random bytes using the TLS 1.2 PRF.
///
/// This is the module's one public entry point. It implements
/// `PRF(secret, label, seed) = P_hash(secret, label + seed)` from RFC 5246 §5:
/// the `label` and `seed` are concatenated into a single "full seed", then the
/// `P_hash` HMAC ladder is run until `outLen` bytes have been written into
/// `out`. `hashId` picks the hash (1 = SHA-384, else SHA-256) and therefore the
/// block size via [`hLen`]; `hmacInto` performs every keyed hash.
///
/// The loop maintains the chained value `A`, starting at `A(1) = HMAC(secret,
/// label + seed)`. Each iteration hashes `A + fullSeed` to produce one block,
/// copies up to a block's worth into `out` (truncating the final block so the
/// output is exactly `outLen` bytes), then advances `A` to `HMAC(secret, A)`
/// for the next round. Note that `produced` is bumped by a whole block `hl`
/// even on the last, truncated iteration, so the loop still terminates.
///
/// All four scratch buffers (`fullSeed`, `A`, `blk`, `digest`) are freed before
/// returning, so this function leaks nothing. The caller owns `out` and must
/// size it for at least `outLen` bytes; the `secret`, `label`, and `seed`
/// buffers are only read.
pub fn prf(hashId: int, secret: ptr, secretLen: int, label: ptr, labelLen: int,
           seed: ptr, seedLen: int, out: ptr, outLen: int): void {
    let hl = hLen(hashId);
    let fsLen = labelLen + seedLen;
    let fullSeed = bytes.alloc(fsLen);
    let i = 0;
    while (i < labelLen) { bytes.write_byte(fullSeed, i, bytes.read_byte(label, i)); i = i + 1; }
    i = 0;
    while (i < seedLen) { bytes.write_byte(fullSeed, labelLen + i, bytes.read_byte(seed, i)); i = i + 1; }

    let a = bytes.alloc(hl);
    hmacInto(hashId, secret, secretLen, fullSeed, fsLen, a);

    let blk = bytes.alloc(hl + fsLen);
    let digest = bytes.alloc(hl);
    let produced = 0;
    while (produced < outLen) {
        i = 0;
        while (i < hl) { bytes.write_byte(blk, i, bytes.read_byte(a, i)); i = i + 1; }
        i = 0;
        while (i < fsLen) { bytes.write_byte(blk, hl + i, bytes.read_byte(fullSeed, i)); i = i + 1; }
        hmacInto(hashId, secret, secretLen, blk, hl + fsLen, digest);
        let take = hl;
        if (produced + take > outLen) { take = outLen - produced; }
        i = 0;
        while (i < take) { bytes.write_byte(out, produced + i, bytes.read_byte(digest, i)); i = i + 1; }
        produced = produced + hl;
        hmacInto(hashId, secret, secretLen, a, hl, a);
    }
    bytes.free(fullSeed); bytes.free(a); bytes.free(blk); bytes.free(digest);
}

/// Decodes one lowercase hexadecimal ASCII character into its 0..15 value.
///
/// Handles the digits `'0'..'9'` (ASCII 48..57) and lowercase `'a'..'f'`
/// (ASCII 97..102, mapped by subtracting 87). Uppercase letters and any other
/// byte fall through to `0`, so this trusts its input to be well-formed lower
/// hex; it is a test-only helper feeding the known-answer vectors below.
fn hexNib(c: int): int { if (c >= 48 && c <= 57) { return c - 48; } if (c >= 97 && c <= 102) { return c - 87; } return 0; }
/// Decodes a lowercase hex string into a freshly allocated byte buffer.
///
/// Reads the input two characters at a time, combining the high and low nibbles
/// via [`hexNib`], and returns a `bytes.alloc`-ed buffer of `hex.length / 2`
/// bytes. An odd trailing character is ignored. The caller owns the returned
/// buffer and must `bytes.free` it. Test-only.
fn hexBuf(hex: string): ptr {
    let n = hex.length / 2;
    let b = bytes.alloc(n);
    let i = 0;
    while (i < n) { bytes.write_byte(b, i, hexNib(hex[i * 2]) * 16 + hexNib(hex[i * 2 + 1])); i = i + 1; }
    return b;
}
/// Reports whether the first `n` bytes of `buf` equal the value encoded by the
/// hex string `hex`.
///
/// Returns `false` immediately if `hex` does not encode exactly `n` bytes
/// (`hex.length != n * 2`), otherwise compares byte by byte, decoding each hex
/// pair with [`hexNib`]. Used by the test to check PRF output against the
/// expected known-answer vector without allocating an intermediate buffer.
/// Test-only.
fn eqHex(buf: ptr, n: int, hex: string): bool {
    if (hex.length != n * 2) { return false; }
    let i = 0;
    while (i < n) {
        if (bytes.read_byte(buf, i) != hexNib(hex[i * 2]) * 16 + hexNib(hex[i * 2 + 1])) { return false; }
        i = i + 1;
    }
    return true;
}

/// Expected 100-byte P_SHA-256 output for the standard TLS 1.2 PRF test vector,
/// encoded as hex.
///
/// This is the well-known community known-answer vector (secret
/// `9bbe436ba940f017b17652849a71db35`, label `"test label"`, seed
/// `a0ba9f936cda311827a6f796ffd5198c`) widely used to check TLS 1.2 SHA-256 PRF
/// implementations. [`test_prf_sha256_kat`] pins [`prf`] against it.
const PRF_KAT: string = "e3f229ba727be17b8d122620557cd453c2aab21d07c3d495329b52d4e61edb5a6b301791e90d35c9c9a46b4e14baf9af0fa022f7077def17abfd3797c0564bab4fbc91666e9def9b97fce34f796789baa48082d122ee42c5a72e5a5110fff70187347b66";

/// Verifies [`prf`] against the SHA-256 known-answer vector [`PRF_KAT`].
///
/// Builds the secret, label, and seed buffers for the standard test vector,
/// runs [`prf`] with `hashId == 0` (SHA-256) to produce 100 output bytes, and
/// asserts they match [`PRF_KAT`]. This exercises the truncation path too, since
/// 100 is not a multiple of the 32-byte SHA-256 block. The label is copied byte
/// by byte from the `"test label"` string rather than via [`hexBuf`] because it
/// is plain ASCII, not hex.
@test
fn test_prf_sha256_kat(): void {
    let secret = hexBuf("9bbe436ba940f017b17652849a71db35");
    let label = "test label";
    let labelBuf = bytes.alloc(label.length);
    let i = 0;
    while (i < label.length) { bytes.write_byte(labelBuf, i, label[i]); i = i + 1; }
    let seed = hexBuf("a0ba9f936cda311827a6f796ffd5198c");
    let out = bytes.alloc(100);
    prf(0, secret, 16, labelBuf, label.length, seed, 16, out, 100);
    assert.isTrue(eqHex(out, 100, PRF_KAT));
}
