//! TLS trust anchors: the set of root CA certificates a client trusts, and the
//! machinery to validate a server's presented chain against them.
//!
//! A `TrustStore` is Kyte's equivalent of the operating system's root CA bundle.
//! It holds a list of trusted root certificates in DER form (raw ASN.1 bytes),
//! and answers one question the TLS handshake must ask: does this chain of
//! certificates the peer sent us terminate in a root we already trust, and is it
//! valid for the hostname we meant to reach, right now? The actual cryptographic
//! and structural checking (signature verification, name constraints, validity
//! windows, SAN/hostname matching) lives in [`crypto.x509`]; this file is the
//! anchor store plus the loop that tries the chain against every anchor.
//!
//! Why DER and not parsed `Cert` structs are kept: a root bundle can hold well
//! over a hundred certificates, and on a real handshake only one of them is the
//! actual issuer. Parsing every anchor up front would be wasted work, so the
//! store keeps the anchors as raw byte buffers ([`TrustStore.ders`] plus their
//! lengths in [`TrustStore.lens`]) and lets [`crypto.x509`] parse on demand
//! inside the verification loop. The buffers are heap-allocated and OWNED by the
//! store; [`TrustStore.free`] releases them.
//!
//! There are TLS 1.3 and TLS 1.2 variants of each verification entry point
//! (`trusts` vs `trusts12`, and the `NotRevoked` pair). They differ only in how
//! the intermediate certificate is located in the presented chain, because the
//! two protocol versions lay the Certificate message out differently. The
//! revocation-aware variants additionally consult a stapled OCSP response and/or
//! a CRL through [`crypto.tls.revocation`], and fail closed only on a definite
//! REVOKED verdict (an unknown or unavailable status does not reject here).
//!
//! The bottom half of the file is a small self-contained PEM reader:
//! [`loadPemBundle`] walks a PEM text, base64-decodes each
//! `-----BEGIN CERTIFICATE-----` block via [`crypto.base64`], and stores the
//! resulting DER. This lets a client load a system bundle or an application's
//! pinned roots straight from a `.pem` file with no external dependency.

import bytes;
import list;
import crypto.x509;
import crypto.tls.revocation;
import crypto.base64;
import datetime;

/// Current wall-clock UTC time encoded as a packed `YYYYMMDDhhmmss` integer.
///
/// The value is a single `long` where the calendar fields are laid out as
/// decimal digits (for example, 2026-08-22 13:45:07 becomes 20260822134507).
/// This is the exact shape [`crypto.x509`] expects for the `now` argument of its
/// validity checks, so the verification entry points below can be handed the
/// result directly to test a chain's not-before / not-after window.
///
/// Internally it takes the Unix timestamp from [`datetime.now`] and runs the
/// civil-from-days algorithm (the `era` / `doe` / `yoe` arithmetic) to recover
/// year, month, and day without a lookup table, then folds the time-of-day
/// fields on top. The `mp >= 10` and `m <= 2` adjustments undo the algorithm's
/// convention of starting the year in March.
pub fn nowUtc(): long {
    let t = datetime.now() as long;
    let days = t / 86400;
    let sod = t - days * 86400;
    let hh = sod / 3600;
    let mi = (sod - hh * 3600) / 60;
    let ss = sod - hh * 3600 - mi * 60;
    let z = days + 719468;
    let era = z / 146097;
    let doe = z - era * 146097;
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    let y = yoe + era * 400;
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    let mp = (5 * doy + 2) / 153;
    let d = doy - (153 * mp + 2) / 5 + 1;
    let m = mp + 3;
    if (mp >= 10) { m = mp - 9; }
    if (m <= 2) { y = y + 1; }
    return ((((y * 100 + m) * 100 + d) * 100 + hh) * 100 + mi) * 100 + ss;
}

/// The PEM header line that opens a certificate block in a bundle file.
///
/// [`loadPemBundle`] scans for this exact marker to find where each encoded
/// certificate begins; the base64 body starts immediately after it.
const BEGIN_MARK: string = "-----BEGIN CERTIFICATE-----";
/// The PEM footer line that closes a certificate block in a bundle file.
///
/// [`loadPemBundle`] scans for this marker to bound the base64 body it decodes,
/// then resumes searching for the next block after it.
const END_MARK: string = "-----END CERTIFICATE-----";

/// A set of trusted root CA certificates, held as owned DER byte buffers.
///
/// Each anchor is stored as a raw DER buffer whose heap address sits in
/// [`TrustStore.ders`] (a `long`, because it is a machine address that must not
/// be truncated to 32 bits) with its byte length at the matching index in
/// [`TrustStore.lens`]. The two lists are kept in lock-step: index `i` in one
/// corresponds to index `i` in the other.
///
/// The buffers are owned by the store. Call [`TrustStore.free`] when done to
/// release them. The verification methods parse anchors lazily out of these
/// buffers rather than keeping parsed [`crypto.x509.Cert`] structs, so the store
/// stays cheap to hold even for a large system bundle.
pub struct TrustStore {
    /// Heap addresses of the owned DER buffers, one per trusted anchor.
    ///
    /// Stored as `long` because these are raw machine addresses; an `int` would
    /// truncate any address above 4 GB to garbage. Each entry is cast back to a
    /// `ptr` before use and freed by [`TrustStore.free`].
    pub ders: List<long>,
    /// Byte length of each DER buffer, parallel to [`TrustStore.ders`].
    pub lens: List<int>,

    /// Number of trust anchors currently held.
    pub fn count(self: TrustStore): int { return self.ders.size(); }

    /// Validates a TLS 1.3 certificate chain against every trusted anchor.
    ///
    /// Walks the anchors in order and returns true as soon as [`crypto.x509.verifyCertList`]
    /// accepts the presented chain (`certList` / `listLen`) as chaining up to
    /// that anchor, valid for `host` at time `now` (see [`nowUtc`]). Returns
    /// false only if no anchor accepts it. This checks trust, hostname, and
    /// validity but NOT revocation; use [`TrustStore.trustsNotRevoked`] when a
    /// stapled OCSP response or CRL is available.
    pub fn trusts(self: TrustStore, certList: ptr, listLen: int, host: string, now: long): bool {
        let i = 0;
        while (i < self.ders.size()) {
            let d = (self.ders.get(i) ?? 0) as ptr;
            let n = self.lens.get(i) ?? 0;
            if (x509.verifyCertList(certList, listLen, d, n, host, now)) { return true; }
            i = i + 1;
        }
        return false;
    }

    /// Validates a TLS 1.2 certificate chain against every trusted anchor.
    ///
    /// Identical in shape to [`TrustStore.trusts`], but calls
    /// [`crypto.x509.verifyCertList12`], which reads the chain using the TLS 1.2
    /// Certificate message layout. Kept separate because the two protocol
    /// versions frame the peer's certificate list differently.
    pub fn trusts12(self: TrustStore, certList: ptr, listLen: int, host: string, now: long): bool {
        let i = 0;
        while (i < self.ders.size()) {
            let d = (self.ders.get(i) ?? 0) as ptr;
            let n = self.lens.get(i) ?? 0;
            if (x509.verifyCertList12(certList, listLen, d, n, host, now)) { return true; }
            i = i + 1;
        }
        return false;
    }

    /// Finds the certificate that issued `leaf`, so revocation can be checked.
    ///
    /// Revocation queries (OCSP and CRL) are made against the leaf's ISSUER, so
    /// the caller needs a handle to it. The search prefers the intermediate the
    /// peer already sent (`inter`): if it parsed cleanly and its subject matches
    /// the leaf's issuer name (via [`crypto.x509.nameMatches`]), that is the
    /// issuer. Otherwise the leaf was likely signed directly by a root, so the
    /// trusted anchors are parsed one by one and the first name match wins.
    ///
    /// If nothing matches, it returns `leaf` itself as a fallback. Callers should
    /// treat that as "issuer not found" rather than a meaningful result, since a
    /// certificate is not its own issuer.
    pub fn issuerOf(self: TrustStore, leaf: x509.Cert, inter: x509.Cert): x509.Cert {
        if (inter.ok && x509.nameMatches(leaf, inter)) { return inter; }
        let i = 0;
        while (i < self.ders.size()) {
            let root = x509.parseCert((self.ders.get(i) ?? 0) as ptr, self.lens.get(i) ?? 0);
            if (root.ok && x509.nameMatches(leaf, root)) { return root; }
            i = i + 1;
        }
        return leaf;
    }

    /// TLS 1.3 chain validation that also rejects a revoked leaf certificate.
    ///
    /// First requires that the chain passes [`TrustStore.trusts`]; if it does
    /// not, it fails immediately. It then locates the leaf and its issuer
    /// (via [`crypto.x509.leafCert`], [`crypto.x509.interCert13`], and
    /// [`TrustStore.issuerOf`]) and consults whatever revocation evidence the
    /// caller supplied: a stapled OCSP response when `ocspLen > 0`, and a CRL
    /// when `crlLen > 0`, through [`crypto.tls.revocation`].
    ///
    /// The policy is soft-fail, not hard-fail: it returns false ONLY when a
    /// source returns a definite `REV_REVOKED` verdict. An absent response, an
    /// unparseable one, or an "unknown" status does not cause rejection here, so
    /// a missing OCSP staple or CRL leaves the chain trusted on the strength of
    /// the [`TrustStore.trusts`] result alone.
    pub fn trustsNotRevoked(self: TrustStore, certList: ptr, listLen: int, host: string, now: long,
                            ocspDer: ptr, ocspLen: int, crlDer: ptr, crlLen: int): bool {
        if (!self.trusts(certList, listLen, host, now)) { return false; }
        let leaf = x509.leafCert(certList, listLen);
        let issuer = self.issuerOf(leaf, x509.interCert13(certList, listLen));
        if (ocspLen > 0 && revocation.checkOcspStapled(leaf, issuer, ocspDer, ocspLen) == revocation.REV_REVOKED) { return false; }
        if (crlLen > 0 && revocation.checkCrl(leaf, issuer, crlDer, crlLen) == revocation.REV_REVOKED) { return false; }
        return true;
    }

    /// TLS 1.2 counterpart of [`TrustStore.trustsNotRevoked`].
    ///
    /// Same soft-fail revocation policy, but gates on [`TrustStore.trusts12`] and
    /// finds the intermediate with [`crypto.x509.interCert12`], matching the
    /// TLS 1.2 Certificate message layout.
    pub fn trustsNotRevoked12(self: TrustStore, certList: ptr, listLen: int, host: string, now: long,
                              ocspDer: ptr, ocspLen: int, crlDer: ptr, crlLen: int): bool {
        if (!self.trusts12(certList, listLen, host, now)) { return false; }
        let leaf = x509.leafCert(certList, listLen);
        let issuer = self.issuerOf(leaf, x509.interCert12(certList, listLen));
        if (ocspLen > 0 && revocation.checkOcspStapled(leaf, issuer, ocspDer, ocspLen) == revocation.REV_REVOKED) { return false; }
        if (crlLen > 0 && revocation.checkCrl(leaf, issuer, crlDer, crlLen) == revocation.REV_REVOKED) { return false; }
        return true;
    }

    /// Frees the owned DER buffers backing this store.
    ///
    /// Releases every anchor buffer listed in [`TrustStore.ders`] via
    /// [`bytes.free`]. Call this once, when the store is no longer needed. The
    /// [`TrustStore.ders`] and [`TrustStore.lens`] lists themselves are ordinary
    /// ARC-managed containers and are reclaimed with the struct; only the raw
    /// buffers they point at need this explicit release.
    pub fn free(self: TrustStore): void {
        let i = 0;
        while (i < self.ders.size()) { bytes.free((self.ders.get(i) ?? 0) as ptr); i = i + 1; }
    }
}

/// Reads a little-endian signed 32-bit integer from buffer `b` at offset `o`.
///
/// Reassembles four consecutive bytes, least-significant first, into an `int`.
/// Used by [`loadPemBundle`] to read back the DER length that
/// [`decodeBlock`] wrote into a scratch buffer with [`bytes.write_i32`].
fn readI32(b: ptr, o: int): int {
    return bytes.read_byte(b, o) | (bytes.read_byte(b, o + 1) << 8) | (bytes.read_byte(b, o + 2) << 16) | (bytes.read_byte(b, o + 3) << 24);
}

/// Finds the first occurrence of `needle` in `hay` at or after index `from`.
///
/// A plain forward substring scan that returns the start index of the match, or
/// -1 if `needle` does not occur from `from` onward. [`loadPemBundle`] uses it to
/// locate the PEM begin and end markers. It is deliberately simple rather than
/// using a string library search, because it must operate from an arbitrary
/// resume position as the bundle is walked block by block.
fn indexFrom(hay: string, needle: string, from: int): int {
    let n = hay.length; let m = needle.length;
    let i = from;
    while (i + m <= n) {
        let j = 0;
        while (j < m && hay[i + j] == needle[j]) { j = j + 1; }
        if (j == m) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

/// Decodes one PEM certificate body into a freshly allocated DER buffer.
///
/// `start` and `end` bound the base64 body of a single certificate (the region
/// between the begin and end markers). The function first strips all PEM
/// whitespace (newline, carriage return, space, tab) so the base64 decoder sees
/// a contiguous alphabet, then decodes it via [`crypto.base64.decode`], and
/// finally copies the decoded bytes into a returned buffer that the caller owns.
/// The decoded DER length is written to offset 0 of the caller-supplied `lenOut`
/// scratch buffer with [`bytes.write_i32`], to be read back with [`readI32`].
///
/// The intermediate `clean` and `b64` buffers are freed before returning; only
/// the returned DER buffer survives, and it becomes an owned anchor in the store
/// built by [`loadPemBundle`].
fn decodeBlock(pem: string, start: int, end: int, lenOut: ptr): ptr {
    let clean = bytes.alloc(end - start);
    let cn = 0;
    let i = start;
    while (i < end) {
        let c = pem[i];
        if (c != 10 && c != 13 && c != 32 && c != 9) { bytes.write_byte(clean, cn, c); cn = cn + 1; }
        i = i + 1;
    }
    let b64 = bytes.alloc(cn);
    let j = 0;
    while (j < cn) { bytes.write_byte(b64, j, bytes.read_byte(clean, j)); j = j + 1; }
    bytes.free(clean);
    let der = base64.decode(b64 as string);
    bytes.free(b64);
    let n = der.length;
    let buf = bytes.alloc(n);
    j = 0;
    while (j < n) { bytes.write_byte(buf, j, bytes.read_byte(der as ptr, j)); j = j + 1; }
    bytes.write_i32(lenOut, 0, n);
    return buf;
}

/// Builds a store from a single already-decoded DER certificate.
///
/// A convenience for the common case of pinning one root: the buffer `der` of
/// length `len` becomes the sole anchor. NOTE that the store takes the buffer as
/// its owned anchor, so [`TrustStore.free`] will free `der`; the caller must not
/// also free it, and must not pass a buffer it needs to keep independently.
pub fn newTrustStoreDer(der: ptr, len: int): TrustStore {
    let store = TrustStore { ders: List<long>(), lens: List<int>() };
    store.ders.push(der as long);
    store.lens.push(len);
    return store;
}

/// Parses a PEM bundle into a trust store, one anchor per certificate block.
///
/// Walks `pem` from the start, repeatedly finding a `-----BEGIN CERTIFICATE-----`
/// / `-----END CERTIFICATE-----` pair (via [`indexFrom`] and the [`BEGIN_MARK`] /
/// [`END_MARK`] constants), decoding the body between them with [`decodeBlock`],
/// and pushing the resulting owned DER buffer and its length onto the store. The
/// scan resumes just past each end marker, so a file with many concatenated
/// certificates (a typical system root bundle) loads them all.
///
/// The loop stops cleanly at the first point where no further begin or end
/// marker is found, so trailing text after the last block is ignored. A scratch
/// buffer is used to shuttle each decoded length out of [`decodeBlock`] and is
/// freed before returning. The returned store owns its buffers; release them
/// with [`TrustStore.free`].
pub fn loadPemBundle(pem: string): TrustStore {
    let store = TrustStore { ders: List<long>(), lens: List<int>() };
    let lenOut = bytes.alloc(4);
    let pos = 0;
    while (true) {
        let bs = indexFrom(pem, BEGIN_MARK, pos);
        if (bs < 0) { break; }
        let bodyStart = bs + BEGIN_MARK.length;
        let es = indexFrom(pem, END_MARK, bodyStart);
        if (es < 0) { break; }
        let buf = decodeBlock(pem, bodyStart, es, lenOut);
        store.ders.push(buf as long);
        store.lens.push(readI32(lenOut, 0));
        pos = es + END_MARK.length;
    }
    bytes.free(lenOut);
    return store;
}
