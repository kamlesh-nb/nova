//! NIST P-384 elliptic curve: key derivation and ECDH.
//!
//! This file implements the arithmetic of the NIST P-384 (secp384r1) curve
//! from the ground up, so that the pure-Nova TLS stack can do ECDHE key
//! agreement over the `secp384r1` group without linking any C crypto library.
//! It exposes exactly two public entry points: [`derivePublic`], which turns a
//! private scalar into an uncompressed public point, and [`ecdh`], which
//! multiplies a peer's public point by our scalar to reach the shared secret.
//! Everything else here is the private machinery those two need.
//!
//! Representation. A field element ("fe") is 12 little-endian 32-bit limbs.
//! Each limb is stored in its own 8-byte slot (so an fe buffer is 96 bytes),
//! which keeps every intermediate product inside a 64-bit `ulong` and avoids
//! carry loss: a 32x32 multiply plus carries never overflows 64 bits. The
//! prime is p = 2^384 - 2^128 - 2^96 + 2^32 - 1, whose limbs are produced by
//! [`pl`] rather than stored as a constant. Elements live in the range
//! `[0, p)`; the module keeps them reduced after every add, subtract, and
//! multiply.
//!
//! Montgomery form. Field multiplication uses Montgomery reduction, so most
//! values circulating through the point routines are in Montgomery
//! representation (a value `x` is held as `x * R mod p`, R = 2^384). [`toMont`]
//! and [`fromMont`] move in and out of that domain. The one subtlety is that
//! [`feMul`] is a Montgomery multiply, so it folds an implicit factor of
//! `R^-1` into every product: two Montgomery-form inputs give a Montgomery-form
//! output, which is exactly why the point arithmetic can chain multiplies
//! freely.
//!
//! Points and constant time. Points are held in Jacobian projective
//! coordinates `(X, Y, Z)` (three field elements, 288 bytes), so a point add or
//! double needs no inversion; a single inversion at the end ([`toAffine`])
//! recovers the affine `(x, y)`. The scalar multiply [`scalarMultPoint`] is
//! written to run in constant time with respect to the secret scalar: it always
//! executes the same doublings and additions and selects the right addend with
//! branch-free conditional copies ([`ptCcopy`], driven by [`eqVal`] and
//! [`neqZero`]), so the sequence of operations does not leak the scalar's bits
//! through timing.
//!
//! Memory. There is no fixed-size stack array type here, so every field element
//! and point is a heap allocation from [`bytes.alloc`] and is released with
//! [`bytes.free`] before the function returns. The helpers own their scratch;
//! the two public functions own the working points and free them on every exit
//! path, including the early rejections in [`ecdh`]. This module is a leaf of
//! the crypto tree under `std/crypto/ecc`, sitting beside the other named
//! curves, and is consumed by the TLS key-exchange code rather than called
//! directly by applications.

import bytes;

/// Low 32 bits set: the mask that keeps a value to one 32-bit limb.
///
/// Every limb is materialised as `value & MASK32` after an arithmetic step, so
/// the high half of the 64-bit `ulong` carries into the next limb instead of
/// corrupting this one.
const MASK32: ulong = 0xffffffff;
/// The constant zero as a `ulong`, used wherever a typed zero limb is needed.
const U0: ulong = 0;
/// The constant one as a `ulong`, used for the low limb of one and for masks.
const U1: ulong = 1;


/// Allocates a fresh field element: 12 limbs in 8-byte slots, so 96 bytes.
///
/// The caller owns the returned buffer and must release it with
/// [`bytes.free`]. The contents are uninitialised, so callers that need a known
/// starting value follow this with [`feZero`] or a load.
fn newFe(): ptr { return bytes.alloc(96); }
/// Reads limb `i` (0-based) of a field element as a `ulong`.
///
/// Each limb occupies its own 8-byte slot at offset `i * 8`, so the value is a
/// 32-bit limb held in a 64-bit word. Pairs with [`setw`].
fn getw(f: ptr, i: int): ulong { return (bytes.read_ptr(f, i * 8) as long) as ulong; }
/// Writes `v` into limb `i` (0-based) of a field element.
///
/// The value is stored in the 8-byte slot at offset `i * 8`. Callers are
/// expected to have masked `v` to 32 bits already; this does not reduce.
fn setw(f: ptr, i: int, v: ulong): void { bytes.write_ptr(f, i * 8, (v as long) as ptr); }

/// Returns limb `i` of the curve prime p = 2^384 - 2^128 - 2^96 + 2^32 - 1.
///
/// The prime is computed limb by limb rather than stored: most limbs are all
/// ones (`MASK32`), but limbs 1 and 2 are zero and limb 4 is `0xfffffffe`,
/// which is the bit pattern that encodes the `- 2^128 - 2^96 + 2^32` terms.
/// Used by the reduction and comparison helpers ([`condSubP`], [`feSub`],
/// [`feLtP`], [`feMul`]).
fn pl(i: int): ulong {
    if (i == 1) { return U0; }
    if (i == 2) { return U0; }
    if (i == 4) { return 0xfffffffe; }
    return MASK32;
}

/// Copies all 12 limbs of field element `a` into `out`.
fn feCopy(out: ptr, a: ptr): void { let i = 0; while (i < 12) { setw(out, i, getw(a, i)); i = i + 1; } }
/// Sets field element `out` to zero by clearing all 12 limbs.
fn feZero(out: ptr): void { let i = 0; while (i < 12) { setw(out, i, U0); i = i + 1; } }

/// Conditionally subtracts the prime p from a 13-limb value, writing a reduced
/// field element to `out`.
///
/// The input `t` is a 13-limb value (12 limbs plus a top carry limb) produced
/// by an add or a Montgomery multiply, so it can be as large as roughly `2p`.
/// This computes `t - p` into a scratch buffer `d`, then decides whether the
/// subtraction was needed by looking at the final borrow: if `t >= p` there is
/// no borrow out of the top limb and the reduced difference is selected,
/// otherwise `t` was already less than p and the original is kept. The choice
/// is made with a branch-free mask so the operation is constant time. Frees its
/// scratch before returning.
fn condSubP(out: ptr, t: ptr): void {
    let d = bytes.alloc(96);
    let borrow: ulong = 0;
    let j = 0;
    while (j < 12) {
        let x = getw(t, j) - pl(j) - borrow;
        setw(d, j, x & MASK32);
        borrow = (x >> 32) & U1;
        j = j + 1;
    }
    let x12 = getw(t, 12) - borrow;
    borrow = (x12 >> 32) & U1;
    let mask = U0 - (borrow ^ U1);
    j = 0;
    while (j < 12) {
        setw(out, j, (getw(d, j) & mask) | (getw(t, j) & (~mask)));
        j = j + 1;
    }
    bytes.free(d);
}

/// Modular addition: `out = (a + b) mod p`.
///
/// Adds the two field elements limb by limb, propagating the carry into a
/// 13-limb temporary `t` whose top limb holds the final carry, then reduces
/// once with [`condSubP`]. A single conditional subtraction is enough because
/// both inputs are already in `[0, p)`, so their sum is below `2p`. Frees its
/// temporary before returning.
fn feAdd(out: ptr, a: ptr, b: ptr): void {
    let t = bytes.alloc(112);
    let carry: ulong = 0;
    let j = 0;
    while (j < 12) {
        let s = getw(a, j) + getw(b, j) + carry;
        setw(t, j, s & MASK32);
        carry = s >> 32;
        j = j + 1;
    }
    setw(t, 12, carry);
    condSubP(out, t);
    bytes.free(t);
}

/// Modular subtraction: `out = (a - b) mod p`.
///
/// Subtracts limb by limb into scratch `d`, tracking the borrow. If the result
/// went negative (a final borrow of one) the true value is `d + p`, so a mask
/// derived from the borrow adds the prime back in a second pass; if there was
/// no borrow the added term is zero and `d` passes through unchanged. Both
/// passes are unconditional, so the routine is constant time. Frees its scratch
/// before returning.
fn feSub(out: ptr, a: ptr, b: ptr): void {
    let d = bytes.alloc(96);
    let borrow: ulong = 0;
    let j = 0;
    while (j < 12) {
        let x = getw(a, j) - getw(b, j) - borrow;
        setw(d, j, x & MASK32);
        borrow = (x >> 32) & U1;
        j = j + 1;
    }
    let mask = U0 - borrow;
    let carry: ulong = 0;
    j = 0;
    while (j < 12) {
        let s = getw(d, j) + (pl(j) & mask) + carry;
        setw(out, j, s & MASK32);
        carry = s >> 32;
        j = j + 1;
    }
    bytes.free(d);
}

/// Montgomery multiplication: `out = (a * b * R^-1) mod p`, R = 2^384.
///
/// This is the workhorse of the module. It interleaves schoolbook
/// multiplication with Montgomery reduction using the classic CIOS
/// (coarsely integrated operand scanning) layout: for each limb `b[i]` it
/// accumulates the partial products into a 14-limb accumulator `t`, then folds
/// in one reduction step that clears the low limb by adding a multiple of p and
/// shifts the window down by one limb. Because p ends in `- 1`, the reduction
/// multiplier for each step is simply the current low limb `m`, so no separate
/// n-prime constant is needed. After 12 rounds the accumulator holds the
/// Montgomery product in the low 12 limbs plus a carry, which [`condSubP`]
/// reduces into `out`. Both inputs and the output are in Montgomery form. Frees
/// its accumulator before returning.
fn feMul(out: ptr, a: ptr, b: ptr): void {
    let t = bytes.alloc(112);
    let j = 0;
    while (j < 14) { setw(t, j, U0); j = j + 1; }
    let i = 0;
    while (i < 12) {
        let bi = getw(b, i);
        let carry: ulong = 0;
        j = 0;
        while (j < 12) {
            let s = getw(t, j) + getw(a, j) * bi + carry;
            setw(t, j, s & MASK32);
            carry = s >> 32;
            j = j + 1;
        }
        let s12 = getw(t, 12) + carry;
        setw(t, 12, s12 & MASK32);
        setw(t, 13, s12 >> 32);
        let m = getw(t, 0);
        let c2 = (getw(t, 0) + m * pl(0)) >> 32;
        j = 1;
        while (j < 12) {
            let s = getw(t, j) + m * pl(j) + c2;
            setw(t, j - 1, s & MASK32);
            c2 = s >> 32;
            j = j + 1;
        }
        let s11 = getw(t, 12) + c2;
        setw(t, 11, s11 & MASK32);
        setw(t, 12, getw(t, 13) + (s11 >> 32));
        i = i + 1;
    }
    condSubP(out, t);
    bytes.free(t);
}
/// Montgomery squaring: `out = (a * a * R^-1) mod p`.
///
/// A thin alias for [`feMul`] with both operands the same; kept separate so the
/// point routines read as squarings where a squaring is meant.
fn feSq(out: ptr, a: ptr): void { feMul(out, a, a); }

/// Converts an ordinary field element into Montgomery form: `out = a * R mod p`.
///
/// It multiplies by R = 2^384 the slow but obvious way, by doubling 384 times
/// modulo p (each [`feAdd`] of the value to itself is one left shift with
/// reduction). This is only used for one-off setup (loading the base point, the
/// curve constant b, and peer coordinates), so the cost does not matter and the
/// approach avoids needing a precomputed R^2 constant.
fn toMont(out: ptr, a: ptr): void {
    feCopy(out, a);
    let i = 0;
    while (i < 384) { feAdd(out, out, out); i = i + 1; }
}
/// Converts a Montgomery-form element back to an ordinary integer: `out = x * R^-1 mod p`.
///
/// A Montgomery multiply by the value one clears the extra R factor, because
/// [`feMul`] already folds in an `R^-1`: `x * 1 * R^-1 = x * R^-1`. The literal
/// one is built in ordinary (non-Montgomery) form. Frees its scratch before
/// returning.
fn fromMont(out: ptr, x: ptr): void {
    let one = newFe(); feZero(one); setw(one, 0, U1);
    feMul(out, x, one);
    bytes.free(one);
}

/// Constant-time equality of two field elements.
///
/// It ORs together the XOR of every limb pair, so the accumulator stays zero
/// only when all limbs match, and the single comparison at the end does not
/// short-circuit or depend on which limb differed. Assumes both inputs are
/// already reduced into `[0, p)`, since it compares limb patterns, not values
/// modulo p.
fn feEq(a: ptr, b: ptr): bool {
    let diff: ulong = 0;
    let j = 0;
    while (j < 12) { diff = diff | (getw(a, j) ^ getw(b, j)); j = j + 1; }
    return diff == U0;
}
/// Reports whether field element `a` is strictly less than the prime p.
///
/// It performs a trial subtraction `a - p` limb by limb and returns whether a
/// borrow fell out of the top limb: a borrow means `a < p`. This is the range
/// check used on peer-supplied coordinates in [`ecdh`], where a value at or
/// above p must be rejected as invalid.
fn feLtP(a: ptr): bool {
    let borrow: ulong = 0;
    let j = 0;
    while (j < 12) {
        let x = getw(a, j) - pl(j) - borrow;
        borrow = (x >> 32) & U1;
        j = j + 1;
    }
    return borrow == U1;
}

/// Decodes one ASCII hex digit to its 0..15 value.
///
/// Handles the three ranges directly: `'0'..'9'` (48..57), lowercase `'a'..'f'`
/// (97..102, minus 87), and by the final fall-through uppercase `'A'..'F'`
/// (65..70, minus 55). It does not validate its input; a non-hex byte yields a
/// meaningless number, which is acceptable because the only callers pass fixed,
/// known-good constant strings.
fn nib(c: int): int {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    return c - 55;
}
/// Fills a byte buffer from a hex string, two hex digits per byte.
///
/// Writes `hex.length / 2` bytes, each the big-endian pairing of two [`nib`]
/// digits. Used to load the compile-time curve constants (the base point, the
/// constant b, and the inversion exponent) into raw byte buffers before they
/// are parsed into field elements. The caller must size `buf` for at least that
/// many bytes.
fn setHex(buf: ptr, hex: string): void {
    let n = hex.length / 2;
    let i = 0;
    while (i < n) { bytes.write_byte(buf, i, nib(hex[i * 2]) * 16 + nib(hex[i * 2 + 1])); i = i + 1; }
}

/// Modular inverse in Montgomery form: `out = a^-1` (Montgomery to Montgomery).
///
/// It computes the inverse by Fermat's little theorem, raising `a` to the power
/// `p - 2` since `a^(p-2) = a^-1 mod p`. The exponent `p - 2` is loaded as a
/// 48-byte big-endian constant and consumed bit by bit from the top down in a
/// square-and-multiply loop: square every iteration, and multiply in `a` where
/// the exponent bit is set. The accumulator starts at the Montgomery
/// representation of one ([`montOne`]) so the whole computation stays in the
/// Montgomery domain and the result is `a^-1` in Montgomery form. This is the
/// single inversion used per point, deferred to [`toAffine`]. Frees its scratch
/// before returning.
fn feInvert(out: ptr, a: ptr): void {
    let r = newFe(); montOne(r);
    let e = bytes.alloc(48);
    setHex(e, "fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffeffffffff0000000000000000fffffffd");
    let k = 383;
    while (k >= 0) {
        feSq(r, r);
        let bitVal = (bytes.read_byte(e, 47 - (k >> 3)) >> (k & 7)) & 1;
        if (bitVal == 1) { feMul(r, r, a); }
        k = k - 1;
    }
    feCopy(out, r);
    bytes.free(r); bytes.free(e);
}
/// Writes the Montgomery representation of one into `out`.
///
/// Builds the integer one, then maps it into Montgomery form with [`toMont`],
/// giving `R mod p`. This is the multiplicative identity used to seed
/// square-and-multiply loops ([`feInvert`]) and to initialise the Z coordinate
/// of a point. Frees its scratch before returning.
fn montOne(out: ptr): void {
    let one = newFe(); feZero(one); setw(one, 0, U1);
    toMont(out, one);
    bytes.free(one);
}


/// Loads a field element from a 48-byte big-endian buffer at offset `off`.
///
/// The wire format for P-384 coordinates is 48 bytes big-endian, but the
/// internal limbs are little-endian 32-bit words, so limb `i` is assembled from
/// the four bytes at the mirrored position `(11 - i) * 4`. The result is an
/// ordinary field element, not yet in Montgomery form.
fn feFromBE(out: ptr, buf: ptr, off: int): void {
    let i = 0;
    while (i < 12) {
        let base = off + (11 - i) * 4;
        let w = ((bytes.read_byte(buf, base) as ulong) << 24)
              | ((bytes.read_byte(buf, base + 1) as ulong) << 16)
              | ((bytes.read_byte(buf, base + 2) as ulong) << 8)
              | (bytes.read_byte(buf, base + 3) as ulong);
        setw(out, i, w);
        i = i + 1;
    }
}
/// Stores a field element into a 48-byte big-endian buffer at offset `off`.
///
/// The inverse of [`feFromBE`]: it serialises the little-endian limbs back to
/// big-endian wire order, writing limb `i` into the four bytes at
/// `(11 - i) * 4`. The input should be an ordinary (non-Montgomery) field
/// element, as produced by [`fromMont`].
fn feToBE(buf: ptr, off: int, a: ptr): void {
    let i = 0;
    while (i < 12) {
        let base = off + (11 - i) * 4;
        let w = getw(a, i);
        bytes.write_byte(buf, base, ((w >> 24) & 0xff) as int);
        bytes.write_byte(buf, base + 1, ((w >> 16) & 0xff) as int);
        bytes.write_byte(buf, base + 2, ((w >> 8) & 0xff) as int);
        bytes.write_byte(buf, base + 3, (w & 0xff) as int);
        i = i + 1;
    }
}

/// Writes the curve constant b into `out` in Montgomery form.
///
/// b is the P-384 equation constant from `y^2 = x^3 - 3x + b`. It is loaded
/// from its published big-endian hex, parsed with [`feFromBE`], then mapped
/// into Montgomery form so it can be added directly to the Montgomery-form
/// right-hand side in [`onCurve`]. Frees its scratch before returning.
fn bMont(out: ptr): void {
    let b = bytes.alloc(48);
    setHex(b, "b3312fa7e23ee7e4988e056be3f82d19181d9c6efe8141120314088f5013875ac656398d8a2ed19d2a85c8edd3ec2aef");
    let t = newFe();
    feFromBE(t, b, 0);
    toMont(out, t);
    bytes.free(b); bytes.free(t);
}


/// Allocates a fresh Jacobian point: three field elements `(X, Y, Z)`, 288 bytes.
///
/// The three coordinates are laid out contiguously so [`px`], [`py`], and
/// [`pz`] can address them by offset. The caller owns the buffer and frees it
/// with [`bytes.free`]; the contents are uninitialised until loaded or zeroed.
fn newPt(): ptr { return bytes.alloc(288); }
/// Returns a pointer to the X coordinate of point `p` (offset 0).
fn px(p: ptr): ptr { return p; }
/// Returns a pointer to the Y coordinate of point `p` (offset 96, the second fe).
fn py(p: ptr): ptr { return (p as long + 96) as ptr; }
/// Returns a pointer to the Z coordinate of point `p` (offset 192, the third fe).
fn pz(p: ptr): ptr { return (p as long + 192) as ptr; }

/// Copies all three coordinates (36 limbs) of point `s` into `d`.
fn ptCopy(d: ptr, s: ptr): void { let i = 0; while (i < 36) { setw(d, i, getw(s, i)); i = i + 1; } }
/// Zeroes all three coordinates of point `p`.
///
/// With `Z = 0` this is the representation of the point at infinity, which is
/// how [`scalarMultPoint`] seeds its accumulator before the first real addend.
fn ptZero(p: ptr): void { let i = 0; while (i < 36) { setw(p, i, U0); i = i + 1; } }
/// Constant-time conditional copy: `d = s` when `flag` is 1, unchanged when 0.
///
/// `flag` must be exactly 0 or 1. It is expanded to an all-ones or all-zeros
/// mask, and each limb of `d` is rebuilt by selecting bits from `s` or the
/// existing `d`, so the same memory traffic happens regardless of the flag. The
/// scalar multiply relies on this to pick an addend without a data-dependent
/// branch, which is what keeps the secret scalar from leaking through timing.
fn ptCcopy(d: ptr, s: ptr, flag: ulong): void {
    let mask = U0 - flag;
    let i = 0;
    while (i < 36) { setw(d, i, (getw(s, i) & mask) | (getw(d, i) & (~mask))); i = i + 1; }
}

/// Point doubling in place: `q = 2q` in Jacobian coordinates.
///
/// Implements the standard `a = -3` doubling formulas (which P-384 admits, its
/// curve coefficient being `-3`), operating on the Montgomery-form coordinates
/// with the field primitives. Everything is projective, so no inversion is
/// needed; the result overwrites `q`. Correct for the point at infinity too,
/// since the formulas keep `Z = 0`. All four scratch elements are freed before
/// returning.
fn jDouble(q: ptr): void {
    let t1 = newFe(); let t2 = newFe(); let t3 = newFe(); let t4 = newFe();
    feSq(t1, pz(q));
    feAdd(t2, px(q), t1);
    feSub(t1, px(q), t1);
    feMul(t3, t1, t2);
    feAdd(t1, t3, t3);
    feAdd(t1, t3, t1);
    feSq(t3, py(q));
    feAdd(t3, t3, t3);
    feMul(t2, px(q), t3);
    feAdd(t2, t2, t2);
    feSq(px(q), t1);
    feSub(px(q), px(q), t2);
    feSub(px(q), px(q), t2);
    feMul(t4, py(q), pz(q));
    feAdd(pz(q), t4, t4);
    feSub(t2, t2, px(q));
    feMul(py(q), t1, t2);
    feSq(t4, t3);
    feAdd(t4, t4, t4);
    feSub(py(q), py(q), t4);
    bytes.free(t1); bytes.free(t2); bytes.free(t3); bytes.free(t4);
}

/// Point addition in place: `p1 = p1 + p2` in Jacobian coordinates.
///
/// Adds two projective points using the general Jacobian addition formulas,
/// writing the sum back into `p1`. It is not a complete addition formula: it
/// does not special-case `p1 == p2` (doubling) or an infinity operand, so
/// [`scalarMultPoint`] is arranged so those cases never reach it on the value
/// that matters, guarding the accumulator with conditional copies instead. All
/// seven scratch elements are freed before returning.
fn jAdd(p1: ptr, p2: ptr): void {
    let t1 = newFe(); let t2 = newFe(); let t3 = newFe(); let t4 = newFe();
    let t5 = newFe(); let t6 = newFe(); let t7 = newFe();
    feSq(t3, pz(p2));
    feMul(t1, px(p1), t3);
    feMul(t4, pz(p2), t3);
    feMul(t3, py(p1), t4);
    feSq(t4, pz(p1));
    feMul(t2, px(p2), t4);
    feMul(t5, pz(p1), t4);
    feMul(t4, py(p2), t5);
    feSub(t2, t2, t1);
    feSub(t4, t4, t3);
    feSq(t7, t2);
    feMul(t6, t1, t7);
    feMul(t5, t7, t2);
    feSq(px(p1), t4);
    feSub(px(p1), px(p1), t5);
    feSub(px(p1), px(p1), t6);
    feSub(px(p1), px(p1), t6);
    feSub(t6, t6, px(p1));
    feMul(py(p1), t4, t6);
    feMul(t1, t5, t3);
    feSub(py(p1), py(p1), t1);
    feMul(t1, pz(p1), pz(p2));
    feMul(pz(p1), t1, t2);
    bytes.free(t1); bytes.free(t2); bytes.free(t3); bytes.free(t4);
    bytes.free(t5); bytes.free(t6); bytes.free(t7);
}

/// Constant-time "is non-zero": returns 1 if `v != 0`, else 0.
///
/// It ORs `v` with its two's-complement negation, which sets the top bit for
/// any non-zero `v` and stays zero only for zero, then extracts that sign bit.
/// No branch, so it does not leak whether `v` was zero. Used to build the
/// selection masks in [`scalarMultPoint`].
fn neqZero(v: ulong): ulong { return ((v | (U0 - v)) >> 63) & U1; }
/// Constant-time equality against a constant: returns 1 if `v == c`, else 0.
///
/// Computed as the logical negation of [`neqZero(v ^ c)`], so it too runs
/// branch-free. Used to test the current two-bit window against the values 2
/// and 3 when choosing which precomputed multiple to add.
fn eqVal(v: ulong, c: ulong): ulong { return neqZero(v ^ c) ^ U1; }

/// Scalar multiplication in place: `p = x * p`, constant time in `x`.
///
/// This is the core of both public functions. It precomputes `2p` and `3p`, then
/// scans the big-endian scalar `x` two bits at a time (a fixed-window ladder):
/// each window doubles the accumulator twice, selects one of `p`, `2p`, or `3p`
/// according to the window value, adds it, and commits the result. The tricky
/// part is the accumulator starting at infinity, which the incomplete [`jAdd`]
/// cannot handle: while the accumulator is still infinity (`qz == 1`) a real
/// addend is copied in directly rather than added, and once a non-zero window
/// has been seen the code switches to the added form. All of the selection is
/// done with [`ptCcopy`] driven by [`neqZero`]/[`eqVal`] masks, so the same
/// doublings, the same add, and the same copies execute for every scalar,
/// leaking nothing through control flow. The window value zero is handled by
/// simply not committing an addend (`bnz == 0`). Frees all five working points
/// before returning.
fn scalarMultPoint(p: ptr, x: ptr, xlen: int): void {
    let p2 = newPt(); ptCopy(p2, p); jDouble(p2);
    let p3 = newPt(); ptCopy(p3, p); jAdd(p3, p2);
    let q = newPt(); ptZero(q);
    let tt = newPt(); let uu = newPt();
    let qz: ulong = 1;
    let bi = 0;
    while (bi < xlen) {
        let byteV = bytes.read_byte(x, bi);
        let k = 6;
        while (k >= 0) {
            jDouble(q); jDouble(q);
            ptCopy(tt, p);
            ptCopy(uu, q);
            let bitsPair = ((byteV >> k) & 3) as ulong;
            let bnz = neqZero(bitsPair);
            ptCcopy(tt, p2, eqVal(bitsPair, 2));
            ptCcopy(tt, p3, eqVal(bitsPair, 3));
            jAdd(uu, tt);
            ptCcopy(q, tt, bnz & qz);
            ptCcopy(q, uu, bnz & (qz ^ U1));
            qz = qz & (bnz ^ U1);
            k = k - 2;
        }
        bi = bi + 1;
    }
    ptCopy(p, q);
    bytes.free(p2); bytes.free(p3); bytes.free(q); bytes.free(tt); bytes.free(uu);
}

/// Converts a Jacobian point to affine `(x, y)` in ordinary integer form.
///
/// Recovers affine coordinates from projective ones with a single field
/// inversion: given `Z`, compute `Z^-1`, then `x = X * Z^-2` and
/// `y = Y * Z^-3`. The single [`feInvert`] here is why the point operations
/// stay projective throughout, deferring the one expensive inversion to the
/// end. The two outputs are written in ordinary form via [`fromMont`], ready
/// for [`feToBE`]. Frees all five scratch elements before returning.
fn toAffine(p: ptr, xaOut: ptr, yaOut: ptr): void {
    let zinv = newFe(); feInvert(zinv, pz(p));
    let z2 = newFe(); feSq(z2, zinv);
    let xm = newFe(); feMul(xm, px(p), z2);
    let z3 = newFe(); feMul(z3, z2, zinv);
    let ym = newFe(); feMul(ym, py(p), z3);
    fromMont(xaOut, xm);
    fromMont(yaOut, ym);
    bytes.free(zinv); bytes.free(z2); bytes.free(xm); bytes.free(z3); bytes.free(ym);
}

/// Loads the P-384 base point G into `p` in Montgomery Jacobian form.
///
/// The generator's affine coordinates `(Gx, Gy)` are the published constants,
/// loaded from big-endian hex and mapped into Montgomery form; the Z coordinate
/// is set to the Montgomery representation of one, which places the affine point
/// into Jacobian coordinates. [`derivePublic`] starts from this point before
/// multiplying by the private scalar. Frees its scratch before returning.
fn baseG(p: ptr): void {
    let gx = bytes.alloc(48);
    setHex(gx, "aa87ca22be8b05378eb1c71ef320ad746e1d3b628ba79b9859f741e082542a385502f25dbf55296c3a545e3872760ab7");
    let gy = bytes.alloc(48);
    setHex(gy, "3617de4a96262c6f5d9e98bf9292dc29f8f41dbd289a147ce9da3113b5f0b8c00a60b1ce1d7e819d7a431d7c90ea0e5f");
    let t = newFe();
    feFromBE(t, gx, 0); toMont(px(p), t);
    feFromBE(t, gy, 0); toMont(py(p), t);
    feZero(t); setw(t, 0, U1); toMont(pz(p), t);
    bytes.free(gx); bytes.free(gy); bytes.free(t);
}

/// Checks whether affine `(xn, yn)` satisfies the P-384 curve equation.
///
/// Verifies `y^2 == x^3 - 3x + b` over the field. The inputs arrive in ordinary
/// form, so they are first mapped to Montgomery form; then the left side `y^2`
/// and the right side `x^3 - 3x + b` (with b from [`bMont`]) are built with the
/// field primitives and compared in constant time by [`feEq`]. This is the
/// point-on-curve validation [`ecdh`] runs on a peer's public key to reject
/// invalid-curve attack inputs. Frees all six scratch elements before returning.
fn onCurve(xn: ptr, yn: ptr): bool {
    let xm = newFe(); let ym = newFe();
    toMont(xm, xn); toMont(ym, yn);
    let l = newFe(); feSq(l, ym);
    let r = newFe(); feSq(r, xm); feMul(r, r, xm);
    let t = newFe(); feAdd(t, xm, xm); feAdd(t, t, xm);
    feSub(r, r, t);
    let bm = newFe(); bMont(bm); feAdd(r, r, bm);
    let ok = feEq(l, r);
    bytes.free(xm); bytes.free(ym); bytes.free(l); bytes.free(r); bytes.free(t); bytes.free(bm);
    return ok;
}


/// Derives a P-384 public key from a private scalar.
///
/// Computes `Q = scalar * G` and writes the uncompressed SEC1 encoding of `Q`
/// into `outPub97`: a leading `0x04` tag byte, then the 48-byte big-endian x
/// coordinate, then the 48-byte big-endian y, for 97 bytes total. `scalar48`
/// is the 48-byte big-endian private key. The scalar multiply is constant time,
/// so this does not leak the private key through timing. The caller owns and
/// sizes both buffers (97 bytes out, 48 bytes in). All working memory is freed
/// before returning. See [`ecdh`] for the shared-secret half of key exchange.
pub fn derivePublic(outPub97: ptr, scalar48: ptr): void {
    let g = newPt(); baseG(g);
    scalarMultPoint(g, scalar48, 48);
    let xa = newFe(); let ya = newFe();
    toAffine(g, xa, ya);
    bytes.write_byte(outPub97, 0, 4);
    feToBE(outPub97, 1, xa);
    feToBE(outPub97, 49, ya);
    bytes.free(g); bytes.free(xa); bytes.free(ya);
}

/// Computes the ECDH shared secret from our scalar and a peer's public point.
///
/// Multiplies the peer's public point by our private scalar and writes the
/// 48-byte big-endian x coordinate of the result into `outSecret48`, which is
/// the raw ECDH shared secret (a KDF is applied by the caller, not here).
/// `peerPub97` is the peer's uncompressed SEC1 point (0x04 tag plus x and y),
/// and `scalar48` is our 48-byte big-endian private scalar. Returns 1 on
/// success and 0 on rejection.
///
/// It validates the peer point before using it, which is essential: the tag
/// byte must be 0x04, each coordinate must be less than the prime ([`feLtP`]),
/// and the point must satisfy the curve equation ([`onCurve`]). Skipping these
/// would open an invalid-curve attack that can recover the private scalar. On
/// any failed check it frees what it has allocated and returns 0. All working
/// memory is freed on every path. See [`derivePublic`] for the key-generation
/// half.
pub fn ecdh(outSecret48: ptr, scalar48: ptr, peerPub97: ptr): int {
    if (bytes.read_byte(peerPub97, 0) != 4) { return 0; }
    let xn = newFe(); let yn = newFe();
    feFromBE(xn, peerPub97, 1); feFromBE(yn, peerPub97, 49);
    if (!feLtP(xn) || !feLtP(yn) || !onCurve(xn, yn)) {
        bytes.free(xn); bytes.free(yn);
        return 0;
    }
    let q = newPt();
    toMont(px(q), xn); toMont(py(q), yn);
    let one = newFe(); feZero(one); setw(one, 0, U1); toMont(pz(q), one);
    scalarMultPoint(q, scalar48, 48);
    let xa = newFe(); let ya = newFe();
    toAffine(q, xa, ya);
    feToBE(outSecret48, 0, xa);
    bytes.free(xn); bytes.free(yn); bytes.free(q); bytes.free(one);
    bytes.free(xa); bytes.free(ya);
    return 1;
}
