//! X25519: Diffie-Hellman key agreement over Curve25519 (RFC 7748).
//!
//! This file implements the single primitive that X25519 needs, the
//! `scalarMult(out, scalar, point)` operation: it multiplies a 32-byte
//! Montgomery-curve u-coordinate by a 32-byte scalar and writes the resulting
//! 32-byte u-coordinate. Everything else in an ECDH exchange (generating a key
//! pair by multiplying the fixed base point 9, deriving a shared secret by
//! multiplying the peer's public u by our secret scalar) is just this function
//! called with different arguments, so callers such as the TLS 1.3 handshake
//! and the `crypto` facade build key exchange directly on top of it.
//!
//! The curve is `y^2 = x^3 + 486662 x^2 + x` over the prime field GF(p) with
//! p = 2^255 - 19. Scalar multiplication uses the classic Montgomery ladder on
//! the (X:Z) projective u-coordinate, which needs no point addition formula and
//! no y-coordinate. The ladder is written to be CONSTANT TIME with respect to
//! the secret scalar: every bit does the same work, and the conditional swap of
//! the two ladder points is done with a bit mask (`feCswap` / `cswap51`) rather
//! than a branch, so the secret never steers control flow or memory addressing.
//!
//! ## Two field backends, one interface
//!
//! Arithmetic in GF(2^255 - 19) is the whole cost of the operation, so this
//! file carries TWO independent implementations of the field, selected at the
//! bottom:
//!
//!   1. The **51-bit backend** (`*51` functions, five 51-bit limbs, radix
//!      2^51). This is the fast path. It multiplies limbs as full 64x64 -> 128
//!      products using `simd.mulhi64` for the high half, so it needs the SIMD
//!      high-multiply intrinsic to be available. `scalarMult` dispatches here.
//!   2. The **25.5-bit reference backend** (`fe*` functions, ten limbs in the
//!      alternating 26/25-bit radix from the original ref10 code). Every limb
//!      product fits in 64 bits, so it depends on nothing beyond plain integer
//!      arithmetic. It is exposed as `scalarMultRef` and exists as a portable
//!      cross-check: given the same inputs it must produce the same 32 bytes as
//!      the 51-bit path, which is how the fast backend is validated.
//!
//! Both backends store a field element as a small heap block of 64-bit limbs
//! (`bytes.alloc`), passed around as a raw `ptr`. The limbs are deliberately
//! left UNREDUCED between operations (a redundant representation): additions and
//! multiplications let limbs grow and only fold the excess back with a carry
//! pass, which is what makes the constant-time ladder cheap. A field element is
//! canonicalised to a unique value only at the very end, in `feToBytes` /
//! `toBytes51`, which perform the final conditional subtraction of p.
//!
//! ## Memory and safety notes
//!
//! Everything here is manual pointer arithmetic over `bytes`, not managed Nova
//! values, so each backend allocates its scratch field elements up front and
//! frees every one of them before returning. The limb buffers hold 64-bit
//! values, so limb `i` lives at byte offset `i * 8`; addresses are handled as
//! `ptr` / `long` and never as `int`, because a 32-bit `int` would truncate a
//! heap address (see the address-truncation gotcha in the language notes). The
//! caller owns `out`, `scalar`, and `point`: each must be a readable/writable
//! 32-byte buffer, and `out` may not alias `scalar` or `point`.

import bytes;

/// Allocates one field element for the 25.5-bit reference backend.
///
/// Ten limbs would be 80 bytes; the block is sized 80 so limb `i` sits at byte
/// offset `i * 8`. The contents are uninitialised, so a caller that needs a
/// zeroed element must clear it (as [`scalarMultRef`] does before the ladder).
/// The returned block must eventually be released with `bytes.free`.
fn newFe(): ptr { return bytes.alloc(80); }
/// Reads limb `i` of a reference-backend field element as a signed 64-bit value.
///
/// Limbs live at byte offset `i * 8`. They are stored through a `ptr` slot but
/// interpreted as `long`, because the 25.5-bit representation carries SIGNED
/// limbs (subtraction in [`feSub`] can leave a limb negative until the next
/// carry pass).
fn getl(f: ptr, i: int): long { return bytes.read_ptr(f, i * 8) as long; }
/// Writes `v` into limb `i` (byte offset `i * 8`) of a reference-backend element.
///
/// The inverse of [`getl`]. Values are stored via a `ptr`-width slot, so the
/// full 64 bits of `v`, including a negative limb, round-trip intact.
fn setl(f: ptr, i: int, v: long): void { bytes.write_ptr(f, i * 8, v as ptr); }

/// Loads three little-endian bytes at `off` as a 24-bit unsigned integer.
///
/// A building block for [`feFromBytes`], which unpacks the 32-byte wire encoding
/// into ten radix-2^25.5 limbs by reading overlapping 3- and 4-byte windows.
fn load3(s: ptr, off: int): long {
    return (bytes.read_byte(s, off) as long)
        | ((bytes.read_byte(s, off + 1) as long) << 8)
        | ((bytes.read_byte(s, off + 2) as long) << 16);
}
/// Loads four little-endian bytes at `off` as a 32-bit unsigned integer.
///
/// Companion to [`load3`], used by [`feFromBytes`] for the limb positions that
/// take a full four bytes of the input.
fn load4(s: ptr, off: int): long {
    return (bytes.read_byte(s, off) as long)
        | ((bytes.read_byte(s, off + 1) as long) << 8)
        | ((bytes.read_byte(s, off + 2) as long) << 16)
        | ((bytes.read_byte(s, off + 3) as long) << 24);
}

/// Unpacks a 32-byte little-endian field element into ten 25.5-bit limbs.
///
/// This is the reference-backend decoder. The 255-bit value is split into ten
/// limbs alternating between 26 and 25 bits (the classic ref10 radix), each
/// shifted into place from an overlapping window of the input. The final limb is
/// masked to 23 bits and the top bit of byte 31 is discarded, which is what
/// clears bit 255 of the input as RFC 7748 requires. The tail runs one carry
/// pass so the freshly loaded limbs start within their nominal ranges.
fn feFromBytes(h: ptr, s: ptr): void {
    let h0 = load4(s, 0);
    let h1 = load3(s, 4) << 6;
    let h2 = load3(s, 7) << 5;
    let h3 = load3(s, 10) << 3;
    let h4 = load3(s, 13) << 2;
    let h5 = load4(s, 16);
    let h6 = load3(s, 20) << 7;
    let h7 = load3(s, 23) << 5;
    let h8 = load3(s, 26) << 4;
    let h9 = (load3(s, 29) & 8388607) << 2;
    let c9 = (h9 + (1 << 24)) >> 25; h0 = h0 + c9 * 19; h9 = h9 - (c9 << 25);
    let c1 = (h1 + (1 << 24)) >> 25; h2 = h2 + c1; h1 = h1 - (c1 << 25);
    let c3 = (h3 + (1 << 24)) >> 25; h4 = h4 + c3; h3 = h3 - (c3 << 25);
    let c5 = (h5 + (1 << 24)) >> 25; h6 = h6 + c5; h5 = h5 - (c5 << 25);
    let c7 = (h7 + (1 << 24)) >> 25; h8 = h8 + c7; h7 = h7 - (c7 << 25);
    let c0 = (h0 + (1 << 25)) >> 26; h1 = h1 + c0; h0 = h0 - (c0 << 26);
    let c2 = (h2 + (1 << 25)) >> 26; h3 = h3 + c2; h2 = h2 - (c2 << 26);
    let c4 = (h4 + (1 << 25)) >> 26; h5 = h5 + c4; h4 = h4 - (c4 << 26);
    let c6 = (h6 + (1 << 25)) >> 26; h7 = h7 + c6; h6 = h6 - (c6 << 26);
    let c8 = (h8 + (1 << 25)) >> 26; h9 = h9 + c8; h8 = h8 - (c8 << 26);
    setl(h, 0, h0); setl(h, 1, h1); setl(h, 2, h2); setl(h, 3, h3); setl(h, 4, h4);
    setl(h, 5, h5); setl(h, 6, h6); setl(h, 7, h7); setl(h, 8, h8); setl(h, 9, h9);
}

/// Serialises a reference-backend field element to 32 canonical little-endian bytes.
///
/// This performs the final reduction that the redundant limb representation
/// defers everywhere else. It first computes the carry `q` that decides whether
/// the value is >= p (p = 2^255 - 19), adds `19 * q` to fold in that multiple of
/// p, runs a full carry chain so every limb is in range, and then repacks the
/// ten limbs into 32 bytes. The result is the unique canonical encoding: two
/// field elements equal mod p produce identical bytes. This is the point where a
/// value stops being "some representative" and becomes a definite number.
fn feToBytes(s: ptr, h: ptr): void {
    let h0 = getl(h, 0); let h1 = getl(h, 1); let h2 = getl(h, 2); let h3 = getl(h, 3); let h4 = getl(h, 4);
    let h5 = getl(h, 5); let h6 = getl(h, 6); let h7 = getl(h, 7); let h8 = getl(h, 8); let h9 = getl(h, 9);
    let q = (19 * h9 + (1 << 24)) >> 25;
    q = (h0 + q) >> 26; q = (h1 + q) >> 25; q = (h2 + q) >> 26; q = (h3 + q) >> 25;
    q = (h4 + q) >> 26; q = (h5 + q) >> 25; q = (h6 + q) >> 26; q = (h7 + q) >> 25;
    q = (h8 + q) >> 26; q = (h9 + q) >> 25;
    h0 = h0 + 19 * q;
    let c0 = h0 >> 26; h1 = h1 + c0; h0 = h0 - (c0 << 26);
    let c1 = h1 >> 25; h2 = h2 + c1; h1 = h1 - (c1 << 25);
    let c2 = h2 >> 26; h3 = h3 + c2; h2 = h2 - (c2 << 26);
    let c3 = h3 >> 25; h4 = h4 + c3; h3 = h3 - (c3 << 25);
    let c4 = h4 >> 26; h5 = h5 + c4; h4 = h4 - (c4 << 26);
    let c5 = h5 >> 25; h6 = h6 + c5; h5 = h5 - (c5 << 25);
    let c6 = h6 >> 26; h7 = h7 + c6; h6 = h6 - (c6 << 26);
    let c7 = h7 >> 25; h8 = h8 + c7; h7 = h7 - (c7 << 25);
    let c8 = h8 >> 26; h9 = h9 + c8; h8 = h8 - (c8 << 26);
    let c9 = h9 >> 25; h9 = h9 - (c9 << 25);
    bytes.write_byte(s, 0, (h0 >> 0) & 0xff);
    bytes.write_byte(s, 1, (h0 >> 8) & 0xff);
    bytes.write_byte(s, 2, (h0 >> 16) & 0xff);
    bytes.write_byte(s, 3, ((h0 >> 24) | (h1 << 2)) & 0xff);
    bytes.write_byte(s, 4, (h1 >> 6) & 0xff);
    bytes.write_byte(s, 5, (h1 >> 14) & 0xff);
    bytes.write_byte(s, 6, ((h1 >> 22) | (h2 << 3)) & 0xff);
    bytes.write_byte(s, 7, (h2 >> 5) & 0xff);
    bytes.write_byte(s, 8, (h2 >> 13) & 0xff);
    bytes.write_byte(s, 9, ((h2 >> 21) | (h3 << 5)) & 0xff);
    bytes.write_byte(s, 10, (h3 >> 3) & 0xff);
    bytes.write_byte(s, 11, (h3 >> 11) & 0xff);
    bytes.write_byte(s, 12, ((h3 >> 19) | (h4 << 6)) & 0xff);
    bytes.write_byte(s, 13, (h4 >> 2) & 0xff);
    bytes.write_byte(s, 14, (h4 >> 10) & 0xff);
    bytes.write_byte(s, 15, (h4 >> 18) & 0xff);
    bytes.write_byte(s, 16, (h5 >> 0) & 0xff);
    bytes.write_byte(s, 17, (h5 >> 8) & 0xff);
    bytes.write_byte(s, 18, (h5 >> 16) & 0xff);
    bytes.write_byte(s, 19, ((h5 >> 24) | (h6 << 1)) & 0xff);
    bytes.write_byte(s, 20, (h6 >> 7) & 0xff);
    bytes.write_byte(s, 21, (h6 >> 15) & 0xff);
    bytes.write_byte(s, 22, ((h6 >> 23) | (h7 << 3)) & 0xff);
    bytes.write_byte(s, 23, (h7 >> 5) & 0xff);
    bytes.write_byte(s, 24, (h7 >> 13) & 0xff);
    bytes.write_byte(s, 25, ((h7 >> 21) | (h8 << 4)) & 0xff);
    bytes.write_byte(s, 26, (h8 >> 4) & 0xff);
    bytes.write_byte(s, 27, (h8 >> 12) & 0xff);
    bytes.write_byte(s, 28, ((h8 >> 20) | (h9 << 6)) & 0xff);
    bytes.write_byte(s, 29, (h9 >> 2) & 0xff);
    bytes.write_byte(s, 30, (h9 >> 10) & 0xff);
    bytes.write_byte(s, 31, (h9 >> 18) & 0xff);
}

/// Field addition (reference backend): `out = a + b`, limb by limb.
///
/// No carry pass is done here; the limbs simply grow. The redundant
/// representation tolerates this, and the next multiply or the final
/// [`feToBytes`] normalises the result. `out` may alias `a` or `b`.
fn feAdd(out: ptr, a: ptr, b: ptr): void {
    let i = 0;
    while (i < 10) { setl(out, i, getl(a, i) + getl(b, i)); i = i + 1; }
}
/// Field subtraction (reference backend): `out = a - b`, limb by limb.
///
/// Because limbs are signed here, a straight per-limb subtraction is safe even
/// when a limb of `b` exceeds the matching limb of `a`: the result limb simply
/// goes negative and is repaired by the next carry pass. Contrast the 51-bit
/// [`sub51`], whose limbs are unsigned and so must add a multiple of p first.
fn feSub(out: ptr, a: ptr, b: ptr): void {
    let i = 0;
    while (i < 10) { setl(out, i, getl(a, i) - getl(b, i)); i = i + 1; }
}
/// Copies all ten limbs of a reference-backend element: `out = a`.
fn feCopy(out: ptr, a: ptr): void {
    let i = 0;
    while (i < 10) { setl(out, i, getl(a, i)); i = i + 1; }
}

/// Reduces an 11-limb product accumulator back into ten in-range 25.5-bit limbs.
///
/// Shared tail of [`feMul`] and [`feMul121665`]. It walks the limbs propagating
/// the 26/25-bit carries, then folds the overflow out of the top limb (index 10)
/// back into limb 0 multiplied by 19, which is the reduction identity for
/// 2^255 = 19 (mod p). A final carry from limb 0 into limb 1 settles the result.
fn reduceCoeffs(t: ptr): void {
    setl(t, 10, 0);
    let i = 0;
    while (i < 10) {
        let over = getl(t, i) >> 26; setl(t, i, getl(t, i) - (over << 26)); setl(t, i + 1, getl(t, i + 1) + over);
        over = getl(t, i + 1) >> 25; setl(t, i + 1, getl(t, i + 1) - (over << 25)); setl(t, i + 2, getl(t, i + 2) + over);
        i = i + 2;
    }
    let o10 = getl(t, 10);
    setl(t, 0, getl(t, 0) + 19 * o10);
    setl(t, 10, 0);
    let over = getl(t, 0) >> 26; setl(t, 0, getl(t, 0) - (over << 26)); setl(t, 1, getl(t, 1) + over);
}

/// Field multiplication (reference backend): `out = f * g` in GF(2^255 - 19).
///
/// This is schoolbook multiplication of the ten limbs into a 19-coefficient
/// convolution, held in a temporary heap accumulator `t`. The factors of 2 on
/// certain cross terms account for the odd (25-bit) limb positions carrying an
/// implicit extra bit of weight in the 26/25 radix. Coefficients 10 through 18
/// (the part above 2^255) are folded down with the `19 *` reduction and merged
/// into the low ten, then [`reduceCoeffs`] normalises. Because every partial
/// product fits in 64 bits, this path needs no 128-bit multiply and therefore no
/// SIMD support, unlike [`mul51`]. `out` may alias `f` or `g`. The scratch block
/// `t` is freed before returning.
fn feMul(out: ptr, f: ptr, g: ptr): void {
    let a0 = getl(f, 0); let a1 = getl(f, 1); let a2 = getl(f, 2); let a3 = getl(f, 3); let a4 = getl(f, 4);
    let a5 = getl(f, 5); let a6 = getl(f, 6); let a7 = getl(f, 7); let a8 = getl(f, 8); let a9 = getl(f, 9);
    let b0 = getl(g, 0); let b1 = getl(g, 1); let b2 = getl(g, 2); let b3 = getl(g, 3); let b4 = getl(g, 4);
    let b5 = getl(g, 5); let b6 = getl(g, 6); let b7 = getl(g, 7); let b8 = getl(g, 8); let b9 = getl(g, 9);
    let t = bytes.alloc(19 * 8);
    setl(t, 0, a0 * b0);
    setl(t, 1, a0 * b1 + a1 * b0);
    setl(t, 2, 2 * a1 * b1 + a0 * b2 + a2 * b0);
    setl(t, 3, a1 * b2 + a2 * b1 + a0 * b3 + a3 * b0);
    setl(t, 4, a2 * b2 + 2 * (a1 * b3 + a3 * b1) + a0 * b4 + a4 * b0);
    setl(t, 5, a2 * b3 + a3 * b2 + a1 * b4 + a4 * b1 + a0 * b5 + a5 * b0);
    setl(t, 6, 2 * (a3 * b3 + a1 * b5 + a5 * b1) + a2 * b4 + a4 * b2 + a0 * b6 + a6 * b0);
    setl(t, 7, a3 * b4 + a4 * b3 + a2 * b5 + a5 * b2 + a1 * b6 + a6 * b1 + a0 * b7 + a7 * b0);
    setl(t, 8, a4 * b4 + 2 * (a3 * b5 + a5 * b3 + a1 * b7 + a7 * b1) + a2 * b6 + a6 * b2 + a0 * b8 + a8 * b0);
    setl(t, 9, a4 * b5 + a5 * b4 + a3 * b6 + a6 * b3 + a2 * b7 + a7 * b2 + a1 * b8 + a8 * b1 + a0 * b9 + a9 * b0);
    setl(t, 10, 2 * (a5 * b5 + a3 * b7 + a7 * b3 + a1 * b9 + a9 * b1) + a4 * b6 + a6 * b4 + a2 * b8 + a8 * b2);
    setl(t, 11, a5 * b6 + a6 * b5 + a4 * b7 + a7 * b4 + a3 * b8 + a8 * b3 + a2 * b9 + a9 * b2);
    setl(t, 12, a6 * b6 + 2 * (a5 * b7 + a7 * b5 + a3 * b9 + a9 * b3) + a4 * b8 + a8 * b4);
    setl(t, 13, a6 * b7 + a7 * b6 + a5 * b8 + a8 * b5 + a4 * b9 + a9 * b4);
    setl(t, 14, 2 * (a7 * b7 + a5 * b9 + a9 * b5) + a6 * b8 + a8 * b6);
    setl(t, 15, a7 * b8 + a8 * b7 + a6 * b9 + a9 * b6);
    setl(t, 16, a8 * b8 + 2 * (a7 * b9 + a9 * b7));
    setl(t, 17, a8 * b9 + a9 * b8);
    setl(t, 18, 2 * a9 * b9);
    let i = 0;
    while (i < 9) { setl(t, i, getl(t, i) + 19 * getl(t, i + 10)); i = i + 1; }
    reduceCoeffs(t);
    i = 0;
    while (i < 10) { setl(out, i, getl(t, i)); i = i + 1; }
    bytes.free(t);
}

/// Field squaring (reference backend): `out = a^2`.
///
/// Implemented as `feMul(out, a, a)`. A dedicated squaring routine would save a
/// few multiplies, but the reference backend favours simplicity since the
/// 51-bit path is the one that runs in production.
fn feSq(out: ptr, a: ptr): void { feMul(out, a, a); }

/// Multiplies a reference-backend element by the curve constant 121665.
///
/// 121665 is (A - 2) / 4 for A = 486662, the constant the Montgomery ladder
/// multiplies by once per bit (see the `feMul121665(t, ee)` step in
/// [`scalarMultRef`]). Multiplying by a small scalar is far cheaper than a full
/// [`feMul`]: each limb is scaled directly and [`reduceCoeffs`] cleans up. The
/// scratch block is freed before returning.
fn feMul121665(out: ptr, a: ptr): void {
    let t = bytes.alloc(11 * 8);
    let i = 0;
    while (i < 10) { setl(t, i, getl(a, i) * 121665); i = i + 1; }
    reduceCoeffs(t);
    i = 0;
    while (i < 10) { setl(out, i, getl(t, i)); i = i + 1; }
    bytes.free(t);
}

/// Constant-time conditional swap of two reference-backend elements.
///
/// If `swap` is 1 the limbs of `a` and `b` are exchanged; if 0 they are left
/// unchanged. Crucially it does this WITHOUT branching on `swap`: the value is
/// turned into an all-ones or all-zeros mask (`0 - swap`), and each limb pair is
/// swapped via `x = (a ^ b) & mask`. This is the heart of keeping the ladder
/// constant time, so the secret scalar bit driving the swap never influences
/// timing or memory access. `swap` must be exactly 0 or 1. Mirrors
/// [`cswap51`] for the 51-bit backend.
fn feCswap(a: ptr, b: ptr, swap: long): void {
    let mask = 0 - swap;
    let i = 0;
    while (i < 10) {
        let x = (getl(a, i) ^ getl(b, i)) & mask;
        setl(a, i, getl(a, i) ^ x);
        setl(b, i, getl(b, i) ^ x);
        i = i + 1;
    }
}

/// Field inversion (reference backend): `out = z^(-1)` in GF(2^255 - 19).
///
/// Uses Fermat's little theorem: the inverse is `z^(p-2)`, computed by the
/// standard fixed addition chain of squarings and multiplications (the same
/// chain ref10 uses). The ladder needs this once, at the end, to turn the
/// projective (X:Z) result into the affine u = X * Z^(-1). Because the exponent
/// p-2 is a compile-time constant, the chain is fixed and so is constant time.
/// The four scratch elements are freed before returning. Mirrors [`invert51`].
fn feInvert(out: ptr, z: ptr): void {
    let t0 = newFe(); let t1 = newFe(); let t2 = newFe(); let t3 = newFe();
    let i = 0;
    feSq(t0, z);
    feSq(t1, t0); feSq(t1, t1); feMul(t1, z, t1);
    feMul(t0, t0, t1);
    feSq(t2, t0); feMul(t1, t1, t2);
    feSq(t2, t1); i = 1; while (i < 5) { feSq(t2, t2); i = i + 1; } feMul(t1, t2, t1);
    feSq(t2, t1); i = 1; while (i < 10) { feSq(t2, t2); i = i + 1; } feMul(t2, t2, t1);
    feSq(t3, t2); i = 1; while (i < 20) { feSq(t3, t3); i = i + 1; } feMul(t2, t3, t2);
    feSq(t2, t2); i = 1; while (i < 10) { feSq(t2, t2); i = i + 1; } feMul(t1, t2, t1);
    feSq(t2, t1); i = 1; while (i < 50) { feSq(t2, t2); i = i + 1; } feMul(t2, t2, t1);
    feSq(t3, t2); i = 1; while (i < 100) { feSq(t3, t3); i = i + 1; } feMul(t2, t3, t2);
    feSq(t2, t2); i = 1; while (i < 50) { feSq(t2, t2); i = i + 1; } feMul(t1, t2, t1);
    feSq(t1, t1); i = 1; while (i < 5) { feSq(t1, t1); i = i + 1; } feMul(out, t1, t0);
    bytes.free(t0); bytes.free(t1); bytes.free(t2); bytes.free(t3);
}

/// Limb mask for the 51-bit backend: the low 51 bits set (2^51 - 1).
///
/// A limb of a 5-limb field element is reduced by ANDing with this; the bits
/// above 51 are the carry that flows into the next limb (or, from the top limb,
/// folds back into limb 0 times 19). Used throughout [`carry51`], [`mul51`], and
/// the pack/unpack helpers.
const M51: ulong = 0x7ffffffffffff;

/// Returns the high 64 bits of the 128-bit product `a * b`.
///
/// The 51-bit multiplier accumulates full 64x64 -> 128 products, and this is the
/// only way to reach the upper half. It delegates to the `simd.mulhi64`
/// intrinsic, which is why the fast backend depends on SIMD support being
/// present; the reference backend exists for platforms where it is not.
fn mulhi(a: ulong, b: ulong): ulong { return simd.mulhi64(a, b) as ulong; }

/// Allocates one field element for the 51-bit backend (five limbs, 40 bytes).
///
/// Limb `i` sits at byte offset `i * 8`. Contents are uninitialised; callers
/// that need zero must clear it. Release with `bytes.free`. The 51-bit analogue
/// of [`newFe`].
fn newFe51(): ptr { return bytes.alloc(40); }
/// Reads limb `i` (byte offset `i * 8`) of a 51-bit element as UNSIGNED 64-bit.
///
/// The 51-bit representation keeps limbs unsigned, unlike the signed limbs read
/// by [`getl`] in the reference backend.
fn g51(f: ptr, i: int): ulong { return bytes.read_ptr(f, i * 8) as ulong; }
/// Writes unsigned `v` into limb `i` (byte offset `i * 8`) of a 51-bit element.
fn s51(f: ptr, i: int, v: ulong): void { bytes.write_ptr(f, i * 8, v as ptr); }

/// Loads eight bytes at `off` as a little-endian unsigned 64-bit word.
///
/// Used by [`fromBytes51`] to read the 32-byte input as four 64-bit words before
/// re-slicing them into five 51-bit limbs.
fn load64le(s: ptr, off: int): ulong {
    let v: ulong = 0; let i = 0;
    while (i < 8) { v = v | ((bytes.read_byte(s, off + i) as ulong) << (i * 8)); i = i + 1; }
    return v;
}
/// Stores `v` as eight little-endian bytes at `off`.
///
/// Inverse of [`load64le`], used by [`toBytes51`] to repack the reduced limbs
/// into the 32-byte output.
fn store64le(s: ptr, off: int, v: ulong): void {
    let i = 0; while (i < 8) { bytes.write_byte(s, off + i, ((v >> (i * 8)) & 0xff) as int); i = i + 1; }
}

/// Unpacks a 32-byte little-endian field element into five 51-bit limbs.
///
/// Reads the input as four 64-bit words and re-slices them into five limbs of 51
/// bits each, masking with [`M51`]. Note it does NOT clear bit 255: the caller
/// ([`scalarMult51`]) has already forced the point's high bit to 0 as part of the
/// standard input handling. The 51-bit analogue of [`feFromBytes`].
fn fromBytes51(h: ptr, s: ptr): void {
    let t0 = load64le(s, 0); let t1 = load64le(s, 8); let t2 = load64le(s, 16); let t3 = load64le(s, 24);
    s51(h, 0, t0 & M51);
    s51(h, 1, ((t0 >> 51) | (t1 << 13)) & M51);
    s51(h, 2, ((t1 >> 38) | (t2 << 26)) & M51);
    s51(h, 3, ((t2 >> 25) | (t3 << 39)) & M51);
    s51(h, 4, (t3 >> 12) & M51);
}

/// One carry pass over a 51-bit element: fold each limb's overflow into the next.
///
/// Each limb is reduced to 51 bits with [`M51`] and its top bits are carried
/// forward; the carry out of the top limb (limb 4) wraps back into limb 0
/// multiplied by 19, using 2^255 = 19 (mod p). A single pass leaves limbs
/// slightly larger than 51 bits in the worst case, which the callers account
/// for. This is the workhorse normalisation used after every add, subtract, and
/// multiply in the fast backend.
fn carry51(h: ptr): void {
    let h0 = g51(h,0); let h1 = g51(h,1); let h2 = g51(h,2); let h3 = g51(h,3); let h4 = g51(h,4);
    let c0 = h0 >> 51; let c1 = h1 >> 51; let c2 = h2 >> 51; let c3 = h3 >> 51; let c4 = h4 >> 51;
    s51(h,0, (h0 & M51) + c4 * 19);
    s51(h,1, (h1 & M51) + c0);
    s51(h,2, (h2 & M51) + c1);
    s51(h,3, (h3 & M51) + c2);
    s51(h,4, (h4 & M51) + c3);
}

/// Field addition (51-bit backend): `out = a + b`, followed by one carry pass.
///
/// Unlike the reference [`feAdd`], this normalises immediately with [`carry51`],
/// because the unsigned 51-bit limbs would otherwise be free to overflow 64 bits
/// across a chain of operations. `out` may alias `a` or `b`.
fn add51(out: ptr, a: ptr, b: ptr): void {
    let i = 0; while (i < 5) { s51(out, i, g51(a, i) + g51(b, i)); i = i + 1; }
    carry51(out);
}

/// Field subtraction (51-bit backend): `out = a - b`, staying non-negative.
///
/// The limbs are UNSIGNED, so a plain `a - b` could underflow. Each limb of `a`
/// first has a multiple of p added to it (a value congruent to 0 mod p, chosen
/// large enough to dominate any limb of `b`) before subtracting, so every
/// intermediate stays non-negative and the result is still correct mod p. A
/// [`carry51`] pass then normalises. Contrast [`feSub`], which can rely on signed
/// limbs and needs no such bias.
fn sub51(out: ptr, a: ptr, b: ptr): void {
    s51(out, 0, (g51(a,0) + 0xFFFFFFFFFFFDA) - g51(b,0));
    s51(out, 1, (g51(a,1) + 0xFFFFFFFFFFFFE) - g51(b,1));
    s51(out, 2, (g51(a,2) + 0xFFFFFFFFFFFFE) - g51(b,2));
    s51(out, 3, (g51(a,3) + 0xFFFFFFFFFFFFE) - g51(b,3));
    s51(out, 4, (g51(a,4) + 0xFFFFFFFFFFFFE) - g51(b,4));
    carry51(out);
}

/// Field multiplication (51-bit backend): `out = a * b` in GF(2^255 - 19).
///
/// The fast, production multiply. It forms the five output limbs as sums of
/// 64x64 -> 128 partial products, tracking each accumulator as an explicit
/// (lo, hi) pair with manual carry detection (`if (nl < lo) 1 else 0` counts the
/// 128-bit overflow of the low word). The wrap-around terms above 2^255 are
/// pre-multiplied by 19 (the `b*_19` values), which applies the reduction inline
/// rather than in a separate fold. After the five accumulators are combined, each
/// 102-bit result is split into a 51-bit limb plus a carry `cc` (assembled from
/// the high word and the top bits of the low word), the carries are threaded into
/// the next limb (and the top one back into limb 0 times 19), and a final
/// [`carry51`] settles everything. This is where [`mulhi`] and therefore SIMD are
/// required. `out` may alias `a` or `b`.
fn mul51(out: ptr, a: ptr, b: ptr): void {
    let a0 = g51(a,0); let a1 = g51(a,1); let a2 = g51(a,2); let a3 = g51(a,3); let a4 = g51(a,4);
    let b0 = g51(b,0); let b1 = g51(b,1); let b2 = g51(b,2); let b3 = g51(b,3); let b4 = g51(b,4);
    let b1_19 = b1 * 19; let b2_19 = b2 * 19; let b3_19 = b3 * 19; let b4_19 = b4 * 19;

    let lo: ulong = a0*b0; let hi: ulong = mulhi(a0,b0);
    let pl: ulong = a1*b4_19; let ph: ulong = mulhi(a1,b4_19); let nl = lo+pl; hi = hi+ph+(if(nl<lo)(1 as ulong) else (0 as ulong)); lo = nl;
    pl = a2*b3_19; ph = mulhi(a2,b3_19); nl = lo+pl; hi = hi+ph+(if(nl<lo)(1 as ulong) else (0 as ulong)); lo = nl;
    pl = a3*b2_19; ph = mulhi(a3,b2_19); nl = lo+pl; hi = hi+ph+(if(nl<lo)(1 as ulong) else (0 as ulong)); lo = nl;
    pl = a4*b1_19; ph = mulhi(a4,b1_19); nl = lo+pl; hi = hi+ph+(if(nl<lo)(1 as ulong) else (0 as ulong)); lo = nl;
    let lo0 = lo; let hi0 = hi;

    lo = a0*b1; hi = mulhi(a0,b1);
    pl = a1*b0; ph = mulhi(a1,b0); nl = lo+pl; hi = hi+ph+(if(nl<lo)(1 as ulong) else (0 as ulong)); lo = nl;
    pl = a2*b4_19; ph = mulhi(a2,b4_19); nl = lo+pl; hi = hi+ph+(if(nl<lo)(1 as ulong) else (0 as ulong)); lo = nl;
    pl = a3*b3_19; ph = mulhi(a3,b3_19); nl = lo+pl; hi = hi+ph+(if(nl<lo)(1 as ulong) else (0 as ulong)); lo = nl;
    pl = a4*b2_19; ph = mulhi(a4,b2_19); nl = lo+pl; hi = hi+ph+(if(nl<lo)(1 as ulong) else (0 as ulong)); lo = nl;
    let lo1 = lo; let hi1 = hi;

    lo = a0*b2; hi = mulhi(a0,b2);
    pl = a1*b1; ph = mulhi(a1,b1); nl = lo+pl; hi = hi+ph+(if(nl<lo)(1 as ulong) else (0 as ulong)); lo = nl;
    pl = a2*b0; ph = mulhi(a2,b0); nl = lo+pl; hi = hi+ph+(if(nl<lo)(1 as ulong) else (0 as ulong)); lo = nl;
    pl = a3*b4_19; ph = mulhi(a3,b4_19); nl = lo+pl; hi = hi+ph+(if(nl<lo)(1 as ulong) else (0 as ulong)); lo = nl;
    pl = a4*b3_19; ph = mulhi(a4,b3_19); nl = lo+pl; hi = hi+ph+(if(nl<lo)(1 as ulong) else (0 as ulong)); lo = nl;
    let lo2 = lo; let hi2 = hi;

    lo = a0*b3; hi = mulhi(a0,b3);
    pl = a1*b2; ph = mulhi(a1,b2); nl = lo+pl; hi = hi+ph+(if(nl<lo)(1 as ulong) else (0 as ulong)); lo = nl;
    pl = a2*b1; ph = mulhi(a2,b1); nl = lo+pl; hi = hi+ph+(if(nl<lo)(1 as ulong) else (0 as ulong)); lo = nl;
    pl = a3*b0; ph = mulhi(a3,b0); nl = lo+pl; hi = hi+ph+(if(nl<lo)(1 as ulong) else (0 as ulong)); lo = nl;
    pl = a4*b4_19; ph = mulhi(a4,b4_19); nl = lo+pl; hi = hi+ph+(if(nl<lo)(1 as ulong) else (0 as ulong)); lo = nl;
    let lo3 = lo; let hi3 = hi;

    lo = a0*b4; hi = mulhi(a0,b4);
    pl = a1*b3; ph = mulhi(a1,b3); nl = lo+pl; hi = hi+ph+(if(nl<lo)(1 as ulong) else (0 as ulong)); lo = nl;
    pl = a2*b2; ph = mulhi(a2,b2); nl = lo+pl; hi = hi+ph+(if(nl<lo)(1 as ulong) else (0 as ulong)); lo = nl;
    pl = a3*b1; ph = mulhi(a3,b1); nl = lo+pl; hi = hi+ph+(if(nl<lo)(1 as ulong) else (0 as ulong)); lo = nl;
    pl = a4*b0; ph = mulhi(a4,b0); nl = lo+pl; hi = hi+ph+(if(nl<lo)(1 as ulong) else (0 as ulong)); lo = nl;
    let lo4 = lo; let hi4 = hi;

    let cc0 = (hi0 << 13) | (lo0 >> 51);
    let cc1 = (hi1 << 13) | (lo1 >> 51);
    let cc2 = (hi2 << 13) | (lo2 >> 51);
    let cc3 = (hi3 << 13) | (lo3 >> 51);
    let cc4 = (hi4 << 13) | (lo4 >> 51);
    s51(out, 0, (lo0 & M51) + cc4 * 19);
    s51(out, 1, (lo1 & M51) + cc0);
    s51(out, 2, (lo2 & M51) + cc1);
    s51(out, 3, (lo3 & M51) + cc2);
    s51(out, 4, (lo4 & M51) + cc3);
    carry51(out);
}

/// Field squaring (51-bit backend): `out = a^2`, via `mul51(out, a, a)`.
fn sq51(out: ptr, a: ptr): void { mul51(out, a, a); }

/// Multiplies a 51-bit element by the curve constant 121665.
///
/// The 51-bit counterpart of [`feMul121665`], scaling each limb by the small
/// constant as a 64x64 -> 128 product and reducing with the same carry-and-fold
/// scheme as [`mul51`]. 121665 = (486662 - 2) / 4 is the ladder's per-bit curve
/// constant; see the `mul121665_51(t, ee)` step in [`scalarMult51`].
fn mul121665_51(out: ptr, a: ptr): void {
    let c: ulong = 121665;
    let lo0 = g51(a,0)*c; let hi0 = mulhi(g51(a,0),c);
    let lo1 = g51(a,1)*c; let hi1 = mulhi(g51(a,1),c);
    let lo2 = g51(a,2)*c; let hi2 = mulhi(g51(a,2),c);
    let lo3 = g51(a,3)*c; let hi3 = mulhi(g51(a,3),c);
    let lo4 = g51(a,4)*c; let hi4 = mulhi(g51(a,4),c);
    let cc0 = (hi0 << 13) | (lo0 >> 51);
    let cc1 = (hi1 << 13) | (lo1 >> 51);
    let cc2 = (hi2 << 13) | (lo2 >> 51);
    let cc3 = (hi3 << 13) | (lo3 >> 51);
    let cc4 = (hi4 << 13) | (lo4 >> 51);
    s51(out, 0, (lo0 & M51) + cc4 * 19);
    s51(out, 1, (lo1 & M51) + cc0);
    s51(out, 2, (lo2 & M51) + cc1);
    s51(out, 3, (lo3 & M51) + cc2);
    s51(out, 4, (lo4 & M51) + cc3);
    carry51(out);
}

/// Constant-time conditional swap of two 51-bit elements (five limbs).
///
/// The 51-bit analogue of [`feCswap`]: `swap` (0 or 1) becomes an all-ones or
/// all-zeros mask and each limb pair is exchanged with `x = (a ^ b) & mask`, so
/// no branch depends on the secret scalar bit. Keeps the ladder in
/// [`scalarMult51`] constant time.
fn cswap51(a: ptr, b: ptr, swap: long): void {
    let mask: ulong = (0 - swap) as ulong;
    let i = 0;
    while (i < 5) {
        let x = (g51(a,i) ^ g51(b,i)) & mask;
        s51(a, i, g51(a,i) ^ x);
        s51(b, i, g51(b,i) ^ x);
        i = i + 1;
    }
}

/// Copies all five limbs of a 51-bit element: `out = a`. Analogue of [`feCopy`].
fn copy51(out: ptr, a: ptr): void { let i = 0; while (i < 5) { s51(out, i, g51(a,i)); i = i + 1; } }

/// Field inversion (51-bit backend): `out = z^(-1)` via `z^(p-2)`.
///
/// Same fixed Fermat addition chain as [`feInvert`] but over the 51-bit
/// operations, used once at the end of [`scalarMult51`] to convert the projective
/// result to affine. The exponent is a constant, so the chain is constant time.
/// The four scratch elements are freed before returning.
fn invert51(out: ptr, z: ptr): void {
    let t0 = newFe51(); let t1 = newFe51(); let t2 = newFe51(); let t3 = newFe51();
    let i = 0;
    sq51(t0, z);
    sq51(t1, t0); sq51(t1, t1); mul51(t1, z, t1);
    mul51(t0, t0, t1);
    sq51(t2, t0); mul51(t1, t1, t2);
    sq51(t2, t1); i = 1; while (i < 5) { sq51(t2, t2); i = i + 1; } mul51(t1, t2, t1);
    sq51(t2, t1); i = 1; while (i < 10) { sq51(t2, t2); i = i + 1; } mul51(t2, t2, t1);
    sq51(t3, t2); i = 1; while (i < 20) { sq51(t3, t3); i = i + 1; } mul51(t2, t3, t2);
    sq51(t2, t2); i = 1; while (i < 10) { sq51(t2, t2); i = i + 1; } mul51(t1, t2, t1);
    sq51(t2, t1); i = 1; while (i < 50) { sq51(t2, t2); i = i + 1; } mul51(t2, t2, t1);
    sq51(t3, t2); i = 1; while (i < 100) { sq51(t3, t3); i = i + 1; } mul51(t2, t3, t2);
    sq51(t2, t2); i = 1; while (i < 50) { sq51(t2, t2); i = i + 1; } mul51(t1, t2, t1);
    sq51(t1, t1); i = 1; while (i < 5) { sq51(t1, t1); i = i + 1; } mul51(out, t1, t0);
    bytes.free(t0); bytes.free(t1); bytes.free(t2); bytes.free(t3);
}

/// Serialises a 51-bit element to 32 canonical little-endian bytes.
///
/// The 51-bit analogue of [`feToBytes`]. It runs two carry passes to bring the
/// limbs fully in range, then does the final conditional subtraction of p: it
/// computes the borrow that `+ 19` would generate to detect a value in
/// [p, 2^255), adds `19 * c` to complete the reduction, threads one more carry
/// chain, and repacks the five 51-bit limbs into four 64-bit words. The output is
/// the unique canonical encoding, so equal field elements serialise identically.
fn toBytes51(s: ptr, h: ptr): void {
    carry51(h); carry51(h);
    let h0 = g51(h,0); let h1 = g51(h,1); let h2 = g51(h,2); let h3 = g51(h,3); let h4 = g51(h,4);
    let c = (h0 + 19) >> 51;
    c = (h1 + c) >> 51;
    c = (h2 + c) >> 51;
    c = (h3 + c) >> 51;
    c = (h4 + c) >> 51;
    h0 = h0 + 19 * c;
    h1 = h1 + (h0 >> 51); h0 = h0 & M51;
    h2 = h2 + (h1 >> 51); h1 = h1 & M51;
    h3 = h3 + (h2 >> 51); h2 = h2 & M51;
    h4 = h4 + (h3 >> 51); h3 = h3 & M51;
    h4 = h4 & M51;
    store64le(s, 0,  h0 | (h1 << 51));
    store64le(s, 8,  (h1 >> 13) | (h2 << 38));
    store64le(s, 16, (h2 >> 26) | (h3 << 25));
    store64le(s, 24, (h3 >> 39) | (h4 << 12));
}

/// The Montgomery ladder over the 51-bit backend: the fast scalar multiply.
///
/// Computes the X25519 core: `out = (scalar * point).u`. It first clamps a
/// private copy `e` of the scalar per RFC 7748 (clear the low 3 bits of byte 0,
/// clear the top bit and set bit 254 of byte 31), which forces the scalar into
/// the correct subgroup and fixes its bit length. It then runs the standard
/// Montgomery ladder from bit 254 down to bit 0 over the projective pair
/// (x2:z2), (x3:z3), using [`cswap51`] so each step's conditional swap is driven
/// by the secret bit without a branch. The running `swap` is the XOR trick that
/// lets a single conditional swap per iteration track the difference between the
/// current and previous bit. After the loop it inverts z2 with [`invert51`],
/// multiplies to get the affine u, and serialises with [`toBytes51`]. Every
/// scratch field element is allocated up front and freed before returning; `out`
/// must be a 32-byte buffer that does not alias `scalar` or `point`.
fn scalarMult51(out: ptr, scalar: ptr, point: ptr): void {
    let e = bytes.alloc(32);
    let i = 0;
    while (i < 32) { bytes.write_byte(e, i, bytes.read_byte(scalar, i)); i = i + 1; }
    bytes.write_byte(e, 0, bytes.read_byte(e, 0) & 248);
    bytes.write_byte(e, 31, (bytes.read_byte(e, 31) & 127) | 64);

    let x1 = newFe51(); fromBytes51(x1, point);
    let x2 = newFe51(); let z2 = newFe51(); let x3 = newFe51(); let z3 = newFe51();
    i = 0; while (i < 5) { s51(x2, i, 0); s51(z2, i, 0); s51(z3, i, 0); i = i + 1; }
    s51(x2, 0, 1); s51(z3, 0, 1); copy51(x3, x1);

    let a = newFe51(); let aa = newFe51(); let b = newFe51(); let bb = newFe51(); let ee = newFe51();
    let c = newFe51(); let d = newFe51(); let da = newFe51(); let cb = newFe51(); let t = newFe51();

    let swap: long = 0;
    let pos = 254;
    while (pos >= 0) {
        let kt = (bytes.read_byte(e, pos >> 3) >> (pos & 7)) & 1;
        swap = swap ^ (kt as long);
        cswap51(x2, x3, swap);
        cswap51(z2, z3, swap);
        swap = kt as long;

        add51(a, x2, z2); sq51(aa, a);
        sub51(b, x2, z2); sq51(bb, b);
        sub51(ee, aa, bb);
        add51(c, x3, z3); sub51(d, x3, z3);
        mul51(da, d, a); mul51(cb, c, b);
        add51(t, da, cb); sq51(x3, t);
        sub51(t, da, cb); sq51(t, t); mul51(z3, x1, t);
        mul51(x2, aa, bb);
        mul121665_51(t, ee); add51(t, aa, t); mul51(z2, ee, t);
        pos = pos - 1;
    }
    cswap51(x2, x3, swap);
    cswap51(z2, z3, swap);

    invert51(z2, z2);
    mul51(x2, x2, z2);
    toBytes51(out, x2);

    bytes.free(e); bytes.free(x1); bytes.free(x2); bytes.free(z2); bytes.free(x3); bytes.free(z3);
    bytes.free(a); bytes.free(aa); bytes.free(b); bytes.free(bb); bytes.free(ee);
    bytes.free(c); bytes.free(d); bytes.free(da); bytes.free(cb); bytes.free(t);
}

/// X25519 scalar multiplication: `out = (scalar * point).u`, the public entry point.
///
/// This is the one function callers use. Given a 32-byte `scalar` and a 32-byte
/// Montgomery u-coordinate `point`, it writes the 32-byte result u-coordinate to
/// `out`. Passing the base point (u = 9) as `point` derives a public key from a
/// private scalar; passing a peer's public u derives the shared secret. It
/// delegates to the fast [`scalarMult51`] backend. The scalar is clamped
/// internally, so the caller need not pre-clamp it. `out` must be a writable
/// 32-byte buffer distinct from `scalar` and `point`.
pub fn scalarMult(out: ptr, scalar: ptr, point: ptr): void {
    scalarMult51(out, scalar, point);
}

/// X25519 scalar multiplication using the portable 25.5-bit reference backend.
///
/// Semantically identical to [`scalarMult`], but runs the [`feMul`]-based
/// reference field arithmetic that needs no SIMD high-multiply. It exists chiefly
/// as a cross-check: for any inputs it must produce byte-for-byte the same `out`
/// as the fast path, which is how the 51-bit backend is validated. It follows the
/// same shape as [`scalarMult51`]: clamp `e`, run the ladder from bit 254 to 0
/// with [`feCswap`], invert, convert to affine, and serialise with [`feToBytes`].
/// All scratch elements are freed before returning; `out` must be a 32-byte
/// buffer not aliasing `scalar` or `point`.
pub fn scalarMultRef(out: ptr, scalar: ptr, point: ptr): void {
    let e = bytes.alloc(32);
    let i = 0;
    while (i < 32) { bytes.write_byte(e, i, bytes.read_byte(scalar, i)); i = i + 1; }
    bytes.write_byte(e, 0, bytes.read_byte(e, 0) & 248);
    bytes.write_byte(e, 31, (bytes.read_byte(e, 31) & 127) | 64);

    let x1 = newFe(); feFromBytes(x1, point);
    let x2 = newFe(); let z2 = newFe(); let x3 = newFe(); let z3 = newFe();
    i = 0; while (i < 10) { setl(x2, i, 0); setl(z2, i, 0); setl(z3, i, 0); i = i + 1; }
    setl(x2, 0, 1); setl(z3, 0, 1); feCopy(x3, x1);

    let a = newFe(); let aa = newFe(); let b = newFe(); let bb = newFe(); let ee = newFe();
    let c = newFe(); let d = newFe(); let da = newFe(); let cb = newFe(); let t = newFe();

    let swap: long = 0;
    let pos = 254;
    while (pos >= 0) {
        let kt = (bytes.read_byte(e, pos >> 3) >> (pos & 7)) & 1;
        swap = swap ^ (kt as long);
        feCswap(x2, x3, swap);
        feCswap(z2, z3, swap);
        swap = kt as long;

        feAdd(a, x2, z2); feSq(aa, a);
        feSub(b, x2, z2); feSq(bb, b);
        feSub(ee, aa, bb);
        feAdd(c, x3, z3); feSub(d, x3, z3);
        feMul(da, d, a); feMul(cb, c, b);
        feAdd(t, da, cb); feSq(x3, t);
        feSub(t, da, cb); feSq(t, t); feMul(z3, x1, t);
        feMul(x2, aa, bb);
        feMul121665(t, ee); feAdd(t, aa, t); feMul(z2, ee, t);
        pos = pos - 1;
    }
    feCswap(x2, x3, swap);
    feCswap(z2, z3, swap);

    feInvert(z2, z2);
    feMul(x2, x2, z2);
    feToBytes(out, x2);

    bytes.free(e); bytes.free(x1); bytes.free(x2); bytes.free(z2); bytes.free(x3); bytes.free(z3);
    bytes.free(a); bytes.free(aa); bytes.free(b); bytes.free(bb); bytes.free(ee);
    bytes.free(c); bytes.free(d); bytes.free(da); bytes.free(cb); bytes.free(t);
}
