//! NIST P-256 (secp256r1) elliptic-curve primitives: ECDH, ECDSA sign, and
//! ECDSA verify, implemented from scratch in pure Nova.
//!
//! This is the curve half of Nova's self-hosted crypto stack. The runtime no
//! longer links wolfSSL, so every big-integer and curve operation the TLS layer
//! and application code needs has to live here. There is no libgmp, no bignum
//! type, and no arbitrary-precision arithmetic in the language. Everything is
//! built out of raw byte buffers (`ptr`) and 32-bit limbs, which is why the file
//! reads like C rather than like the rest of the standard library.
//!
//! Representation. A P-256 field element (a residue mod the prime `p`) is stored
//! as EIGHT 32-bit limbs, least-significant first, but each limb sits in its OWN
//! 64-bit slot. So a field element is a 64-byte buffer, and limb `i` lives at
//! byte offset `i * 8`. Widening every 32-bit limb to a 64-bit slot is
//! deliberate: a 32x32 limb product, or a limb sum, can carry into the high 32
//! bits WITHOUT overflowing the 64-bit machine word, so carries can be extracted
//! with a plain shift and mask instead of detecting overflow. See [`getw`] and
//! [`setw`] for the accessors and [`newFe`] for the allocation.
//!
//! Montgomery form. Field multiplication uses Montgomery reduction rather than a
//! schoolbook mod, because a full division by `p` per multiply would be far
//! slower. Values that go through [`feMul`] are held in Montgomery form (that is,
//! multiplied by `R = 2^256 mod p`), converted in with [`toMont`] and out with
//! [`fromMont`]. A neat consequence of P-256's prime is that `-p^-1 mod 2^32`
//! works out to 1, so the Montgomery reduction multiplier collapses to the low
//! limb itself; that is the unexplained `m = getw(t, 0)` inside [`feMul`]. The
//! scalar field (arithmetic mod the group order `n`) needs its own reduction
//! because `n` has no such nicety, so it carries the real constant [`N0INV`] and
//! a parallel set of `n`-suffixed routines ([`nMul`], [`nAdd`], and friends).
//!
//! Points. Curve points are held in JACOBIAN projective coordinates `(X, Y, Z)`,
//! where the affine point is `(X/Z^2, Y/Z^3)`. Projective coordinates avoid a
//! modular inversion on every point addition; a single inversion is paid at the
//! end in [`toAffine`]. A point is a 192-byte buffer: three field elements laid
//! out X, then Y, then Z, addressed by [`px`], [`py`], and [`pz`]. The point at
//! infinity is represented as `Z = 0`.
//!
//! Constant-time discipline. Secret-dependent branches leak timing, so the hot
//! paths avoid them. Conditional subtraction of the modulus ([`condSubP`],
//! [`nCondSub`]) and conditional point selection ([`ptCcopy`]) are done with
//! arithmetic masks (`0 - flag` gives all-ones or all-zeros), never with `if`.
//! The scalar ladder in [`scalarMultPoint`] processes two bits at a time and
//! always performs the same doublings and a masked add, so its shape does not
//! depend on the secret scalar's bits. Both inversions ([`feInvert`],
//! [`invModN`]) use a fixed Fermat exponentiation, `a^(p-2)` and `a^(n-2)`, again
//! to keep the control flow independent of the value being inverted.
//!
//! Memory model. Every buffer here is an explicit `bytes.alloc` that MUST be
//! matched by a `bytes.free`; these are raw allocations outside ARC, so a missed
//! free leaks and a double free corrupts. The functions follow a strict
//! allocate-at-top, free-at-bottom convention, and the early-return error paths
//! free what they have allocated so far before returning.
//!
//! Public surface. Only four functions are exported: [`derivePublic`] (private
//! scalar to uncompressed public key), [`ecdh`] (X25519-style shared secret, but
//! over P-256), [`ecdsaSign`] (RFC 6979 deterministic signing), and
//! [`ecdsaVerify`]. Everything else is an internal building block. The signing
//! path pulls its deterministic nonce from HMAC-SHA-256 via `crypto.mac.hmac`,
//! so this file has no dependence on a system random source.

import bytes;
import crypto.mac.hmac;

/// Bit mask that keeps only the low 32 bits of a 64-bit slot.
///
/// Applied after every limb operation to strip the carry out of the working
/// slot, leaving a canonical 32-bit limb behind. The carry itself is recovered
/// separately with a `>> 32`.
const MASK32: ulong = 0xffffffff;
/// The constant zero as a `ulong`, named so the limb code reads uniformly.
const U0: ulong = 0;
/// The constant one as a `ulong`, used for set-low-limb and single-bit masks.
const U1: ulong = 1;


/// Allocates a fresh 64-byte field element (eight 64-bit limb slots).
///
/// The contents are uninitialised, so callers zero or fill it before reading.
/// The returned buffer must eventually be released with `bytes.free`.
fn newFe(): ptr { return bytes.alloc(64); }
/// Reads limb `i` of a field element as a `ulong` (limb `i` is at byte `i * 8`).
///
/// The value is a machine pointer-sized word on disk, so it round-trips through
/// `long` before being reinterpreted as the unsigned limb value.
fn getw(f: ptr, i: int): ulong { return (bytes.read_ptr(f, i * 8) as long) as ulong; }
/// Writes `v` into limb `i` of a field element (limb `i` is at byte `i * 8`).
///
/// The stored slot is 64 bits wide, so a caller may deposit an un-normalised
/// value carrying into the high half; downstream code masks it with [`MASK32`].
fn setw(f: ptr, i: int, v: ulong): void { bytes.write_ptr(f, i * 8, (v as long) as ptr); }

/// Returns limb `i` of the P-256 field prime `p`, least-significant limb first.
///
/// The prime is
/// `p = ffffffff00000001000000000000000000000000ffffffffffffffffffffffff`, whose
/// limbs are mostly `0xffffffff` with three zero limbs (3, 4, 5) and a single
/// `1` limb (6). Encoding `p` as a function of the limb index keeps it in code
/// rather than a table and lets the reduction routines index it directly.
fn pl(i: int): ulong {
    if (i == 3) { return U0; }
    if (i == 4) { return U0; }
    if (i == 5) { return U0; }
    if (i == 6) { return U1; }
    return MASK32;
}

/// Copies all eight limbs of field element `a` into `out`.
fn feCopy(out: ptr, a: ptr): void {
    let i = 0;
    while (i < 8) { setw(out, i, getw(a, i)); i = i + 1; }
}
/// Sets every limb of field element `out` to zero.
fn feZero(out: ptr): void {
    let i = 0;
    while (i < 8) { setw(out, i, U0); i = i + 1; }
}

/// Constant-time conditional subtract of the prime `p` from a nine-limb value.
///
/// `t` is a value in `[0, 2p)` held across nine limbs (limb 8 is the top carry
/// out of an add). This computes `t - p` across the low eight limbs, tracks the
/// final borrow including limb 8, and writes `t - p` into `out` when the result
/// did not go negative, otherwise writes `t` unchanged. The choice is made with
/// an arithmetic `mask` rather than a branch, so the timing does not reveal
/// whether the reduction fired. Paired with [`feAdd`] and [`feMul`], which
/// produce exactly such a nine-limb intermediate.
fn condSubP(out: ptr, t: ptr): void {
    let d = bytes.alloc(64);
    let borrow: ulong = 0;
    let j = 0;
    while (j < 8) {
        let x = getw(t, j) - pl(j) - borrow;
        setw(d, j, x & MASK32);
        borrow = (x >> 32) & U1;
        j = j + 1;
    }
    let x8 = getw(t, 8) - borrow;
    borrow = (x8 >> 32) & U1;
    let mask = U0 - (borrow ^ U1);
    j = 0;
    while (j < 8) {
        setw(out, j, (getw(d, j) & mask) | (getw(t, j) & (~mask)));
        j = j + 1;
    }
    bytes.free(d);
}

/// Modular addition on the field: `out = (a + b) mod p`.
///
/// Adds limb by limb into a nine-limb temporary (the ninth limb absorbs the
/// final carry), then reduces once with [`condSubP`]. Correct because two
/// canonical field elements sum to less than `2p`, so a single conditional
/// subtraction suffices.
fn feAdd(out: ptr, a: ptr, b: ptr): void {
    let t = bytes.alloc(72);
    let carry: ulong = 0;
    let j = 0;
    while (j < 8) {
        let s = getw(a, j) + getw(b, j) + carry;
        setw(t, j, s & MASK32);
        carry = s >> 32;
        j = j + 1;
    }
    setw(t, 8, carry);
    condSubP(out, t);
    bytes.free(t);
}

/// Modular subtraction on the field: `out = (a - b) mod p`.
///
/// Subtracts limb by limb, and if the result went negative (final `borrow` set)
/// adds `p` back, again gated by an arithmetic `mask` so the add is
/// unconditional in shape. The `pl(j) & mask` term is either the prime's limb or
/// zero depending on the borrow.
fn feSub(out: ptr, a: ptr, b: ptr): void {
    let d = bytes.alloc(64);
    let borrow: ulong = 0;
    let j = 0;
    while (j < 8) {
        let x = getw(a, j) - getw(b, j) - borrow;
        setw(d, j, x & MASK32);
        borrow = (x >> 32) & U1;
        j = j + 1;
    }
    let mask = U0 - borrow;
    let carry: ulong = 0;
    j = 0;
    while (j < 8) {
        let s = getw(d, j) + (pl(j) & mask) + carry;
        setw(out, j, s & MASK32);
        carry = s >> 32;
        j = j + 1;
    }
    bytes.free(d);
}

/// Montgomery modular multiplication on the field: `out = a * b * R^-1 mod p`.
///
/// This is the interleaved CIOS (Coarsely Integrated Operand Scanning)
/// Montgomery multiply: for each limb of `b` it accumulates a partial product
/// into a ten-limb temporary, then folds one Montgomery reduction step. The
/// reduction multiplier `m` would normally be `t0 * (-p^-1 mod 2^32)`, but for
/// P-256's prime that inverse is 1, so `m` is just the low limb `getw(t, 0)`. A
/// final [`condSubP`] brings the result back below `p`.
///
/// Because it carries the `R^-1` factor, this is correct only for operands in
/// Montgomery form (see [`toMont`]); multiplying two Montgomery values yields a
/// Montgomery value, which is why the whole point pipeline stays in that domain
/// until [`toAffine`] converts out.
fn feMul(out: ptr, a: ptr, b: ptr): void {
    let t = bytes.alloc(80);
    let j = 0;
    while (j < 10) { setw(t, j, U0); j = j + 1; }
    let i = 0;
    while (i < 8) {
        let bi = getw(b, i);
        let carry: ulong = 0;
        j = 0;
        while (j < 8) {
            let s = getw(t, j) + getw(a, j) * bi + carry;
            setw(t, j, s & MASK32);
            carry = s >> 32;
            j = j + 1;
        }
        let s8 = getw(t, 8) + carry;
        setw(t, 8, s8 & MASK32);
        setw(t, 9, s8 >> 32);
        let m = getw(t, 0);
        let c2 = (getw(t, 0) + m * pl(0)) >> 32;
        j = 1;
        while (j < 8) {
            let s = getw(t, j) + m * pl(j) + c2;
            setw(t, j - 1, s & MASK32);
            c2 = s >> 32;
            j = j + 1;
        }
        let s7 = getw(t, 8) + c2;
        setw(t, 7, s7 & MASK32);
        setw(t, 8, getw(t, 9) + (s7 >> 32));
        i = i + 1;
    }
    condSubP(out, t);
    bytes.free(t);
}

/// Montgomery modular squaring: `out = a^2 * R^-1 mod p`, i.e. [`feMul`] of `a`
/// with itself.
fn feSq(out: ptr, a: ptr): void { feMul(out, a, a); }

/// Converts a plain field element into Montgomery form: `out = a * R mod p`.
///
/// Rather than multiply by the precomputed constant `R = 2^256 mod p`, it
/// doubles `a` modulo `p` two hundred and fifty-six times, since `2^256 * a` is
/// exactly `R * a`. Slower than a single multiply but avoids storing `R` and
/// reuses the already-reduced [`feAdd`].
fn toMont(out: ptr, a: ptr): void {
    feCopy(out, a);
    let i = 0;
    while (i < 256) { feAdd(out, out, out); i = i + 1; }
}

/// Converts a Montgomery-form element back to a plain residue: `out = x * R^-1
/// mod p`.
///
/// Achieved by a Montgomery multiply against the plain integer 1, which strips
/// exactly one factor of `R`.
fn fromMont(out: ptr, x: ptr): void {
    let one = newFe();
    feZero(one); setw(one, 0, U1);
    feMul(out, x, one);
    bytes.free(one);
}

/// Writes the Montgomery-form representation of the value 1 (that is, `R mod p`)
/// into `out`.
///
/// Used to seed the accumulator of the Fermat exponentiation in [`feInvert`],
/// where the running product must start at the Montgomery identity.
fn montOne(out: ptr): void {
    let one = newFe();
    feZero(one); setw(one, 0, U1);
    toMont(out, one);
    bytes.free(one);
}

/// Constant-time field equality: true when `a` and `b` are equal limb for limb.
///
/// ORs together the XOR of every limb pair and checks the accumulator against
/// zero, so it always inspects all eight limbs and does not short-circuit on the
/// first difference. Assumes both inputs are already reduced below `p`, since it
/// compares representations, not residues.
fn feEq(a: ptr, b: ptr): bool {
    let diff: ulong = 0;
    let j = 0;
    while (j < 8) { diff = diff | (getw(a, j) ^ getw(b, j)); j = j + 1; }
    return diff == U0;
}

/// Returns true when the field element `a` is strictly less than the prime `p`.
///
/// Performs a trial subtraction `a - p` and reports whether it borrowed: a borrow
/// out of the top limb means `a < p`. Used to validate that an externally
/// supplied coordinate is a canonical field element before it is trusted (see
/// [`ecdh`] and [`decodePointToJac`]).
fn feLtP(a: ptr): bool {
    let borrow: ulong = 0;
    let j = 0;
    while (j < 8) {
        let x = getw(a, j) - pl(j) - borrow;
        borrow = (x >> 32) & U1;
        j = j + 1;
    }
    return borrow == U1;
}

/// Modular inverse in the field: `out = a^-1 mod p`, computed by Fermat's little
/// theorem as `a^(p-2) mod p`.
///
/// `a` and `out` are in Montgomery form. The exponent `p - 2` is spelled out as a
/// 32-byte big-endian constant, and the routine runs a fixed 256-iteration
/// square-and-multiply from the top bit down. The iteration count is constant and
/// the multiply is data-independent in shape, so timing does not leak `a`. Only
/// defined for a non-zero `a`; the callers guarantee that.
fn feInvert(out: ptr, a: ptr): void {
    let r = newFe();
    montOne(r);
    let e = bytes.alloc(32);
    setHex(e, "ffffffff00000001000000000000000000000000fffffffffffffffffffffffd");
    let k = 255;
    while (k >= 0) {
        feSq(r, r);
        let bitVal = (bytes.read_byte(e, 31 - (k >> 3)) >> (k & 7)) & 1;
        if (bitVal == 1) { feMul(r, r, a); }
        k = k - 1;
    }
    feCopy(out, r);
    bytes.free(r);
    bytes.free(e);
}


/// Decodes a 32-byte big-endian integer at `buf + off` into field-element limbs.
///
/// Wire and key material carry field values as big-endian bytes; internally the
/// limbs are little-endian, so limb `i` is assembled from the four bytes at the
/// mirrored offset `off + (7 - i) * 4`. The result is a plain residue, not yet in
/// Montgomery form. Inverse of [`feToBE`].
fn feFromBE(out: ptr, buf: ptr, off: int): void {
    let i = 0;
    while (i < 8) {
        let base = off + (7 - i) * 4;
        let w = ((bytes.read_byte(buf, base) as ulong) << 24)
              | ((bytes.read_byte(buf, base + 1) as ulong) << 16)
              | ((bytes.read_byte(buf, base + 2) as ulong) << 8)
              | (bytes.read_byte(buf, base + 3) as ulong);
        setw(out, i, w);
        i = i + 1;
    }
}

/// Encodes field element `a` as a 32-byte big-endian integer into `buf + off`.
///
/// The inverse of [`feFromBE`]: limb `i` is emitted most-significant byte first
/// at the mirrored offset. Used to serialise coordinates and signature scalars
/// back to the fixed 32-byte wire form.
fn feToBE(buf: ptr, off: int, a: ptr): void {
    let i = 0;
    while (i < 8) {
        let base = off + (7 - i) * 4;
        let w = getw(a, i);
        bytes.write_byte(buf, base, ((w >> 24) & 0xff) as int);
        bytes.write_byte(buf, base + 1, ((w >> 16) & 0xff) as int);
        bytes.write_byte(buf, base + 2, ((w >> 8) & 0xff) as int);
        bytes.write_byte(buf, base + 3, (w & 0xff) as int);
        i = i + 1;
    }
}

/// Maps one ASCII hex digit (as a codepoint) to its 0..15 numeric value.
///
/// Handles digits `0-9` (codepoints 48..57) and lowercase `a-f` (97..102, offset
/// 87); the final `c - 55` fall-through covers uppercase `A-F`. Inputs are the
/// trusted constant hex strings in this file, so there is no validation of
/// out-of-range characters.
fn nib(c: int): int {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    return c - 55;
}
/// Decodes the hex string `hex` into the raw byte buffer `buf`, two chars per
/// byte.
///
/// Used to load the curve constants (the prime, the order, the generator, the
/// coefficient `b`, and the Fermat exponents) from their canonical hex spellings.
/// It writes `hex.length / 2` bytes and does no length check against `buf`; the
/// call sites size the buffer to match.
fn setHex(buf: ptr, hex: string): void {
    let n = hex.length / 2;
    let i = 0;
    while (i < n) {
        bytes.write_byte(buf, i, nib(hex[i * 2]) * 16 + nib(hex[i * 2 + 1]));
        i = i + 1;
    }
}

/// Loads the curve coefficient `b` in Montgomery form into `out`.
///
/// P-256 is `y^2 = x^3 - 3x + b`; this materialises that `b` constant (decoded
/// from big-endian hex, then pushed through [`toMont`]) for the curve-membership
/// test in [`onCurve`]. The `a = -3` coefficient is handled inline there and
/// needs no constant.
fn bMont(out: ptr): void {
    let b = bytes.alloc(32);
    setHex(b, "5ac635d8aa3a93e7b3ebbd55769886bc651d06b0cc53b0f63bce3c3e27d2604b");
    let t = newFe();
    feFromBE(t, b, 0);
    toMont(out, t);
    bytes.free(b);
    bytes.free(t);
}


/// Allocates a fresh 192-byte Jacobian point (three 64-byte field elements X, Y,
/// Z).
///
/// Contents are uninitialised; callers set the coordinates before use and must
/// `bytes.free` the buffer afterwards.
fn newPt(): ptr { return bytes.alloc(192); }
/// Returns a pointer to the X coordinate of point `p` (offset 0).
fn px(p: ptr): ptr { return p; }
/// Returns a pointer to the Y coordinate of point `p` (offset 64).
///
/// Pointer arithmetic goes through `long`, never `int`: a 64-bit heap address
/// plus an offset must not be truncated to 32 bits.
fn py(p: ptr): ptr { return (p as long + 64) as ptr; }
/// Returns a pointer to the Z coordinate of point `p` (offset 128); `Z = 0`
/// denotes the point at infinity.
fn pz(p: ptr): ptr { return (p as long + 128) as ptr; }

/// Copies a whole Jacobian point (all 24 limbs, i.e. X, Y and Z) from `s` to `d`.
fn ptCopy(d: ptr, s: ptr): void {
    let i = 0;
    while (i < 24) { setw(d, i, getw(s, i)); i = i + 1; }
}
/// Zeroes all 24 limbs of a point, giving `Z = 0`, i.e. the point at infinity.
fn ptZero(p: ptr): void {
    let i = 0;
    while (i < 24) { setw(p, i, U0); i = i + 1; }
}
/// Constant-time conditional copy: when `flag` is 1 copy `s` into `d`, when 0
/// leave `d` unchanged.
///
/// The choice is done with an arithmetic `mask` (`0 - flag`) over all 24 limbs,
/// with no branch on `flag`, so the selection cannot be observed through timing.
/// This is the primitive the scalar ladder [`scalarMultPoint`] uses to pick a
/// precomputed multiple without leaking the scalar bits. `flag` MUST be exactly 0
/// or 1.
fn ptCcopy(d: ptr, s: ptr, flag: ulong): void {
    let mask = U0 - flag;
    let i = 0;
    while (i < 24) {
        setw(d, i, (getw(s, i) & mask) | (getw(d, i) & (~mask)));
        i = i + 1;
    }
}

/// Jacobian point doubling in place: `q = 2q`.
///
/// Uses the standard `a = -3` doubling formula, which is why the `-3`
/// coefficient never needs a separate constant: it is folded into the
/// `feAdd(t2, px, t1); feSub(t1, px, t1); feMul(t3, t1, t2)` opening, computing
/// `3 * (X - Z^2) * (X + Z^2) = 3X^2 - 3Z^4`. All coordinates are in Montgomery
/// form. Correct for the point at infinity too: doubling `Z = 0` keeps `Z = 0`.
fn jDouble(q: ptr): void {
    let t1 = newFe(); let t2 = newFe(); let t3 = newFe(); let t4 = newFe();
    feSq(t1, pz(q));
    feAdd(t2, px(q), t1);
    feSub(t1, px(q), t1);
    feMul(t3, t1, t2);
    feAdd(t1, t3, t3);
    feAdd(t1, t3, t1);
    feSq(t3, py(q));
    feAdd(t3, t3, t3);
    feMul(t2, px(q), t3);
    feAdd(t2, t2, t2);
    feSq(px(q), t1);
    feSub(px(q), px(q), t2);
    feSub(px(q), px(q), t2);
    feMul(t4, py(q), pz(q));
    feAdd(pz(q), t4, t4);
    feSub(t2, t2, px(q));
    feMul(py(q), t1, t2);
    feSq(t4, t3);
    feAdd(t4, t4, t4);
    feSub(py(q), py(q), t4);
    bytes.free(t1); bytes.free(t2); bytes.free(t3); bytes.free(t4);
}

/// Jacobian point addition in place: `p1 = p1 + p2`.
///
/// The general add-1998-cmo style formula in Montgomery coordinates. IMPORTANT:
/// this is the incomplete addition law, so it does NOT handle `p1 == p2`
/// (doubling), `p1 == -p2` (giving infinity), or either operand being the point
/// at infinity. The callers arrange never to hit those cases: [`scalarMultPoint`]
/// keeps the accumulator distinct from the addend by construction, and the
/// affine-level [`affineAdd`] is used where the exceptional cases can genuinely
/// arise (in [`ecdsaVerify`]).
fn jAdd(p1: ptr, p2: ptr): void {
    let t1 = newFe(); let t2 = newFe(); let t3 = newFe(); let t4 = newFe();
    let t5 = newFe(); let t6 = newFe(); let t7 = newFe();
    feSq(t3, pz(p2));
    feMul(t1, px(p1), t3);
    feMul(t4, pz(p2), t3);
    feMul(t3, py(p1), t4);
    feSq(t4, pz(p1));
    feMul(t2, px(p2), t4);
    feMul(t5, pz(p1), t4);
    feMul(t4, py(p2), t5);
    feSub(t2, t2, t1);
    feSub(t4, t4, t3);
    feSq(t7, t2);
    feMul(t6, t1, t7);
    feMul(t5, t7, t2);
    feSq(px(p1), t4);
    feSub(px(p1), px(p1), t5);
    feSub(px(p1), px(p1), t6);
    feSub(px(p1), px(p1), t6);
    feSub(t6, t6, px(p1));
    feMul(py(p1), t4, t6);
    feMul(t1, t5, t3);
    feSub(py(p1), py(p1), t1);
    feMul(t1, pz(p1), pz(p2));
    feMul(pz(p1), t1, t2);
    bytes.free(t1); bytes.free(t2); bytes.free(t3); bytes.free(t4);
    bytes.free(t5); bytes.free(t6); bytes.free(t7);
}

/// Branch-free "is non-zero": returns 1 when `v != 0`, else 0.
///
/// `v | (0 - v)` has its top bit set for every non-zero `v` (either `v` or its
/// negation is negative), and 0 stays 0; the `>> 63` extracts that sign bit.
/// Used to build constant-time selection flags.
fn neqZero(v: ulong): ulong { return ((v | (U0 - v)) >> 63) & U1; }
/// Branch-free "equals constant": returns 1 when `v == c`, else 0.
///
/// Computed as the logical negation of [`neqZero`] applied to `v ^ c`. Drives the
/// masked precomputed-multiple selection in [`scalarMultPoint`].
fn eqVal(v: ulong, c: ulong): ulong { return neqZero(v ^ c) ^ U1; }

/// Constant-time scalar multiplication in place: `p = x * p`, where `x` is the
/// big-endian scalar in the first `xlen` bytes.
///
/// A fixed 2-bit windowed ladder. It precomputes `p2 = 2P` and `p3 = 3P`, then
/// walks the scalar two bits at a time from the most significant end: each step
/// does two doublings (multiply the accumulator by 4) and then adds the window's
/// multiple of `P` (one of `P`, `2P`, `3P`, or nothing for a zero window). The
/// add uses [`jAdd`], whose incomplete law cannot handle the accumulator still
/// being the point at infinity, so a running `qz` flag tracks whether `q` is
/// still zero and [`ptCcopy`] selects between "copy the addend directly" and
/// "add" without branching. Every window performs the same operations regardless
/// of the bit values, keeping the scalar secret against timing attacks.
///
/// Precondition: `p` must be a valid, non-infinity point in Montgomery Jacobian
/// form; the result is left in `p` and the scratch points are freed.
fn scalarMultPoint(p: ptr, x: ptr, xlen: int): void {
    let p2 = newPt(); ptCopy(p2, p); jDouble(p2);
    let p3 = newPt(); ptCopy(p3, p); jAdd(p3, p2);
    let q = newPt(); ptZero(q);
    let tt = newPt(); let uu = newPt();
    let qz: ulong = 1;
    let bi = 0;
    while (bi < xlen) {
        let byteV = bytes.read_byte(x, bi);
        let k = 6;
        while (k >= 0) {
            jDouble(q); jDouble(q);
            ptCopy(tt, p);
            ptCopy(uu, q);
            let bitsPair = ((byteV >> k) & 3) as ulong;
            let bnz = neqZero(bitsPair);
            ptCcopy(tt, p2, eqVal(bitsPair, 2));
            ptCcopy(tt, p3, eqVal(bitsPair, 3));
            jAdd(uu, tt);
            ptCcopy(q, tt, bnz & qz);
            ptCcopy(q, uu, bnz & (qz ^ U1));
            qz = qz & (bnz ^ U1);
            k = k - 2;
        }
        bi = bi + 1;
    }
    ptCopy(p, q);
    bytes.free(p2); bytes.free(p3); bytes.free(q); bytes.free(tt); bytes.free(uu);
}

/// Converts a Jacobian point to affine coordinates, dividing out `Z` and leaving
/// Montgomery form.
///
/// Computes `x = X / Z^2` and `y = Y / Z^3` with a single field inversion
/// ([`feInvert`]) of `Z`, which is the whole reason projective coordinates are
/// worth carrying: only one inversion, at the end. Both outputs are converted OUT
/// of Montgomery form via [`fromMont`], so `xaOut` and `yaOut` are plain 256-bit
/// residues ready for [`feToBE`]. Undefined for the point at infinity (`Z = 0`),
/// which the callers screen out first with [`feIsZero`] / [`jacToAffine`].
fn toAffine(p: ptr, xaOut: ptr, yaOut: ptr): void {
    let zinv = newFe(); feInvert(zinv, pz(p));
    let z2 = newFe(); feSq(z2, zinv);
    let xm = newFe(); feMul(xm, px(p), z2);
    let z3 = newFe(); feMul(z3, z2, zinv);
    let ym = newFe(); feMul(ym, py(p), z3);
    fromMont(xaOut, xm);
    fromMont(yaOut, ym);
    bytes.free(zinv); bytes.free(z2); bytes.free(xm); bytes.free(z3); bytes.free(ym);
}

/// Loads the P-256 base point `G` into `p` as a Montgomery Jacobian point with
/// `Z = 1`.
///
/// `Gx` and `Gy` are the standard NIST generator coordinates, decoded from hex,
/// pushed into Montgomery form, and `Z` set to the Montgomery representation of
/// 1. This is the starting point for public-key derivation ([`derivePublic`]) and
/// the `u1 * G` term of verification ([`ecdsaVerify`]).
fn baseG(p: ptr): void {
    let gx = bytes.alloc(32);
    setHex(gx, "6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296");
    let gy = bytes.alloc(32);
    setHex(gy, "4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5");
    let t = newFe();
    feFromBE(t, gx, 0); toMont(px(p), t);
    feFromBE(t, gy, 0); toMont(py(p), t);
    feZero(t); setw(t, 0, U1); toMont(pz(p), t);
    bytes.free(gx); bytes.free(gy); bytes.free(t);
}

/// Curve-membership test: true when the affine point `(xn, yn)` satisfies the
/// P-256 equation.
///
/// Takes plain (non-Montgomery) affine coordinates, lifts them into Montgomery
/// form, and checks `y^2 == x^3 - 3x + b`. The `x^3 - 3x` left side is built as
/// `x^2 * x` minus `3x` (the `feAdd(t, xm, xm); feAdd(t, t, xm)` triple), then `b`
/// is added from [`bMont`]. This is an essential input-validation step: an
/// attacker-supplied point that is NOT on the curve can leak the private scalar
/// through invalid-curve attacks, so [`ecdh`] and [`decodePointToJac`] reject any
/// point that fails here.
fn onCurve(xn: ptr, yn: ptr): bool {
    let xm = newFe(); let ym = newFe();
    toMont(xm, xn); toMont(ym, yn);
    let l = newFe(); feSq(l, ym);
    let r = newFe(); feSq(r, xm); feMul(r, r, xm);
    let t = newFe(); feAdd(t, xm, xm); feAdd(t, t, xm);
    feSub(r, r, t);
    let bm = newFe(); bMont(bm); feAdd(r, r, bm);
    let ok = feEq(l, r);
    bytes.free(xm); bytes.free(ym); bytes.free(l); bytes.free(r); bytes.free(t); bytes.free(bm);
    return ok;
}


/// Derives the uncompressed public key for a 32-byte private scalar.
///
/// Computes `scalar * G` and writes the SEC1 uncompressed encoding into the
/// 65-byte `outPub65`: a leading `0x04` tag followed by the 32-byte big-endian X
/// and Y coordinates. `scalar32` is the big-endian private key; the caller is
/// responsible for it being a valid scalar in `[1, n-1]`. Buffer sizes are
/// fixed: `outPub65` must be at least 65 bytes and `scalar32` exactly 32.
pub fn derivePublic(outPub65: ptr, scalar32: ptr): void {
    let g = newPt(); baseG(g);
    scalarMultPoint(g, scalar32, 32);
    let xa = newFe(); let ya = newFe();
    toAffine(g, xa, ya);
    bytes.write_byte(outPub65, 0, 4);
    feToBE(outPub65, 1, xa);
    feToBE(outPub65, 33, ya);
    bytes.free(g); bytes.free(xa); bytes.free(ya);
}

/// ECDH shared-secret agreement over P-256.
///
/// Multiplies the peer's public point by our private `scalar32` and writes the
/// 32-byte big-endian X coordinate of the result into `outSecret32` (the raw
/// shared secret, which a caller normally runs through a KDF before use).
/// Returns 1 on success and 0 on failure.
///
/// It validates the peer key before touching the secret scalar, rejecting
/// (return 0) any of: a first byte other than `0x04` (only the uncompressed
/// encoding is accepted), an X or Y coordinate that is not less than `p`
/// ([`feLtP`]), or a point that is not on the curve ([`onCurve`]). These checks
/// defend against invalid-curve attacks that would otherwise leak the private
/// key. The point at infinity as an output is not separately signalled; a
/// well-formed peer key and a valid scalar cannot produce it.
pub fn ecdh(outSecret32: ptr, scalar32: ptr, peerPub65: ptr): int {
    if (bytes.read_byte(peerPub65, 0) != 4) { return 0; }
    let xn = newFe(); let yn = newFe();
    feFromBE(xn, peerPub65, 1); feFromBE(yn, peerPub65, 33);
    if (!feLtP(xn) || !feLtP(yn) || !onCurve(xn, yn)) {
        bytes.free(xn); bytes.free(yn);
        return 0;
    }
    let q = newPt();
    toMont(px(q), xn); toMont(py(q), yn);
    let one = newFe(); feZero(one); setw(one, 0, U1); toMont(pz(q), one);
    scalarMultPoint(q, scalar32, 32);
    let xa = newFe(); let ya = newFe();
    toAffine(q, xa, ya);
    feToBE(outSecret32, 0, xa);
    bytes.free(xn); bytes.free(yn); bytes.free(q); bytes.free(one);
    bytes.free(xa); bytes.free(ya);
    return 1;
}


/// Montgomery reduction constant for the scalar field: `-n^-1 mod 2^32`.
///
/// Unlike the prime `p`, whose corresponding constant is 1 (and so vanishes in
/// [`feMul`]), the group order `n` needs this real value in [`nMul`]'s reduction
/// step. It is the multiplier that zeroes the low limb during each Montgomery
/// fold.
const N0INV: ulong = 0xee00bc4f;

/// Returns limb `i` of the P-256 group order `n`, least-significant limb first.
///
/// The order is
/// `n = ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551`. The
/// low four limbs are the irregular `bce6faad...` tail, limbs 4, 5, 7 are all
/// ones, and limb 6 is zero. This is the scalar-field analogue of [`pl`].
fn nl(i: int): ulong {
    if (i == 0) { return 0xfc632551; }
    if (i == 1) { return 0xf3b9cac2; }
    if (i == 2) { return 0xa7179e84; }
    if (i == 3) { return 0xbce6faad; }
    if (i == 6) { return U0; }
    return MASK32;
}

/// Constant-time zero test: true when every limb of `a` is zero.
///
/// ORs all eight limbs together and compares to zero, inspecting the full width
/// rather than short-circuiting. Used both as a field predicate and, in the
/// scalar domain, to reject a zero `r` or `s`.
fn feIsZero(a: ptr): bool {
    let d: ulong = 0;
    let j = 0;
    while (j < 8) { d = d | getw(a, j); j = j + 1; }
    return d == U0;
}

/// Returns true when `a` is strictly less than the group order `n`.
///
/// A trial subtraction `a - n` whose top borrow indicates `a < n`, the
/// scalar-field counterpart of [`feLtP`]. Combined with [`feIsZero`] in
/// [`inRangeN`] to validate signature scalars.
fn ltN(a: ptr): bool {
    let borrow: ulong = 0;
    let j = 0;
    while (j < 8) {
        let x = getw(a, j) - nl(j) - borrow;
        borrow = (x >> 32) & U1;
        j = j + 1;
    }
    return borrow == U1;
}
/// Returns true when `a` is a valid scalar-field element, that is `0 < a < n`.
///
/// This is the acceptance predicate for an ECDSA `r`/`s` component and for a
/// candidate nonce `k`: both zero and any value at or above the order are
/// rejected. See [`ecdsaVerify`] and [`ecdsaSign`].
fn inRangeN(a: ptr): bool { return (!feIsZero(a)) && ltN(a); }

/// Constant-time conditional subtract of the order `n` from a nine-limb value.
///
/// The scalar-field analogue of [`condSubP`]: reduces a sum or Montgomery
/// intermediate that may be in `[0, 2n)` back below `n`, choosing `t - n` or `t`
/// with an arithmetic mask so no branch depends on the value. Used by [`nAdd`]
/// and [`nMul`].
fn nCondSub(out: ptr, t: ptr): void {
    let d = bytes.alloc(64);
    let borrow: ulong = 0;
    let j = 0;
    while (j < 8) {
        let x = getw(t, j) - nl(j) - borrow;
        setw(d, j, x & MASK32);
        borrow = (x >> 32) & U1;
        j = j + 1;
    }
    let x8 = getw(t, 8) - borrow;
    borrow = (x8 >> 32) & U1;
    let mask = U0 - (borrow ^ U1);
    j = 0;
    while (j < 8) {
        setw(out, j, (getw(d, j) & mask) | (getw(t, j) & (~mask)));
        j = j + 1;
    }
    bytes.free(d);
}

/// Modular addition in the scalar field: `out = (a + b) mod n`.
///
/// The `mod n` counterpart of [`feAdd`], adding into a nine-limb temporary and
/// reducing once with [`nCondSub`].
fn nAdd(out: ptr, a: ptr, b: ptr): void {
    let t = bytes.alloc(72);
    let carry: ulong = 0;
    let j = 0;
    while (j < 8) {
        let s = getw(a, j) + getw(b, j) + carry;
        setw(t, j, s & MASK32);
        carry = s >> 32;
        j = j + 1;
    }
    setw(t, 8, carry);
    nCondSub(out, t);
    bytes.free(t);
}

/// Montgomery modular multiplication in the scalar field: `out = a * b * R^-1 mod
/// n`.
///
/// The `mod n` counterpart of [`feMul`]. It differs in one respect: the reduction
/// multiplier is `m = t0 * N0INV mod 2^32` using the real constant [`N0INV`],
/// whereas [`feMul`] could drop that factor because the prime's inverse is 1.
/// Operands must be in the scalar-field Montgomery domain (see [`toMontN`]).
fn nMul(out: ptr, a: ptr, b: ptr): void {
    let t = bytes.alloc(80);
    let j = 0;
    while (j < 10) { setw(t, j, U0); j = j + 1; }
    let i = 0;
    while (i < 8) {
        let bi = getw(b, i);
        let carry: ulong = 0;
        j = 0;
        while (j < 8) {
            let s = getw(t, j) + getw(a, j) * bi + carry;
            setw(t, j, s & MASK32);
            carry = s >> 32;
            j = j + 1;
        }
        let s8 = getw(t, 8) + carry;
        setw(t, 8, s8 & MASK32);
        setw(t, 9, s8 >> 32);
        let m = (getw(t, 0) * N0INV) & MASK32;
        let c2 = (getw(t, 0) + m * nl(0)) >> 32;
        j = 1;
        while (j < 8) {
            let s = getw(t, j) + m * nl(j) + c2;
            setw(t, j - 1, s & MASK32);
            c2 = s >> 32;
            j = j + 1;
        }
        let s7 = getw(t, 8) + c2;
        setw(t, 7, s7 & MASK32);
        setw(t, 8, getw(t, 9) + (s7 >> 32));
        i = i + 1;
    }
    nCondSub(out, t);
    bytes.free(t);
}

/// Converts a plain scalar into scalar-field Montgomery form: `out = a * R mod n`.
///
/// Like [`toMont`] but reduces mod `n`, doubling `a` 256 times via [`nAdd`].
fn toMontN(out: ptr, a: ptr): void {
    feCopy(out, a);
    let i = 0;
    while (i < 256) { nAdd(out, out, out); i = i + 1; }
}
/// Converts a scalar-field Montgomery value back to a plain residue: `out = x *
/// R^-1 mod n`.
///
/// A Montgomery multiply against the plain integer 1, mirroring [`fromMont`].
fn fromMontN(out: ptr, x: ptr): void {
    let one = newFe(); feZero(one); setw(one, 0, U1);
    nMul(out, x, one);
    bytes.free(one);
}
/// Writes the scalar-field Montgomery representation of 1 (`R mod n`) into `out`,
/// used to seed the [`invModN`] exponentiation.
fn montOneN(out: ptr): void {
    let one = newFe(); feZero(one); setw(one, 0, U1);
    toMontN(out, one);
    bytes.free(one);
}

/// Plain modular multiply in the scalar field: `out = (a * b) mod n`, both inputs
/// and output in ordinary (non-Montgomery) form.
///
/// It lifts `a` into Montgomery form and multiplies by a plain `b`; the single
/// `R^-1` that [`nMul`] introduces cancels the `R` from `a`, leaving a plain
/// residue. This is the convenience wrapper the ECDSA maths uses for products
/// like `u1 = e * s^-1` and `u2 = r * s^-1`.
fn modMulN(out: ptr, a: ptr, b: ptr): void {
    let aM = newFe(); toMontN(aM, a);
    nMul(out, aM, b);
    bytes.free(aM);
}

/// Modular inverse in the scalar field: `out = a^-1 mod n`, via Fermat as
/// `a^(n-2) mod n`.
///
/// The scalar-field analogue of [`feInvert`]. It lifts `a` into Montgomery form,
/// runs a fixed 256-iteration square-and-multiply over the constant exponent
/// `n - 2`, and converts the result back out with [`fromMontN`], so `out` is a
/// plain residue. Used to invert `s` in verification and `k` in signing; the
/// callers ensure `a` is non-zero.
fn invModN(out: ptr, a: ptr): void {
    let aM = newFe(); toMontN(aM, a);
    let r = newFe(); montOneN(r);
    let e = bytes.alloc(32);
    setHex(e, "ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc63254f");
    let k = 255;
    while (k >= 0) {
        nMul(r, r, r);
        let bitVal = (bytes.read_byte(e, 31 - (k >> 3)) >> (k & 7)) & 1;
        if (bitVal == 1) { nMul(r, r, aM); }
        k = k - 1;
    }
    fromMontN(out, r);
    bytes.free(aM); bytes.free(r); bytes.free(e);
}

/// Reduces a value already known to be less than `2n` down modulo the order:
/// `out = inp mod n`.
///
/// It widens `inp` to a nine-limb temporary with a zero top limb and applies a
/// single [`nCondSub`]. This is NOT a general reduction: it assumes `inp < 2n`,
/// which holds when `inp` is a field element (a value below `p`, and `p < 2n`) or
/// a scalar-field sum. It is how a hash or an X-coordinate is folded into the
/// scalar field in [`ecdsaVerify`] and [`ecdsaSign`].
fn reduceModN(out: ptr, inp: ptr): void {
    let t = bytes.alloc(72);
    let j = 0;
    while (j < 8) { setw(t, j, getw(inp, j)); j = j + 1; }
    setw(t, 8, U0);
    nCondSub(out, t);
    bytes.free(t);
}

/// Decodes and validates an uncompressed public key into a Montgomery Jacobian
/// point.
///
/// Reads the SEC1 uncompressed encoding (`0x04 || X || Y`) from `pub65`,
/// validates it exactly as [`ecdh`] does (tag byte, both coordinates `< p`, and
/// on the curve), and on success writes the point into `q` in Montgomery form
/// with `Z = 1`. Returns 1 when the key is accepted and 0 when it is malformed or
/// off-curve, in which case `q` is left untouched and the scratch buffers are
/// freed. This is the validating decoder used by [`ecdsaVerify`].
fn decodePointToJac(pub65: ptr, q: ptr): int {
    if (bytes.read_byte(pub65, 0) != 4) { return 0; }
    let xn = newFe(); let yn = newFe();
    feFromBE(xn, pub65, 1); feFromBE(yn, pub65, 33);
    if (!feLtP(xn) || !feLtP(yn) || !onCurve(xn, yn)) {
        bytes.free(xn); bytes.free(yn);
        return 0;
    }
    toMont(px(q), xn); toMont(py(q), yn);
    let one = newFe(); feZero(one); setw(one, 0, U1); toMont(pz(q), one);
    bytes.free(xn); bytes.free(yn); bytes.free(one);
    return 1;
}

/// Converts a Jacobian point to affine, reporting whether it is the point at
/// infinity.
///
/// Returns 1 without writing outputs when `Z = 0` (infinity), otherwise delegates
/// to [`toAffine`] and returns 0. The `int` return doubles as the "is infinity"
/// flag threaded into [`affineAdd`] during verification, which must treat
/// infinity specially because [`toAffine`] cannot.
fn jacToAffine(p: ptr, xOut: ptr, yOut: ptr): int {
    if (feIsZero(pz(p))) { return 1; }
    toAffine(p, xOut, yOut);
    return 0;
}

/// Complete affine point addition `(rx, ry) = A + B`, handling every exceptional
/// case.
///
/// Unlike the fast but incomplete [`jAdd`], this one covers all inputs, which is
/// why [`ecdsaVerify`] uses it for the final `u1*G + u2*Q` sum where the two
/// terms may coincide or cancel. The `aInf`/`bInf` flags mark either operand as
/// the point at infinity. When both X coordinates match it either doubles (equal
/// Y) or returns infinity (opposite Y); otherwise it uses the chord slope. The
/// return value is 1 when the result is the point at infinity and 0 otherwise, in
/// which case the plain affine coordinates are written to `rxOut`/`ryOut`.
/// Internally it lifts inputs to Montgomery form and inverts with [`feInvert`].
fn affineAdd(aInf: int, ax: ptr, ay: ptr, bInf: int, bx: ptr, by: ptr, rxOut: ptr, ryOut: ptr): int {
    if (aInf == 1) {
        if (bInf == 1) { return 1; }
        feCopy(rxOut, bx); feCopy(ryOut, by);
        return 0;
    }
    if (bInf == 1) { feCopy(rxOut, ax); feCopy(ryOut, ay); return 0; }
    let axM = newFe(); toMont(axM, ax); let ayM = newFe(); toMont(ayM, ay);
    let bxM = newFe(); toMont(bxM, bx); let byM = newFe(); toMont(byM, by);
    let lam = newFe(); let t1 = newFe(); let t2 = newFe();
    let inf = 0;
    if (feEq(axM, bxM)) {
        if (feEq(ayM, byM)) {
            feSq(t1, axM);
            feAdd(t2, t1, t1); feAdd(t1, t2, t1);
            let three = newFe(); feZero(three); setw(three, 0, 3);
            let threeM = newFe(); toMont(threeM, three);
            feSub(t1, t1, threeM);
            feAdd(t2, ayM, ayM);
            let inv = newFe(); feInvert(inv, t2);
            feMul(lam, t1, inv);
            bytes.free(three); bytes.free(threeM); bytes.free(inv);
        } else {
            inf = 1;
        }
    } else {
        feSub(t1, byM, ayM);
        feSub(t2, bxM, axM);
        let inv = newFe(); feInvert(inv, t2);
        feMul(lam, t1, inv);
        bytes.free(inv);
    }
    if (inf == 0) {
        let rxM = newFe(); let ryM = newFe();
        feSq(rxM, lam);
        feSub(rxM, rxM, axM);
        feSub(rxM, rxM, bxM);
        feSub(t1, axM, rxM);
        feMul(ryM, lam, t1);
        feSub(ryM, ryM, ayM);
        fromMont(rxOut, rxM);
        fromMont(ryOut, ryM);
        bytes.free(rxM); bytes.free(ryM);
    }
    bytes.free(axM); bytes.free(ayM); bytes.free(bxM); bytes.free(byM);
    bytes.free(lam); bytes.free(t1); bytes.free(t2);
    return inf;
}

/// Verifies an ECDSA signature over P-256, returning true only when it is valid.
///
/// `hash32` is the 32-byte message digest (the caller hashes the message,
/// normally with SHA-256), `pub65` the signer's uncompressed public key, and
/// `r32`/`s32` the two 32-byte big-endian signature scalars. The standard check:
/// reject unless `r` and `s` are both in `[1, n-1]` and the public key decodes to
/// a valid on-curve point; reduce the hash mod `n` into `e`; form `w = s^-1`,
/// `u1 = e*w`, `u2 = r*w`; compute `R = u1*G + u2*Q`; and accept when the affine
/// X of `R`, reduced mod `n`, equals `r`.
///
/// The two scalar multiplications go through the incomplete [`jAdd`] internally,
/// so the final combination is done at the affine level with [`affineAdd`], which
/// handles the case where the two terms coincide or cancel. A result at infinity
/// (`rInf == 1`) is a rejection. All scratch allocations are freed on every path.
pub fn ecdsaVerify(hash32: ptr, pub65: ptr, r32: ptr, s32: ptr): bool {
    let r = newFe(); feFromBE(r, r32, 0);
    let s = newFe(); feFromBE(s, s32, 0);
    let q = newPt();
    if (!inRangeN(r) || !inRangeN(s) || decodePointToJac(pub65, q) == 0) {
        bytes.free(r); bytes.free(s); bytes.free(q);
        return false;
    }
    let hb = newFe(); feFromBE(hb, hash32, 0);
    let e = newFe(); reduceModN(e, hb);
    let w = newFe(); invModN(w, s);
    let u1 = newFe(); modMulN(u1, e, w);
    let u2 = newFe(); modMulN(u2, r, w);
    let u1b = bytes.alloc(32); feToBE(u1b, 0, u1);
    let u2b = bytes.alloc(32); feToBE(u2b, 0, u2);

    let a = newPt(); baseG(a); scalarMultPoint(a, u1b, 32);
    scalarMultPoint(q, u2b, 32);

    let ax = newFe(); let ay = newFe(); let aInf = jacToAffine(a, ax, ay);
    let bx = newFe(); let by = newFe(); let bInf = jacToAffine(q, bx, by);
    let rx = newFe(); let ry = newFe();
    let rInf = affineAdd(aInf, ax, ay, bInf, bx, by, rx, ry);

    let ok = false;
    if (rInf == 0) {
        let v = newFe(); reduceModN(v, rx);
        ok = feEq(v, r);
        bytes.free(v);
    }
    bytes.free(r); bytes.free(s); bytes.free(q); bytes.free(hb); bytes.free(e);
    bytes.free(w); bytes.free(u1); bytes.free(u2); bytes.free(u1b); bytes.free(u2b);
    bytes.free(a); bytes.free(ax); bytes.free(ay); bytes.free(bx); bytes.free(by);
    bytes.free(rx); bytes.free(ry);
    return ok;
}

/// Assembles the 97-byte HMAC message `V || sep || x || h` for RFC 6979 nonce
/// derivation.
///
/// The deterministic-nonce construction feeds HMAC with the current `V` (32
/// bytes), a single separator byte `sep` (0x00 or 0x01), the private key `x` (32
/// bytes), and the reduced message hash `h` (32 bytes). This helper lays those
/// out contiguously into `out`, which must be at least 97 bytes. Used twice in
/// the K/V initialisation inside [`ecdsaSign`].
fn hmacInput(out: ptr, v: ptr, sep: int, x: ptr, h: ptr): void {
    let i = 0;
    while (i < 32) { bytes.write_byte(out, i, bytes.read_byte(v, i)); i = i + 1; }
    bytes.write_byte(out, 32, sep);
    i = 0;
    while (i < 32) { bytes.write_byte(out, 33 + i, bytes.read_byte(x, i)); i = i + 1; }
    i = 0;
    while (i < 32) { bytes.write_byte(out, 65 + i, bytes.read_byte(h, i)); i = i + 1; }
}

/// Produces an ECDSA signature over P-256 with an RFC 6979 deterministic nonce.
///
/// `hash32` is the 32-byte message digest and `privKey32` the 32-byte big-endian
/// private key; on success the big-endian signature scalars are written to
/// `rOut` and `sOut` and the function returns 1. The nonce `k` is derived
/// deterministically from the key and message through the HMAC-SHA-256 K/V
/// generator (via `crypto.mac.hmac`), so signing needs no random source and never
/// reuses a nonce for the same message, avoiding the catastrophic key leak that
/// nonce reuse causes.
///
/// It follows the RFC 6979 loop: initialise `V` to all-ones and `K` to all-zeros,
/// mix in the key and hash twice with the 0x00 and 0x01 separators, then repeat
/// generating candidate `k` values until one lands in `[1, n-1]` AND yields a
/// non-zero `r` and `s`. `r` is the X coordinate of `k*G` reduced mod `n`, and
/// `s = k^-1 * (z + r*d) mod n`. The retry loop is bounded at 64 attempts; if it
/// somehow exhausts them it returns 0 without writing a signature. This
/// implementation does not force low-`s` (BIP-0062) normalisation.
pub fn ecdsaSign(hash32: ptr, privKey32: ptr, rOut: ptr, sOut: ptr): int {
    let hz = newFe(); feFromBE(hz, hash32, 0);
    let z = newFe(); reduceModN(z, hz);
    let h1o = bytes.alloc(32); feToBE(h1o, 0, z);
    let dtmp = newFe(); feFromBE(dtmp, privKey32, 0);
    let d = newFe(); reduceModN(d, dtmp);

    let vv = bytes.alloc(32); let kk = bytes.alloc(32);
    let i = 0;
    while (i < 32) { bytes.write_byte(vv, i, 1); bytes.write_byte(kk, i, 0); i = i + 1; }
    let msg = bytes.alloc(97);
    hmacInput(msg, vv, 0, privKey32, h1o); hmac.hmacSha256(kk, 32, msg, 97, kk); hmac.hmacSha256(kk, 32, vv, 32, vv);
    hmacInput(msg, vv, 1, privKey32, h1o); hmac.hmacSha256(kk, 32, msg, 97, kk); hmac.hmacSha256(kk, 32, vv, 32, vv);

    let result = 0;
    let attempts = 0;
    while (result == 0 && attempts < 64) {
        hmac.hmacSha256(kk, 32, vv, 32, vv);
        let kfe = newFe(); feFromBE(kfe, vv, 0);
        if (inRangeN(kfe)) {
            let g = newPt(); baseG(g); scalarMultPoint(g, vv, 32);
            let xa = newFe(); let ya = newFe(); toAffine(g, xa, ya);
            let r = newFe(); reduceModN(r, xa);
            if (!feIsZero(r)) {
                let rd = newFe(); modMulN(rd, r, d);
                let zrd = newFe(); nAdd(zrd, z, rd);
                let kinv = newFe(); invModN(kinv, kfe);
                let s = newFe(); modMulN(s, kinv, zrd);
                if (!feIsZero(s)) {
                    feToBE(rOut, 0, r);
                    feToBE(sOut, 0, s);
                    result = 1;
                }
                bytes.free(rd); bytes.free(zrd); bytes.free(kinv); bytes.free(s);
            }
            bytes.free(g); bytes.free(xa); bytes.free(ya); bytes.free(r);
        }
        bytes.free(kfe);
        if (result == 0) {
            let m2 = bytes.alloc(33);
            i = 0;
            while (i < 32) { bytes.write_byte(m2, i, bytes.read_byte(vv, i)); i = i + 1; }
            bytes.write_byte(m2, 32, 0);
            hmac.hmacSha256(kk, 32, m2, 33, kk);
            hmac.hmacSha256(kk, 32, vv, 32, vv);
            bytes.free(m2);
        }
        attempts = attempts + 1;
    }
    bytes.free(hz); bytes.free(z); bytes.free(h1o); bytes.free(dtmp); bytes.free(d);
    bytes.free(vv); bytes.free(kk); bytes.free(msg);
    return result;
}
