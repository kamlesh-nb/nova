import bytes;
import crypto.mac.hmac;

const MASK32: ulong = 0xffffffff;
const U0: ulong = 0;
const U1: ulong = 1;


fn newFe(): ptr { return bytes.alloc(64); }
fn getw(f: ptr, i: int): ulong { return (bytes.read_ptr(f, i * 8) as long) as ulong; }
fn setw(f: ptr, i: int, v: ulong): void { bytes.write_ptr(f, i * 8, (v as long) as ptr); }

fn pl(i: int): ulong {
    if (i == 3) { return U0; }
    if (i == 4) { return U0; }
    if (i == 5) { return U0; }
    if (i == 6) { return U1; }
    return MASK32;
}

fn feCopy(out: ptr, a: ptr): void {
    let i = 0;
    while (i < 8) { setw(out, i, getw(a, i)); i = i + 1; }
}
fn feZero(out: ptr): void {
    let i = 0;
    while (i < 8) { setw(out, i, U0); i = i + 1; }
}

fn condSubP(out: ptr, t: ptr): void {
    let d = bytes.alloc(64);
    let borrow: ulong = 0;
    let j = 0;
    while (j < 8) {
        let x = getw(t, j) - pl(j) - borrow;
        setw(d, j, x & MASK32);
        borrow = (x >> 32) & U1;
        j = j + 1;
    }
    let x8 = getw(t, 8) - borrow;
    borrow = (x8 >> 32) & U1;
    let mask = U0 - (borrow ^ U1);
    j = 0;
    while (j < 8) {
        setw(out, j, (getw(d, j) & mask) | (getw(t, j) & (~mask)));
        j = j + 1;
    }
    bytes.free(d);
}

fn feAdd(out: ptr, a: ptr, b: ptr): void {
    let t = bytes.alloc(72);
    let carry: ulong = 0;
    let j = 0;
    while (j < 8) {
        let s = getw(a, j) + getw(b, j) + carry;
        setw(t, j, s & MASK32);
        carry = s >> 32;
        j = j + 1;
    }
    setw(t, 8, carry);
    condSubP(out, t);
    bytes.free(t);
}

fn feSub(out: ptr, a: ptr, b: ptr): void {
    let d = bytes.alloc(64);
    let borrow: ulong = 0;
    let j = 0;
    while (j < 8) {
        let x = getw(a, j) - getw(b, j) - borrow;
        setw(d, j, x & MASK32);
        borrow = (x >> 32) & U1;
        j = j + 1;
    }
    let mask = U0 - borrow;
    let carry: ulong = 0;
    j = 0;
    while (j < 8) {
        let s = getw(d, j) + (pl(j) & mask) + carry;
        setw(out, j, s & MASK32);
        carry = s >> 32;
        j = j + 1;
    }
    bytes.free(d);
}

fn feMul(out: ptr, a: ptr, b: ptr): void {
    let t = bytes.alloc(80);
    let j = 0;
    while (j < 10) { setw(t, j, U0); j = j + 1; }
    let i = 0;
    while (i < 8) {
        let bi = getw(b, i);
        let carry: ulong = 0;
        j = 0;
        while (j < 8) {
            let s = getw(t, j) + getw(a, j) * bi + carry;
            setw(t, j, s & MASK32);
            carry = s >> 32;
            j = j + 1;
        }
        let s8 = getw(t, 8) + carry;
        setw(t, 8, s8 & MASK32);
        setw(t, 9, s8 >> 32);
        let m = getw(t, 0);
        let c2 = (getw(t, 0) + m * pl(0)) >> 32;
        j = 1;
        while (j < 8) {
            let s = getw(t, j) + m * pl(j) + c2;
            setw(t, j - 1, s & MASK32);
            c2 = s >> 32;
            j = j + 1;
        }
        let s7 = getw(t, 8) + c2;
        setw(t, 7, s7 & MASK32);
        setw(t, 8, getw(t, 9) + (s7 >> 32));
        i = i + 1;
    }
    condSubP(out, t);
    bytes.free(t);
}

fn feSq(out: ptr, a: ptr): void { feMul(out, a, a); }

fn toMont(out: ptr, a: ptr): void {
    feCopy(out, a);
    let i = 0;
    while (i < 256) { feAdd(out, out, out); i = i + 1; }
}

fn fromMont(out: ptr, x: ptr): void {
    let one = newFe();
    feZero(one); setw(one, 0, U1);
    feMul(out, x, one);
    bytes.free(one);
}

fn montOne(out: ptr): void {
    let one = newFe();
    feZero(one); setw(one, 0, U1);
    toMont(out, one);
    bytes.free(one);
}

fn feEq(a: ptr, b: ptr): bool {
    let diff: ulong = 0;
    let j = 0;
    while (j < 8) { diff = diff | (getw(a, j) ^ getw(b, j)); j = j + 1; }
    return diff == U0;
}

fn feLtP(a: ptr): bool {
    let borrow: ulong = 0;
    let j = 0;
    while (j < 8) {
        let x = getw(a, j) - pl(j) - borrow;
        borrow = (x >> 32) & U1;
        j = j + 1;
    }
    return borrow == U1;
}

fn feInvert(out: ptr, a: ptr): void {
    let r = newFe();
    montOne(r);
    let e = bytes.alloc(32);
    setHex(e, "ffffffff00000001000000000000000000000000fffffffffffffffffffffffd");
    let k = 255;
    while (k >= 0) {
        feSq(r, r);
        let bitVal = (bytes.read_byte(e, 31 - (k >> 3)) >> (k & 7)) & 1;
        if (bitVal == 1) { feMul(r, r, a); }
        k = k - 1;
    }
    feCopy(out, r);
    bytes.free(r);
    bytes.free(e);
}


fn feFromBE(out: ptr, buf: ptr, off: int): void {
    let i = 0;
    while (i < 8) {
        let base = off + (7 - i) * 4;
        let w = ((bytes.read_byte(buf, base) as ulong) << 24)
              | ((bytes.read_byte(buf, base + 1) as ulong) << 16)
              | ((bytes.read_byte(buf, base + 2) as ulong) << 8)
              | (bytes.read_byte(buf, base + 3) as ulong);
        setw(out, i, w);
        i = i + 1;
    }
}

fn feToBE(buf: ptr, off: int, a: ptr): void {
    let i = 0;
    while (i < 8) {
        let base = off + (7 - i) * 4;
        let w = getw(a, i);
        bytes.write_byte(buf, base, ((w >> 24) & 0xff) as int);
        bytes.write_byte(buf, base + 1, ((w >> 16) & 0xff) as int);
        bytes.write_byte(buf, base + 2, ((w >> 8) & 0xff) as int);
        bytes.write_byte(buf, base + 3, (w & 0xff) as int);
        i = i + 1;
    }
}

fn nib(c: int): int {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    return c - 55;
}
fn setHex(buf: ptr, hex: string): void {
    let n = hex.length / 2;
    let i = 0;
    while (i < n) {
        bytes.write_byte(buf, i, nib(hex[i * 2]) * 16 + nib(hex[i * 2 + 1]));
        i = i + 1;
    }
}

fn bMont(out: ptr): void {
    let b = bytes.alloc(32);
    setHex(b, "5ac635d8aa3a93e7b3ebbd55769886bc651d06b0cc53b0f63bce3c3e27d2604b");
    let t = newFe();
    feFromBE(t, b, 0);
    toMont(out, t);
    bytes.free(b);
    bytes.free(t);
}


fn newPt(): ptr { return bytes.alloc(192); }
fn px(p: ptr): ptr { return p; }
fn py(p: ptr): ptr { return (p as long + 64) as ptr; }
fn pz(p: ptr): ptr { return (p as long + 128) as ptr; }

fn ptCopy(d: ptr, s: ptr): void {
    let i = 0;
    while (i < 24) { setw(d, i, getw(s, i)); i = i + 1; }
}
fn ptZero(p: ptr): void {
    let i = 0;
    while (i < 24) { setw(p, i, U0); i = i + 1; }
}
fn ptCcopy(d: ptr, s: ptr, flag: ulong): void {
    let mask = U0 - flag;
    let i = 0;
    while (i < 24) {
        setw(d, i, (getw(s, i) & mask) | (getw(d, i) & (~mask)));
        i = i + 1;
    }
}

fn jDouble(q: ptr): void {
    let t1 = newFe(); let t2 = newFe(); let t3 = newFe(); let t4 = newFe();
    feSq(t1, pz(q));
    feAdd(t2, px(q), t1);
    feSub(t1, px(q), t1);
    feMul(t3, t1, t2);
    feAdd(t1, t3, t3);
    feAdd(t1, t3, t1);
    feSq(t3, py(q));
    feAdd(t3, t3, t3);
    feMul(t2, px(q), t3);
    feAdd(t2, t2, t2);
    feSq(px(q), t1);
    feSub(px(q), px(q), t2);
    feSub(px(q), px(q), t2);
    feMul(t4, py(q), pz(q));
    feAdd(pz(q), t4, t4);
    feSub(t2, t2, px(q));
    feMul(py(q), t1, t2);
    feSq(t4, t3);
    feAdd(t4, t4, t4);
    feSub(py(q), py(q), t4);
    bytes.free(t1); bytes.free(t2); bytes.free(t3); bytes.free(t4);
}

fn jAdd(p1: ptr, p2: ptr): void {
    let t1 = newFe(); let t2 = newFe(); let t3 = newFe(); let t4 = newFe();
    let t5 = newFe(); let t6 = newFe(); let t7 = newFe();
    feSq(t3, pz(p2));
    feMul(t1, px(p1), t3);
    feMul(t4, pz(p2), t3);
    feMul(t3, py(p1), t4);
    feSq(t4, pz(p1));
    feMul(t2, px(p2), t4);
    feMul(t5, pz(p1), t4);
    feMul(t4, py(p2), t5);
    feSub(t2, t2, t1);
    feSub(t4, t4, t3);
    feSq(t7, t2);
    feMul(t6, t1, t7);
    feMul(t5, t7, t2);
    feSq(px(p1), t4);
    feSub(px(p1), px(p1), t5);
    feSub(px(p1), px(p1), t6);
    feSub(px(p1), px(p1), t6);
    feSub(t6, t6, px(p1));
    feMul(py(p1), t4, t6);
    feMul(t1, t5, t3);
    feSub(py(p1), py(p1), t1);
    feMul(t1, pz(p1), pz(p2));
    feMul(pz(p1), t1, t2);
    bytes.free(t1); bytes.free(t2); bytes.free(t3); bytes.free(t4);
    bytes.free(t5); bytes.free(t6); bytes.free(t7);
}

fn neqZero(v: ulong): ulong { return ((v | (U0 - v)) >> 63) & U1; }
fn eqVal(v: ulong, c: ulong): ulong { return neqZero(v ^ c) ^ U1; }

fn scalarMultPoint(p: ptr, x: ptr, xlen: int): void {
    let p2 = newPt(); ptCopy(p2, p); jDouble(p2);
    let p3 = newPt(); ptCopy(p3, p); jAdd(p3, p2);
    let q = newPt(); ptZero(q);
    let tt = newPt(); let uu = newPt();
    let qz: ulong = 1;
    let bi = 0;
    while (bi < xlen) {
        let byteV = bytes.read_byte(x, bi);
        let k = 6;
        while (k >= 0) {
            jDouble(q); jDouble(q);
            ptCopy(tt, p);
            ptCopy(uu, q);
            let bitsPair = ((byteV >> k) & 3) as ulong;
            let bnz = neqZero(bitsPair);
            ptCcopy(tt, p2, eqVal(bitsPair, 2));
            ptCcopy(tt, p3, eqVal(bitsPair, 3));
            jAdd(uu, tt);
            ptCcopy(q, tt, bnz & qz);
            ptCcopy(q, uu, bnz & (qz ^ U1));
            qz = qz & (bnz ^ U1);
            k = k - 2;
        }
        bi = bi + 1;
    }
    ptCopy(p, q);
    bytes.free(p2); bytes.free(p3); bytes.free(q); bytes.free(tt); bytes.free(uu);
}

fn toAffine(p: ptr, xaOut: ptr, yaOut: ptr): void {
    let zinv = newFe(); feInvert(zinv, pz(p));
    let z2 = newFe(); feSq(z2, zinv);
    let xm = newFe(); feMul(xm, px(p), z2);
    let z3 = newFe(); feMul(z3, z2, zinv);
    let ym = newFe(); feMul(ym, py(p), z3);
    fromMont(xaOut, xm);
    fromMont(yaOut, ym);
    bytes.free(zinv); bytes.free(z2); bytes.free(xm); bytes.free(z3); bytes.free(ym);
}

fn baseG(p: ptr): void {
    let gx = bytes.alloc(32);
    setHex(gx, "6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296");
    let gy = bytes.alloc(32);
    setHex(gy, "4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5");
    let t = newFe();
    feFromBE(t, gx, 0); toMont(px(p), t);
    feFromBE(t, gy, 0); toMont(py(p), t);
    feZero(t); setw(t, 0, U1); toMont(pz(p), t);
    bytes.free(gx); bytes.free(gy); bytes.free(t);
}

fn onCurve(xn: ptr, yn: ptr): bool {
    let xm = newFe(); let ym = newFe();
    toMont(xm, xn); toMont(ym, yn);
    let l = newFe(); feSq(l, ym);
    let r = newFe(); feSq(r, xm); feMul(r, r, xm);
    let t = newFe(); feAdd(t, xm, xm); feAdd(t, t, xm);
    feSub(r, r, t);
    let bm = newFe(); bMont(bm); feAdd(r, r, bm);
    let ok = feEq(l, r);
    bytes.free(xm); bytes.free(ym); bytes.free(l); bytes.free(r); bytes.free(t); bytes.free(bm);
    return ok;
}


pub fn derivePublic(outPub65: ptr, scalar32: ptr): void {
    let g = newPt(); baseG(g);
    scalarMultPoint(g, scalar32, 32);
    let xa = newFe(); let ya = newFe();
    toAffine(g, xa, ya);
    bytes.write_byte(outPub65, 0, 4);
    feToBE(outPub65, 1, xa);
    feToBE(outPub65, 33, ya);
    bytes.free(g); bytes.free(xa); bytes.free(ya);
}

pub fn ecdh(outSecret32: ptr, scalar32: ptr, peerPub65: ptr): int {
    if (bytes.read_byte(peerPub65, 0) != 4) { return 0; }
    let xn = newFe(); let yn = newFe();
    feFromBE(xn, peerPub65, 1); feFromBE(yn, peerPub65, 33);
    if (!feLtP(xn) || !feLtP(yn) || !onCurve(xn, yn)) {
        bytes.free(xn); bytes.free(yn);
        return 0;
    }
    let q = newPt();
    toMont(px(q), xn); toMont(py(q), yn);
    let one = newFe(); feZero(one); setw(one, 0, U1); toMont(pz(q), one);
    scalarMultPoint(q, scalar32, 32);
    let xa = newFe(); let ya = newFe();
    toAffine(q, xa, ya);
    feToBE(outSecret32, 0, xa);
    bytes.free(xn); bytes.free(yn); bytes.free(q); bytes.free(one);
    bytes.free(xa); bytes.free(ya);
    return 1;
}


const N0INV: ulong = 0xee00bc4f;

fn nl(i: int): ulong {
    if (i == 0) { return 0xfc632551; }
    if (i == 1) { return 0xf3b9cac2; }
    if (i == 2) { return 0xa7179e84; }
    if (i == 3) { return 0xbce6faad; }
    if (i == 6) { return U0; }
    return MASK32;
}

fn feIsZero(a: ptr): bool {
    let d: ulong = 0;
    let j = 0;
    while (j < 8) { d = d | getw(a, j); j = j + 1; }
    return d == U0;
}

fn ltN(a: ptr): bool {
    let borrow: ulong = 0;
    let j = 0;
    while (j < 8) {
        let x = getw(a, j) - nl(j) - borrow;
        borrow = (x >> 32) & U1;
        j = j + 1;
    }
    return borrow == U1;
}
fn inRangeN(a: ptr): bool { return (!feIsZero(a)) && ltN(a); }

fn nCondSub(out: ptr, t: ptr): void {
    let d = bytes.alloc(64);
    let borrow: ulong = 0;
    let j = 0;
    while (j < 8) {
        let x = getw(t, j) - nl(j) - borrow;
        setw(d, j, x & MASK32);
        borrow = (x >> 32) & U1;
        j = j + 1;
    }
    let x8 = getw(t, 8) - borrow;
    borrow = (x8 >> 32) & U1;
    let mask = U0 - (borrow ^ U1);
    j = 0;
    while (j < 8) {
        setw(out, j, (getw(d, j) & mask) | (getw(t, j) & (~mask)));
        j = j + 1;
    }
    bytes.free(d);
}

fn nAdd(out: ptr, a: ptr, b: ptr): void {
    let t = bytes.alloc(72);
    let carry: ulong = 0;
    let j = 0;
    while (j < 8) {
        let s = getw(a, j) + getw(b, j) + carry;
        setw(t, j, s & MASK32);
        carry = s >> 32;
        j = j + 1;
    }
    setw(t, 8, carry);
    nCondSub(out, t);
    bytes.free(t);
}

fn nMul(out: ptr, a: ptr, b: ptr): void {
    let t = bytes.alloc(80);
    let j = 0;
    while (j < 10) { setw(t, j, U0); j = j + 1; }
    let i = 0;
    while (i < 8) {
        let bi = getw(b, i);
        let carry: ulong = 0;
        j = 0;
        while (j < 8) {
            let s = getw(t, j) + getw(a, j) * bi + carry;
            setw(t, j, s & MASK32);
            carry = s >> 32;
            j = j + 1;
        }
        let s8 = getw(t, 8) + carry;
        setw(t, 8, s8 & MASK32);
        setw(t, 9, s8 >> 32);
        let m = (getw(t, 0) * N0INV) & MASK32;
        let c2 = (getw(t, 0) + m * nl(0)) >> 32;
        j = 1;
        while (j < 8) {
            let s = getw(t, j) + m * nl(j) + c2;
            setw(t, j - 1, s & MASK32);
            c2 = s >> 32;
            j = j + 1;
        }
        let s7 = getw(t, 8) + c2;
        setw(t, 7, s7 & MASK32);
        setw(t, 8, getw(t, 9) + (s7 >> 32));
        i = i + 1;
    }
    nCondSub(out, t);
    bytes.free(t);
}

fn toMontN(out: ptr, a: ptr): void {
    feCopy(out, a);
    let i = 0;
    while (i < 256) { nAdd(out, out, out); i = i + 1; }
}
fn fromMontN(out: ptr, x: ptr): void {
    let one = newFe(); feZero(one); setw(one, 0, U1);
    nMul(out, x, one);
    bytes.free(one);
}
fn montOneN(out: ptr): void {
    let one = newFe(); feZero(one); setw(one, 0, U1);
    toMontN(out, one);
    bytes.free(one);
}

fn modMulN(out: ptr, a: ptr, b: ptr): void {
    let aM = newFe(); toMontN(aM, a);
    nMul(out, aM, b);
    bytes.free(aM);
}

fn invModN(out: ptr, a: ptr): void {
    let aM = newFe(); toMontN(aM, a);
    let r = newFe(); montOneN(r);
    let e = bytes.alloc(32);
    setHex(e, "ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc63254f");
    let k = 255;
    while (k >= 0) {
        nMul(r, r, r);
        let bitVal = (bytes.read_byte(e, 31 - (k >> 3)) >> (k & 7)) & 1;
        if (bitVal == 1) { nMul(r, r, aM); }
        k = k - 1;
    }
    fromMontN(out, r);
    bytes.free(aM); bytes.free(r); bytes.free(e);
}

fn reduceModN(out: ptr, inp: ptr): void {
    let t = bytes.alloc(72);
    let j = 0;
    while (j < 8) { setw(t, j, getw(inp, j)); j = j + 1; }
    setw(t, 8, U0);
    nCondSub(out, t);
    bytes.free(t);
}

fn decodePointToJac(pub65: ptr, q: ptr): int {
    if (bytes.read_byte(pub65, 0) != 4) { return 0; }
    let xn = newFe(); let yn = newFe();
    feFromBE(xn, pub65, 1); feFromBE(yn, pub65, 33);
    if (!feLtP(xn) || !feLtP(yn) || !onCurve(xn, yn)) {
        bytes.free(xn); bytes.free(yn);
        return 0;
    }
    toMont(px(q), xn); toMont(py(q), yn);
    let one = newFe(); feZero(one); setw(one, 0, U1); toMont(pz(q), one);
    bytes.free(xn); bytes.free(yn); bytes.free(one);
    return 1;
}

fn jacToAffine(p: ptr, xOut: ptr, yOut: ptr): int {
    if (feIsZero(pz(p))) { return 1; }
    toAffine(p, xOut, yOut);
    return 0;
}

fn affineAdd(aInf: int, ax: ptr, ay: ptr, bInf: int, bx: ptr, by: ptr, rxOut: ptr, ryOut: ptr): int {
    if (aInf == 1) {
        if (bInf == 1) { return 1; }
        feCopy(rxOut, bx); feCopy(ryOut, by);
        return 0;
    }
    if (bInf == 1) { feCopy(rxOut, ax); feCopy(ryOut, ay); return 0; }
    let axM = newFe(); toMont(axM, ax); let ayM = newFe(); toMont(ayM, ay);
    let bxM = newFe(); toMont(bxM, bx); let byM = newFe(); toMont(byM, by);
    let lam = newFe(); let t1 = newFe(); let t2 = newFe();
    let inf = 0;
    if (feEq(axM, bxM)) {
        if (feEq(ayM, byM)) {
            feSq(t1, axM);
            feAdd(t2, t1, t1); feAdd(t1, t2, t1);
            let three = newFe(); feZero(three); setw(three, 0, 3);
            let threeM = newFe(); toMont(threeM, three);
            feSub(t1, t1, threeM);
            feAdd(t2, ayM, ayM);
            let inv = newFe(); feInvert(inv, t2);
            feMul(lam, t1, inv);
            bytes.free(three); bytes.free(threeM); bytes.free(inv);
        } else {
            inf = 1;
        }
    } else {
        feSub(t1, byM, ayM);
        feSub(t2, bxM, axM);
        let inv = newFe(); feInvert(inv, t2);
        feMul(lam, t1, inv);
        bytes.free(inv);
    }
    if (inf == 0) {
        let rxM = newFe(); let ryM = newFe();
        feSq(rxM, lam);
        feSub(rxM, rxM, axM);
        feSub(rxM, rxM, bxM);
        feSub(t1, axM, rxM);
        feMul(ryM, lam, t1);
        feSub(ryM, ryM, ayM);
        fromMont(rxOut, rxM);
        fromMont(ryOut, ryM);
        bytes.free(rxM); bytes.free(ryM);
    }
    bytes.free(axM); bytes.free(ayM); bytes.free(bxM); bytes.free(byM);
    bytes.free(lam); bytes.free(t1); bytes.free(t2);
    return inf;
}

pub fn ecdsaVerify(hash32: ptr, pub65: ptr, r32: ptr, s32: ptr): bool {
    let r = newFe(); feFromBE(r, r32, 0);
    let s = newFe(); feFromBE(s, s32, 0);
    let q = newPt();
    if (!inRangeN(r) || !inRangeN(s) || decodePointToJac(pub65, q) == 0) {
        bytes.free(r); bytes.free(s); bytes.free(q);
        return false;
    }
    let hb = newFe(); feFromBE(hb, hash32, 0);
    let e = newFe(); reduceModN(e, hb);
    let w = newFe(); invModN(w, s);
    let u1 = newFe(); modMulN(u1, e, w);
    let u2 = newFe(); modMulN(u2, r, w);
    let u1b = bytes.alloc(32); feToBE(u1b, 0, u1);
    let u2b = bytes.alloc(32); feToBE(u2b, 0, u2);

    let a = newPt(); baseG(a); scalarMultPoint(a, u1b, 32);
    scalarMultPoint(q, u2b, 32);

    let ax = newFe(); let ay = newFe(); let aInf = jacToAffine(a, ax, ay);
    let bx = newFe(); let by = newFe(); let bInf = jacToAffine(q, bx, by);
    let rx = newFe(); let ry = newFe();
    let rInf = affineAdd(aInf, ax, ay, bInf, bx, by, rx, ry);

    let ok = false;
    if (rInf == 0) {
        let v = newFe(); reduceModN(v, rx);
        ok = feEq(v, r);
        bytes.free(v);
    }
    bytes.free(r); bytes.free(s); bytes.free(q); bytes.free(hb); bytes.free(e);
    bytes.free(w); bytes.free(u1); bytes.free(u2); bytes.free(u1b); bytes.free(u2b);
    bytes.free(a); bytes.free(ax); bytes.free(ay); bytes.free(bx); bytes.free(by);
    bytes.free(rx); bytes.free(ry);
    return ok;
}

fn hmacInput(out: ptr, v: ptr, sep: int, x: ptr, h: ptr): void {
    let i = 0;
    while (i < 32) { bytes.write_byte(out, i, bytes.read_byte(v, i)); i = i + 1; }
    bytes.write_byte(out, 32, sep);
    i = 0;
    while (i < 32) { bytes.write_byte(out, 33 + i, bytes.read_byte(x, i)); i = i + 1; }
    i = 0;
    while (i < 32) { bytes.write_byte(out, 65 + i, bytes.read_byte(h, i)); i = i + 1; }
}

pub fn ecdsaSign(hash32: ptr, privKey32: ptr, rOut: ptr, sOut: ptr): int {
    let hz = newFe(); feFromBE(hz, hash32, 0);
    let z = newFe(); reduceModN(z, hz);
    let h1o = bytes.alloc(32); feToBE(h1o, 0, z);
    let dtmp = newFe(); feFromBE(dtmp, privKey32, 0);
    let d = newFe(); reduceModN(d, dtmp);

    let vv = bytes.alloc(32); let kk = bytes.alloc(32);
    let i = 0;
    while (i < 32) { bytes.write_byte(vv, i, 1); bytes.write_byte(kk, i, 0); i = i + 1; }
    let msg = bytes.alloc(97);
    hmacInput(msg, vv, 0, privKey32, h1o); hmac.hmacSha256(kk, 32, msg, 97, kk); hmac.hmacSha256(kk, 32, vv, 32, vv);
    hmacInput(msg, vv, 1, privKey32, h1o); hmac.hmacSha256(kk, 32, msg, 97, kk); hmac.hmacSha256(kk, 32, vv, 32, vv);

    let result = 0;
    let attempts = 0;
    while (result == 0 && attempts < 64) {
        hmac.hmacSha256(kk, 32, vv, 32, vv);
        let kfe = newFe(); feFromBE(kfe, vv, 0);
        if (inRangeN(kfe)) {
            let g = newPt(); baseG(g); scalarMultPoint(g, vv, 32);
            let xa = newFe(); let ya = newFe(); toAffine(g, xa, ya);
            let r = newFe(); reduceModN(r, xa);
            if (!feIsZero(r)) {
                let rd = newFe(); modMulN(rd, r, d);
                let zrd = newFe(); nAdd(zrd, z, rd);
                let kinv = newFe(); invModN(kinv, kfe);
                let s = newFe(); modMulN(s, kinv, zrd);
                if (!feIsZero(s)) {
                    feToBE(rOut, 0, r);
                    feToBE(sOut, 0, s);
                    result = 1;
                }
                bytes.free(rd); bytes.free(zrd); bytes.free(kinv); bytes.free(s);
            }
            bytes.free(g); bytes.free(xa); bytes.free(ya); bytes.free(r);
        }
        bytes.free(kfe);
        if (result == 0) {
            let m2 = bytes.alloc(33);
            i = 0;
            while (i < 32) { bytes.write_byte(m2, i, bytes.read_byte(vv, i)); i = i + 1; }
            bytes.write_byte(m2, 32, 0);
            hmac.hmacSha256(kk, 32, m2, 33, kk);
            hmac.hmacSha256(kk, 32, vv, 32, vv);
            bytes.free(m2);
        }
        attempts = attempts + 1;
    }
    bytes.free(hz); bytes.free(z); bytes.free(h1o); bytes.free(dtmp); bytes.free(d);
    bytes.free(vv); bytes.free(kk); bytes.free(msg);
    return result;
}
