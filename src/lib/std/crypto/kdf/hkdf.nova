// HKDF (RFC 5869) and the TLS 1.3 HKDF-Expand-Label / Derive-Secret helpers (RFC 8446 section 7.1),
// implemented in Nova over the Nova HMAC. This is the TLS 1.3 key schedule's core; it is pure
// composition over HMAC, so nothing here is timing-sensitive beyond the hash. Parameterized by hash
// via a kind selector (SHA-256 or SHA-384), the two hashes the TLS 1.3 cipher suites use.
import bytes;
import crypto.mac.hmac;

pub const SHA256: int = 0;
pub const SHA384: int = 1;

// Digest length of the selected hash.
pub fn hashLen(kind: int): int {
    return if (kind == SHA384) 48 else 32;
}

// HMAC of the selected hash: HMAC-SHA256 (32-byte out) or HMAC-SHA384 (48-byte out).
fn mac(kind: int, key: ptr, keyLen: int, msg: ptr, msgLen: int, out: ptr): void {
    if (kind == SHA384) {
        hmac.hmacSha384(key, keyLen, msg, msgLen, out);
    } else {
        hmac.hmacSha256(key, keyLen, msg, msgLen, out);
    }
}

// HKDF-Extract: PRK = HMAC(salt, IKM). Writes hashLen(kind) bytes to prkOut.
pub fn extract(kind: int, salt: ptr, saltLen: int, ikm: ptr, ikmLen: int, prkOut: ptr): void {
    mac(kind, salt, saltLen, ikm, ikmLen, prkOut);
}

// HKDF-Expand: expand PRK to L bytes of output keying material into out.
pub fn expand(kind: int, prk: ptr, prkLen: int, info: ptr, infoLen: int, out: ptr, l: int): void {
    let hl = hashLen(kind);
    let t = bytes.alloc(hl);       // T(i-1), empty on the first round (tlen = 0)
    let tlen = 0;
    let tmp = bytes.alloc(hl);     // T(i)
    let buf = bytes.alloc(hl + infoLen + 1);
    let done = 0;
    let counter = 1;
    while (done < l) {
        let p = 0;
        let i = 0;
        while (i < tlen) { bytes.write_byte(buf, p, bytes.read_byte(t, i)); p = p + 1; i = i + 1; }
        i = 0;
        while (i < infoLen) { bytes.write_byte(buf, p, bytes.read_byte(info, i)); p = p + 1; i = i + 1; }
        bytes.write_byte(buf, p, counter);
        p = p + 1;
        mac(kind, prk, prkLen, buf, p, tmp);
        i = 0;
        while (i < hl) { bytes.write_byte(t, i, bytes.read_byte(tmp, i)); i = i + 1; }
        tlen = hl;
        let n = if (l - done < hl) (l - done) else hl;
        i = 0;
        while (i < n) { bytes.write_byte(out, done + i, bytes.read_byte(tmp, i)); i = i + 1; }
        done = done + n;
        counter = counter + 1;
    }
    bytes.free(t);
    bytes.free(tmp);
    bytes.free(buf);
}

// HKDF-Expand-Label (RFC 8446 section 7.1). `label` is the short label without the "tls13 " prefix,
// which this adds. HkdfLabel = uint16 length, opaque label<7..255> = "tls13 " + label,
// opaque context<0..255> = context. Writes l bytes to out.
pub fn expandLabel(kind: int, secret: ptr, secretLen: int, label: ptr, labelLen: int,
                   context: ptr, contextLen: int, out: ptr, l: int): void {
    let fullLabelLen = 6 + labelLen;
    let info = bytes.alloc(2 + 1 + fullLabelLen + 1 + contextLen);
    let p = 0;
    // uint16 length, big-endian.
    bytes.write_byte(info, p, (l >> 8) & 0xff);
    p = p + 1;
    bytes.write_byte(info, p, l & 0xff);
    p = p + 1;
    // opaque label: one length byte then "tls13 " + label.
    bytes.write_byte(info, p, fullLabelLen);
    p = p + 1;
    bytes.write_byte(info, p, 116); p = p + 1;  // 't'
    bytes.write_byte(info, p, 108); p = p + 1;  // 'l'
    bytes.write_byte(info, p, 115); p = p + 1;  // 's'
    bytes.write_byte(info, p, 49); p = p + 1;   // '1'
    bytes.write_byte(info, p, 51); p = p + 1;   // '3'
    bytes.write_byte(info, p, 32); p = p + 1;   // ' '
    let i = 0;
    while (i < labelLen) { bytes.write_byte(info, p, bytes.read_byte(label, i)); p = p + 1; i = i + 1; }
    // opaque context: one length byte then the context.
    bytes.write_byte(info, p, contextLen);
    p = p + 1;
    i = 0;
    while (i < contextLen) { bytes.write_byte(info, p, bytes.read_byte(context, i)); p = p + 1; i = i + 1; }

    expand(kind, secret, secretLen, info, p, out, l);
    bytes.free(info);
}

// Derive-Secret(Secret, Label, Messages) = HKDF-Expand-Label(Secret, Label, Transcript-Hash(Messages),
// Hash.length). The caller passes the already-computed transcript hash as `transcriptHash`. Writes
// hashLen(kind) bytes to out.
pub fn deriveSecret(kind: int, secret: ptr, secretLen: int, label: ptr, labelLen: int,
                    transcriptHash: ptr, out: ptr): void {
    let hl = hashLen(kind);
    expandLabel(kind, secret, secretLen, label, labelLen, transcriptHash, hl, out, hl);
}
