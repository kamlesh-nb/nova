
import bytes;
import list;
import string;
import assert;

fn widthOfLead(b0: int): int {
    if (b0 < 128) { return 1; }
    if (b0 < 192) { return 1; }
    if (b0 < 224) { return 2; }
    if (b0 < 240) { return 3; }
    if (b0 < 248) { return 4; }
    return 1;
}

pub fn codepointAt(s: string, i: int): int {
    let b0 = bytes.read_byte(s, i);
    if (b0 < 128) { return b0; }
    if (b0 < 224) {
        let b1 = bytes.read_byte(s, i + 1);
        return ((b0 & 31) << 6) | (b1 & 63);
    }
    if (b0 < 240) {
        let b1 = bytes.read_byte(s, i + 1);
        let b2 = bytes.read_byte(s, i + 2);
        return ((b0 & 15) << 12) | ((b1 & 63) << 6) | (b2 & 63);
    }
    let b1 = bytes.read_byte(s, i + 1);
    let b2 = bytes.read_byte(s, i + 2);
    let b3 = bytes.read_byte(s, i + 3);
    return ((b0 & 7) << 18) | ((b1 & 63) << 12) | ((b2 & 63) << 6) | (b3 & 63);
}

pub fn widthAt(s: string, i: int): int {
    return widthOfLead(bytes.read_byte(s, i));
}

pub fn codepointCount(s: string): int {
    let n = s.length;
    let i = 0;
    let count = 0;
    while (i < n) {
        i = i + widthOfLead(bytes.read_byte(s, i));
        count = count + 1;
    }
    return count;
}

pub fn fromCodepoint(cp: int): string {
    if (cp < 128) {
        let p = bytes.alloc(1);
        bytes.write_byte(p, 0, cp);
        return p as string;
    }
    if (cp < 2048) {
        let p = bytes.alloc(2);
        bytes.write_byte(p, 0, 192 | (cp >> 6));
        bytes.write_byte(p, 1, 128 | (cp & 63));
        return p as string;
    }
    if (cp < 65536) {
        let p = bytes.alloc(3);
        bytes.write_byte(p, 0, 224 | (cp >> 12));
        bytes.write_byte(p, 1, 128 | ((cp >> 6) & 63));
        bytes.write_byte(p, 2, 128 | (cp & 63));
        return p as string;
    }
    let p = bytes.alloc(4);
    bytes.write_byte(p, 0, 240 | (cp >> 18));
    bytes.write_byte(p, 1, 128 | ((cp >> 12) & 63));
    bytes.write_byte(p, 2, 128 | ((cp >> 6) & 63));
    bytes.write_byte(p, 3, 128 | (cp & 63));
    return p as string;
}

pub fn chars(s: string): list.List<string> {
    let result = list.List<string>();
    let n = s.length;
    let i = 0;
    while (i < n) {
        let w = widthOfLead(bytes.read_byte(s, i));
        result.push(string.slice(s, i, i + w));
        i = i + w;
    }
    return result;
}

pub fn isValid(s: string): bool {
    let n = s.length;
    let i = 0;
    while (i < n) {
        let b0 = bytes.read_byte(s, i);
        let w = 0;
        if (b0 < 128) { w = 1; }
        else if (b0 < 192) { return false; }
        else if (b0 < 224) { w = 2; }
        else if (b0 < 240) { w = 3; }
        else if (b0 < 248) { w = 4; }
        else { return false; }
        if (i + w > n) { return false; }
        let j = 1;
        while (j < w) {
            let bj = bytes.read_byte(s, i + j);
            if (bj < 128 || bj >= 192) { return false; }
            j = j + 1;
        }
        i = i + w;
    }
    return true;
}

@test
fn test_codepoint_count_vs_bytes(): void {

    let s = "héllo wörld";
    assert.equalInt(codepointCount(s), 11);
    assert.equalInt(s.length, 13);
}

@test
fn test_codepoint_at_and_roundtrip(): void {
    let s = "aé€";
    assert.equalInt(codepointAt(s, 0), 97);
    assert.equalInt(codepointAt(s, 1), 233);
    assert.equalInt(codepointAt(s, 3), 8364);
    assert.equalStr(fromCodepoint(97), "a");
    assert.equalStr(fromCodepoint(233), "é");
    assert.equalStr(fromCodepoint(8364), "€");
}

@test
fn test_chars_iteration(): void {
    let cs = chars("aé€");
    assert.equalInt(cs.len, 3);
    assert.equalStr(cs.get(0), "a");
    assert.equalStr(cs.get(1), "é");
    assert.equalStr(cs.get(2), "€");
}

@test
fn test_validation(): void {
    assert.isTrue(isValid("héllo"));
    assert.isTrue(isValid(""));

    let bad = bytes.alloc(1);
    bytes.write_byte(bad, 0, 128);
    assert.isFalse(isValid(bad as string));
    bytes.free(bad);
}
