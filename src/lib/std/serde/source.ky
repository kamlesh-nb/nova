//! A uniform, format-agnostic way to read typed values out of request-shaped data.
//!
//! `ValueSource` gives callers (route handlers, ORM binders, config loaders) one interface
//! for pulling strings, numbers, booleans, decimals, and nested/array values out of a
//! document, regardless of whether that document arrived as JSON, YAML, or route/query
//! parameters. `JsonSource` and `YamlSource` wrap the respective `serde.json`/`serde.yaml`
//! trees; `ParamSource` wraps a flat `Map<string, string>` (route params, query strings);
//! `CompositeSource` layers a `ParamSource` in front of a body `ValueSource` so route
//! parameters take precedence over the request body for the same key. `ValueSink` is the
//! mirror-image write side for building an output document field by field.

import serde.json;
import serde.yaml;
import string;
import str;
import list;
import map;

/// Read-only, format-agnostic access to a document's fields by key, including nested
/// objects and arrays.
///
/// Every getter is total: a missing key or a value of the wrong shape returns a zero
/// value for the type (empty string, `0`, `false`, `0.0`, `0m`) rather than failing, so
/// callers do not need to check `has` before every read. Use `has` only when presence
/// itself is meaningful.
pub trait ValueSource {
    /// Field value as a `string`, or `""` if the key is absent or not string-like.
    fn getString(self: ValueSource, key: string): string;
    /// Field value as a borrowed `Str` view; see `getString` for the fallback rule.
    fn getStr(self: ValueSource, key: string): str.Str;
    /// Field value as a `long`, or `0` if the key is absent or not numeric.
    fn getInt(self: ValueSource, key: string): long;
    /// Field value as a `bool`, or `false` if the key is absent or not boolean.
    fn getBool(self: ValueSource, key: string): bool;
    /// Field value as a `double`, or `0.0` if the key is absent or not numeric.
    fn getFloat(self: ValueSource, key: string): double;
    /// Field value as a `decimal`, or `0m` if the key is absent or not numeric.
    fn getDecimal(self: ValueSource, key: string): decimal;
    /// Nested object at `key` as another `ValueSource` of the same underlying format.
    fn getChild(self: ValueSource, key: string): ValueSource;
    /// Whether `key` is present in the document (format-specific "present" rule).
    fn has(self: ValueSource, key: string): bool;
    /// Number of elements in the array at `key`, or `0` if absent or not an array.
    fn arrayLen(self: ValueSource, key: string): int;
    /// String value at index `i` of the array at `key`.
    fn itemString(self: ValueSource, key: string, i: int): string;
    /// Integer value at index `i` of the array at `key`.
    fn itemInt(self: ValueSource, key: string, i: int): long;
    /// Decimal value at index `i` of the array at `key`.
    fn itemDecimal(self: ValueSource, key: string, i: int): decimal;
    /// Nested object at index `i` of the array at `key`, as another `ValueSource`.
    fn itemChild(self: ValueSource, key: string, i: int): ValueSource;
}

/// Write-only, format-agnostic interface for building an output document field by field.
pub trait ValueSink {
    /// Sets a string field.
    fn putString(self: ValueSink, key: string, val: string): void;
    /// Sets an integer field.
    fn putInt(self: ValueSink, key: string, val: long): void;
    /// Sets a boolean field.
    fn putBool(self: ValueSink, key: string, val: bool): void;
    /// Sets a floating-point field.
    fn putFloat(self: ValueSink, key: string, val: double): void;
    /// Sets a decimal field.
    fn putDecimal(self: ValueSink, key: string, val: decimal): void;
}

/// `ValueSource` backed by a parsed `serde.json.JsonValue` tree.
pub struct JsonSource impl ValueSource {
    /// The wrapped JSON node this source reads from.
    pub node: json.JsonValue,

    init(node: json.JsonValue) { self.node = node; }

    pub fn getString(self: JsonSource, key: string): string {
        return json.asString(json.get(self.node, key)) ?? "";
    }
    pub fn getStr(self: JsonSource, key: string): str.Str {
        return str.of(self.getString(key));
    }
    pub fn getInt(self: JsonSource, key: string): long {
        return json.asNumber(json.get(self.node, key)) ?? 0;
    }
    pub fn getBool(self: JsonSource, key: string): bool {
        return json.asBool(json.get(self.node, key)) ?? false;
    }
    pub fn getFloat(self: JsonSource, key: string): double {
        return json.asFloat(json.get(self.node, key)) ?? 0.0;
    }
    pub fn getDecimal(self: JsonSource, key: string): decimal {
        return json.asDecimal(json.get(self.node, key)) ?? 0m;
    }
    pub fn getChild(self: JsonSource, key: string): ValueSource {
        return JsonSource(json.get(self.node, key));
    }
    pub fn has(self: JsonSource, key: string): bool {
        return json.has(self.node, key);
    }
    pub fn arrayLen(self: JsonSource, key: string): int {
        return json.size(json.get(self.node, key));
    }
    pub fn itemString(self: JsonSource, key: string, i: int): string {
        return json.asString(json.at(json.get(self.node, key), i)) ?? "";
    }
    pub fn itemInt(self: JsonSource, key: string, i: int): long {
        return json.asNumber(json.at(json.get(self.node, key), i)) ?? 0;
    }
    pub fn itemDecimal(self: JsonSource, key: string, i: int): decimal {
        return json.asDecimal(json.at(json.get(self.node, key), i)) ?? 0m;
    }
    pub fn itemChild(self: JsonSource, key: string, i: int): ValueSource {
        return JsonSource(json.at(json.get(self.node, key), i));
    }
}

/// Parses `body` as JSON and wraps the result in a `JsonSource`.
pub fn fromJson(body: string): JsonSource {
    return JsonSource(json.parse(body));
}

/// `ValueSource` backed by a parsed `serde.yaml.YamlValue` tree.
pub struct YamlSource impl ValueSource {
    /// The wrapped YAML node this source reads from.
    pub node: yaml.YamlValue,

    init(node: yaml.YamlValue) { self.node = node; }

    pub fn getString(self: YamlSource, key: string): string {
        return yaml.asString(yaml.get(self.node, key)) ?? "";
    }
    pub fn getStr(self: YamlSource, key: string): str.Str {
        return str.of(self.getString(key));
    }
    pub fn getInt(self: YamlSource, key: string): long {
        let v = yaml.get(self.node, key);
        let n = yaml.asNumber(v);
        if (n != undefined) { return n; }
        let d = yaml.asDecimal(v);
        if (d != undefined) { return string.parseI64(`${d}`); }
        return 0;
    }
    pub fn getBool(self: YamlSource, key: string): bool {
        return yaml.asBool(yaml.get(self.node, key)) ?? false;
    }
    pub fn getFloat(self: YamlSource, key: string): double {
        let v = yaml.get(self.node, key);
        let n = yaml.asNumber(v);
        if (n != undefined) { return string.parseFloat(`${n}`); }
        let d = yaml.asDecimal(v);
        if (d != undefined) { return string.parseFloat(`${d}`); }
        return 0.0;
    }
    pub fn getDecimal(self: YamlSource, key: string): decimal {
        let v = yaml.get(self.node, key);
        let d = yaml.asDecimal(v);
        if (d != undefined) { return d; }
        let n = yaml.asNumber(v);
        if (n != undefined) { return decimal.fromString(`${n}`); }
        return 0m;
    }
    pub fn getChild(self: YamlSource, key: string): ValueSource {
        return YamlSource(yaml.get(self.node, key));
    }
    pub fn has(self: YamlSource, key: string): bool {
        return !yaml.isNull(yaml.get(self.node, key));
    }
    pub fn arrayLen(self: YamlSource, key: string): int {
        let a = yaml.asArray(yaml.get(self.node, key));
        if (a == undefined) { return 0; }
        return a.size();
    }
    pub fn itemString(self: YamlSource, key: string, i: int): string {
        return yaml.asString(yaml.at(yaml.get(self.node, key), i)) ?? "";
    }
    pub fn itemInt(self: YamlSource, key: string, i: int): long {
        let v = yaml.at(yaml.get(self.node, key), i);
        let n = yaml.asNumber(v);
        if (n != undefined) { return n; }
        let d = yaml.asDecimal(v);
        if (d != undefined) { return string.parseI64(`${d}`); }
        return 0;
    }
    pub fn itemDecimal(self: YamlSource, key: string, i: int): decimal {
        let v = yaml.at(yaml.get(self.node, key), i);
        let d = yaml.asDecimal(v);
        if (d != undefined) { return d; }
        let n = yaml.asNumber(v);
        if (n != undefined) { return decimal.fromString(`${n}`); }
        return 0m;
    }
    pub fn itemChild(self: YamlSource, key: string, i: int): ValueSource {
        return YamlSource(yaml.at(yaml.get(self.node, key), i));
    }
}

/// Parses `body` as YAML and wraps the result in a `YamlSource`.
pub fn fromYaml(body: string): YamlSource {
    return YamlSource(yaml.parse(body));
}

/// `ValueSource` backed by a flat string-to-string map, typically route or query
/// parameters.
///
/// There is no nested structure here: `getChild`/`itemChild` return an empty
/// `ParamSource`, and `arrayLen`/`itemString`/`itemInt`/`itemDecimal` all report "no
/// array" (`0` / `""`), since a flat param map has no array shape to expose.
pub struct ParamSource impl ValueSource {
    /// The underlying key-to-value map this source reads from.
    pub params: Map<string, string>,

    init(params: Map<string, string>) { self.params = params; }

    pub fn getString(self: ParamSource, key: string): string {
        return self.params.get(key) ?? "";
    }
    pub fn getStr(self: ParamSource, key: string): str.Str {
        return str.of(self.getString(key));
    }
    pub fn getInt(self: ParamSource, key: string): long {
        return string.parseI64(self.params.get(key) ?? "0");
    }
    pub fn getBool(self: ParamSource, key: string): bool {
        return string.eql(self.params.get(key) ?? "", "true");
    }
    pub fn getFloat(self: ParamSource, key: string): double {
        return string.parseFloat(self.params.get(key) ?? "0");
    }
    pub fn getDecimal(self: ParamSource, key: string): decimal {
        return decimal.fromString(self.params.get(key) ?? "0");
    }
    pub fn getChild(self: ParamSource, key: string): ValueSource {
        return ParamSource(Map<string, string>(2, string.hash));
    }
    pub fn has(self: ParamSource, key: string): bool {
        let r = self.params.get(key);
        if (r == undefined) { return false; }
        return true;
    }
    pub fn arrayLen(self: ParamSource, key: string): int { return 0; }
    pub fn itemString(self: ParamSource, key: string, i: int): string { return ""; }
    pub fn itemInt(self: ParamSource, key: string, i: int): long { return 0; }
    pub fn itemDecimal(self: ParamSource, key: string, i: int): decimal { return 0m; }
    pub fn itemChild(self: ParamSource, key: string, i: int): ValueSource {
        return ParamSource(Map<string, string>(2, string.hash));
    }
}

/// `ValueSource` that layers route/query parameters over a request body source.
///
/// Every getter checks `route` first and falls through to `body` only when `route` does
/// not have the key, so a route parameter always shadows a body field of the same name.
/// `getChild`, `arrayLen`, and the `item*` accessors delegate straight to `body`, since
/// `route` (a `ParamSource`) has no nested or array structure to contribute.
pub struct CompositeSource impl ValueSource {
    /// Route or query parameters, consulted first for every key.
    pub route: ParamSource,
    /// Fallback source, typically the parsed request body.
    pub body: ValueSource,

    init(route: ParamSource, body: ValueSource) {
        self.route = route;
        self.body = body;
    }

    pub fn getString(self: CompositeSource, key: string): string {
        if (self.route.has(key)) { return self.route.getString(key); }
        return self.body.getString(key);
    }
    pub fn getStr(self: CompositeSource, key: string): str.Str {
        if (self.route.has(key)) { return self.route.getStr(key); }
        return self.body.getStr(key);
    }
    pub fn getInt(self: CompositeSource, key: string): long {
        if (self.route.has(key)) { return self.route.getInt(key); }
        return self.body.getInt(key);
    }
    pub fn getBool(self: CompositeSource, key: string): bool {
        if (self.route.has(key)) { return self.route.getBool(key); }
        return self.body.getBool(key);
    }
    pub fn getFloat(self: CompositeSource, key: string): double {
        if (self.route.has(key)) { return self.route.getFloat(key); }
        return self.body.getFloat(key);
    }
    pub fn getDecimal(self: CompositeSource, key: string): decimal {
        if (self.route.has(key)) { return self.route.getDecimal(key); }
        return self.body.getDecimal(key);
    }

    pub fn getChild(self: CompositeSource, key: string): ValueSource {
        return self.body.getChild(key);
    }
    pub fn has(self: CompositeSource, key: string): bool {
        if (self.route.has(key)) { return true; }
        return self.body.has(key);
    }
    pub fn arrayLen(self: CompositeSource, key: string): int {
        return self.body.arrayLen(key);
    }
    pub fn itemString(self: CompositeSource, key: string, i: int): string {
        return self.body.itemString(key, i);
    }
    pub fn itemInt(self: CompositeSource, key: string, i: int): long {
        return self.body.itemInt(key, i);
    }
    pub fn itemDecimal(self: CompositeSource, key: string, i: int): decimal {
        return self.body.itemDecimal(key, i);
    }
    pub fn itemChild(self: CompositeSource, key: string, i: int): ValueSource {
        return self.body.itemChild(key, i);
    }
}
