//! Gzip container helpers (RFC 1952) over the DEFLATE codec.
//!
//! This file is the thin, user-facing face of gzip compression in the standard
//! library. It does not implement any compression itself: the real work, the
//! DEFLATE bit-stream plus the gzip header, footer, and CRC32 trailer, lives in
//! `compress.deflate`. This module exists only to give callers a small, stable
//! two-function surface (`compress` / `decompress`) that reads naturally at the
//! call site and hides which internal entry points do the encoding.
//!
//! WHY it is separate from `deflate`: gzip and raw DEFLATE are different wire
//! formats. Raw DEFLATE is just the compressed blocks with no framing. Gzip
//! wraps those blocks in a 10-byte header (magic bytes `1f 8b`, method, flags,
//! mtime, and so on) and an 8-byte footer holding the CRC32 and the original
//! length. Keeping the gzip framing behind its own module lets a caller pick the
//! format explicitly by choosing the module, rather than by passing a flag, and
//! keeps `deflate` free to expose the lower-level primitives.
//!
//! Both functions move whole payloads through Kyte `string` values, which in
//! this codebase are length-prefixed byte buffers rather than NUL-terminated C
//! strings, so binary data and embedded NUL bytes round-trip correctly. There is
//! no streaming API here; the entire input and output live in memory at once,
//! which suits the request-scoped, in-memory payloads this is aimed at (HTTP
//! bodies, small files). For anything that must stream, drop down to the
//! `compress.deflate` primitives directly.

import assert;
import compress.deflate;


/// Compresses a whole byte buffer into the gzip container format (RFC 1952).
///
/// Delegates to [`deflate.gzipCompress`], which emits the 10-byte gzip header,
/// the DEFLATE-compressed blocks, and the 8-byte CRC32 plus length footer, all
/// in one call. The returned `string` is a binary buffer, not text: treat it as
/// opaque bytes and do not assume it is printable or NUL-free. Feed the result
/// back through [`decompress`] to recover the original bytes exactly. Note that
/// for very small or incompressible inputs the gzip framing overhead can make
/// the output LARGER than the input, so callers must not assume the result is
/// shorter.
pub fn compress(data: string): string {
    return deflate.gzipCompress(data);
}

/// Decompresses a gzip container back into the original byte buffer.
///
/// Delegates to [`deflate.gunzip`], which parses the gzip header, inflates the
/// DEFLATE blocks, and (in a conforming implementation) checks the trailing
/// CRC32 and length against the recovered bytes. This is the exact inverse of
/// [`compress`]: `decompress(compress(x))` returns `x` byte for byte, including
/// tabs, newlines, and any embedded NUL bytes. By convention here an empty input
/// decompresses to the empty string, so a caller can pass through a value that
/// may be absent without special-casing it.
pub fn decompress(data: string): string {
    return deflate.gunzip(data);
}

/// Round-trip check: a repetitive string compresses smaller and inflates back
/// to exactly the original.
///
/// The repeated `"Hello, Kyte!"` text is deliberately compressible, so this both
/// asserts loss-free recovery (`back == original`) and confirms that gzip
/// actually shrank a redundant payload (`packed.length < original.length`),
/// which would not hold for an incompressible input.
@test
fn test_gzip_roundtrip(): void {
    let original = "Hello, Kyte! Hello, Kyte! Hello, Kyte! Hello, Kyte!";
    let packed = compress(original);

    assert.isTrue(packed.length > 0);
    assert.isTrue(packed.length < original.length);
    let back = decompress(packed);
    assert.equalStr(back, original);
}

/// Edge cases: the empty input and a small buffer carrying control bytes.
///
/// Guards two behaviours the [`decompress`] contract promises: an empty input
/// decompresses to the empty string, and a payload containing tab, newline, and
/// space bytes survives a `compress` then `decompress` round trip unchanged,
/// confirming the path is byte-transparent rather than text-oriented.
@test
fn test_gzip_empty_and_binary(): void {
    assert.equalStr(decompress(""), "");

    let s = "a\tb\nc  d";
    assert.equalStr(decompress(compress(s)), s);
}
