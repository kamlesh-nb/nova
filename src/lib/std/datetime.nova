//! Calendar and clock helpers built on Unix timestamps.
//!
//! A "timestamp" throughout this file is a `long` count of seconds since the
//! Unix epoch (1970-01-01T00:00:00 UTC), treated as wall clock in UTC unless a
//! caller applies its own offset. There is no separate `DateTime` struct: the
//! module works directly on `long` so it stays a cheap value everywhere it is
//! passed, and provides ISO 8601 parsing/formatting, `strftime`-style custom
//! formatting, calendar arithmetic (`isLeapYear`, `daysInMonth`, `addDays`
//! and friends), and a `Duration` breakdown for the gap between two
//! timestamps.
//!
//! The date maths (`dateToTimestamp` / `timestampToDate`) is a plain
//! proleptic Gregorian calculation done by counting whole years and months,
//! it does not consult the host's C library or any timezone database, so the
//! only timezone it understands is a fixed UTC offset in seconds supplied by
//! the caller (see `tzOffsetSeconds`, `fromIsoUtc`, `formatOffset`).

import bytes;
import string;
import assert;

/// Number of seconds in one minute, as a `long` so it composes directly with timestamp arithmetic.
const SECONDS_PER_MINUTE: long = 60;
const MINUTES_PER_HOUR: long = 60;
const HOURS_PER_DAY: long = 24;
const SECONDS_PER_HOUR = SECONDS_PER_MINUTE * MINUTES_PER_HOUR;
const SECONDS_PER_DAY = SECONDS_PER_HOUR * HOURS_PER_DAY;

// Days per month for a non-leap year, indexed 0 (January) to 11 (December).
const MONTH_DAYS: int[12] = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];

/// A breakdown of an elapsed span into days, hours, minutes and seconds.
///
/// Produced by `dateDiff`. The fields are the non-negative components of the
/// gap between two timestamps; they are not independently clamped, so
/// `hours` is always in 0..23, `minutes` and `seconds` in 0..59.
pub struct Duration {
    /// Whole days in the span.
    pub days: int,
    /// Remaining whole hours after `days` is removed.
    pub hours: int,
    /// Remaining whole minutes after `days` and `hours` are removed.
    pub minutes: int,
    /// Remaining whole seconds after `days`, `hours` and `minutes` are removed.
    pub seconds: int,
}

/// Reports whether `year` is a Gregorian leap year (divisible by 4, except centuries not divisible by 400).
pub fn isLeapYear(year: int): bool {
    if (year % 400 == 0) {
        return true;
    }
    if (year % 100 == 0) {
        return false;
    }
    return (year % 4 == 0);
}

/// Number of days in `month` (1..12) of `year`, accounting for February in leap years.
///
/// Returns 0 for an out-of-range month rather than erroring.
pub fn daysInMonth(year: int, month: int): int {
    if (month < 1 || month > 12) {
        return 0;
    }
    let dim = MONTH_DAYS[month - 1];
    if (month == 2 && isLeapYear(year)) {
        dim = 29;
    }
    return dim;
}

/// The current wall-clock time as a Unix timestamp (whole seconds since the epoch).
pub fn now(): long {
    return nowNs() / 1000000000;
}

/// The current wall-clock time as nanoseconds since the Unix epoch, sourced from the host runtime clock.
pub fn nowNs(): long {
    return nova_time_now_ns();
}

/// Parses an ISO 8601-ish date or date-time string into a timestamp; returns `undefined` if `s` is malformed.
pub fn parse(s: string): long | undefined {
    return parseIso(s);
}

/// Alias for `parse`: parses an ISO 8601-ish string into a timestamp.
pub fn fromIso(s: string): long | undefined {
    return parseIso(s);
}

// Parses "YYYY-MM-DD" optionally followed by a 'T' or space and "HH:MM:SS".
// The wall clock is taken literally, with no timezone applied. Returns
// `undefined` on any structural or range violation.
fn parseIso(s: string): long | undefined {
    let len = s.length;
    if (len < 10) {
        return undefined;
    }

    let year = parseIntRange(s, 0, 4);
    if (year == undefined) return undefined;
    if (s[4] != 45 && s[4] != 45) {

        if (s[4] != 45) return undefined;
    }
    let month = parseIntRange(s, 5, 7);
    if (month == undefined) return undefined;
    let day = parseIntRange(s, 8, 10);
    if (day == undefined) return undefined;

    if (month < 1 || month > 12) return undefined;
    let dim = daysInMonth(year, month);
    if (day < 1 || day > dim) return undefined;

    let hour: int = 0;
    let minute: int = 0;
    let second: int = 0;

    if (len >= 11) {
        let sep = s[10];
        if (sep == 'T' || sep == 32) {
            if (len < 19) {

            } else {
                hour = parseIntRange(s, 11, 13) ?? 0;
                minute = parseIntRange(s, 14, 16) ?? 0;
                second = parseIntRange(s, 17, 19) ?? 0;

                if (hour < 0 || hour > 23) return undefined;
                if (minute < 0 || minute > 59) return undefined;
                if (second < 0 || second > 59) return undefined;
            }
        }

    }

    let timestamp = dateToTimestamp(year, month, day, hour, minute, second);
    return timestamp;
}

// Parses digits of s[start..end) as an unsigned integer; returns undefined on an empty or non-digit range.
fn parseIntRange(s: string, start: int, end: int): int | undefined {
    if (start < 0 || end > s.length || start >= end) {
        return undefined;
    }
    let res = 0;
    let i = start;
    while (i < end) {
        let c = s[i];
        if (c < 48 || c > 57) {
            return undefined;
        }
        res = res * 10 + (c - 48);
        i = i + 1;
    }
    return res;
}

// Converts a calendar date and time of day to a Unix timestamp by summing whole years, whole months, and the remaining day/time.
fn dateToTimestamp(year: int, month: int, day: int, hour: int, minute: int, second: int): long {

    let days: long = 0;
    let y = 1970;
    while (y < year) {
        days = days + 365 + (if isLeapYear(y) then 1 else 0);
        y = y + 1;
    }
    let m = 1;
    while (m < month) {
        days = days + daysInMonth(year, m);
        m = m + 1;
    }
    days = days + (day - 1);
    return days * SECONDS_PER_DAY + (hour as long) * SECONDS_PER_HOUR + (minute as long) * SECONDS_PER_MINUTE + (second as long);
}

/// Formats timestamp `t` (treated as UTC wall clock) according to `fmt`.
///
/// Supports two token styles mixed in the same string: `%`-prefixed
/// (`%Y %m %d %H %M %S %%`), and bare-letter run-length tokens (`Y`/`YYYY`
/// four-digit year, `YY` two-digit year, `M`/`MM` month, `D`/`DD` day,
/// `h`/`hh` hour, `m`/`mm` minute, `s`/`ss` second, `TZD` literal `Z`). Any
/// other character is copied through unchanged. See `toIso` for the
/// canonical ISO 8601 pattern.
pub fn format(t: long, fmt: string): string {
    let (year, month, day, hour, minute, second) = timestampToDate(t);

    let result = bytes.alloc(fmt.length * 4 + 1);
    let offset = 0;
    let i = 0;
    while (i < fmt.length) {
        let c = fmt[i];
        if (c == '%') {
            if (i + 1 < fmt.length) {
                let next_c = fmt[i+1];
                if (next_c == 'Y') {
                    offset = offset + writeNumber(result, offset, year, 4);
                    i = i + 2;
                    continue;
                }
                if (next_c == 'm') {
                    offset = offset + writeNumber(result, offset, month, 2);
                    i = i + 2;
                    continue;
                }
                if (next_c == 'd') {
                    offset = offset + writeNumber(result, offset, day, 2);
                    i = i + 2;
                    continue;
                }
                if (next_c == 'H') {
                    offset = offset + writeNumber(result, offset, hour, 2);
                    i = i + 2;
                    continue;
                }
                if (next_c == 'M') {
                    offset = offset + writeNumber(result, offset, minute, 2);
                    i = i + 2;
                    continue;
                }
                if (next_c == 'S') {
                    offset = offset + writeNumber(result, offset, second, 2);
                    i = i + 2;
                    continue;
                }
                if (next_c == '%') {
                    bytes.write_byte(result, offset, 37);
                    offset = offset + 1;
                    i = i + 2;
                    continue;
                }
            }
        }
        if (c == 'Y') {

            if (i + 3 < fmt.length && fmt[i+1] == 'Y' && fmt[i+2] == 'Y' && fmt[i+3] == 'Y') {
                offset = offset + writeNumber(result, offset, year, 4);
                i = i + 4;
                continue;
            }
            if (i + 1 < fmt.length && fmt[i+1] == 'Y') {
                offset = offset + writeNumber(result, offset, year % 100, 2);
                i = i + 2;
                continue;
            }
        }
        if (c == 'M') {

            if (i + 1 < fmt.length && fmt[i+1] == 'M') {
                offset = offset + writeNumber(result, offset, month, 2);
                i = i + 2;
                continue;
            } else {
                offset = offset + writeNumber(result, offset, month, 0);
                i = i + 1;
                continue;
            }
        }
        if (c == 'D') {
            if (i + 1 < fmt.length && fmt[i+1] == 'D') {
                offset = offset + writeNumber(result, offset, day, 2);
                i = i + 2;
                continue;
            } else {
                offset = offset + writeNumber(result, offset, day, 0);
                i = i + 1;
                continue;
            }
        }
        if (c == 'h') {
            if (i + 1 < fmt.length && fmt[i+1] == 'h') {
                offset = offset + writeNumber(result, offset, hour, 2);
                i = i + 2;
                continue;
            } else {
                offset = offset + writeNumber(result, offset, hour, 0);
                i = i + 1;
                continue;
            }
        }
        if (c == 'm') {
            if (i + 1 < fmt.length && fmt[i+1] == 'm') {
                offset = offset + writeNumber(result, offset, minute, 2);
                i = i + 2;
                continue;
            } else {
                offset = offset + writeNumber(result, offset, minute, 0);
                i = i + 1;
                continue;
            }
        }
        if (c == 's') {
            if (i + 1 < fmt.length && fmt[i+1] == 's') {
                offset = offset + writeNumber(result, offset, second, 2);
                i = i + 2;
                continue;
            } else {
                offset = offset + writeNumber(result, offset, second, 0);
                i = i + 1;
                continue;
            }
        }
        if (c == 'T' && i + 2 < fmt.length && fmt[i+1] == 'Z' && fmt[i+2] == 'D') {

            bytes.write_byte(result, offset, 'Z');
            offset = offset + 1;
            i = i + 3;
            continue;
        }

        bytes.write_byte(result, offset, c);
        offset = offset + 1;
        i = i + 1;
    }
    bytes.write_i32(result - 4, 0, offset);
    return result as string;
}

// Writes val as decimal digits into ptr at offset, zero-padded on the left to at least min_digits; returns the number of bytes written.
fn writeNumber(ptr: int, offset: int, val: int, min_digits: int): int {

    let temp = val;
    let digits = 0;
    if (temp == 0) {
        digits = 1;
    } else {
        while (temp > 0) {
            digits = digits + 1;
            temp = temp / 10;
        }
    }
    let pad = 0;
    if (digits < min_digits) {
        pad = min_digits - digits;
    }
    let total = digits + pad;
    let i = total - 1;
    temp = val;
    while (i >= 0) {
        if (i < pad) {
            bytes.write_byte(ptr, offset + i, 48);
        } else {
            bytes.write_byte(ptr, offset + i, (temp % 10) + 48);
            temp = temp / 10;
        }
        i = i - 1;
    }
    return total;
}

// Inverse of dateToTimestamp: decomposes a Unix timestamp into (year, month, day, hour, minute, second) by successive division and year/month walking.
fn timestampToDate(t: long): (int, int, int, int, int, int) {
    let total_sec: long = t;
    let second = (total_sec % SECONDS_PER_MINUTE) as int;
    let total_min = total_sec / SECONDS_PER_MINUTE;
    let minute = (total_min % MINUTES_PER_HOUR) as int;
    let total_hour = total_min / MINUTES_PER_HOUR;
    let hour = (total_hour % HOURS_PER_DAY) as int;
    let total_day = total_hour / HOURS_PER_DAY;

    let year = 1970;
    let days: long = total_day;
    while (true) {
        let days_in_year = 365 + (if isLeapYear(year) then 1 else 0);
        if (days < days_in_year) {
            break;
        }
        days = days - days_in_year;
        year = year + 1;
    }

    let month = 1;
    while (true) {
        let dim = daysInMonth(year, month);
        if (days < dim) {
            break;
        }
        days = days - dim;
        month = month + 1;
    }
    let day = (days + 1) as int;

    return (year, month, day, hour, minute, second);
}

/// Formats timestamp `t` as `YYYY-MM-DDThh:mm:ssZ` (ISO 8601, UTC, `Z` suffix).
pub fn toIso(t: long): string {
    return format(t, "YYYY-MM-DDThh:mm:ssTZD");
}

/// Returns `t` shifted by `days` (negative to go backwards).
pub fn addDays(t: long, days: int): long {
    return t + days * SECONDS_PER_DAY;
}

/// Returns `t` shifted by `hours` (negative to go backwards).
pub fn addHours(t: long, hours: int): long {
    return t + hours * SECONDS_PER_HOUR;
}

/// Returns `t` shifted by `minutes` (negative to go backwards).
pub fn addMinutes(t: long, minutes: int): long {
    return t + minutes * SECONDS_PER_MINUTE;
}

/// Returns `t` shifted by `seconds` (negative to go backwards).
pub fn addSeconds(t: long, seconds: int): long {
    return t + seconds;
}

/// The absolute elapsed span between `t1` and `t2`, broken down into a `Duration`.
///
/// Order does not matter: the difference is taken as an absolute value, so
/// `dateDiff(a, b)` and `dateDiff(b, a)` return the same result.
pub fn dateDiff(t1: long, t2: long): Duration {
    let total_sec = t2 - t1;
    if (total_sec < 0) {
        total_sec = -total_sec;
    }
    let days = total_sec / SECONDS_PER_DAY;
    let rem = total_sec - (days * SECONDS_PER_DAY);
    let hours = rem / SECONDS_PER_HOUR;
    rem = rem - (hours * SECONDS_PER_HOUR);
    let minutes = rem / SECONDS_PER_MINUTE;
    let seconds = rem - (minutes * SECONDS_PER_MINUTE);

    return Duration{
        days: days,
        hours: hours,
        minutes: minutes,
        seconds: seconds,
    };
}

/// Destructor for `Duration`; a no-op since all its fields are plain scalars.
pub fn delete(self: Duration): void {
}


/// Parses the trailing timezone designator of an ISO 8601 string `s` into an offset in seconds east of UTC.
///
/// Accepts a trailing `Z`/`z` (offset 0), `+HH:MM`, `+HHMM`, or `+HH` (and
/// their `-` equivalents); an absent designator also yields 0. Returns
/// `undefined` if a `+`/`-` designator is present but malformed.
pub fn tzOffsetSeconds(s: string): int | undefined {
    let len = s.length;
    if (len == 0) { return 0; }
    let last = s[len - 1];
    if (last == 'Z' || last == 'z') { return 0; }
    let i = len - 1;
    while (i >= 11) {
        let c = s[i];
        if (c == '+' || c == '-') {
            let sign = if (c == '-') 0 - 1 else 1;
            let rest = len - i - 1;
            let hh = 0;
            let mm = 0;
            if (rest == 5) {
                hh = parseIntRange(s, i + 1, i + 3) ?? -1;
                mm = parseIntRange(s, i + 4, i + 6) ?? -1;
            } else if (rest == 4) {
                hh = parseIntRange(s, i + 1, i + 3) ?? -1;
                mm = parseIntRange(s, i + 3, i + 5) ?? -1;
            } else if (rest == 2) {
                hh = parseIntRange(s, i + 1, i + 3) ?? -1;
                mm = 0;
            } else {
                return undefined;
            }
            if (hh < 0 || hh > 23 || mm < 0 || mm > 59) { return undefined; }
            return sign * ((hh * SECONDS_PER_HOUR) + (mm * SECONDS_PER_MINUTE));
        }
        i = i - 1;
    }
    return 0;
}

/// Parses an ISO 8601 string `s` (with an optional timezone designator) and returns the equivalent UTC timestamp.
///
/// Combines `parseIso` with `tzOffsetSeconds` to convert a local wall clock
/// plus offset into a true UTC instant. Returns `undefined` if either the
/// date/time or the timezone designator fails to parse.
pub fn fromIsoUtc(s: string): long | undefined {
    let wall = parseIso(s);
    if (wall == undefined) { return undefined; }
    let off = tzOffsetSeconds(s);
    if (off == undefined) { return undefined; }
    return (wall ?? 0) - (off ?? 0);
}

/// Formats UTC timestamp `t` as ISO 8601 in the local time implied by `offsetSeconds` (seconds east of UTC).
///
/// Emits a trailing `Z` when `offsetSeconds` is 0, otherwise a signed
/// `+hh:mm` / `-hh:mm` suffix.
pub fn formatOffset(t: long, offsetSeconds: int): string {
    let local = t + offsetSeconds;
    let base = format(local, "YYYY-MM-DDThh:mm:ss");
    if (offsetSeconds == 0) { return base + "Z"; }
    let off = offsetSeconds;
    let sign = "+";
    if (off < 0) { sign = "-"; off = 0 - off; }
    let hh = off / SECONDS_PER_HOUR;
    let mm = (off - (hh * SECONDS_PER_HOUR)) / SECONDS_PER_MINUTE;
    return base + sign + pad2(hh) + ":" + pad2(mm);
}

// Formats v as a zero-padded two-digit string (used for the offset hh:mm in formatOffset).
fn pad2(v: int): string {
    let buf = bytes.alloc(3);
    bytes.write_byte(buf, 0, ((v / 10) % 10) + 48);
    bytes.write_byte(buf, 1, (v % 10) + 48);
    bytes.write_byte(buf, 2, 0);
    bytes.write_i32(buf - 4, 0, 2);
    return buf as string;
}

@test
fn test_datetime_tz(): void {
    let utc = fromIsoUtc("2024-03-15T12:30:00+05:00") ?? -1;
    let plain = parseIso("2024-03-15T07:30:00") ?? -2;
    assert.equalInt(plain, utc);
    assert.equalInt(fromIsoUtc("2024-03-15T07:30:00Z") ?? -1, plain);
    assert.equalInt(fromIsoUtc("2024-03-15T07:30:00") ?? -1, plain);
    let utc2 = fromIsoUtc("2024-03-15T00:00:00-08:00") ?? -1;
    assert.equalInt(parseIso("2024-03-15T08:00:00") ?? -2, utc2);
    assert.equalInt(5 * 3600, tzOffsetSeconds("2024-03-15T12:30:00+0500") ?? -1);
    assert.equalInt(0 - (8 * 3600), tzOffsetSeconds("2024-03-15T12:30:00-08") ?? 1);
    let iso = formatOffset(plain, (5 * 3600) + (30 * 60));
    assert.equalInt(plain, fromIsoUtc(iso) ?? -1);
    assert.equalInt(1, if (string.endsWith(iso, "+05:30")) 1 else 0);
}

@test
fn test_datetime(): void {
    assert.isTrue(isLeapYear(2020));
    assert.isFalse(isLeapYear(2021));
    assert.isTrue(isLeapYear(2000));
    assert.isFalse(isLeapYear(1900));

    assert.equalInt(31, daysInMonth(2020, 1));
    assert.equalInt(29, daysInMonth(2020, 2));
    assert.equalInt(28, daysInMonth(2021, 2));

    let ts = parse("2024-03-15 12:30:00") ?? 0;
    assert.isTrue(ts > 0);
    let iso = toIso(ts);

    assert.equalInt(1, if (string.startsWith(iso, "2024-03-15")) 1 else 0);
}
