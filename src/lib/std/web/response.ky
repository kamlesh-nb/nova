//! HTTP response building, HTML escaping, and wire parsing for the `web` framework.
//!
//! This file provides the `Response` struct that route handlers construct and
//! return (status, body, headers, cookies), plus `Response.serialize` to render
//! it as raw HTTP/1.1 bytes and `Response.parse` to read a response back off
//! the wire (used by the HTTP client side and by tests). `HttpError` is the
//! error type route handlers can throw to short-circuit into a status-coded
//! response.
//!
//! It also carries the HTML-escaping helpers used by the template/render path:
//! `escapeHtml` for owned strings and `escapeHtmlIntoView` for the zero-copy
//! path that escapes straight out of a borrowed `str.Str` (see `str.ky`)
//! into a `StringBuilder` without minting an intermediate owned string.

import string;
import str;
import list;
import map;
import bytes;
import assert;
import os.sys;
import collections.string_builder;
import web.status;
import web.request;
import compress.gzip;

/// Scans a raw byte buffer for the first occurrence of byte `b` within
/// `[start, end)`, returning its offset or -1 if not found.
fn idxByte(buf: long, start: int, end: int, b: int): int {
    if (start >= end) { return -1; }
    let p = sys.memchr(buf + (start as long), b, (end - start) as long);
    if (p == 0) { return -1; }
    return (p - buf) as int;
}

/// Case-insensitive ASCII string comparison, used for HTTP header name lookup.
fn ciEquals(a: string, b: string): bool {
    if (a.length != b.length) { return false; }
    let i = 0;
    while (i < a.length) {
        let ca = a[i];
        let cb = b[i];
        if (ca >= 65 && ca <= 90) { ca = ca + 32; }
        if (cb >= 65 && cb <= 90) { cb = cb + 32; }
        if (ca != cb) { return false; }
        i = i + 1;
    }
    return true;
}

/// Escapes `&`, `<`, `>`, `"` and `'` in `s` (HTML entity form) and appends the
/// result into `sb`, in place, without building an intermediate string.
pub fn escapeHtmlInto(sb: StringBuilder, s: string): void {
    let n = string.len(s);
    let base = s as long;
    let runStart = 0;
    let m = kyte_html_find_meta(base, 0, n);
    while (m < n) {
        if (m > runStart) { sb.appendRange(s, runStart, m); }
        let c = s[m];
        if (c == 38) { sb.append("&amp;"); }
        else if (c == 60) { sb.append("&lt;"); }
        else if (c == 62) { sb.append("&gt;"); }
        else if (c == 34) { sb.append("&quot;"); }
        else { sb.append("&#39;"); }
        runStart = m + 1;
        m = kyte_html_find_meta(base, runStart, n);
    }
    if (n > runStart) { sb.appendRange(s, runStart, n); }
}

/// Same as `escapeHtmlInto`, but reads directly from a borrowed `str.Str`
/// view instead of an owned `string`. This is the zero-copy path used by the
/// template render path: it escapes straight out of the source buffer into
/// `sb` without allocating an owned intermediate string.
pub fn escapeHtmlIntoView(sb: StringBuilder, v: str.Str): void {
    let base = v.ptr;
    let n = v.len;
    let runStart = 0;
    let m = kyte_html_find_meta(base, 0, n);
    while (m < n) {
        if (m > runStart) { sb.appendBytes(base + (runStart as long), m - runStart); }
        let c = bytes.read_byte(base, m);
        if (c == 38) { sb.append("&amp;"); }
        else if (c == 60) { sb.append("&lt;"); }
        else if (c == 62) { sb.append("&gt;"); }
        else if (c == 34) { sb.append("&quot;"); }
        else { sb.append("&#39;"); }
        runStart = m + 1;
        m = kyte_html_find_meta(base, runStart, n);
    }
    if (n > runStart) { sb.appendBytes(base + (runStart as long), n - runStart); }
}

/// Returns an HTML-escaped copy of `s`, escaping `&`, `<`, `>`, `"` and `'`.
///
/// If `s` contains none of these characters, the original string `s` is
/// returned unchanged (no copy is made), so the common case is free.
// Marks an already-rendered, trusted HTML fragment for RAW embedding inside NSX markup:
// `<div>{response.raw(childHtml)}</div>` inserts `childHtml` without HTML-escaping, for
// composing a parent view from a child view's output. The NSX compiler recognises the
// `raw(...)` / `x.raw(...)` call shape in child position and skips escaping only there.
// Use ONLY for HTML your own code produced, never for user input (that would be an XSS
// hole -- every other `{expr}` child is escaped precisely to prevent it).
// The one sanctioned `string` -> `Html` promotion. `s as Html` is the explicit
// cast the type system otherwise forbids (a plain string cannot become trusted
// markup implicitly), so this function is the single, greppable XSS boundary for
// pre-rendered fragments. Use ONLY for HTML your own code produced.
pub fn raw(s: string): Html { return s as Html; }

pub fn escapeHtml(s: string): string {
    let n = string.len(s);
    let first = -1;
    let k = 0;
    while (k < n) {
        let c = s[k];
        if (c == 38 || c == 60 || c == 62 || c == 34 || c == 39) { first = k; break; }
        k = k + 1;
    }
    if (first == -1) { return s; }
    let sb = StringBuilder();
    if (first > 0) { sb.append(string.slice(s, 0, first)); }
    let i = first;
    let runStart = first;
    while (i < n) {
        let c = s[i];
        if (c == 38 || c == 60 || c == 62 || c == 34 || c == 39) {
            if (i > runStart) { sb.append(string.slice(s, runStart, i)); }
            if (c == 38) { sb.append("&amp;"); }
            else if (c == 60) { sb.append("&lt;"); }
            else if (c == 62) { sb.append("&gt;"); }
            else if (c == 34) { sb.append("&quot;"); }
            else { sb.append("&#39;"); }
            runStart = i + 1;
        }
        i = i + 1;
    }
    if (i > runStart) { sb.append(string.slice(s, runStart, i)); }
    return sb.toString();
}

/// An error that a route handler can throw to short-circuit request handling
/// into a status-coded response, instead of returning a `Response` directly.
pub struct HttpError {
    /// HTTP status code, e.g. 404 or 500.
    pub status: int,
    /// Body text carried into the resulting response.
    pub message: string,

    init(status: int, message: string) {
        self.status = status;
        self.message = message;
    }

    /// Converts this error into a plain-text `Response` with `status` mapped
    /// through `Status.fromCode` and `message` as the body.
    pub fn toResponse(self: HttpError): Response {
        let r = Response(Status.fromCode(self.status), self.message);
        return r;
    }
}

/// An HTTP response: status, body, headers, and cookies to be set. Route
/// handlers build and return this; `serialize` renders it to wire bytes.
pub struct Response {
    /// The HTTP status line code and reason phrase.
    pub status: Status,
    /// The response body. `serialize` fills in Content-Length from this if
    /// the caller hasn't set it explicitly.
    pub body: string,
    /// Response headers, keyed by name. Lookup via `getHeader` is
    /// case-insensitive even though the map itself is not.
    pub headers: Map<string, string>,
    /// Cookies to emit as `Set-Cookie` headers on serialize, each with
    /// `Path=/`.
    pub cookies: Map<string, string>,

    init(stat: Status, body: string) {
        self.status = stat;
        self.body = body;
        self.headers = Map<string, string>(16, string.hash);
        self.cookies = Map<string, string>(16, string.hash);
    }

    /// Builds a 200 OK response with the given body and no headers or cookies.
    pub fn ok(body: string): Response {
        return Response(Status.Ok, body);
    }

    /// Builds a response with an explicit status, body, and header map;
    /// cookies start empty.
    pub fn withHeaders(stat: Status, body: string, headers: Map<string, string>): Response {
        let cookies = Map<string, string>(16, string.hash);
        return Response{
            status: stat,
            body: body,
            headers: headers,
            cookies: cookies,
        };
    }

    /// Sets a header, overwriting any existing value for `key`, and returns
    /// `self` for chaining.
    pub fn setHeader(self: Response, key: string, value: string): Response {
        self.headers.set(key, value);
        return self;
    }

    /// Sets a cookie to be emitted via `Set-Cookie: name=value; Path=/` on
    /// serialize, and returns `self` for chaining.
    pub fn setCookie(self: Response, name: string, value: string): Response {
        self.cookies.set(name, value);
        return self;
    }

    /// Looks up a header by name, case-insensitively, returning `undefined`
    /// if absent. This is a linear scan over all header keys.
    pub fn getHeader(self: Response, name: string): string | undefined {
        let keys = self.headers.keys();
        let keysLen = keys.size();
        let i = 0;
        while (i < keysLen) {
            let key = keys.get(i) ?? "";
            if (ciEquals(key, name)) {
                return self.headers.get(key);
            }
            i = i + 1;
        }
        return undefined;
    }

    /// Renders the full HTTP/1.1 response: status line, headers, Set-Cookie
    /// lines, a blank line, then the body. Sets Content-Length automatically
    /// if not already present in `headers`.
    pub fn serialize(self: Response): string {
        if (self.headers.get("Content-Length") == undefined) {
            self.headers.set("Content-Length", intToStr(self.body.length));
        }

        let sb = string_builder.StringBuilder();
        sb.ensureCapacity(self.body.length + 512);
        sb.append("HTTP/1.1 ");
        sb.append(intToStr(Status.toCode(self.status)));
        sb.append(" ");
        sb.append(Status.reasonPhrase(self.status));
        sb.append("\r\n");
        self.headers.forEach((key, value) => {
            sb.append(key);
            sb.append(": ");
            sb.append(value);
            sb.append("\r\n");
        });
        self.cookies.forEach((key, value) => {
            sb.append("Set-Cookie: ");
            sb.append(key);
            sb.append("=");
            sb.append(value);
            sb.append("; Path=/\r\n");
        });
        sb.append("\r\n");
        sb.append(self.body);
        return sb.toString();
    }

    /// Same as `serialize` but without the body: status line, headers,
    /// Set-Cookie lines, and the trailing blank line. Used when the body is
    /// streamed separately.
    pub fn serializeHeaders(self: Response): string {
        if (self.headers.get("Content-Length") == undefined) {
            self.headers.set("Content-Length", intToStr(self.body.length));
        }
        let sb = string_builder.StringBuilder();
        sb.ensureCapacity(512);
        sb.append("HTTP/1.1 ");
        sb.append(intToStr(Status.toCode(self.status)));
        sb.append(" ");
        sb.append(Status.reasonPhrase(self.status));
        sb.append("\r\n");
        self.headers.forEach((key, value) => {
            sb.append(key);
            sb.append(": ");
            sb.append(value);
            sb.append("\r\n");
        });
        self.cookies.forEach((key, value) => {
            sb.append("Set-Cookie: ");
            sb.append(key);
            sb.append("=");
            sb.append(value);
            sb.append("; Path=/\r\n");
        });
        sb.append("\r\n");
        return sb.toString();
    }

    /// Parses a raw HTTP/1.1 response (status line, headers, blank line,
    /// body) into a `Response`. Automatically dechunks a
    /// `Transfer-Encoding: chunked` body and gunzips a
    /// `Content-Encoding: gzip` body. Malformed input that lacks even a
    /// status-line terminator returns a 200 OK with an empty body rather
    /// than failing.
    pub fn parse(raw: string): Response {
        let n = raw.length;
        let buf = raw as long;

        let eol = idxByte(buf, 0, n, 13);
        if (eol < 0) { return Response(Status.Ok, ""); }

        let sp1 = idxByte(buf, 0, eol, 32);
        let code = 200;
        if (sp1 >= 0) {
            let sp2 = idxByte(buf, sp1 + 1, eol, 32);
            let code_end = if (sp2 >= 0) sp2 else eol;
            code = string.parseI64(string.slice(raw, sp1 + 1, code_end)) as int;
        }
        let stat = Status.fromCode(code);

        let pos = eol + 2;
        let headers = Map<string, string>(16, string.hash);
        while (pos < n) {
            if (bytes.read_byte(buf, pos) as int == 13) {
                pos = pos + 2;
                break;
            }
            let line_end = idxByte(buf, pos, n, 13);
            if (line_end < 0) { break; }
            let colon = idxByte(buf, pos, line_end, 58);
            if (colon >= 0) {
                let key = string.slice(raw, pos, colon);
                let v_off = colon + 1;
                while (v_off < line_end && (bytes.read_byte(buf, v_off) as int == 32)) {
                    v_off = v_off + 1;
                }
                let val = string.slice(raw, v_off, line_end);
                headers.set(key, val);
            }
            pos = line_end + 2;
        }

        let body = if (pos <= n) string.slice(raw, pos, n) else "";

        let te = decodedHeader(headers, "transfer-encoding");
        if (string.contains(te, "chunked")) {
            body = request.bufDechunk(body as long, 0, body.length);
        }
        let ce = decodedHeader(headers, "content-encoding");
        if (string.contains(ce, "gzip")) {
            body = gzip.decompress(body);
        }
        return Response.withHeaders(stat, body, headers);
    }
}

/// Case-insensitive header lookup that returns the lower-cased value, or an
/// empty string if the header is absent. Used to match tokens such as
/// "chunked" or "gzip" without worrying about header-value casing.
fn decodedHeader(headers: Map<string, string>, name: string): string {
    let keys = headers.keys();
    let i = 0;
    while (i < keys.size()) {
        let k = keys.get(i) ?? "";
        if (ciEquals(k, name)) { return string.toLowerCase(headers.get(k) ?? ""); }
        i = i + 1;
    }
    return "";
}

@test
fn test_parse_content_length(): void {
    let raw = "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 5\r\n\r\nhello";
    let r = Response.parse(raw);
    assert.equalInt(Status.toCode(r.status), 200);
    assert.equalStr(r.body, "hello");
    assert.equalStr(r.getHeader("Content-Type") ?? "", "text/plain");
}

@test
fn test_parse_chunked(): void {
    let raw = "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n4\r\nWiki\r\n5\r\npedia\r\n0\r\n\r\n";
    let r = Response.parse(raw);
    assert.equalInt(Status.toCode(r.status), 200);
    assert.equalStr(r.body, "Wikipedia");
}

/// Converts a non-negative int to its decimal string form (`val == 0` is
/// handled as a special case; negative values are not handled).
fn intToStr(val: int): string {
    if (val == 0) return "0";
    let temp = val;
    let digits = 0;
    while (temp > 0) {
        digits = digits + 1;
        temp = temp / 10;
    }

    let str_ptr = bytes.alloc(digits);
    let i = digits - 1;
    temp = val;
    while (i >= 0) {
        bytes.write_byte(str_ptr, i, (temp % 10) + 48);
        temp = temp / 10;
        i = i - 1;
    }
    return str_ptr as string;
}
