//! The Nova web application: routing, mediator dispatch, static file serving,
//! response caching and the HTTP/1.1 and HTTP/2 connection handling that
//! sits on top of Nova's own reactor (`net.poller`, `net.eventedio`).
//!
//! `App` is the entry point a project's `main` builds up (`useTls`, `useGzip`,
//! `useStatic`, `get`/`post`/... route registration, `useServices`) and then
//! hands to `run`, which starts a single-reactor event loop and serves
//! connections until the process exits. Two ways to come up are supported:
//! a normal listening socket bound directly to `port` (`reactorWorkerBody`),
//! or receiving already-accepted client file descriptors handed off from a
//! front-end proxy over a Unix control socket (`reactorHandoffBody`, used
//! when `NOVA_HANDOFF_SOCK` is set for zero-downtime deploys under `proxyd`).
//!
//! Requests are read off raw buffers (chunked and content-length bodies both
//! handled), matched against `web.routing.Router`, converted into typed
//! request objects via `web.serde.source`, and dispatched through
//! `web.mediator.Mediator` to the handler registered for that request type.
//! HTTP/2 support (behind ALPN over TLS) speaks frames directly using
//! `web.http2.frame` and `web.http2.hpack` rather than reusing the HTTP/1.1
//! text parsing path.

import net.aio;
import net.asynctls;
import net.poller;
import net.eventedio;
import os.sys;
import os.socket;
import io.file;
import web.request;
import web.response;
import web.status;
import serde.source;
import web.static_content;
import web.di;
import web.mediator;
import web.routing;
import web.http2.frame;
import web.http2.hpack;
import compress.gzip;
import string;
import list;
import map;
import bytes;
import assert;
import env;




/// A streaming (Server-Sent Events) route handler.
///
/// Unlike a request handler it returns no `Response`; it takes over the
/// connection via `io` and writes SSE frames until the client disconnects (a
/// write returns a negative byte count) or it decides to stop. Register one with
/// `App.sse(path, handler)`. Handlers usually hold a `web.sse.EventBus`,
/// subscribe to a topic derived from `req`, and forward each event with
/// `web.sse.writeEvent`. Defined here (not in `web.sse`) so the framework core
/// does not depend on `web.sse`; an app imports `web.app` for this trait and
/// `web.sse` for the bus and wire writers.
pub trait SseHandler {
    /// Serves one SSE connection to completion.
    async fn stream(self, req: request.Request, io: aio.AsyncIO): void;
}

/// The web application: holds routing, dependency injection, static
/// mounts, response caching and server configuration, and owns the
/// connection-handling loop started by `run`.
pub class App {
    /// Route table mapping method and path pattern to a registered request type.
    pub router: routing.Router,
    /// Dispatches a resolved route's typed request through the registered pipeline behaviours to its handler.
    pub mediator: mediator.Mediator,
    /// Static file mounts consulted, in order, for GET requests that miss the router.
    pub static_mounts: List<static_content.StaticMount>,

    /// Serialized response bodies keyed by path, used to serve cache hits without re-dispatching.
    pub cache: Map<string, string>,
    /// Paths marked eligible for caching via `enableCache`.
    pub cacheable: Map<string, bool>,

    /// Dependency injection container built from the last `ServiceCollection` passed to `useServices` (or the default, empty one).
    pub provider: ServiceProvider,

    /// Milliseconds to wait for request data before the connection is dropped.
    pub readTimeoutMs: int,
    /// Maximum size, in bytes, of the request header block before a 431 response is sent.
    pub maxHeaderBytes: int,
    /// Maximum request body size, in bytes, before a 413 response is sent.
    pub maxBodyBytes: int,

    /// Whether TLS is active for this server (set by `useTls`).
    pub tlsEnabled: bool,
    /// PEM certificate contents used to terminate TLS.
    pub tlsCert: string,
    /// PEM private key contents used to terminate TLS.
    pub tlsKey: string,

    /// Whether eligible response bodies are gzip-compressed before sending.
    pub gzipEnabled: bool,

    /// TCP port the server listens on, set by `run`.
    pub serverPort: int,

    /// Streaming (Server-Sent Events) routes. `sseRouter` matches the request
    /// path (supporting `{name}` and `{name:int}` parameters) to an index into
    /// `sseHandlers`. Matched in the connection loop before normal dispatch: a
    /// hit hands the raw connection to the registered `SseHandler`, which owns
    /// the socket for the life of the stream.
    pub sseRouter: routing.Router,
    pub sseHandlers: List<SseHandler>,

    init() {
        self.router = routing.Router();
        self.provider = ServiceCollection().buildServiceProvider();
        self.mediator = mediator.Mediator(self.provider);
        __registerHandlers(self.mediator);
        self.static_mounts = List<static_content.StaticMount>();
        self.cache = Map<string, string>(16, string.hash);
        self.cacheable = Map<string, bool>(16, string.hash);
        self.readTimeoutMs = 30000;
        self.maxHeaderBytes = 32768;
        self.maxBodyBytes = 1048576;
        self.tlsEnabled = false;
        self.tlsCert = "";
        self.tlsKey = "";
        self.gzipEnabled = false;
        self.serverPort = 0;
        self.sseRouter = routing.Router();
        self.sseHandlers = List<SseHandler>();
    }

    /// Turns on gzip compression for eligible outgoing response bodies.
    pub fn useGzip(self: App): void {
        self.gzipEnabled = true;
    }

    /// Loads a certificate and private key from disk and enables TLS termination.
    ///
    /// Silently leaves TLS disabled if either file reads as empty, rather than raising an error.
    pub fn useTls(self: App, certPath: string, keyPath: string): void {
        let cert = File.readText(certPath);
        let key = File.readText(keyPath);
        if (cert.length > 0 && key.length > 0) {
            self.tlsCert = cert;
            self.tlsKey = key;
            self.tlsEnabled = true;
        }
    }

    /// Overrides the default read timeout and header and body size limits used while reading connections.
    pub fn configureServer(self: App, readTimeoutMs: int, maxHeaderBytes: int, maxBodyBytes: int): void {
        self.readTimeoutMs = readTimeoutMs;
        self.maxHeaderBytes = maxHeaderBytes;
        self.maxBodyBytes = maxBodyBytes;
    }

    /// Replaces the dependency injection provider by building it from `sc`, and rebinds the mediator to it.
    pub fn useServices(self: App, sc: ServiceCollection): void {
        self.provider = sc.buildServiceProvider();
        self.mediator.setProvider(self.provider);
    }

    /// Registers a pipeline behaviour that wraps every request dispatched through the mediator.
    pub fn useBehavior(self: App, behavior: mediator.PipelineBehavior): void {
        self.mediator.useBehavior(behavior);
    }

    /// Marks a path as cacheable: its first successfully served, non-gzipped GET response is cached for later hits.
    pub fn enableCache(self: App, path: string): void {
        self.cacheable.set(path, true);
    }

    /// Returns a fresh copy of the cached serialized response for `path`, or `undefined` if nothing is cached.
    pub fn cachedCopy(self: App, path: string): string | undefined {
        let hit = self.cache.get(path);
        if (hit != undefined) {
            let hv = hit ?? "";
            return string.slice(hv, 0, hv.length);
        }
        return undefined;
    }

    /// Parses a raw HTTP/1.1 request, dispatches it, and sends the response on a cache miss.
    ///
    /// Applies gzip compression when enabled and the client accepts it, then stores the
    /// serialized response in the cache for GET requests on cacheable paths (skipped when
    /// the body was gzipped, since the cache holds only uncompressed bodies).
    pub async fn respondMissTo(self: App, io: aio.AsyncIO, raw: string, method: string, path: string): int {
        let req = request.Request.fromString(raw);
        let resp = await self.dispatch(req);

        let ae = req.getHeader("accept-encoding") ?? "";
        let didGzip = false;
        if (self.gzipEnabled && string.contains(ae, "gzip") && resp.body.length >= 256) {
            let packed = gzip.compress(resp.body);
            if (packed.length > 0 && packed.length < resp.body.length) {
                resp.body = packed;
                resp.headers.set("Content-Encoding", "gzip");
                resp.headers.set("Content-Length", `${packed.length}`);
                didGzip = true;
            }
        }

        if (string.eql(method, "GET") && !didGzip && self.cacheable.get(path) != undefined) {
            let out = resp.serialize();
            self.cache.set(path, string.slice(out, 0, out.length));
            return await io.sendStr(out);
        }
        let hdrs = resp.serializeHeaders();
        if (resp.body.length == 0) { return await io.sendStr(hdrs); }
        if (resp.body.length < 65536) { return await io.sendStr(hdrs + resp.body); }
        let hn = await io.sendStr(hdrs);
        return await io.sendStr(resp.body);
    }

    /// Mounts a directory on disk to be served for GET requests under `prefix` when no route matches.
    pub fn useStatic(self: App, prefix: string, dir: string): void {
        self.static_mounts.push(static_content.StaticMount(prefix, dir, 128));
    }

    /// Registers a GET route at `path`, binding matched requests to type `TReq`.
    pub fn get<TReq>(self: App, path: string): void {
        self.router.__addRoute("GET", path, serde.typeName<TReq>());
    }
    /// Registers a POST route at `path`, binding matched requests to type `TReq`.
    pub fn post<TReq>(self: App, path: string): void {
        self.router.__addRoute("POST", path, serde.typeName<TReq>());
    }
    /// Registers a PUT route at `path`, binding matched requests to type `TReq`.
    pub fn put<TReq>(self: App, path: string): void {
        self.router.__addRoute("PUT", path, serde.typeName<TReq>());
    }
    /// Registers a DELETE route at `path`, binding matched requests to type `TReq`.
    pub fn delete<TReq>(self: App, path: string): void {
        self.router.__addRoute("DELETE", path, serde.typeName<TReq>());
    }
    /// Registers a PATCH route at `path`, binding matched requests to type `TReq`.
    pub fn patch<TReq>(self: App, path: string): void {
        self.router.__addRoute("PATCH", path, serde.typeName<TReq>());
    }

    /// Registers a streaming (Server-Sent Events) route at `path`.
    ///
    /// A GET matching `path` is handed straight to `handler`, which takes over
    /// the connection and writes SSE frames until the client disconnects, rather
    /// than returning a finite `Response`. `path` may contain `{name}` (or
    /// `{name:int}`) parameters; captured values are merged into the request's
    /// query, so the handler reads them with `req.query.get("name")`. Matched in
    /// the connection loop before normal dispatch. See `web.sse`.
    pub fn sse(self: App, path: string, handler: SseHandler): void {
        let idx = self.sseHandlers.size();
        self.sseHandlers.push(handler);
        self.sseRouter.__addRoute("GET", path, `${idx}`);
    }

    // Builds the value source a matched request's fields are bound from: request
    // cookies (lowest precedence), then query and path params, plus a body source
    // chosen by content type for POST/PUT/PATCH. Cookies are merged in so a
    // request field can bind from a cookie (for example a session or cart id),
    // while any query, path, or body value of the same name overrides it.
    fn sourceFor(self: App, req: Request, params: Map<string, string>): ValueSource {
        let merged = Map<string, string>(8, string.hash);
        req.cookies.forEach((k, v) => { merged.set(k, v); });
        req.query.forEach((k, v) => { merged.set(k, v); });
        params.forEach((k, v) => { merged.set(k, v); });
        let paramSrc = source.ParamSource(merged);
        if (string.eql(req.method, "POST") || string.eql(req.method, "PUT") || string.eql(req.method, "PATCH")) {
            let contentType = req.getHeader("content-type") ?? "";
            let ct = string.toLowerCase(contentType);
            if (string.indexOf(ct, "multipart/form-data") != -1) {
                return source.CompositeSource(paramSrc, request.multipartSource(contentType, req.body));
            }
            if (string.indexOf(ct, "x-www-form-urlencoded") != -1) {
                return source.CompositeSource(paramSrc, request.formSource(req.body));
            }
            return source.CompositeSource(paramSrc, source.fromJson(req.body));
        }
        return paramSrc;
    }

    /// Resolves and serves one request: a matched route through the mediator, an
    /// unmatched GET through the static mounts, otherwise a Bad Request, Method Not
    /// Allowed, or Not Found response as appropriate.
    pub async fn dispatch(self: App, req: Request): response.Response {
        let m = self.router.resolve(req.method, req.path);
        if (m.typedBad) {
            return response.Response(Status.BadRequest, "Bad Request: invalid path parameter");
        }
        if (m.matched) {
            let src = self.sourceFor(req, m.params);
            return await __mediator_dispatch_runtime(m.key, src, self.mediator);
        }
        if (m.methodNotAllowed) {
            return response.Response(Status.MethodNotAllowed, "Method Not Allowed");
        }

        if (string.eql(req.method, "GET")) {
            let m = 0;
            let nm = self.static_mounts.size();
            while (m < nm) {
                let mount = self.static_mounts.at(m);
                let served = mount.serve(req.path);
                if (served != undefined) {
                    return served ?? response.Response(Status.NotFound, "Not Found");
                }
                m = m + 1;
            }
        }
        return response.Response(Status.NotFound, "Not Found");
    }

    /// Starts serving on `port`: receives handed-off connections from a proxy if
    /// `NOVA_HANDOFF_SOCK` is set in the environment, otherwise binds and listens
    /// directly. Runs the reactor loop and does not return.
    pub fn run(self: App, port: int): void {
        self.serverPort = port;
        let handoff = env.get("NOVA_HANDOFF_SOCK");
        if (!string.eql(handoff, "")) {
            reactorHandoffBody(self, handoff);
            return;
        }
        reactorWorkerBody(self, 0);
    }
}

// Builds a minimal, bodyless HTTP/1.1 error response that closes the connection.
fn errResponse(code: int, reason: string): string {
    return `HTTP/1.1 ${code} ${reason}\r\nContent-Length: 0\r\nConnection: close\r\n\r\n`;
}

// Reads exactly n bytes into buf starting at off, looping over partial reads; false on EOF or error.
async fn h2ReadN(io: AsyncIO, buf: long, off: int, n: int): bool {
    let got = 0;
    while (got < n) {
        let r = await io.recvInto(buf + ((off + got) as long), n - got);
        if (r <= 0) { return false; }
        got = got + r;
    }
    return true;
}

// Reinterprets a raw byte buffer as a Nova string by writing the ARC length header and NUL terminator in place.
fn h2BufToStr(buf: long, len: int): string {
    bytes.write_byte(buf, len, 0);
    bytes.write_i32(buf - 4, 0, len);
    return buf as string;
}

// Serves one HTTP/2 connection: validates the preface, acknowledges SETTINGS/PING,
// decodes HEADERS frames with HPACK, dispatches completed requests through the app,
// and encodes the response back as HEADERS (+ DATA if there is a body). Returns on GOAWAY or a send failure.
async fn handleConnH2(app: App, io: AsyncIO): int {
    let dec = hpack.newHpack();
    let enc = hpack.newHpack();
    let hdr: long = bytes.alloc(9);
    let pre: long = bytes.alloc(24);

    if (!(await h2ReadN(io, pre, 0, 24))) { return 0; }
    let k = 0;
    while (k < 24) { if (bytes.read_byte(pre, k) != frame.PREFACE[k]) { return 0; } k = k + 1; }

    let sbuf: long = bytes.alloc(64);
    let sl = frame.writeSettingsEmpty(sbuf, 0);
    if ((await io.sendStr(h2BufToStr(sbuf, sl))) < 0) { return 0; }

    let running = true;
    while (running) {
        if (!(await h2ReadN(io, hdr, 0, 9))) { running = false; }
        if (running) {
            let fh = frame.readHeader(hdr, 0);
            let pay: long = bytes.alloc(fh.length + 1);
            if (fh.length > 0) {
                if (!(await h2ReadN(io, pay, 0, fh.length))) { running = false; }
            }
            if (running) {
                if (fh.ftype == frame.FRAME_SETTINGS) {
                    if ((fh.flags & frame.FLAG_ACK) == 0) {
                        let ab: long = bytes.alloc(16);
                        let al = frame.writeSettingsAck(ab, 0);
                        if ((await io.sendStr(h2BufToStr(ab, al))) < 0) { running = false; }
                    }
                } else if (fh.ftype == frame.FRAME_PING) {
                    if ((fh.flags & frame.FLAG_ACK) == 0) {
                        let pb: long = bytes.alloc(32);
                        let pl = frame.writePingAck(pb, 0, pay, 0);
                        if ((await io.sendStr(h2BufToStr(pb, pl))) < 0) { running = false; }
                    }
                } else if (fh.ftype == frame.FRAME_GOAWAY) {
                    running = false;
                } else if (fh.ftype == frame.FRAME_HEADERS) {
                    let boff = 0;
                    let blen = fh.length;
                    if ((fh.flags & frame.FLAG_PADDED) != 0) { let padL = bytes.read_byte(pay, 0); boff = 1; blen = fh.length - 1 - padL; }
                    if ((fh.flags & frame.FLAG_PRIORITY) != 0) { boff = boff + 5; blen = blen - 5; }
                    if (blen < 0) { blen = 0; }
                    let fields = dec.decode(pay, boff, blen);
                    if ((fh.flags & frame.FLAG_END_STREAM) != 0) {
                        let req = h2BuildRequest(fields);
                        let resp = await app.dispatch(req);
                        let rf = List<hpack.HeaderField>();
                        rf.push(hpack.HeaderField(":status", `${Status.toCode(resp.status)}`));
                        let hk = resp.headers.keys();
                        let hi = 0;
                        while (hi < hk.size()) {
                            let key = hk.get(hi) ?? "";
                            let lk = h2Lower(key);
                            if (lk != "connection" && lk != "keep-alive" && lk != "transfer-encoding" && lk != "upgrade") {
                                rf.push(hpack.HeaderField(lk, resp.headers.get(key) ?? ""));
                            }
                            hi = hi + 1;
                        }
                        let (hb, hbLen) = enc.encode(rf);
                        let body = resp.body;
                        let hasBody = body.length > 0;
                        let hflags = frame.FLAG_END_HEADERS;
                        if (!hasBody) { hflags = hflags | frame.FLAG_END_STREAM; }
                        let rbuf: long = bytes.alloc(hbLen + 64);
                        let ro = frame.writeFrame(rbuf, 0, frame.FRAME_HEADERS, hflags, fh.streamId, hb, 0, hbLen);
                        if ((await io.sendStr(h2BufToStr(rbuf, ro))) < 0) { running = false; }
                        if (running && hasBody) {
                            let dbuf: long = bytes.alloc(body.length + 16);
                            let dl = frame.writeFrame(dbuf, 0, frame.FRAME_DATA, frame.FLAG_END_STREAM, fh.streamId, body as long, 0, body.length);
                            if ((await io.sendStr(h2BufToStr(dbuf, dl))) < 0) { running = false; }
                        }
                    }
                }
            }
        }
    }
    io.close();
    return 1;
}

// Lowercases an ASCII string into a freshly allocated buffer (HTTP/2 header names must be lowercase).
fn h2Lower(s: string): string {
    let out = bytes.alloc(s.length + 1);
    let i = 0;
    while (i < s.length) {
        let c = s[i];
        if (c >= 'A' && c <= 'Z') { c = c + 32; }
        bytes.write_byte(out, i, c);
        i = i + 1;
    }
    bytes.write_byte(out, s.length, 0);
    bytes.write_i32(out - 4, 0, s.length);
    return out as string;
}

// Looks up a pseudo-header (":method", ":path", ...) by name in decoded HTTP/2 fields; "" if absent.
fn h2GetPseudo(fields: List<hpack.HeaderField>, name: string): string {
    let i = 0;
    while (i < fields.size()) {
        let f = fields.at(i);
        if (f.name == name) { return f.value; }
        i = i + 1;
    }
    return "";
}

// Converts decoded HTTP/2 header fields into a Request, taking method/path from pseudo-headers.
fn h2BuildRequest(fields: List<hpack.HeaderField>): Request {
    let req = Request.empty();
    req.method = h2GetPseudo(fields, ":method");
    req.path = h2GetPseudo(fields, ":path");
    let i = 0;
    while (i < fields.size()) {
        let f = fields.at(i);
        if (f.name.length > 0 && f.name[0] != ':') { req.headers.set(f.name, f.value); }
        i = i + 1;
    }
    return req;
}

// Serves one HTTP/1.1 keep-alive connection: reads and buffers headers and body (chunked
// or content-length, enforcing the app's size limits), serves a cached copy on a GET cache
// hit, otherwise dispatches through the app, then slides any pipelined leftover bytes to
// the front of the buffer for the next request. Loops until "Connection: close" or a read failure.
async fn handleConn(app: App, io: AsyncIO): int {
    let cap = 65536;
    let buf: long = bytes.alloc(cap);

    let len = 0;
    let alive = true;
    let tmo = app.readTimeoutMs;

    let _ = io.setTimeout(tmo);
    while (alive) {
        let hdrEnd = request.bufFindHeaderEnd(buf, 0, len);
        while (hdrEnd == -1) {
            if (len >= app.maxHeaderBytes || len >= cap) {
                await io.sendStr(errResponse(431, "Request Header Fields Too Large"));
                alive = false;
                break;
            }
            let hn = await io.recvInto(buf + len, cap - len);
            if (hn <= 0) { alive = false; break; }
            len = len + hn;
            hdrEnd = request.bufFindHeaderEnd(buf, 0, len);
        }
        if (!alive) { break; }

        if (request.bufFindCI(buf, 0, hdrEnd, "expect: 100-continue") != -1) {
            await io.sendStr("HTTP/1.1 100 Continue\r\n\r\n");
        }

        let bodyStart = hdrEnd + 4;
        let reqEnd = bodyStart;
        let chunkedBody = "";
        let usedChunked = false;

        if (request.bufIsChunked(buf, 0, hdrEnd)) {

            let cend = request.bufChunkedEnd(buf, bodyStart, len);
            while (cend == -1) {
                if ((len - bodyStart) >= app.maxBodyBytes) {
                    await io.sendStr(errResponse(413, "Payload Too Large"));
                    alive = false;
                    break;
                }
                if (len >= cap) { alive = false; break; }
                let bn = await io.recvInto(buf + len, cap - len);
                if (bn <= 0) { alive = false; break; }
                len = len + bn;
                cend = request.bufChunkedEnd(buf, bodyStart, len);
            }
            if (!alive) { break; }
            chunkedBody = request.bufDechunk(buf, bodyStart, len);
            reqEnd = cend;
            usedChunked = true;
        } else {

            let need = request.bufContentLength(buf, 0, hdrEnd);
            if (need > app.maxBodyBytes) {
                await io.sendStr(errResponse(413, "Payload Too Large"));
                alive = false;
                break;
            }
            while (len - bodyStart < need) {
                if (len >= cap) { alive = false; break; }
                let bn = await io.recvInto(buf + len, cap - len);
                if (bn <= 0) { alive = false; break; }
                len = len + bn;
            }
            if (!alive) { break; }
            reqEnd = bodyStart + need;
        }
        let wantClose = request.bufFindCI(buf, 0, hdrEnd, "connection: close") != -1;

        let (method, path) = request.bufMethodPath(buf, len);

        // Streaming (SSE) routes take over the connection: hand the raw stream
        // to the handler, which owns the socket until the client disconnects.
        // The connection is not reused afterwards.
        if (string.eql(method, "GET")) {
            let sm = app.sseRouter.resolve("GET", path);
            if (sm.matched) {
                let sho = app.sseHandlers.get(string.parseI64(sm.key) as int);
                if (sho != undefined) {
                    let sreq = request.Request.fromString(bytes.read_string(buf, reqEnd));
                    // Merge captured path parameters into the request query so
                    // the handler reads them uniformly via req.query.
                    sm.params.forEach((k, v) => { sreq.query.set(k, v); });
                    await sho.stream(sreq, io);
                    alive = false;
                    break;
                }
            }
        }

        let served = false;
        if (string.eql(method, "GET") && !usedChunked) {
            let c = app.cachedCopy(path);
            if (c != undefined) { await io.sendStr(c ?? ""); served = true; }
        }
        if (!served) {
            let raw = if (usedChunked)
                bytes.read_string(buf, hdrEnd) + "\r\n\r\n" + chunkedBody
            else
                bytes.read_string(buf, reqEnd);
            let sent = await app.respondMissTo(io, raw, method, path);
        }

        let leftover = len - reqEnd;
        if (leftover > 0) {
            let k = 0;
            while (k < leftover) {
                bytes.write_byte(buf, k, bytes.read_byte(buf, reqEnd + k));
                k = k + 1;
            }
        }
        len = leftover;

        if (wantClose) { alive = false; }
    }
    io.close();
    bytes.free(buf);
    return 0;
}


/// Serves one accepted connection on the reactor identified by `kq`: negotiates TLS and
/// ALPN if the app has TLS enabled (dispatching to the HTTP/2 or HTTP/1.1 handler based
/// on the negotiated protocol), otherwise serves plain HTTP/1.1 directly.
pub async fn serveReactorConn(app: App, fd: int, kq: int): int {
    let s = aio.AsyncStream(fd as long);
    s.kq = kq;
    if (app.tlsEnabled) {
        let tls = await asynctls.tlsAcceptAlpn(s, app.tlsCert, app.tlsKey, "h2,http/1.1");
        if (!tls.ok()) {
            tls.close();
            return -1;
        }
        if (tls.selectedAlpn() == "h2") {
            return await handleConnH2(app, tls);
        }
        return await handleConn(app, tls);
    }
    return await handleConn(app, s);
}

// Accepts incoming connections on lfd forever, spawning a coroutine per connection.
async fn reactorAcceptLoop(app: App, lfd: int, kq: int): void {
    while (true) {
        let s = await eventedio.reactorAccept(lfd, kq);
        if (s.isOpen()) {
            coroStart(serveReactorConn(app, s.fdOf(), kq));
        }
    }
}

// Binds and listens on app.serverPort (SO_REUSEPORT, non-blocking), then runs the reactor
// loop, accepting and serving connections directly, until the process exits.
fn reactorWorkerBody(app: App, idx: int): void {
    let lfd = sys.socket(sys.AF_INET, sys.SOCK_STREAM, 0);
    let one = bytes.alloc(4);
    bytes.write_i32(one, 0, 1);
    sys.setsockopt(lfd, sys.SOL_SOCKET(), 4, one, 4);
    sys.setReusePort(lfd);
    bytes.free(one);
    let sa = sys.makeSockaddrIn(app.serverPort, 0);
    if (sys.bind(lfd, sa, 16) != 0) {
        bytes.free(sa);
        return;
    }
    bytes.free(sa);
    sys.listen(lfd, 512);
    sys.setNonBlocking(lfd);

    let r = poller.Reactor(1024, 16384, 256);
    poller.setCurrent(r.kq);
    coroStart(reactorAcceptLoop(app, lfd, r.kq));

    while (true) {
        let n = r.pollComplete(-1);
        poller.batchBegin();
        let i = 0;
        while (i < n) {
            nova_reactor_resume(r.completedToken(i));
            i = i + 1;
        }
    }
}

// Receives already-accepted client file descriptors over ctrlFd forever, spawning a
// coroutine to serve each one; returns when the handoff channel is closed.
async fn handoffRecvLoop(app: App, ctrlFd: int, kq: int): void {
    while (true) {
        let clientFd = await eventedio.recvFdOp(ctrlFd, kq);
        if (clientFd < 0) { console.log("Nova web: proxyd handoff channel closed"); return; }
        socket.setNonBlock(clientFd);
        coroStart(serveReactorConn(app, clientFd, kq));
    }
}

// Connects to the proxy's Unix control socket at sockPath (retrying for up to 10s), then
// runs the reactor loop, receiving handed-off client connections instead of accepting directly.
fn reactorHandoffBody(app: App, sockPath: string): void {
    let ua = socket.makeSockaddrUn(sockPath);
    let ctrl = socket.newUnix();
    let ok = -1;
    let tries = 0;
    while (tries < 500) {
        ok = socket.connectSock(ctrl, ua, socket.sockaddrUnLen());
        if (ok == 0) { break; }
        socket.close(ctrl);
        ctrl = socket.newUnix();
        sys.nova_sleep_ms(20);
        tries = tries + 1;
    }
    bytes.free(ua);
    if (ok != 0) { console.log("Nova web: could not reach the service handoff socket " + sockPath); return; }
    socket.setNonBlock(ctrl);

    let r = poller.Reactor(1024, 16384, 256);
    poller.setCurrent(r.kq);
    coroStart(handoffRecvLoop(app, ctrl, r.kq));
    console.log("Nova web server listening (fd-handoff receiver on " + sockPath + ")");
    while (true) {
        let n = r.pollComplete(-1);
        poller.batchBegin();
        let i = 0;
        while (i < n) {
            nova_reactor_resume(r.completedToken(i));
            i = i + 1;
        }
    }
}

/// Binds and listens on `port` directly and runs the reactor loop, bypassing the
/// `NOVA_HANDOFF_SOCK` check that `run` performs. Does not return.
pub fn runReactor(self: App, port: int): void {
    let lfd = sys.socket(sys.AF_INET, sys.SOCK_STREAM, 0);
    let one = bytes.alloc(4);
    bytes.write_i32(one, 0, 1);
    sys.setsockopt(lfd, sys.SOL_SOCKET(), 4, one, 4);
    bytes.free(one);
    let sa = sys.makeSockaddrIn(port, 0);
    if (sys.bind(lfd, sa, 16) != 0) {
        bytes.free(sa);
        console.log("Nova web: failed to bind port (in use?)");
        return;
    }
    bytes.free(sa);
    sys.listen(lfd, 512);
    sys.setNonBlocking(lfd);

    let r = poller.Reactor(1024, 16384, 256);
    poller.setCurrent(r.kq);
    coroStart(reactorAcceptLoop(self, lfd, r.kq));
    console.log("Nova web server listening (Nova reactor)");

    while (true) {
        let n = r.pollComplete(-1);
        poller.batchBegin();
        let i = 0;
        while (i < n) {
            nova_reactor_resume(r.completedToken(i));
            i = i + 1;
        }
    }
}

