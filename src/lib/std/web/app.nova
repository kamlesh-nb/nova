
import net.aio;
import net.asynctls;
import net.poller;
import net.eventedio;
import os.sys;
import os.socket;
import io.file;
import web.request;
import web.response;
import web.status;
import serde.source;
import web.static_content;
import web.di;
import web.mediator;
import web.routing;
import web.http2.frame;
import web.http2.hpack;
import compress.gzip;
import string;
import list;
import map;
import bytes;
import assert;
import env;

// The request-dispatch mediator lives in web.mediator (MessageHandler + the async pipeline). The App
// composes it; it no longer declares its own. `text`/`json`/`html` response helpers also live there,
// and the thin wrappers below delegate to them so `app.text/json/html` keeps working.

// Routing lives in web.routing (the single Router: Route table + parsePattern + typed matcher). The App
// composes a Router for its route table and matches through `router.resolve`; it does not re-roll its
// own segment type or matching loop. Path parsing (pathSegs / isAllDigits) and request-body parsing
// (MultiMapSource / formSource / multipartSource) live in web.request -- the App calls them as
// `request.*` below.

// `text`/`json`/`html` response helpers live in web.mediator (their single definition). Because
// web.app imports web.mediator, they remain in scope for any module that imports web.app -- so a bare
// `json(...)` in a handler still resolves, with no duplicate definition to make it ambiguous.

pub class App {
    pub router: routing.Router,
    pub mediator: mediator.Mediator,
    pub static_mounts: List<static_content.StaticMount>,

    pub cache: Map<string, string>,
    pub cacheable: Map<string, bool>,

    pub provider: ServiceProvider,

    pub readTimeoutMs: int,
    pub maxHeaderBytes: int,
    pub maxBodyBytes: int,

    pub tlsEnabled: bool,
    pub tlsCert: string,
    pub tlsKey: string,

    // Response gzip is OFF by default: the pure-Nova DEFLATE is CPU-heavy (it dominated a profile of the
    // server -- ~60% of CPU compressing every response), so paying it on every request is the wrong
    // default. Opt in with `app.useGzip()` when responses are large/compressible enough to be worth it.
    pub gzipEnabled: bool,

    // The port the single reactor binds/serves on. Carried on the App so the reactor serve body reads it
    // off the App rather than threading a separate parameter through.
    pub serverPort: int,

    init() {
        self.router = routing.Router();
        self.provider = ServiceCollection().buildServiceProvider();
        // The runtime mediator: the compiler-generated `__registerHandlers` populates it with a handler
        // adapter (and any validators) for every request type that implements `Message`.
        self.mediator = mediator.Mediator(self.provider);
        __registerHandlers(self.mediator);
        self.static_mounts = List<static_content.StaticMount>();
        self.cache = Map<string, string>(16, string.hash);
        self.cacheable = Map<string, bool>(16, string.hash);
        self.readTimeoutMs = 30000;
        self.maxHeaderBytes = 32768;
        self.maxBodyBytes = 1048576;
        self.tlsEnabled = false;
        self.tlsCert = "";
        self.tlsKey = "";
        self.gzipEnabled = false;
        self.serverPort = 0;
    }

    // Opt in to response gzip (Content-Encoding: gzip for compressible responses >= 256 bytes when the
    // client sends Accept-Encoding: gzip). Off by default -- see the gzipEnabled field note.
    pub fn useGzip(self: App): void {
        self.gzipEnabled = true;
    }

    pub fn useTls(self: App, certPath: string, keyPath: string): void {
        let cert = File.readText(certPath);
        let key = File.readText(keyPath);
        if (cert.length > 0 && key.length > 0) {
            self.tlsCert = cert;
            self.tlsKey = key;
            self.tlsEnabled = true;
        }
    }

    pub fn configureServer(self: App, readTimeoutMs: int, maxHeaderBytes: int, maxBodyBytes: int): void {
        self.readTimeoutMs = readTimeoutMs;
        self.maxHeaderBytes = maxHeaderBytes;
        self.maxBodyBytes = maxBodyBytes;
    }

    pub fn useServices(self: App, sc: ServiceCollection): void {
        self.provider = sc.buildServiceProvider();
        // The mediator opens a scope off this provider for every `send`, so handlers and behaviours
        // share per-request scoped services (a DB connection, a unit of work).
        self.mediator.setProvider(self.provider);
    }

    // Register a cross-cutting behaviour that wraps every handler (logging, validation, timing, auth).
    // Behaviours run in registration order (first registered is outermost); each calls
    // `await next.proceed(ctx)` to continue, and may short-circuit by returning a Response.
    pub fn useBehavior(self: App, behavior: mediator.PipelineBehavior): void {
        self.mediator.useBehavior(behavior);
    }

    pub fn enableCache(self: App, path: string): void {
        self.cacheable.set(path, true);
    }

    pub fn cachedCopy(self: App, path: string): string | undefined {
        let hit = self.cache.get(path);
        if (hit != undefined) {
            let hv = hit ?? "";
            return string.slice(hv, 0, hv.length);
        }
        return undefined;
    }

    // Dispatch a request and WRITE the response straight to the socket. The common (non-cacheable) path
    // writes the header block and the body as two separate sends, so a large body is written directly from
    // its own buffer -- avoiding the serialize()-into-a-buffer + toString() double-copy (two full body
    // copies per request). Cacheable GET responses still build one string (the cache stores it).
    pub async fn respondMissTo(self: App, io: aio.AsyncIO, raw: string, method: string, path: string): int {
        let req = request.Request.fromString(raw);
        let resp = await self.dispatch(req);

        let ae = req.getHeader("accept-encoding") ?? "";
        let didGzip = false;
        if (self.gzipEnabled && string.contains(ae, "gzip") && resp.body.length >= 256) {
            let packed = gzip.compress(resp.body);
            if (packed.length > 0 && packed.length < resp.body.length) {
                resp.body = packed;
                resp.headers.set("Content-Encoding", "gzip");
                resp.headers.set("Content-Length", `${packed.length}`);
                didGzip = true;
            }
        }

        if (string.eql(method, "GET") && !didGzip && self.cacheable.get(path) != undefined) {
            let out = resp.serialize();                       // cacheable: one string, stored in the cache
            self.cache.set(path, string.slice(out, 0, out.length));
            return await io.sendStr(out);
        }
        // Response write. For a SMALL body, concatenate the header block + body and send in ONE syscall --
        // one write beats two when the extra copy is cheap. For a LARGE body (>= 64 KB) keep the two-part
        // write (header first, then the body from its own buffer) so we never re-copy a big payload.
        let hdrs = resp.serializeHeaders();
        if (resp.body.length == 0) { return await io.sendStr(hdrs); }
        if (resp.body.length < 65536) { return await io.sendStr(hdrs + resp.body); }
        let hn = await io.sendStr(hdrs);
        return await io.sendStr(resp.body);
    }

    pub fn useStatic(self: App, prefix: string, dir: string): void {
        self.static_mounts.push(static_content.StaticMount(prefix, dir, 128));
    }

    // Route registration delegates to the single Router. The key is serde.typeName<TReq>() -- the same
    // string the compiler registers the handler adapter under -- so a matched route resolves to its
    // handler through the mediator. The handler itself is discovered by its `RequestHandler<TReq, _>`
    // impl; there is nothing to register beyond the route.
    pub fn get<TReq>(self: App, path: string): void {
        self.router.__addRoute("GET", path, serde.typeName<TReq>());
    }
    pub fn post<TReq>(self: App, path: string): void {
        self.router.__addRoute("POST", path, serde.typeName<TReq>());
    }
    pub fn put<TReq>(self: App, path: string): void {
        self.router.__addRoute("PUT", path, serde.typeName<TReq>());
    }
    pub fn delete<TReq>(self: App, path: string): void {
        self.router.__addRoute("DELETE", path, serde.typeName<TReq>());
    }
    pub fn patch<TReq>(self: App, path: string): void {
        self.router.__addRoute("PATCH", path, serde.typeName<TReq>());
    }

    // Build the ValueSource the handler binds from: the body (JSON / form / multipart) for methods that
    // carry one, with the path params overlaid so a @fromRoute field wins over @fromBody. A GET has no
    // body, so it binds from the params alone.
    fn sourceFor(self: App, req: Request, params: Map<string, string>): ValueSource {
        // Overlay route params on the query string so a GET binds both `?a=b` filters and `{id}` path
        // params into its request DTO (route params win on a key clash).
        let merged = Map<string, string>(8, string.hash);
        req.query.forEach((k, v) => { merged.set(k, v); });
        params.forEach((k, v) => { merged.set(k, v); });
        let paramSrc = source.ParamSource(merged);
        if (string.eql(req.method, "POST") || string.eql(req.method, "PUT") || string.eql(req.method, "PATCH")) {
            let contentType = req.getHeader("content-type") ?? "";
            let ct = string.toLowerCase(contentType);
            if (string.indexOf(ct, "multipart/form-data") != -1) {
                return source.CompositeSource(paramSrc, request.multipartSource(contentType, req.body));
            }
            if (string.indexOf(ct, "x-www-form-urlencoded") != -1) {
                return source.CompositeSource(paramSrc, request.formSource(req.body));
            }
            return source.CompositeSource(paramSrc, source.fromJson(req.body));
        }
        return paramSrc;
    }

    pub async fn dispatch(self: App, req: Request): response.Response {
        let m = self.router.resolve(req.method, req.path);
        if (m.typedBad) {
            return response.Response(Status.BadRequest, "Bad Request: invalid path parameter");
        }
        if (m.matched) {
            // Bind the request source (route params over body), then hand off to the runtime mediator:
            // the compiler-generated `__mediator_dispatch_runtime` binds the typed request, widens it,
            // and calls `mediator.send`, which picks the handler by request type, opens a per-request DI
            // scope, runs the behaviour pipeline (validation, transactions, logging), and returns the
            // Response. The App never knows about handlers; it binds and sends.
            let src = self.sourceFor(req, m.params);
            return await __mediator_dispatch_runtime(m.key, src, self.mediator);
        }
        if (m.methodNotAllowed) {
            return response.Response(Status.MethodNotAllowed, "Method Not Allowed");
        }

        if (string.eql(req.method, "GET")) {
            let m = 0;
            let nm = self.static_mounts.size();
            while (m < nm) {
                let mount = self.static_mounts.at(m);
                let served = mount.serve(req.path);
                if (served != undefined) {
                    return served ?? response.Response(Status.NotFound, "Not Found");
                }
                m = m + 1;
            }
        }
        return response.Response(Status.NotFound, "Not Found");
    }

    pub fn run(self: App, port: int): void {
        // A web app is ALWAYS single-reactor: one reactor, one thread, per PROCESS. The reactor runs
        // INLINE on this (the calling) thread, so the App and its DI provider never cross a thread
        // boundary, which is what keeps per-request service resolution correct and lets ARC stay
        // non-atomic. TLS is included (serveReactorConn tlsAccepts when useTls is set). No Asio: the
        // reactor path carries the whole server (M4).
        //
        // To use more cores, run more INSTANCES of the binary (each with its own NOVA_PORT) behind proxyd
        // and let the orchestrator manage the replicas -- see the deployment guide. That is the one
        // supported scaling model; there is no in-process multi-reactor worker mode.
        self.serverPort = port;
        // fd-passing handoff mode: when NOVA_HANDOFF_SOCK names proxyd's AF_UNIX rendezvous, this app
        // does NOT bind a TCP port. Instead it connects to proxyd and serves client SOCKETS that proxyd
        // hands over (SCM_RIGHTS), replying to each client directly. proxyd is then out of the data path.
        // Single-reactor as always; the received fds are served with the identical request pipeline.
        let handoff = env.get("NOVA_HANDOFF_SOCK");
        if (!string.eql(handoff, "")) {
            reactorHandoffBody(self, handoff);
            return;
        }
        // Nova web is SINGLE-REACTOR by design: one reactor, one thread, per process. To use more cores,
        // run more INSTANCES of the binary behind proxyd and let the orchestrator manage the replicas --
        // that is the one supported scaling model. There is no in-process multi-reactor worker mode.
        reactorWorkerBody(self, 0);
    }
}

// HTTP wire framing (bufFindHeaderEnd / bufFindCI / bufContentLength / bufIsChunked / bufChunkedEnd /
// bufDechunk / bufMethodPath) now lives in web.request -- it is request parsing, not app logic. The
// server reader below calls it qualified as `request.*`. Only errResponse (a canned error REPLY, a
// response concern) stays here with the server.
fn errResponse(code: int, reason: string): string {
    return `HTTP/1.1 ${code} ${reason}\r\nContent-Length: 0\r\nConnection: close\r\n\r\n`;
}

// Read exactly n bytes from io into buf[off..]; false on EOF/error.
async fn h2ReadN(io: AsyncIO, buf: long, off: int, n: int): bool {
    let got = 0;
    while (got < n) {
        let r = await io.recvInto(buf + ((off + got) as long), n - got);
        if (r <= 0) { return false; }
        got = got + r;
    }
    return true;
}

fn h2BufToStr(buf: long, len: int): string {
    bytes.write_byte(buf, len, 0);
    bytes.write_i32(buf - 4, 0, len);
    return buf as string;
}

// Serve one HTTP/2 connection: verify the preface, exchange SETTINGS, then decode each request's HEADERS
// with HPACK, dispatch it through the SAME mediator/routing as HTTP/1.1 (await self.dispatch), and write the
// response as HEADERS + DATA. PING is answered; SETTINGS is ACKed; GOAWAY ends the loop. One
// request/response per stream (no request body), which covers hypermedia GET/POST-form traffic.
async fn handleConnH2(app: App, io: AsyncIO): int {
    let dec = hpack.newHpack();
    let enc = hpack.newHpack();
    let hdr: long = bytes.alloc(9);
    let pre: long = bytes.alloc(24);

    if (!(await h2ReadN(io, pre, 0, 24))) { return 0; }
    let k = 0;
    while (k < 24) { if (bytes.read_byte(pre, k) != frame.PREFACE[k]) { return 0; } k = k + 1; }

    let sbuf: long = bytes.alloc(64);
    let sl = frame.writeSettingsEmpty(sbuf, 0);
    if ((await io.sendStr(h2BufToStr(sbuf, sl))) < 0) { return 0; }

    let running = true;
    while (running) {
        if (!(await h2ReadN(io, hdr, 0, 9))) { running = false; }
        if (running) {
            let fh = frame.readHeader(hdr, 0);
            let pay: long = bytes.alloc(fh.length + 1);
            if (fh.length > 0) {
                if (!(await h2ReadN(io, pay, 0, fh.length))) { running = false; }
            }
            if (running) {
                if (fh.ftype == frame.FRAME_SETTINGS) {
                    if ((fh.flags & frame.FLAG_ACK) == 0) {
                        let ab: long = bytes.alloc(16);
                        let al = frame.writeSettingsAck(ab, 0);
                        if ((await io.sendStr(h2BufToStr(ab, al))) < 0) { running = false; }
                    }
                } else if (fh.ftype == frame.FRAME_PING) {
                    if ((fh.flags & frame.FLAG_ACK) == 0) {
                        let pb: long = bytes.alloc(32);
                        let pl = frame.writePingAck(pb, 0, pay, 0);
                        if ((await io.sendStr(h2BufToStr(pb, pl))) < 0) { running = false; }
                    }
                } else if (fh.ftype == frame.FRAME_GOAWAY) {
                    running = false;
                } else if (fh.ftype == frame.FRAME_HEADERS) {
                    let boff = 0;
                    let blen = fh.length;
                    if ((fh.flags & frame.FLAG_PADDED) != 0) { let padL = bytes.read_byte(pay, 0); boff = 1; blen = fh.length - 1 - padL; }
                    if ((fh.flags & frame.FLAG_PRIORITY) != 0) { boff = boff + 5; blen = blen - 5; }
                    if (blen < 0) { blen = 0; }
                    let fields = dec.decode(pay, boff, blen);
                    if ((fh.flags & frame.FLAG_END_STREAM) != 0) {
                        let req = h2BuildRequest(fields);
                        let resp = await app.dispatch(req);
                        let rf = List<hpack.HeaderField>();
                        rf.push(hpack.HeaderField(":status", `${Status.toCode(resp.status)}`));
                        let hk = resp.headers.keys();
                        let hi = 0;
                        while (hi < hk.size()) {
                            let key = hk.get(hi) ?? "";
                            let lk = h2Lower(key);
                            // Connection-specific headers are illegal in HTTP/2.
                            if (lk != "connection" && lk != "keep-alive" && lk != "transfer-encoding" && lk != "upgrade") {
                                rf.push(hpack.HeaderField(lk, resp.headers.get(key) ?? ""));
                            }
                            hi = hi + 1;
                        }
                        let (hb, hbLen) = enc.encode(rf);
                        let body = resp.body;
                        let hasBody = body.length > 0;
                        let hflags = frame.FLAG_END_HEADERS;
                        if (!hasBody) { hflags = hflags | frame.FLAG_END_STREAM; }
                        let rbuf: long = bytes.alloc(hbLen + 64);
                        let ro = frame.writeFrame(rbuf, 0, frame.FRAME_HEADERS, hflags, fh.streamId, hb, 0, hbLen);
                        if ((await io.sendStr(h2BufToStr(rbuf, ro))) < 0) { running = false; }
                        if (running && hasBody) {
                            let dbuf: long = bytes.alloc(body.length + 16);
                            let dl = frame.writeFrame(dbuf, 0, frame.FRAME_DATA, frame.FLAG_END_STREAM, fh.streamId, body as long, 0, body.length);
                            if ((await io.sendStr(h2BufToStr(dbuf, dl))) < 0) { running = false; }
                        }
                    }
                }
            }
        }
    }
    io.close();
    return 1;
}

fn h2Lower(s: string): string {
    let out = bytes.alloc(s.length + 1);
    let i = 0;
    while (i < s.length) {
        let c = s[i];
        if (c >= 'A' && c <= 'Z') { c = c + 32; }
        bytes.write_byte(out, i, c);
        i = i + 1;
    }
    bytes.write_byte(out, s.length, 0);
    bytes.write_i32(out - 4, 0, s.length);
    return out as string;
}

fn h2GetPseudo(fields: List<hpack.HeaderField>, name: string): string {
    let i = 0;
    while (i < fields.size()) {
        let f = fields.at(i);
        if (f.name == name) { return f.value; }
        i = i + 1;
    }
    return "";
}

fn h2BuildRequest(fields: List<hpack.HeaderField>): Request {
    let req = Request.empty();
    req.method = h2GetPseudo(fields, ":method");
    req.path = h2GetPseudo(fields, ":path");
    let i = 0;
    while (i < fields.size()) {
        let f = fields.at(i);
        if (f.name.length > 0 && f.name[0] != ':') { req.headers.set(f.name, f.value); }
        i = i + 1;
    }
    return req;
}

async fn handleConn(app: App, io: AsyncIO): int {
    let cap = 65536;
    let buf: long = bytes.alloc(cap);

    let len = 0;
    let alive = true;
    let tmo = app.readTimeoutMs;

    let _ = io.setTimeout(tmo);
    while (alive) {
        let hdrEnd = request.bufFindHeaderEnd(buf, 0, len);
        while (hdrEnd == -1) {
            if (len >= app.maxHeaderBytes || len >= cap) {
                await io.sendStr(errResponse(431, "Request Header Fields Too Large"));
                alive = false;
                break;
            }
            let hn = await io.recvInto(buf + len, cap - len);
            if (hn <= 0) { alive = false; break; }
            len = len + hn;
            hdrEnd = request.bufFindHeaderEnd(buf, 0, len);
        }
        if (!alive) { break; }

        if (request.bufFindCI(buf, 0, hdrEnd, "expect: 100-continue") != -1) {
            await io.sendStr("HTTP/1.1 100 Continue\r\n\r\n");
        }

        let bodyStart = hdrEnd + 4;
        let reqEnd = bodyStart;
        let chunkedBody = "";
        let usedChunked = false;

        if (request.bufIsChunked(buf, 0, hdrEnd)) {

            let cend = request.bufChunkedEnd(buf, bodyStart, len);
            while (cend == -1) {
                if ((len - bodyStart) >= app.maxBodyBytes) {
                    await io.sendStr(errResponse(413, "Payload Too Large"));
                    alive = false;
                    break;
                }
                if (len >= cap) { alive = false; break; }
                let bn = await io.recvInto(buf + len, cap - len);
                if (bn <= 0) { alive = false; break; }
                len = len + bn;
                cend = request.bufChunkedEnd(buf, bodyStart, len);
            }
            if (!alive) { break; }
            chunkedBody = request.bufDechunk(buf, bodyStart, len);
            reqEnd = cend;
            usedChunked = true;
        } else {

            let need = request.bufContentLength(buf, 0, hdrEnd);
            if (need > app.maxBodyBytes) {
                await io.sendStr(errResponse(413, "Payload Too Large"));
                alive = false;
                break;
            }
            while (len - bodyStart < need) {
                if (len >= cap) { alive = false; break; }
                let bn = await io.recvInto(buf + len, cap - len);
                if (bn <= 0) { alive = false; break; }
                len = len + bn;
            }
            if (!alive) { break; }
            reqEnd = bodyStart + need;
        }
        let wantClose = request.bufFindCI(buf, 0, hdrEnd, "connection: close") != -1;

        let (method, path) = request.bufMethodPath(buf, len);
        let served = false;
        if (string.eql(method, "GET") && !usedChunked) {
            let c = app.cachedCopy(path);
            if (c != undefined) { await io.sendStr(c ?? ""); served = true; }
        }
        if (!served) {
            let raw = if (usedChunked)
                bytes.read_string(buf, hdrEnd) + "\r\n\r\n" + chunkedBody
            else
                bytes.read_string(buf, reqEnd);
            // P2: respondMissTo writes the header block and the body as two separate sends, so a large body
            // is written straight from its own buffer -- no serialize append + toString double-copy.
            let sent = await app.respondMissTo(io, raw, method, path);
        }

        let leftover = len - reqEnd;
        if (leftover > 0) {
            let k = 0;
            while (k < leftover) {
                bytes.write_byte(buf, k, bytes.read_byte(buf, reqEnd + k));
                k = k + 1;
            }
        }
        len = leftover;

        if (wantClose) { alive = false; }
    }
    io.close();
    bytes.free(buf);
    return 0;
}


// Handle one connection on the Nova reactor (M2 of the C++ runtime retirement plan): wrap the
// accepted fd in a reactor-native AsyncStream (kq set) and run the same request pipeline as the
// Asio path. Because handleConn takes the AsyncIO trait and AsyncStream is reactor-native when kq>0,
// the whole request (parse, mediator, handler, response, and any await to a reactor-native database
// connection) runs on the reactor with no Asio.
pub async fn serveReactorConn(app: App, fd: int, kq: int): int {
    let s = aio.AsyncStream(fd as long);
    s.kq = kq;
    if (app.tlsEnabled) {
        // Inbound TLS on the reactor: the pure-Nova TLS 1.3 memory-BIO (TlsStream over net/tlsmembio) does its socket I/O
        // through the reactor-native AsyncStream, so the handshake and data path run on the reactor,
        // no Asio. TlsStream itself is an AsyncIO, so handleConn is unchanged.
        // Offer HTTP/2 via ALPN ("h2") with an HTTP/1.1 fallback. If the client negotiates h2 we run the
        // HTTP/2 framing loop; otherwise the connection is served as HTTP/1.1 exactly as before.
        let tls = await asynctls.tlsAcceptAlpn(s, app.tlsCert, app.tlsKey, "h2,http/1.1");
        if (!tls.ok()) {
            tls.close();
            return -1;
        }
        if (tls.selectedAlpn() == "h2") {
            return await handleConnH2(app, tls);
        }
        return await handleConn(app, tls);
    }
    return await handleConn(app, s);
}

// Accept loop as a reactor coroutine (completion model): await one accepted connection at a time and
// spawn a serve coroutine for it. This replaces the old inline "listener readable -> drain backlog"
// branch, so the reactor's poll loop is uniform (every ready item is just a coroutine to resume) and
// maps directly onto IOCP AcceptEx. Loops forever.
async fn reactorAcceptLoop(app: App, lfd: int, kq: int): void {
    while (true) {
        let s = await eventedio.reactorAccept(lfd, kq);
        if (s.isOpen()) {
            coroStart(serveReactorConn(app, s.fdOf(), kq));
        }
    }
}

// One reactor worker thread: its own reactor, its own SO_REUSEPORT listener on the shared port (the
// kernel load-balances connections across the threads), its own coroutines. Share-nothing: the only
// thing crossing threads is the App configuration, which is read-only during serving. Loops forever.
fn reactorWorkerBody(app: App, idx: int): void {
    let lfd = sys.socket(sys.AF_INET, sys.SOCK_STREAM, 0);
    let one = bytes.alloc(4);
    bytes.write_i32(one, 0, 1);
    sys.setsockopt(lfd, sys.SOL_SOCKET(), 4, one, 4);   // SO_REUSEADDR
    sys.setReusePort(lfd);
    bytes.free(one);
    let sa = sys.makeSockaddrIn(app.serverPort, 0);
    if (sys.bind(lfd, sa, 16) != 0) {
        bytes.free(sa);
        return;
    }
    bytes.free(sa);
    sys.listen(lfd, 512);
    sys.setNonBlocking(lfd);

    let r = poller.Reactor(1024, 16384, 256);
    poller.setCurrent(r.kq);
    coroStart(reactorAcceptLoop(app, lfd, r.kq));

    while (true) {
        let n = r.pollComplete(-1);
        poller.batchBegin();
        let i = 0;
        while (i < n) {
            nova_reactor_resume(r.completedToken(i));
            i = i + 1;
        }
    }
}

// fd-passing handoff receiver: instead of accepting TCP, receive client SOCKETS that proxyd hands over
// its AF_UNIX control channel (SCM_RIGHTS), and serve each on this reactor with the identical request
// pipeline (serveReactorConn). The app replies to each client DIRECTLY, so proxyd never sees the
// response. Each received fd becomes its own coroutine, exactly like an accepted connection.
async fn handoffRecvLoop(app: App, ctrlFd: int, kq: int): void {
    while (true) {
        // recvFdOp waits for readability on the reactor and recvmsg's ONE handed-off client fd (or -1 if
        // proxyd closed the channel). Each received fd becomes its own serve coroutine, exactly like an
        // accepted connection; the app reads the request off it and replies directly to the client.
        let clientFd = await eventedio.recvFdOp(ctrlFd, kq);
        if (clientFd < 0) { console.log("Nova web: proxyd handoff channel closed"); return; }
        socket.setNonBlock(clientFd);
        coroStart(serveReactorConn(app, clientFd, kq));
    }
}

// Single-reactor handoff receiver body: connect to proxyd's rendezvous (retrying, as proxyd may still
// be starting), then drive the reactor forever serving handed-off connections. Mirrors reactorWorkerBody
// but with a handoff receive loop in place of the TCP accept loop.
fn reactorHandoffBody(app: App, sockPath: string): void {
    let ua = socket.makeSockaddrUn(sockPath);
    let ctrl = socket.newUnix();
    let ok = -1;
    let tries = 0;
    // Retry with a real backoff (20ms) so the app reliably waits for the service to bind the rendezvous,
    // regardless of launch ordering; ~500 tries ≈ 10s before giving up (a tight spin used to race the
    // service and exhaust before the socket appeared).
    while (tries < 500) {
        ok = socket.connectSock(ctrl, ua, socket.sockaddrUnLen());
        if (ok == 0) { break; }
        socket.close(ctrl);
        ctrl = socket.newUnix();
        sys.nova_sleep_ms(20);
        tries = tries + 1;
    }
    bytes.free(ua);
    if (ok != 0) { console.log("Nova web: could not reach the service handoff socket " + sockPath); return; }
    socket.setNonBlock(ctrl);

    let r = poller.Reactor(1024, 16384, 256);
    poller.setCurrent(r.kq);
    coroStart(handoffRecvLoop(app, ctrl, r.kq));
    console.log("Nova web server listening (fd-handoff receiver on " + sockPath + ")");
    while (true) {
        let n = r.pollComplete(-1);
        poller.batchBegin();
        let i = 0;
        while (i < n) {
            nova_reactor_resume(r.completedToken(i));
            i = i + 1;
        }
    }
}

// Run the web server on a single Nova reactor (no Asio). Opt-in via runReactor; the default run()
// keeps the Asio path. Each accepted connection becomes a coroutine driven by the reactor.
pub fn runReactor(self: App, port: int): void {
    let lfd = sys.socket(sys.AF_INET, sys.SOCK_STREAM, 0);
    let one = bytes.alloc(4);
    bytes.write_i32(one, 0, 1);
    sys.setsockopt(lfd, sys.SOL_SOCKET(), 4, one, 4);   // SO_REUSEADDR
    bytes.free(one);
    let sa = sys.makeSockaddrIn(port, 0);
    if (sys.bind(lfd, sa, 16) != 0) {
        bytes.free(sa);
        console.log("Nova web: failed to bind port (in use?)");
        return;
    }
    bytes.free(sa);
    sys.listen(lfd, 512);
    sys.setNonBlocking(lfd);

    let r = poller.Reactor(1024, 16384, 256);
    poller.setCurrent(r.kq);
    coroStart(reactorAcceptLoop(self, lfd, r.kq));
    console.log("Nova web server listening (Nova reactor)");

    while (true) {
        let n = r.pollComplete(-1);
        poller.batchBegin();
        let i = 0;
        while (i < n) {
            nova_reactor_resume(r.completedToken(i));
            i = i + 1;
        }
    }
}

