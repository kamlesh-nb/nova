//! web/config.nova -- framework application configuration.
//!
//! An app's configuration is read from its MANIFEST FILE (app.yaml), never from environment variables.
//! Env vars are process-global and collide when several apps (or several replicas) share a machine, and
//! routing config through a shared parent process (the way an orchestrator would set-then-spawn) races.
//! A file avoids all of that: each app/replica reads its own manifest, and the orchestrator points each
//! one at its manifest with a single `--config <path>` argument (conflict-free, one per workload). With
//! no argument the loader falls back to `app.yaml` in the working directory, so a bare local run works.
//!
//! The loader lives in the framework so an app does NOT write its own settings plumbing. The app only
//! declares its OWN `@serializable` config structs and binds them by section:
//!
//!     let cfg = config.load();
//!     let db  = cfg.bind<DbConfig>("db");     // reads the `config.db` section of app.yaml
//!     app.run(cfg.port(8080));                // per-replica port from `--port`, else manifest, else default
//!
//! app.yaml holds the app config under a top-level `config:` mapping of typed sections:
//!
//!     config:
//!       db: { dsn: "...", poolSize: 32 }
//!       payment: { provider: stripe }
//!
//! Secrets are NOT committed in app.yaml; the orchestrator supplies them by writing the delivered
//! manifest with the secret sections filled in, so they reach the app through the same file, never env.

import serde.source;
import string;
import list;
import env;
import io.file;

pub class AppConfig {
    // The `config:` subtree of the manifest, as a ValueSource (YAML-backed).
    root: ValueSource,
    // The process argv, used for `--config` / `--port` (these are ARGUMENTS, not environment variables).
    argv: list.List<string>,

    init(root: ValueSource, argv: list.List<string>) {
        self.root = root;
        self.argv = argv;
    }

    // Bind a typed, @serializable section: `cfg.bind<DbConfig>("db")` reads `config.db`. Missing keys
    // fall back to the struct's own defaults (the same serde binder the web framework uses for bodies).
    pub fn bind<T>(self: AppConfig, section: string): T {
        return serde.bind<T>(self.root.getChild(section));
    }

    // A single scalar under `config:` (for apps that do not want a typed struct).
    pub fn getString(self: AppConfig, key: string): string { return self.root.getString(key); }
    pub fn getInt(self: AppConfig, key: string): long { return self.root.getInt(key); }

    // A CLI flag value: `--name value`, "" when absent. Reads argv, never the environment.
    pub fn flag(self: AppConfig, name: string): string {
        let i = 0;
        while (i + 1 < self.argv.size()) {
            if (string.eql(self.argv.get(i) ?? "", name)) { return self.argv.get(i + 1) ?? ""; }
            i = i + 1;
        }
        return "";
    }

    // The listen port: the orchestrator passes `--port N` per replica (distinct per replica); otherwise a
    // top-level `port:` in the manifest; otherwise `dflt`. No NOVA_PORT env var.
    pub fn port(self: AppConfig, dflt: int): int {
        let f = self.flag("--port");
        if (!string.eql(f, "")) { return string.parseInt(f) ?? dflt; }
        let p = self.root.getInt("port");
        if (p > 0) { return p as int; }
        return dflt;
    }
}

// The manifest path: `--config <path>` when the orchestrator passes it, else `app.yaml` in the working
// directory for a local run.
fn configPath(argv: list.List<string>): string {
    let i = 0;
    while (i + 1 < argv.size()) {
        if (string.eql(argv.get(i) ?? "", "--config")) { return argv.get(i + 1) ?? "app.yaml"; }
        i = i + 1;
    }
    return "app.yaml";
}

// Load the app config from its manifest. Reads the `config:` subtree; a missing file yields an empty
// config so binds fall back to their struct defaults (a local run with no manifest still starts).
pub fn load(): AppConfig {
    let argv = env.args();
    let path = configPath(argv);
    let text = if (File.exists(path)) File.readText(path) else "";
    let root = source.fromYaml(text).getChild("config");
    return AppConfig(root, argv);
}
