//! Explicit request-handler registration for the Nova web framework.
//!
//! A `HandlerRegistry` is the visible, navigable record of which request
//! handler serves each command type. It is a sibling of `web.di.ServiceCollection`,
//! deliberately NOT part of it: services are the things injected INTO handlers,
//! whereas handlers are the request-processing layer that consumes them, so the
//! two live in separate collections. Registering `Register -> RegisterHandler`
//! here does two jobs:
//!
//!   1. it documents the wiring at one source line, so a reader (or the LSP
//!      go-to-definition) can jump from the command type to the handler that
//!      serves it, and
//!   2. it gates dispatch: a route bound to a command that has no registered
//!      handler is refused, rather than being resolved by silent convention.
//!
//! Registration is by command type, the same key `app.post<TCmd>(path)` binds a
//! route under, so a route and its handler are joined by naming the same command
//! type in both places:
//!
//! ```
//! let handlers = HandlerRegistry();
//! handlers.add<Register, RegisterHandler>();   // Register  -> RegisterHandler
//! app.useHandlers(handlers);
//! app.post<Register>("/register");             // route bound to Register
//! ```
//!
//! An empty registry means the app never opted in, and the framework falls back
//! to auto-discovery of every `RequestHandler` implementation (the legacy
//! behaviour), so existing apps keep working unchanged.

import string;
import map;
import serde.source;


/// The set of request handlers an app exposes, keyed by command type name.
///
/// The value stored against each command key is the handler's own type name.
/// It is not used for dispatch (the compiler-generated adapter table does the
/// actual work); it is kept so `describe` can report the wiring and so a future
/// tooling pass can surface the command-to-handler map.
pub struct HandlerRegistry {
    /// Command type name (`serde.typeName<TCmd>()`) mapped to handler type name.
    pub handlers: Map<string, string>,

    init() {
        self.handlers = Map<string, string>(32, string.hash);
    }

    /// Registers `THandler` as the handler for command `TCmd`.
    ///
    /// `TCmd` is the dispatch key: it must match the type a route was bound to
    /// with `app.post<TCmd>` / `app.get<TCmd>` and so on. `THandler` names the
    /// concrete `RequestHandler<TCmd, Response>` implementation that serves it;
    /// it is recorded for reporting and navigation.
    pub fn add<TCmd, THandler>(self: HandlerRegistry): void {
        self.handlers.set(serde.typeName<TCmd>(), serde.typeName<THandler>());
    }

    /// True if a handler was registered for the command keyed by `key`.
    pub fn has(self: HandlerRegistry, key: string): bool {
        return self.handlers.get(key) != undefined;
    }

    /// The number of registered handlers. Zero means the registry is unused, and
    /// the app falls back to auto-discovery of every `RequestHandler`.
    pub fn size(self: HandlerRegistry): int {
        return self.handlers.size();
    }

    /// The handler type name registered for `key`, or `undefined` if none is.
    pub fn handlerFor(self: HandlerRegistry, key: string): string | undefined {
        return self.handlers.get(key);
    }
}
