
import string;
import str;
import list;
import map;
import bytes;
import assert;
import os.sys;
import collections.string_builder;
import web.status;
import web.request;
import compress.gzip;

// memchr (SIMD-backed) delimiter scan, shared shape with web/request. Response.parse uses it for the
// client side (parsing responses from external calls); serialize builds into one StringBuilder buffer
// instead of a List<string> + join + concat chain.
fn idxByte(buf: long, start: int, end: int, b: int): int {
    if (start >= end) { return -1; }
    let p = sys.memchr(buf + (start as long), b, (end - start) as long);
    if (p == 0) { return -1; }
    return (p - buf) as int;
}

// case-insensitive ASCII equality, no allocation.
fn ciEquals(a: string, b: string): bool {
    if (a.length != b.length) { return false; }
    let i = 0;
    while (i < a.length) {
        let ca = a[i];
        let cb = b[i];
        if (ca >= 65 && ca <= 90) { ca = ca + 32; }
        if (cb >= 65 && cb <= 90) { cb = cb + 32; }
        if (ca != cb) { return false; }
        i = i + 1;
    }
    return true;
}

// HTML-escape a string for safe interpolation into an NSX / hypermedia view. NSX inserts a `{expr}`
// string RAW (so pre-rendered fragments compose), which means any text that could contain HTML-special
// characters must be escaped by the caller. This is the one canonical escaper so views (and `.nsx` files)
// do not each redefine their own: `{response.escapeHtml(user.name)}`. It replaces the five characters that
// matter in element text and double-quoted attribute values: & < > " '.
// Escape `s` and append the result DIRECTLY into a render StringBuilder -- no intermediate string. This
// is the hot path the NSX codegen calls for every `{expr}` interpolation: clean runs are memcpy'd in via
// appendRange (zero allocation) and only the five metacharacters expand to entity literals (which are
// immortal string constants, so also allocation-free). A 200-card page interpolates ~1200 values; the old
// escapeHtml(...)->append allocated one escaped string per value, which this eliminates entirely.
pub fn escapeHtmlInto(sb: StringBuilder, s: string): void {
    let n = string.len(s);
    let base = s as long;
    let runStart = 0;
    // SWAR bulk scan: `nova_html_find_meta` returns the next metacharacter index (8 bytes/iteration,
    // branch-free) or `n`. For clean text (the overwhelming majority of interpolated values) this is ONE
    // call that scans the whole value; each metacharacter then costs one more call. The clean runs between
    // metacharacters are copied wholesale via appendRange (zero per-byte work).
    let m = nova_html_find_meta(base, 0, n);
    while (m < n) {
        if (m > runStart) { sb.appendRange(s, runStart, m); }
        let c = s[m];
        if (c == 38) { sb.append("&amp;"); }
        else if (c == 60) { sb.append("&lt;"); }
        else if (c == 62) { sb.append("&gt;"); }
        else if (c == 34) { sb.append("&quot;"); }
        else { sb.append("&#39;"); }
        runStart = m + 1;
        m = nova_html_find_meta(base, runStart, n);
    }
    if (n > runStart) { sb.appendRange(s, runStart, n); }
}

// P10: HTML-escape a BORROWED view straight into the builder -- the clean runs are copied byte-for-byte
// out of the borrowed buffer (appendBytes), so NO owned intermediate string is minted. This is the render
// sink that lets a DB cell (a StrView over the row buffer) or a constant template chunk flow to the output
// without the ~1 owned-string allocation per interpolated value that escapeHtmlInto(string) costs.
pub fn escapeHtmlIntoView(sb: StringBuilder, v: str.Str): void {
    let base = v.ptr;
    let n = v.len;
    let runStart = 0;
    let m = nova_html_find_meta(base, 0, n);
    while (m < n) {
        if (m > runStart) { sb.appendBytes(base + (runStart as long), m - runStart); }
        let c = bytes.read_byte(base, m);
        if (c == 38) { sb.append("&amp;"); }
        else if (c == 60) { sb.append("&lt;"); }
        else if (c == 62) { sb.append("&gt;"); }
        else if (c == 34) { sb.append("&quot;"); }
        else { sb.append("&#39;"); }
        runStart = m + 1;
        m = nova_html_find_meta(base, runStart, n);
    }
    if (n > runStart) { sb.appendBytes(base + (runStart as long), n - runStart); }
}

pub fn escapeHtml(s: string): string {
    let n = string.len(s);
    // Fast path: scan once for anything needing escaping. The overwhelming majority of interpolated
    // values (names, descriptions, URLs) contain no HTML metacharacters, so return the input UNCHANGED
    // with zero allocation. The old code allocated a one-character string per byte (string.slice(s,i,i+1))
    // even for clean text, which made rendering O(bytes) allocations and was the response-build throughput
    // ceiling (~43 MB/s) -- a large product page is mostly clean description text.
    let first = -1;
    let k = 0;
    while (k < n) {
        let c = s[k];
        if (c == 38 || c == 60 || c == 62 || c == 34 || c == 39) { first = k; break; }
        k = k + 1;
    }
    if (first == -1) { return s; }
    // Slow path: copy safe RUNS between metacharacters in one slice each, not byte by byte.
    let sb = StringBuilder();
    if (first > 0) { sb.append(string.slice(s, 0, first)); }
    let i = first;
    let runStart = first;
    while (i < n) {
        let c = s[i];
        if (c == 38 || c == 60 || c == 62 || c == 34 || c == 39) {
            if (i > runStart) { sb.append(string.slice(s, runStart, i)); }
            if (c == 38) { sb.append("&amp;"); }
            else if (c == 60) { sb.append("&lt;"); }
            else if (c == 62) { sb.append("&gt;"); }
            else if (c == 34) { sb.append("&quot;"); }
            else { sb.append("&#39;"); }
            runStart = i + 1;
        }
        i = i + 1;
    }
    if (i > runStart) { sb.append(string.slice(s, runStart, i)); }
    return sb.toString();
}

// The standard error side of a typed handler's `TResp | HttpError` return. A handler returns the ok
// DTO for success (the framework serialises it as 200 JSON) or an `HttpError` for failure, which the
// framework turns into a Response via `toResponse()`: the given status code and the message as the body.
pub struct HttpError {
    pub status: int,
    pub message: string,

    init(status: int, message: string) {
        self.status = status;
        self.message = message;
    }

    pub fn toResponse(self: HttpError): Response {
        let r = Response(Status.fromCode(self.status), self.message);
        return r;
    }
}

pub struct Response {
    pub status: Status,
    pub body: string,
    pub headers: Map<string, string>,
    pub cookies: Map<string, string>,

    init(stat: Status, body: string) {
        self.status = stat;
        self.body = body;
        self.headers = Map<string, string>(16, string.hash);
        self.cookies = Map<string, string>(16, string.hash);
    }

    pub fn ok(body: string): Response {
        return Response(Status.Ok, body);
    }

    pub fn withHeaders(stat: Status, body: string, headers: Map<string, string>): Response {
        let cookies = Map<string, string>(16, string.hash);
        return Response{
            status: stat,
            body: body,
            headers: headers,
            cookies: cookies,
        };
    }

    pub fn setHeader(self: Response, key: string, value: string): Response {
        self.headers.set(key, value);
        return self;
    }

    pub fn setCookie(self: Response, name: string, value: string): Response {
        self.cookies.set(name, value);
        return self;
    }

    pub fn getHeader(self: Response, name: string): string | undefined {
        let keys = self.headers.keys();
        let keysLen = keys.size();
        let i = 0;
        while (i < keysLen) {
            let key = keys.get(i) ?? "";
            if (ciEquals(key, name)) {
                return self.headers.get(key);
            }
            i = i + 1;
        }
        return undefined;
    }

    pub fn serialize(self: Response): string {
        if (self.headers.get("Content-Length") == undefined) {
            self.headers.set("Content-Length", intToStr(self.body.length));
        }

        // one growable buffer, no List/join/concat chain. Pre-size it to the body plus header headroom so
        // a large body (e.g. a static asset) is copied once, not re-copied through ~log2(n) doublings.
        let sb = string_builder.StringBuilder();
        sb.ensureCapacity(self.body.length + 512);
        sb.append("HTTP/1.1 ");
        sb.append(intToStr(Status.toCode(self.status)));
        sb.append(" ");
        sb.append(Status.reasonPhrase(self.status));
        sb.append("\r\n");
        self.headers.forEach((key, value) => {
            sb.append(key);
            sb.append(": ");
            sb.append(value);
            sb.append("\r\n");
        });
        self.cookies.forEach((key, value) => {
            sb.append("Set-Cookie: ");
            sb.append(key);
            sb.append("=");
            sb.append(value);
            sb.append("; Path=/\r\n");
        });
        sb.append("\r\n");
        sb.append(self.body);
        return sb.toString();
    }

    // Just the status line + headers + cookies + the blank line -- NOT the body. Lets the server write the
    // header block and the (large) body as two separate sends, so the body is written straight from its
    // existing buffer instead of being appended into a serialize buffer AND copied out by toString (two
    // full body copies). Content-Length is set from the body length the caller will send next.
    pub fn serializeHeaders(self: Response): string {
        if (self.headers.get("Content-Length") == undefined) {
            self.headers.set("Content-Length", intToStr(self.body.length));
        }
        let sb = string_builder.StringBuilder();
        sb.ensureCapacity(512);
        sb.append("HTTP/1.1 ");
        sb.append(intToStr(Status.toCode(self.status)));
        sb.append(" ");
        sb.append(Status.reasonPhrase(self.status));
        sb.append("\r\n");
        self.headers.forEach((key, value) => {
            sb.append(key);
            sb.append(": ");
            sb.append(value);
            sb.append("\r\n");
        });
        self.cookies.forEach((key, value) => {
            sb.append("Set-Cookie: ");
            sb.append(key);
            sb.append("=");
            sb.append(value);
            sb.append("; Path=/\r\n");
        });
        sb.append("\r\n");
        return sb.toString();
    }

    // Parse a raw HTTP/1 response (client side: external calls). memchr offset scan, no split/join.
    pub fn parse(raw: string): Response {
        let n = raw.length;
        let buf = raw as long;

        let eol = idxByte(buf, 0, n, 13); // CR ending the status line
        if (eol < 0) { return Response(Status.Ok, ""); }

        // status line: HTTP/1.1 CODE REASON
        let sp1 = idxByte(buf, 0, eol, 32);
        let code = 200;
        if (sp1 >= 0) {
            let sp2 = idxByte(buf, sp1 + 1, eol, 32);
            let code_end = if (sp2 >= 0) sp2 else eol;
            code = string.parseI64(string.slice(raw, sp1 + 1, code_end)) as int;
        }
        let stat = Status.fromCode(code);

        let pos = eol + 2;
        let headers = Map<string, string>(16, string.hash);
        while (pos < n) {
            if (bytes.read_byte(buf, pos) as int == 13) { // blank line -> end of headers
                pos = pos + 2;
                break;
            }
            let line_end = idxByte(buf, pos, n, 13);
            if (line_end < 0) { break; }
            let colon = idxByte(buf, pos, line_end, 58);
            if (colon >= 0) {
                let key = string.slice(raw, pos, colon);
                let v_off = colon + 1;
                while (v_off < line_end && (bytes.read_byte(buf, v_off) as int == 32)) {
                    v_off = v_off + 1;
                }
                let val = string.slice(raw, v_off, line_end);
                headers.set(key, val);
            }
            pos = line_end + 2;
        }

        let body = if (pos <= n) string.slice(raw, pos, n) else "";

        // Decode the transfer/content encodings so callers see the actual payload. Chunked framing is
        // decoded with the same engine the server read path uses (request.bufDechunk over the body's
        // bytes); a gzip Content-Encoding is then inflated. A string's bytes are addressable via
        // `body as long`, so no copy into a separate buffer is needed.
        let te = decodedHeader(headers, "transfer-encoding");
        if (string.contains(te, "chunked")) {
            body = request.bufDechunk(body as long, 0, body.length);
        }
        let ce = decodedHeader(headers, "content-encoding");
        if (string.contains(ce, "gzip")) {
            body = gzip.decompress(body);
        }
        return Response.withHeaders(stat, body, headers);
    }
}

// Case-insensitive header lookup returning a lowercased value (or ""), for content-negotiation checks.
fn decodedHeader(headers: Map<string, string>, name: string): string {
    let keys = headers.keys();
    let i = 0;
    while (i < keys.size()) {
        let k = keys.get(i) ?? "";
        if (ciEquals(k, name)) { return string.toLowerCase(headers.get(k) ?? ""); }
        i = i + 1;
    }
    return "";
}

@test
fn test_parse_content_length(): void {
    let raw = "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 5\r\n\r\nhello";
    let r = Response.parse(raw);
    assert.equalInt(Status.toCode(r.status), 200);
    assert.equalStr(r.body, "hello");
    assert.equalStr(r.getHeader("Content-Type") ?? "", "text/plain");
}

@test
fn test_parse_chunked(): void {
    let raw = "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n4\r\nWiki\r\n5\r\npedia\r\n0\r\n\r\n";
    let r = Response.parse(raw);
    assert.equalInt(Status.toCode(r.status), 200);
    assert.equalStr(r.body, "Wikipedia");
}

fn intToStr(val: int): string {
    if (val == 0) return "0";
    let temp = val;
    let digits = 0;
    while (temp > 0) {
        digits = digits + 1;
        temp = temp / 10;
    }

    let str_ptr = bytes.alloc(digits);
    let i = digits - 1;
    temp = val;
    while (i >= 0) {
        bytes.write_byte(str_ptr, i, (temp % 10) + 48);
        temp = temp / 10;
        i = i - 1;
    }
    return str_ptr as string;
}
