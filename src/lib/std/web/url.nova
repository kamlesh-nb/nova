
//! URL percent-encoding and decoding (`application/x-www-form-urlencoded` style).
//!
//! This module provides `encode` and `decode` for turning raw bytes into a
//! form safe to embed in a URL query string or a form-encoded request body,
//! and back again. Spaces are encoded as `+` (not `%20`), matching the
//! `application/x-www-form-urlencoded` convention used by HTML forms and
//! query strings, rather than the stricter RFC 3986 path/component encoding.
//! It is used by the web framework wherever query parameters or form bodies
//! need to move between wire format and plain Nova strings.

import collections.string_builder;
import assert;

/// Uppercase hex digits used when emitting `%XX` escapes.
const HEX_CHARS = "0123456789ABCDEF";

/// Reports whether byte `c` may appear unescaped: ASCII letters, digits,
/// and the characters `-`, `_`, `.`, `~`.
fn isUnreserved(c: int): bool {
    if (c >= 65 && c <= 90) return true;
    if (c >= 97 && c <= 122) return true;
    if (c >= 48 && c <= 57) return true;
    if (c == 45 || c == 95 || c == 46 || c == 126) return true;
    return false;
}

fn hexVal(c: int): int {
    if (c >= 48 && c <= 57) return c - 48;
    if (c >= 97 && c <= 102) return c - 97 + 10;
    if (c >= 65 && c <= 70) return c - 65 + 10;
    return -1;
}

pub fn encode(raw: string): string {
    let sb = string_builder.StringBuilder();
    let len = raw.length;
    let i = 0;
    while (i < len) {
        let c = raw[i];
        if (isUnreserved(c)) {
            sb.appendChar(c);
        } else if (c == 32) {
            sb.appendChar(43);
        } else {
            sb.appendChar(37);
            sb.appendChar(HEX_CHARS[c >> 4]);
            sb.appendChar(HEX_CHARS[c & 15]);
        }
        i = i + 1;
    }
    let res = sb.toString();
    sb.delete();
    return res;
}

pub fn decode(encoded: string): string {
    let sb = string_builder.StringBuilder();
    let len = encoded.length;
    let i = 0;
    while (i < len) {
        let c = encoded[i];
        if (c == 37 && i + 2 < len) {
            let hi = hexVal(encoded[i + 1]);
            let lo = hexVal(encoded[i + 2]);
            if (hi != -1 && lo != -1) {
                let byte = (hi << 4) | lo;
                sb.appendChar(byte);
                i = i + 3;
                continue;
            }
        }
        if (c == 43) {
            sb.appendChar(32);
        } else {
            sb.appendChar(c);
        }
        i = i + 1;
    }
    let res = sb.toString();
    sb.delete();
    return res;
}

@test
fn test_url_encoding(): void {
    let raw = "hello world / test = + &";
    let enc = encode(raw);
    assert.isTrue(enc == "hello+world+%2F+test+%3D+%2B+%26");
    let dec = decode(enc);
    assert.isTrue(dec == raw);
}
