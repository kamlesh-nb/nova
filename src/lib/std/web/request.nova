
//! HTTP request parsing for the web framework.
//!
//! This file turns raw HTTP/1.1 bytes into a `Request` struct: method, path,
//! query parameters, headers, cookies and body, plus the helper routines used
//! upstream by the connection reader to find message boundaries before a full
//! `Request` can even be built (header-end detection, Content-Length and
//! chunked-encoding parsing, dechunking). It also provides `MultiMapSource`,
//! a `ValueSource` implementation over `application/x-www-form-urlencoded`
//! and multipart form bodies, so form data can be bound into typed structs
//! the same way `serde` binds JSON.
//!
//! Two families of routines exist side by side: string-based ones that work
//! on an already materialised `string` (`Request.fromString`, `parseQuery`),
//! and buffer-based ones that scan a raw pointer directly (`buf*` functions),
//! used on the hot path so the connection reader does not have to copy the
//! whole request into a `string` before it knows the body length.

import string;
import str;
import list;
import map;
import bytes;
import assert;
import os.sys;
import web.url;
import web.multipart;
import serde.source;


/// Finds the first occurrence of byte `b` in `buf[start:end]`, or -1 if not found.
fn idxByte(buf: long, start: int, end: int, b: int): int {
    if (start >= end) { return -1; }
    let p = sys.memchr(buf + (start as long), b, (end - start) as long);
    if (p == 0) { return -1; }
    return (p - buf) as int;
}

/// Case-insensitive ASCII string equality, used for HTTP header name matching.
fn ciEquals(a: string, b: string): bool {
    if (a.length != b.length) { return false; }
    let i = 0;
    while (i < a.length) {
        let ca = a[i];
        let cb = b[i];
        if (ca >= 65 && ca <= 90) { ca = ca + 32; }
        if (cb >= 65 && cb <= 90) { cb = cb + 32; }
        if (ca != cb) { return false; }
        i = i + 1;
    }
    return true;
}

/// A parsed HTTP/1.1 request: the request line, headers, cookies and body.
pub struct Request {
    /// The HTTP method, for example "GET" or "POST".
    pub method: string,
    /// The request path, with the query string removed.
    pub path: string,
    /// Query string parameters, URL-decoded.
    pub query: Map<string, string>,
    /// Header names as they appeared on the wire, mapped to their values. Use
    /// `getHeader` for case-insensitive lookup.
    pub headers: Map<string, string>,
    /// Cookies parsed out of the `Cookie` header, keyed by cookie name.
    pub cookies: Map<string, string>,
    /// The raw request body.
    pub body: string,

    /// Parses a full raw HTTP/1.1 request out of an already materialised string.
    /// Returns `Request.empty()` if the request line or headers are malformed
    /// (missing spaces, no CRLF terminator).
    pub fn fromString(raw: string): Request {
        let n = raw.length;
        let buf = raw as long;

        let sp1 = idxByte(buf, 0, n, 32);
        if (sp1 < 0) { return Request.empty(); }
        let method = string.slice(raw, 0, sp1);

        let sp2 = idxByte(buf, sp1 + 1, n, 32);
        if (sp2 < 0) { return Request.empty(); }
        let full_path = string.slice(raw, sp1 + 1, sp2);
        let (path, query) = splitPathQuery(full_path);

        let eol = idxByte(buf, sp2 + 1, n, 13);
        if (eol < 0) { return Request.empty(); }
        let pos = eol + 2;

        let headers = Map<string, string>(8, string.hash);
        let cookie_str = "";

        while (pos < n) {
            if (bytes.read_byte(buf, pos) as int == 13) {
                pos = pos + 2;
                break;
            }
            let line_end = idxByte(buf, pos, n, 13);
            if (line_end < 0) { break; }
            let colon = idxByte(buf, pos, line_end, 58);
            if (colon >= 0) {
                let key = string.slice(raw, pos, colon);
                let v_off = colon + 1;
                while (v_off < line_end && (bytes.read_byte(buf, v_off) as int == 32)) {
                    v_off = v_off + 1;
                }
                let val = string.slice(raw, v_off, line_end);
                headers.set(key, val);
                if (ciEquals(key, "Cookie")) { cookie_str = val; }
            }
            pos = line_end + 2;
        }

        let body = if (pos <= n) string.slice(raw, pos, n) else "";

        let cookies = Map<string, string>(4, string.hash);
        if (cookie_str != "") {
            let pairs = string.split(cookie_str, ";");
            let j = 0;
            while (j < pairs.size()) {
                let pair = pairs.get(j) ?? "";
                let trimmed_pair = trimWhitespace(pair);
                let eq_idx = string.indexOf(trimmed_pair, "=");
                if (eq_idx != -1) {
                    let k = string.slice(trimmed_pair, 0, eq_idx);
                    let v = string.slice(trimmed_pair, eq_idx + 1, trimmed_pair.length);
                    cookies.set(k, v);
                }
                j = j + 1;
            }
        }

        return Request{
            method: method,
            path: path,
            query: query,
            headers: headers,
            cookies: cookies,
            body: body,
        };
    }

    /// Reads `len` bytes starting at `ptr` and parses them as an HTTP request.
    pub fn parse(ptr: int, len: int): Request {
        let raw = bytes.read_string(ptr, len);
        return Request.fromString(raw);
    }

    /// An empty request with blank method, path and body, and empty maps.
    /// Used as the fallback when parsing fails.
    pub fn empty(): Request {
        return Request{
            method: "",
            path: "",
            query: Map<string, string>(1, string.hash),
            headers: Map<string, string>(1, string.hash),
            cookies: Map<string, string>(1, string.hash),
            body: "",
        };
    }

    /// Looks up a header by name, case-insensitively. Returns `undefined` if
    /// the header was not present on the request.
    pub fn getHeader(self: Request, name: string): string | undefined {
        let keys = self.headers.keys();
        let keysLen = keys.size();
        let i = 0;
        while (i < keysLen) {
            let key = keys.get(i) ?? "";
            if (ciEquals(key, name)) {
                return self.headers.get(key);
            }
            i = i + 1;
        }
        return undefined;
    }

    /// Looks up a cookie by name (exact match). Returns `undefined` if absent.
    pub fn getCookie(self: Request, name: string): string | undefined {
        return self.cookies.get(name);
    }
}

/// Splits a request-target into its path and its parsed query map, at the first `?`.
fn splitPathQuery(full_path: string): (string, Map<string, string>) {
    let idx = string.indexOf(full_path, "?");
    if (idx == -1) {
        return (full_path, Map<string, string>(1, string.hash));
    }
    let path = string.slice(full_path, 0, idx);
    let query_str = string.slice(full_path, idx + 1, full_path.length);
    let query = parseQuery(query_str);
    return (path, query);
}

/// Parses an `&`-separated, `=`-joined query string into a map, URL-decoding
/// both keys and values. A pair with no `=` yields an entry with an empty value.
pub fn parseQuery(query_str: string): Map<string, string> {

    let result = Map<string, string>(4, string.hash);
    let pairs = string.split(query_str, "&");
    pairs.forEach((pair) => {
        let parts = string.split(pair, "=");
        let key = url.decode(parts.get(0) ?? "");
        let val = url.decode(parts.get(1) ?? "");
        result.set(key, val);
    });
    return result;
}

/// Strips leading and trailing spaces, tabs, CR and LF from `s`.
fn trimWhitespace(s: string): string {
    let len = s.length;
    let start = 0;
    while (start < len) {
        let c = s[start];
        if (c != 32 && c != 9 && c != 10 && c != 13) {
            break;
        }
        start = start + 1;
    }
    let end = len;
    while (end > start) {
        let c = s[end - 1];
        if (c != 32 && c != 9 && c != 10 && c != 13) {
            break;
        }
        end = end - 1;
    }
    if (start >= end) {
        return "";
    }
    return string.slice(s, start, end);
}


/// Lowercases an ASCII byte; non-letters pass through unchanged.
fn lowerByte(b: int): int {
    if (b >= 65 && b <= 90) { return b + 32; }
    return b;
}

/// Scans `buf[start:end]` for the blank-line CRLFCRLF that ends the HTTP
/// header block, returning the index of its first byte, or -1 if not yet
/// present (the caller should keep reading more bytes off the socket).
pub fn bufFindHeaderEnd(buf: long, start: int, end: int): int {
    let i = start;
    while (i + 4 <= end) {
        if (bytes.read_byte(buf, i) == 13 && bytes.read_byte(buf, i + 1) == 10 &&
            bytes.read_byte(buf, i + 2) == 13 && bytes.read_byte(buf, i + 3) == 10) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

/// Case-insensitive search for `needle` in `buf[start:end]`, returning the
/// index of the first match or -1. An empty needle matches at `start`.
pub fn bufFindCI(buf: long, start: int, end: int, needle: string): int {
    let nlen = needle.length;
    if (nlen == 0) { return start; }
    let i = start;
    while (i + nlen <= end) {
        let j = 0;
        let matched = true;
        while (j < nlen) {
            if (lowerByte(bytes.read_byte(buf, i + j)) != (needle[j] as int)) { matched = false; break; }
            j = j + 1;
        }
        if (matched) { return i; }
        i = i + 1;
    }
    return -1;
}

/// Reads the `Content-Length` header value out of `buf[start:hdrEnd]` and
/// parses it as a decimal integer. Returns 0 if the header is absent.
pub fn bufContentLength(buf: long, start: int, hdrEnd: int): int {
    let idx = bufFindCI(buf, start, hdrEnd, "content-length:");
    if (idx == -1) { return 0; }
    let p = idx + 15;
    while (p < hdrEnd && bytes.read_byte(buf, p) == 32) { p = p + 1; }
    let n = 0;
    while (p < hdrEnd) {
        let c = bytes.read_byte(buf, p);
        if (c < 48 || c > 57) { break; }
        n = n * 10 + (c - 48);
        p = p + 1;
    }
    return n;
}

/// Reports whether the headers in `buf[start:hdrEnd]` declare chunked
/// transfer encoding (`Transfer-Encoding: chunked`, exact spacing required).
pub fn bufIsChunked(buf: long, start: int, hdrEnd: int): bool {
    return bufFindCI(buf, start, hdrEnd, "transfer-encoding: chunked") != -1;
}

/// Finds the next CRLF in `buf[from:len]`, returning the index of the CR, or -1.
pub fn bufFindCRLF(buf: long, from: int, len: int): int {
    let p = from;
    while (p + 1 < len) {
        if (bytes.read_byte(buf, p) == 13 && bytes.read_byte(buf, p + 1) == 10) { return p; }
        p = p + 1;
    }
    return -1;
}

/// Parses a hexadecimal integer from `buf[from:to]`, stopping at the first
/// non-hex-digit byte. Used to read chunk-size lines in chunked encoding.
pub fn bufParseHex(buf: long, from: int, to: int): int {
    let v = 0;
    let p = from;
    while (p < to) {
        let c = bytes.read_byte(buf, p);
        let d = -1;
        if (c >= 48 && c <= 57) { d = c - 48; }
        else if (c >= 97 && c <= 102) { d = c - 97 + 10; }
        else if (c >= 65 && c <= 70) { d = c - 65 + 10; }
        if (d < 0) { break; }
        v = v * 16 + d;
        p = p + 1;
    }
    return v;
}

/// Walks a chunked-encoded body starting at `start` and returns the index
/// just past the terminating zero-size chunk and its trailing CRLF, or -1 if
/// the body is not yet complete in `buf[..len]` (more bytes are needed).
pub fn bufChunkedEnd(buf: long, start: int, len: int): int {
    let p = start;
    while (p < len) {
        let lineEnd = bufFindCRLF(buf, p, len);
        if (lineEnd == -1) { return -1; }
        let size = bufParseHex(buf, p, lineEnd);
        let dataStart = lineEnd + 2;
        if (size == 0) {
            if (dataStart + 2 <= len) { return dataStart + 2; }
            return -1;
        }
        let next = dataStart + size + 2;
        if (next > len) { return -1; }
        p = next;
    }
    return -1;
}

pub fn bufDechunk(buf: long, start: int, len: int): string {
    let out = List<string>();
    let p = start;
    while (p < len) {
        let lineEnd = bufFindCRLF(buf, p, len);
        if (lineEnd == -1) { break; }
        let size = bufParseHex(buf, p, lineEnd);
        let dataStart = lineEnd + 2;
        if (size == 0) { break; }
        if (dataStart + size > len) { break; }
        out.push(bytes.read_string(buf + dataStart, size));
        p = dataStart + size + 2;
    }
    return string.join(out, "");
}

pub fn bufMethodPath(buf: long, len: int): (string, string) {
    let sp1 = -1;
    let i = 0;
    while (i < len) {
        if (bytes.read_byte(buf, i) == 32) { sp1 = i; break; }
        i = i + 1;
    }
    if (sp1 == -1) { return ("", ""); }
    let method = bytes.read_string(buf, sp1);
    let ps = sp1 + 1;
    let pe = ps;
    while (pe < len) {
        let c = bytes.read_byte(buf, pe);
        if (c == 32 || c == 63) { break; }
        pe = pe + 1;
    }
    let path = bytes.read_string(buf + ps, pe - ps);
    return (method, path);
}


pub fn pathSegs(path: string): List<string> {
    let out = List<string>();
    let parts = string.split(path, "/");
    let n = parts.size();
    let i = 0;
    while (i < n) {
        let p = parts.get(i) ?? "";
        if (p != "") { out.push(p); }
        i = i + 1;
    }
    return out;
}

pub fn isAllDigits(s: string): bool {
    let n = s.length;
    if (n == 0) { return false; }
    let i = 0;
    while (i < n) {
        let c = s[i];
        if (c < 48 || c > 57) { return false; }
        i = i + 1;
    }
    return true;
}


pub struct MultiMapSource impl ValueSource {
    pub fields: Map<string, List<string>>,

    init(fields: Map<string, List<string>>) { self.fields = fields; }

    pub fn getString(self: MultiMapSource, key: string): string {
        let l = self.fields.get(key);
        if (l == undefined) { return ""; }
        return (l ?? List<string>()).get(0) ?? "";
    }
    pub fn getStr(self: MultiMapSource, key: string): str.Str {
        return str.of(self.getString(key));
    }
    pub fn getInt(self: MultiMapSource, key: string): long { return string.parseI64(self.getString(key)); }
    pub fn getBool(self: MultiMapSource, key: string): bool { return string.eql(self.getString(key), "true"); }
    pub fn getFloat(self: MultiMapSource, key: string): double { return string.parseFloat(self.getString(key)); }
    pub fn getDecimal(self: MultiMapSource, key: string): decimal { return decimal.fromString(self.getString(key)); }
    pub fn getChild(self: MultiMapSource, key: string): ValueSource {
        return MultiMapSource(Map<string, List<string>>(2, string.hash));
    }
    pub fn has(self: MultiMapSource, key: string): bool {
        let l = self.fields.get(key);
        if (l == undefined) { return false; }
        return true;
    }
    pub fn arrayLen(self: MultiMapSource, key: string): int {
        let l = self.fields.get(key);
        if (l == undefined) { return 0; }
        return (l ?? List<string>()).size();
    }
    pub fn itemString(self: MultiMapSource, key: string, i: int): string {
        let l = self.fields.get(key);
        if (l == undefined) { return ""; }
        return (l ?? List<string>()).get(i) ?? "";
    }
    pub fn itemInt(self: MultiMapSource, key: string, i: int): long { return string.parseI64(self.itemString(key, i)); }
    pub fn itemDecimal(self: MultiMapSource, key: string, i: int): decimal { return decimal.fromString(self.itemString(key, i)); }
    pub fn itemChild(self: MultiMapSource, key: string, i: int): ValueSource {
        return MultiMapSource(Map<string, List<string>>(2, string.hash));
    }
}

fn mmPush(m: Map<string, List<string>>, key: string, val: string): void {
    let existing = m.get(key);
    if (existing == undefined) {
        let lst = List<string>();
        lst.push(val);
        m.set(key, lst);
    } else {
        (existing ?? List<string>()).push(val);
    }
}

pub fn formSource(body: string): MultiMapSource {
    let m = Map<string, List<string>>(16, string.hash);
    if (body != "") {
        let pairs = string.split(body, "&");
        let i = 0;
        while (i < pairs.size()) {
            let pair = pairs.get(i) ?? "";
            if (pair != "") {
                let eq = string.indexOf(pair, "=");
                if (eq == -1) {
                    mmPush(m, url.decode(pair), "");
                } else {
                    mmPush(m, url.decode(string.slice(pair, 0, eq)), url.decode(string.slice(pair, eq + 1, pair.length)));
                }
            }
            i = i + 1;
        }
    }
    return MultiMapSource(m);
}

pub fn multipartSource(contentType: string, body: string): MultiMapSource {
    let m = Map<string, List<string>>(16, string.hash);
    let parts = multipart.parseMultipart(contentType, body);
    let i = 0;
    while (i < parts.size()) {
        let p = parts.get(i) ?? multipart.Part{ name: "", filename: "", contentType: "", data: "" };
        mmPush(m, p.name, p.data);
        i = i + 1;
    }
    return MultiMapSource(m);
}

@test
fn test_chunked_request_decode(): void {
    let s = "4\r\nWiki\r\n5\r\npedia\r\n0\r\n\r\n";
    let n = s.length;
    let buf: long = bytes.alloc(n);
    let i = 0;
    while (i < n) { bytes.write_byte(buf, i, s[i]); i = i + 1; }
    assert.equalInt(bufChunkedEnd(buf, 0, n), n);
    assert.equalStr(bufDechunk(buf, 0, n), "Wikipedia");
    assert.equalInt(bufChunkedEnd(buf, 0, n - 4), -1);
    assert.equalInt(bufParseHex(buf, 0, 1), 4);
    bytes.free(buf);
}
