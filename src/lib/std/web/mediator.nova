//! Mediator pattern for the Nova web framework: a request/handler dispatch
//! pipeline in the style of MediatR (.NET), used to keep route handlers thin
//! and to compose cross-cutting concerns (validation, logging, auth) as
//! ordered middleware rather than duplicated per-handler logic.
//!
//! A `Message` is any request shape a caller wants routed. Handlers register
//! against a string key via `HandlerAdapter`, and `Mediator.send` builds a
//! `RequestContext` and walks it through the registered `PipelineBehavior`
//! chain (`Next`) before the terminal handler runs. `ValidationBehavior` is
//! the one behaviour shipped here: it looks up a `ValidatorAdapter` for the
//! request type and short-circuits with a 400 response when validation
//! fails. The `text`/`html`/`json`/`sse` helpers at the bottom build a
//! `response.Response` with the matching `Content-Type` header set, for use
//! by handlers that do not need the pipeline machinery.

import string;
import map;
import list;
import web.response;
import web.status;
import web.di;


/// Marker trait for any type that can be sent through the mediator as a
/// request. Carries no methods; it exists so `RequestContext.request` and
/// `send` have a common type to hold arbitrary, differently-shaped requests.
pub trait Message {}

/// Type-safe validator for a specific request type `TReq`, implemented per
/// request struct before being wrapped in a `ValidatorAdapter` for storage
/// in `Mediator.validators`.
pub trait Validator<TReq> {
    fn validate(self: Validator<TReq>, req: TReq): List<string>;
}

/// Type-erased wrapper around a `Validator<TReq>` so validators for
/// different request types can be stored together, keyed by request type
/// name, and invoked through a single `Message`-typed interface.
pub trait ValidatorAdapter {
    fn validate(self: ValidatorAdapter, req: Message): List<string>;
}

/// Type-erased wrapper around a concrete request handler, invoked as the
/// terminal step of the pipeline once all `PipelineBehavior`s have run.
pub trait HandlerAdapter {
    async fn execute(self: HandlerAdapter, ctx: RequestContext): response.Response;
}

/// Everything a pipeline behaviour or handler needs to process one request:
/// the request itself, its type key, the DI scope for that request, the
/// markers attached at registration time, and the validator table.
pub struct RequestContext {
    /// The message being dispatched, as a type-erased `Message`.
    pub request: Message,
    /// The key the handler was registered under; also used to look up its validator.
    pub requestType: string,
    /// Per-request dependency-injection scope, created fresh for each `send`.
    pub scope: ServiceScope,
    /// Arbitrary tags attached to the handler at `Mediator.register` time (e.g. to opt behaviours in or out per route).
    pub markers: List<string>,
    /// Validators registered on the mediator, keyed by request type.
    pub validators: Map<string, ValidatorAdapter>,

    init(request: Message, requestType: string, scope: ServiceScope, markers: List<string>, validators: Map<string, ValidatorAdapter>) {
        self.request = request;
        self.requestType = requestType;
        self.scope = scope;
        self.markers = markers;
        self.validators = validators;
    }

    /// Returns true if `marker` was attached to the current request's handler at registration time.
    pub fn requestIs(self: RequestContext, marker: string): bool {
        let i = 0;
        while (i < self.markers.size()) {
            if (string.eql(self.markers.at(i), marker)) { return true; }
            i = i + 1;
        }
        return false;
    }

    /// Looks up the validator registered for `key` (a request type name); returns `undefined` if none is registered.
    pub fn validatorFor(self: RequestContext, key: string): ValidatorAdapter | undefined {
        return self.validators.get(key);
    }
}

/// One link in the pipeline chain. A behaviour must call `next.proceed(ctx)`
/// to continue the chain, or return its own `response.Response` to
/// short-circuit it (as `ValidationBehavior` does on a failed validation).
pub trait PipelineBehavior {
    async fn handle(self: PipelineBehavior, ctx: RequestContext, next: Next): response.Response;
}

// No-op behaviour that just forwards to the next link; unused elsewhere in this file.
struct NoBehavior impl PipelineBehavior {
    async fn handle(self: NoBehavior, ctx: RequestContext, next: Next): response.Response {
        return await next.proceed(ctx);
    }
}

/// Cursor over the behaviour chain: calling `proceed` advances to the next
/// behaviour, or to the terminal handler once the chain is exhausted. A
/// fresh `Next` is constructed at each step, holding the index of the
/// behaviour still to run.
pub struct Next {
    /// The full ordered behaviour chain, shared across every step.
    pub behaviors: List<PipelineBehavior>,
    /// Index of the next behaviour in `behaviors` to invoke.
    pub idx: int,
    /// The handler to run once every behaviour has called `proceed`.
    pub terminal: HandlerAdapter,

    init(behaviors: List<PipelineBehavior>, idx: int, terminal: HandlerAdapter) {
        self.behaviors = behaviors;
        self.idx = idx;
        self.terminal = terminal;
    }

    /// Runs the next behaviour in the chain, or the terminal handler once `idx` reaches the end of `behaviors`.
    pub async fn proceed(self: Next, ctx: RequestContext): response.Response {
        if (self.idx >= self.behaviors.size()) {
            return await self.terminal.execute(ctx);
        }
        let b = self.behaviors.at(self.idx);
        let nxt = Next(self.behaviors, self.idx + 1, self.terminal);
        return await b.handle(ctx, nxt);
    }
}

/// A registered handler paired with the markers it was registered with.
pub struct HandlerEntry {
    /// The handler to invoke for this request type.
    pub adapter: HandlerAdapter,
    /// Tags checked via `RequestContext.requestIs` by behaviours that only apply to some routes.
    pub markers: List<string>,
    init(adapter: HandlerAdapter, markers: List<string>) { self.adapter = adapter; self.markers = markers; }
}

// Fallback terminal handler used by `send` when no handler is registered for the request key: returns 404.
struct NotFoundAdapter impl HandlerAdapter {
    async fn execute(self: NotFoundAdapter, ctx: RequestContext): response.Response {
        return response.Response(Status.NotFound, "no handler for " + ctx.requestType);
    }
}

/// The mediator itself: a registry of handlers and validators keyed by
/// request type, plus an ordered list of pipeline behaviours applied to
/// every dispatched request.
pub struct Mediator {
    /// Handlers keyed by request type string.
    pub handlers: Map<string, HandlerEntry>,
    /// Validators keyed by request type string.
    pub validators: Map<string, ValidatorAdapter>,
    /// Pipeline behaviours, run in registration order for every request.
    pub behaviors: List<PipelineBehavior>,
    /// DI provider used to create a fresh `ServiceScope` per request in `send`.
    pub provider: ServiceProvider,

    init(provider: ServiceProvider) {
        self.handlers = Map<string, HandlerEntry>(32, string.hash);
        self.validators = Map<string, ValidatorAdapter>(32, string.hash);
        self.behaviors = List<PipelineBehavior>();
        self.provider = provider;
    }

    /// Registers `adapter` as the handler for requests keyed by `key`, tagged with `markers`.
    pub fn register(self: Mediator, key: string, adapter: HandlerAdapter, markers: List<string>): void {
        self.handlers.set(key, HandlerEntry(adapter, markers));
    }
    /// Registers `v` as the validator to run for requests of type `key`.
    pub fn registerValidator(self: Mediator, key: string, v: ValidatorAdapter): void {
        self.validators.set(key, v);
    }
    /// Appends `b` to the pipeline; behaviours run in the order they are added.
    pub fn useBehavior(self: Mediator, b: PipelineBehavior): void {
        self.behaviors.push(b);
    }
    /// Returns true if a handler is registered for `key`.
    pub fn hasHandlerFor(self: Mediator, key: string): bool {
        return self.handlers.get(key) != undefined;
    }
    /// Replaces the DI provider used for future per-request scopes.
    pub fn setProvider(self: Mediator, provider: ServiceProvider): void {
        self.provider = provider;
    }

    /// Dispatches `req` under `key`: creates a fresh DI scope, resolves the
    /// registered handler (falling back to a 404 `NotFoundAdapter` if none
    /// is registered), builds a `RequestContext`, and runs it through the
    /// full behaviour pipeline before returning the resulting response.
    pub async fn send(self: Mediator, req: Message, key: string): response.Response {
        let scope = self.provider.createScope();
        let entry = self.handlers.get(key);
        let markers = List<string>();
        let terminal: HandlerAdapter = NotFoundAdapter{};
        if (entry != undefined) {
            let e = entry ?? HandlerEntry(NotFoundAdapter{}, List<string>());
            terminal = e.adapter;
            markers = e.markers;
        }
        let ctx = RequestContext(req, key, scope, markers, self.validators);
        let start = Next(self.behaviors, 0, terminal);
        return await start.proceed(ctx);
    }
}

/// Pipeline behaviour that runs the request's registered validator (if any)
/// before letting the request proceed. On a validation failure, returns a
/// 400 Bad Request carrying only the FIRST error message and does not call
/// `next.proceed`, so no later behaviour or the handler runs.
pub struct ValidationBehavior impl PipelineBehavior {
    async fn handle(self: ValidationBehavior, ctx: RequestContext, next: Next): response.Response {
        let v = ctx.validatorFor(ctx.requestType);
        if (v != undefined) {
            let errs = (v ?? NullValidator{}).validate(ctx.request);
            if (errs.size() > 0) {
                return response.Response(Status.BadRequest, errs.at(0));
            }
        }
        return await next.proceed(ctx);
    }
}

// Placeholder validator that always passes, used as the fallback when `validatorFor` returns undefined.
struct NullValidator impl ValidatorAdapter {
    fn validate(self: NullValidator, req: Message): List<string> { return List<string>(); }
}

/// Wraps `body` in a 200 OK response with `Content-Type: text/plain; charset=utf-8`.
pub fn text(body: string): response.Response {
    let r = response.Response(Status.Ok, body);
    r.setHeader("Content-Type", "text/plain; charset=utf-8");
    return r;
}

/// Wraps `body` in a 200 OK response with `Content-Type: text/html; charset=utf-8`.
pub fn html(body: string): response.Response {
    let r = response.Response(Status.Ok, body);
    r.setHeader("Content-Type", "text/html; charset=utf-8");
    return r;
}

/// Wraps `body` in a 200 OK response with `Content-Type: application/json`.
/// Takes an already-serialised JSON string; it does not serialise for you.
pub fn json(body: string): response.Response {
    let r = response.Response(Status.Ok, body);
    r.setHeader("Content-Type", "application/json");
    return r;
}

/// Wraps `body` in a 200 OK response set up for server-sent events:
/// `Content-Type: text/event-stream` with caching disabled.
pub fn sse(body: string): response.Response {
    let r = response.Response(Status.Ok, body);
    r.setHeader("Content-Type", "text/event-stream");
    r.setHeader("Cache-Control", "no-cache");
    return r;
}
