
import string;
import map;
import list;
import web.response;
import web.status;
import web.di;


pub trait Message {}

pub trait Validator<TReq> {
    fn validate(self: Validator<TReq>, req: TReq): List<string>;
}

pub trait ValidatorAdapter {
    fn validate(self: ValidatorAdapter, req: Message): List<string>;
}

pub trait HandlerAdapter {
    async fn execute(self: HandlerAdapter, ctx: RequestContext): response.Response;
}

pub struct RequestContext {
    pub request: Message,
    pub requestType: string,
    pub scope: ServiceScope,
    pub markers: List<string>,
    pub validators: Map<string, ValidatorAdapter>,

    init(request: Message, requestType: string, scope: ServiceScope, markers: List<string>, validators: Map<string, ValidatorAdapter>) {
        self.request = request;
        self.requestType = requestType;
        self.scope = scope;
        self.markers = markers;
        self.validators = validators;
    }

    pub fn requestIs(self: RequestContext, marker: string): bool {
        let i = 0;
        while (i < self.markers.size()) {
            if (string.eql(self.markers.at(i), marker)) { return true; }
            i = i + 1;
        }
        return false;
    }

    pub fn validatorFor(self: RequestContext, key: string): ValidatorAdapter | undefined {
        return self.validators.get(key);
    }
}

pub trait PipelineBehavior {
    async fn handle(self: PipelineBehavior, ctx: RequestContext, next: Next): response.Response;
}

struct NoBehavior impl PipelineBehavior {
    async fn handle(self: NoBehavior, ctx: RequestContext, next: Next): response.Response {
        return await next.proceed(ctx);
    }
}

pub struct Next {
    pub behaviors: List<PipelineBehavior>,
    pub idx: int,
    pub terminal: HandlerAdapter,

    init(behaviors: List<PipelineBehavior>, idx: int, terminal: HandlerAdapter) {
        self.behaviors = behaviors;
        self.idx = idx;
        self.terminal = terminal;
    }

    pub async fn proceed(self: Next, ctx: RequestContext): response.Response {
        if (self.idx >= self.behaviors.size()) {
            return await self.terminal.execute(ctx);
        }
        let b = self.behaviors.at(self.idx);
        let nxt = Next(self.behaviors, self.idx + 1, self.terminal);
        return await b.handle(ctx, nxt);
    }
}

pub struct HandlerEntry {
    pub adapter: HandlerAdapter,
    pub markers: List<string>,
    init(adapter: HandlerAdapter, markers: List<string>) { self.adapter = adapter; self.markers = markers; }
}

struct NotFoundAdapter impl HandlerAdapter {
    async fn execute(self: NotFoundAdapter, ctx: RequestContext): response.Response {
        return response.Response(Status.NotFound, "no handler for " + ctx.requestType);
    }
}

pub struct Mediator {
    pub handlers: Map<string, HandlerEntry>,
    pub validators: Map<string, ValidatorAdapter>,
    pub behaviors: List<PipelineBehavior>,
    pub provider: ServiceProvider,

    init(provider: ServiceProvider) {
        self.handlers = Map<string, HandlerEntry>(32, string.hash);
        self.validators = Map<string, ValidatorAdapter>(32, string.hash);
        self.behaviors = List<PipelineBehavior>();
        self.provider = provider;
    }

    pub fn register(self: Mediator, key: string, adapter: HandlerAdapter, markers: List<string>): void {
        self.handlers.set(key, HandlerEntry(adapter, markers));
    }
    pub fn registerValidator(self: Mediator, key: string, v: ValidatorAdapter): void {
        self.validators.set(key, v);
    }
    pub fn useBehavior(self: Mediator, b: PipelineBehavior): void {
        self.behaviors.push(b);
    }
    pub fn hasHandlerFor(self: Mediator, key: string): bool {
        return self.handlers.get(key) != undefined;
    }
    pub fn setProvider(self: Mediator, provider: ServiceProvider): void {
        self.provider = provider;
    }

    pub async fn send(self: Mediator, req: Message, key: string): response.Response {
        let scope = self.provider.createScope();
        let entry = self.handlers.get(key);
        let markers = List<string>();
        let terminal: HandlerAdapter = NotFoundAdapter{};
        if (entry != undefined) {
            let e = entry ?? HandlerEntry(NotFoundAdapter{}, List<string>());
            terminal = e.adapter;
            markers = e.markers;
        }
        let ctx = RequestContext(req, key, scope, markers, self.validators);
        let start = Next(self.behaviors, 0, terminal);
        return await start.proceed(ctx);
    }
}

pub struct ValidationBehavior impl PipelineBehavior {
    async fn handle(self: ValidationBehavior, ctx: RequestContext, next: Next): response.Response {
        let v = ctx.validatorFor(ctx.requestType);
        if (v != undefined) {
            let errs = (v ?? NullValidator{}).validate(ctx.request);
            if (errs.size() > 0) {
                return response.Response(Status.BadRequest, errs.at(0));
            }
        }
        return await next.proceed(ctx);
    }
}

struct NullValidator impl ValidatorAdapter {
    fn validate(self: NullValidator, req: Message): List<string> { return List<string>(); }
}

pub fn text(body: string): response.Response {
    let r = response.Response(Status.Ok, body);
    r.setHeader("Content-Type", "text/plain; charset=utf-8");
    return r;
}

pub fn html(body: string): response.Response {
    let r = response.Response(Status.Ok, body);
    r.setHeader("Content-Type", "text/html; charset=utf-8");
    return r;
}

pub fn json(body: string): response.Response {
    let r = response.Response(Status.Ok, body);
    r.setHeader("Content-Type", "application/json");
    return r;
}

pub fn sse(body: string): response.Response {
    let r = response.Response(Status.Ok, body);
    r.setHeader("Content-Type", "text/event-stream");
    r.setHeader("Cache-Control", "no-cache");
    return r;
}
