//! Cross-Origin Resource Sharing (CORS) middleware for the web framework.
//!
//! This file provides `CorsConfig`, which holds the policy an application wants
//! to expose (allowed origin or origins, methods, headers, credentials and
//! preflight cache lifetime), and `CorsMiddleware`, which applies that policy to
//! every request by implementing the `RouteMiddleware` contract. Register it via
//! `app.use`: it sets the appropriate `Access-Control-*` response headers, and
//! short-circuits `OPTIONS` preflight requests with a `204 No Content` reply
//! instead of letting them reach route handlers.

import web.routing;
import web.response;
import web.status;
import collections.list;

/// Policy settings for CORS handling: which origins, methods and headers are
/// permitted, and how preflight responses are shaped.
pub struct CorsConfig {
    /// Single origin to echo back when `allowOrigins` is empty (for example
    /// `"*"` or a specific `https://example.com`).
    pub allowOrigin: string,
    /// Explicit list of allowed origins. When non-empty, this takes priority
    /// over `allowOrigin`, and a matching request origin (or a `"*"` entry) is
    /// echoed back with a `Vary: Origin` response header.
    pub allowOrigins: list.List,
    /// Value sent in the `Access-Control-Allow-Methods` header, for example
    /// `"GET, POST, PUT, DELETE, OPTIONS"`.
    pub allowMethods: string,
    /// Value sent in the `Access-Control-Allow-Headers` header.
    pub allowHeaders: string,
    /// Value sent in the `Access-Control-Max-Age` header on preflight
    /// (`OPTIONS`) responses, controlling how long the browser may cache the
    /// preflight result.
    pub maxAge: string,
    /// When true, sends `Access-Control-Allow-Credentials: true` so that
    /// requests with cookies or HTTP auth are permitted cross-origin.
    pub allowCredentials: bool,
}

/// Middleware that applies a `CorsConfig` to every request: sets the
/// `Access-Control-*` response headers, and answers `OPTIONS` preflight
/// requests directly rather than forwarding them to a route handler.
pub struct CorsMiddleware impl RouteMiddleware {
    /// The policy this middleware instance enforces.
    pub config: CorsConfig,

    init(config: CorsConfig) {
        self.config = config;
    }

    /// Resolves the origin to echo for this request's `Origin` header. When
    /// `config.allowOrigins` is non-empty, the request origin is matched against
    /// that list (a `"*"` entry matches any origin) and returned on a match, else
    /// `""`; when the list is empty, `config.allowOrigin` is used unconditionally.
    fn resolveOrigin(self: CorsMiddleware, originHeader: string): string {
        if (self.config.allowOrigins.size() > 0) {
            let i = 0;
            while (i < self.config.allowOrigins.size()) {
                let allowed = self.config.allowOrigins.get(i);
                if (allowed == "*" || allowed == originHeader) {
                    return originHeader;
                }
                i = i + 1;
            }
            return "";
        }
        return self.config.allowOrigin;
    }

    /// Writes the `Access-Control-*` headers for `originResolved` onto `res`.
    fn applyHeaders(self: CorsMiddleware, res: Response, originResolved: string): void {
        if (originResolved != "") {
            res.setHeader("Access-Control-Allow-Origin", originResolved);
        }
        if (self.config.allowOrigins.size() > 0) {
            res.setHeader("Vary", "Origin");
        }
        res.setHeader("Access-Control-Allow-Methods", self.config.allowMethods);
        res.setHeader("Access-Control-Allow-Headers", self.config.allowHeaders);
        if (self.config.allowCredentials) {
            res.setHeader("Access-Control-Allow-Credentials", "true");
        }
    }

    /// For an `OPTIONS` preflight, answers directly with a `204 No Content`
    /// carrying the CORS headers (plus `Access-Control-Max-Age`) and never
    /// reaches a route handler. Every other method runs the chain and has the
    /// CORS headers stamped onto the response on the way out.
    async fn handle(self: CorsMiddleware, ctx: routing.Context, next: routing.Chain): Response {
        let origin_header = ctx.request.headers.get("Origin") ?? ctx.request.headers.get("origin") ?? "";
        let origin_resolved = self.resolveOrigin(origin_header);

        if (ctx.request.method == "OPTIONS") {
            let res = response.Response(Status.NoContent, "");
            self.applyHeaders(res, origin_resolved);
            res.setHeader("Access-Control-Max-Age", self.config.maxAge);
            return res;
        }

        let res = await next.proceed(ctx);
        self.applyHeaders(res, origin_resolved);
        return res;
    }
}
