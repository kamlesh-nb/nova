import bytes;

pub const FRAME_DATA: int = 0;
pub const FRAME_HEADERS: int = 1;
pub const FRAME_PRIORITY: int = 2;
pub const FRAME_RST_STREAM: int = 3;
pub const FRAME_SETTINGS: int = 4;
pub const FRAME_PUSH_PROMISE: int = 5;
pub const FRAME_PING: int = 6;
pub const FRAME_GOAWAY: int = 7;
pub const FRAME_WINDOW_UPDATE: int = 8;
pub const FRAME_CONTINUATION: int = 9;

pub const FLAG_END_STREAM: int = 1;
pub const FLAG_ACK: int = 1;
pub const FLAG_END_HEADERS: int = 4;
pub const FLAG_PADDED: int = 8;
pub const FLAG_PRIORITY: int = 32;

pub const SETTINGS_HEADER_TABLE_SIZE: int = 1;
pub const SETTINGS_ENABLE_PUSH: int = 2;
pub const SETTINGS_MAX_CONCURRENT_STREAMS: int = 3;
pub const SETTINGS_INITIAL_WINDOW_SIZE: int = 4;
pub const SETTINGS_MAX_FRAME_SIZE: int = 5;
pub const SETTINGS_MAX_HEADER_LIST_SIZE: int = 6;

pub const PREFACE: string = "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n";

pub struct FrameHeader {
    pub length: int,
    pub ftype: int,
    pub flags: int,
    pub streamId: int,
    init(length: int, ftype: int, flags: int, streamId: int) {
        self.length = length; self.ftype = ftype; self.flags = flags; self.streamId = streamId;
    }
}

pub fn readHeader(buf: ptr, off: int): FrameHeader {
    let len = (bytes.read_byte(buf, off) << 16) | (bytes.read_byte(buf, off + 1) << 8) | bytes.read_byte(buf, off + 2);
    let ftype = bytes.read_byte(buf, off + 3);
    let flags = bytes.read_byte(buf, off + 4);
    let sid = ((bytes.read_byte(buf, off + 5) & 127) << 24) | (bytes.read_byte(buf, off + 6) << 16) | (bytes.read_byte(buf, off + 7) << 8) | bytes.read_byte(buf, off + 8);
    return FrameHeader(len, ftype, flags, sid);
}

pub fn writeHeader(out: ptr, o: int, length: int, ftype: int, flags: int, streamId: int): int {
    bytes.write_byte(out, o, (length >> 16) & 255);
    bytes.write_byte(out, o + 1, (length >> 8) & 255);
    bytes.write_byte(out, o + 2, length & 255);
    bytes.write_byte(out, o + 3, ftype);
    bytes.write_byte(out, o + 4, flags);
    bytes.write_byte(out, o + 5, (streamId >> 24) & 127);
    bytes.write_byte(out, o + 6, (streamId >> 16) & 255);
    bytes.write_byte(out, o + 7, (streamId >> 8) & 255);
    bytes.write_byte(out, o + 8, streamId & 255);
    return o + 9;
}

pub fn writeFrame(out: ptr, o: int, ftype: int, flags: int, streamId: int, src: ptr, srcOff: int, len: int): int {
    let p = writeHeader(out, o, len, ftype, flags, streamId);
    let i = 0;
    while (i < len) { bytes.write_byte(out, p + i, bytes.read_byte(src, srcOff + i)); i = i + 1; }
    return p + len;
}

pub fn writeSettings(out: ptr, o: int, id: int, value: int): int {
    let p = writeHeader(out, o, 6, FRAME_SETTINGS, 0, 0);
    bytes.write_byte(out, p, (id >> 8) & 255);
    bytes.write_byte(out, p + 1, id & 255);
    bytes.write_byte(out, p + 2, (value >> 24) & 255);
    bytes.write_byte(out, p + 3, (value >> 16) & 255);
    bytes.write_byte(out, p + 4, (value >> 8) & 255);
    bytes.write_byte(out, p + 5, value & 255);
    return p + 6;
}

pub fn writeSettingsEmpty(out: ptr, o: int): int { return writeHeader(out, o, 0, FRAME_SETTINGS, 0, 0); }

pub fn writeSettingsAck(out: ptr, o: int): int { return writeHeader(out, o, 0, FRAME_SETTINGS, FLAG_ACK, 0); }

pub fn writeWindowUpdate(out: ptr, o: int, streamId: int, increment: int): int {
    let p = writeHeader(out, o, 4, FRAME_WINDOW_UPDATE, 0, streamId);
    bytes.write_byte(out, p, (increment >> 24) & 127);
    bytes.write_byte(out, p + 1, (increment >> 16) & 255);
    bytes.write_byte(out, p + 2, (increment >> 8) & 255);
    bytes.write_byte(out, p + 3, increment & 255);
    return p + 4;
}

pub fn writePingAck(out: ptr, o: int, src: ptr, srcOff: int): int {
    let p = writeHeader(out, o, 8, FRAME_PING, FLAG_ACK, 0);
    let i = 0;
    while (i < 8) { bytes.write_byte(out, p + i, bytes.read_byte(src, srcOff + i)); i = i + 1; }
    return p + 8;
}

pub fn writeGoaway(out: ptr, o: int, lastStreamId: int, errorCode: int): int {
    let p = writeHeader(out, o, 8, FRAME_GOAWAY, 0, 0);
    bytes.write_byte(out, p, (lastStreamId >> 24) & 127);
    bytes.write_byte(out, p + 1, (lastStreamId >> 16) & 255);
    bytes.write_byte(out, p + 2, (lastStreamId >> 8) & 255);
    bytes.write_byte(out, p + 3, lastStreamId & 255);
    bytes.write_byte(out, p + 4, (errorCode >> 24) & 255);
    bytes.write_byte(out, p + 5, (errorCode >> 16) & 255);
    bytes.write_byte(out, p + 6, (errorCode >> 8) & 255);
    bytes.write_byte(out, p + 7, errorCode & 255);
    return p + 8;
}

pub fn writeRstStream(out: ptr, o: int, streamId: int, errorCode: int): int {
    let p = writeHeader(out, o, 4, FRAME_RST_STREAM, 0, streamId);
    bytes.write_byte(out, p, (errorCode >> 24) & 255);
    bytes.write_byte(out, p + 1, (errorCode >> 16) & 255);
    bytes.write_byte(out, p + 2, (errorCode >> 8) & 255);
    bytes.write_byte(out, p + 3, errorCode & 255);
    return p + 4;
}

pub fn readU32(buf: ptr, off: int): int {
    return ((bytes.read_byte(buf, off) & 127) << 24) | (bytes.read_byte(buf, off + 1) << 16) | (bytes.read_byte(buf, off + 2) << 8) | bytes.read_byte(buf, off + 3);
}
