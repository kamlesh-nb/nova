//! HPACK header compression (RFC 7541) for the HTTP/2 module.
//!
//! This file implements the static and dynamic header tables, the static
//! Huffman code used for string literals, and the integer/string encoding
//! and decoding primitives that HPACK needs. It is used by the HTTP/2
//! connection and frame handling in `web/http2` to compress and decompress
//! request and response header blocks, and has no dependants outside that
//! module.
//!
//! The Huffman table (codes and bit lengths) is stored as hex strings and
//! decoded once, at `Hpack` construction time, into parallel `codes`/`lens`
//! lists plus a decode map keyed on `(bit length, code) -> symbol`, so both
//! encode and decode work off the same tables.

import string;
import list;
import map;
import bytes;

// RFC 7541 Appendix B canonical Huffman codes for the 256 HPACK symbols, packed as 8 hex digits (32 bits) per entry.
const HUFF_CODES_HEX: string = "";
// Matching bit lengths for each symbol, 2 hex digits (one byte) per entry, parallel to HUFF_CODES_HEX.
const HUFF_LENS_HEX: string = "";

// Converts one hex digit character to its numeric value; non-hex input yields 0.
fn hx(c: int): int {
    if (c >= '0' && c <= '9') { return c - '0'; }
    if (c >= 'a' && c <= 'f') { return c - 'a' + 10; }
    return 0;
}
// Parses 8 hex digits starting at index i into a 32-bit value (used to read a Huffman code).
fn hex8(s: string, i: int): int {
    let v = 0;
    let k = 0;
    while (k < 8) { v = (v << 4) | hx(s[i + k]); k = k + 1; }
    return v;
}
// Parses 2 hex digits starting at index i into a byte value (used to read a Huffman code length).
fn hex2At(s: string, i: int): int { return (hx(s[i]) << 4) | hx(s[i + 1]); }

/// A single decoded or to-be-encoded HTTP header, as a name/value pair.
pub struct HeaderField {
    /// The header name, for example ":method" or "content-type".
    pub name: string,
    /// The header value.
    pub value: string,
    init(name: string, value: string) { self.name = name; self.value = value; }
}

// Names of the 61 static-table entries defined by RFC 7541 Appendix A, in table order (index 1 = first).
fn staticNames(): List<string> {
    let n = List<string>();
    n.push(":authority"); n.push(":method"); n.push(":method"); n.push(":path"); n.push(":path");
    n.push(":scheme"); n.push(":scheme"); n.push(":status"); n.push(":status"); n.push(":status");
    n.push(":status"); n.push(":status"); n.push(":status"); n.push(":status"); n.push("accept-charset");
    n.push("accept-encoding"); n.push("accept-language"); n.push("accept-ranges"); n.push("accept");
    n.push("access-control-allow-origin"); n.push("age"); n.push("allow"); n.push("authorization");
    n.push("cache-control"); n.push("content-disposition"); n.push("content-encoding");
    n.push("content-language"); n.push("content-length"); n.push("content-location"); n.push("content-range");
    n.push("content-type"); n.push("cookie"); n.push("date"); n.push("etag"); n.push("expect");
    n.push("expires"); n.push("from"); n.push("host"); n.push("if-match"); n.push("if-modified-since");
    n.push("if-none-match"); n.push("if-range"); n.push("if-unmodified-since"); n.push("last-modified");
    n.push("link"); n.push("location"); n.push("max-forwards"); n.push("proxy-authenticate");
    n.push("proxy-authorization"); n.push("range"); n.push("referer"); n.push("refresh"); n.push("retry-after");
    n.push("server"); n.push("set-cookie"); n.push("strict-transport-security"); n.push("transfer-encoding");
    n.push("user-agent"); n.push("vary"); n.push("via"); n.push("www-authenticate");
    return n;
}
// Values matching staticNames(); most static-table entries carry no fixed value, so those slots are "".
fn staticValues(): List<string> {
    let v = List<string>();
    v.push(""); v.push("GET"); v.push("POST"); v.push("/"); v.push("/index.html");
    v.push("http"); v.push("https"); v.push("200"); v.push("204"); v.push("206");
    v.push("304"); v.push("400"); v.push("404"); v.push("500"); v.push("");
    v.push("gzip, deflate"); v.push(""); v.push(""); v.push("");
    v.push(""); v.push(""); v.push(""); v.push("");
    v.push(""); v.push(""); v.push("");
    v.push(""); v.push(""); v.push(""); v.push("");
    v.push(""); v.push(""); v.push(""); v.push(""); v.push("");
    v.push(""); v.push(""); v.push(""); v.push(""); v.push("");
    v.push(""); v.push(""); v.push(""); v.push("");
    v.push(""); v.push(""); v.push(""); v.push("");
    v.push(""); v.push(""); v.push(""); v.push(""); v.push("");
    v.push(""); v.push(""); v.push(""); v.push("");
    v.push(""); v.push(""); v.push(""); v.push("");
    return v;
}

/// One HPACK codec instance for a single HTTP/2 connection.
///
/// An `Hpack` holds the Huffman tables (shared, read-only after construction),
/// the RFC 7541 static header table, and this connection's dynamic header
/// table. Because the dynamic table evolves with every header block encoded
/// or decoded, encoder and decoder state must not be shared across
/// connections: create one `Hpack` per connection.
pub class Hpack {
    /// Huffman code for each of the 256 symbols (index = byte value), decoded from HUFF_CODES_HEX.
    pub codes: List<int>,
    /// Bit length of the Huffman code for each symbol, decoded from HUFF_LENS_HEX.
    pub lens: List<int>,
    /// Maps a packed (bit length << 32 | code) key to its symbol, for Huffman decoding.
    pub decMap: Map<long, int>,
    /// Static-table header names (RFC 7541 Appendix A), indexed 0..60 for table indices 1..61.
    pub sNames: List<string>,
    /// Static-table header values matching sNames.
    pub sValues: List<string>,
    /// Dynamic-table header names, most recently inserted first (index 0 = table index 62).
    pub dynNames: List<string>,
    /// Dynamic-table header values matching dynNames.
    pub dynValues: List<string>,
    /// Current size of the dynamic table in bytes, per the RFC 7541 accounting: name.length + value.length + 32 per entry.
    pub dynSize: int,
    /// Maximum allowed size of the dynamic table in bytes; entries are evicted (oldest first) to stay within it.
    pub maxDynSize: int,

    init() {
        self.codes = List<int>();
        self.lens = List<int>();
        self.decMap = Map<long, int>(512, longHash);
        let i = 0;
        while (i < 256) {
            let code = hex8(HUFF_CODES_HEX, i * 8);
            let l = hex2At(HUFF_LENS_HEX, i * 2);
            self.codes.push(code);
            self.lens.push(l);
            let key = ((l as long) << 32) | (code as long);
            self.decMap.set(key, i);
            i = i + 1;
        }
        self.sNames = staticNames();
        self.sValues = staticValues();
        self.dynNames = List<string>();
        self.dynValues = List<string>();
        self.dynSize = 0;
        self.maxDynSize = 4096;
    }

    // Computes the encoded length in bytes if s were Huffman-coded, without producing the bytes.
    fn huffEncodeLen(self: Hpack, s: string): int {
        let bits = 0;
        let i = 0;
        while (i < s.length) { bits = bits + self.lens.at(s[i]); i = i + 1; }
        return (bits + 7) / 8;
    }

    // Huffman-encodes s into out starting at byte offset o0, padding the final byte with 1-bits; returns the offset past the written bytes.
    fn huffEncode(self: Hpack, out: ptr, o0: int, s: string): int {
        let o = o0;
        let acc = 0 as long;
        let nbits = 0;
        let i = 0;
        while (i < s.length) {
            let b = s[i];
            let code = self.codes.at(b) as long;
            let clen = self.lens.at(b);
            acc = (acc << clen) | code;
            nbits = nbits + clen;
            while (nbits >= 8) {
                nbits = nbits - 8;
                bytes.write_byte(out, o, ((acc >> nbits) & 255) as int);
                o = o + 1;
            }
            i = i + 1;
        }
        if (nbits > 0) {
            let pad = 8 - nbits;
            acc = (acc << pad) | (((1 << pad) - 1) as long);
            bytes.write_byte(out, o, (acc & 255) as int);
            o = o + 1;
        }
        return o;
    }

    // Huffman-decodes len bytes from buf at off back into a string, matching bits against decMap greedily.
    fn huffDecode(self: Hpack, buf: ptr, off: int, len: int): string {
        let out = bytes.alloc(len * 8 + 2);
        let o = 0;
        let cur = 0 as long;
        let nbits = 0;
        let i = 0;
        while (i < len) {
            let b = bytes.read_byte(buf, off + i);
            let bit = 7;
            while (bit >= 0) {
                cur = (cur << 1) | (((b >> bit) & 1) as long);
                nbits = nbits + 1;
                if (nbits <= 30) {
                    let key = ((nbits as long) << 32) | cur;
                    let sym = self.decMap.get(key);
                    if (sym != undefined) {
                        bytes.write_byte(out, o, (sym ?? 0)); o = o + 1;
                        cur = 0 as long;
                        nbits = 0;
                    }
                }
                bit = bit - 1;
            }
            i = i + 1;
        }
        bytes.write_byte(out, o, 0);
        bytes.write_i32(out - 4, 0, o);
        return out as string;
    }

    // Encodes v0 using RFC 7541 §5.1 variable-length integer encoding with an n-bit prefix, ORing in flags on the first byte.
    fn encInt(self: Hpack, out: ptr, o0: int, n: int, flags: int, v0: int): int {
        let o = o0;
        let max = (1 << n) - 1;
        if (v0 < max) {
            bytes.write_byte(out, o, flags | v0); return o + 1;
        }
        bytes.write_byte(out, o, flags | max); o = o + 1;
        let v = v0 - max;
        while (v >= 128) {
            bytes.write_byte(out, o, (v & 127) | 128); o = o + 1;
            v = v / 128;
        }
        bytes.write_byte(out, o, v); o = o + 1;
        return o;
    }

    // Encodes s as an RFC 7541 §5.2 string literal, choosing Huffman coding only when it is shorter than the raw bytes.
    fn encStr(self: Hpack, out: ptr, o0: int, s: string): int {
        let o = o0;
        let hl = self.huffEncodeLen(s);
        if (hl < s.length) {
            o = self.encInt(out, o, 7, 128, hl);
            o = self.huffEncode(out, o, s);
        } else {
            o = self.encInt(out, o, 7, 0, s.length);
            let i = 0;
            while (i < s.length) { bytes.write_byte(out, o, s[i]); o = o + 1; i = i + 1; }
        }
        return o;
    }

    // Inserts a name/value pair at the front of the dynamic table, evicting the oldest entries first to stay within maxDynSize.
    fn dynAdd(self: Hpack, name: string, value: string): void {
        let sz = name.length + value.length + 32;
        while (self.dynSize + sz > self.maxDynSize && self.dynNames.size() > 0) {
            let last = self.dynNames.size() - 1;
            let en = self.dynNames.at(last);
            let ev = self.dynValues.at(last);
            self.dynSize = self.dynSize - (en.length + ev.length + 32);
            self.dynNames.remove(last);
            self.dynValues.remove(last);
        }
        if (sz <= self.maxDynSize) {
            self.dynNames.insert(0, name);
            self.dynValues.insert(0, value);
            self.dynSize = self.dynSize + sz;
        }
    }

    // Resolves a combined static/dynamic table index (1-based) to its header name, or "" if out of range.
    fn tableName(self: Hpack, idx: int): string {
        if (idx >= 1 && idx <= 61) { return self.sNames.at(idx - 1); }
        let d = idx - 62;
        if (d >= 0 && d < self.dynNames.size()) { return self.dynNames.at(d); }
        return "";
    }
    // Resolves a combined static/dynamic table index (1-based) to its header value, or "" if out of range.
    fn tableValue(self: Hpack, idx: int): string {
        if (idx >= 1 && idx <= 61) { return self.sValues.at(idx - 1); }
        let d = idx - 62;
        if (d >= 0 && d < self.dynValues.size()) { return self.dynValues.at(d); }
        return "";
    }

    // Searches the static table for name/value: returns +index on an exact match, -index on a name-only match, or 0 for no match.
    fn staticFind(self: Hpack, name: string, value: string): int {
        let nameOnly = 0;
        let i = 0;
        while (i < 61) {
            if (string.eql(self.sNames.at(i), name)) {
                if (string.eql(self.sValues.at(i), value)) { return i + 1; }
                if (nameOnly == 0) { nameOnly = 0 - (i + 1); }
            }
            i = i + 1;
        }
        return nameOnly;
    }


    /// Encodes a list of header fields into an HPACK header block.
    ///
    /// Every field is encoded as an "indexed name" reference (RFC 7541 §6.2.1)
    /// when the name matches the static table but the value does not, or as a
    /// literal with both name and value when neither matches. Fields that
    /// exactly match a static-table entry are emitted as a single indexed
    /// reference (§6.1). Returns the allocated output buffer and the number
    /// of bytes written into it.
    pub fn encode(self: Hpack, fields: List<HeaderField>): (ptr, int) {
        let cap = 64;
        let i = 0;
        while (i < fields.size()) { let f = fields.at(i); cap = cap + f.name.length + f.value.length + 16; i = i + 1; }
        let out = bytes.alloc(cap);
        let o = 0;
        let k = 0;
        while (k < fields.size()) {
            let f = fields.at(k);
            let m = self.staticFind(f.name, f.value);
            if (m > 0) {
                o = self.encInt(out, o, 7, 128, m);
            } else if (m < 0) {
                o = self.encInt(out, o, 4, 0, 0 - m);
                o = self.encStr(out, o, f.value);
            } else {
                bytes.write_byte(out, o, 0); o = o + 1;
                o = self.encStr(out, o, f.name);
                o = self.encStr(out, o, f.value);
            }
            k = k + 1;
        }
        return (out, o);
    }

    /// Decodes an HPACK header block of len bytes starting at off within buf into a list of header fields.
    ///
    /// Dispatches on the leading byte per RFC 7541 §6: indexed field (bit 7),
    /// literal with incremental indexing (bit 6, added to the dynamic table),
    /// dynamic table size update (bits 5, adjusts maxDynSize and evicts as
    /// needed), or literal without indexing (fallback). Mutates this
    /// codec's dynamic table as a side effect, so header blocks from the
    /// same connection must be decoded in order.
    pub fn decode(self: Hpack, buf: ptr, off: int, len: int): List<HeaderField> {
        let out = List<HeaderField>();
        let p = off;
        let end = off + len;
        while (p < end) {
            let b = bytes.read_byte(buf, p);
            if ((b & 128) != 0) {
                let (idx, np) = self.decInt(buf, p, end, 7);
                p = np;
                out.push(HeaderField(self.tableName(idx), self.tableValue(idx)));
            } else if ((b & 64) != 0) {
                let (idx, np) = self.decInt(buf, p, end, 6);
                p = np;
                let (nm, p2) = self.decNameOrStr(buf, p, end, idx);
                p = p2;
                let (vl, p3) = self.decStr(buf, p, end);
                p = p3;
                self.dynAdd(nm, vl);
                out.push(HeaderField(nm, vl));
            } else if ((b & 32) != 0) {
                let (sz, np) = self.decInt(buf, p, end, 5);
                p = np;
                self.maxDynSize = sz;
                while (self.dynSize > self.maxDynSize && self.dynNames.size() > 0) {
                    let last = self.dynNames.size() - 1;
                    self.dynSize = self.dynSize - (self.dynNames.at(last).length + self.dynValues.at(last).length + 32);
                    self.dynNames.remove(last);
                    self.dynValues.remove(last);
                }
            } else {
                let (idx, np) = self.decInt(buf, p, end, 4);
                p = np;
                let (nm, p2) = self.decNameOrStr(buf, p, end, idx);
                p = p2;
                let (vl, p3) = self.decStr(buf, p, end);
                p = p3;
                out.push(HeaderField(nm, vl));
            }
        }
        return out;
    }

    // Resolves a header name: from the table when idx is non-zero, otherwise decodes it as an inline string literal.
    fn decNameOrStr(self: Hpack, buf: ptr, p0: int, end: int, idx: int): (string, int) {
        if (idx != 0) { return (self.tableName(idx), p0); }
        return self.decStr(buf, p0, end);
    }

    // Decodes an RFC 7541 §5.1 variable-length integer with an n-bit prefix starting at p0; returns the value and the offset past it.
    fn decInt(self: Hpack, buf: ptr, p0: int, end: int, n: int): (int, int) {
        let p = p0;
        let max = (1 << n) - 1;
        let v = bytes.read_byte(buf, p) & max;
        p = p + 1;
        if (v < max) { return (v, p); }
        let m = 0;
        while (p < end) {
            let b = bytes.read_byte(buf, p);
            p = p + 1;
            v = v + ((b & 127) << m);
            if ((b & 128) == 0) { break; }
            m = m + 7;
        }
        return (v, p);
    }

    // Decodes an RFC 7541 §5.2 string literal at p0, Huffman-decoding it when the leading bit marks it as coded.
    fn decStr(self: Hpack, buf: ptr, p0: int, end: int): (string, int) {
        let huff = (bytes.read_byte(buf, p0) & 128) != 0;
        let (slen, p) = self.decInt(buf, p0, end, 7);
        if (huff) {
            let s = self.huffDecode(buf, p, slen);
            return (s, p + slen);
        }
        let outb = bytes.alloc(slen + 1);
        let i = 0;
        while (i < slen) { bytes.write_byte(outb, i, bytes.read_byte(buf, p + i)); i = i + 1; }
        bytes.write_byte(outb, slen, 0);
        bytes.write_i32(outb - 4, 0, slen);
        return (outb as string, p + slen);
    }
}

// Hash function for the long-keyed decMap: folds a long into a non-negative int within Map's expected range.
fn longHash(k: long): int {
    let x = k;
    if (x < 0) { x = 0 - x; }
    return (x % 2147483647) as int;
}

/// Creates a fresh Hpack codec with empty dynamic table and default 4096-byte dynamic table size.
pub fn newHpack(): Hpack { return Hpack(); }
