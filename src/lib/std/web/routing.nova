//! HTTP path routing: pattern parsing, route matching, and request dispatch.
//!
//! This file turns a registered set of routes (method plus a path pattern such
//! as `/users/{id:int}`) into a `Router` that can resolve an incoming request to
//! either a mediator handler key (for the CQRS-style dispatch path, see
//! `web.di`) or a directly attached closure (for controller-style routes). It
//! also owns the small pattern language: literal segments, `{name}` string
//! parameters, and `{name:type}` typed parameters (currently `int` is the only
//! enforced type, checked with `request.isAllDigits`).
//!
//! `Router.serve` is the usual entry point for a running web app: it resolves
//! the route, extracts path parameters into a `ParamSource`, merges them with
//! the JSON request body via `CompositeSource`, and calls into the mediator to
//! produce a `response.Response`. `Router.dispatch` is a lighter, string-in
//! string-out variant used where only the rendered body is wanted.

import string;
import list;
import map;
import serde.source;
import web.request;
import web.response;
import web.status;
import web.di;


/// A handler contract for mediator-style request processing: given a request
/// value, asynchronously produce a response value.
pub trait RequestHandler<TReq, TResp> {
    async fn handle(self, req: TReq): TResp;
}

/// One parsed segment of a route pattern: either a literal path component or a
/// named parameter (optionally typed).
pub struct Seg {
    /// True if this segment is a `{...}` parameter, false for a literal path component.
    pub is_param: bool,
    /// The literal text for a non-parameter segment, or the parameter name for a parameter segment.
    pub text: string,
    /// The declared parameter type (for example `"int"` or `"string"`); empty for non-parameter segments.
    pub ptype: string,

    init(is_param: bool, text: string, ptype: string) {
        self.is_param = is_param;
        self.text = text;
        self.ptype = ptype;
    }
}

/// A single registered route: an HTTP method, its parsed path pattern, and how
/// to handle a matching request.
pub struct Route {
    /// The HTTP method this route matches (for example `"GET"`), compared case-sensitively.
    pub method: string,
    /// The path pattern, already split into literal and parameter segments by `parsePattern`.
    pub segs: List<Seg>,
    /// The mediator dispatch key used to look up a handler when `isCtrl` is false; empty for controller routes.
    pub key: string,
    /// The handler closure invoked directly when `isCtrl` is true; a placeholder 404 closure otherwise.
    pub handler: (request.Request) -> response.Response,
    /// True when this route was registered via `handle` (a direct controller closure) rather than `__addRoute` (mediator dispatch by key).
    pub isCtrl: bool,

    init(method: string, segs: List<Seg>, key: string, handler: (request.Request) -> response.Response, isCtrl: bool) {
        self.method = method;
        self.segs = segs;
        self.key = key;
        self.handler = handler;
        self.isCtrl = isCtrl;
    }
}

/// The outcome of resolving a method and path against a `Router`'s routes.
///
/// Exactly one of `matched`, `typedBad`, or `methodNotAllowed` is true on a
/// non-match result; all three are false only for a plain 404 (no route with a
/// matching path shape exists at all).
pub struct RouteMatch {
    /// True when a route matched both the path shape and the HTTP method.
    pub matched: bool,
    /// True when the path shape matched but a typed parameter (for example `{id:int}`) failed its type check.
    pub typedBad: bool,
    /// True when the path shape matched some route but none of those routes accept this HTTP method.
    pub methodNotAllowed: bool,
    /// Extracted path parameters, keyed by parameter name. Populated only when `matched` is true.
    pub params: Map<string, string>,
    /// The matched route's mediator dispatch key. Empty unless `matched` is true.
    pub key: string,
    /// The index of the matched route within `Router.routes`, or -1 when there is no match.
    pub routeIndex: int,

    init(matched: bool, typedBad: bool, methodNotAllowed: bool, params: Map<string, string>, key: string, routeIndex: int) {
        self.matched = matched;
        self.typedBad = typedBad;
        self.methodNotAllowed = methodNotAllowed;
        self.params = params;
        self.key = key;
        self.routeIndex = routeIndex;
    }
}

/// Splits a route pattern (for example `/users/{id:int}/posts/{slug}`) into its
/// ordered `Seg` list, using `request.pathSegs` to break the path on `/`.
///
/// A segment wrapped in `{...}` becomes a parameter segment: a `name:type`
/// form (split on the first `:`) sets `ptype` explicitly, otherwise `ptype`
/// defaults to `"string"`. Any other segment is stored as a literal.
pub fn parsePattern(path: string): List<Seg> {
    let segs = List<Seg>();
    let splits = request.pathSegs(path);
    let pi = 0;
    while (pi < splits.size()) {
        let p = splits.at(pi);
        if (string.startsWith(p, "{") && string.endsWith(p, "}")) {
            let inner = string.slice(p, 1, p.length - 1);
            let colon = string.indexOf(inner, ":");
            if (colon == -1) {
                segs.push(Seg(true, inner, "string"));
            } else {
                let nm = string.slice(inner, 0, colon);
                let ty = string.slice(inner, colon + 1, inner.length);
                segs.push(Seg(true, nm, ty));
            }
        } else {
            segs.push(Seg(false, p, ""));
        }
        pi = pi + 1;
    }
    return segs;
}

/// The route table for a web app: registers routes, matches an incoming
/// request against them, and dispatches to the resolved handler.
///
/// Routes are matched in registration order and the first route whose segment
/// count and literal/typed segments agree with the request wins, so more
/// specific patterns should generally be registered before more general ones.
pub struct Router {
    /// The registered routes, in registration order; also the order in which `resolve` tries them.
    pub routes: List<Route>,

    init() {
        self.routes = List<Route>();
    }

    /// Registers a mediator-dispatched route: matching requests are resolved by `key` and handled via `__mediator_dispatch_by_name`, not by an attached closure.
    pub fn __addRoute(self: Router, method: string, path: string, key: string): void {
        self.routes.push(Route(method, parsePattern(path), key,
            (req: request.Request) => response.Response(Status.NotFound, "Not Found"), false));
    }

    /// Registers a controller-style route: matching requests are handled directly by the given closure, bypassing mediator dispatch.
    pub fn handle(self: Router, method: string, path: string, handler: (request.Request) -> response.Response): void {
        self.routes.push(Route(method, parsePattern(path), "", handler, true));
    }

    /// Matches `method` and `path` against the registered routes and reports the outcome.
    ///
    /// Tries every route whose segment count matches the path; a literal
    /// mismatch fails that route silently, but a typed-parameter mismatch
    /// (`typedBad`) short-circuits with a match-shaped failure as soon as the
    /// method also agrees, even if a later route would otherwise have matched.
    /// Falls back to `methodNotAllowed` when some route's path shape matched
    /// but none had the right method, and to a plain no-match otherwise.
    pub fn resolve(self: Router, method: string, path: string): RouteMatch {
        let segs = request.pathSegs(path);
        let nseg = segs.size();
        let pathMatched = false;
        let r = 0;
        while (r < self.routes.size()) {
            let route = self.routes.at(r);
            if (route.segs.size() == nseg) {
                let params = Map<string, string>(8, string.hash);
                let ok = true;
                let typedBad = false;
                let i = 0;
                while (i < nseg) {
                    let pat = route.segs.at(i);
                    let val = segs.get(i) ?? "";
                    if (pat.is_param) {
                        if (string.eql(pat.ptype, "int") && !request.isAllDigits(val)) {
                            typedBad = true;
                            ok = false;
                        } else {
                            params.set(pat.text, val);
                        }
                    } else if (!string.eql(pat.text, val)) {
                        ok = false;
                    }
                    i = i + 1;
                }
                if (ok) {
                    pathMatched = true;
                    if (string.eql(route.method, method)) {
                        return RouteMatch(true, false, false, params, route.key, r);
                    }
                } else if (typedBad && string.eql(route.method, method)) {
                    return RouteMatch(false, true, false, Map<string, string>(1, string.hash), "", -1);
                }
            }
            r = r + 1;
        }
        if (pathMatched) {
            return RouteMatch(false, false, true, Map<string, string>(1, string.hash), "", -1);
        }
        return RouteMatch(false, false, false, Map<string, string>(1, string.hash), "", -1);
    }

    /// Resolves `method` and `path` and returns the matched `Route`, or `undefined` when there is no match.
    pub fn matchRoute(self: Router, method: string, path: string): Route | undefined {
        let m = self.resolve(method, path);
        if (m.matched) { return self.routes.at(m.routeIndex); }
        return undefined;
    }

    /// Resolves and dispatches a request via the mediator, returning only the rendered response body as a string.
    ///
    /// Path parameters are merged with `body` through a `CompositeSource`. On a
    /// non-match returns `"400"`, `"405"`, or `"404"` as a plain string rather
    /// than a proper `response.Response`; prefer `serve` for real HTTP handling.
    pub fn dispatch(self: Router, method: string, path: string, body: ValueSource): string {
        let m = self.resolve(method, path);
        if (m.matched) {
            let composite = CompositeSource(ParamSource(m.params), body);
            let provider = ServiceCollection().buildServiceProvider();
            let resp = __mediator_dispatch_by_name(m.key, composite, provider);
            return resp.body;
        }
        if (m.typedBad) { return "400"; }
        if (m.methodNotAllowed) { return "405"; }
        return "404";
    }

    pub fn serve(self: Router, req: request.Request): response.Response {
        let m = self.resolve(req.method, req.path);
        if (m.matched) {
            let route = self.routes.at(m.routeIndex);
            if (route.isCtrl) {
                let h = route.handler;
                return h(req);
            }
            let jsonBody = req.body == "" ? "{}" : req.body;
            let src = source.fromJson(jsonBody);
            let composite = CompositeSource(ParamSource(m.params), src);
            let provider = ServiceCollection().buildServiceProvider();
            return __mediator_dispatch_by_name(m.key, composite, provider);
        }
        if (m.typedBad) {
            return response.Response(Status.BadRequest, "Bad Request: invalid path parameter");
        }
        if (m.methodNotAllowed) {
            return response.Response(Status.MethodNotAllowed, "405");
        }
        return response.Response(Status.NotFound, "404");
    }

    pub fn route(self: Router, req: request.Request): response.Response {
        return self.serve(req);
    }
}
