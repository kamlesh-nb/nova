//! The `Controller` trait, the common contract that groups a set of related
//! HTTP routes into one type.
//!
//! An app organises its handlers by giving each feature area (for example,
//! "products" or "auth") a struct that implements `Controller`. The app's
//! bootstrap code then hands each controller to the `web.routing.Router`,
//! which calls `registerRoutes` once per controller to wire its endpoints in.
//! This keeps route registration close to the handler code that serves it,
//! instead of collecting every route in one central file.

import web.routing;

/// Contract for a type that owns a group of HTTP routes.
pub trait Controller {
    /// Registers this controller's routes on `router`.
    ///
    /// Called once during app start-up. Implementations typically call
    /// `router.get`/`router.post`/etc. for each endpoint they own.
    fn registerRoutes(self: Controller, router: routing.Router): void;
}
