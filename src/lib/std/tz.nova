import datetime;
import string;

const DST_NONE: int = 0;
const DST_US: int = 1;
const DST_EU: int = 2;
const DST_AU: int = 3;

const HOUR: long = 3600;

struct ZoneRec { pub off: int, pub dst: int }

fn zoneRec(name: string): ZoneRec | undefined {
    if (string.eql(name, "UTC")) { return ZoneRec{ off: 0, dst: DST_NONE }; }
    if (string.eql(name, "America/New_York")) { return ZoneRec{ off: -18000, dst: DST_US }; }
    if (string.eql(name, "America/Chicago")) { return ZoneRec{ off: -21600, dst: DST_US }; }
    if (string.eql(name, "America/Denver")) { return ZoneRec{ off: -25200, dst: DST_US }; }
    if (string.eql(name, "America/Los_Angeles")) { return ZoneRec{ off: -28800, dst: DST_US }; }
    if (string.eql(name, "Europe/London")) { return ZoneRec{ off: 0, dst: DST_EU }; }
    if (string.eql(name, "Europe/Paris")) { return ZoneRec{ off: 3600, dst: DST_EU }; }
    if (string.eql(name, "Europe/Berlin")) { return ZoneRec{ off: 3600, dst: DST_EU }; }
    if (string.eql(name, "Asia/Kolkata")) { return ZoneRec{ off: 19800, dst: DST_NONE }; }
    if (string.eql(name, "Asia/Tokyo")) { return ZoneRec{ off: 32400, dst: DST_NONE }; }
    if (string.eql(name, "Asia/Shanghai")) { return ZoneRec{ off: 28800, dst: DST_NONE }; }
    if (string.eql(name, "Australia/Sydney")) { return ZoneRec{ off: 36000, dst: DST_AU }; }
    return undefined;
}

pub fn known(name: string): bool { return zoneRec(name) != undefined; }

fn dowOfEpochDay(epochDay: long): int {
    let r = ((epochDay % 7) + 4) % 7;
    if (r < 0) { r = r + 7; }
    return r as int;
}

fn transitionEpoch(year: int, month: int, weekday: int, nth: int, localHour: int, stdOffset: int): long {
    let first = datetime.parse(twoDate(year, month, 1)) ?? 0;
    let firstDow = dowOfEpochDay(first / 86400);
    let day = 0;
    if (nth > 0) {
        let delta = (weekday - firstDow + 7) % 7;
        day = 1 + delta + (nth - 1) * 7;
    } else {
        let dim = datetime.daysInMonth(year, month);
        let lastDow = dowOfEpochDay((first / 86400) + (dim - 1));
        let back = (lastDow - weekday + 7) % 7;
        day = dim - back;
    }
    let localWall = datetime.parse(dateTimeStr(year, month, day, localHour, 0, 0)) ?? 0;
    return localWall - (stdOffset as long);
}

pub fn offsetAt(zone: string, utcEpoch: long): int | undefined {
    let zr = zoneRec(zone);
    if (zr == undefined) { return undefined; }
    let rec = zr ?? ZoneRec{ off: 0, dst: DST_NONE };
    if (rec.dst == DST_NONE) { return rec.off; }
    let localApprox = utcEpoch + (rec.off as long);
    let year = string.parseI64(datetime.format(localApprox, "YYYY")) as int;
    let inDst = false;
    if (rec.dst == DST_US) {
        let start = transitionEpoch(year, 3, 0, 2, 2, rec.off);
        let end = transitionEpoch(year, 11, 0, 1, 2, rec.off + 3600);
        inDst = utcEpoch >= start && utcEpoch < end;
    } else if (rec.dst == DST_EU) {
        let start = transitionEpoch(year, 3, 0, -1, 1, 0);
        let end = transitionEpoch(year, 10, 0, -1, 1, 0);
        inDst = utcEpoch >= start && utcEpoch < end;
    } else if (rec.dst == DST_AU) {
        let start = transitionEpoch(year, 10, 0, 1, 2, rec.off);
        let end = transitionEpoch(year, 4, 0, 1, 3, rec.off + 3600);
        inDst = utcEpoch >= start || utcEpoch < end;
    }
    if (inDst) { return rec.off + 3600; }
    return rec.off;
}

pub fn toLocal(zone: string, utcEpoch: long): long | undefined {
    let o = offsetAt(zone, utcEpoch);
    if (o == undefined) { return undefined; }
    return utcEpoch + ((o ?? 0) as long);
}

pub fn formatInZone(zone: string, utcEpoch: long, fmt: string): string | undefined {
    let local = toLocal(zone, utcEpoch);
    if (local == undefined) { return undefined; }
    return datetime.format(local ?? 0, fmt);
}

fn pad2(n: int): string {
    if (n < 10) { return "0" + `${n}`; }
    return `${n}`;
}
fn twoDate(year: int, month: int, day: int): string {
    return `${year}` + "-" + pad2(month) + "-" + pad2(day);
}
fn dateTimeStr(year: int, month: int, day: int, h: int, mi: int, s: int): string {
    return twoDate(year, month, day) + "T" + pad2(h) + ":" + pad2(mi) + ":" + pad2(s);
}
